# Tark patches over upstream.json, applied in order by build.py patch.
branding-name-and-team.patch  # Tark name, com.gettarka.Tarka, Zynclave team
js-deps-audit.patch  # dompurify, darkreader, fast-uri: npm audit clean
services-off.patch  # no Glean, Sentry, Nimbus fetch, Remote Settings, push, Sync; Mozilla features off; no Firefox welcome
search-shodhya-only.patch  # Shodhya is the only built-in engine
mozilla-ui-off.patch  # no sign-in, Mozilla data toggles, support, privacy notice or terms rows
adblock-tark-lists.patch  # Tark list files (build.py lists) apply in Standard mode, not lowercased
adblock-cosmetic.patch  # element hiding and scriptlets with adblock-rust in the app (build.py engine)
xlit-rows.patch  # D1: transliteration rows and the one-time offer in the address bar (build.py xlit)
sources-at.patch  # I4b: @wiki, @maps and the Mac's other @ sources in the address bar
rows-suggestions-off.patch  # @ sources and language rows show with search suggestions off
