+/// Tark: the engine side of the page's translation port, answering
+/// `translations-document.sys.mjs` the way Firefox's engine
+/// (`translations-engine.sys.mjs`) does, with Tark's IndicTrans2 model on the
+/// phone. Paragraphs are split into sentences; requests are batched so
+/// Indian ↔ Indian swaps models once per batch, not per paragraph. Markup
+/// inside a paragraph is dropped and the paragraph translated whole (the
+/// user's choice: good sentences over keeping inline links). A sentence that
+/// fails keeps its original text.
+@MainActor
+final class TarkEngineEndpoint: BridgeEndpoint {
+    private struct Request {
+        let id: Int
+        let sourceText: String
+        let isHTML: Bool
+    }
+
+    /// Paragraphs per batch: about a screenful, so the first screen comes
+    /// back in one pass.
+    private static let batchSize = 12
+
+    let handlerName: String
+    weak var bridge: Bridge?
+
+    private var from = ""
+    private var to = ""
+    /// Bumped by StartTranslation and DiscardTranslations; a batch that
+    /// finishes under an older generation is dropped.
+    private var generation = 0
+    private var queue: [Request] = []
+    private var isTranslating = false
+
+    init(handlerName: String) {
+        self.handlerName = handlerName
+    }
+
+    func registerScriptHandler(_ handler: WKScriptMessageHandler) {}
+
+    /// A message from the page, as JSON.
+    func send(json: String) {
+        guard let data = json.data(using: .utf8),
+              let message = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any],
+              let type = message["type"] as? String else { return }
+
+        switch type {
+        case "StartTranslation":
+            let pair = message["languagePair"] as? [String: Any]
+            from = pair?["sourceLanguage"] as? String ?? ""
+            to = pair?["targetLanguage"] as? String ?? ""
+            reset()
+        case "DiscardTranslations", "TranslationsPort:DiscardTranslations":
+            reset()
+        case "ForceShutdown":
+            reset()
+            TarkPageTranslator.shared.unload()
+        case "TranslationsPort:GetEngineStatusRequest":
+            let ready = directions().allSatisfy { TarkTranslateModels.shared.isReady($0) }
+            reply(["type": "TranslationsPort:GetEngineStatusResponse",
+                   "status": ready ? "ready" : "error",
+                   "error": ready ? NSNull() : "models not on this phone"])
+        case "TranslationsPort:Passthrough":
+            reply(["type": "TranslationsPort:TranslationResponse",
+                   "translationId": message["translationId"] ?? NSNull(),
+                   "targetText": NSNull()])
+        case "TranslationsPort:CachedTranslation":
+            reply(["type": "TranslationsPort:TranslationResponse",
+                   "translationId": message["translationId"] ?? NSNull(),
+                   "targetText": message["cachedTranslation"] ?? NSNull()])
+        case "TranslationsPort:TranslationRequest":
+            guard let id = message["translationId"] as? Int,
+                  let sourceText = message["sourceText"] as? String else { return }
+            queue.append(Request(id: id, sourceText: sourceText, isHTML: message["isHTML"] as? Bool ?? false))
+            translateNextBatch()
+        case "TranslationsPort:CancelSingleTranslation":
+            guard let id = message["translationId"] as? Int else { return }
+            queue.removeAll { $0.id == id }
+        default:
+            break
+        }
+    }
+
+    private func reset() {
+        generation += 1
+        queue.removeAll()
+    }
+
+    /// The models this pair goes through.
+    private func directions() -> [TarkTranslateModels.Direction] {
+        var directions: [TarkTranslateModels.Direction] = []
+        if from != "en" { directions.append(.indicToEnglish) }
+        if to != "en" { directions.append(.englishToIndic) }
+        return directions
+    }
+
+    private func translateNextBatch() {
+        guard !isTranslating, !queue.isEmpty else { return }
+        isTranslating = true
+        let batch = Array(queue.prefix(Self.batchSize))
+        queue.removeFirst(batch.count)
+        let paragraphs = batch.map { Self.sentences(in: $0.isHTML ? Self.plainText(fromHTML: $0.sourceText) : $0.sourceText) }
+        let started = generation
+        let (from, to) = (self.from, self.to)
+
+        Task {
+            let flat = paragraphs.flatMap { $0 }
+            let translated = await TarkPageTranslator.shared.translate(flat, from: from, to: to)
+            var index = 0
+            if started == generation {
+                for (request, sentences) in zip(batch, paragraphs) {
+                    let text = sentences.map { sentence -> String in
+                        defer { index += 1 }
+                        return translated[index] ?? sentence
+                    }.joined(separator: " ")
+                    reply(["type": "TranslationsPort:TranslationResponse",
+                           "translationId": request.id,
+                           "targetText": request.isHTML ? Self.escapeHTML(text) : text])
+                }
+            }
+            isTranslating = false
+            translateNextBatch()
+        }
+    }
+
+    private func reply(_ message: [String: Any]) {
+        bridge?.receive(handlerName: handlerName, body: message)
+    }
+
+    /// `text` split into sentences; whitespace-only pieces dropped.
+    static func sentences(in text: String) -> [String] {
+        let tokenizer = NLTokenizer(unit: .sentence)
+        tokenizer.string = text
+        var sentences: [String] = []
+        tokenizer.enumerateTokens(in: text.startIndex..<text.endIndex) { range, _ in
+            let sentence = text[range].trimmingCharacters(in: .whitespacesAndNewlines)
+            if !sentence.isEmpty { sentences.append(sentence) }
+            return true
+        }
+        return sentences
+    }
+
+    /// The text of an inline-markup fragment: tags dropped (`<br>` as a
+    /// space), entities decoded, whitespace collapsed.
+    static func plainText(fromHTML html: String) -> String {
+        var text = html.replacingOccurrences(of: "<br\\s*/?>", with: " ", options: [.regularExpression, .caseInsensitive])
+        text = text.replacingOccurrences(of: "<[^>]*>", with: "", options: .regularExpression)
+        text = decodeEntities(text)
+        return text.replacingOccurrences(of: "\\s+", with: " ", options: .regularExpression)
+            .trimmingCharacters(in: .whitespaces)
+    }
+
+    private static let namedEntities = ["amp": "&", "lt": "<", "gt": ">", "quot": "\"", "apos": "'", "nbsp": "\u{00A0}"]
+
+    static func decodeEntities(_ text: String) -> String {
+        guard text.contains("&") else { return text }
+        let regex = try? NSRegularExpression(pattern: "&(#[0-9]+|#[xX][0-9a-fA-F]+|[a-zA-Z]+);")
+        let ns = text as NSString
+        var out = ""
+        var last = 0
+        for match in regex?.matches(in: text, range: NSRange(location: 0, length: ns.length)) ?? [] {
+            out += ns.substring(with: NSRange(location: last, length: match.range.location - last))
+            let body = ns.substring(with: match.range(at: 1))
+            var decoded: String?
+            if body.hasPrefix("#x") || body.hasPrefix("#X") {
+                decoded = UInt32(body.dropFirst(2), radix: 16).flatMap(Unicode.Scalar.init).map { String($0) }
+            } else if body.hasPrefix("#") {
+                decoded = UInt32(body.dropFirst()).flatMap(Unicode.Scalar.init).map { String($0) }
+            } else {
+                decoded = namedEntities[body]
+            }
+            out += decoded ?? ns.substring(with: match.range)
+            last = match.range.location + match.range.length
+        }
+        return out + ns.substring(from: last)
+    }
 
