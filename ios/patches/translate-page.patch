+/// Tark: page translation runs on Tark's own IndicTrans2 engine on the
+/// phone, so the languages are the engine's and nothing is fetched from
+/// Mozilla's Remote Settings. English and the Indian languages translate
+/// both ways; Indian ↔ Indian goes through English (TarkPageTranslator).
+final class TarkTranslationModelsFetcher: TranslationModelsFetcherProtocol {
+    static let languages = ["en", "hi", "ta", "bn"]
+
+    func fetchTranslatorWASM() async -> Data? { return nil }
+
+    /// Non-nil when Tark translates `sourceLang` into `targetLang`; Firefox
+    /// only checks for a pair, it does not read the data.
+    func fetchModels(from sourceLang: String, to targetLang: String) async -> Data? {
+        let supported = sourceLang != targetLang
+            && Self.languages.contains(sourceLang)
+            && Self.languages.contains(targetLang)
+        return supported ? Data("[]".utf8) : nil
+    }
+
+    func fetchModelBuffer(recordId: String) async -> Data? { return nil }
+
+    /// The models download on first use (a card asks), never ahead of time.
+    func prewarmResources(for sourceLang: String, to targetLang: String) async {}
+
+    func fetchSupportedTargetLanguages() async -> [String] { return Self.languages }
+
+    /// Firefox's "remove downloaded languages": deletes Tark's models.
+    func resetStorage() async {
+        TarkPageTranslator.shared.unload()
+        TarkTranslateModels.Direction.allCases.forEach(TarkTranslateModels.shared.delete)
+    }
+}
