+/// Tark: the selected tab's page started or stopped playing a video.
+struct TarkVideoStateAction: Action {
+    let windowUUID: WindowUUID
+    let actionType: ActionType
+    let playing: Bool
+
+    init(playing: Bool, windowUUID: WindowUUID) {
+        self.playing = playing
+        self.windowUUID = windowUUID
+        self.actionType = TarkVideoActionType.videoStateChanged
+    }
+}
+
+enum TarkVideoActionType: ActionType {
+    case videoStateChanged
+}
