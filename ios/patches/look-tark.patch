@@ -43,6 +43,25 @@ struct SearchEnginePrefs {
 struct TarkSearchEngineProvider: SearchEngineProvider {
     static let shodhyaID = "shodhya"
 
+    /// Shodhya's mark (shodhya.com/favicon.svg): three dots, coral, indigo and
+    /// amber, drawn here so no file is fetched.
+    static let shodhyaMark: UIImage = {
+        let size = CGSize(width: 52, height: 52)
+        return UIGraphicsImageRenderer(size: size).image { _ in
+            // The favicon's viewBox is -4 -8 52 52.
+            let dots: [(x: CGFloat, y: CGFloat, color: UInt32)] = [
+                (9, 27, 0xe63e5c), (35, 27, 0x4338ca), (22, 9, 0xffb703),
+            ]
+            for dot in dots {
+                UIColor(red: CGFloat((dot.color >> 16) & 0xff) / 255,
+                        green: CGFloat((dot.color >> 8) & 0xff) / 255,
+                        blue: CGFloat(dot.color & 0xff) / 255,
+                        alpha: 1).setFill()
+                UIBezierPath(ovalIn: CGRect(x: dot.x + 4 - 7, y: dot.y + 8 - 7, width: 14, height: 14)).fill()
+            }
+        }
+    }()
+
     let preferencesVersion: SearchEngineOrderingPrefsVersion = .v2
 
