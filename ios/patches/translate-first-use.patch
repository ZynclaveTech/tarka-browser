+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import SwiftUI
+import TarkXlit
+import UIKit
+
+/// Tark: the first-use card for page translation. When a page needs a model
+/// that is not on the phone yet, it says what and how big, downloads on
+/// Wi-Fi (or now, on mobile data, if the person says so), shows progress,
+/// and answers whether translation can go ahead. Nothing downloads without a
+/// tap.
+@MainActor
+public enum TarkModelsCard {
+    /// True when every model `source` → `target` needs is on the phone,
+    /// asking and downloading first if not; false when the person said not
+    /// now (or closed the card).
+    public static func ensureModels(from source: String,
+                                    to target: String,
+                                    presentingFrom presenter: UIViewController?,
+                                    models: TarkTranslateModels = .shared) async -> Bool {
+        let missing = TarkTranslateModels.directions(from: source, to: target).filter { !models.isReady($0) }
+        guard !missing.isEmpty else { return true }
+        guard let presenter = presenter.map(topmost) else { return false }
+
+        return await withCheckedContinuation { continuation in
+            let state = CardState(source: source, target: target, missing: missing, models: models)
+            let host = UIHostingController(rootView: CardView(state: state))
+            host.view.backgroundColor = .systemBackground
+            if let sheet = host.sheetPresentationController {
+                sheet.detents = [.medium()]
+                sheet.prefersGrabberVisible = true
+            }
+            state.finish = { [weak host] ready in
+                state.finish = nil
+                state.cancel()
+                host?.dismiss(animated: true)
+                continuation.resume(returning: ready)
+            }
+            host.presentationController?.delegate = state
+            presenter.present(host, animated: true)
+        }
+    }
+
+    private static func topmost(_ controller: UIViewController) -> UIViewController {
+        var top = controller
+        while let presented = top.presentedViewController, !presented.isBeingDismissed {
+            top = presented
+        }
+        return top
+    }
+}
+
+@MainActor
+private final class CardState: NSObject, ObservableObject, UIAdaptivePresentationControllerDelegate {
+    enum Phase: Equatable {
+        case asking
+        case waitingForWiFi
+        case downloading
+        case failed
+    }
+
+    @Published var phase: Phase = .asking
+    @Published var done: Int64 = 0
+
+    let title: String
+    let total: Int64
+    var finish: ((Bool) -> Void)?
+
+    private let missing: [TarkTranslateModels.Direction]
+    private let models: TarkTranslateModels
+    private var task: Task<Void, Never>?
+
+    init(source: String, target: String, missing: [TarkTranslateModels.Direction], models: TarkTranslateModels) {
+        self.missing = missing
+        self.models = models
+        self.total = missing.reduce(0) { $0 + TarkTranslateModels.size($1) }
+        self.title = "\(Self.name(source)) → \(Self.name(target))"
+    }
+
+    var size: String { Self.megabytes(total) }
+    var progressText: String { "\(Self.megabytes(done)) of \(size)" }
+
+    func start(now: Bool) {
+        task?.cancel()
+        task = Task { [weak self] in
+            guard let self else { return }
+            while !Task.isCancelled {
+                if !now, await !TarkXlitDownloader.isUnmeteredNetwork() {
+                    self.phase = .waitingForWiFi
+                    // Tries again when the phone may have joined Wi-Fi.
+                    try? await Task.sleep(nanoseconds: 5_000_000_000)
+                    continue
+                }
+                self.phase = .downloading
+                if await self.downloadMissing() {
+                    self.finish?(true)
+                } else if !Task.isCancelled {
+                    self.phase = .failed
+                }
+                return
+            }
+        }
+    }
+
+    private func downloadMissing() async -> Bool {
+        var before: Int64 = 0
+        for direction in missing {
+            let base = before
+            let outcome = await models.download(direction, now: true) { [weak self] bytes, _ in
+                Task { @MainActor in self?.done = base + bytes }
+            }
+            guard case .ready = outcome else { return false }
+            before += TarkTranslateModels.size(direction)
+        }
+        return true
+    }
+
+    func cancel() {
+        task?.cancel()
+        task = nil
+    }
+
+    func presentationControllerDidDismiss(_ presentationController: UIPresentationController) {
+        finish?(false)
+    }
+
+    private static func name(_ code: String) -> String {
+        return Locale.current.localizedString(forLanguageCode: code) ?? code
+    }
+
+    private static func megabytes(_ bytes: Int64) -> String {
+        return ByteCountFormatter.string(fromByteCount: bytes, countStyle: .file)
+    }
+}
+
+private struct CardView: View {
+    @ObservedObject var state: CardState
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 16) {
+            Text(verbatim: "Getting translation ready")
+                .font(.title3.bold())
+            Text(verbatim: state.title)
+                .font(.headline)
+                .foregroundStyle(.secondary)
+            Text(verbatim: description)
+                .font(.body)
+                .fixedSize(horizontal: false, vertical: true)
+
+            switch state.phase {
+            case .asking:
+                primary("Download · \(state.size)") { state.start(now: false) }
+                secondary("Not now") { state.finish?(false) }
+            case .waitingForWiFi:
+                Label { Text(verbatim: "Waiting for Wi-Fi") } icon: { ProgressView() }
+                primary("Download now on mobile data") { state.start(now: true) }
+                secondary("Not now") { state.finish?(false) }
+            case .downloading:
+                ProgressView(value: Double(state.done), total: Double(max(state.total, 1)))
+                    .tint(.indigo)
+                Text(verbatim: state.progressText)
+                    .font(.footnote.monospacedDigit())
+                    .foregroundStyle(.secondary)
+                secondary("Cancel") { state.finish?(false) }
+            case .failed:
+                Text(verbatim: "The download didn't finish. Check the connection and try again.")
+                    .font(.footnote)
+                    .foregroundStyle(.red)
+                primary("Try again") { state.start(now: false) }
+                secondary("Not now") { state.finish?(false) }
+            }
+            Spacer(minLength: 0)
+        }
+        .padding(24)
+    }
+
+    private var description: String {
+        return "Tark translates pages on your iPhone with its own model, so pages never leave your phone. "
+            + "The model downloads once (\(state.size)). Tark uses Wi-Fi for it unless you choose mobile data."
+    }
+
+    private func primary(_ title: String, action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            Text(verbatim: title).font(.body.bold()).frame(maxWidth: .infinity)
+        }
+        .buttonStyle(.borderedProminent)
+        .tint(.indigo)
+        .controlSize(.large)
+    }
+
+    private func secondary(_ title: String, action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            Text(verbatim: title).frame(maxWidth: .infinity)
+        }
+        .controlSize(.large)
+    }
+}
