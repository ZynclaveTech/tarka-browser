+/// Tark: Settings → Zynclave account. Signed out, it starts Sign in with
+/// Zynclave (Settings closes; the login page opens in a new normal tab);
+/// signed in, it shows who, with the photo, and opens the account screen.
+final class TarkAccountSetting: Setting {
+    private weak var settingsController: UITableViewController?
+    /// The row's photo once loaded, for the account it belongs to.
+    @MainActor private static var photo: (sub: String, image: UIImage)?
+    /// Settings' theme, for the account screen's colours.
+    private let screenTheme: Theme
+
+    override var accessoryView: UIImageView? {
+        guard let theme else { return nil }
+        return SettingDisclosureUtility.buildDisclosureIndicator(theme: theme)
+    }
+
+    override var style: UITableViewCell.CellStyle { return .subtitle }
+
+    override var status: NSAttributedString? {
+        guard TarkAccount.shared.isSignedIn else {
+            return NSAttributedString(string: "Optional. Browsing never needs an account.")
+        }
+        let profile = TarkAccount.shared.profile
+        return (profile?.name == nil ? nil : profile?.email).map(NSAttributedString.init(string:))
+    }
+
+    override var image: UIImage? {
+        guard TarkAccount.shared.isSignedIn else { return UIImage(named: "tarkMenuMark") }
+        let profile = TarkAccount.shared.profile
+        if let photo = Self.photo, photo.sub == profile?.sub { return photo.image }
+        return TarkAccountAvatar.initials(for: profile, size: 32)
+    }
+
+    init(settings: UITableViewController, theme: Theme) {
+        self.settingsController = settings
+        self.screenTheme = theme
+        let account = TarkAccount.shared
+        let title = account.isSignedIn
+            ? account.profile?.displayName ?? "Signed in"
+            : "Sign in with Zynclave"
+        super.init(title: NSAttributedString(
+            string: title,
+            attributes: [NSAttributedString.Key.foregroundColor: theme.colors.textPrimary]
+        ))
+        loadPhoto()
+    }
+
+    override func onConfigureCell(_ cell: UITableViewCell, theme: Theme) {
+        super.onConfigureCell(cell, theme: theme)
+        let size: CGFloat = 32
+        cell.imageView?.image = image.map { image in
+            UIGraphicsImageRenderer(size: CGSize(width: size, height: size)).image { _ in
+                UIBezierPath(ovalIn: CGRect(x: 0, y: 0, width: size, height: size)).addClip()
+                image.draw(in: CGRect(x: 0, y: 0, width: size, height: size))
+            }
+        }
+    }
+
+    override func onClick(_ navigationController: UINavigationController?) {
+        guard TarkAccount.shared.isSignedIn else {
+            if let controller = settingsController { TarkAccountRequest.signIn.send(from: controller) }
+            return
+        }
+        let colors = screenTheme.colors
+        let accountColors = TarkAccountColors(
+            background: colors.layer1,
+            row: colors.layer5,
+            separator: colors.borderPrimary,
+            accent: colors.actionPrimary,
+            text: colors.textPrimary,
+            secondaryText: colors.textSecondary)
+        navigationController?.pushViewController(TarkAccountViewController(colors: accountColors), animated: true)
+    }
+
+    private func loadPhoto() {
+        let profile = TarkAccount.shared.profile
+        guard let sub = profile?.sub, profile?.picture != nil, Self.photo?.sub != sub else { return }
+        Task { @MainActor [weak settingsController] in
+            let image = await TarkAccountAvatar.image(for: profile, size: 32)
+            guard TarkAccount.shared.profile?.sub == sub else { return }
+            Self.photo = (sub, image)
+            settingsController?.tableView.reloadData()
+        }
+    }
+}
+
 /// Tark: Settings → Languages (the address bar's Indian-language suggestions).
 final class TarkLanguagesSetting: Setting {
     override var accessoryView: UIImageView? {
