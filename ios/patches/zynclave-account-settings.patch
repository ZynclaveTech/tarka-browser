+// found in the LICENSE file.
+
+import CryptoKit
+import UIKit
+
+/// The account's photo: `userinfo.picture` (already limited to Zynclave's
+/// and Google's photo hosts), fetched without browsing cookies and kept on
+/// disk by URL; initials when there is no photo (about one account in
+/// seven) or it will not load. The cache goes when Tark signs out.
+@MainActor
+public enum TarkAccountAvatar {
+    private static let session = URLSession(configuration: .ephemeral)
+    private static let maxBytes = 5 * 1024 * 1024
+    private static var directory: URL {
+        FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("TarkAccountAvatar", isDirectory: true)
+    }
+
+    private static var signOutObserver: NSObjectProtocol?
+
+    /// The photo, else initials, `size` points across.
+    public static func image(for profile: TarkAccountProfile?, size: CGFloat) async -> UIImage {
+        watchSignOut()
+        guard let url = profile?.picture else { return initials(for: profile, size: size) }
+        let file = directory.appendingPathComponent(name(for: url))
+        if let data = try? Data(contentsOf: file), let image = UIImage(data: data) { return image }
+        guard let (data, response) = try? await session.data(from: url),
+              (response as? HTTPURLResponse)?.statusCode == 200,
+              data.count <= maxBytes,
+              let image = UIImage(data: data) else { return initials(for: profile, size: size) }
+        // A sign-out while the photo loaded: show it, but don't keep it.
+        if TarkAccount.shared.isSignedIn {
+            try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            try? data.write(to: file, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+        }
+        return image
+    }
+
+    /// One or two letters from the name (else the email), on a tinted circle.
+    public static func initials(for profile: TarkAccountProfile?, size: CGFloat) -> UIImage {
+        let source = profile?.name ?? profile?.email ?? ""
+        let letters = source.split(separator: " ").prefix(2).compactMap(\.first).map(String.init).joined()
+        let text = (letters.isEmpty ? "?" : letters).uppercased()
+        return UIGraphicsImageRenderer(size: CGSize(width: size, height: size)).image { _ in
+            UIColor(red: 0.26, green: 0.22, blue: 0.79, alpha: 1).setFill()
+            UIBezierPath(ovalIn: CGRect(x: 0, y: 0, width: size, height: size)).fill()
+            let attributes: [NSAttributedString.Key: Any] = [
+                .font: UIFont.systemFont(ofSize: size * 0.4, weight: .semibold),
+                .foregroundColor: UIColor.white,
+            ]
+            let textSize = text.size(withAttributes: attributes)
+            text.draw(at: CGPoint(x: (size - textSize.width) / 2, y: (size - textSize.height) / 2),
+                      withAttributes: attributes)
+        }
+    }
+
+    public static func clearCache() {
+        try? FileManager.default.removeItem(at: directory)
+    }
+
+    private static func watchSignOut() {
+        guard signOutObserver == nil else { return }
+        signOutObserver = NotificationCenter.default.addObserver(
+            forName: .tarkAccountDidChange, object: nil, queue: .main) { _ in
+            MainActor.assumeIsolated {
+                if !TarkAccount.shared.isSignedIn { clearCache() }
+            }
+        }
+    }
+
+    private static func name(for url: URL) -> String {
+        SHA256.hash(data: Data(url.absoluteString.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+}
