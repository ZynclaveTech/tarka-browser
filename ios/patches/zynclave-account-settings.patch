@@ -1682,6 +1682,51 @@ extension BrowserViewController {
         return true
     }
 
+    /// Settings' account requests (sign in, open a Zynclave page) for this
+    /// window only: each window's browser listens, and acts when the request
+    /// came from its own scene. Settings closes first.
+    func observeTarkAccountRequests() {
+        NotificationCenter.default.addObserver(
+            self,
+            selector: #selector(tarkAccountRequested(_:)),
+            name: .tarkAccountRequest,
+            object: nil)
+    }
+
+    @objc
+    private func tarkAccountRequested(_ note: Notification) {
+        guard let scene = note.object as? UIWindowScene, scene === view.window?.windowScene,
+              let request = note.userInfo?["request"] as? TarkAccountRequest else { return }
+        let run: () -> Void = { [weak self] in self?.handleTarkAccountRequest(request) }
+        if let presented = presentedViewController {
+            presented.dismiss(animated: true, completion: run)
+        } else {
+            run()
+        }
+    }
+
+    private func handleTarkAccountRequest(_ request: TarkAccountRequest) {
+        switch request {
+        case .open(let url):
+            _ = openURLInNewTab(url, isPrivate: false)
+        case .signIn:
+            Task { @MainActor in
+                do {
+                    try await startTarkSignIn()
+                } catch TarkAccount.SignInError.cancelled {
+                    // Closed the tab: nothing to say.
+                } catch {
+                    let alert = UIAlertController(
+                        title: "Couldn't sign in",
+                        message: "Check the connection and try again.",
+                        preferredStyle: .alert)
+                    alert.addAction(UIAlertAction(title: "OK", style: .default))
+                    present(alert, animated: true)
+                }
+            }
+        }
+    }
+
     /// The person closed the sign-in tab before finishing.
     func tarkSignInTabRemoved(_ tab: Tab) {
         guard tab === TarkSignInTab.tab else { return }
