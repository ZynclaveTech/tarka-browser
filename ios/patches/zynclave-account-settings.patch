+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import UIKit
+
+public extension Notification.Name {
+    /// Settings asks the browser window it belongs to (the notification's
+    /// object, a `UIWindowScene`) to act; `userInfo["request"]` is a
+    /// `TarkAccountRequest`. The browser closes Settings first.
+    static let tarkAccountRequest = Notification.Name("TarkAccountRequest")
+}
+
+public enum TarkAccountRequest {
+    /// Sign in with Zynclave in a new normal tab.
+    case signIn
+    /// Open a Zynclave page (account settings, sign out of the websites) in
+    /// a new normal tab, where the person's Zynclave session lives.
+    case open(URL)
+
+    @MainActor
+    public func send(from viewController: UIViewController) {
+        NotificationCenter.default.post(name: .tarkAccountRequest,
+                                        object: viewController.view.window?.windowScene,
+                                        userInfo: ["request": self])
+    }
+}
+
+/// Settings' theme colours, so the account screen matches the rest of
+/// Settings (BrowserKit's account module has no access to the theme).
+public struct TarkAccountColors {
+    public let background: UIColor
+    public let row: UIColor
+    public let separator: UIColor
+    public let accent: UIColor
+    public let text: UIColor
+    public let secondaryText: UIColor
+
+    public init(
+        background: UIColor,
+        row: UIColor,
+        separator: UIColor,
+        accent: UIColor,
+        text: UIColor,
+        secondaryText: UIColor
+    ) {
+        self.background = background
+        self.row = row
+        self.separator = separator
+        self.accent = accent
+        self.text = text
+        self.secondaryText = secondaryText
+    }
+}
+
+/// Settings → Zynclave account, while signed in: who, the photo, managing
+/// the account on Zynclave, switching account, signing out.
+public final class TarkAccountViewController: UITableViewController {
+    private enum Row { case manage, switchAccount, signOut }
+    private let sections: [[Row]] = [[.manage, .switchAccount], [.signOut]]
+
+    private let photo = UIImageView()
+    private let nameLabel = UILabel()
+    private let emailLabel = UILabel()
+    private let colors: TarkAccountColors
+
+    public init(colors: TarkAccountColors) {
+        self.colors = colors
+        super.init(style: .insetGrouped)
+        title = "Zynclave account"
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override public func viewDidLoad() {
+        super.viewDidLoad()
+        tableView.register(UITableViewCell.self, forCellReuseIdentifier: "row")
+        tableView.backgroundColor = colors.background
+        tableView.separatorColor = colors.separator
+        nameLabel.textColor = colors.text
+        emailLabel.textColor = colors.secondaryText
+        tableView.tableHeaderView = makeHeader()
+        NotificationCenter.default.addObserver(
+            self,
+            selector: #selector(accountChanged),
+            name: .tarkAccountDidChange,
+            object: nil)
+        accountChanged()
+    }
+
+    override public func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        // Back from Zynclave's settings page: a new photo or name shows.
+        Task { await TarkAccount.shared.refreshProfile() }
+    }
+
+    override public func viewDidLayoutSubviews() {
+        super.viewDidLayoutSubviews()
+        guard let header = tableView.tableHeaderView else { return }
+        let height = header.systemLayoutSizeFitting(
+            CGSize(width: tableView.bounds.width, height: UIView.layoutFittingCompressedSize.height),
+            withHorizontalFittingPriority: .required,
+            verticalFittingPriority: .fittingSizeLevel).height
+        if header.frame.height != height {
+            header.frame.size = CGSize(width: tableView.bounds.width, height: height)
+            tableView.tableHeaderView = header
+        }
+    }
+
+    private func makeHeader() -> UIView {
+        photo.contentMode = .scaleAspectFill
+        photo.clipsToBounds = true
+        photo.layer.cornerRadius = 36
+        photo.accessibilityIgnoresInvertColors = true
+        photo.widthAnchor.constraint(equalToConstant: 72).isActive = true
+        photo.heightAnchor.constraint(equalToConstant: 72).isActive = true
+        nameLabel.font = .preferredFont(forTextStyle: .title3)
+        nameLabel.adjustsFontForContentSizeCategory = true
+        nameLabel.textAlignment = .center
+        nameLabel.numberOfLines = 0
+        emailLabel.font = .preferredFont(forTextStyle: .subheadline)
+        emailLabel.adjustsFontForContentSizeCategory = true
+        emailLabel.textAlignment = .center
+        emailLabel.numberOfLines = 0
+        let stack = UIStackView(arrangedSubviews: [photo, nameLabel, emailLabel])
+        stack.axis = .vertical
+        stack.alignment = .center
+        stack.spacing = 6
+        stack.isLayoutMarginsRelativeArrangement = true
+        stack.directionalLayoutMargins = NSDirectionalEdgeInsets(top: 20, leading: 16, bottom: 12, trailing: 16)
+        return stack
+    }
+
+    @objc
+    private func accountChanged() {
+        let account = TarkAccount.shared
+        guard account.isSignedIn else {
+            navigationController?.popViewController(animated: true)
+            return
+        }
+        let profile = account.profile
+        nameLabel.text = profile?.name ?? profile?.email ?? "Signed in"
+        emailLabel.text = profile?.name == nil ? nil : profile?.email
+        emailLabel.isHidden = emailLabel.text == nil
+        photo.image = TarkAccountAvatar.initials(for: profile, size: 72)
+        photo.accessibilityLabel = "Photo of \(nameLabel.text ?? "your account")"
+        Task {
+            let image = await TarkAccountAvatar.image(for: profile, size: 72)
+            if TarkAccount.shared.profile == profile { photo.image = image }
+        }
+        viewDidLayoutSubviews()
+    }
+
+    // MARK: Table
+
+    override public func numberOfSections(in tableView: UITableView) -> Int { sections.count }
+
+    override public func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        sections[section].count
+    }
+
+    override public func tableView(_ tableView: UITableView, willDisplayFooterView view: UIView, forSection section: Int) {
+        (view as? UITableViewHeaderFooterView)?.textLabel?.textColor = colors.secondaryText
+    }
+
+    override public func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        guard section == sections.count - 1 else { return nil }
+        return "Your history, bookmarks and passwords stay on this device. Signing in doesn't send them anywhere."
+    }
+
+    override public func tableView(_ tableView: UITableView,
+                                   cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = tableView.dequeueReusableCell(withIdentifier: "row", for: indexPath)
+        var content = cell.defaultContentConfiguration()
+        switch sections[indexPath.section][indexPath.row] {
+        case .manage:
+            content.text = "Manage Zynclave account"
+            content.secondaryText = "Photo, name, username, other accounts"
+            content.image = UIImage(systemName: "person.crop.circle")
+            content.imageProperties.tintColor = colors.accent
+        case .switchAccount:
+            content.text = "Switch account"
+            content.image = UIImage(systemName: "arrow.left.arrow.right")
+            content.imageProperties.tintColor = colors.accent
+        case .signOut:
+            content.text = "Sign out"
+            content.textProperties.color = .systemRed
+            content.image = UIImage(systemName: "rectangle.portrait.and.arrow.right")
+            content.imageProperties.tintColor = .systemRed
+        }
+        if content.textProperties.color != .systemRed { content.textProperties.color = colors.text }
+        content.secondaryTextProperties.color = colors.secondaryText
+        cell.contentConfiguration = content
+        cell.backgroundColor = colors.row
+        return cell
+    }
+
+    override public func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        switch sections[indexPath.section][indexPath.row] {
+        case .manage:
+            TarkAccountRequest.open(TarkAccount.shared.config.settingsURL).send(from: self)
+        case .switchAccount:
+            switchAccount()
+        case .signOut:
+            confirmSignOut(from: tableView.cellForRow(at: indexPath))
+        }
+    }
+
+    // MARK: Actions
+
+    /// Signs Tark out (the web session stays), then signs in again: Zynclave
+    /// offers "Continue as …" with "Use another account", or its chooser
+    /// when two or more accounts are signed in on the web.
+    private func switchAccount() {
+        let request = TarkAccountRequest.signIn
+        let scene = view.window?.windowScene
+        Task {
+            await TarkAccount.shared.signOut(alsoWebsites: false)
+            NotificationCenter.default.post(
+                name: .tarkAccountRequest,
+                object: scene,
+                userInfo: ["request": request])
+        }
+    }
+
+    private func confirmSignOut(from cell: UITableViewCell?) {
+        let sheet = UIAlertController(
+            title: "Sign out of Tark?",
+            message: "You can also sign out of Zynclave's websites (Shodhya and others) in Tark.",
+            preferredStyle: .actionSheet)
+        sheet.addAction(UIAlertAction(title: "Sign out of Tark", style: .destructive) { [weak self] _ in
+            self?.signOut(alsoWebsites: false)
+        })
+        sheet.addAction(UIAlertAction(title: "Sign out of Tark and the websites", style: .destructive) { [weak self] _ in
+            self?.signOut(alsoWebsites: true)
+        })
+        sheet.addAction(UIAlertAction(title: "Cancel", style: .cancel))
+        sheet.popoverPresentationController?.sourceView = cell ?? view
+        sheet.popoverPresentationController?.sourceRect = cell?.bounds ?? view.bounds
+        present(sheet, animated: true)
+    }
+
+    private func signOut(alsoWebsites: Bool) {
+        let scene = view.window?.windowScene
+        Task {
+            let endSession = await TarkAccount.shared.signOut(alsoWebsites: alsoWebsites)
+            TarkAccountAvatar.clearCache()
+            if let endSession {
+                NotificationCenter.default.post(
+                    name: .tarkAccountRequest,
+                    object: scene,
+                    userInfo: ["request": TarkAccountRequest.open(endSession)])
+            }
+        }
+    }
+}
