@@ -0,0 +1,21 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import TarkXlitCore
+
+extension TarkTransliteration {
+    /// The Wikipedia language code for `query`: "en" for Latin text, else the
+    /// first of the user's languages written in the query's script, else that
+    /// script's default ("hi" for Devanagari).
+    public static func wikipediaLanguage(for query: String,
+                                         preferred: [String] = Locale.preferredLanguages) -> String {
+        let acceptLanguages = preferred.joined(separator: ",")
+        guard let code = query.withCString({ q in
+            acceptLanguages.withCString { tark_xlit_wikipedia_language(q, $0) }
+        }) else { return "en" }
+        defer { tark_xlit_string_free(code) }
+        return String(cString: code)
+    }
+}
