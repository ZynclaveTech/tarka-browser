+    /// "@wiki namaste" labels the row for what was typed with its source;
+    /// "@" and part of a keyword lists the matching sources first.
+    @MainActor
+    private func addTarkSourceRows(for query: String) {
+        if let match = TarkSources.match(query) {
+            if suggestions?.contains(query) == false { suggestions?.insert(query, at: 0) }
+            tarkSourceRows[query] = match.source
+        } else {
+            for (at, source) in TarkSources.candidates(for: query).enumerated() {
+                let row = "@" + source.keyword
+                suggestions?.removeAll { $0 == row }
+                // The index first: reading `suggestions` inside its own
+                // insert is an exclusivity violation (a crash).
+                let index = min(at, suggestions?.count ?? 0)
+                suggestions?.insert(row, at: index)
+                tarkSourceRows[row] = source
+            }
+        }
+        delegate?.reloadTableView()
+    }
