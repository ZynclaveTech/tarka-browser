diff --git a/BrowserKit/Sources/TarkSources/TarkSources.swift b/BrowserKit/Sources/TarkSources/TarkSources.swift
new file mode 100644
index 0000000..b85b59e
--- /dev/null
+++ b/BrowserKit/Sources/TarkSources/TarkSources.swift
@@ -0,0 +1,82 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import TarkXlit
+
+/// A web source reached by typing `@` and its keyword in the address bar, as
+/// on the Mac (patches/tarka/omnibox-sources). Names are proper nouns and are
+/// not translated.
+public struct TarkSource: Equatable, Sendable {
+    /// Without the leading `@`.
+    public let keyword: String
+    public let name: String
+    /// `{searchTerms}` is the query; `{tark:wikiLang}` the Wikipedia language.
+    let searchTemplate: String
+
+    /// The address that searches this source for `query`.
+    public func searchURL(for query: String) -> URL? {
+        let terms = query.addingPercentEncoding(withAllowedCharacters: Self.termCharacters) ?? query
+        var url = searchTemplate.replacingOccurrences(of: "{searchTerms}", with: terms)
+        if url.contains("{tark:wikiLang}") {
+            url = url.replacingOccurrences(of: "{tark:wikiLang}",
+                                           with: TarkTransliteration.wikipediaLanguage(for: query))
+        }
+        return URL(string: url)
+    }
+
+    private static let termCharacters: CharacterSet = {
+        var allowed = CharacterSet.urlQueryAllowed
+        allowed.remove(charactersIn: "&+=?#/")
+        return allowed
+    }()
+}
+
+public enum TarkSources {
+    /// In the order the address bar lists them; the same as the Mac's.
+    public static let all: [TarkSource] = [
+        TarkSource(keyword: "wiki", name: "Wikipedia",
+                   searchTemplate: "https://www.wikipedia.org/search-redirect.php"
+                       + "?family=wikipedia&language={tark:wikiLang}&search={searchTerms}"),
+        TarkSource(keyword: "maps", name: "OpenStreetMap",
+                   searchTemplate: "https://www.openstreetmap.org/search?query={searchTerms}"),
+        TarkSource(keyword: "gov", name: "India.gov.in",
+                   searchTemplate: "https://www.india.gov.in/search?search={searchTerms}"),
+        // IRCTC has no linkable search; the term stays in the fragment, which
+        // never leaves the phone.
+        TarkSource(keyword: "irctc", name: "IRCTC",
+                   searchTemplate: "https://www.irctc.co.in/nget/train-search#{searchTerms}"),
+        TarkSource(keyword: "kanoon", name: "Indian Kanoon",
+                   searchTemplate: "https://indiankanoon.org/search/?formInput={searchTerms}"),
+        TarkSource(keyword: "yt", name: "YouTube",
+                   searchTemplate: "https://www.youtube.com/results?search_query={searchTerms}"),
+        TarkSource(keyword: "dict", name: "Wiktionary",
+                   searchTemplate: "https://en.wiktionary.org/w/index.php?search={searchTerms}"),
+        TarkSource(keyword: "archive", name: "Internet Archive",
+                   searchTemplate: "https://archive.org/search?query={searchTerms}"),
+        TarkSource(keyword: "flipkart", name: "Flipkart",
+                   searchTemplate: "https://www.flipkart.com/search?q={searchTerms}"),
+        TarkSource(keyword: "amazon", name: "Amazon India",
+                   searchTemplate: "https://www.amazon.in/s?k={searchTerms}"),
+    ]
+
+    /// The sources to list while `text` is `@` and part of a keyword, with
+    /// no space yet: "@" lists them all, "@a" lists @archive and @amazon.
+    public static func candidates(for text: String) -> [TarkSource] {
+        guard text.hasPrefix("@"), !text.contains(where: \.isWhitespace) else { return [] }
+        let typed = text.dropFirst().lowercased()
+        return all.filter { $0.keyword.hasPrefix(typed) }
+    }
+
+    /// The source and query of `text` written as "@keyword query", or nil.
+    /// An empty query opens nothing: "@wiki " alone still waits for a query.
+    public static func match(_ text: String) -> (source: TarkSource, query: String)? {
+        guard text.hasPrefix("@"),
+              let space = text.firstIndex(where: \.isWhitespace) else { return nil }
+        let keyword = text[text.index(after: text.startIndex)..<space].lowercased()
+        let query = text[space...].trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !query.isEmpty, let source = all.first(where: { $0.keyword == keyword }) else { return nil }
+        return (source, query)
+    }
+}
