-    /// The languages to offer, best first, from iOS's preferred languages
-    /// (tark_xlit::RowLanguages, as on the Mac and Android).
-    public static func languages(preferred: [String] = Locale.preferredLanguages) -> [Language] {
+    /// The person's answer to the one-time offer, or Settings → Languages'
+    /// switch: "yes", "no", or nil before either.
+    public static let answerKey = "tark.xlit.answer"
+    /// The tags chosen in Settings → Languages, best first; unset follows the
+    /// phone's languages.
+    static let chosenKey = "tark.xlit.languages"
+    /// At most this many rows (tark_xlit kMaxRows).
+    public static let maxLanguages = 3
+
+    public static var isOn: Bool {
+        get { UserDefaults.standard.string(forKey: answerKey) == "yes" }
+        set { UserDefaults.standard.set(newValue ? "yes" : "no", forKey: answerKey) }
+    }
+
+    public static var hasAnswered: Bool {
+        return UserDefaults.standard.string(forKey: answerKey) != nil
+    }
+
+    /// The languages to offer, best first: the ones chosen in Settings, else
+    /// the phone's (tark_xlit::RowLanguages, as on the Mac and Android).
+    public static func languages() -> [Language] {
+        if let chosen = UserDefaults.standard.stringArray(forKey: chosenKey), !chosen.isEmpty {
+            let all = allLanguages()
+            return chosen.compactMap { tag in all.first { $0.tag == tag } }
+        }
+        return phoneLanguages()
+    }
+
+    public static func setLanguages(_ languages: [Language]) {
+        UserDefaults.standard.set(languages.prefix(maxLanguages).map(\.tag), forKey: chosenKey)
+    }
+
+    /// The Indian languages among iOS's preferred languages, Hindi if none.
+    public static func phoneLanguages(preferred: [String] = Locale.preferredLanguages) -> [Language] {
         let acceptLanguages = preferred.joined(separator: ",")
-        guard let json = acceptLanguages.withCString({ tark_xlit_row_languages($0) }) else { return [] }
+        return decode(acceptLanguages.withCString { tark_xlit_row_languages($0) })
+    }
+
+    /// Every language tark_xlit has, for Settings → Languages.
+    public static func allLanguages() -> [Language] {
+        return decode(tark_xlit_all_languages())
+    }
+
+    private static func decode(_ json: UnsafeMutablePointer<CChar>?) -> [Language] {
+        guard let json else { return [] }
         defer { tark_xlit_string_free(json) }
         return (try? JSONDecoder().decode([Language].self, from: Data(String(cString: json).utf8))) ?? []
     }
 
+    /// Where the downloads stand, for Settings → Languages.
+    public enum DownloadState: Equatable {
+        /// On, with files missing and no run since the app started.
+        case notDownloaded
+        case off, waitingForWiFi, downloading, failed, ready([Language])
+    }
+
+    /// Posted on the main thread when a download run starts or ends.
+    public static let didChangeNotification = Notification.Name("TarkXlitDidChange")
+
+    @MainActor private static var downloading = false
+    /// How the last run ended short of every file, or nil: kept in memory, so
+    /// after a relaunch the state is `notDownloaded` until a run starts.
+    @MainActor private static var lastProblem: TarkXlitDownloader.Outcome?
+
+    @MainActor
+    public static func downloadState() -> DownloadState {
+        guard isOn else { return .off }
+        if downloading { return .downloading }
+        let ready = shared.readyLanguages()
+        if ready.count == languages().count { return .ready(ready) }
+        switch lastProblem {
+        case .waitingForWiFi: return .waitingForWiFi
+        case .failed: return .failed
+        case .ready, nil: return .notDownloaded
+        }
+    }
+
+    /// Downloads what the chosen languages still need. "Download now" (`now`)
+    /// ignores the Wi-Fi rule.
+    @MainActor
+    public static func startDownloads(now: Bool) {
+        guard isOn, !downloading else { return }
+        downloading = true
+        NotificationCenter.default.post(name: didChangeNotification, object: nil)
+        let tags = languages().map(\.tag)
+        Task.detached {
+            var problem: TarkXlitDownloader.Outcome?
+            for tag in tags {
+                let outcome = await shared.downloader.download(tag, now: now)
+                if outcome != .ready { problem = outcome }
+                // Without Wi-Fi the other languages would wait too.
+                if outcome == .waitingForWiFi { break }
+            }
+            await MainActor.run {
+                downloading = false
+                lastProblem = problem
+                NotificationCenter.default.post(name: didChangeNotification, object: nil)
+                // A language chosen while this run was going still needs its list.
+                if problem == nil, languages().map(\.tag) != tags { startDownloads(now: now) }
+            }
+        }
+    }
+
     /// Whether `text` might be an Indian-language phrase typed in Latin letters.
     public static func looksTransliterable(_ text: String) -> Bool {
         return text.withCString { tark_xlit_looks_transliterable($0) } == 1
