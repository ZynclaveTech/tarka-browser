+import Network
+import UIKit
+
+/// Settings → Languages, as on Android: the switch for Indian-language
+/// suggestions in the address bar, where its download stands, and the
+/// languages (up to three) the suggestions are in.
+public final class TarkLanguagesViewController: UITableViewController {
+    private enum Section: Int, CaseIterable { case suggestions, languages }
+
+    private let all = TarkTransliteration.allLanguages()
+    private var chosen = TarkTransliteration.languages()
+    /// While the screen shows: a run that waited for Wi-Fi starts again when
+    /// the phone joins one.
+    private let pathMonitor = NWPathMonitor()
+
+    public init() {
+        super.init(style: .insetGrouped)
+        title = "Languages"
+    }
+
+    @available(*, unavailable)
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override public func viewDidLoad() {
+        super.viewDidLoad()
+        // Posted on the main thread; removed with the controller.
+        NotificationCenter.default.addObserver(
+            self, selector: #selector(downloadsChanged), name: TarkTransliteration.didChangeNotification, object: nil
+        )
+        pathMonitor.pathUpdateHandler = { path in
+            guard path.status == .satisfied, !path.isExpensive, !path.isConstrained else { return }
+            Task { @MainActor in
+                if TarkTransliteration.downloadState() == .waitingForWiFi {
+                    TarkTransliteration.startDownloads(now: false)
+                }
+            }
+        }
+        pathMonitor.start(queue: DispatchQueue(label: "com.gettarka.xlit.settings.path"))
+    }
+
+    override public func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        // After a relaunch nothing has run yet: the screen shows a real state.
+        TarkTransliteration.startDownloads(now: false)
+    }
+
+    override public func viewDidDisappear(_ animated: Bool) {
+        super.viewDidDisappear(animated)
+        if isMovingFromParent || isBeingDismissed { pathMonitor.cancel() }
+    }
+
+    override public func numberOfSections(in tableView: UITableView) -> Int {
+        return Section.allCases.count
+    }
+
+    override public func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
+        switch Section(rawValue: section) {
+        case .suggestions: return 1
+        case .languages: return TarkTransliteration.isOn ? all.count : 0
+        case nil: return 0
+        }
+    }
+
+    override public func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        switch Section(rawValue: section) {
+        case .suggestions:
+            return "Type in English letters and get your language in the address bar. "
+                + "Tark downloads about 25 MB once from gettarka.com; what you type never leaves the phone."
+        case .languages:
+            return TarkTransliteration.isOn ? "Up to \(TarkTransliteration.maxLanguages)." : nil
+        case nil:
+            return nil
+        }
+    }
+
+    override public func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        var content = cell.defaultContentConfiguration()
+        switch Section(rawValue: indexPath.section) {
+        case .suggestions:
+            content.text = "Indian-language suggestions"
+            content.secondaryText = Self.summary(TarkTransliteration.downloadState())
+            content.secondaryTextProperties.color = .secondaryLabel
+            let toggle = UISwitch()
+            toggle.isOn = TarkTransliteration.isOn
+            toggle.addTarget(self, action: #selector(switchChanged(_:)), for: .valueChanged)
+            cell.accessoryView = toggle
+            cell.selectionStyle = .none
+        case .languages:
+            let language = all[indexPath.row]
+            content.text = language.name
+            cell.accessoryType = chosen.contains(language) ? .checkmark : .none
+        case nil:
+            break
+        }
+        cell.contentConfiguration = content
+        return cell
+    }
+
+    override public func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard Section(rawValue: indexPath.section) == .languages else { return }
+        let language = all[indexPath.row]
+        if let index = chosen.firstIndex(of: language) {
+            // One language always stays: with none there would be no rows.
+            guard chosen.count > 1 else { return }
+            chosen.remove(at: index)
+        } else {
+            guard chosen.count < TarkTransliteration.maxLanguages else { return }
+            chosen.append(language)
+        }
+        TarkTransliteration.setLanguages(chosen)
+        TarkTransliteration.startDownloads(now: false)
+        tableView.reloadSections(IndexSet(integersIn: 0..<Section.allCases.count), with: .none)
+    }
+
+    @objc
+    private func switchChanged(_ toggle: UISwitch) {
+        TarkTransliteration.isOn = toggle.isOn
+        TarkTransliteration.startDownloads(now: false)
+        tableView.reloadSections(IndexSet(integersIn: 0..<Section.allCases.count), with: .automatic)
+    }
+
+    @objc
+    private func downloadsChanged() {
+        tableView.reloadRows(at: [IndexPath(row: 0, section: Section.suggestions.rawValue)], with: .none)
+    }
+
+    static func summary(_ state: TarkTransliteration.DownloadState) -> String {
+        switch state {
+        case .off: return "Off"
+        case .notDownloaded: return "Not downloaded yet"
+        case .waitingForWiFi: return "Waiting for Wi-Fi"
+        case .failed: return "Couldn’t download. Tark tries again later."
+        case .downloading: return "Downloading…"
+        case .ready(let languages): return "Downloaded: " + languages.map(\.name).joined(separator: ", ")
+        }
+    }
+}
