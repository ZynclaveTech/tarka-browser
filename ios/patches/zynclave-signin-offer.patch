+    /// Offers once to sign Tark in with the Zynclave account just signed in
+    /// on its website in this normal tab (see `TarkAccountOffer`). Sign in
+    /// asks Zynclave without a page (`prompt=none`); if it wants one after
+    /// all, it runs again with the page, which offers "Continue as …".
+    func offerTarkSignIn(after webView: WKWebView, in tab: Tab) {
+        let isPrivate = tab.isPrivate
+        let signInRunning = TarkSignInTab.tab != nil
+        Task { @MainActor [weak self] in
+            guard let identity = await TarkAccountOffer.identityToOffer(
+                in: webView, isPrivate: isPrivate, signInRunning: signInRunning),
+                  let self, self.presentedViewController == nil,
+                  self.tabManager.selectedTab === tab else { return }
+            let name = identity.displayName ?? "your Zynclave account"
+            let alert = UIAlertController(
+                title: "Sign in to Tark as \(name)?",
+                message: "You're signed in to Zynclave on this site. Tark can use the same account. "
+                    + "Your browsing stays on this phone.",
+                preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "No thanks", style: .cancel) { _ in
+                TarkAccountOffer.decline(identity)
+            })
+            alert.addAction(UIAlertAction(title: "Sign in", style: .default) { [weak self] _ in
+                Task { @MainActor in
+                    do {
+                        try await self?.startTarkSignIn(prompt: "none")
+                    } catch TarkAccount.SignInError.cancelled {
+                        // Closed the tab.
+                    } catch {
+                        // login_required, consent_required and the like:
+                        // once more, with the page.
+                        try? await self?.startTarkSignIn()
+                    }
+                }
+            })
+            self.present(alert, animated: true)
+        }
+    }
+
     /// The person closed the sign-in tab before finishing.
     func tarkSignInTabRemoved(_ tab: Tab) {
         guard tab === TarkSignInTab.tab else { return }
