+import CryptoKit
+import Foundation
+import WebKit
+
+/// "Sign in to Tark as X?": after the person signs in to Zynclave on its
+/// website in a normal tab, Tark offers to use the same account, once. It
+/// never signs in by itself, never looks in Private tabs, and never reads
+/// cookies: it asks Zynclave's own session endpoint from the page, in Tark's
+/// content world (the page's scripts can't see or change the call).
+@MainActor
+public enum TarkAccountOffer {
+    /// Who the Zynclave web session in the tab belongs to.
+    public struct WebIdentity: Sendable {
+        /// Kratos' identity id; only its hash is ever stored.
+        public let id: String
+        /// For the prompt's text only.
+        public let displayName: String?
+    }
+
+    private static let declinedKey = "TarkAccountDeclinedOffers"
+    /// Asked about already while Tark runs (declined or not): ask once.
+    private static var askedThisRun: Set<String> = []
+
+    /// The web identity to offer, or nil: not Zynclave's accounts site, a
+    /// Private tab, already signed in, a sign-in running, no web session, or
+    /// this account was offered before.
+    public static func identityToOffer(in webView: WKWebView,
+                                       isPrivate: Bool,
+                                       signInRunning: Bool) async -> WebIdentity? {
+        let account = TarkAccount.shared
+        guard !isPrivate, !signInRunning, !account.isSignedIn,
+              let url = webView.url, url.scheme == "https",
+              url.host?.lowercased() == account.config.accountsHost else { return nil }
+        let script = """
+            const response = await fetch('/sessions/whoami', {
+                credentials: 'include', headers: { Accept: 'application/json' } });
+            if (response.status !== 200) { return null; }
+            const session = await response.json();
+            const identity = session && session.identity;
+            if (!identity || !identity.id) { return null; }
+            const traits = identity.traits || {};
+            let name = traits.name;
+            if (name && typeof name === 'object') {
+                name = [name.first, name.last].filter(Boolean).join(' ');
+            }
+            return { id: identity.id, name: name || traits.email || '' };
+            """
+        guard let result = try? await webView.callAsyncJavaScript(script, contentWorld: .defaultClient)
+                as? [String: Any],
+              let id = result["id"] as? String, !id.isEmpty else { return nil }
+        let hash = hashed(id)
+        guard !askedThisRun.contains(hash), !declined.contains(hash), !account.isSignedIn else { return nil }
+        askedThisRun.insert(hash)
+        let name = (result["name"] as? String).flatMap { $0.isEmpty ? nil : $0 }
+        return WebIdentity(id: id, displayName: name)
+    }
+
+    /// "No thanks": never offer this account again.
+    public static func decline(_ identity: WebIdentity) {
+        var list = declined
+        list.insert(hashed(identity.id))
+        UserDefaults.standard.set(Array(list), forKey: declinedKey)
+    }
+
+    private static var declined: Set<String> {
+        Set(UserDefaults.standard.stringArray(forKey: declinedKey) ?? [])
+    }
+
+    private static func hashed(_ id: String) -> String {
+        SHA256.hash(data: Data(id.utf8)).map { String(format: "%02x", $0) }.joined()
+    }
+}
