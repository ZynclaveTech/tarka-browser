+++ b/firefox-ios/Client/Configuration/version.xcconfig
@@ -1 +1,5 @@
-APP_VERSION = 159.0
\ No newline at end of file
+// Tark: <Firefox for iOS major it is built on>.<Tark release on that base>,
+// as Android is <Chromium version>-r<N>. Firefox 159, Tark release 1.
