+    // MARK: - Tark sections
+
+    /// A menu item that closes the menu, then does `perform`.
+    private func tarkItem(
+        _ title: String,
+        icon: String,
+        a11yId: String,
+        uuid: WindowUUID,
+        tabInfo: MainMenuTabInfo,
+        isEnabled: Bool = true,
+        perform: @escaping @MainActor () -> Void
+    ) -> MenuElement {
+        return MenuElement(
+            title: title,
+            iconName: icon,
+            isEnabled: isEnabled,
+            isActive: false,
+            a11yLabel: title,
+            a11yHint: "",
+            a11yId: a11yId,
+            action: {
+                store.dispatch(
+                    MainMenuAction(
+                        windowUUID: uuid,
+                        actionType: MainMenuActionType.tapCloseMenu,
+                        telemetryInfo: TelemetryInfo(isHomepage: tabInfo.isHomepage)
+                    )
+                )
+                perform()
+            }
+        )
+    }
+
+    /// A menu item that opens one of the menu's destinations.
+    private func tarkDestination(
+        _ title: String,
+        icon: String,
+        a11yId: String,
+        destination: MainMenuNavigationDestination,
+        uuid: WindowUUID,
+        tabInfo: MainMenuTabInfo
+    ) -> MenuElement {
+        return MenuElement(
+            title: title,
+            iconName: icon,
+            isEnabled: true,
+            isActive: false,
+            a11yLabel: title,
+            a11yHint: "",
+            a11yId: a11yId,
+            action: {
+                store.dispatch(
+                    MainMenuAction(
+                        windowUUID: uuid,
+                        actionType: MainMenuActionType.tapNavigateToDestination,
+                        navigationDestination: MenuNavigationDestination(destination),
+                        telemetryInfo: TelemetryInfo(isHomepage: tabInfo.isHomepage)
+                    )
+                )
+            }
+        )
+    }
+
+    private func browserAction(_ type: GeneralBrowserActionType, uuid: WindowUUID) -> @MainActor () -> Void {
+        return { store.dispatch(GeneralBrowserAction(windowUUID: uuid, actionType: type)) }
+    }
+
+    private func getTarkPageRow(with uuid: WindowUUID, tabInfo: MainMenuTabInfo) -> MenuSection {
+        return MenuSection(
+            isHorizontalTabsSection: true,
+            groupA11yLabel: .MainMenu.ToolsSection.AccessibilityLabels.LibraryOptions,
+            isHomepage: tabInfo.isHomepage,
+            options: [
+                tarkItem(.KeyboardShortcuts.Forward, icon: StandardImageIdentifiers.Large.chevronRight,
+                         a11yId: "tark.menu.forward", uuid: uuid, tabInfo: tabInfo,
+                         isEnabled: tabInfo.canGoForward,
+                         perform: browserAction(.navigateForward, uuid: uuid)),
+                configureBookmarkPageItem(with: uuid, and: tabInfo),
+                tarkItem(.KeyboardShortcuts.ReloadPage, icon: StandardImageIdentifiers.Large.arrowClockwise,
+                         a11yId: "tark.menu.reload", uuid: uuid, tabInfo: tabInfo,
+                         perform: browserAction(.reloadWebsite, uuid: uuid)),
+                tarkDestination(.ShareContextMenuTitle, icon: Icons.share, a11yId: "tark.menu.share",
+                                destination: .shareSheet, uuid: uuid, tabInfo: tabInfo),
+            ]
+        )
+    }
+
+    private func getTarkTiles(with uuid: WindowUUID, tabInfo: MainMenuTabInfo) -> MenuSection {
+        return MenuSection(
+            isHorizontalTabsSection: true,
+            groupA11yLabel: .MainMenu.ToolsSection.AccessibilityLabels.LibraryOptions,
+            isHomepage: tabInfo.isHomepage,
+            options: [
+                tarkItem(.KeyboardShortcuts.NewTab, icon: StandardImageIdentifiers.Large.plus,
+                         a11yId: "tark.menu.newTab", uuid: uuid, tabInfo: tabInfo,
+                         perform: { store.dispatch(TabPanelViewModernAction.addNewTab(ofType: .normal), forWindowUUID: uuid) }),
+                tarkItem(.KeyboardShortcuts.NewPrivateTab, icon: StandardImageIdentifiers.Large.privateMode,
+                         a11yId: "tark.menu.privateTab", uuid: uuid, tabInfo: tabInfo,
+                         perform: { store.dispatch(TabPanelViewModernAction.addNewTab(ofType: .private), forWindowUUID: uuid) }),
+                tarkDestination(.MainMenu.PanelLinkSection.History, icon: Icons.history,
+                                a11yId: AccessibilityIdentifiers.MainMenu.history,
+                                destination: .history, uuid: uuid, tabInfo: tabInfo),
+                tarkDestination(.MainMenu.PanelLinkSection.Downloads, icon: Icons.downloads,
+                                a11yId: AccessibilityIdentifiers.MainMenu.downloads,
+                                destination: .downloads, uuid: uuid, tabInfo: tabInfo),
+            ]
+        )
+    }
+
+    private func getTarkRows(with uuid: WindowUUID, tabInfo: MainMenuTabInfo) -> MenuSection {
+        var options = [
+            tarkDestination(.MainMenu.PanelLinkSection.Bookmarks, icon: Icons.bookmarksTray,
+                            a11yId: AccessibilityIdentifiers.MainMenu.bookmarks,
+                            destination: .bookmarks, uuid: uuid, tabInfo: tabInfo)
+        ]
+        if !tabInfo.isHomepage {
+            options.append(tarkDestination(.MainMenu.ToolsSection.FindInPageV2, icon: Icons.findInPage,
+                                           a11yId: AccessibilityIdentifiers.MainMenu.findInPage,
+                                           destination: .findInPage, uuid: uuid, tabInfo: tabInfo))
+            options.append(configureUserAgentItem(with: uuid, tabInfo: tabInfo))
+            options.append(configureReaderViewItem(with: uuid, tabInfo: tabInfo))
+        }
+        return MenuSection(isHomepage: tabInfo.isHomepage, options: options)
+    }
+
