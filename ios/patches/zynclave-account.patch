diff --git a/BrowserKit/Sources/TarkAccount/TarkAccount.swift b/BrowserKit/Sources/TarkAccount/TarkAccount.swift
new file mode 100644
index 0000000..819f6c2
--- /dev/null
+++ b/BrowserKit/Sources/TarkAccount/TarkAccount.swift
@@ -0,0 +1,274 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+@preconcurrency import AppAuthCore
+import Foundation
+
+public extension Notification.Name {
+    /// Signed in, signed out, or the profile changed.
+    static let tarkAccountDidChange = Notification.Name("TarkAccountDidChange")
+}
+
+/// What `userinfo` says about the signed-in person; any of it may be missing
+/// except `sub`, the only key the account is known by.
+public struct TarkAccountProfile: Codable, Equatable, Sendable {
+    public let sub: String
+    public let name: String?
+    public let email: String?
+    /// Only from an allowed photo host (`TarkAccountConfig.allowsPicture`).
+    public let picture: URL?
+
+    /// Name, else email, else nothing: what Tark shows for the account.
+    public var displayName: String? { name ?? email }
+}
+
+/// Sign in with Zynclave: authorization code + PKCE as a public client
+/// (AppAuth), tokens in the Keychain, refreshed on use. Sign-in is optional;
+/// nothing here runs at launch beyond reading the Keychain, so Tark starts
+/// and browses the same signed out or offline.
+@MainActor
+public final class TarkAccount: NSObject {
+    public enum SignInError: Error {
+        /// The person closed the sign-in tab.
+        case cancelled
+        /// `prompt=none` found no Zynclave session to use.
+        case loginRequired
+        case failed(Error)
+    }
+
+    public static let shared = TarkAccount(config: .current)
+
+    public let config: TarkAccountConfig
+    private var authState: OIDAuthState?
+    private var discovery: OIDServiceConfiguration?
+    private var session: OIDExternalUserAgentSession?
+    /// Browsing cookies never ride along on account calls.
+    private let urlSession = URLSession(configuration: .ephemeral)
+
+    private static let profileKey = "TarkAccountProfile"
+    public private(set) var profile: TarkAccountProfile?
+
+    init(config: TarkAccountConfig) {
+        self.config = config
+        super.init()
+        if let data = TarkAccountKeychain.load(),
+           let state = try? NSKeyedUnarchiver.unarchivedObject(ofClass: OIDAuthState.self, from: data) {
+            authState = state
+            state.stateChangeDelegate = self
+            if let saved = UserDefaults.standard.data(forKey: Self.profileKey) {
+                profile = try? JSONDecoder().decode(TarkAccountProfile.self, from: saved)
+            }
+        } else {
+            // A Keychain left from a deleted install, or nothing: start clean.
+            UserDefaults.standard.removeObject(forKey: Self.profileKey)
+        }
+    }
+
+    public var isSignedIn: Bool { authState?.refreshToken != nil }
+
+    /// The last ID token, for `id_token_hint` (re-sign-in the same account
+    /// silently, or sign out of Zynclave's websites).
+    public var lastIDToken: String? { authState?.lastTokenResponse?.idToken }
+
+    // MARK: Sign in
+
+    /// Runs the authorization in `agent` (a Tark tab). `prompt: "none"` asks
+    /// for the Zynclave web session already in Tark without showing a page;
+    /// with `idTokenHint` it returns that same account even when another is
+    /// active. Never sends `prompt=select_account` (Zynclave rejects it):
+    /// with two or more web accounts Zynclave shows its chooser by itself.
+    public func signIn(using agent: OIDExternalUserAgent,
+                       prompt: String? = nil,
+                       idTokenHint: String? = nil,
+                       loginHint: String? = nil) async throws {
+        let configuration = try await serviceConfiguration()
+        var parameters: [String: String] = [:]
+        if let prompt { parameters["prompt"] = prompt }
+        if let idTokenHint { parameters["id_token_hint"] = idTokenHint }
+        if let loginHint { parameters["login_hint"] = loginHint }
+        let request = OIDAuthorizationRequest(configuration: configuration,
+                                              clientId: config.clientID,
+                                              scopes: TarkAccountConfig.scopes,
+                                              redirectURL: TarkAccountConfig.redirectURL,
+                                              responseType: OIDResponseTypeCode,
+                                              additionalParameters: parameters.isEmpty ? nil : parameters)
+        session?.cancel(completion: nil)
+        let state: OIDAuthState = try await withCheckedThrowingContinuation { continuation in
+            session = OIDAuthState.authState(byPresenting: request, externalUserAgent: agent) { state, error in
+                if let state {
+                    continuation.resume(returning: state)
+                } else {
+                    continuation.resume(throwing: Self.signInError(error))
+                }
+            }
+        }
+        session = nil
+        authState = state
+        state.stateChangeDelegate = self
+        persist()
+        NotificationCenter.default.post(name: .tarkAccountDidChange, object: self)
+        await refreshProfile()
+    }
+
+    /// The redirect, from the sign-in tab or from outside Tark. False when no
+    /// sign-in is waiting or the `state` is not this sign-in's (AppAuth
+    /// checks), so a stray link does nothing.
+    @discardableResult
+    public func resume(with url: URL) -> Bool {
+        guard TarkAccountConfig.isRedirect(url), let session else { return false }
+        do {
+            try session.resumeExternalUserAgentFlow(url)
+            return true
+        } catch {
+            return false
+        }
+    }
+
+    /// The sign-in tab closed before the redirect.
+    public func cancelSignIn() {
+        session?.cancel(completion: nil)
+        session = nil
+    }
+
+    // MARK: Tokens
+
+    /// An access token, refreshed first when needed. A refused refresh
+    /// (`invalid_grant`: revoked, expired, or rotated elsewhere) signs Tark
+    /// out cleanly instead of retrying.
+    public func freshAccessToken() async throws -> String {
+        guard let authState else { throw SignInError.loginRequired }
+        do {
+            return try await withCheckedThrowingContinuation { continuation in
+                authState.performAction { accessToken, _, error in
+                    if let accessToken {
+                        continuation.resume(returning: accessToken)
+                    } else {
+                        continuation.resume(throwing: error ?? SignInError.loginRequired)
+                    }
+                }
+            }
+        } catch let error as NSError where error.domain == OIDOAuthTokenErrorDomain
+                    && error.code == OIDErrorCodeOAuthToken.invalidGrant.rawValue {
+            clear()
+            throw SignInError.loginRequired
+        }
+    }
+
+    // MARK: Profile
+
+    /// Refetches `userinfo`. Kept signed in on a network failure; a refused
+    /// token ends in `freshAccessToken`'s clean sign-out.
+    public func refreshProfile() async {
+        let configuration = try? await serviceConfiguration()
+        guard let endpoint = configuration?.discoveryDocument?.userinfoEndpoint,
+              let token = try? await freshAccessToken() else { return }
+        var request = URLRequest(url: endpoint)
+        request.setValue("Bearer \(token)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        guard let (data, response) = try? await urlSession.data(for: request),
+              (response as? HTTPURLResponse)?.statusCode == 200,
+              let info = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let sub = info["sub"] as? String else { return }
+        let picture = (info["picture"] as? String).flatMap(URL.init(string:)).flatMap {
+            config.allowsPicture($0) ? $0 : nil
+        }
+        let fresh = TarkAccountProfile(sub: sub,
+                                       name: (info["name"] as? String).flatMap { $0.isEmpty ? nil : $0 },
+                                       email: info["email"] as? String,
+                                       picture: picture)
+        guard fresh != profile else { return }
+        profile = fresh
+        UserDefaults.standard.set(try? JSONEncoder().encode(fresh), forKey: Self.profileKey)
+        NotificationCenter.default.post(name: .tarkAccountDidChange, object: self)
+    }
+
+    // MARK: Sign out
+
+    /// Signs Tark out: revokes the refresh token and forgets the account.
+    /// Returns the URL that also signs out of Zynclave's websites in Tark
+    /// (open it in a normal tab) when `alsoWebsites` is set.
+    @discardableResult
+    public func signOut(alsoWebsites: Bool) async -> URL? {
+        let configuration = try? await serviceConfiguration()
+        var endSession: URL?
+        if alsoWebsites, let endpoint = configuration?.discoveryDocument?.endSessionEndpoint,
+           var components = URLComponents(url: endpoint, resolvingAgainstBaseURL: false) {
+            if let idToken = lastIDToken {
+                components.queryItems = (components.queryItems ?? []) + [URLQueryItem(name: "id_token_hint", value: idToken)]
+            }
+            endSession = components.url
+        }
+        if let refreshToken = authState?.refreshToken,
+           let revocation = (configuration?.discoveryDocument?.discoveryDictionary["revocation_endpoint"] as? String)
+            .flatMap(URL.init(string:)) {
+            var request = URLRequest(url: revocation)
+            request.httpMethod = "POST"
+            request.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
+            var body = URLComponents()
+            body.queryItems = [URLQueryItem(name: "token", value: refreshToken),
+                               URLQueryItem(name: "token_type_hint", value: "refresh_token"),
+                               URLQueryItem(name: "client_id", value: config.clientID)]
+            request.httpBody = body.percentEncodedQuery?.data(using: .utf8)
+            // Signed out on this phone either way; a failed revoke leaves a
+            // token that expires on its own.
+            _ = try? await urlSession.data(for: request)
+        }
+        clear()
+        return endSession
+    }
+
+    // MARK: Private
+
+    private func serviceConfiguration() async throws -> OIDServiceConfiguration {
+        if let discovery { return discovery }
+        let fetched: OIDServiceConfiguration = try await withCheckedThrowingContinuation { continuation in
+            OIDAuthorizationService.discoverConfiguration(forIssuer: config.issuer) { configuration, error in
+                if let configuration {
+                    continuation.resume(returning: configuration)
+                } else {
+                    continuation.resume(throwing: SignInError.failed(error ?? URLError(.badServerResponse)))
+                }
+            }
+        }
+        discovery = fetched
+        return fetched
+    }
+
+    private func persist() {
+        guard let authState,
+              let data = try? NSKeyedArchiver.archivedData(withRootObject: authState, requiringSecureCoding: true)
+        else { return }
+        TarkAccountKeychain.save(data)
+    }
+
+    private func clear() {
+        let wasSignedIn = authState != nil
+        authState?.stateChangeDelegate = nil
+        authState = nil
+        profile = nil
+        TarkAccountKeychain.delete()
+        UserDefaults.standard.removeObject(forKey: Self.profileKey)
+        if wasSignedIn {
+            NotificationCenter.default.post(name: .tarkAccountDidChange, object: self)
+        }
+    }
+
+    nonisolated private static func signInError(_ error: Error?) -> SignInError {
+        guard let error = error as NSError? else { return .failed(URLError(.unknown)) }
+        if error.domain == OIDGeneralErrorDomain,
+           error.code == OIDErrorCode.userCanceledAuthorizationFlow.rawValue {
+            return .cancelled
+        }
+        let response = error.userInfo[OIDOAuthErrorResponseErrorKey] as? [String: Any]
+        if response?["error"] as? String == "login_required" { return .loginRequired }
+        return .failed(error)
+    }
+}
+
+extension TarkAccount: OIDAuthStateChangeDelegate {
+    /// Refresh tokens rotate on every use: keep the newest in the Keychain.
+    nonisolated public func didChange(_ state: OIDAuthState) {
+        Task { @MainActor in self.persist() }
+    }
+}
