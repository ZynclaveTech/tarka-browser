@@ -0,0 +1,61 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+
+/// Tark's Zynclave clients: public native clients (no secret, PKCE S256),
+/// the same redirect as every other Tark platform, so a person has the same
+/// pairwise `sub` in Tark on iOS, Android and the desktop. Debug (`.dev`)
+/// builds use staging; TestFlight and the App Store use production.
+public struct TarkAccountConfig: Sendable {
+    public let issuer: URL
+    public let clientID: String
+    public let accountsHost: String
+    public let avatarHosts: Set<String>
+
+    /// Never change: the pairwise `sub` is derived from it.
+    public static let redirectURL = URL(string: "com.gettarka.tarka:/oauth2redirect")!
+    public static let scopes = ["openid", "profile", "email", "offline_access"]
+
+    public static let production = TarkAccountConfig(
+        issuer: URL(string: "https://auth.zynclave.com/")!,
+        clientID: "faedd095-b0c2-4caa-84b1-384a6520f903",
+        accountsHost: "accounts.zynclave.com",
+        avatarHosts: ["avatars.zynclave.com"])
+
+    public static let staging = TarkAccountConfig(
+        issuer: URL(string: "https://auth.staging.zynclave.com/")!,
+        clientID: "c8a4acfb-88e0-4d0d-91ad-7f32bd2ff795",
+        accountsHost: "accounts.staging.zynclave.com",
+        avatarHosts: ["avatars.staging.zynclave.com"])
+
+    public static var current: TarkAccountConfig {
+        Bundle.main.bundleIdentifier?.hasSuffix(".dev") == true ? staging : production
+    }
+
+    /// Google's photo hosts, besides Zynclave's own.
+    private static let googlePhotoHosts: Set<String> = [
+        "lh3.googleusercontent.com", "lh4.googleusercontent.com",
+        "lh5.googleusercontent.com", "lh6.googleusercontent.com",
+    ]
+
+    /// The account settings page (photo, username, other accounts).
+    public var settingsURL: URL { URL(string: "https://\(accountsHost)/settings")! }
+
+    /// Forces the account chooser when only one web account is signed in.
+    public var chooseAccountURL: URL { URL(string: "https://\(accountsHost)/accounts/choose")! }
+
+    /// A `picture` Tark loads only from Zynclave's or Google's photo hosts,
+    /// over HTTPS.
+    public func allowsPicture(_ url: URL) -> Bool {
+        guard url.scheme == "https", let host = url.host?.lowercased() else { return false }
+        return avatarHosts.contains(host) || Self.googlePhotoHosts.contains(host)
+    }
+
+    /// True for `com.gettarka.tarka:/oauth2redirect…` (schemes are
+    /// case-insensitive).
+    public static func isRedirect(_ url: URL) -> Bool {
+        url.scheme?.lowercased() == redirectURL.scheme && url.path == redirectURL.path
+    }
+}
