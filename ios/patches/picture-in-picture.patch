+
+/// Tark: a video playing when Tark leaves the screen goes into Picture in
+/// Picture.
+class PictureInPictureSetting: BoolSetting {
+    init(prefs: Prefs) {
+        super.init(
+            prefs: prefs,
+            prefKey: BackgroundAudioHelper.pictureInPictureKey,
+            defaultValue: true,
+            attributedTitleText: NSAttributedString(string: "Picture in Picture"),
+            attributedStatusText: NSAttributedString(
+                string: "A playing video keeps going in a small window when you leave Tark."),
+            settingDidChange: { isEnabled in
+                Task { @MainActor in
+                    BackgroundAudioHelper.shared.togglePictureInPicture(isEnabled: isEnabled, prefs: prefs)
+                }
+            }
+        )
+    }
+}
