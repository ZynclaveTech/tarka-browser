+
+// MARK: - Tark: your language (D1)
+
+extension SearchViewModel {
+    /// Whether the person has answered the one-time offer: "yes", "no", or nil.
+    static let tarkXlitAnswerKey = "tark.xlit.answer"
+
+    /// A language row or the offer row: neither fills the address bar.
+    func isTarkRow(_ row: String) -> Bool {
+        return tarkLabels[row] != nil || row == tarkOfferText
+    }
+
+    /// The offer row's text, "Type in हिन्दी?", when it shows.
+    var tarkOfferText: String? {
+        return tarkOffer.map { "Type in \($0.name)?" }
+    }
+
+    /// Adds, after the row for what was typed, the phrase in each ready
+    /// Indian language, or the one-time offer row while nothing is ready.
+    @MainActor
+    func addTarkRows(for query: String) {
+        tarkLabels = [:]
+        tarkOffer = nil
+        guard !query.isEmpty, !query.looksLikeAURL(), TarkTransliteration.looksTransliterable(query) else { return }
+        let xlit = TarkTransliteration.shared
+        let answer = UserDefaults.standard.string(forKey: Self.tarkXlitAnswerKey)
+        if answer == nil, xlit.readyLanguages().isEmpty, let first = TarkTransliteration.languages().first {
+            tarkOffer = first
+            let at = min(1, suggestions?.count ?? 0)
+            if let text = tarkOfferText { suggestions?.insert(text, at: at) }
+            delegate?.reloadTableView()
+            return
+        }
+        if answer == "yes" { startTarkDownload(now: false) }
+        xlit.rows(for: query) { [weak self] rows in
+            guard let self, self.searchQuery == query, !rows.isEmpty else { return }
+            var at = min(1, self.suggestions?.count ?? 0)
+            for row in rows where row.text != query && self.suggestions?.contains(row.text) == false {
+                self.suggestions?.insert(row.text, at: at)
+                self.tarkLabels[row.text] = row.language.name
+                at += 1
+            }
+            self.delegate?.reloadTableView()
+        }
+    }
+
+    /// The person's answer to the offer. "Download now" ignores the Wi-Fi rule.
+    @MainActor
+    func answerTarkOffer(yes: Bool, now: Bool) {
+        UserDefaults.standard.set(yes ? "yes" : "no", forKey: Self.tarkXlitAnswerKey)
+        if let offer = tarkOfferText { suggestions?.removeAll { $0 == offer } }
+        tarkOffer = nil
+        if yes { startTarkDownload(now: now) }
+    }
+
+    @MainActor
+    private func startTarkDownload(now: Bool) {
+        guard !Self.tarkDownloading else { return }
+        Self.tarkDownloading = true
+        let tags = TarkTransliteration.languages().map(\.tag)
+        Task.detached {
+            for tag in tags {
+                _ = await TarkTransliteration.shared.downloader.download(tag, now: now)
+            }
+            await MainActor.run { Self.tarkDownloading = false }
+        }
+    }
+}
