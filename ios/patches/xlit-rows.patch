+// MARK: - Tark: the one-time offer to type in your language
+
+extension SearchViewController {
+    /// A language row shows its language at the edge.
+    func showTarkLanguage(of row: String, in cell: OneLineTableViewCell) {
+        guard let language = viewModel.tarkLabels[row] else { return }
+        let label = UILabel()
+        label.text = language
+        label.font = .preferredFont(forTextStyle: .footnote)
+        label.textColor = .secondaryLabel
+        label.sizeToFit()
+        cell.accessoryView = label
+    }
+
+    func presentTarkOffer() {
+        guard let language = viewModel.tarkOffer else { return }
+        let sheet = UIAlertController(
+            title: "Type in \(language.name)?",
+            message: "Tark downloads about 25 MB once from gettarka.com. What you type is turned "
+                + "into \(language.name) on your phone and never sent anywhere.",
+            preferredStyle: .actionSheet)
+        sheet.addAction(UIAlertAction(title: "Download on Wi-Fi", style: .default) { [weak self] _ in
+            self?.viewModel.answerTarkOffer(yes: true, now: false)
+            self?.reloadData()
+        })
+        sheet.addAction(UIAlertAction(title: "Download now", style: .default) { [weak self] _ in
+            self?.viewModel.answerTarkOffer(yes: true, now: true)
+            self?.reloadData()
+        })
+        sheet.addAction(UIAlertAction(title: "Not now", style: .cancel) { [weak self] _ in
+            self?.viewModel.answerTarkOffer(yes: false, now: false)
+            self?.reloadData()
+        })
+        if traitCollection.userInterfaceIdiom == .pad, let popover = sheet.popoverPresentationController {
+            popover.sourceView = view
+            popover.sourceRect = CGRect(x: view.bounds.midX, y: view.bounds.midY, width: 0, height: 0)
+            popover.permittedArrowDirections = []
+        }
+        present(sheet, animated: true)
+    }
+}
