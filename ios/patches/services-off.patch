+
+// MARK: - Tark network guard
+
+/// Tark: refuses every request the app makes with URLSession to Mozilla's
+/// services, as a backstop to switching them off at their source. Pages in
+/// WKWebView are not affected. Rust components (viaduct) bypass URLSession
+/// and are switched off where they start.
+final class TarkNetworkGuard: URLProtocol {
+    static let blockedDomains = [
+        "mozilla.org", "mozilla.com", "mozilla.net", "mozaws.net", "mozgcp.net",
+        "allizom.org", "firefox.com", "getpocket.com", "sentry.io"
+    ]
+
+    static func isBlocked(_ host: String) -> Bool {
+        let host = host.lowercased()
+        return blockedDomains.contains { host == $0 || host.hasSuffix("." + $0) }
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool {
+        guard let host = request.url?.host else { return false }
+        let blocked = isBlocked(host)
+        #if MOZ_CHANNEL_developer
+        DefaultLogger.shared.log("TarkNet \(blocked ? "block" : "allow") \(host)", level: .info, category: .lifecycle)
+        #endif
+        return blocked
+    }
+
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest {
+        return request
+    }
+
+    override func startLoading() {
+        client?.urlProtocol(self, didFailWithError: URLError(.notConnectedToInternet))
+    }
+
+    override func stopLoading() {}
+
+    /// Puts the guard in front of the shared session and of every session
+    /// made from the default or ephemeral configuration.
+    static func install() {
+        URLProtocol.registerClass(TarkNetworkGuard.self)
+        let pairs = [
+            ("defaultSessionConfiguration", #selector(URLSessionConfiguration.tarkDefault)),
+            ("ephemeralSessionConfiguration", #selector(URLSessionConfiguration.tarkEphemeral))
+        ]
+        for (name, replacement) in pairs {
+            guard let original = class_getClassMethod(URLSessionConfiguration.self, NSSelectorFromString(name)),
+                  let swapped = class_getClassMethod(URLSessionConfiguration.self, replacement) else { continue }
+            method_exchangeImplementations(original, swapped)
+        }
+        #if MOZ_CHANNEL_developer
+        DefaultLogger.shared.log("TarkNet installed, default config guarded: \(URLSessionConfiguration.default.protocolClasses?.first == TarkNetworkGuard.self)", level: .info, category: .lifecycle)
+        #endif
+    }
+}
+
+extension URLSessionConfiguration {
+    // After install() these selectors run the original implementations.
+    @objc class func tarkDefault() -> URLSessionConfiguration {
+        return Self.guarded(tarkDefault())
+    }
+
+    @objc class func tarkEphemeral() -> URLSessionConfiguration {
+        return Self.guarded(tarkEphemeral())
+    }
+
+    private class func guarded(_ configuration: URLSessionConfiguration) -> URLSessionConfiguration {
+        configuration.protocolClasses = [TarkNetworkGuard.self] + (configuration.protocolClasses ?? [])
+        return configuration
+    }
+}
