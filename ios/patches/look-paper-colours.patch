index 215eed7..b285614 100644
--- a/BrowserKit/Sources/Common/Theming/NovaColors.swift
+++ b/BrowserKit/Sources/Common/Theming/NovaColors.swift
@@ -153,3 +153,32 @@ final class NovaColors {
     static let Blue80 = UIColor(rgb: 0x17214c)
     static let Blue90 = UIColor(rgb: 0x111524)
 }
+
+/// Tark: the Paper colours (the Mac's tokens, as on Android's
+/// `look-paper-palette`). Nova's themes point their tokens at these.
+struct TarkPaper {
+    let paper: UIColor
+    let raised: UIColor
+    let sunk: UIColor
+    let ink: UIColor
+    let soft: UIColor
+    let faint: UIColor
+    let rule: UIColor
+    let ruleStrong: UIColor
+    let indigo: UIColor
+    let indigoPressed: UIColor
+    let onIndigo: UIColor
+
+    static let light = TarkPaper(
+        paper: UIColor(rgb: 0xf6f1e7), raised: UIColor(rgb: 0xfffdf8), sunk: UIColor(rgb: 0xede6d8),
+        ink: UIColor(rgb: 0x14142b), soft: UIColor(rgb: 0x4d473d), faint: UIColor(rgb: 0x6f6757),
+        rule: UIColor(rgb: 0xd9d0bf), ruleStrong: UIColor(rgb: 0xc4b9a4),
+        indigo: UIColor(rgb: 0x4338ca), indigoPressed: UIColor(rgb: 0x3730a3), onIndigo: UIColor(rgb: 0xffffff)
+    )
+    static let dark = TarkPaper(
+        paper: UIColor(rgb: 0x12121c), raised: UIColor(rgb: 0x1b1b29), sunk: UIColor(rgb: 0x232334),
+        ink: UIColor(rgb: 0xf3efe6), soft: UIColor(rgb: 0xbdb6a8), faint: UIColor(rgb: 0x948d80),
+        rule: UIColor(rgb: 0x2c2c3d), ruleStrong: UIColor(rgb: 0x3d3d52),
+        indigo: UIColor(rgb: 0x8f88ff), indigoPressed: UIColor(rgb: 0xa7a1ff), onIndigo: UIColor(rgb: 0x12121c)
+    )
+}
