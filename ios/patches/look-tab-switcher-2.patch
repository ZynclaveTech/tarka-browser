+    /// Tark: shows the page from its top (aspect fill would cut off the top as well as the bottom).
+    private func alignScreenshotToTop() {
+        guard let image = screenshotView.image,
+              image.size.width > 0, image.size.height > 0,
+              screenshotView.bounds.width > 0, screenshotView.bounds.height > 0
+        else { return }
+        let viewSize = screenshotView.bounds.size
+        let imageAspect = image.size.height / image.size.width
+        let viewAspect = viewSize.height / viewSize.width
+        screenshotView.contentMode = .scaleToFill
+        if imageAspect > viewAspect {
+            screenshotView.layer.contentsRect = CGRect(x: 0, y: 0, width: 1, height: viewAspect / imageAspect)
+        } else {
+            let width = imageAspect / viewAspect
+            screenshotView.layer.contentsRect = CGRect(x: (1 - width) / 2, y: 0, width: width, height: 1)
+        }
+    }
