--- a/firefox-ios/Client/Frontend/TabContentsScripts/BackgroundAudioHelper.swift
+++ b/firefox-ios/Client/Frontend/TabContentsScripts/BackgroundAudioHelper.swift
@@ -50,6 +50,15 @@ class BackgroundAudioHelper: Notifiable {
 
     /// Tark: puts `webView`'s video into Picture in Picture.
     static func startPictureInPicture(in webView: WKWebView) {
+        // iOS shows the PiP window only for an app whose audio session is set
+        // for playback (as video apps and Safari are); without it WebKit
+        // switches the page to PiP but no window appears.
+        do {
+            try AVAudioSession.sharedInstance().setCategory(.playback, mode: .moviePlayback)
+            try AVAudioSession.sharedInstance().setActive(true)
+        } catch {
+            // No window then; the page shows its own placeholder.
+        }
         webView.evaluateJavaScript(pictureInPictureJS)
     }
 
