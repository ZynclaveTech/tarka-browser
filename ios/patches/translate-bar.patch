+
+/// Tark: the bar under a translated page — "Hindi → [English ▾] · Show
+/// original". The chip picks another language (Firefox's language switch
+/// re-translates from the original); Show original is the Translate button's
+/// own restore. It watches the toolbar's translation state, so it shows only
+/// while the page is translated.
+final class TarkTranslationBar: UIView, AlphaDimmable, ThemeApplicable, StoreSubscriber {
+    typealias SubscriberStateType = ToolbarState
+
+    private struct UX {
+        static let borderThickness: CGFloat = 1.0
+        static let verticalPadding: CGFloat = 8
+        static let horizontalPadding: CGFloat = 16
+        static let spacing: CGFloat = 8
+    }
+
+    private let windowUUID: WindowUUID
+    private var source: String?
+    private var target: String?
+    private var theme: Theme?
+
+    private var topBorderView: UIView = .build()
+
+    private let sourceLabel: UILabel = .build { label in
+        label.adjustsFontForContentSizeCategory = true
+        label.font = FXFontStyles.Regular.body.scaledFont()
+        label.setContentCompressionResistancePriority(.defaultHigh, for: .horizontal)
+    }
+
+    private lazy var targetChip: UIButton = .build { button in
+        var configuration = UIButton.Configuration.tinted()
+        configuration.cornerStyle = .capsule
+        configuration.image = UIImage(systemName: "chevron.down",
+                                      withConfiguration: UIImage.SymbolConfiguration(scale: .small))
+        configuration.imagePlacement = .trailing
+        configuration.imagePadding = 4
+        configuration.contentInsets = NSDirectionalEdgeInsets(top: 4, leading: 12, bottom: 4, trailing: 10)
+        button.configuration = configuration
+        button.showsMenuAsPrimaryAction = true
+        button.accessibilityHint = "Chooses the language to translate into"
+    }
+
+    private lazy var showOriginalButton: UIButton = .build { button in
+        button.titleLabel?.adjustsFontForContentSizeCategory = true
+        button.titleLabel?.font = FXFontStyles.Regular.body.scaledFont()
+        button.setTitle("Show original", for: .normal)
+        button.addTarget(self, action: #selector(self.didTapShowOriginal), for: .touchUpInside)
+        button.setContentCompressionResistancePriority(.required, for: .horizontal)
+    }
+
+    private lazy var row: UIStackView = .build { stack in
+        stack.axis = .horizontal
+        stack.alignment = .center
+        stack.spacing = UX.spacing
+    }
+
+    init(windowUUID: WindowUUID) {
+        self.windowUUID = windowUUID
+        super.init(frame: .zero)
+        isHidden = true
+        let spacer = UIView()
+        spacer.setContentHuggingPriority(.defaultLow, for: .horizontal)
+        [sourceLabel, targetChip, spacer, showOriginalButton].forEach(row.addArrangedSubview)
+        addSubview(topBorderView)
+        addSubview(row)
+        NSLayoutConstraint.activate([
+            topBorderView.leadingAnchor.constraint(equalTo: leadingAnchor),
+            topBorderView.trailingAnchor.constraint(equalTo: trailingAnchor),
+            topBorderView.topAnchor.constraint(equalTo: topAnchor),
+            topBorderView.heightAnchor.constraint(equalToConstant: UX.borderThickness),
+            row.topAnchor.constraint(equalTo: topBorderView.bottomAnchor, constant: UX.verticalPadding),
+            row.bottomAnchor.constraint(equalTo: bottomAnchor, constant: -UX.verticalPadding),
+            row.leadingAnchor.constraint(equalTo: safeAreaLayoutGuide.leadingAnchor,
+                                         constant: UX.horizontalPadding),
+            row.trailingAnchor.constraint(equalTo: safeAreaLayoutGuide.trailingAnchor,
+                                          constant: -UX.horizontalPadding),
+        ])
+        subscribeToRedux()
+    }
+
+    func subscribeToRedux() {
+        let windowUUID = windowUUID
+        store.subscribe(self, transform: {
+            $0.select { appState in ToolbarState(appState: appState, uuid: windowUUID) }
+        })
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        // As NavigationToolbarContainer: the store holds subscribers weakly,
+        // so off the main thread there is nothing to clean up safely.
+        guard Thread.isMainThread else { return }
+        MainActor.assumeIsolated { store.unsubscribe(self) }
+    }
+
+    func newState(state: ToolbarState) {
+        let configuration = state.addressToolbar.translationConfiguration
+        guard configuration?.state == .active,
+              let source = configuration?.sourceLanguage,
+              let target = configuration?.translatedToLanguage else {
+            isHidden = true
+            return
+        }
+        isHidden = false
+        guard source != self.source || target != self.target else { return }
+        self.source = source
+        self.target = target
+        sourceLabel.text = "\(Self.name(source)) →"
+        targetChip.configuration?.title = Self.name(target)
+        targetChip.accessibilityLabel = "Translated into \(Self.name(target))"
+        targetChip.menu = UIMenu(children: TarkTranslationModelsFetcher.languages
+            .filter { $0 != source }
+            .map { code in
+                UIAction(title: Self.name(code), state: code == target ? .on : .off) { [weak self] _ in
+                    guard let self, code != self.target else { return }
+                    store.dispatch(TranslationLanguageSelectedAction(
+                        windowUUID: self.windowUUID,
+                        targetLanguage: code,
+                        actionType: TranslationsActionType.didSelectTargetLanguage
+                    ))
+                }
+            })
+    }
+
+    @objc
+    private func didTapShowOriginal() {
+        store.dispatch(ToolbarMiddlewareAction(
+            buttonType: .translate,
+            gestureType: .tap,
+            windowUUID: windowUUID,
+            actionType: ToolbarMiddlewareActionType.didTapButton
+        ))
+    }
+
+    private static func name(_ code: String) -> String {
+        return Locale.current.localizedString(forLanguageCode: code) ?? code
+    }
+
+    // MARK: - AlphaDimmable
+
+    func updateAlphaForSubviews(_ alpha: CGFloat) {
+        self.alpha = alpha
+    }
+
+    // MARK: - ThemeApplicable
+
+    func applyTheme(theme: Theme) {
+        backgroundColor = theme.colors.layer1
+        topBorderView.backgroundColor = theme.colors.borderPrimary
+        sourceLabel.textColor = theme.colors.textPrimary
+        targetChip.tintColor = theme.colors.actionPrimary
+        targetChip.configuration?.baseForegroundColor = theme.colors.textAccent
+        showOriginalButton.setTitleColor(theme.colors.textAccent, for: .normal)
+    }
+}
