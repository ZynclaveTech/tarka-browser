+    /// Deletes files in `direction`'s folder that the app no longer pins
+    /// (e.g. .onnx models replaced by .ort), keeping pinned files and their
+    /// .sha256 and .resume companions.
+    func removeUnpinned(_ direction: Direction) {
+        let folder = directory.appendingPathComponent(direction.rawValue)
+        let pinned = Set(Self.names(direction).map { $0.components(separatedBy: "/")[1] })
+        let files = (try? FileManager.default.contentsOfDirectory(atPath: folder.path)) ?? []
+        for file in files {
+            let base = file.hasSuffix(".sha256") || file.hasSuffix(".resume")
+                ? String(file[..<file.lastIndex(of: ".")!]) : file
+            if !pinned.contains(base) {
+                try? FileManager.default.removeItem(at: folder.appendingPathComponent(file))
+            }
+        }
+    }
+
     /// Deletes `direction`'s files, finished or part-downloaded.
