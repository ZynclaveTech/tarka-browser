diff --git a/BrowserKit/Sources/TarkAdblock/TarkAdblockEngine.swift b/BrowserKit/Sources/TarkAdblock/TarkAdblockEngine.swift
new file mode 100644
index 0000000..a0f6d96
--- /dev/null
+++ b/BrowserKit/Sources/TarkAdblock/TarkAdblockEngine.swift
@@ -0,0 +1,79 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import TarkAdblockFFI
+
+/// Tark: adblock-rust in the app (the engine Tark for Android ships), for
+/// what WebKit's content blockers cannot do: hiding page elements with
+/// per-site exceptions, and scriptlets. All calls go through one serial
+/// queue; the engine is not thread-safe.
+public final class TarkAdblockEngine: @unchecked Sendable {
+    /// What one page gets: selectors to hide, generic-rule exceptions,
+    /// scriptlet code, and whether generic hiding is off for it.
+    public struct PageResources: Decodable, Sendable {
+        public let hideSelectors: [String]
+        public let exceptions: [String]
+        public let injectedScript: String
+        public let generichide: Bool
+
+        enum CodingKeys: String, CodingKey {
+            case hideSelectors = "hide_selectors"
+            case exceptions
+            case injectedScript = "injected_script"
+            case generichide
+        }
+    }
+
+    private let engine: OpaquePointer
+    private let queue = DispatchQueue(label: "com.gettarka.adblock.engine")
+
+    /// Loads `engine.dat` (serialized by listtool engine) and `resources.json`.
+    public init?(dat: Data, resourcesJSON: String) {
+        let pointer = dat.withUnsafeBytes { bytes in
+            resourcesJSON.withCString { resources in
+                tark_engine_new(bytes.bindMemory(to: UInt8.self).baseAddress, bytes.count, resources)
+            }
+        }
+        guard let pointer else { return nil }
+        engine = pointer
+    }
+
+    deinit {
+        tark_engine_free(engine)
+    }
+
+    public func pageResources(for url: URL, completion: @escaping @Sendable (PageResources?) -> Void) {
+        queue.async { [self] in
+            let json = Self.take(url.absoluteString.withCString { tark_url_cosmetic_resources(engine, $0) })
+            completion(json.flatMap { try? JSONDecoder().decode(PageResources.self, from: Data($0.utf8)) })
+        }
+    }
+
+    public func hiddenSelectors(classes: [String],
+                                ids: [String],
+                                exceptions: [String],
+                                completion: @escaping @Sendable ([String]) -> Void) {
+        queue.async { [self] in
+            let encode = { (list: [String]) in
+                String(data: (try? JSONEncoder().encode(list)) ?? Data("[]".utf8), encoding: .utf8) ?? "[]"
+            }
+            let json = encode(classes).withCString { c in
+                encode(ids).withCString { i in
+                    encode(exceptions).withCString { e in
+                        Self.take(tark_hidden_class_id_selectors(engine, c, i, e))
+                    }
+                }
+            }
+            completion(json.flatMap { try? JSONDecoder().decode([String].self, from: Data($0.utf8)) } ?? [])
+        }
+    }
+
+    /// Copies a string the library returned and frees it.
+    private static func take(_ pointer: UnsafeMutablePointer<CChar>?) -> String? {
+        guard let pointer else { return nil }
+        defer { tark_string_free(pointer) }
+        return String(cString: pointer)
+    }
+}
