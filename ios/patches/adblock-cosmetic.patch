     }
 }
+
+// MARK: - Tark element hiding and scriptlets
+
+/// Tark: hides page elements and runs scriptlets with adblock-rust in the app
+/// (TarkAdblockEngine), as Brave does on iOS; network blocking stays in
+/// WebKit's content blockers. A script in Firefox's isolated client world
+/// asks for the page's own hide rules and scriptlets, then reports the class
+/// and id names it sees; the engine answers with the generic hide rules for
+/// them, minus the page's exceptions. Off wherever blocking is off.
+@MainActor
+final class TarkCosmeticFilter: TabContentScript {
+    private static let messageName = "tarkCosmetic"
+
+    /// Loaded once, off the main thread, from the files `build.py lists`
+    /// bundles beside the WebKit rules.
+    private static let engine = Task.detached(priority: .utility) { () -> TarkAdblockEngine? in
+        guard let datURL = Bundle.main.url(forResource: "tark-engine", withExtension: "dat"),
+              let resourcesURL = Bundle.main.url(forResource: "tark-resources", withExtension: "json"),
+              let dat = try? Data(contentsOf: datURL),
+              let resources = try? String(contentsOf: resourcesURL, encoding: .utf8) else { return nil }
+        return TarkAdblockEngine(dat: dat, resourcesJSON: resources)
+    }
+
+    static let userScript = WKUserScript(source: script,
+                                         injectionTime: .atDocumentStart,
+                                         forMainFrameOnly: false,
+                                         in: .defaultClient)
+
+    private weak var tab: Tab?
+
+    init(tab: Tab) {
+        self.tab = tab
+    }
+
+    static func name() -> String {
+        return "TarkCosmeticFilter"
+    }
+
+    func scriptMessageHandlerNames() -> [String]? {
+        return [Self.messageName]
+    }
+
+    func prepareForDeinit() {}
+
+    func userContentController(_ userContentController: WKUserContentController,
+                               didReceiveScriptMessage message: WKScriptMessage) {
+        guard let body = message.body as? [String: Any],
+              let href = body["href"] as? String,
+              let url = URL(string: href),
+              url.scheme == "http" || url.scheme == "https",
+              let tab, tab.contentBlocker?.isEnabled == true,
+              !ContentBlocker.shared.isSafelisted(url: tab.url ?? url),
+              let webView = message.webView else { return }
+        let frame = message.frameInfo
+        switch body["kind"] as? String {
+        case "page":
+            Task {
+                guard let engine = await Self.engine.value else { return }
+                engine.pageResources(for: url) { resources in
+                    guard let resources else { return }
+                    Task { @MainActor [weak webView] in
+                        if !resources.injectedScript.isEmpty {
+                            webView?.evaluateJavaScript(resources.injectedScript, in: frame, in: .page)
+                        }
+                        let page: [String: Any] = ["hideSelectors": resources.hideSelectors,
+                                                   "exceptions": resources.exceptions,
+                                                   "generichide": resources.generichide]
+                        Self.call("page", with: page, in: webView, frame: frame)
+                    }
+                }
+            }
+        case "names":
+            let classes = body["classes"] as? [String] ?? []
+            let ids = body["ids"] as? [String] ?? []
+            let exceptions = body["exceptions"] as? [String] ?? []
+            Task {
+                guard let engine = await Self.engine.value else { return }
+                engine.hiddenSelectors(classes: classes, ids: ids, exceptions: exceptions) { selectors in
+                    guard !selectors.isEmpty else { return }
+                    Task { @MainActor [weak webView] in
+                        Self.call("hide", with: selectors, in: webView, frame: frame)
+                    }
+                }
+            }
+        default:
+            return
+        }
+    }
+
+    private static func call(_ function: String, with argument: Any, in webView: WKWebView?, frame: WKFrameInfo) {
+        guard let data = try? JSONSerialization.data(withJSONObject: argument),
+              let json = String(data: data, encoding: .utf8) else { return }
+        webView?.evaluateJavaScript("window.__tarkCosmetic && window.__tarkCosmetic.\(function)(\(json))",
+                                    in: frame,
+                                    in: .defaultClient)
+    }
+
+    private static let script = """
+    (function () {
+      if (window.__tarkCosmetic) { return; }
+      const send = (m) => { try { webkit.messageHandlers.tarkCosmetic.postMessage(m); } catch (e) {} };
+      const seenClasses = new Set(), seenIds = new Set(), classes = new Set(), ids = new Set();
+      let exceptions = [], generic = true, ready = false, timer = null, style = null;
+      const hide = (selectors) => {
+        if (!selectors.length) { return; }
+        if (!style) { style = document.createElement('style'); }
+        if (!style.isConnected) { (document.head || document.documentElement).appendChild(style); }
+        // One rule per selector: an invalid selector drops only its own rule.
+        style.textContent += selectors.map((s) => s + '{display:none!important}').join('\\n') + '\\n';
+      };
+      const note = (el) => {
+        if (el.id && !seenIds.has(el.id)) { seenIds.add(el.id); ids.add(el.id); }
+        if (el.classList) {
+          for (const c of el.classList) { if (!seenClasses.has(c)) { seenClasses.add(c); classes.add(c); } }
+        }
+      };
+      const flush = () => {
+        timer = null;
+        if (!ready || !generic || (!classes.size && !ids.size)) { return; }
+        send({ kind: 'names', href: location.href, classes: [...classes], ids: [...ids], exceptions });
+        classes.clear(); ids.clear();
+      };
+      const schedule = () => { if (!timer) { timer = setTimeout(flush, 100); } };
+      const scan = (root) => {
+        note(root);
+        if (root.querySelectorAll) { for (const el of root.querySelectorAll('[id],[class]')) { note(el); } }
+      };
+      window.__tarkCosmetic = {
+        page: (r) => {
+          exceptions = r.exceptions; generic = !r.generichide; ready = true;
+          hide(r.hideSelectors);
+          if (document.documentElement) { scan(document.documentElement); }
+          schedule();
+        },
+        hide,
+      };
+      new MutationObserver((mutations) => {
+        for (const m of mutations) {
+          if (m.type === 'attributes') { note(m.target); continue; }
+          for (const n of m.addedNodes) { if (n.nodeType === 1) { scan(n); } }
+        }
+        schedule();
+      }).observe(document, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'id'] });
+      send({ kind: 'page', href: location.href });
+    })();
+    """
+}
