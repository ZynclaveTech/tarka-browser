index 0000000..07a0b70
--- /dev/null
+++ b/BrowserKit/Sources/TarkTranslate/TarkPageTranslator.swift
@@ -0,0 +1,113 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import TarkTranslateCore
+import UIKit
+
+/// Tark: translates text on the phone with IndicTrans2 (tark_captions'
+/// translator). Holds **one model at a time** (the user's decision, to stay
+/// under 450 MB): Indian ↔ Indian translates the whole batch into English,
+/// frees that model, then loads the other. The model is freed after 3
+/// minutes unused and when Tark goes to the background. Nothing leaves the
+/// phone.
+public final class TarkPageTranslator: @unchecked Sendable {
+    public static let shared = TarkPageTranslator()
+
+    static let idleTimeout: TimeInterval = 180
+
+    private let models: TarkTranslateModels
+    /// Everything that touches `translator` runs here, one sentence at a time.
+    private let queue = DispatchQueue(label: "com.gettarka.translate", qos: .userInitiated)
+    private var translator: OpaquePointer?
+    private var loaded: TarkTranslateModels.Direction?
+    private var idleUnload: DispatchWorkItem?
+
+    public init(models: TarkTranslateModels = .shared) {
+        self.models = models
+        NotificationCenter.default.addObserver(forName: UIApplication.didEnterBackgroundNotification,
+                                               object: nil, queue: nil) { [weak self] _ in
+            self?.unload()
+        }
+    }
+
+    deinit {
+        if let translator { tark_translator_destroy(translator) }
+    }
+
+    /// The direction loaded now, if any (for tests and memory checks).
+    public var loadedDirection: TarkTranslateModels.Direction? {
+        return queue.sync { loaded }
+    }
+
+    /// `texts` from `source` into `target` ("en", "hi", "ta", ...), in order;
+    /// nil for a sentence that failed (the page keeps its original). Needs the
+    /// models of the directions it goes through (TarkTranslateModels).
+    public func translate(_ texts: [String], from source: String, to target: String) async -> [String?] {
+        guard source != target else { return texts }
+        var current: [String?] = texts
+        if source != "en" {
+            current = await run(.indicToEnglish, current, language: source)
+        }
+        if target != "en" {
+            current = await run(.englishToIndic, current, language: target)
+        }
+        return current
+    }
+
+    /// Frees the model now.
+    public func unload() {
+        queue.async { self.free() }
+    }
+
+    private func run(_ direction: TarkTranslateModels.Direction,
+                     _ texts: [String?],
+                     language: String) async -> [String?] {
+        await withCheckedContinuation { continuation in
+            queue.async {
+                guard let translator = self.load(direction) else {
+                    continuation.resume(returning: texts.map { _ in nil })
+                    return
+                }
+                let out: [String?] = texts.map { text in
+                    guard let text else { return nil }
+                    guard let result = tark_translator_translate(translator, text, language) else { return nil }
+                    defer { tark_translate_free(result) }
+                    return String(cString: result)
+                }
+                self.scheduleIdleUnload()
+                continuation.resume(returning: out)
+            }
+        }
+    }
+
+    /// On `queue`. Frees the other direction's model before loading this one.
+    private func load(_ direction: TarkTranslateModels.Direction) -> OpaquePointer? {
+        if loaded == direction, let translator { return translator }
+        free()
+        guard models.isReady(direction) else { return nil }
+        let raw: TarkTranslateDirection = direction == .indicToEnglish
+            ? TARK_TRANSLATE_INDIC_TO_ENGLISH : TARK_TRANSLATE_ENGLISH_TO_INDIC
+        translator = models.directory.path.withCString { tark_translator_create($0, raw) }
+        loaded = translator == nil ? nil : direction
+        return translator
+    }
+
+    /// On `queue`.
+    private func free() {
+        idleUnload?.cancel()
+        idleUnload = nil
+        if let translator { tark_translator_destroy(translator) }
+        translator = nil
+        loaded = nil
+    }
+
+    /// On `queue`.
+    private func scheduleIdleUnload() {
+        idleUnload?.cancel()
+        let work = DispatchWorkItem { [weak self] in self?.free() }
+        idleUnload = work
+        queue.asyncAfter(deadline: .now() + Self.idleTimeout, execute: work)
+    }
+}
