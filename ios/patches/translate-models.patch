+++ b/BrowserKit/Tests/TarkTranslateTests/TarkTranslateTests.swift
@@ -0,0 +1,93 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import XCTest
+@testable import TarkTranslate
+
+final class TarkTranslateModelsTests: XCTestCase {
+    private var folder: URL!
+
+    override func setUp() {
+        super.setUp()
+        folder = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    }
+
+    override func tearDown() {
+        try? FileManager.default.removeItem(at: folder)
+        super.tearDown()
+    }
+
+    func testEachDirectionPinsTheSixFilesAndroidPublishes() {
+        for direction in TarkTranslateModels.Direction.allCases {
+            XCTAssertEqual(TarkTranslateModels.names(direction).map { $0.components(separatedBy: "/")[1] },
+                           ["config.json", "decoder_step.int8.onnx", "dict.SRC.json", "dict.TGT.json",
+                            "encoder.int8.onnx", "model.SRC"])
+        }
+        XCTAssertEqual(TarkTranslateModels.size(.indicToEnglish), 238_880_795)
+        XCTAssertEqual(TarkTranslateModels.size(.englishToIndic), 282_651_524)
+    }
+
+    func testAFileThatIsNotThePinnedOneIsDeleted() throws {
+        let models = TarkTranslateModels(directory: folder)
+        let name = "it2_indic_en/config.json"
+        try FileManager.default.createDirectory(at: models.path("it2_indic_en"), withIntermediateDirectories: true)
+        // The pinned size, other bytes.
+        try Data(count: 1370).write(to: models.path(name))
+        XCTAssertFalse(models.isVerified(name))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: models.path(name).path))
+        XCTAssertFalse(models.isReady(.indicToEnglish))
+    }
+
+    func testDeleteRemovesTheDirectionOnly() throws {
+        let models = TarkTranslateModels(directory: folder)
+        for direction in TarkTranslateModels.Direction.allCases {
+            try FileManager.default.createDirectory(at: models.path(direction.rawValue),
+                                                    withIntermediateDirectories: true)
+            try Data(count: 10).write(to: models.path(direction.rawValue + "/model.SRC.resume"))
+        }
+        models.delete(.indicToEnglish)
+        XCTAssertEqual(models.bytesOnPhone(.indicToEnglish), 0)
+        XCTAssertEqual(models.bytesOnPhone(.englishToIndic), 10)
+    }
+
+    func testWithoutModelsEverySentenceKeepsItsOriginal() async {
+        let translator = TarkPageTranslator(models: TarkTranslateModels(directory: folder))
+        let out = await translator.translate(["नमस्ते"], from: "hi", to: "en")
+        XCTAssertEqual(out, [nil])
+        XCTAssertNil(translator.loadedDirection)
+    }
+}
+
+/// Downloads both models from gettarka.com (~490 MB, kept between runs) and
+/// translates with them. Only with TARK_TRANSLATE_NETWORK=1 (xcodebuild:
+/// TEST_RUNNER_TARK_TRANSLATE_NETWORK=1).
+final class TarkTranslateDownloadTests: XCTestCase {
+    func testDownloadsCheckedModelsAndHoldsOneAtATime() async throws {
+        try XCTSkipUnless(ProcessInfo.processInfo.environment["TARK_TRANSLATE_NETWORK"] == "1")
+        let folder = FileManager.default.temporaryDirectory.appendingPathComponent("tark-translate-download")
+        let models = TarkTranslateModels(directory: folder)
+        let translator = TarkPageTranslator(models: models)
+
+        let indicToEnglish = await models.download(.indicToEnglish, now: true)
+        XCTAssertEqual("\(indicToEnglish)", "ready")
+        let english = await translator.translate(["मुझे आज बाज़ार जाना है।"], from: "hi", to: "en")
+        let sentence = try XCTUnwrap(english.first ?? nil)
+        print("hi→en:", sentence)
+        XCTAssertTrue(sentence.lowercased().contains("market"))
+        XCTAssertEqual(translator.loadedDirection, .indicToEnglish)
+
+        let englishToIndic = await models.download(.englishToIndic, now: true)
+        XCTAssertEqual("\(englishToIndic)", "ready")
+        let tamil = await translator.translate(["मुझे आज बाज़ार जाना है।"], from: "hi", to: "ta")
+        let tamilSentence = try XCTUnwrap(tamil.first ?? nil)
+        print("hi→ta:", tamilSentence)
+        XCTAssertTrue(tamilSentence.unicodeScalars.contains { (0x0B80...0x0BFF).contains($0.value) })
+        // Indian ↔ Indian went through English and kept only the second model.
+        XCTAssertEqual(translator.loadedDirection, .englishToIndic)
+
+        translator.unload()
+        XCTAssertNil(translator.loadedDirection)
+    }
+}
