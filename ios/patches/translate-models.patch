index 0000000..7eb2e01
--- /dev/null
+++ b/BrowserKit/Sources/TarkTranslate/TarkTranslateModels.swift
@@ -0,0 +1,166 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import Foundation
+import TarkXlit
+
+/// Tark: page translation's IndicTrans2 models, the files Tark for Android
+/// downloads, content-addressed on gettarka.com and checked against the size
+/// and sha256 compiled into the app (TarkTranslateFiles). One folder per
+/// direction under Application Support/tark-translate; a file that does not
+/// match is deleted. A download cut off part way resumes where it stopped.
+public final class TarkTranslateModels: NSObject, @unchecked Sendable, URLSessionTaskDelegate {
+    public enum Direction: String, CaseIterable, Sendable {
+        /// Indian languages → English (~221 MB).
+        case indicToEnglish = "it2_indic_en"
+        /// English → Indian languages (~265 MB).
+        case englishToIndic = "it2_en_indic"
+    }
+
+    public enum Outcome: Sendable {
+        case ready
+        /// Not tried: cellular or a constrained network, without "Download now".
+        case waitingForWiFi
+        /// Tried and did not get verified files.
+        case failed
+    }
+
+    public static let baseURL = URL(string: "https://gettarka.com/models/android/v1/")!
+    private static let triesPerRun = 3
+
+    public static let shared = TarkTranslateModels()
+
+    /// Application Support/tark-translate, kept out of backups; the engine
+    /// reads <directory>/<direction>/.
+    public let directory: URL
+    private lazy var session = URLSession(configuration: .ephemeral, delegate: self, delegateQueue: nil)
+
+    public init(directory: URL? = nil) {
+        let base = directory ?? FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("tark-translate", isDirectory: true)
+        try? FileManager.default.createDirectory(at: base, withIntermediateDirectories: true)
+        var values = URLResourceValues()
+        values.isExcludedFromBackup = true
+        var excluded = base
+        try? excluded.setResourceValues(values)
+        self.directory = base
+    }
+
+    /// The pinned files of `direction`, as "<direction>/<file>".
+    static func names(_ direction: Direction) -> [String] {
+        return TarkTranslateFiles.table.keys.filter { $0.hasPrefix(direction.rawValue + "/") }.sorted()
+    }
+
+    /// The download size of `direction`.
+    public static func size(_ direction: Direction) -> Int64 {
+        return names(direction).reduce(0) { $0 + (TarkTranslateFiles.table[$1]?.size ?? 0) }
+    }
+
+    func path(_ name: String) -> URL {
+        return directory.appendingPathComponent(name)
+    }
+
+    /// Every file of `direction` present and checked.
+    public func isReady(_ direction: Direction) -> Bool {
+        return Self.names(direction).allSatisfy(isVerified)
+    }
+
+    /// Bytes of `direction` on the phone (checked or not), for "On this phone".
+    public func bytesOnPhone(_ direction: Direction) -> Int64 {
+        let folder = directory.appendingPathComponent(direction.rawValue)
+        guard let files = try? FileManager.default.contentsOfDirectory(
+            at: folder, includingPropertiesForKeys: [.fileSizeKey]) else { return 0 }
+        return files.reduce(0) { total, file in
+            total + Int64((try? file.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0)
+        }
+    }
+
+    /// Whether the file is there with the size and hash the app pins. A
+    /// "<name>.sha256" record beside it saves hashing it on every start.
+    func isVerified(_ name: String) -> Bool {
+        guard let pinned = TarkTranslateFiles.table[name] else { return false }
+        let file = path(name)
+        let record = path(name + ".sha256")
+        guard let attributes = try? FileManager.default.attributesOfItem(atPath: file.path),
+              (attributes[.size] as? NSNumber)?.int64Value == pinned.size else { return false }
+        if (try? String(contentsOf: record, encoding: .utf8)) == pinned.sha256 { return true }
+        guard TarkXlitDownloader.sha256(of: file) == pinned.sha256 else {
+            try? FileManager.default.removeItem(at: file)
+            return false
+        }
+        try? pinned.sha256.write(to: record, atomically: true, encoding: .utf8)
+        return true
+    }
+
+    /// Downloads what `direction` still needs. Cellular or a constrained
+    /// network waits unless `now` (the person chose "Download now").
+    /// `progress` gets the bytes of `direction` checked so far after each file.
+    public func download(_ direction: Direction,
+                         now: Bool,
+                         progress: (@Sendable (Int64, Int64) -> Void)? = nil) async -> Outcome {
+        if !now, await !TarkXlitDownloader.isUnmeteredNetwork() { return .waitingForWiFi }
+        let total = Self.size(direction)
+        try? FileManager.default.createDirectory(at: directory.appendingPathComponent(direction.rawValue),
+                                                 withIntermediateDirectories: true)
+        var done: Int64 = 0
+        for name in Self.names(direction) {
+            if !isVerified(name) {
+                var fetched = false
+                for _ in 0..<Self.triesPerRun where !fetched {
+                    if Task.isCancelled { return .failed }
+                    fetched = await fetch(name)
+                }
+                if !fetched { return .failed }
+            }
+            done += TarkTranslateFiles.table[name]?.size ?? 0
+            progress?(done, total)
+        }
+        return isReady(direction) ? .ready : .failed
+    }
+
+    /// Deletes `direction`'s files, finished or part-downloaded.
+    public func delete(_ direction: Direction) {
+        try? FileManager.default.removeItem(at: directory.appendingPathComponent(direction.rawValue))
+    }
+
+    private func fetch(_ name: String) async -> Bool {
+        guard let pinned = TarkTranslateFiles.table[name] else { return false }
+        let url = Self.baseURL.appendingPathComponent("\(pinned.sha256).bin")
+        // What an earlier, cut-off try left: URLSession's resume data, so the
+        // file continues from where it stopped (gettarka.com serves ranges).
+        let resumeFile = path(name + ".resume")
+        let temporary: URL
+        let response: URLResponse
+        do {
+            if let resumeData = try? Data(contentsOf: resumeFile) {
+                try? FileManager.default.removeItem(at: resumeFile)
+                (temporary, response) = try await session.download(resumeFrom: resumeData)
+            } else {
+                (temporary, response) = try await session.download(from: url)
+            }
+        } catch {
+            if let resumeData = (error as? URLError)?.downloadTaskResumeData {
+                try? resumeData.write(to: resumeFile)
+            }
+            return false
+        }
+        defer { try? FileManager.default.removeItem(at: temporary) }
+        // 206 when resumed.
+        guard let status = (response as? HTTPURLResponse)?.statusCode, status == 200 || status == 206,
+              TarkXlitDownloader.sha256(of: temporary) == pinned.sha256 else { return false }
+        let file = path(name)
+        try? FileManager.default.removeItem(at: file)
+        guard (try? FileManager.default.moveItem(at: temporary, to: file)) != nil else { return false }
+        try? pinned.sha256.write(to: path(name + ".sha256"), atomically: true, encoding: .utf8)
+        return true
+    }
+
+    /// Never follows a redirect: the files come from gettarka.com only.
+    public func urlSession(_ session: URLSession,
+                           task: URLSessionTask,
+                           willPerformHTTPRedirection response: HTTPURLResponse,
+                           newRequest request: URLRequest) async -> URLRequest? {
+        return nil
+    }
+}
