+/// Tark: tells the tab whether a video on its page is playing (for the
+/// Picture in Picture menu item and address bar button). Main frame only.
+@MainActor
+final class TarkVideoStateHelper: TabContentScript {
+    static let handlerName = "tarkVideoState"
+
+    private static let script = """
+        (() => {
+          if (window.__tarkVideoState) { return; }
+          window.__tarkVideoState = true;
+          let last = null;
+          const post = playing => {
+            if (playing === last) { return; }
+            last = playing;
+            window.webkit.messageHandlers.tarkVideoState.postMessage({ playing });
+          };
+          const report = () => post([...document.querySelectorAll('video')]
+            .some(v => !v.paused && !v.ended && v.readyState > 2));
+          ['play', 'playing', 'pause', 'ended', 'emptied'].forEach(type =>
+            document.addEventListener(type, () => setTimeout(report, 0), true));
+          window.addEventListener('pagehide', () => post(false));
+        })();
+        """
+
+    /// Added with the other page scripts (UserScriptManager), which are
+    /// cleared and re-added together.
+    static let userScript = WKUserScript(
+        source: script, injectionTime: .atDocumentEnd, forMainFrameOnly: true, in: .defaultClient)
+
+    private weak var tab: Tab?
+
+    init(tab: Tab) {
+        self.tab = tab
+    }
+
+    static func name() -> String { return "TarkVideoState" }
+
+    func scriptMessageHandlerNames() -> [String]? { return [Self.handlerName] }
+
+    func userContentController(_ userContentController: WKUserContentController,
+                               didReceiveScriptMessage message: WKScriptMessage) {
+        guard let body = message.body as? [String: Any], let playing = body["playing"] as? Bool else { return }
+        tab?.tarkHasPlayingVideo = playing
+    }
+}
