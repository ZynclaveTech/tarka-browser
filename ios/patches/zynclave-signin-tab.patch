+// found in the LICENSE file.
+
+@preconcurrency import AppAuthCore
+import Foundation
+
+/// AppAuth's "external user agent" as a Tark tab: the login page opens in a
+/// normal (never Private) tab of the person's own browser, so the Zynclave
+/// session lands in Tark's cookies, where Shodhya and Zynclave's other sites
+/// in Tark can use it. Not ASWebAuthenticationSession or Safari: those keep
+/// the session in Safari. The tab shows the real address bar and padlock.
+/// Tark catches the redirect in the tab's navigation and hands it to
+/// `TarkAccount.resume(with:)`; AppAuth then dismisses, which closes the tab.
+@MainActor
+public final class TarkTabUserAgent: NSObject, OIDExternalUserAgent {
+    private let open: @MainActor (URL) -> Void
+    private let close: @MainActor () -> Void
+
+    /// `open` shows the authorization URL in a new normal tab; `close`
+    /// closes that tab if it is still open.
+    public init(open: @escaping @MainActor (URL) -> Void, close: @escaping @MainActor () -> Void) {
+        self.open = open
+        self.close = close
+    }
+
+    nonisolated public func present(_ request: OIDExternalUserAgentRequest,
+                                    session: OIDExternalUserAgentSession) -> Bool {
+        guard let url = request.externalUserAgentRequestURL() else { return false }
+        MainActor.assumeIsolated { open(url) }
+        return true
+    }
+
+    nonisolated public func dismiss(animated: Bool, completion: @escaping () -> Void) {
+        MainActor.assumeIsolated { close() }
+        completion()
+    }
+}
