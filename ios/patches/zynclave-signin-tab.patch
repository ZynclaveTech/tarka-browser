+// MARK: - Tark: Sign in with Zynclave
+
+/// The tab Sign in with Zynclave is running in, while it runs.
+@MainActor
+private enum TarkSignInTab {
+    static weak var tab: Tab?
+}
+
+extension BrowserViewController {
+    /// Signs in to Zynclave in a new normal tab (see `TarkTabUserAgent`).
+    /// `prompt: "none"` with no web session ends in `.loginRequired`, and
+    /// the caller retries without it.
+    func startTarkSignIn(prompt: String? = nil, idTokenHint: String? = nil) async throws {
+        let agent = TarkTabUserAgent(
+            open: { [weak self] url in
+                guard let self else { return }
+                TarkSignInTab.tab = self.openURLInNewTab(url, isPrivate: false)
+            },
+            close: { [weak self] in
+                guard let tab = TarkSignInTab.tab else { return }
+                TarkSignInTab.tab = nil
+                self?.tabManager.removeTab(tab.tabUUID)
+            })
+        try await TarkAccount.shared.signIn(using: agent, prompt: prompt, idTokenHint: idTokenHint)
+    }
+
+    /// True (the navigation is cancelled) for Zynclave's redirect back to
+    /// Tark. Only the normal sign-in tab may finish a sign-in; from any other
+    /// tab, Private ones included, the redirect is just dropped.
+    func handleTarkSignInRedirect(_ url: URL, in tab: Tab) -> Bool {
+        guard TarkAccountConfig.isRedirect(url) else { return false }
+        if !tab.isPrivate, tab === TarkSignInTab.tab {
+            TarkAccount.shared.resume(with: url)
+        }
+        return true
+    }
+
+    /// The person closed the sign-in tab before finishing.
+    func tarkSignInTabRemoved(_ tab: Tab) {
+        guard tab === TarkSignInTab.tab else { return }
+        TarkSignInTab.tab = nil
+        TarkAccount.shared.cancelSignIn()
+    }
+}
