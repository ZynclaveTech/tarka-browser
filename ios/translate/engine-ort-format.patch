+std::unique_ptr<OrtModel> OrtRuntime::LoadMappedOrtModel(const base::FilePath& ort, int threads) {
+  const int fd = open(ort.value().c_str(), O_RDONLY);
+  if (fd < 0) {
+    return nullptr;
+  }
+  struct stat st;
+  void* bytes = MAP_FAILED;
+  if (fstat(fd, &st) == 0 && st.st_size > 0) {
+    bytes = mmap(nullptr, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+  }
+  if (close(fd) != 0 || bytes == MAP_FAILED) {
+    if (bytes != MAP_FAILED) {
+      munmap(bytes, st.st_size);
+    }
+    return nullptr;
+  }
+  const size_t size = static_cast<size_t>(st.st_size);
+  std::unique_ptr<OrtModel> model =
+      Load(threads, [&](OrtSessionOptions* options, OrtSession** session) {
+        OrtStatus* status =
+            api_->AddSessionConfigEntry(options, "session.use_ort_model_bytes_directly", "1");
+        if (!status) {
+          status = api_->AddSessionConfigEntry(options,
+                                               "session.use_ort_model_bytes_for_initializers", "1");
+        }
+        return status ? status : api_->CreateSessionFromArray(env_, bytes, size, options, session);
+      });
+  if (!model) {
+    munmap(bytes, size);
+    return nullptr;
+  }
+  model->mapping_ = bytes;
+  model->mapping_size_ = size;
+  return model;
+}
