# Tark for Android (A1): ungoogled-chromium's gclient config (utils/clone.py)
# with Android added, so gclient also fetches the Android SDK and NDK.
# The solution is named "src" and android/build.sh's copy of clone.py puts
# .gclient beside it (gclient's standard layout): current depot_tools
# rejects the absolute solution name clone.py's own layout produces.
solutions = [
  {
    "name": "src",
    "url": "https://chromium.googlesource.com/chromium/src.git",
    "managed": False,
    "custom_deps": {
      "src/third_party/angle/third_party/VK-GL-CTS/src": None,
    },
    "custom_vars": {
      "checkout_configuration": "small",
      "non_git_source": "False",
    },
  },
];
target_os = ['android'];
target_os_only = False;
target_cpu = ['x64', 'arm64'];
target_cpu_only = False;
