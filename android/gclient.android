# Tark for Android (A1): ungoogled-chromium's gclient config (utils/clone.py)
# with Android added, so gclient also fetches the Android SDK and NDK.
# UC_OUT is the output directory; android/build.sh fills it in, because
# clone.py does not substitute it in a custom config (-c).
solutions = [
  {
    "name": "UC_OUT",
    "url": "https://chromium.googlesource.com/chromium/src.git",
    "managed": False,
    "custom_deps": {
      "UC_OUT/third_party/angle/third_party/VK-GL-CTS/src": None,
    },
    "custom_vars": {
      "checkout_configuration": "small",
      "non_git_source": "False",
    },
  },
];
target_os = ['android'];
target_os_only = False;
target_cpu = ['x64', 'arm64'];
target_cpu_only = False;
