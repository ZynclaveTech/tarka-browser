+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import android.content.Context;
+import android.os.LocaleList;
+
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Reason;
+import org.chromium.chrome.browser.tark_captions.TarkCaptionsBridge;
+import org.chromium.components.user_prefs.UserPrefs;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Tark: the languages the person already uses, for Voice languages' suggestions. They are read on
+ * the phone and never sent anywhere, and browsing is never one of them: the phone's languages,
+ * Tark's languages (the accept-languages list, which Tark's Indian-language typing suggestions
+ * use) and the languages whose captions model is downloaded.
+ */
+@NullMarked
+public final class VoiceLanguageSignals {
+    private VoiceLanguageSignals() {}
+
+    /** The signals by language subtag ("hi"), each with its first reason. */
+    public static Map<String, Reason> read(Context context) {
+        return merge(phoneLanguages(), tarkLanguages(), captionsLanguages());
+    }
+
+    /**
+     * Merges the three signals by language subtag. A language keeps its first reason, in the
+     * order phone, Tark's languages, captions. Tags that fail {@link
+     * SpeechLanguageSnackbar#isWellFormedTag} are dropped.
+     */
+    @VisibleForTesting
+    static Map<String, Reason> merge(
+            List<String> phone, List<String> tarkLanguages, List<String> captions) {
+        Map<String, Reason> signals = new LinkedHashMap<>();
+        add(signals, phone, Reason.PHONE);
+        add(signals, tarkLanguages, Reason.TARK_LANGUAGES);
+        add(signals, captions, Reason.CAPTIONS);
+        return signals;
+    }
+
+    private static void add(Map<String, Reason> signals, List<String> tags, Reason reason) {
+        for (String tag : tags) {
+            String trimmed = tag.trim();
+            if (!SpeechLanguageSnackbar.isWellFormedTag(trimmed)) continue;
+            String language = Locale.forLanguageTag(trimmed).getLanguage().toLowerCase(Locale.ROOT);
+            signals.putIfAbsent(language, reason);
+        }
+    }
+
+    /** The phone's languages ({@link LocaleList#getDefault()}), as tags. */
+    @VisibleForTesting
+    static List<String> phoneLanguages() {
+        LocaleList locales = LocaleList.getDefault();
+        List<String> tags = new ArrayList<>();
+        for (int i = 0; i < locales.size(); i++) tags.add(locales.get(i).toLanguageTag());
+        return tags;
+    }
+
+    /** The profile's accept languages, as Tark's typing suggestions read them. */
+    private static List<String> tarkLanguages() {
+        if (!LibraryLoader.getInstance().isInitialized() || !ProfileManager.isInitialized()) {
+            return List.of();
+        }
+        String accept =
+                UserPrefs.get(ProfileManager.getLastUsedRegularProfile())
+                        .getString(Pref.ACCEPT_LANGUAGES);
+        return splitList(accept);
+    }
+
+    /** The languages whose captions model is on the phone ("hi"; translation models aren't). */
+    private static List<String> captionsLanguages() {
+        if (!LibraryLoader.getInstance().isInitialized()) return List.of();
+        return Arrays.asList(TarkCaptionsBridge.getReadyLanguages());
+    }
+
+    @VisibleForTesting
+    static List<String> splitList(@Nullable String list) {
+        if (list == null || list.isEmpty()) return List.of();
+        return Arrays.asList(list.split(","));
+    }
+}
