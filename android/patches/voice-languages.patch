+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class VoiceLanguagesSettingsTest {
+    /** Android's recognizer, as lists. */
+    private static class FakePlatform implements VoicePlatform {
+        List<String> mInstalled = new ArrayList<>(List.of("en-IN", "en-US"));
+        List<String> mPending = new ArrayList<>();
+        List<String> mSupported =
+                new ArrayList<>(List.of("en-IN", "en-US", "hi-IN", "ta-IN", "bn-IN"));
+        int mSupportCalls;
+        final List<String> mDownloads = new ArrayList<>();
+        final List<@Nullable DownloadListener> mListeners = new ArrayList<>();
+        int mSystemSettingsOpened;
+        // When set, answers wait in mDeferred until the test delivers them.
+        boolean mDefer;
+        final List<Callback<@Nullable RecognitionSupport>> mDeferred = new ArrayList<>();
+
+        @Override
+        public void support(
+                Context context,
+                @Nullable String tag,
+                Callback<@Nullable RecognitionSupport> callback) {
+            mSupportCalls++;
+            if (mDefer) {
+                mDeferred.add(callback);
+                return;
+            }
+            callback.onResult(current());
+        }
+
+        RecognitionSupport current() {
+            return new RecognitionSupport.Builder()
+                    .setInstalledOnDeviceLanguages(new ArrayList<>(mInstalled))
+                    .setPendingOnDeviceLanguages(new ArrayList<>(mPending))
+                    .setSupportedOnDeviceLanguages(new ArrayList<>(mSupported))
+                    .build();
+        }
+
+        @Override
+        public void download(Context context, String tag, @Nullable DownloadListener listener) {
+            mDownloads.add(tag);
+            mListeners.add(listener);
+        }
+
+        @Override
+        public void openSystemSettings(Context context) {
+            mSystemSettingsOpened++;
+        }
+    }
+
+    /**
+     * Captions' downloader for the detector unit (CaptionDownloads), as voice sees it: owners, and
+     * a fetch only for a unit that is not on the phone.
+     */
+    private static class FakeDownloads implements VoiceDetector.Downloads {
+        static final long TOTAL = 86_063_323L + 325L + 2_327_524L;
+
+        int mState = TarkCaptionsBridge.UNIT_MISSING;
+        long mBytes;
+        boolean mRetrying;
+        boolean mCaptionsWant;
+        boolean mVoiceWants;
+        int mFetches;
+        final List<Boolean> mRequests = new ArrayList<>();
+        int mRemoves;
+        int mStateReads;
+        final List<Runnable> mListeners = new ArrayList<>();
+
+        @Override
+        public long[] unitState(String unit) {
+            assertEquals("language_id", unit);
+            mStateReads++;
+            return new long[] {mState, mBytes, TOTAL, mRetrying ? 1 : 0};
+        }
+
+        @Override
+        public void addListener(String unit, Runnable onChanged) {
+            assertEquals("language_id", unit);
+            mListeners.add(onChanged);
+        }
+
+        @Override
+        public void removeListener(Runnable onChanged) {
+            mListeners.remove(onChanged);
+        }
+
+        /** CaptionDownloads::Observer::OnUnitChanged, through the bridge. */
+        void changed() {
+            for (Runnable listener : new ArrayList<>(mListeners)) listener.run();
+        }
+
+        @Override
+        public boolean wantedByVoice(String unit) {
+            return mVoiceWants;
+        }
+
+        @Override
+        public void request(String unit, boolean now) {
+            mVoiceWants = true;
+            mRequests.add(now);
+            if (mState != TarkCaptionsBridge.UNIT_READY) {
+                mFetches++;
+                mState =
+                        now
+                                ? TarkCaptionsBridge.UNIT_DOWNLOADING
+                                : TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI;
+            }
+        }
+
+        @Override
+        public void remove(String unit) {
+            mVoiceWants = false;
+            mRemoves++;
+            if (!mCaptionsWant) {
+                mState = TarkCaptionsBridge.UNIT_MISSING;
+                mBytes = 0;
+            }
+        }
+    }
+
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private final LocaleList mDefaultLocales = LocaleList.getDefault();
+    private FakePlatform mPlatform;
+    private FakeDownloads mDetector;
+    private TestActivity mActivity;
+    private VoiceLanguagesSettings mSettings;
+
+    @Before
+    public void setUp() {
+        mPlatform = new FakePlatform();
+        VoicePlatform.setForTesting(mPlatform);
+        mDetector = new FakeDownloads();
+        VoiceDetector.setDownloadsForTesting(mDetector);
+        VoiceSiteLanguages.setInstalledForTesting(null);
+        Map<String, Reason> signals = new LinkedHashMap<>();
+        signals.put("hi", Reason.TARK_LANGUAGES);
+        signals.put("ta", Reason.PHONE);
+        VoiceLanguagesSettings.setSignalsForTesting(signals);
+        LocaleList.setDefault(LocaleList.forLanguageTags("en-IN"));
+        mActivityScenarioRule
+                .getScenario()
+                .onActivity(
+                        activity -> {
+                            mActivity = activity;
+                            mActivity.setTheme(R.style.Theme_BrowserUI_DayNight);
+                        });
+    }
+
+    @After
+    public void tearDown() {
+        LocaleList.setDefault(mDefaultLocales);
+    }
+
+    private void launch() {
+        FragmentManager fragmentManager = mActivity.getSupportFragmentManager();
+        mSettings =
+                (VoiceLanguagesSettings)
+                        fragmentManager
+                                .getFragmentFactory()
+                                .instantiate(
+                                        VoiceLanguagesSettings.class.getClassLoader(),
+                                        VoiceLanguagesSettings.class.getName());
+        mSettings.setProfile(Mockito.mock(Profile.class));
+        fragmentManager.beginTransaction().replace(android.R.id.content, mSettings).commitNow();
+        ShadowLooper.idleMainLooper();
+    }
