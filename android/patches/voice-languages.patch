+        Preference voice = new Preference(getPreferenceManager().getContext());
+        voice.setKey(TARK_VOICE_LANGUAGES_KEY);
+        voice.setTitle(R.string.tark_voice_languages_title);
+        voice.setFragment(TARK_VOICE_LANGUAGES_FRAGMENT);
+        voice.setPersistent(false);
+        // Right after the typing suggestions' switch (it is added right after it, too).
+        if (mTarkXlitSwitch != null) voice.setOrder(mTarkXlitSwitch.getOrder() + 1);
+        getPreferenceScreen().addPreference(voice);
+    }
