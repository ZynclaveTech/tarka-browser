+    /** Download (or Try again): Android downloads the language. */
+    @VisibleForTesting
+    void startDownload(String tag) {
+        if (!isAlive()) return;
+        Download download = new Download(mRequest);
+        mDownloads.put(tag, download);
+        mPollingSince = -1;
+        // Android 13 reports nothing; the list's pending languages tell instead.
+        VoicePlatform.DownloadListener listener =
+                Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE
+                        ? new PageDownloadListener(this, tag, download)
+                        : null;
+        mPlatform.download(getContext(), tag, listener);
+        showSections(mSupport);
+    }
+
+    /**
+     * A download's news for the page. Android's recognizer outlives the page, so this holds the
+     * page weakly and drops news for a page that is gone or a download it no longer tracks.
+     */
+    private static final class PageDownloadListener implements VoicePlatform.DownloadListener {
+        private final WeakReference<VoiceLanguagesSettings> mPage;
+        private final String mTag;
+        private final Download mDownload;
+
+        PageDownloadListener(VoiceLanguagesSettings page, String tag, Download download) {
+            mPage = new WeakReference<>(page);
+            mTag = tag;
+            mDownload = download;
+        }
+
+        private @Nullable VoiceLanguagesSettings page() {
+            VoiceLanguagesSettings page = mPage.get();
+            if (page == null || !page.isAlive()) return null;
+            return page.mDownloads.get(mTag) == mDownload ? page : null;
+        }
+
+        @Override
+        public void onProgress(int percent) {
+            VoiceLanguagesSettings page = page();
+            if (page == null) return;
+            mDownload.mPercent = percent;
+            mDownload.mWaiting = false;
+            page.showSections(page.mSupport);
+        }
+
+        @Override
+        public void onSuccess() {
+            VoiceLanguagesSettings page = page();
+            if (page == null) return;
+            // Kept as downloading until Android lists it as installed.
+            mDownload.mPercent = 100;
+            mDownload.mWaiting = false;
+            mDownload.mSucceeded = true;
+            page.refresh();
+        }
+
+        @Override
+        public void onScheduled() {
+            VoiceLanguagesSettings page = page();
+            if (page == null) return;
+            mDownload.mWaiting = true;
+            page.showSections(page.mSupport);
+        }
+
+        @Override
+        public void onError(int error) {
+            VoiceLanguagesSettings page = page();
+            if (page == null) return;
+            mDownload.mFailed = true;
+            page.showSections(page.mSupport);
+        }
+    }
+
+    /**
+     * A download's progress bar, two touch targets wide: determinate and never animated (an
+     * animating view keeps the page from going idle for UI automation and accessibility); it is
+     * rebuilt only when the whole percent changes.
+     */
+    @VisibleForTesting
+    static ProgressBar progressBar(Context context, int percent) {
+        ProgressBar bar = new ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal);
+        bar.setIndeterminate(false);
+        bar.setMax(100);
+        bar.setProgress(percent, /* animate= */ false);
+        int width = context.getResources().getDimensionPixelSize(R.dimen.min_touch_target_size);
+        bar.setLayoutParams(
+                new ViewGroup.LayoutParams(2 * width, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return bar;
+    }
