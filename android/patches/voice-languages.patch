+    @Test
+    @Config(minSdk = Build.VERSION_CODES.TIRAMISU)
+    public void testUnansweredCheckTimesOut() {
+        VoiceSiteLanguages.set(SITE, "hi-IN");
+        VoiceSiteLanguages.refreshInstalled(ContextUtils.getApplicationContext());
+        assertEquals(1, mPlatform.mPending.size());
+
+        // Android never answers: after the timeout, the next session's check asks again.
+        ShadowLooper.idleMainLooper(
+                VoiceSiteLanguages.CHECK_TIMEOUT_MS - 1, TimeUnit.MILLISECONDS);
+        VoiceSiteLanguages.refreshInstalled(ContextUtils.getApplicationContext());
+        assertEquals(1, mPlatform.mPending.size());
+        ShadowLooper.idleMainLooper(1, TimeUnit.MILLISECONDS);
+        VoiceSiteLanguages.refreshInstalled(ContextUtils.getApplicationContext());
+        assertEquals(2, mPlatform.mPending.size());
+    }
