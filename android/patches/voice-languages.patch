+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+import android.os.LocaleList;
+import android.speech.RecognitionSupport;
+
+import androidx.fragment.app.FragmentManager;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.test.ext.junit.rules.ActivityScenarioRule;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mockito;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowLooper;
+
+import org.chromium.base.Callback;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Reason;
+import org.chromium.chrome.browser.speech.VoiceLanguagesSettings.LanguageRow;
+import org.chromium.ui.base.TestActivity;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+
+/** Tests for {@link VoiceLanguagesSettings}. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class VoiceLanguagesSettingsTest {
+    /** Android's recognizer, as lists. */
+    private static class FakePlatform implements VoicePlatform {
+        List<String> mInstalled = new ArrayList<>(List.of("en-IN", "en-US"));
+        List<String> mPending = new ArrayList<>();
+        List<String> mSupported =
+                new ArrayList<>(List.of("en-IN", "en-US", "hi-IN", "ta-IN", "bn-IN"));
+        int mSupportCalls;
+        final List<String> mDownloads = new ArrayList<>();
+        final List<@Nullable DownloadListener> mListeners = new ArrayList<>();
+        int mSystemSettingsOpened;
+
+        @Override
+        public void support(Context context, Callback<@Nullable RecognitionSupport> callback) {
+            mSupportCalls++;
+            callback.onResult(
+                    new RecognitionSupport.Builder()
+                            .setInstalledOnDeviceLanguages(new ArrayList<>(mInstalled))
+                            .setPendingOnDeviceLanguages(new ArrayList<>(mPending))
+                            .setSupportedOnDeviceLanguages(new ArrayList<>(mSupported))
+                            .build());
+        }
+
+        @Override
+        public void download(Context context, String tag, @Nullable DownloadListener listener) {
+            mDownloads.add(tag);
+            mListeners.add(listener);
+        }
+
+        @Override
+        public void openSystemSettings(Context context) {
+            mSystemSettingsOpened++;
+        }
+    }
+
+    @Rule
+    public ActivityScenarioRule<TestActivity> mActivityScenarioRule =
+            new ActivityScenarioRule<>(TestActivity.class);
+
+    private final LocaleList mDefaultLocales = LocaleList.getDefault();
+    private FakePlatform mPlatform;
+    private TestActivity mActivity;
+    private VoiceLanguagesSettings mSettings;
+
+    @Before
+    public void setUp() {
+        mPlatform = new FakePlatform();
+        VoicePlatform.setForTesting(mPlatform);
+        Map<String, Reason> signals = new LinkedHashMap<>();
+        signals.put("hi", Reason.TARK_LANGUAGES);
+        signals.put("ta", Reason.PHONE);
+        VoiceLanguagesSettings.setSignalsForTesting(signals);
+        LocaleList.setDefault(LocaleList.forLanguageTags("en-IN"));
+        mActivityScenarioRule
+                .getScenario()
+                .onActivity(
+                        activity -> {
+                            mActivity = activity;
+                            mActivity.setTheme(R.style.Theme_BrowserUI_DayNight);
+                        });
+    }
+
+    @After
+    public void tearDown() {
+        LocaleList.setDefault(mDefaultLocales);
+    }
+
+    private void launch() {
+        FragmentManager fragmentManager = mActivity.getSupportFragmentManager();
+        mSettings =
+                (VoiceLanguagesSettings)
+                        fragmentManager
+                                .getFragmentFactory()
+                                .instantiate(
+                                        VoiceLanguagesSettings.class.getClassLoader(),
+                                        VoiceLanguagesSettings.class.getName());
+        mSettings.setProfile(Mockito.mock(Profile.class));
+        fragmentManager.beginTransaction().replace(android.R.id.content, mSettings).commitNow();
+        ShadowLooper.idleMainLooper();
+    }
+
+    private PreferenceCategory section(String key) {
+        PreferenceCategory category = mSettings.findPreference(key);
+        assertNotNull(key, category);
+        return category;
+    }
+
+    private String title(String key) {
+        return String.valueOf(section(key).getTitle());
+    }
+
+    private List<String> rowTags(String key) {
+        PreferenceCategory category = section(key);
+        List<String> tags = new ArrayList<>();
+        for (int i = 0; i < category.getPreferenceCount(); i++) {
+            tags.add(((LanguageRow) category.getPreference(i)).getLanguageTag());
+        }
+        return tags;
+    }
+
+    private LanguageRow row(String tag) {
+        LanguageRow row = mSettings.findPreference("voice_language_" + tag);
+        assertNotNull(tag, row);
+        return row;
+    }
+
+    private static String summary(Preference preference) {
+        CharSequence summary = preference.getSummary();
+        return summary == null ? null : summary.toString();
+    }
+
+    @Test
+    public void testScreenSections() {
+        launch();
+
+        assertEquals("On this phone", title(VoiceLanguagesSettings.ON_PHONE_KEY));
+        assertEquals("Suggested for you", title(VoiceLanguagesSettings.SUGGESTED_KEY));
+        assertEquals("More languages", title(VoiceLanguagesSettings.MORE_KEY));
+        assertTrue(section(VoiceLanguagesSettings.ON_PHONE_KEY).isVisible());
+        assertTrue(section(VoiceLanguagesSettings.SUGGESTED_KEY).isVisible());
+        assertTrue(section(VoiceLanguagesSettings.MORE_KEY).isVisible());
+
+        assertEquals(List.of("en-IN", "en-US"), rowTags(VoiceLanguagesSettings.ON_PHONE_KEY));
+        assertEquals(List.of("hi-IN", "ta-IN"), rowTags(VoiceLanguagesSettings.SUGGESTED_KEY));
+        assertEquals(List.of("bn-IN"), rowTags(VoiceLanguagesSettings.MORE_KEY));
+        assertEquals("You type Hindi with Tark's keyboard", summary(row("hi-IN")));
+        assertEquals("One of your phone's languages", summary(row("ta-IN")));
+        assertEquals(LanguageRow.AVAILABLE, row("bn-IN").getStatus());
+        assertEquals(LanguageRow.READY, row("en-US").getStatus());
+
+        // Spoken-language detection comes with its own task; no placeholder until then.
+        assertNull(mSettings.findPreference("voice_languages_detection"));
+        Preference line = mSettings.findPreference(VoiceLanguagesSettings.NEEDS_ANDROID_13_KEY);
+        assertNotNull(line);
+        assertFalse(line.isVisible());
+    }
+
+    @Test
+    public void testEmptySectionHidden() {
+        mPlatform.mSupported = new ArrayList<>(List.of("en-IN", "en-US", "bn-IN"));
+        launch();
+
+        assertFalse(section(VoiceLanguagesSettings.SUGGESTED_KEY).isVisible());
+        assertTrue(section(VoiceLanguagesSettings.MORE_KEY).isVisible());
+    }
+
+    @Test
+    public void testDefaultLanguageLine() {
+        launch();
+
+        assertEquals("Used when a site doesn't say", summary(row("en-IN")));
+        assertNull(summary(row("en-US")));
+    }
+
+    @Test
+    public void testDefaultLanguageOtherRegion() {
+        LocaleList.setDefault(LocaleList.forLanguageTags("en-GB"));
+        launch();
+
+        // The phone's language in the first installed region.
+        assertEquals("Used when a site doesn't say", summary(row("en-IN")));
+        assertNull(summary(row("en-US")));
+    }
+
+    @Test
+    public void testDownloadTapCallsPlatform() {
+        launch();
+        row("hi-IN").tapAction();
+
+        assertEquals(List.of("hi-IN"), mPlatform.mDownloads);
+        VoicePlatform.DownloadListener listener = mPlatform.mListeners.get(0);
+        assertNotNull(listener);
+        assertEquals(
+                List.of("en-IN", "en-US", "hi-IN"), rowTags(VoiceLanguagesSettings.ON_PHONE_KEY));
+        assertEquals("Downloading…", summary(row("hi-IN")));
+        assertFalse(row("hi-IN").showsProgress());
+
+        listener.onProgress(40);
+        assertTrue(row("hi-IN").showsProgress());
+        assertEquals(40, row("hi-IN").getPercent());
+        assertEquals("Downloading…", summary(row("hi-IN")));
+    }
+
+    @Test
+    @Config(sdk = 33)
+    public void testDownloadOnApi33ReadsDownloading() {
+        launch();
+        row("hi-IN").tapAction();
+
+        assertEquals(List.of("hi-IN"), mPlatform.mDownloads);
+        assertNull(mPlatform.mListeners.get(0));
+        assertEquals(
+                List.of("en-IN", "en-US", "hi-IN"), rowTags(VoiceLanguagesSettings.ON_PHONE_KEY));
+        assertEquals("Downloading…", summary(row("hi-IN")));
+        assertFalse(row("hi-IN").showsProgress());
+    }
+
+    @Test
+    public void testDownloadFailedShowsTryAgain() {
+        launch();
+        row("ta-IN").tapAction();
+        mPlatform.mListeners.get(0).onError(0);
+
+        assertEquals(List.of("hi-IN", "ta-IN"), rowTags(VoiceLanguagesSettings.SUGGESTED_KEY));
+        assertEquals("Couldn't download", summary(row("ta-IN")));
+        assertEquals(LanguageRow.FAILED, row("ta-IN").getStatus());
+
+        row("ta-IN").tapAction();
+        assertEquals(List.of("ta-IN", "ta-IN"), mPlatform.mDownloads);
+        assertEquals("Downloading…", summary(row("ta-IN")));
+    }
+
+    @Test
+    public void testScheduledShowsWaitingForWifi() {
+        launch();
+        row("hi-IN").tapAction();
+        mPlatform.mListeners.get(0).onScheduled();
+
+        assertEquals("Waiting for Wi-Fi", summary(row("hi-IN")));
+        assertFalse(row("hi-IN").showsProgress());
+    }
+
+    @Test
+    public void testInstalledAfterRefresh() {
+        launch();
+        row("hi-IN").tapAction();
+        mPlatform.mListeners.get(0).onSuccess();
+        // Until Android lists it, it is still on its way.
+        assertEquals("Downloading…", summary(row("hi-IN")));
+
+        mPlatform.mInstalled.add("hi-IN");
+        mSettings.refresh();
+        assertEquals(LanguageRow.READY, row("hi-IN").getStatus());
+        assertNull(summary(row("hi-IN")));
+        assertFalse(section(VoiceLanguagesSettings.SUGGESTED_KEY).getPreferenceCount() > 1);
+    }
+
+    @Test
+    public void testAndroidPendingShownAndRefreshed() {
+        mPlatform.mPending.add("ta-IN");
+        launch();
+
+        assertEquals("Downloading…", summary(row("ta-IN")));
+        int calls = mPlatform.mSupportCalls;
+        ShadowLooper.idleMainLooper(
+                VoiceLanguagesSettings.REFRESH_INTERVAL_MS, TimeUnit.MILLISECONDS);
+        assertTrue(mPlatform.mSupportCalls > calls);
+    }
+
+    @Test
+    @Config(sdk = 32)
+    public void testApi32ShowsSystemSettingsLine() {
+        launch();
+
+        Preference line = mSettings.findPreference(VoiceLanguagesSettings.NEEDS_ANDROID_13_KEY);
+        Preference button = mSettings.findPreference(VoiceLanguagesSettings.SYSTEM_SETTINGS_KEY);
+        assertNotNull(line);
+        assertNotNull(button);
+        assertTrue(line.isVisible());
+        assertEquals("Android 13 or later can list and download voice languages", summary(line));
+        assertTrue(button.isVisible());
+        assertFalse(section(VoiceLanguagesSettings.ON_PHONE_KEY).isVisible());
+        assertFalse(section(VoiceLanguagesSettings.SUGGESTED_KEY).isVisible());
+        assertFalse(section(VoiceLanguagesSettings.MORE_KEY).isVisible());
+        assertEquals(0, mPlatform.mSupportCalls);
+
+        button.getOnPreferenceClickListener().onPreferenceClick(button);
+        assertEquals(1, mPlatform.mSystemSettingsOpened);
+    }
+
+    @Test
+    public void testDefaultLanguagePicksInstalledOnly() {
+        List<VoiceLanguages.Entry> onPhone =
+                List.of(
+                        new VoiceLanguages.Entry(
+                                "en-IN", "English (India)", null, VoiceLanguages.State.PENDING),
+                        new VoiceLanguages.Entry(
+                                "en-US", "English (US)", null, VoiceLanguages.State.INSTALLED));
+        assertEquals(
+                "en-US",
+                VoiceLanguagesSettings.defaultLanguage(onPhone, Locale.forLanguageTag("en-IN")));
+        assertNull(VoiceLanguagesSettings.defaultLanguage(onPhone, Locale.forLanguageTag("hi-IN")));
+    }
+}
