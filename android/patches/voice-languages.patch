+package org.chromium.chrome.browser.speech;
+
+import android.content.Context;
+
+import androidx.annotation.StringRes;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Tark: the list behind Settings › Voice languages. From the languages Android's on-device
+ * recognizer has (installed), is downloading (pending) and can download (supported), and the
+ * person's signals (the phone's languages, Tark's languages, captions languages; never
+ * browsing), it builds three sections: on this phone, suggested (with the reason) and more.
+ *
+ * <p>Languages are matched on the language subtag: a language installed or pending in any region
+ * is never suggested again. A suggestion takes the supported region equal to the phone's, or else
+ * Android's first listed one. Tags that fail {@link SpeechLanguageSnackbar#isWellFormedTag} are
+ * dropped everywhere.
+ */
+@NullMarked
+public final class VoiceLanguages {
+    /** Whether a language is on the phone, on its way, or only offered. */
+    public enum State {
+        INSTALLED,
+        PENDING,
+        AVAILABLE
+    }
+
+    /** Why a language is suggested. */
+    public enum Reason {
+        PHONE(R.string.tark_voice_reason_phone, false),
+        TARK_LANGUAGES(R.string.tark_voice_reason_tark_languages, false),
+        CAPTIONS(R.string.tark_voice_reason_captions, true);
+
+        private final @StringRes int mText;
+        private final boolean mNamesLanguage;
+
+        Reason(@StringRes int text, boolean namesLanguage) {
+            mText = text;
+            mNamesLanguage = namesLanguage;
+        }
+
+        /** The user-facing text; {@code languageName} fills in where the string names one. */
+        public String text(String languageName) {
+            Context context = ContextUtils.getApplicationContext();
+            if (!mNamesLanguage) return context.getString(mText);
+            return context.getString(mText, languageName);
+        }
+    }
+
+    /** One row: the BCP 47 tag, its name in the UI's language, the suggestion's reason, if any. */
+    public static final class Entry {
+        private final String mTag;
+        private final String mDisplayName;
+        private final @Nullable String mReason;
+        private final State mState;
+
+        public Entry(String tag, String displayName, @Nullable String reason, State state) {
+            mTag = tag;
+            mDisplayName = displayName;
+            mReason = reason;
+            mState = state;
+        }
+
+        public String tag() {
+            return mTag;
+        }
+
+        public String displayName() {
+            return mDisplayName;
+        }
+
+        public @Nullable String reason() {
+            return mReason;
+        }
+
+        public State state() {
+            return mState;
+        }
+    }
+
+    /** The three sections, in display order. */
+    public static final class Sections {
+        private final List<Entry> mOnPhone;
+        private final List<Entry> mSuggested;
+        private final List<Entry> mMore;
+
+        public Sections(List<Entry> onPhone, List<Entry> suggested, List<Entry> more) {
+            mOnPhone = onPhone;
+            mSuggested = suggested;
+            mMore = more;
+        }
+
+        public List<Entry> onPhone() {
+            return mOnPhone;
+        }
+
+        public List<Entry> suggested() {
+            return mSuggested;
+        }
+
+        public List<Entry> more() {
+            return mMore;
+        }
+    }
+
+    private VoiceLanguages() {}
+
+    /**
+     * Builds the sections. The lists and the map are non-null; a null tag in a list counts as
+     * malformed and is dropped.
+     *
+     * @param installed tags Android's on-device recognizer has.
+     * @param pending tags it is downloading.
+     * @param supported tags it can download, in Android's order.
+     * @param signals the person's languages by language subtag ("hi"), with why each is one.
+     *     Keys are normalised like tags, so legacy codes match (he/iw, id/in).
+     * @param phoneLocale the phone's locale; its region picks a suggestion's region.
+     * @param uiLocale the locale names are shown in.
+     */
+    public static Sections build(
+            List<String> installed,
+            List<String> pending,
+            List<String> supported,
+            Map<String, Reason> signals,
+            Locale phoneLocale,
+            Locale uiLocale) {
+        Names names = new Names(wellFormed(supported), wellFormed(installed), wellFormed(pending));
+        List<Entry> onPhone = new ArrayList<>();
+        Set<String> onPhoneTags = new HashSet<>();
+        Set<String> onPhoneLanguages = new HashSet<>();
+        for (String tag : wellFormed(installed)) {
+            if (onPhoneTags.add(key(tag))) {
+                onPhone.add(entry(tag, null, State.INSTALLED, names, uiLocale));
+                onPhoneLanguages.add(language(tag));
+            }
+        }
+        for (String tag : wellFormed(pending)) {
+            if (onPhoneTags.add(key(tag))) {
+                onPhone.add(entry(tag, null, State.PENDING, names, uiLocale));
+                onPhoneLanguages.add(language(tag));
+            }
+        }
+
+        // Supported tags not on the phone, grouped by language in Android's order.
+        Map<String, List<String>> byLanguage = new LinkedHashMap<>();
+        Set<String> seen = new HashSet<>(onPhoneTags);
+        for (String tag : wellFormed(supported)) {
+            if (!seen.add(key(tag))) continue;
+            byLanguage.computeIfAbsent(language(tag), k -> new ArrayList<>()).add(tag);
+        }
+
+        Map<String, Reason> wanted = new LinkedHashMap<>();
+        for (Map.Entry<String, Reason> signal : signals.entrySet()) {
+            wanted.put(language(signal.getKey()), signal.getValue());
+        }
+
+        List<Entry> suggested = new ArrayList<>();
+        List<Entry> more = new ArrayList<>();
+        String phoneRegion = phoneLocale.getCountry();
+        for (Map.Entry<String, List<String>> group : byLanguage.entrySet()) {
+            String language = group.getKey();
+            List<String> tags = group.getValue();
+            Reason reason = wanted.get(language);
+            @Nullable String pick = null;
+            if (reason != null && !onPhoneLanguages.contains(language)) {
+                pick = tags.get(0);
+                for (String tag : tags) {
+                    if (Locale.forLanguageTag(tag).getCountry().equalsIgnoreCase(phoneRegion)) {
+                        pick = tag;
+                        break;
+                    }
+                }
+                String languageName = Locale.forLanguageTag(pick).getDisplayLanguage(uiLocale);
+                suggested.add(
+                        entry(pick, reason.text(languageName), State.AVAILABLE, names, uiLocale));
+            }
+            for (String tag : tags) {
+                if (!tag.equals(pick)) {
+                    more.add(entry(tag, null, State.AVAILABLE, names, uiLocale));
+                }
+            }
+        }
+        Collator collator = Collator.getInstance(uiLocale);
+        Collections.sort(more, (a, b) -> collator.compare(a.displayName(), b.displayName()));
+
+        return new Sections(onPhone, suggested, more);
+    }
+
+    private static List<String> wellFormed(List<@Nullable String> tags) {
+        List<String> result = new ArrayList<>();
+        for (String tag : tags) {
+            if (tag != null && SpeechLanguageSnackbar.isWellFormedTag(tag)) result.add(tag);
+        }
+        return result;
+    }
+
+    private static String key(String tag) {
+        return tag.toLowerCase(Locale.ROOT);
+    }
+
+    private static String language(String tag) {
+        return Locale.forLanguageTag(tag).getLanguage().toLowerCase(Locale.ROOT);
+    }
+
+    private static Entry entry(
+            String tag, @Nullable String reason, State state, Names names, Locale uiLocale) {
+        return new Entry(tag, names.displayName(tag, uiLocale), reason, state);
+    }
+
+    /**
+     * The name of {@code tag} as the lists name it, by the same rule as {@link #build}: the
+     * language alone unless {@code known} has another tag of that language.
+     */
+    static String displayName(String tag, List<String> known, Locale uiLocale) {
+        List<String> tags = new ArrayList<>();
+        for (String other : known) {
+            if (SpeechLanguageSnackbar.isWellFormedTag(other)) tags.add(other);
+        }
+        tags.add(tag);
+        return new Names(tags).displayName(tag, uiLocale);
+    }
+
+    /**
+     * Names a tag as plainly as Android's list allows: the language alone ("Hindi") when it has
+     * one tag in the whole list, the language and country ("English (India)") otherwise, and the
+     * script too only when two tags share language and country.
+     */
+    private static final class Names {
+        private final Map<String, Integer> mPerLanguage = new HashMap<>();
+        private final Map<String, Integer> mPerLanguageRegion = new HashMap<>();
+
+        @SafeVarargs
+        Names(List<String>... lists) {
+            Set<String> seen = new HashSet<>();
+            for (List<String> list : lists) {
+                for (String tag : list) {
+                    if (!seen.add(key(tag))) continue;
+                    Locale locale = Locale.forLanguageTag(tag);
+                    mPerLanguage.merge(language(tag), 1, Integer::sum);
+                    mPerLanguageRegion.merge(languageRegion(locale), 1, Integer::sum);
+                }
+            }
+        }
+
+        String displayName(String tag, Locale uiLocale) {
+            Locale locale = Locale.forLanguageTag(tag);
+            Locale.Builder shown = new Locale.Builder().setLanguage(locale.getLanguage());
+            if (mPerLanguage.getOrDefault(language(tag), 0) > 1) {
+                shown.setRegion(locale.getCountry());
+                if (mPerLanguageRegion.getOrDefault(languageRegion(locale), 0) > 1) {
+                    shown.setScript(locale.getScript());
+                }
+            }
+            return shown.build().getDisplayName(uiLocale);
+        }
+
+        private static String languageRegion(Locale locale) {
+            return locale.getLanguage().toLowerCase(Locale.ROOT)
+                    + "-"
+                    + locale.getCountry().toLowerCase(Locale.ROOT);
+        }
+    }
+}
