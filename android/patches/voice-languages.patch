+        assertEquals(DetectionRow.WAITING, detection().getStatus());
+        assertEquals(1, mDetector.mListeners.size());
+
+        int reads = mDetector.mStateReads;
+        ShadowLooper.idleMainLooper(10_000, TimeUnit.MILLISECONDS);
+        assertEquals(reads, mDetector.mStateReads);
+        assertTrue(VoiceLanguagesSettings.DETECTOR_REFRESH_MS >= 10_000);
