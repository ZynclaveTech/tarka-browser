+    @VisibleForTesting
+    static void setSignalsForTesting(@Nullable Map<String, Reason> signals) {
+        sSignalsForTesting = signals;
+        ResettersForTesting.register(() -> sSignalsForTesting = null);
+    }
+
+    /** Whether Android's late answers may still change this page. */
+    private boolean isAlive() {
+        return !mDestroyed && isAdded() && getView() != null;
+    }
+
+    /** Asks Android for its languages again. */
+    @VisibleForTesting
+    void refresh() {
+        mHandler.removeCallbacks(mRefresh);
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        int request = ++mRequest;
+        // Android's callback may come after the page is gone; it holds the page weakly.
+        WeakReference<VoiceLanguagesSettings> page = new WeakReference<>(this);
+        mPlatform.support(
+                getContext(),
+                null,
+                support -> {
+                    VoiceLanguagesSettings settings = page.get();
+                    if (settings == null || !settings.isAlive()) return;
+                    if (request != settings.mRequest) return;
+                    settings.onSupport(support, request);
+                });
+    }
+
+    private void onSupport(@Nullable RecognitionSupport support, int request) {
+        mSupport = support;
+        // Also tells voice whether the phone still has the sites' languages.
+        VoiceSiteLanguages.onSupport(support);
+        if (support != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            List<String> installed = new ArrayList<>();
+            List<String> pending = new ArrayList<>();
+            readSupport(support, installed, pending, new ArrayList<>());
+            Iterator<Map.Entry<String, Download>> it = mDownloads.entrySet().iterator();
+            while (it.hasNext()) {
+                Map.Entry<String, Download> entry = it.next();
+                Download download = entry.getValue();
+                if (installed.contains(entry.getKey())) {
+                    // Android's to show from now on.
+                    it.remove();
+                } else if (pending.contains(entry.getKey())) {
+                    // On its way after all, even if it looked failed.
+                    download.mFailed = false;
+                } else if (download.mFailed
+                        || download.mWaiting
+                        || request <= download.mAfterRequest) {
+                    continue;
+                } else if (download.mSucceeded) {
+                    it.remove();
+                } else if (SystemClock.uptimeMillis() - download.mStartedAt >= FAIL_AFTER_MS) {
+                    // Asked for long enough ago, yet Android neither has it nor is getting it.
+                    download.mFailed = true;
+                }
+            }
+        }
+        showSections(support);
+    }
+
+    private Map<String, Reason> signals() {
+        if (sSignalsForTesting != null) return sSignalsForTesting;
+        if (mSignals == null) mSignals = VoiceLanguageSignals.read(getContext(), getProfile());
+        return mSignals;
+    }
+
+    private void showSections(@Nullable RecognitionSupport support) {
+        List<String> installed = new ArrayList<>();
+        List<String> pending = new ArrayList<>();
+        List<String> supported = new ArrayList<>();
+        if (support != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            readSupport(support, installed, pending, supported);
+        }
+        for (Map.Entry<String, Download> download : mDownloads.entrySet()) {
+            if (!download.getValue().mFailed
+                    && !pending.contains(download.getKey())
+                    && !installed.contains(download.getKey())) {
+                pending.add(download.getKey());
+            }
+        }
+
+        Locale phone = LocaleList.getDefault().get(0);
+        Locale ui = getResources().getConfiguration().getLocales().get(0);
+        Sections sections =
+                VoiceLanguages.build(installed, pending, supported, signals(), phone, ui);
+        @Nullable String defaultTag = defaultLanguage(sections.onPhone(), phone);
+
+        boolean downloading = false;
+        downloading |= fill(ON_PHONE_KEY, sections.onPhone(), defaultTag);
+        downloading |= fill(SUGGESTED_KEY, sections.suggested(), null);
+        downloading |= fill(MORE_KEY, sections.more(), null);
+        fillSites();
+        schedulePoll(downloading);
+    }
+
+    /** Polls while something downloads, the page shows, and for at most {@link #POLL_LIMIT_MS}. */
+    private void schedulePoll(boolean downloading) {
+        mHandler.removeCallbacks(mRefresh);
+        if (!downloading) {
+            mPollingSince = -1;
+            return;
+        }
+        long now = SystemClock.uptimeMillis();
+        if (mPollingSince < 0) mPollingSince = now;
+        if (mResumed && now - mPollingSince < POLL_LIMIT_MS) {
+            mHandler.postDelayed(mRefresh, REFRESH_INTERVAL_MS);
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static void readSupport(
+            RecognitionSupport support,
+            List<String> installed,
+            List<String> pending,
+            List<String> supported) {
+        installed.addAll(support.getInstalledOnDeviceLanguages());
+        pending.addAll(support.getPendingOnDeviceLanguages());
+        supported.addAll(support.getSupportedOnDeviceLanguages());
+    }
+
+    /**
+     * The installed language the recognizer uses when a site names none: the phone's language,
+     * in its region if installed, else in the first installed region.
+     */
+    @VisibleForTesting
+    static @Nullable String defaultLanguage(List<Entry> onPhone, Locale phone) {
+        String phoneTag = phone.toLanguageTag();
+        @Nullable String sameLanguage = null;
+        for (Entry entry : onPhone) {
+            if (entry.state() != State.INSTALLED) continue;
+            if (entry.tag().equalsIgnoreCase(phoneTag)) return entry.tag();
+            String language = Locale.forLanguageTag(entry.tag()).getLanguage();
+            if (sameLanguage == null && language.equals(phone.getLanguage())) {
+                sameLanguage = entry.tag();
+            }
+        }
+        return sameLanguage;
+    }
+
+    /** Fills a section; returns whether one of its rows is downloading. */
+    private boolean fill(String key, List<Entry> entries, @Nullable String defaultTag) {
+        PreferenceCategory category = findPreference(key);
+        if (category == null) return false;
+        category.removeAll();
+        category.setVisible(!entries.isEmpty());
+        boolean downloading = false;
+        for (Entry entry : entries) {
+            LanguageRow row = new LanguageRow(getContext(), entry.tag());
+            row.setKey(ROW_KEY_PREFIX + entry.tag());
+            row.setTitle(entry.displayName());
+            Download download = mDownloads.get(entry.tag());
+            switch (entry.state()) {
+                case INSTALLED:
+                    row.setSummary(
+                            entry.tag().equals(defaultTag)
+                                    ? getString(R.string.tark_voice_default_language)
+                                    : null);
+                    row.show(LanguageRow.READY, -1, null);
+                    break;
+                case PENDING:
+                    downloading = true;
+                    boolean waiting = download != null && download.mWaiting;
+                    row.setSummary(
+                            getString(
+                                    waiting
+                                            ? R.string.tark_captions_waiting_for_wifi
+                                            : R.string.tark_voice_downloading));
+                    row.show(
+                            LanguageRow.DOWNLOADING,
+                            download != null && !waiting ? download.mPercent : -1,
+                            null);
+                    break;
+                case AVAILABLE:
+                    boolean failed = download != null && download.mFailed;
+                    row.setSummary(
+                            failed
+                                    ? getString(R.string.tark_captions_download_failed)
+                                    : entry.reason());
+                    row.show(
+                            failed ? LanguageRow.FAILED : LanguageRow.AVAILABLE,
+                            -1,
+                            () -> startDownload(entry.tag()));
+                    break;
+            }
+            category.addPreference(row);
+        }
+        return downloading;
+    }
+
+    /**
+     * Spoken-language detection's row, from captions' downloader: updated when it reports a change,
+     * and read again slowly as a fallback while the detector waits for Wi-Fi or downloads.
+     */
+    @VisibleForTesting
+    void showDetection() {
+        mHandler.removeCallbacks(mDetectorRefresh);
+        DetectionRow row = findPreference(DETECTION_ROW_KEY);
+        if (row == null || !isAlive() || Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            return;
+        }
+        VoiceDetector.Status status = VoiceDetector.status();
+        int shown = DetectionRow.OFF;
+        if (status.wanted) {
+            switch (status.state) {
+                case TarkCaptionsBridge.UNIT_READY:
+                    shown = DetectionRow.ON;
+                    break;
+                case TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI:
+                    // A failed try waits for the next one, on any network: not for Wi-Fi.
+                    shown = status.retrying ? DetectionRow.RETRYING : DetectionRow.WAITING;
+                    break;
+                case TarkCaptionsBridge.UNIT_DOWNLOADING:
+                    shown = DetectionRow.DOWNLOADING;
+                    break;
+                case TarkCaptionsBridge.UNIT_FAILED:
+                    shown = DetectionRow.FAILED;
+                    break;
+                default:
+                    // Asked for, yet neither here nor coming (removed elsewhere): Get again.
+                    break;
+            }
+        }
+        int percent =
+                status.total > 0 ? (int) Math.min(100, status.bytes * 100 / status.total) : -1;
+        switch (shown) {
+            case DetectionRow.ON:
+                row.setSummary(R.string.tark_voice_detection_on);
+                row.show(shown, -1, this::removeDetector);
+                break;
+            case DetectionRow.WAITING:
+                row.setSummary(R.string.tark_captions_waiting_for_wifi);
+                row.show(shown, -1, () -> getDetector(true));
+                break;
+            case DetectionRow.DOWNLOADING:
+                row.setSummary(R.string.tark_voice_downloading);
+                row.show(shown, percent, null);
+                break;
+            case DetectionRow.RETRYING:
+                row.setSummary(R.string.tark_voice_detection_retrying);
+                row.show(shown, -1, null);
+                break;
+            case DetectionRow.FAILED:
+                row.setSummary(R.string.tark_captions_download_failed);
+                row.show(shown, -1, () -> getDetector(mDetectorNow));
+                break;
+            default:
+                // Already here for captions: Get downloads nothing.
+                row.setSummary(
+                        status.state == TarkCaptionsBridge.UNIT_READY
+                                ? getString(R.string.tark_voice_detection_already_here)
+                                : getString(
+                                        R.string.tark_voice_detection_summary,
+                                        Formatter.formatShortFileSize(
+                                                getContext(), status.total)));
+                row.show(shown, -1, () -> getDetector(false));
+                break;
+        }
+        if (mResumed
+                && (shown == DetectionRow.WAITING
+                        || shown == DetectionRow.DOWNLOADING
+                        || shown == DetectionRow.RETRYING)) {
+            mHandler.postDelayed(mDetectorRefresh, DETECTOR_REFRESH_MS);
+        }
+    }
+
+    private void onDetectorChanged() {
+        if (mDetectorUpdatePosted) return;
+        mDetectorUpdatePosted = true;
+        mHandler.post(
+                () -> {
+                    mDetectorUpdatePosted = false;
+                    if (mResumed) showDetection();
+                });
+    }
+
+    private void getDetector(boolean now) {
+        if (!isAlive()) return;
+        mDetectorNow = now;
+        VoiceDetector.get(now);
+        showDetection();
+    }
+
+    private void removeDetector() {
+        if (!isAlive()) return;
+        VoiceDetector.remove();
+        showDetection();
+    }
+
+    /** Sites: the language chosen for each site, each with Remove; hidden when there are none. */
+    private void fillSites() {
+        PreferenceCategory category = findPreference(SITES_KEY);
+        if (category == null) return;
+        category.removeAll();
+        Map<String, String> sites = VoiceSiteLanguages.all();
+        category.setVisible(!sites.isEmpty());
+        Locale ui = getResources().getConfiguration().getLocales().get(0);
+        // Named as the lists name them (Task 2's rule), against Android's list once it answered.
+        List<String> known = new ArrayList<>(sites.values());
+        if (mSupport != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            readSupport(mSupport, known, known, known);
+        }
+        for (Map.Entry<String, String> site : sites.entrySet()) {
+            String origin = site.getKey();
+            String host = VoiceSiteLanguages.hostOf(origin);
+            SiteRow row =
+                    new SiteRow(
+                            getContext(),
+                            origin,
+                            getString(R.string.tark_voice_site_remove_description, host),
+                            () -> removeSite(origin));
+            row.setKey(SITE_KEY_PREFIX + origin);
+            row.setTitle(host);
+            row.setSummary(VoiceLanguages.displayName(site.getValue(), known, ui));
+            category.addPreference(row);
+        }
+    }
+
+    private void removeSite(String origin) {
+        if (!isAlive()) return;
+        VoiceSiteLanguages.remove(origin);
+        fillSites();
+    }
+
