+
+/**
+ * Tark: Settings › Languages › Voice languages (spec §1, mockups 1 and 2). The languages Android's
+ * on-device recognizer has (the phone's default marked "Used when a site doesn't say"), the ones
+ * suggested from the person's own languages with the reason, and the rest; each downloads with
+ * one tap through Android. Android 12 can't list or download them, so there the page says so and
+ * opens Android's voice input settings instead.
+ *
+ * <p>The list is read again on resume and every few seconds while something downloads. Tark keeps
+ * no download logic of its own: progress where Android 14 reports it, "Downloading…" otherwise,
+ * and a failure offers Try again.
+ */
+@NullMarked
+public class VoiceLanguagesSettings extends ChromeBaseSettingsFragment {
+    static final String INTRO_KEY = "voice_languages_intro";
+    static final String ON_PHONE_KEY = "voice_languages_on_phone";
+    static final String SUGGESTED_KEY = "voice_languages_suggested";
+    static final String MORE_KEY = "voice_languages_more";
+    static final String NEEDS_ANDROID_13_KEY = "voice_languages_needs_android_13";
+    static final String SYSTEM_SETTINGS_KEY = "voice_languages_system_settings";
+    private static final String ROW_KEY_PREFIX = "voice_language_";
+
+    /** How often the list is read again while a language downloads. */
+    static final long REFRESH_INTERVAL_MS = 3000;
+
+    private static @Nullable Map<String, Reason> sSignalsForTesting;
+
+    /** A download Tark asked for, as far as Android has told (API 34) or not (API 33). */
+    private static final class Download {
+        /** 0-100, or -1 before (or without) any progress. */
+        int mPercent = -1;
+
+        boolean mWaiting;
+        boolean mFailed;
+    }
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mRefresh = this::refresh;
+    // Tags whose download was asked for here; kept until Android lists them as installed.
+    private final Map<String, Download> mDownloads = new HashMap<>();
+    private VoicePlatform mPlatform = VoicePlatform.get();
+    private @Nullable Map<String, Reason> mSignals;
+    private @Nullable RecognitionSupport mSupport;
+    private boolean mResumed;
+    // Ignores a support answer that a newer request overtook.
+    private int mRequest;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.tark_voice_languages_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.voice_languages_preferences);
+        mPlatform = VoicePlatform.get();
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            // Android 12: no list, only Android's own settings.
+            for (String key : new String[] {INTRO_KEY, ON_PHONE_KEY, SUGGESTED_KEY, MORE_KEY}) {
+                Preference preference = findPreference(key);
+                if (preference != null) preference.setVisible(false);
+            }
+            Preference line = findPreference(NEEDS_ANDROID_13_KEY);
+            Preference button = findPreference(SYSTEM_SETTINGS_KEY);
+            if (line != null) line.setVisible(true);
+            if (button != null) {
+                button.setVisible(true);
+                button.setOnPreferenceClickListener(
+                        p -> {
+                            mPlatform.openSystemSettings(getContext());
+                            return true;
+                        });
+            }
+            return;
+        }
+        // Empty until Android answers.
+        for (String key : new String[] {ON_PHONE_KEY, SUGGESTED_KEY, MORE_KEY}) {
+            Preference section = findPreference(key);
+            if (section != null) section.setVisible(false);
+        }
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        mResumed = true;
+        mSignals = null; // The person may have changed a language meanwhile.
+        refresh();
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        mResumed = false;
+        mHandler.removeCallbacks(mRefresh);
+    }
+
+    @VisibleForTesting
+    static void setSignalsForTesting(@Nullable Map<String, Reason> signals) {
+        sSignalsForTesting = signals;
+        ResettersForTesting.register(() -> sSignalsForTesting = null);
+    }
+
+    /** Asks Android for its languages again. */
+    @VisibleForTesting
+    void refresh() {
+        mHandler.removeCallbacks(mRefresh);
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        int request = ++mRequest;
+        mPlatform.support(
+                getContext(),
+                support -> {
+                    if (request != mRequest || !isAdded()) return;
+                    mSupport = support;
+                    showSections(support);
+                });
+    }
+
+    private Map<String, Reason> signals() {
+        if (sSignalsForTesting != null) return sSignalsForTesting;
+        if (mSignals == null) mSignals = VoiceLanguageSignals.read(getContext());
+        return mSignals;
+    }
+
+    private void showSections(@Nullable RecognitionSupport support) {
+        List<String> installed = new ArrayList<>();
+        List<String> pending = new ArrayList<>();
+        List<String> supported = new ArrayList<>();
+        if (support != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            readSupport(support, installed, pending, supported);
+        }
+        // A download that Android has finished is Android's to show from now on.
+        for (String tag : installed) mDownloads.remove(tag);
+        for (Map.Entry<String, Download> download : mDownloads.entrySet()) {
+            if (!download.getValue().mFailed && !pending.contains(download.getKey())) {
+                pending.add(download.getKey());
+            }
+        }
+
+        Locale phone = LocaleList.getDefault().get(0);
+        Locale ui = getResources().getConfiguration().getLocales().get(0);
+        Sections sections =
+                VoiceLanguages.build(installed, pending, supported, signals(), phone, ui);
+        @Nullable String defaultTag = defaultLanguage(sections.onPhone(), phone);
+
+        boolean downloading = false;
+        downloading |= fill(ON_PHONE_KEY, sections.onPhone(), defaultTag);
+        downloading |= fill(SUGGESTED_KEY, sections.suggested(), null);
+        downloading |= fill(MORE_KEY, sections.more(), null);
+        if (downloading && mResumed) mHandler.postDelayed(mRefresh, REFRESH_INTERVAL_MS);
+    }
+
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static void readSupport(
+            RecognitionSupport support,
+            List<String> installed,
+            List<String> pending,
+            List<String> supported) {
+        installed.addAll(support.getInstalledOnDeviceLanguages());
+        pending.addAll(support.getPendingOnDeviceLanguages());
+        supported.addAll(support.getSupportedOnDeviceLanguages());
+    }
+
+    /**
+     * The installed language the recognizer uses when a site names none: the phone's language,
+     * in its region if installed, else in the first installed region.
+     */
+    @VisibleForTesting
+    static @Nullable String defaultLanguage(List<Entry> onPhone, Locale phone) {
+        String phoneTag = phone.toLanguageTag();
+        @Nullable String sameLanguage = null;
+        for (Entry entry : onPhone) {
+            if (entry.state() != State.INSTALLED) continue;
+            if (entry.tag().equalsIgnoreCase(phoneTag)) return entry.tag();
+            String language = Locale.forLanguageTag(entry.tag()).getLanguage();
+            if (sameLanguage == null && language.equals(phone.getLanguage())) {
+                sameLanguage = entry.tag();
+            }
+        }
+        return sameLanguage;
+    }
+
+    /** Fills a section; returns whether one of its rows is downloading. */
+    private boolean fill(String key, List<Entry> entries, @Nullable String defaultTag) {
+        PreferenceCategory category = findPreference(key);
+        if (category == null) return false;
+        category.removeAll();
+        category.setVisible(!entries.isEmpty());
+        boolean downloading = false;
+        for (Entry entry : entries) {
+            LanguageRow row = new LanguageRow(getContext(), entry.tag());
+            row.setKey(ROW_KEY_PREFIX + entry.tag());
+            row.setTitle(entry.displayName());
+            Download download = mDownloads.get(entry.tag());
+            switch (entry.state()) {
+                case INSTALLED:
+                    row.setSummary(
+                            entry.tag().equals(defaultTag)
+                                    ? getString(R.string.tark_voice_default_language)
+                                    : null);
+                    row.show(LanguageRow.READY, -1, null);
+                    break;
+                case PENDING:
+                    downloading = true;
+                    boolean waiting = download != null && download.mWaiting;
+                    row.setSummary(
+                            getString(
+                                    waiting
+                                            ? R.string.tark_captions_waiting_for_wifi
+                                            : R.string.tark_voice_downloading));
+                    row.show(
+                            LanguageRow.DOWNLOADING,
+                            download != null && !waiting ? download.mPercent : -1,
+                            null);
+                    break;
+                case AVAILABLE:
+                    boolean failed = download != null && download.mFailed;
+                    row.setSummary(
+                            failed
+                                    ? getString(R.string.tark_captions_download_failed)
+                                    : entry.reason());
+                    row.show(
+                            failed ? LanguageRow.FAILED : LanguageRow.AVAILABLE,
+                            -1,
+                            () -> startDownload(entry.tag()));
+                    break;
+            }
+            category.addPreference(row);
+        }
+        return downloading;
+    }
+
+    /** Download (or Try again): Android downloads the language. */
+    @VisibleForTesting
+    void startDownload(String tag) {
+        Download download = new Download();
+        mDownloads.put(tag, download);
+        // Android 13 reports nothing; the list's pending languages tell instead.
+        VoicePlatform.DownloadListener listener =
+                Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE
+                        ? new VoicePlatform.DownloadListener() {
+                            @Override
+                            public void onProgress(int percent) {
+                                download.mPercent = percent;
+                                download.mWaiting = false;
+                                update(download);
+                            }
+
+                            @Override
+                            public void onSuccess() {
+                                // Kept as downloading until Android lists it as installed.
+                                download.mPercent = 100;
+                                download.mWaiting = false;
+                                if (isAdded() && mDownloads.get(tag) == download) refresh();
+                            }
+
+                            @Override
+                            public void onScheduled() {
+                                download.mWaiting = true;
+                                update(download);
+                            }
+
+                            @Override
+                            public void onError(int error) {
+                                download.mFailed = true;
+                                update(download);
+                            }
+                        }
+                        : null;
+        mPlatform.download(getContext(), tag, listener);
+        showSections(mSupport);
+    }
+
+    private void update(Download download) {
+        if (!isAdded() || !mDownloads.containsValue(download)) return;
+        showSections(mSupport);
+    }
+
+    /** A language: its name, a line below, and Ready, progress, or a Download button. */
+    @VisibleForTesting
+    static final class LanguageRow extends Preference {
+        static final int READY = 0;
+        static final int DOWNLOADING = 1;
+        static final int AVAILABLE = 2;
+        static final int FAILED = 3;
+
+        private final String mTag;
+        private int mStatus = READY;
+        private int mPercent = -1;
+        private @Nullable Runnable mAction;
+
+        LanguageRow(Context context, String tag) {
+            super(context);
+            mTag = tag;
+            setPersistent(false);
+        }
+
+        void show(int status, int percent, @Nullable Runnable action) {
+            mStatus = status;
+            mPercent = percent;
+            mAction = action;
+            setSelectable(action != null);
+            setOnPreferenceClickListener(
+                    action == null
+                            ? null
+                            : p -> {
+                                action.run();
+                                return true;
+                            });
+            notifyChanged();
+        }
+
+        String getLanguageTag() {
+            return mTag;
+        }
+
+        int getStatus() {
+            return mStatus;
+        }
+
+        /** Whether a progress bar shows (Android 14 reported progress). */
+        boolean showsProgress() {
+            return mStatus == DOWNLOADING && mPercent >= 0;
+        }
+
+        int getPercent() {
+            return mPercent;
+        }
+
+        /** Download, or Try again. */
+        void tapAction() {
+            if (mAction != null) mAction.run();
+        }
+
+        @Override
+        public void onBindViewHolder(PreferenceViewHolder holder) {
+            super.onBindViewHolder(holder);
+            View frame = holder.findViewById(android.R.id.widget_frame);
+            if (!(frame instanceof ViewGroup widgetFrame)) return;
+            widgetFrame.removeAllViews();
+            Context context = getContext();
+            View widget = null;
+            switch (mStatus) {
+                case READY:
+                    TextView ready = new TextView(context);
+                    ready.setTextAppearance(R.style.TextAppearance_TextMedium_Secondary);
+                    ready.setText(R.string.tark_voice_ready);
+                    widget = ready;
+                    break;
+                case DOWNLOADING:
+                    if (mPercent < 0) break;
+                    ProgressBar bar =
+                            new ProgressBar(
+                                    context, null, android.R.attr.progressBarStyleHorizontal);
+                    bar.setMax(100);
+                    bar.setProgress(mPercent);
+                    int width =
+                            context.getResources()
+                                    .getDimensionPixelSize(R.dimen.min_touch_target_size);
+                    bar.setLayoutParams(
+                            new ViewGroup.LayoutParams(
+                                    2 * width, ViewGroup.LayoutParams.WRAP_CONTENT));
+                    widget = bar;
+                    break;
+                case AVAILABLE:
+                case FAILED:
+                    ButtonCompat button = new ButtonCompat(context, R.style.TextButtonThemeOverlay);
+                    button.setText(
+                            mStatus == FAILED
+                                    ? R.string.tark_captions_try_again
+                                    : R.string.tark_speech_language_download);
+                    button.setOnClickListener(v -> tapAction());
+                    widget = button;
+                    break;
+            }
+            if (widget == null) {
+                widgetFrame.setVisibility(View.GONE);
+                return;
+            }
+            widgetFrame.setVisibility(View.VISIBLE);
+            if (widgetFrame instanceof android.widget.LinearLayout linear) {
+                linear.setGravity(Gravity.CENTER_VERTICAL | Gravity.END);
+            }
+            widgetFrame.addView(widget);
+        }
+    }
+}
