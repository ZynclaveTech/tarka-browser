+        if (!(frame instanceof ViewGroup widgetFrame)) return;
+        widgetFrame.removeAllViews();
+        if (widget == null) {
+            widgetFrame.setVisibility(View.GONE);
+            return;
+        }
+        widgetFrame.setVisibility(View.VISIBLE);
+        if (widgetFrame instanceof android.widget.LinearLayout linear) {
+            linear.setGravity(Gravity.CENTER_VERTICAL | Gravity.END);
+        }
+        widgetFrame.addView(widget);
+    }
