+    @Test
+    public void testOriginNotUrl() {
+        VoiceSiteLanguages.set("https://Shodhya.com/search?q=secret#frag", "hi-IN");
+        VoiceSiteLanguages.set("http://localhost:8080/a/b?c=d", "ta-IN");
+        VoiceSiteLanguages.set("https://example.com:443/path", "bn-IN");
+
+        // Only scheme://host[:port] is ever stored; no path, query or fragment.
+        assertEquals(
+                Map.of(
+                        "https://shodhya.com", "hi-IN",
+                        "http://localhost:8080", "ta-IN",
+                        "https://example.com", "bn-IN"),
+                stored());
+        for (String key : stored().keySet()) {
+            assertFalse(key, key.contains("search") || key.contains("?") || key.contains("/a"));
+        }
+        // Any URL of the site finds it.
+        assertEquals("hi-IN", VoiceSiteLanguages.get("https://shodhya.com/other"));
+        assertEquals("shodhya.com", VoiceSiteLanguages.hostOf("https://shodhya.com"));
+        // The scheme when it isn't https, the port when it isn't the default.
+        assertEquals("http://localhost:8080", VoiceSiteLanguages.hostOf("http://localhost:8080"));
+        assertEquals("http://example.com", VoiceSiteLanguages.hostOf("http://example.com"));
+        assertEquals("shodhya.com:8443", VoiceSiteLanguages.hostOf("https://shodhya.com:8443"));
+    }
