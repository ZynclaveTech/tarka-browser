diff '--color=never' -ruN a/chrome/android/junit/src/org/chromium/chrome/browser/speech/VoiceLanguagesTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/speech/VoiceLanguagesTest.java
--- a/chrome/android/junit/src/org/chromium/chrome/browser/speech/VoiceLanguagesTest.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/speech/VoiceLanguagesTest.java	2026-10-25 02:36:40.695121131 +0530
@@ -0,0 +1,216 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Entry;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Reason;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Sections;
+import org.chromium.chrome.browser.speech.VoiceLanguages.State;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/** Tests for {@link VoiceLanguages}. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class VoiceLanguagesTest {
+    private static final Locale PHONE_IN = Locale.forLanguageTag("en-IN");
+    private static final Locale PHONE_US = Locale.US;
+    private static final Locale UI = Locale.US;
+
+    private static List<String> tags(List<Entry> entries) {
+        List<String> result = new ArrayList<>();
+        for (Entry e : entries) result.add(e.tag());
+        return result;
+    }
+
+    private static Map<String, Reason> signals(Object... pairs) {
+        Map<String, Reason> map = new LinkedHashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) map.put((String) pairs[i], (Reason) pairs[i + 1]);
+        return map;
+    }
+
+    @Test
+    public void testSectionsFromSupport() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of("en-IN", "en-US"),
+                        List.of(),
+                        List.of("en-IN", "en-US", "hi-IN", "ta-IN", "bn-IN"),
+                        signals("hi", Reason.TARK_LANGUAGES, "ta", Reason.PHONE),
+                        PHONE_IN,
+                        UI);
+
+        assertEquals(List.of("en-IN", "en-US"), tags(s.onPhone()));
+        for (Entry e : s.onPhone()) {
+            assertEquals(State.INSTALLED, e.state());
+            assertNull(e.reason());
+        }
+
+        assertEquals(List.of("hi-IN", "ta-IN"), tags(s.suggested()));
+        assertEquals("You type Hindi with Tark's keyboard", s.suggested().get(0).reason());
+        assertEquals("One of your phone's languages", s.suggested().get(1).reason());
+        assertEquals(State.AVAILABLE, s.suggested().get(0).state());
+        assertEquals("Hindi (India)", s.suggested().get(0).displayName());
+
+        assertEquals(List.of("bn-IN"), tags(s.more()));
+        assertNull(s.more().get(0).reason());
+    }
+
+    @Test
+    public void testCaptionsReasonNamesLanguage() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of(),
+                        List.of(),
+                        List.of("bn-IN"),
+                        signals("bn", Reason.CAPTIONS),
+                        PHONE_IN,
+                        UI);
+        String bengali = Locale.forLanguageTag("bn").getDisplayLanguage(UI);
+        assertEquals("You watch captions in " + bengali, s.suggested().get(0).reason());
+    }
+
+    @Test
+    public void testMoreSortedByDisplayName() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of(),
+                        List.of(),
+                        List.of("ta-IN", "bn-IN", "hi-IN"),
+                        signals(),
+                        PHONE_IN,
+                        UI);
+        assertEquals(List.of("bn-IN", "hi-IN", "ta-IN"), tags(s.more()));
+    }
+
+    // A legacy code in a signal ("iw") matches the tag's language. ("iw-IL" itself fails
+    // isWellFormedTag's round trip, which turns it into "he-IL".)
+    @Test
+    public void testLegacyCodeSignalMatches() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of(),
+                        List.of(),
+                        List.of("he-IL", "en-US"),
+                        signals("iw", Reason.PHONE),
+                        PHONE_US,
+                        UI);
+        assertEquals(List.of("he-IL"), tags(s.suggested()));
+    }
+
+    @Test
+    public void testNullTagDropped() {
+        List<String> supported = new ArrayList<>();
+        supported.add(null);
+        supported.add("hi-IN");
+        Sections s =
+                VoiceLanguages.build(List.of(), List.of(), supported, signals(), PHONE_IN, UI);
+        assertEquals(List.of("hi-IN"), tags(s.more()));
+    }
+
+    @Test
+    public void testInstalledOtherRegionNotSuggested() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of("hi-IN"),
+                        List.of(),
+                        List.of("hi-IN", "hi-Latn-IN", "en-US"),
+                        signals("hi", Reason.TARK_LANGUAGES),
+                        PHONE_US,
+                        UI);
+        assertTrue(s.suggested().isEmpty());
+        assertEquals(List.of("hi-IN"), tags(s.onPhone()));
+    }
+
+    @Test
+    public void testInstalledOtherRegionOnlyInMore() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of("hi-IN"),
+                        List.of(),
+                        List.of("hi-IN", "hi-US"),
+                        signals("hi", Reason.TARK_LANGUAGES),
+                        PHONE_US,
+                        UI);
+        assertTrue(s.suggested().isEmpty());
+        assertEquals(List.of("hi-US"), tags(s.more()));
+    }
+
+    @Test
+    public void testRegionPrefersPhoneRegion() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of(),
+                        List.of(),
+                        List.of("es-ES", "es-US"),
+                        signals("es", Reason.PHONE),
+                        PHONE_US,
+                        UI);
+        assertEquals(List.of("es-US"), tags(s.suggested()));
+        assertEquals(List.of("es-ES"), tags(s.more()));
+    }
+
+    @Test
+    public void testRegionFallsBackToFirstListed() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of(),
+                        List.of(),
+                        List.of("es-ES", "es-US"),
+                        signals("es", Reason.PHONE),
+                        PHONE_IN,
+                        UI);
+        assertEquals(List.of("es-ES"), tags(s.suggested()));
+        assertEquals(List.of("es-US"), tags(s.more()));
+    }
+
+    @Test
+    public void testMalformedTagsDropped() {
+        String longTag = "en-" + "a".repeat(37);
+        assertEquals(40, longTag.length());
+        Sections s =
+                VoiceLanguages.build(
+                        List.of("en US"),
+                        List.of(longTag),
+                        List.of("en US", longTag, "hi-IN"),
+                        signals("en", Reason.PHONE),
+                        PHONE_US,
+                        UI);
+        List<String> all = new ArrayList<>();
+        all.addAll(tags(s.onPhone()));
+        all.addAll(tags(s.suggested()));
+        all.addAll(tags(s.more()));
+        assertEquals(List.of("hi-IN"), all);
+    }
+
+    @Test
+    public void testPendingShownOnPhone() {
+        Sections s =
+                VoiceLanguages.build(
+                        List.of("en-US"),
+                        List.of("hi-IN"),
+                        List.of("en-US", "hi-IN", "ta-IN"),
+                        signals("hi", Reason.TARK_LANGUAGES),
+                        PHONE_IN,
+                        UI);
+        assertEquals(List.of("en-US", "hi-IN"), tags(s.onPhone()));
+        assertEquals(State.PENDING, s.onPhone().get(1).state());
+        assertTrue(s.suggested().isEmpty());
+        assertEquals(List.of("ta-IN"), tags(s.more()));
+    }
+}
