+    @VisibleForTesting
+    static final class DetectionRow extends Preference {
+        static final int OFF = 0;
+        static final int WAITING = 1;
+        static final int DOWNLOADING = 2;
+        static final int ON = 3;
+        static final int FAILED = 4;
+        static final int RETRYING = 5;
+
+        private int mStatus = OFF;
+        private int mPercent = -1;
+        private @Nullable Runnable mAction;
+
+        DetectionRow(Context context) {
+            super(context);
+            setPersistent(false);
+        }
+
+        void show(int status, int percent, @Nullable Runnable action) {
+            boolean changed = status != mStatus || percent != mPercent;
+            mStatus = status;
+            mPercent = percent;
+            mAction = action;
+            // A tap on the row gets the detector; only the button deletes it.
+            setSelectable(action != null && status != ON);
+            setOnPreferenceClickListener(
+                    action == null || status == ON
+                            ? null
+                            : p -> {
+                                action.run();
+                                return true;
+                            });
+            // Unchanged: no rebind, so the page can go idle.
+            if (changed) notifyChanged();
+        }
+
+        int getStatus() {
+            return mStatus;
+        }
+
+        int getPercent() {
+            return mPercent;
+        }
+
+        /** The button's label, or 0 without one. */
+        int getActionLabel() {
+            switch (mStatus) {
+                case OFF:
+                    return R.string.tark_voice_detection_get;
+                case WAITING:
+                    return R.string.tark_captions_download_now;
+                case FAILED:
+                    return R.string.tark_captions_try_again;
+                case ON:
+                    return R.string.tark_voice_detection_remove;
+                default:
+                    return 0;
+            }
+        }
+
