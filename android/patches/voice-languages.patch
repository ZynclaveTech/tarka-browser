+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import static org.junit.Assert.assertEquals;
+
+import android.os.LocaleList;
+
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.speech.VoiceLanguages.Reason;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Tests for {@link VoiceLanguageSignals}. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class VoiceLanguageSignalsTest {
+    private final LocaleList mDefaultLocales = LocaleList.getDefault();
+
+    @After
+    public void tearDown() {
+        LocaleList.setDefault(mDefaultLocales);
+    }
+
+    @Test
+    public void testSignalsMerge() {
+        Map<String, Reason> signals =
+                VoiceLanguageSignals.merge(
+                        List.of("en-IN", "ta-IN"), List.of("en", "hi"), List.of("hi", "es"));
+
+        Map<String, Reason> expected = new LinkedHashMap<>();
+        expected.put("en", Reason.PHONE);
+        expected.put("ta", Reason.PHONE);
+        expected.put("hi", Reason.TARK_LANGUAGES);
+        expected.put("es", Reason.CAPTIONS);
+        assertEquals(expected, signals);
+        assertEquals(List.of("en", "ta", "hi", "es"), List.copyOf(signals.keySet()));
+    }
+
+    @Test
+    public void testMalformedAndModelUnitsDropped() {
+        // Captions' ready units include translation models and the detector.
+        Map<String, Reason> signals =
+                VoiceLanguageSignals.merge(
+                        List.of("en US"),
+                        List.of(""),
+                        List.of("tr_indic_en", "language_id", "ta"));
+
+        assertEquals(Map.of("ta", Reason.CAPTIONS), signals);
+    }
+
+    @Test
+    public void testPhoneLanguagesFromLocaleList() {
+        LocaleList.setDefault(LocaleList.forLanguageTags("en-IN,ta-IN"));
+        assertEquals(List.of("en-IN", "ta-IN"), VoiceLanguageSignals.phoneLanguages());
+    }
+
+    @Test
+    public void testAcceptLanguagesSplit() {
+        // The accept-languages pref, as the profile stores it.
+        assertEquals(List.of("en-US", "en", "hi"), VoiceLanguageSignals.splitList("en-US,en,hi"));
+        assertEquals(List.of(), VoiceLanguageSignals.splitList(""));
+        assertEquals(List.of(), VoiceLanguageSignals.splitList(null));
+
+        Map<String, Reason> signals =
+                VoiceLanguageSignals.merge(
+                        List.of(), VoiceLanguageSignals.splitList("en-US, hi"), List.of());
+        assertEquals(List.of("en", "hi"), List.copyOf(signals.keySet()));
+    }
+}
