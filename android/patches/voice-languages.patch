+
+/**
+ * Tark (spec §2, mockup M3): offers the person's languages for voice search once, after a voice
+ * session ends. It shows only when Android (13+) has answered which languages it has and can get,
+ * and at least one of the person's languages is among those it can get; every suggestion starts
+ * ticked. Download asks Android for the ticked ones; it and "No thanks" end the offer for good
+ * ({@code tark.voice.offer} = "done"). Back or a tap outside closes it for this run only. Never
+ * for a private tab: their sessions have no origin, and a private tab in front waits too.
+ */
+@NullMarked
+public final class VoiceLanguageOffer {
+    @VisibleForTesting static final String PREF = "tark.voice.offer";
+    @VisibleForTesting static final String UNSEEN = "unseen";
+    @VisibleForTesting static final String DONE = "done";
+
+    /**
+     * An answer later than this is not acted on. Android's first answer after a start binds its
+     * speech service, which on a busy emulator took longer than 10 s; a session that started
+     * meanwhile is still checked right before the offer shows.
+     */
+    @VisibleForTesting static final long ANSWER_LIMIT_MS = 30_000;
+
+    /**
+     * Android may answer while Tark's window is not in front or focused yet (just after the
+     * session ended): the offer waits for it, a second at a time, a few times.
+     */
+    @VisibleForTesting static final long FOCUS_RETRY_MS = 1000;
+
+    @VisibleForTesting static final int FOCUS_TRIES = 5;
+
+    /** Where the offer shows and whose languages it offers; replaced in tests. */
+    @VisibleForTesting
+    interface Host {
+        /** The activity in front, or null if there is none to show on or it shows a private tab. */
+        @Nullable AppCompatActivity activity();
+
+        /** The person's languages by language subtag, with why each is one. */
+        Map<String, Reason> signals(Context context);
+
+        /** Whether a voice session (any tab's, private ones too) is starting or running. */
+        boolean sessionLive();
+    }
+
+    private static @Nullable Host sHostForTesting;
+    // Shown once in this run already (closed by back or outside, or answered).
+    private static boolean sShownThisRun;
+    // The question to Android in flight (0: none), and the last one asked.
+    private static int sAsking;
+    private static int sLastAsk;
+    // The offer on screen, and the listener that closes it if its activity goes.
+    private static @Nullable AlertDialog sDialog;
+    private static @Nullable ActivityStateListener sDialogActivityListener;
+
+    private VoiceLanguageOffer() {}
+
+    /** Whether a voice session is live: then nothing may ask Android anything. */
+    @MainThread
+    static boolean isSessionLive() {
+        return host().sessionLive();
+    }
+
+    /**
+     * A voice session for {@code origin} ended, and none is live: asks Android which languages
+     * it has and can get, to offer the person's languages if this is the first time. The answer
+     * (null included) also goes to {@link VoiceSiteLanguages#onSupport}, so callers ask nothing
+     * more.
+     *
+     * @return whether Android was asked.
+     */
+    @MainThread
+    static boolean onSessionEnded(Context context, String origin) {
+        ThreadUtils.assertOnUiThread();
+        if (origin.isEmpty() || Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return false;
+        if (sShownThisRun || sAsking != 0 || isDone() || isSessionLive()) return false;
+        int ask = ++sLastAsk;
+        sAsking = ask;
+        Context appContext = context.getApplicationContext();
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    if (sAsking == ask) sAsking = 0;
+                },
+                ANSWER_LIMIT_MS);
+        try {
+            VoicePlatform.get()
+                    .support(
+                            appContext,
+                            null,
+                            support -> {
+                                if (sAsking != ask) return; // Too late; asked again next time.
+                                sAsking = 0;
+                                VoiceSiteLanguages.onSupport(support);
+                                if (support == null) return; // Android didn't say: not done.
+                                offer(appContext, support, 0);
+                            });
+        } catch (RuntimeException e) {
+            // No recognizer to ask: ask again after the next session.
+            if (sAsking == ask) sAsking = 0;
+            return false;
+        }
+        return true;
+    }
+
+    private static void offer(Context appContext, RecognitionSupport support, int tries) {
+        if (sShownThisRun || isDone()) return;
+        Host host = host();
+        AppCompatActivity activity = host.activity();
+        if (activity == null || activity.isFinishing() || activity.isDestroyed()) {
+            if (tries + 1 < FOCUS_TRIES) {
+                PostTask.postDelayedTask(
+                        TaskTraits.UI_DEFAULT,
+                        () -> offer(appContext, support, tries + 1),
+                        FOCUS_RETRY_MS);
+            }
+            return;
+        }
+        List<Entry> suggested = suggestions(support, host.signals(activity), activity);
+        if (suggested.isEmpty()) return; // Nothing to offer yet: a later session may have some.
+        // A session started (perhaps a private one) while Android answered: not beside it.
+        if (host.sessionLive()) return;
+        sShownThisRun = true;
+        try {
+            show(activity, appContext, suggested);
+        } catch (RuntimeException e) {
+            // The window went away under us: offer again after a later session.
+            closeDialog();
+            sShownThisRun = false;
+        }
+    }
+
+    private static List<Entry> suggestions(
+            RecognitionSupport support, Map<String, Reason> signals, Activity activity) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return List.of();
+        return suggestionsFrom(support, signals, activity);
+    }
+
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static List<Entry> suggestionsFrom(
+            RecognitionSupport support, Map<String, Reason> signals, Activity activity) {
+        Locale phone = LocaleList.getDefault().get(0);
+        Locale ui = activity.getResources().getConfiguration().getLocales().get(0);
+        return VoiceLanguages.build(
+                        support.getInstalledOnDeviceLanguages(),
+                        support.getPendingOnDeviceLanguages(),
+                        support.getSupportedOnDeviceLanguages(),
+                        signals,
+                        phone,
+                        ui)
+                .suggested();
+    }
+
+    private static void show(Activity activity, Context appContext, List<Entry> suggested) {
+        int side = activity.getResources().getDimensionPixelSize(R.dimen.dialog_padding_sides);
+        LinearLayout content = new LinearLayout(activity);
+        content.setOrientation(LinearLayout.VERTICAL);
+        content.setPadding(side, side / 2, side, 0);
+
+        TextView message = new TextView(activity);
+        message.setTextAppearance(R.style.TextAppearance_TextMedium_Secondary);
+        message.setText(R.string.tark_voice_offer_message);
+        message.setPadding(0, 0, 0, side / 2);
+        content.addView(message);
+
+        List<CheckBox> boxes = new ArrayList<>();
+        List<String> tags = new ArrayList<>();
+        for (Entry entry : suggested) {
+            CheckBox box = new CheckBox(activity);
+            box.setTag(entry.tag());
+            tags.add(entry.tag());
+            box.setChecked(true);
+            SpannableStringBuilder text = new SpannableStringBuilder(entry.displayName());
+            text.setSpan(
+                    new TextAppearanceSpan(activity, R.style.TextAppearance_TextMedium_Primary),
+                    0,
+                    text.length(),
+                    Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            String reason = entry.reason();
+            if (reason != null) {
+                int start = text.length() + 1;
+                text.append('\n').append(reason);
+                text.setSpan(
+                        new TextAppearanceSpan(
+                                activity, R.style.TextAppearance_TextSmall_Secondary),
+                        start,
+                        text.length(),
+                        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            }
+            box.setText(text);
+            box.setPadding(box.getPaddingLeft(), side / 3, box.getPaddingRight(), side / 3);
+            boxes.add(box);
+            content.addView(box);
+        }
+        ScrollView scroll = new ScrollView(activity);
+        scroll.addView(content);
+
+        AlertDialog dialog =
+                new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.tark_voice_offer_title)
+                        .setView(scroll)
+                        .setPositiveButton(
+                                R.string.tark_speech_language_download,
+                                (d, which) -> {
+                                    for (int i = 0; i < boxes.size(); i++) {
+                                        if (!boxes.get(i).isChecked()) continue;
+                                        VoicePlatform.get().download(appContext, tags.get(i), null);
+                                    }
+                                    setDone();
+                                })
+                        .setNegativeButton(R.string.tark_xlit_no_thanks, (d, which) -> setDone())
+                        .create();
+        // Back or a tap outside: not answered, so a later run may offer again.
+        dialog.setOnDismissListener(
+                d -> {
+                    if (sDialog == d) forgetDialog();
+                });
+        dialog.setOnShowListener(d -> updateDownloadButton(dialog, boxes));
+        for (CheckBox box : boxes) {
+            box.setOnCheckedChangeListener((b, checked) -> updateDownloadButton(dialog, boxes));
+        }
+        sDialog = dialog;
+        // Closed with its activity, so nothing here outlives (or leaks) it.
+        ActivityStateListener listener =
+                (changed, state) -> {
+                    if (changed == activity && state == ActivityState.DESTROYED) closeDialog();
+                };
+        sDialogActivityListener = listener;
+        ApplicationStatus.registerStateListenerForAllActivities(listener);
+        dialog.show();
+    }
+
+    private static void closeDialog() {
+        AlertDialog dialog = sDialog;
+        forgetDialog();
+        if (dialog == null) return;
+        try {
+            dialog.dismiss();
+        } catch (RuntimeException e) {
+            // Its window is already gone.
+        }
+    }
+
+    private static void forgetDialog() {
+        sDialog = null;
+        ActivityStateListener listener = sDialogActivityListener;
+        sDialogActivityListener = null;
+        if (listener != null) ApplicationStatus.unregisterActivityStateListener(listener);
+    }
+
+    // Download needs at least one language ticked.
+    private static void updateDownloadButton(AlertDialog dialog, List<CheckBox> boxes) {
+        boolean any = false;
+        for (CheckBox box : boxes) any |= box.isChecked();
+        Button download = dialog.getButton(DialogInterface.BUTTON_POSITIVE);
+        if (download != null) download.setEnabled(any);
+    }
+
+    private static Host host() {
+        if (sHostForTesting != null) return sHostForTesting;
+        return new Host() {
+            @Override
+            public @Nullable AppCompatActivity activity() {
+                Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+                if (!(activity instanceof AppCompatActivity appCompat)) return null;
+                // In front and focused: not behind another window, not on its way out.
+                if (ApplicationStatus.getStateForActivity(activity) != ActivityState.RESUMED
+                        || !activity.hasWindowFocus()) {
+                    return null;
+                }
+                if (activity instanceof ChromeActivity chrome
+                        && (!chrome.areTabModelsInitialized()
+                                || chrome.getTabModelSelector().isIncognitoSelected())) {
+                    return null;
+                }
+                return appCompat;
+            }
+
+            @Override
+            public Map<String, Reason> signals(Context context) {
+                if (!ProfileManager.isInitialized()) return Map.of();
+                return VoiceLanguageSignals.read(
+                        context, ProfileManager.getLastUsedRegularProfile());
+            }
+
+            @Override
+            public boolean sessionLive() {
+                return SpeechRecognition.hasLiveSession();
+            }
+        };
+    }
+
+    // One short entry, read after a session ends.
+    private static SharedPreferences prefs() {
+        try (StrictModeContext ignored = StrictModeContext.allowDiskReads()) {
+            SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+            prefs.contains(PREF); // Waits for the file here, under the allowance.
+            return prefs;
+        }
+    }
+
+    @VisibleForTesting
+    static boolean isDone() {
+        return DONE.equals(prefs().getString(PREF, UNSEEN));
+    }
+
+    private static void setDone() {
+        prefs().edit().putString(PREF, DONE).apply();
+    }
+
+    @VisibleForTesting
+    static void setHostForTesting(@Nullable Host host) {
+        sHostForTesting = host;
+        ResettersForTesting.register(
+                () -> {
+                    sHostForTesting = null;
+                    sShownThisRun = false;
+                    sAsking = 0;
+                    forgetDialog();
+                });
+    }
+
+    /** The offer on screen, if any. */
+    @VisibleForTesting
+    static @Nullable AlertDialog getDialogForTesting() {
+        return sDialog;
+    }
+}
