+package org.chromium.chrome.browser.speech;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.speech.RecognitionSupport;
+
+import androidx.annotation.MainThread;
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ResettersForTesting;
+import org.chromium.base.StrictModeContext;
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * Tark: the voice language the person chose for a site ("Use … next time", or their own Switch),
+ * one per origin. Later sessions on that site start in it, even when the page names another
+ * {@code lang}. Kept on the phone only, in the {@code tark.voice.sites} preferences (origin →
+ * BCP 47 tag); the key is the origin alone (scheme://host:port), never a path or query.
+ *
+ * <p>Whether the phone still has a remembered language comes from Android's last answer, read
+ * after a session on a remembered site ends (never at startup, never during a session) and
+ * whenever Voice languages lists the phone's languages. Until Android has answered, the
+ * remembered language is tried; if the recognizer says it is gone, the session goes on in the
+ * page's language and the person hears so.
+ *
+ * <p>A cross-origin iframe is keyed by its own origin. Private tabs never reach here: the browser
+ * gives their sessions no origin.
+ */
+@NullMarked
+public final class VoiceSiteLanguages {
+    @VisibleForTesting static final String PREFS = "tark.voice.sites";
+
+    // The phone's installed recognizer languages as Android last said, or null if unknown.
+    private static @Nullable List<String> sInstalled;
+    // The check in flight, if any (0: none). A check Android never answers is given up after
+    // CHECK_TIMEOUT_MS.
+    private static int sChecking;
+    private static int sLastCheck;
+
+    @VisibleForTesting static final long CHECK_TIMEOUT_MS = 10_000;
+
+    private VoiceSiteLanguages() {}
+
+    /**
+     * The origin of {@code url} as scheme://host[:port] (lower case, default port left out), or
+     * null if it has no host.
+     */
+    @VisibleForTesting
+    static @Nullable String originOf(@Nullable String url) {
+        if (url == null || url.isEmpty()) return null;
+        URI uri;
+        try {
+            uri = new URI(url);
+        } catch (URISyntaxException e) {
+            return null;
+        }
+        String scheme = uri.getScheme();
+        String host = uri.getHost();
+        if (scheme == null || host == null || host.isEmpty()) return null;
+        scheme = scheme.toLowerCase(Locale.ROOT);
+        host = host.toLowerCase(Locale.ROOT);
+        int port = uri.getPort();
+        boolean defaultPort =
+                port == -1
+                        || (scheme.equals("https") && port == 443)
+                        || (scheme.equals("http") && port == 80);
+        return scheme + "://" + host + (defaultPort ? "" : ":" + port);
+    }
+
+    /**
+     * The site as Voice languages' Sites shows it: the host, with the port when it isn't the
+     * scheme's default and the scheme when it isn't https ("shodhya.com", "http://localhost:8080").
+     */
+    static String hostOf(String origin) {
+        try {
+            URI uri = new URI(origin);
+            String host = uri.getHost();
+            String scheme = uri.getScheme();
+            if (host != null && !host.isEmpty() && scheme != null) {
+                scheme = scheme.toLowerCase(Locale.ROOT);
+                int port = uri.getPort();
+                boolean defaultPort =
+                        port == -1
+                                || (scheme.equals("https") && port == 443)
+                                || (scheme.equals("http") && port == 80);
+                return (scheme.equals("https") ? "" : scheme + "://")
+                        + host
+                        + (defaultPort ? "" : ":" + port);
+            }
+        } catch (URISyntaxException e) {
+            // Shown as stored.
+        }
+        return origin;
+    }
+
+    // Read when a session starts and when the app starts: a few short entries.
+    private static SharedPreferences prefs() {
+        try (StrictModeContext ignored = StrictModeContext.allowDiskReads()) {
+            SharedPreferences prefs =
+                    ContextUtils.getApplicationContext()
+                            .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            prefs.contains(""); // Waits for the file here, under the allowance.
+            return prefs;
+        }
+    }
+
+    /** The language remembered for the site, or null. */
+    public static @Nullable String get(String origin) {
+        String key = originOf(origin);
+        if (key == null) return null;
+        String tag = prefs().getString(key, null);
+        return tag != null && SpeechLanguageSnackbar.isWellFormedTag(tag) ? tag : null;
+    }
+
+    /** Remembers {@code tag} for the site. Ignored unless both are well formed. */
+    public static void set(String origin, String tag) {
+        String key = originOf(origin);
+        if (key == null || !SpeechLanguageSnackbar.isWellFormedTag(tag)) return;
+        prefs().edit().putString(key, tag).apply();
+    }
+
+    /** Forgets the site's language. */
+    public static void remove(String origin) {
+        String key = originOf(origin);
+        if (key == null) return;
+        prefs().edit().remove(key).apply();
+    }
+
+    /** Every remembered site and its language, by origin. */
+    public static Map<String, String> all() {
+        Map<String, String> sites = new TreeMap<>();
+        for (Map.Entry<String, ?> entry : prefs().getAll().entrySet()) {
+            if (!(entry.getValue() instanceof String tag)) continue;
+            if (!SpeechLanguageSnackbar.isWellFormedTag(tag)) continue;
+            sites.put(entry.getKey(), tag);
+        }
+        return sites;
+    }
+
+    /**
+     * Whether Android said the phone lacks {@code tag}. False while it hasn't said (or can't, below
+     * Android 13).
+     */
+    @MainThread
+    static boolean isMissing(String tag) {
+        ThreadUtils.assertOnUiThread();
+        List<String> installed = sInstalled;
+        return installed != null && !SpeechLanguageSnackbar.listsLanguage(installed, tag);
+    }
+
+    /**
+     * Asks Android which languages the phone has, if any site is remembered. Called after a
+     * session ends, so it never runs beside a session's recognizer.
+     */
+    @MainThread
+    static void refreshInstalled(Context context) {
+        ThreadUtils.assertOnUiThread();
+        if (sChecking != 0 || Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        if (all().isEmpty()) return;
+        int check = ++sLastCheck;
+        sChecking = check;
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    if (sChecking == check) sChecking = 0;
+                },
+                CHECK_TIMEOUT_MS);
+        try {
+            VoicePlatform.get()
+                    .support(
+                            context,
+                            null,
+                            support -> {
+                                // A late answer after the timeout is still Android's latest.
+                                if (sChecking == check) sChecking = 0;
+                                onSupport(support);
+                            });
+        } catch (RuntimeException e) {
+            // No recognizer to ask (a binding Android refused): ask again next time.
+            if (sChecking == check) sChecking = 0;
+        }
+    }
+
+    /** Android's latest answer, from here or from Voice languages. */
+    @MainThread
+    static void onSupport(@Nullable RecognitionSupport support) {
+        ThreadUtils.assertOnUiThread();
+        if (support == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+            sInstalled = null;
+            return;
+        }
+        sInstalled = new ArrayList<>(support.getInstalledOnDeviceLanguages());
+    }
+
+    @VisibleForTesting
+    static void setInstalledForTesting(@Nullable List<String> installed) {
+        sInstalled = installed;
+        ResettersForTesting.register(
+                () -> {
+                    sInstalled = null;
+                    sChecking = 0;
+                });
+    }
+}
