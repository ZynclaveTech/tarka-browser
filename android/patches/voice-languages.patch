+import android.speech.RecognitionSupportCallback;
+import android.speech.RecognizerIntent;
+import android.speech.SpeechRecognizer;
+
+import androidx.annotation.RequiresApi;
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.Callback;
+import org.chromium.base.ResettersForTesting;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.Executor;
+import java.util.function.Function;
+import java.util.function.Predicate;
+
+/**
+ * Tark: Android's on-device speech recognizer as voice's settings and snackbar use it: which
+ * languages it has, is downloading and can download (API 33+), asking it to download one (API
+ * 33+, with progress on API 34+), and Android's voice input settings. Replaced in tests.
+ */
+@NullMarked
+interface VoicePlatform {
+    /** A download's progress, as API 34's {@link ModelDownloadListener} reports it. */
+    interface DownloadListener {
+        /** 0-100. */
+        void onProgress(int percent);
+
+        void onSuccess();
+
+        /** Android will download it later (on an unmetered network, for example). */
+        void onScheduled();
+
+        void onError(int error);
+    }
+
+    /**
+     * The recognizer's languages, or null if Android can't say (below API 33, no on-device
+     * recognizer, an error). {@code tag} is the language asked about, if any. Called back on the
+     * main thread.
+     */
+    void support(
+            Context context, @Nullable String tag, Callback<@Nullable RecognitionSupport> callback);
+
+    /**
+     * Asks Android to download {@code tag}. The listener hears about it only on API 34+; on API
+     * 33 nothing is reported. Does nothing below API 33.
+     */
+    void download(Context context, String tag, @Nullable DownloadListener listener);
+
+    /** Opens Android's voice input settings (where Android 12 downloads languages). */
+    void openSystemSettings(Context context);
+
+    /** The platform in use. */
+    static VoicePlatform get() {
+        if (Holder.sForTesting != null) return Holder.sForTesting;
+        if (Holder.sAndroid == null) Holder.sAndroid = new AndroidVoicePlatform();
+        return Holder.sAndroid;
+    }
+
+    @VisibleForTesting
+    static void setForTesting(@Nullable VoicePlatform platform) {
+        Holder.sForTesting = platform;
+        ResettersForTesting.register(() -> Holder.sForTesting = null);
+    }
+
+    /**
+     * The intent that opens Android's voice input settings, or Android's settings if nothing on
+     * this phone handles that one.
+     */
+    static Intent systemSettingsIntent(Context context) {
+        Intent intent = voiceInputSettingsIntent(context);
+        PackageManager packageManager = context.getPackageManager();
+        if (packageManager == null || intent.resolveActivity(packageManager) == null) {
+            intent = new Intent(Settings.ACTION_SETTINGS);
+            if (!(context instanceof Activity)) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        }
+        return intent;
+    }
+
+    /** The intent that opens Android's voice input settings, whether or not anything handles it. */
+    static Intent voiceInputSettingsIntent(Context context) {
+        Intent intent = new Intent(Settings.ACTION_VOICE_INPUT_SETTINGS);
+        if (!(context instanceof Activity)) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        return intent;
+    }
+
+    /** A recognizer intent for {@code tag}, or for no particular language if it is null. */
+    static Intent recognizerIntent(@Nullable String tag) {
+        Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
+        intent.putExtra(
+                RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
+        if (tag != null) intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, tag);
+        return intent;
+    }
+
+    /** Static state of an interface. */
+    final class Holder {
+        private static @Nullable VoicePlatform sForTesting;
+        private static @Nullable VoicePlatform sAndroid;
+
+        private Holder() {}
+    }
+
+    /** The parts of {@link SpeechRecognizer} used here; faked in tests. */
+    interface Recognizer {
+        @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+        void checkRecognitionSupport(
+                Intent intent, Executor executor, RecognitionSupportCallback callback);
+
+        @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+        void triggerModelDownload(Intent intent);
+
+        @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+        void triggerModelDownload(Intent intent, Executor executor, ModelDownloadListener listener);
+
+        void destroy();
+    }
+
+    /**
+     * The real one. Every recognizer is made from the application context, so nothing here holds
+     * an activity; a settings page's listener should itself hold its page weakly.
+     *
+     * <p>Each support check and each download gets a recognizer of its own rather than one shared
+     * recognizer: Android keeps a download request only while its recognizer lives, and destroying
+     * a shared one would cancel the others.
+     */
+    final class AndroidVoicePlatform implements VoicePlatform {
+        private final Function<Context, Recognizer> mFactory;
+        private final Predicate<Context> mAvailable;
+        // Recognizers asked for a download, by tag: each stays until its download ends (API 34+)
+        // or the tag is asked for again.
+        private final Map<String, Recognizer> mDownloads = new HashMap<>();
+
+        AndroidVoicePlatform() {
+            this(
+                    appContext -> {
+                        // Only the API 33+ paths ask for one.
+                        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+                            throw new IllegalStateException();
+                        }
+                        return createSystemRecognizer(appContext);
+                    },
+                    appContext ->
+                            Build.VERSION.SDK_INT >= Build.VERSION_CODES.S
+                                    && SpeechRecognizer.isOnDeviceRecognitionAvailable(appContext));
+        }
+
+        @VisibleForTesting
+        AndroidVoicePlatform(Function<Context, Recognizer> factory, Predicate<Context> available) {
+            mFactory = factory;
+            mAvailable = available;
+        }
+
+        @Override
+        public void support(
+                Context context,
+                @Nullable String tag,
+                Callback<@Nullable RecognitionSupport> callback) {
+            Context appContext = context.getApplicationContext();
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU
+                    || !mAvailable.test(appContext)) {
+                callback.onResult(null);
+                return;
+            }
+            checkSupport(appContext, tag, callback);
+        }
+
+        @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+        private void checkSupport(
+                Context appContext,
+                @Nullable String tag,
+                Callback<@Nullable RecognitionSupport> callback) {
+            Recognizer recognizer = mFactory.apply(appContext);
+            recognizer.checkRecognitionSupport(
+                    recognizerIntent(tag),
+                    appContext.getMainExecutor(),
+                    new RecognitionSupportCallback() {
+                        @Override
+                        public void onSupportResult(RecognitionSupport support) {
+                            recognizer.destroy();
+                            callback.onResult(support);
+                        }
+
+                        @Override
+                        public void onError(int error) {
+                            recognizer.destroy();
+                            callback.onResult(null);
+                        }
+                    });
+        }
+
+        @Override
+        public void download(Context context, String tag, @Nullable DownloadListener listener) {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+            Context appContext = context.getApplicationContext();
+            Recognizer previous = mDownloads.remove(tag);
+            if (previous != null) previous.destroy();
+            Recognizer recognizer = mFactory.apply(appContext);
+            mDownloads.put(tag, recognizer);
+            if (listener != null && Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                downloadWithListener(appContext, recognizer, tag, listener);
+            } else {
+                recognizer.triggerModelDownload(recognizerIntent(tag));
+            }
+        }
+
+        @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+        private void downloadWithListener(
+                Context appContext, Recognizer recognizer, String tag, DownloadListener listener) {
+            recognizer.triggerModelDownload(
+                    recognizerIntent(tag),
+                    appContext.getMainExecutor(),
+                    new ModelDownloadListener() {
+                        @Override
+                        public void onProgress(int completedPercent) {
+                            listener.onProgress(completedPercent);
+                        }
+
+                        @Override
+                        public void onSuccess() {
+                            finish(tag, recognizer);
+                            listener.onSuccess();
+                        }
+
+                        @Override
+                        public void onScheduled() {
+                            listener.onScheduled();
+                        }
+
+                        @Override
+                        public void onError(int error) {
+                            finish(tag, recognizer);
+                            listener.onError(error);
+                        }
+                    });
+        }
+
+        private void finish(String tag, Recognizer recognizer) {
+            if (mDownloads.get(tag) == recognizer) mDownloads.remove(tag);
+            recognizer.destroy();
+        }
+
+        @VisibleForTesting
+        int getDownloadCountForTesting() {
+            return mDownloads.size();
+        }
+
+        @Override
+        public void openSystemSettings(Context context) {
+            Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+            Context starter = context instanceof Activity || activity == null ? context : activity;
+            try {
+                starter.startActivity(systemSettingsIntent(starter));
+            } catch (ActivityNotFoundException e) {
+                // Nothing on this phone opens settings.
+            }
+        }
+
+        @RequiresApi(Build.VERSION_CODES.S)
+        private static Recognizer createSystemRecognizer(Context appContext) {
+            SpeechRecognizer recognizer =
+                    SpeechRecognizer.createOnDeviceSpeechRecognizer(appContext);
+            return new Recognizer() {
+                @Override
+                @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+                public void checkRecognitionSupport(
+                        Intent intent, Executor executor, RecognitionSupportCallback callback) {
+                    recognizer.checkRecognitionSupport(intent, executor, callback);
+                }
+
+                @Override
+                @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+                public void triggerModelDownload(Intent intent) {
+                    recognizer.triggerModelDownload(intent);
+                }
+
+                @Override
+                @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+                public void triggerModelDownload(
+                        Intent intent, Executor executor, ModelDownloadListener listener) {
+                    recognizer.triggerModelDownload(intent, executor, listener);
+                }
+
+                @Override
+                public void destroy() {
+                    recognizer.destroy();
+                }
+            };
+        }
+    }
+}
