+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.ResettersForTesting;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.tark_captions.TarkCaptionsBridge;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Tark: spoken-language detection's model (spec §3). It is live captions' {@code language_id}
+ * download unit (the ECAPA detector), which voice search shares: one copy on the phone, fetched by
+ * captions' downloader (on Wi-Fi unless "Download now"), nothing fetched when captions already
+ * have it, and kept when voice turns detection off while captions still want it.
+ */
+@NullMarked
+public final class VoiceDetector {
+    /** The unit's download, as captions' downloader reports it. */
+    public static final class Status {
+        /** One of TarkCaptionsBridge.UNIT_*. */
+        public final int state;
+
+        public final long bytes;
+        public final long total;
+
+        /** Whether voice search turned detection on (it may still be downloading). */
+        public final boolean wanted;
+
+        /** UNIT_WAITING_FOR_WIFI only: in fact waiting to try again after a failure. */
+        public final boolean retrying;
+
+        public Status(int state, long bytes, long total, boolean wanted, boolean retrying) {
+            this.state = state;
+            this.bytes = bytes;
+            this.total = total;
+            this.wanted = wanted;
+            this.retrying = retrying;
+        }
+
+        /** Detection is on: voice asked for it, and the model is on the phone. */
+        public boolean isOn() {
+            return wanted && state == TarkCaptionsBridge.UNIT_READY;
+        }
+    }
+
+    /** Captions' downloads, as voice search uses them; replaced in tests. */
+    @VisibleForTesting
+    interface Downloads {
+        /** {state, bytes, total[, retrying]} of a unit. */
+        long[] unitState(String unit);
+
+        boolean wantedByVoice(String unit);
+
+        /** Voice wants the unit. */
+        void request(String unit, boolean now);
+
+        /** Voice no longer wants the unit: deleted unless captions still want it. */
+        void remove(String unit);
+
+        /** `onChanged` runs when the unit's download changes (state or progress). */
+        void addListener(String unit, Runnable onChanged);
+
+        void removeListener(Runnable onChanged);
+    }
+
+    private static final class BridgeDownloads implements Downloads {
+        @Override
+        public long[] unitState(String unit) {
+            return TarkCaptionsBridge.getUnitState(unit);
+        }
+
+        @Override
+        public boolean wantedByVoice(String unit) {
+            return TarkCaptionsBridge.isUnitWantedBy(unit, TarkCaptionsBridge.OWNER_VOICE);
+        }
+
+        @Override
+        public void request(String unit, boolean now) {
+            TarkCaptionsBridge.requestUnit(unit, TarkCaptionsBridge.OWNER_VOICE, now);
+        }
+
+        @Override
+        public void remove(String unit) {
+            TarkCaptionsBridge.removeUnit(unit, TarkCaptionsBridge.OWNER_VOICE);
+        }
+
+        private final Map<Runnable, TarkCaptionsBridge.UnitListener> mListeners = new HashMap<>();
+
+        @Override
+        public void addListener(String unit, Runnable onChanged) {
+            TarkCaptionsBridge.UnitListener listener =
+                    changed -> {
+                        if (changed.equals(unit)) onChanged.run();
+                    };
+            mListeners.put(onChanged, listener);
+            TarkCaptionsBridge.addUnitListener(listener);
+        }
+
+        @Override
+        public void removeListener(Runnable onChanged) {
+            TarkCaptionsBridge.UnitListener listener = mListeners.remove(onChanged);
+            if (listener != null) TarkCaptionsBridge.removeUnitListener(listener);
+        }
+    }
+
+    private static @Nullable Downloads sDownloadsForTesting;
+
+    private VoiceDetector() {}
+
+    @VisibleForTesting
+    static void setDownloadsForTesting(@Nullable Downloads downloads) {
+        sDownloadsForTesting = downloads;
+        ResettersForTesting.register(() -> sDownloadsForTesting = null);
+    }
+
+    private static @Nullable Downloads sBridgeDownloads;
+
+    private static Downloads downloads() {
+        if (sDownloadsForTesting != null) return sDownloadsForTesting;
+        if (sBridgeDownloads == null) sBridgeDownloads = new BridgeDownloads();
+        return sBridgeDownloads;
+    }
+
+    /** The detector's state for voice search. */
+    public static Status status() {
+        Downloads downloads = downloads();
+        long[] state = downloads.unitState(TarkCaptionsBridge.LANGUAGE_ID_UNIT);
+        return new Status(
+                (int) state[0],
+                state[1],
+                state[2],
+                downloads.wantedByVoice(TarkCaptionsBridge.LANGUAGE_ID_UNIT),
+                state.length > 3 && state[3] != 0);
+    }
+
+    /** `onChanged` runs (on the UI thread) whenever the detector's download changes. */
+    public static void addListener(Runnable onChanged) {
+        downloads().addListener(TarkCaptionsBridge.LANGUAGE_ID_UNIT, onChanged);
+    }
+
+    public static void removeListener(Runnable onChanged) {
+        downloads().removeListener(onChanged);
+    }
+
+    /** Get (on Wi-Fi), "Download now" or Try again. */
+    public static void get(boolean now) {
+        downloads().request(TarkCaptionsBridge.LANGUAGE_ID_UNIT, now);
+    }
+
+    /** Turns detection off; the model goes unless captions still want it. */
+    public static void remove() {
+        downloads().remove(TarkCaptionsBridge.LANGUAGE_ID_UNIT);
+    }
+}
