+    private @Nullable ChromeSwitchPreference mTarkXlitSwitch;
+
+    /**
+     * Tark (A3, spec §5): turns the address bar's Indian-language suggestions on (downloading the
+     * model and the word lists of the person's languages, on Wi-Fi) or off (the files stay). Its
+     * summary says where the download is.
+     */
+    private void addTarkXlitSwitch() {
+        ChromeSwitchPreference xlitSwitch =
+                new ChromeSwitchPreference(getPreferenceManager().getContext());
+        xlitSwitch.setKey(TARK_XLIT_SWITCH_KEY);
+        xlitSwitch.setTitle(R.string.tark_xlit_switch_title);
+        xlitSwitch.setChecked(TarkXlitBridge.getOfferState() == TarkXlitBridge.ACCEPTED);
+        xlitSwitch.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    if ((boolean) newValue) {
+                        TarkXlitBridge.accept(/* now= */ false);
+                    } else {
+                        TarkXlitBridge.decline();
+                    }
+                    updateTarkXlitSummary();
+                    return true;
+                });
+        getPreferenceScreen().addPreference(xlitSwitch);
+        mTarkXlitSwitch = xlitSwitch;
+        updateTarkXlitSummary();
+    }
+
+    private void updateTarkXlitSummary() {
+        if (mTarkXlitSwitch == null) return;
+        String summary;
+        String[] names = TarkXlitBridge.getDownloadedLanguageNames();
+        if (TarkXlitBridge.getOfferState() != TarkXlitBridge.ACCEPTED) {
+            summary = getString(R.string.tark_xlit_switch_off);
+        } else if (TarkXlitBridge.isWaitingForWifi()) {
+            summary = getString(R.string.tark_xlit_switch_waiting);
+        } else if (names.length == 0) {
+            summary = getString(R.string.tark_xlit_switch_downloading);
+        } else {
+            summary = getString(R.string.tark_xlit_switch_downloaded, TextUtils.join(", ", names));
+        }
+        mTarkXlitSwitch.setSummary(summary);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateTarkXlitSummary();
     }
 
