+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.omaha;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.os.Build;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.omaha.UpdateStatusProvider.UpdateState;
+import org.chromium.chrome.browser.omaha.UpdateStatusProvider.UpdateStatus;
+
+/**
+ * Tark for Android (A5): the direct APK's update check, Java side. The native
+ * UpdateCheckService fetches gettarka.com's index at most once a day; a newer
+ * version is kept here and shown by {@link UpdateStatusProvider} as the app
+ * menu's "Update" item. Nothing runs when Google Play installed the app.
+ */
+@NullMarked
+@JNINamespace("tark_update")
+public final class TarkUpdate {
+    private static final String PLAY_STORE = "com.android.vending";
+    private static final String KEY_CODE = "tark.update.latest_code";
+    private static final String KEY_NAME = "tark.update.latest_name";
+    private static final String KEY_URL = "tark.update.latest_url";
+
+    private TarkUpdate() {}
+
+    /** Whether Google Play installed Tark: Play updates it, not this check. */
+    static boolean installedFromPlay() {
+        Context context = ContextUtils.getApplicationContext();
+        PackageManager pm = context.getPackageManager();
+        String installer;
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                installer =
+                        pm.getInstallSourceInfo(context.getPackageName())
+                                .getInstallingPackageName();
+            } else {
+                installer = pm.getInstallerPackageName(context.getPackageName());
+            }
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+        return PLAY_STORE.equals(installer);
+    }
+
+    @CalledByNative
+    static boolean isEnabled() {
+        return !installedFromPlay();
+    }
+
+    @CalledByNative
+    static long installedVersionCode() {
+        Context context = ContextUtils.getApplicationContext();
+        try {
+            return context.getPackageManager()
+                    .getPackageInfo(context.getPackageName(), 0)
+                    .getLongVersionCode();
+        } catch (PackageManager.NameNotFoundException e) {
+            return Long.MAX_VALUE;
+        }
+    }
+
+    /** A newer version, from the native check: kept, and shown in the menu. */
+    @CalledByNative
+    static void offer(
+            long versionCode,
+            @JniType("std::string") String versionName,
+            @JniType("std::string") String url) {
+        ThreadUtils.assertOnUiThread();
+        ContextUtils.getAppSharedPreferences()
+                .edit()
+                .putLong(KEY_CODE, versionCode)
+                .putString(KEY_NAME, versionName)
+                .putString(KEY_URL, url)
+                .apply();
+        UpdateStatusProvider.getInstance().onTarkUpdate();
+    }
+
+    /**
+     * The update the menu offers: the newest version a check found, while it
+     * is newer than the installed one; otherwise an update state of NONE.
+     */
+    static UpdateStatus status() {
+        UpdateStatus status = new UpdateStatus();
+        status.updateState = UpdateState.NONE;
+        if (installedFromPlay()) return status;
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        @Nullable String url = prefs.getString(KEY_URL, null);
+        if (url != null && prefs.getLong(KEY_CODE, 0) > installedVersionCode()) {
+            status.updateState = UpdateState.UPDATE_AVAILABLE;
+            status.updateUrl = url;
+            status.latestVersion = prefs.getString(KEY_NAME, null);
+        }
+        return status;
+    }
+}
