+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_update/update_index.h"
+
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+
+namespace tark_update {
+
+std::optional<UpdateIndex> ParseIndex(std::string_view json) {
+  if (json.size() > kMaxIndexBytes) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return std::nullopt;
+  }
+  const std::optional<int> code = dict->FindInt("version_code");
+  const std::string* name = dict->FindString("version_name");
+  const std::string* url = dict->FindString("url");
+  const std::optional<int> size = dict->FindInt("size");
+  const std::string* sha256 = dict->FindString("sha256");
+  if (!code || *code <= 0 || !name || !url || !size || *size <= 0 ||
+      !sha256) {
+    return std::nullopt;
+  }
+  UpdateIndex index;
+  index.version_code = *code;
+  index.version_name = *name;
+  index.url = GURL(*url);
+  index.size = *size;
+  index.sha256 = *sha256;
+  if (!index.url.is_valid() ||
+      !base::StartsWith(index.url.spec(), kApkPrefix)) {
+    return std::nullopt;
+  }
+  return index;
+}
+
+bool IsNewer(const UpdateIndex& index, int64_t installed_code) {
+  return index.version_code > installed_code;
+}
+
+bool ShouldCheckNow(base::Time now, base::Time last_check) {
+  return last_check.is_null() || last_check > now ||
+         now - last_check >= kCheckInterval;
+}
+
+}  // namespace tark_update
