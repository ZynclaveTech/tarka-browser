+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_update/update_index.h"
+
+#include <string>
+
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_update {
+namespace {
+
+constexpr char kIndex[] = R"({
+  "version_code": 805903902,
+  "version_name": "155.0.8059.39-r2",
+  "url": "https://gettarka.com/android/v1/tark-155.0.8059.39-r2.apk",
+  "size": 180386822,
+  "sha256": "e2e53f9658f8cff7694701eccc8e5a476d97819e6780b8e4f799409b543b9788"
+})";
+
+TEST(TarkUpdateIndexTest, ParseIndex_ReadsTheIndex) {
+  const std::optional<UpdateIndex> index = ParseIndex(kIndex);
+  ASSERT_TRUE(index);
+  EXPECT_EQ(index->version_code, 805903902);
+  EXPECT_EQ(index->version_name, "155.0.8059.39-r2");
+  EXPECT_EQ(index->url.spec(),
+            "https://gettarka.com/android/v1/tark-155.0.8059.39-r2.apk");
+  EXPECT_EQ(index->size, 180386822);
+}
+
+TEST(TarkUpdateIndexTest, ParseIndex_RejectsBadInput) {
+  // Not JSON, a list, a field missing, a field of the wrong type.
+  EXPECT_FALSE(ParseIndex("not json"));
+  EXPECT_FALSE(ParseIndex("[]"));
+  EXPECT_FALSE(ParseIndex(R"({"version_name": "x", "url":
+      "https://gettarka.com/android/v1/a.apk", "size": 1, "sha256": "ab"})"));
+  EXPECT_FALSE(ParseIndex(R"({"version_code": "805903902", "version_name": "x",
+      "url": "https://gettarka.com/android/v1/a.apk", "size": 1,
+      "sha256": "ab"})"));
+  // Only Tark's own folder on gettarka.com, over HTTPS.
+  for (const char* url :
+       {"http://gettarka.com/android/v1/a.apk",
+        "https://example.com/android/v1/a.apk",
+        "https://gettarka.com.example.com/android/v1/a.apk",
+        "https://gettarka.com/other/a.apk"}) {
+    const std::string json =
+        std::string(R"({"version_code": 2, "version_name": "x", "url": ")") +
+        url + R"(", "size": 1, "sha256": "ab"})";
+    EXPECT_FALSE(ParseIndex(json)) << url;
+  }
+  // Over 64 KiB, even if it would parse.
+  std::string big(R"({"version_code": 2, "version_name": "x", "url":
+      "https://gettarka.com/android/v1/a.apk", "size": 1, "sha256": "ab",
+      "pad": ")");
+  big += std::string(kMaxIndexBytes, 'a') + "\"}";
+  EXPECT_FALSE(ParseIndex(big));
+}
+
+TEST(TarkUpdateIndexTest, IsNewer_HigherIs) {
+  const UpdateIndex index = *ParseIndex(kIndex);
+  EXPECT_TRUE(IsNewer(index, 805903901));
+}
+
+TEST(TarkUpdateIndexTest, IsNewer_SameOrLowerIsNot) {
+  // An older index (a mistake on the site) never offers a downgrade.
+  const UpdateIndex index = *ParseIndex(kIndex);
+  EXPECT_FALSE(IsNewer(index, 805903902));
+  EXPECT_FALSE(IsNewer(index, 805903999));
+}
+
+TEST(TarkUpdateIndexTest, ShouldCheckNow_FirstTime) {
+  EXPECT_TRUE(ShouldCheckNow(base::Time::Now(), base::Time()));
+}
+
+TEST(TarkUpdateIndexTest, ShouldCheckNow_23hNo_24hYes) {
+  const base::Time last = base::Time::Now();
+  EXPECT_FALSE(ShouldCheckNow(last + base::Hours(23), last));
+  EXPECT_TRUE(ShouldCheckNow(last + base::Hours(24), last));
+}
+
+TEST(TarkUpdateIndexTest, ShouldCheckNow_FutureLastCheckChecks) {
+  // A phone whose clock was ahead and then corrected: never waits forever.
+  const base::Time now = base::Time::Now();
+  EXPECT_TRUE(ShouldCheckNow(now, now + base::Days(30)));
+}
+
+TEST(TarkUpdateIndexTest, FailedCheckWaitsADay) {
+  // A failed check is recorded as the last check too: no tight retry loop.
+  const base::Time failed_at = base::Time::Now();
+  EXPECT_FALSE(ShouldCheckNow(failed_at + base::Hours(1), failed_at));
+}
+
+}  // namespace
+}  // namespace tark_update
