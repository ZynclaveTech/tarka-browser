+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_update/update_check_service.h"
+
+#include <utility>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/tark_update/update_index.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "url/gurl.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/omaha/android/jni_headers/TarkUpdate_jni.h"
+
+namespace tark_update {
+
+namespace {
+
+constexpr base::TimeDelta kFirstCheckDelay = base::Seconds(30);
+constexpr base::TimeDelta kTimeout = base::Seconds(30);
+
+// For android/update/e2e/run.py only: the index's URL instead of
+// gettarka.com's. Chrome reads command-line flags from a file only on a
+// debuggable or rooted device, as with --tark-xlit-base-url.
+constexpr char kIndexUrlSwitch[] = "tark-update-base-url";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_update_check", R"(
+      semantics {
+        sender: "Tark update check"
+        description:
+          "Reads the small index of the newest Tark for Android on "
+          "gettarka.com, so that the app menu can offer a newer version of "
+          "the APK the person installed from gettarka.com."
+        trigger: "At most once a day while Tark runs; never when Tark was "
+          "installed from Google Play."
+        data: "None: no cookies, no identifiers, no query string."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Installing Tark from Google Play instead turns it off."
+        policy_exception_justification: "Tark has no enterprise policies."
+      })");
+
+GURL IndexUrl() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  return command_line.HasSwitch(kIndexUrlSwitch)
+             ? GURL(command_line.GetSwitchValueASCII(kIndexUrlSwitch))
+             : GURL(kIndexUrl);
+}
+
+}  // namespace
+
+// static
+void UpdateCheckService::RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterTimePref(kLastCheckPref, base::Time());
+}
+
+// static
+UpdateCheckService& UpdateCheckService::Get() {
+  static base::NoDestructor<UpdateCheckService> service;
+  return *service;
+}
+
+UpdateCheckService::UpdateCheckService() {
+  if (!Java_TarkUpdate_isEnabled(base::android::AttachCurrentThread())) {
+    return;
+  }
+  first_.Start(FROM_HERE, kFirstCheckDelay,
+               base::BindOnce(&UpdateCheckService::MaybeCheck,
+                              weak_factory_.GetWeakPtr()));
+  hourly_.Start(FROM_HERE, base::Hours(1),
+                base::BindRepeating(&UpdateCheckService::MaybeCheck,
+                                    weak_factory_.GetWeakPtr()));
+}
+
+UpdateCheckService::~UpdateCheckService() = default;
+
+void UpdateCheckService::MaybeCheck() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  PrefService* local_state = g_browser_process->local_state();
+  if (loader_ || !ShouldCheckNow(base::Time::Now(),
+                                 local_state->GetTime(kLastCheckPref))) {
+    return;
+  }
+  // Recorded before the result: a failure waits a day too.
+  local_state->SetTime(kLastCheckPref, base::Time::Now());
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = IndexUrl();
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kTimeout);
+  // The index is served as it is; a redirect anywhere is refused.
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<UpdateCheckService> service, const GURL&,
+         const net::RedirectInfo&, const network::mojom::URLResponseHead&,
+         std::vector<std::string>*) {
+        if (service) {
+          service->loader_.reset();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->DownloadToString(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(
+          [](base::WeakPtr<UpdateCheckService> service,
+             std::optional<std::string> body) {
+            if (service) {
+              service->OnFetched(std::move(body));
+            }
+          },
+          weak_factory_.GetWeakPtr()),
+      kMaxIndexBytes);
+}
+
+void UpdateCheckService::OnFetched(std::optional<std::string> body) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  loader_.reset();
+  const std::optional<UpdateIndex> index =
+      body ? ParseIndex(*body) : std::nullopt;
+  if (!index) {
+    LOG(WARNING) << "tark update: no index";
+    return;
+  }
+  JNIEnv* env = base::android::AttachCurrentThread();
+  if (!IsNewer(*index, Java_TarkUpdate_installedVersionCode(env))) {
+    LOG(WARNING) << "tark update: up to date";
+    return;
+  }
+  LOG(WARNING) << "tark update: " << index->version_name << " available";
+  Java_TarkUpdate_offer(env, index->version_code, index->version_name,
+                        index->url.spec());
+}
+
+}  // namespace tark_update
