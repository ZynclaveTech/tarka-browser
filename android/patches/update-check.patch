+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_UPDATE_UPDATE_INDEX_H_
+#define CHROME_BROWSER_TARK_UPDATE_UPDATE_INDEX_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+// Tark for Android (A5): the direct APK's daily check for a newer version.
+// The index at gettarka.com/android/v1/latest.json names the newest APK; these
+// are its rules, with no browser or network dependencies, so that their unit
+// tests build for the build machine.
+namespace tark_update {
+
+inline constexpr char kIndexUrl[] = "https://gettarka.com/android/v1/latest.json";
+// Every APK the index may name lives here.
+inline constexpr char kApkPrefix[] = "https://gettarka.com/android/v1/";
+// The index is a few hundred bytes; anything larger is not one.
+inline constexpr size_t kMaxIndexBytes = 64 * 1024;
+inline constexpr base::TimeDelta kCheckInterval = base::Hours(24);
+
+struct UpdateIndex {
+  int64_t version_code = 0;
+  std::string version_name;
+  GURL url;
+  int64_t size = 0;
+  std::string sha256;
+};
+
+// The index, or nullopt for anything else: not JSON, a field missing or of
+// the wrong type, an APK outside kApkPrefix, or more than kMaxIndexBytes.
+std::optional<UpdateIndex> ParseIndex(std::string_view json);
+
+// Whether the index names a version newer than the installed one; never a
+// downgrade.
+bool IsNewer(const UpdateIndex& index, int64_t installed_code);
+
+// Whether a check is due: never checked, the last check kCheckInterval or more
+// ago, or the last check in the future (a clock that was ahead). A failed
+// check counts as a check, so a failure waits a day too.
+bool ShouldCheckNow(base::Time now, base::Time last_check);
+
+}  // namespace tark_update
+
+#endif  // CHROME_BROWSER_TARK_UPDATE_UPDATE_INDEX_H_
