+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_UPDATE_UPDATE_CHECK_SERVICE_H_
+#define CHROME_BROWSER_TARK_UPDATE_UPDATE_CHECK_SERVICE_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/sequence_checker.h"
+#include "base/timer/timer.h"
+
+class PrefRegistrySimple;
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+namespace tark_update {
+
+// Local state: when the index was last fetched, successfully or not.
+inline constexpr char kLastCheckPref[] = "tark.update.last_check";
+
+// Tark for Android (A5): the direct APK's check for a newer version, at most
+// once a day, while Tark runs. A plain GET of gettarka.com's index, with no
+// cookies and no query string; a newer version shows as the app menu's
+// "Update" item (UpdateStatusProvider). Never started when Play installed the
+// app: Play updates it.
+class UpdateCheckService {
+ public:
+  static void RegisterPrefs(PrefRegistrySimple* registry);
+  // Created at browser start (chrome_browser_main_android.cc).
+  static UpdateCheckService& Get();
+
+  UpdateCheckService(const UpdateCheckService&) = delete;
+  UpdateCheckService& operator=(const UpdateCheckService&) = delete;
+
+ private:
+  friend class base::NoDestructor<UpdateCheckService>;
+  UpdateCheckService();
+  ~UpdateCheckService();
+
+  void MaybeCheck();
+  void OnFetched(std::optional<std::string> body);
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::OneShotTimer first_;
+  base::RepeatingTimer hourly_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<UpdateCheckService> weak_factory_{this};
+};
+
+}  // namespace tark_update
+
+#endif  // CHROME_BROWSER_TARK_UPDATE_UPDATE_CHECK_SERVICE_H_
