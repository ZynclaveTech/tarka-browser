+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/page_translation.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace tark_captions {
+namespace {
+
+// The 22 languages of India's Eighth Schedule (IndicTrans2's).
+constexpr std::string_view kIndian[] = {
+    "as", "bn",  "brx", "doi", "gu", "hi", "kn", "ks", "kok", "mai", "ml",
+    "mni", "mr", "ne",  "or",  "pa", "sa", "sat", "sd", "ta",  "te",  "ur",
+};
+
+bool IsIndian(std::string_view code) {
+  return std::ranges::contains(kIndian, code);
+}
+
+}  // namespace
+
+std::vector<std::string> PageUnitsFor(std::string_view source, std::string_view target) {
+  if (source == target || (target != "en" && !IsIndian(target))) {
+    return {};
+  }
+  std::vector<std::string> units;
+  if (IsIndian(source)) {
+    units.emplace_back("tr_indic_en");
+  } else if (source == "es") {
+    units.emplace_back("tr_es_en");
+  } else if (source != "en") {
+    return {};
+  }
+  if (IsIndian(target)) {
+    units.emplace_back("tr_en_indic");
+  }
+  return units;
+}
+
+PageTranslation::PageTranslation(Backend* backend, bool off_the_record)
+    : backend_(backend), off_the_record_(off_the_record) {}
+
+PageTranslation::~PageTranslation() {
+  Cancel();
+  Unload();
+}
+
+void PageTranslation::Translate(std::vector<std::string> texts,
+                                std::string source,
+                                std::string target,
+                                ResultsCallback callback) {
+  if (!off_the_record_ && !texts.empty() && ModelsReady(source, target)) {
+    backend_->RememberTranslated(source, target);  // Warm may load it next time
+  }
+  Send(std::move(texts), std::move(source), std::move(target), std::move(callback));
+}
+
+void PageTranslation::Send(std::vector<std::string> texts,
+                           std::string source,
+                           std::string target,
+                           ResultsCallback callback) {
+  const std::vector<std::string> units = PageUnitsFor(source, target);
+  if (texts.empty() || !ModelsReady(source, target)) {
+    std::move(callback).Run(Results(texts.size()));
+    return;
+  }
+  idle_.Stop();
+  if (!connected_) {
+    connected_ = true;
+    DVLOG(1) << "tark-page: browser connecting to the captions process";
+    backend_->Connect();
+  }
+  for (const std::string& unit : units) {
+    if (!std::ranges::contains(in_use_, unit)) {
+      backend_->SetInUse(unit, true);
+      in_use_.push_back(unit);
+    }
+  }
+  const uint64_t id = next_id_++;
+  size_t bytes = 0;
+  for (const std::string& text : texts) {
+    bytes += text.size();
+  }
+  pending_[id] = Pending{texts.size(), std::move(callback), base::TimeTicks::Now(), bytes};
+  backend_->SendBatch(source, target, units, texts,
+                      base::BindOnce(&PageTranslation::OnResults, weak_factory_.GetWeakPtr(), id));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&PageTranslation::OnDeadline, weak_factory_.GetWeakPtr(), id),
+      kBatchDeadline);
+}
+
+void PageTranslation::Warm(std::string source, std::string target) {
+  if (connected_ || !pending_.empty() || !ModelsReady(source, target) ||
+      !backend_->TranslatedBefore(source, target) || !backend_->CanWarm()) {
+    return;
+  }
+  DVLOG(1) << "tark-page: browser warming " << source << " -> " << target;
+  Send({"."}, std::move(source), std::move(target), base::DoNothing());
+}
+
+bool PageTranslation::ModelsReady(std::string source, std::string target) const {
+  const std::vector<std::string> units = PageUnitsFor(source, target);
+  return !units.empty() && std::ranges::all_of(units, [&](const std::string& unit) {
+    return backend_->UnitReady(unit);
+  });
+}
+
+bool PageTranslation::RequestModels(std::string source, std::string target, bool now) {
+  if (off_the_record_) {
+    return false;
+  }
+  for (const std::string& unit : PageUnitsFor(source, target)) {
+    if (!backend_->UnitReady(unit)) {
+      backend_->RequestUnit(unit, now);
+    }
+  }
+  return true;
+}
+
+void PageTranslation::Cancel() {
+  if (!pending_.empty() && connected_) {
+    backend_->DropSent();
+  }
+  AnswerAllNull();
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::AnswerAllNull() {
+  // Snapshot first: a callback may translate again.
+  std::map<uint64_t, Pending> pending = std::move(pending_);
+  pending_.clear();
+  for (auto& [id, batch] : pending) {
+    std::move(batch.callback).Run(Results(batch.size));
+  }
+}
+
+void PageTranslation::AnswerAllDeferred() {
+  // Snapshot first: a callback may translate again.
+  std::map<uint64_t, Pending> pending = std::move(pending_);
+  pending_.clear();
+  for (auto& [id, batch] : pending) {
+    std::move(batch.callback).Run(Results());
+  }
+}
+
+void PageTranslation::OnAppBackgrounded() {
+  // Let go first, then answer: a batch a callback starts connects again.
+  Unload();
+  AnswerAllDeferred();
+}
+
+void PageTranslation::OnTabHidden() {
+  OnAppBackgrounded();
+}
+
+void PageTranslation::OnBackendGone() {
+  connected_ = false;  // nothing to let go
+  Unload();
+  AnswerAllNull();
+}
+
+void PageTranslation::OnDeadline(uint64_t id) {
+  auto it = pending_.find(id);
+  if (it == pending_.end()) {
+    return;
+  }
+  DVLOG(1) << "tark-page: browser batch deadline items=" << it->second.size
+           << " bytes=" << it->second.bytes << " pending=" << pending_.size();
+  // A new translator pipe: the service drops what was queued on the old one
+  // (PageTranslator::DropBatches), so nothing keeps computing for answers
+  // that would be thrown away. Everything outstanding was on that pipe, so
+  // it all answers deferred and the script sends it again.
+  if (connected_) {
+    backend_->DropSent();
+  }
+  AnswerAllDeferred();
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::OnResults(uint64_t id, Results results) {
+  auto it = pending_.find(id);
+  if (it == pending_.end()) {
+    return;  // cancelled: the page it was for is gone
+  }
+  Pending batch = std::move(it->second);
+  pending_.erase(it);
+  if (results.size() != batch.size) {
+    results = Results(batch.size);
+  }
+  DVLOG(1) << "tark-page: browser batch done items=" << batch.size << " bytes=" << batch.bytes
+           << " ms=" << (base::TimeTicks::Now() - batch.sent).InMilliseconds()
+           << " pending=" << pending_.size();
+  std::move(batch.callback).Run(std::move(results));
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::MaybeStartIdleTimer() {
+  if (connected_ && pending_.empty()) {
+    idle_.Start(FROM_HERE, kIdleUnload,
+                base::BindOnce(&PageTranslation::Unload, base::Unretained(this)));
+  }
+}
+
+void PageTranslation::Unload() {
+  idle_.Stop();
+  if (connected_) {
+    connected_ = false;
+    backend_->Disconnect();
+  }
+  ReleaseUnits();
+}
+
+void PageTranslation::ReleaseUnits() {
+  for (const std::string& unit : in_use_) {
+    backend_->SetInUse(unit, false);
+  }
+  in_use_.clear();
+}
+
+}  // namespace tark_captions
