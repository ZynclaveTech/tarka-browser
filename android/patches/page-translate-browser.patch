+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_CAPTIONS_ANDROID_PAGE_TRANSLATION_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_ANDROID_PAGE_TRANSLATION_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace tark_captions {
+
+// The translation units ("tr_indic_en", "tr_en_indic", "tr_es_en") a page in
+// `source` needs to reach `target`, in order: any of the 22 Indian languages
+// and Spanish go through English, so Indian ↔ Indian is both IndicTrans2
+// models (the captions process loads them a leg at a time). Empty when there
+// is no model for the pair, or the two are the same.
+std::vector<std::string> PageUnitsFor(std::string_view source, std::string_view target);
+
+// One tab's page translation, without content or mojo (TarkPageTranslation
+// is the tab's side; this is what it decides, tested on the build machine).
+// Batches go to the tab's captions process through the Backend; the process
+// is connected on the first batch and let go after three idle minutes, when
+// the app goes to the background, or when the backend goes away. A batch
+// whose page is gone (Cancel) answers all-null at once and its late results
+// are dropped, so nothing is applied to the next page. Off the record,
+// nothing is written to prefs.
+class PageTranslation {
+ public:
+  // One per text; null keeps that text's original. An empty Results for a
+  // non-empty batch means "deferred": nothing was wrong with the texts, the
+  // batch was let go (tab hidden, app in the background, another tab took
+  // the process, or the deadline passed), and the page's script sends them
+  // again.
+  using Results = std::vector<std::optional<std::string>>;
+  using ResultsCallback = base::OnceCallback<void(Results)>;
+
+  static constexpr base::TimeDelta kIdleUnload = base::Seconds(180);
+  // A batch not answered by then (it waits while captions hold another
+  // model: captions win) answers all-null; the page keeps its text.
+  static constexpr base::TimeDelta kBatchDeadline = base::Seconds(30);
+
+  class Backend {
+   public:
+    virtual ~Backend() = default;
+    // Binds a page translator on the tab's captions process: captions' own
+    // when captions are on, otherwise one started for the page, without
+    // speech. Never a second process for the tab.
+    virtual void Connect() = 0;
+    // Lets the translator go; a process started only for the page exits.
+    virtual void Disconnect() = 0;
+    // Drops what was sent and not answered (the page went): a new
+    // translator for the next batch, so it never queues behind old text.
+    virtual void DropSent() = 0;
+    // One batch on the connected translator with `units`' files.
+    virtual void SendBatch(const std::string& source,
+                           const std::string& target,
+                           const std::vector<std::string>& units,
+                           const std::vector<std::string>& texts,
+                           ResultsCallback done) = 0;
+    virtual bool UnitReady(const std::string& unit) const = 0;
+    // Held from deletion while a batch may use it.
+    virtual void SetInUse(const std::string& unit, bool in_use) = 0;
+    // Downloads `unit` for page translation (owner "page_translation" in
+    // tark.captions.owners: a pref write).
+    virtual void RequestUnit(const std::string& unit, bool now) = 0;
+    // Whether a model may be loaded ahead of a tap (Warm): not on a low-RAM
+    // phone or one short of memory, and not while captions run (captions
+    // win: they may hold another model).
+    virtual bool CanWarm() const = 0;
+    // The directions this profile has translated a page in
+    // ("tark.page_translation.warm_directions"); Warm only loads those.
+    virtual bool TranslatedBefore(const std::string& source, const std::string& target) const = 0;
+    // A real translation in `source` -> `target` (never called off the record).
+    virtual void RememberTranslated(const std::string& source, const std::string& target) = 0;
+  };
+
+  PageTranslation(Backend* backend, bool off_the_record);
+  PageTranslation(const PageTranslation&) = delete;
+  PageTranslation& operator=(const PageTranslation&) = delete;
+  ~PageTranslation();
+
+  // Results in `texts`' order; a sentence that failed is null (the page keeps
+  // its original). All null at once when the models are not on the phone.
+  void Translate(std::vector<std::string> texts,
+                 std::string source,
+                 std::string target,
+                 ResultsCallback callback);
+  bool ModelsReady(std::string source, std::string target) const;
+  // The Translate offer is showing: when the pair's models are on the phone,
+  // this profile has translated that direction before (Backend::
+  // TranslatedBefore) and the backend allows it, loads the model now (a one-sentence batch
+  // whose answer is dropped), so the tap doesn't wait for the load. With no
+  // tap the usual idle unload lets it go after kIdleUnload. It costs that
+  // memory for those three minutes even for people who never tap.
+  void Warm(std::string source, std::string target);
+  // Asks for the pair's missing models; false (nothing asked, nothing
+  // written) off the record.
+  bool RequestModels(std::string source, std::string target, bool now);
+  // The page went (a navigation): outstanding batches answer all-null now.
+  void Cancel();
+  // The app went to the background: no translating there, the model goes;
+  // outstanding batches answer deferred.
+  void OnAppBackgrounded();
+  // The tab was hidden: only the visible tab holds a page model, so two tabs
+  // never hold one at once.
+  void OnTabHidden();
+  // The captions process went away (crash, or another tab took the slot).
+  void OnBackendGone();
+
+  bool connected() const { return connected_; }
+  size_t outstanding() const { return pending_.size(); }
+
+ private:
+  struct Pending {
+    size_t size = 0;
+    ResultsCallback callback;
+    base::TimeTicks sent;  // diagnostics (DVLOG)
+    size_t bytes = 0;
+  };
+
+  void Send(std::vector<std::string> texts,
+            std::string source,
+            std::string target,
+            ResultsCallback callback);
+
+  void OnResults(uint64_t id, Results results);
+  void OnDeadline(uint64_t id);
+  // Answers every outstanding batch all-null.
+  void AnswerAllNull();
+  // Answers every outstanding batch deferred (an empty Results).
+  void AnswerAllDeferred();
+  void Unload();
+  void ReleaseUnits();
+  void MaybeStartIdleTimer();
+
+  const raw_ptr<Backend> backend_;
+  const bool off_the_record_;
+  bool connected_ = false;
+  uint64_t next_id_ = 1;
+  std::map<uint64_t, Pending> pending_;
+  std::vector<std::string> in_use_;
+  base::OneShotTimer idle_;
+  base::WeakPtrFactory<PageTranslation> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_ANDROID_PAGE_TRANSLATION_H_
