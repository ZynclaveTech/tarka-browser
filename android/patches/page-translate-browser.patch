+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// TarkPageTranslation's decisions (PageTranslation), on the build machine.
+
+#include <set>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/test/task_environment.h"
+#include "base/values.h"
+#include "chrome/browser/tark_captions_android/model_files.h"
+#include "chrome/browser/tark_captions_android/page_translation.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+using Results = PageTranslation::Results;
+
+class FakeBackend : public PageTranslation::Backend {
+ public:
+  void Connect() override {
+    ++connects;
+    connected = true;
+  }
+  void Disconnect() override {
+    ++disconnects;
+    connected = false;
+  }
+  void DropSent() override {
+    ++drops;
+    for (auto& done : sent) {
+      dropped.push_back(std::move(done));
+    }
+    sent.clear();
+  }
+  void SendBatch(const std::string& source,
+                 const std::string& target,
+                 const std::vector<std::string>& units,
+                 const std::vector<std::string>& texts,
+                 PageTranslation::ResultsCallback done) override {
+    ASSERT_TRUE(connected);
+    sent_units = units;
+    sent.push_back(std::move(done));
+  }
+  bool UnitReady(const std::string& unit) const override { return ready.contains(unit); }
+  void SetInUse(const std::string& unit, bool in_use) override {
+    if (in_use) {
+      in_use_units.insert(unit);
+    } else {
+      in_use_units.erase(unit);
+    }
+  }
+  void RequestUnit(const std::string& unit, bool now) override {
+    owners.SetWanted(unit, Owner::kPageTranslation, true);
+    ++pref_writes;
+  }
+  bool CanWarm() const override { return can_warm; }
+  bool TranslatedBefore(const std::string& source, const std::string& target) const override {
+    return translated.contains(source + ">" + target);
+  }
+  void RememberTranslated(const std::string& source, const std::string& target) override {
+    translated.insert(source + ">" + target);
+  }
+
+  // The captions process answers the oldest batch.
+  void Answer(Results results) {
+    PageTranslation::ResultsCallback done = std::move(sent.front());
+    sent.erase(sent.begin());
+    std::move(done).Run(std::move(results));
+  }
+
+  int connects = 0;
+  int drops = 0;
+  std::vector<PageTranslation::ResultsCallback> dropped;
+  int disconnects = 0;
+  bool connected = false;
+  std::set<std::string> ready = {"tr_indic_en", "tr_en_indic"};
+  std::set<std::string> in_use_units;
+  std::vector<std::string> sent_units;
+  std::vector<PageTranslation::ResultsCallback> sent;
+  UnitOwners owners;
+  int pref_writes = 0;
+  bool can_warm = true;
+  std::set<std::string> translated;  // directions translated before
+};
+
+class TarkPageTranslationTest : public testing::Test {
+ protected:
+  // Translates `texts` from Hindi into English; the results land in `out`.
+  void Translate(PageTranslation& page, std::vector<std::string> texts) {
+    page.Translate(std::move(texts), "hi", "en", base::BindOnce(
+                                                    [](TarkPageTranslationTest* self, Results r) {
+                                                      ++self->answers_;
+                                                      self->out_ = std::move(r);
+                                                    },
+                                                    base::Unretained(this)));
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  FakeBackend backend_;
+  int answers_ = 0;
+  Results out_;
+};
+
+TEST_F(TarkPageTranslationTest, StartsProcessOnFirstBatchWithoutSpeech) {
+  PageTranslation page(&backend_, /*off_the_record=*/false);
+  EXPECT_EQ(backend_.connects, 0);  // nothing runs before the first batch
+  Translate(page, {"नमस्ते", "दुनिया"});
+  EXPECT_EQ(backend_.connects, 1);
+  EXPECT_EQ(backend_.sent_units, (std::vector<std::string>{"tr_indic_en"}));
+  EXPECT_TRUE(backend_.in_use_units.contains("tr_indic_en"));
+  Translate(page, {"फिर"});
+  EXPECT_EQ(backend_.connects, 1);  // the same process
+  backend_.Answer({"Hello", std::nullopt});
+  EXPECT_EQ(out_, (Results{"Hello", std::nullopt}));
+}
+
+TEST_F(TarkPageTranslationTest, UnloadsAfterThreeMinutesIdle) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक"});
+  task_environment_.FastForwardBy(base::Seconds(20));
+  EXPECT_TRUE(backend_.connected);  // a batch in flight (under its 30 s deadline) is never idle
+  backend_.Answer({"one"});
+  task_environment_.FastForwardBy(base::Seconds(179));
+  EXPECT_TRUE(backend_.connected);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_FALSE(backend_.connected);
+  EXPECT_EQ(backend_.disconnects, 1);
+  EXPECT_TRUE(backend_.in_use_units.empty());
+  Translate(page, {"दो"});  // the next batch starts it again
+  EXPECT_EQ(backend_.connects, 2);
+}
+
+TEST_F(TarkPageTranslationTest, UnloadsWhenAppBackgrounded) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक", "दो"});
+  page.OnAppBackgrounded();
+  EXPECT_FALSE(backend_.connected);
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results());  // deferred: the script sends them again
+  EXPECT_TRUE(backend_.in_use_units.empty());
+}
+
+TEST_F(TarkPageTranslationTest, NavigationCancelsOutstanding) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक", "दो"});
+  page.Cancel();
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results(2));
+  EXPECT_EQ(page.outstanding(), 0u);
+  EXPECT_EQ(backend_.drops, 1);
+  // A late reply for the old page (had the process answered anyway).
+  std::move(backend_.dropped.front()).Run({"one", "two"});
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results(2));  // nothing applied
+}
+
+TEST_F(TarkPageTranslationTest, NavigationDropsQueuedBatches) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"पुराना एक"});
+  Translate(page, {"पुराना दो"});
+  page.Cancel();
+  EXPECT_EQ(backend_.drops, 1);  // the process's queue is let go
+  EXPECT_TRUE(backend_.sent.empty());
+  EXPECT_EQ(answers_, 2);
+  Translate(page, {"नया"});
+  EXPECT_EQ(backend_.connects, 1);  // same process, the model stays
+  ASSERT_EQ(backend_.sent.size(), 1u);  // nothing ahead of the new page
+  backend_.Answer({"new"});
+  EXPECT_EQ(out_, (Results{"new"}));
+  page.Cancel();  // nothing outstanding: nothing dropped
+  EXPECT_EQ(backend_.drops, 1);
+}
+
+TEST_F(TarkPageTranslationTest, UnloadsWhenTabHidden) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक"});
+  page.OnTabHidden();
+  EXPECT_FALSE(backend_.connected);
+  EXPECT_EQ(out_, Results());  // deferred
+  EXPECT_TRUE(backend_.in_use_units.empty());
+}
+
+TEST_F(TarkPageTranslationTest, WaitingBatchTimesOutDeferred) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक", "दो"});  // captions hold another model: no reply
+  task_environment_.FastForwardBy(base::Seconds(29));
+  EXPECT_EQ(answers_, 0);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results());  // deferred, not originals
+  EXPECT_EQ(page.outstanding(), 0u);
+  EXPECT_EQ(backend_.drops, 1);  // a new pipe: the service drops the old queue
+  std::move(backend_.dropped.front()).Run({"one", "two"});  // too late: dropped
+  EXPECT_EQ(answers_, 1);
+  task_environment_.FastForwardBy(PageTranslation::kIdleUnload);
+  EXPECT_FALSE(backend_.connected);  // nothing left hanging
+}
+
+TEST_F(TarkPageTranslationTest, BackgroundCallbackMayTranslateAgain) {
+  PageTranslation page(&backend_, false);
+  page.Translate({"एक"}, "hi", "en", base::BindOnce(
+                                          [](PageTranslation* page, Results) {
+                                            page->Translate({"दो"}, "hi", "en",
+                                                            base::DoNothing());
+                                          },
+                                          base::Unretained(&page)));
+  page.OnAppBackgrounded();
+  EXPECT_TRUE(page.connected());  // the new batch connected after the unload
+  EXPECT_EQ(page.outstanding(), 1u);
+  EXPECT_TRUE(backend_.in_use_units.contains("tr_indic_en"));
+}
+
+TEST_F(TarkPageTranslationTest, IncognitoStoresNothing) {
+  PageTranslation page(&backend_, /*off_the_record=*/true);
+  backend_.ready.clear();
+  EXPECT_FALSE(page.RequestModels("hi", "ta", /*now=*/true));
+  backend_.ready = {"tr_indic_en"};
+  Translate(page, {"एक"});
+  backend_.Answer({"one"});
+  EXPECT_EQ(out_, (Results{"one"}));
+  EXPECT_EQ(backend_.pref_writes, 0);
+  EXPECT_TRUE(backend_.owners.Units().empty());
+}
+
+TEST_F(TarkPageTranslationTest, OwnerKeepsModelsWhileCaptionsRemoved) {
+  PageTranslation page(&backend_, false);
+  backend_.ready.clear();
+  EXPECT_TRUE(page.RequestModels("hi", "en", /*now=*/false));
+  EXPECT_TRUE(backend_.owners.WantedBy("tr_indic_en", Owner::kPageTranslation));
+
+  // Captions' Translate wanted it too; the person removes it from captions.
+  UnitOwners owners(backend_.owners.ToDict());  // as saved in local state
+  owners.SetWanted("tr_indic_en", Owner::kCaptions, true);
+  EXPECT_EQ(*owners.ToDict().FindList("tr_indic_en"),
+            base::ListValue().Append("captions").Append("page_translation"));
+  owners.SetWanted("tr_indic_en", Owner::kCaptions, false);
+  UnitUse use;
+  EXPECT_EQ(DecideRemoval("tr_indic_en", owners, use), Removal::kKeep);
+  owners.SetWanted("tr_indic_en", Owner::kPageTranslation, false);
+  EXPECT_EQ(DecideRemoval("tr_indic_en", owners, use), Removal::kNow);
+}
+
+TEST_F(TarkPageTranslationTest, MissingModelsAnswerNullWithoutAProcess) {
+  PageTranslation page(&backend_, false);
+  backend_.ready.clear();
+  Translate(page, {"एक"});
+  EXPECT_EQ(out_, Results(1));
+  EXPECT_EQ(backend_.connects, 0);
+}
+
+TEST_F(TarkPageTranslationTest, BackendGoneAnswersNull) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक"});
+  backend_.connected = false;
+  page.OnBackendGone();
+  EXPECT_EQ(out_, Results(1));
+  EXPECT_EQ(backend_.disconnects, 0);
+  EXPECT_FALSE(page.connected());
+}
+
+TEST(PageUnitsForTest, EveryIndianLanguageThroughEnglish) {
+  using V = std::vector<std::string>;
+  EXPECT_EQ(PageUnitsFor("hi", "en"), (V{"tr_indic_en"}));
+  EXPECT_EQ(PageUnitsFor("en", "sat"), (V{"tr_en_indic"}));
+  EXPECT_EQ(PageUnitsFor("ta", "mni"), (V{"tr_indic_en", "tr_en_indic"}));
+  EXPECT_EQ(PageUnitsFor("es", "en"), (V{"tr_es_en"}));
+  EXPECT_EQ(PageUnitsFor("es", "kok"), (V{"tr_es_en", "tr_en_indic"}));
+  EXPECT_TRUE(PageUnitsFor("hi", "hi").empty());
+  EXPECT_TRUE(PageUnitsFor("fr", "en").empty());
+  EXPECT_TRUE(PageUnitsFor("hi", "es").empty());
+}
+
+// The offer showing loads the model (one sentence, answer dropped); with no
+// tap it goes after the idle unload, like any batch.
+TEST_F(TarkPageTranslationTest, WarmLoadsAheadAndUnloadsWhenIdle) {
+  PageTranslation page(&backend_, false);
+  backend_.translated = {"hi>en"};
+  page.Warm("hi", "en");
+  EXPECT_EQ(backend_.connects, 1);
+  EXPECT_EQ(backend_.sent_units, (std::vector<std::string>{"tr_indic_en"}));
+  EXPECT_TRUE(backend_.in_use_units.contains("tr_indic_en"));
+  backend_.Answer({"."});
+  task_environment_.FastForwardBy(PageTranslation::kIdleUnload);
+  EXPECT_FALSE(backend_.connected);
+  EXPECT_TRUE(backend_.in_use_units.empty());
+}
+
+// A real translation remembers its direction (warm-up may load it on the next
+// offer); the warm-up itself and a Private profile don't.
+TEST_F(TarkPageTranslationTest, RealTranslateRemembersDirection) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक"});
+  EXPECT_TRUE(backend_.translated.contains("hi>en"));
+  PageTranslation incognito(&backend_, /*off_the_record=*/true);
+  incognito.Translate({"one"}, "en", "hi", base::DoNothing());
+  EXPECT_FALSE(backend_.translated.contains("en>hi"));
+}
+
+// The deadline lets the whole pipe go: both batches on it answer deferred.
+TEST_F(TarkPageTranslationTest, DeadlineDefersEverythingOnThePipe) {
+  PageTranslation page(&backend_, false);
+  int deferred = 0;
+  auto count = base::BindRepeating([](int* n, Results r) { *n += r.empty(); }, &deferred);
+  page.Translate({"एक"}, "hi", "en", count);
+  task_environment_.FastForwardBy(base::Seconds(10));
+  page.Translate({"दो"}, "hi", "en", count);
+  task_environment_.FastForwardBy(base::Seconds(20));  // the first's deadline
+  EXPECT_EQ(deferred, 2);
+  EXPECT_EQ(backend_.drops, 1);
+  EXPECT_EQ(page.outstanding(), 0u);
+}
+
+// A tap right after the offer uses the warmed process: no second connect.
+TEST_F(TarkPageTranslationTest, WarmThenTranslateSharesTheProcess) {
+  PageTranslation page(&backend_, false);
+  backend_.translated = {"hi>en"};
+  page.Warm("hi", "en");
+  backend_.Answer({"."});
+  Translate(page, {"एक"});
+  EXPECT_EQ(backend_.connects, 1);
+  backend_.Answer({"one"});
+  EXPECT_EQ(out_, (Results{"one"}));
+}
+
+// No warm-up when the backend says no (low RAM, little memory free, a tab
+// behind others, captions running), when the models aren't on the phone,
+// or when a translation is already connected.
+TEST_F(TarkPageTranslationTest, WarmSkipped) {
+  PageTranslation page(&backend_, false);
+  page.Warm("hi", "en");  // never translated hi -> en here
+  EXPECT_EQ(backend_.connects, 0);
+  backend_.translated = {"hi>en"};
+  backend_.can_warm = false;
+  page.Warm("hi", "en");
+  EXPECT_EQ(backend_.connects, 0);
+  backend_.can_warm = true;
+  backend_.ready.clear();
+  page.Warm("hi", "en");
+  EXPECT_EQ(backend_.connects, 0);
+  backend_.ready = {"tr_indic_en", "tr_en_indic"};
+  page.Warm("hi", "hi");  // no direction
+  EXPECT_EQ(backend_.connects, 0);
+  Translate(page, {"एक"});
+  page.Warm("hi", "en");
+  EXPECT_EQ(backend_.sent.size(), 1u);  // not a second batch
+}
