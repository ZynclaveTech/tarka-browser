+namespace tark_captions {
+namespace {
+
+// The tab whose page holds the browser's one page-only captions process.
+TarkPageTranslation* g_page_only_holder = nullptr;
+
+// The units' files, keyed "<unit>/<name>" (PageTranslator), read-only.
+// Blocking.
+std::map<std::string, base::File> OpenUnits(
+    std::vector<std::pair<std::string, base::FilePath>> units) {
+  std::map<std::string, base::File> files;
+  for (const auto& [unit, dir] : units) {
+    for (const CaptionFile* file : FilesOf(unit)) {
+      base::File opened(dir.AppendASCII(file->name),
+                        base::File::FLAG_OPEN | base::File::FLAG_READ);
+      if (opened.IsValid()) {
+        files.emplace(unit + "/" + std::string(file->name), std::move(opened));
+      }
+    }
+  }
+  return files;
+}
+
+}  // namespace
+
+TarkPageTranslation::TarkPageTranslation(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TarkPageTranslation>(*web_contents),
+      logic_(this, web_contents->GetBrowserContext()->IsOffTheRecord()) {
+  // No translating in the background: the app leaving the screen cancels
+  // the page's batches and lets the model go.
+  app_status_ = base::android::ApplicationStatusListener::New(base::BindRepeating(
+      [](TarkPageTranslation* self, base::android::ApplicationState state) {
+        if (state == base::android::APPLICATION_STATE_HAS_STOPPED_ACTIVITIES ||
+            state == base::android::APPLICATION_STATE_HAS_DESTROYED_ACTIVITIES) {
+          self->logic_.OnAppBackgrounded();
+        }
+      },
+      base::Unretained(this)));
+}
+
+TarkPageTranslation::~TarkPageTranslation() {
+  if (g_page_only_holder == this) {
+    g_page_only_holder = nullptr;
+  }
+}
+
+void TarkPageTranslation::Translate(
+    std::vector<std::string> texts,
+    std::string source,
+    std::string target,
+    base::OnceCallback<void(std::vector<std::optional<std::string>>)> callback) {
+  logic_.Translate(std::move(texts), std::move(source), std::move(target), std::move(callback));
+}
+
+bool TarkPageTranslation::ModelsReady(std::string source, std::string target) {
+  return logic_.ModelsReady(std::move(source), std::move(target));
+}
+
+void TarkPageTranslation::Warm(std::string source, std::string target) {
+  logic_.Warm(std::move(source), std::move(target));
+}
+
+void WarmPageTranslation(content::WebContents* web_contents,
+                         const std::string& source,
+                         const std::string& target) {
+  TarkPageTranslation::CreateForWebContents(web_contents);
+  TarkPageTranslation::FromWebContents(web_contents)->Warm(source, target);
+}
+
+bool TarkPageTranslation::RequestModels(std::string source, std::string target, bool now) {
+  return logic_.RequestModels(std::move(source), std::move(target), now);
+}
+
+void TarkPageTranslation::Cancel() {
+  logic_.Cancel();
+}
+
+mojo::Remote<mojom::CaptionService> TarkPageTranslation::HandOverProcess() {
+  if (g_page_only_holder == this) {
+    g_page_only_holder = nullptr;
+  }
+  // Captions set their own disconnect handler; translator_ notices the
+  // process going either way.
+  return std::move(own_service_);
+}
+
+bool TarkPageTranslation::TakeProcess(mojo::Remote<mojom::CaptionService>& service) {
+  if (!WantsProcess() || !service.is_bound()) {
+    return false;
+  }
+  if (g_page_only_holder && g_page_only_holder != this) {
+    g_page_only_holder->ReleaseForOtherTab();
+  }
+  g_page_only_holder = this;
+  own_service_ = std::move(service);
+  own_service_.set_disconnect_handler(
+      base::BindOnce(&TarkPageTranslation::OnGone, weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+void TarkPageTranslation::PrimaryPageChanged(content::Page& page) {
+  // A new main document: the old page's batches answer null and are dropped.
+  logic_.Cancel();
+}
+
+void TarkPageTranslation::OnVisibilityChanged(content::Visibility visibility) {
+  if (visibility == content::Visibility::HIDDEN) {
+    logic_.OnTabHidden();
+  }
+}
+
+void TarkPageTranslation::Connect() {
+  TarkCaptionsTab* captions = TarkCaptionsTab::FromWebContents(web_contents());
+  mojom::CaptionService* service = captions ? captions->RunningService() : nullptr;
+  if (!service) {
+    // Captions are off: a process for the page, without speech (no Start).
+    if (g_page_only_holder && g_page_only_holder != this) {
+      g_page_only_holder->ReleaseForOtherTab();
+    }
+    g_page_only_holder = this;
+    content::ServiceProcessHost::Launch(
+        own_service_.BindNewPipeAndPassReceiver(),
+        content::ServiceProcessHost::Options().WithDisplayName("Tark captions").Pass());
+    own_service_.set_disconnect_handler(
+        base::BindOnce(&TarkPageTranslation::OnGone, weak_factory_.GetWeakPtr()));
+  }
+  BindTranslator();
+}
+
+void TarkPageTranslation::BindTranslator() {
+  mojom::CaptionService* service = own_service_.is_bound() ? own_service_.get() : nullptr;
+  if (!service) {
+    TarkCaptionsTab* captions = TarkCaptionsTab::FromWebContents(web_contents());
+    service = captions ? captions->RunningService() : nullptr;
+  }
+  if (!service) {
+    return;  // the batch answers null (OnFilesOpened)
+  }
+  service->BindPageTranslator(translator_.BindNewPipeAndPassReceiver());
+  translator_.set_disconnect_handler(
+      base::BindOnce(&TarkPageTranslation::OnGone, weak_factory_.GetWeakPtr()));
+}
+
+void TarkPageTranslation::DropSent() {
+  // The old page's batches: their replies never come, and files being opened
+  // for them are not sent. The next batch gets a new translator on the same
+  // process (the model stays).
+  ++generation_;
+  translator_.reset();
+}
+
+void TarkPageTranslation::Disconnect() {
+  ++generation_;
+  translator_.reset();
+  own_service_.reset();  // a page-only process exits with its last remote
+  if (g_page_only_holder == this) {
+    g_page_only_holder = nullptr;
+  }
+}
+
+void TarkPageTranslation::SendBatch(const std::string& source,
+                                    const std::string& target,
+                                    const std::vector<std::string>& units,
+                                    const std::vector<std::string>& texts,
+                                    PageTranslation::ResultsCallback done) {
+  std::vector<std::pair<std::string, base::FilePath>> dirs;
+  for (const std::string& unit : units) {
+    dirs.emplace_back(unit, CaptionDownloads::Get().UnitDir(unit));
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&OpenUnits, std::move(dirs)),
+      base::BindOnce(&TarkPageTranslation::OnFilesOpened, weak_factory_.GetWeakPtr(),
+                     generation_, source, target, texts, std::move(done)));
+}
+
+void TarkPageTranslation::OnFilesOpened(uint64_t generation,
+                                        std::string source,
+                                        std::string target,
+                                        std::vector<std::string> texts,
+                                        PageTranslation::ResultsCallback done,
+                                        std::map<std::string, base::File> files) {
+  if (generation != generation_) {
+    return;  // dropped (Cancel or unload): already answered null
+  }
+  if (!translator_.is_bound()) {
+    BindTranslator();  // after DropSent
+  }
+  if (!translator_.is_bound()) {
+    std::move(done).Run(PageTranslation::Results(texts.size()));
+    return;
+  }
+  base::flat_map<std::string, base::File> handles;
+  for (auto& [name, file] : files) {
+    handles.emplace(name, std::move(file));
+  }
+  // A batch lost with the process never answers; PageTranslation's
+  // OnBackendGone answers it null.
+  translator_->TranslateBatch(
+      source, target, std::move(handles), texts,
+      base::BindOnce(
+          [](PageTranslation::ResultsCallback done,
+             const std::vector<std::optional<std::string>>& results) {
+            std::move(done).Run(results);
+          },
+          std::move(done)));
+}
+
+bool TarkPageTranslation::UnitReady(const std::string& unit) const {
+  return CaptionDownloads::Get().State(unit).state == CaptionDownloads::State::kReady;
+}
+
+void TarkPageTranslation::SetInUse(const std::string& unit, bool in_use) {
+  CaptionDownloads::Get().SetInUse(unit, in_use);
+}
+
+void TarkPageTranslation::RequestUnit(const std::string& unit, bool now) {
+  CaptionDownloads::Get().Request(unit, now, Owner::kPageTranslation);
+}
+
+bool TarkPageTranslation::CanWarm() const {
+  // A one-model load is ~0.4 GB: not on a low-RAM phone or with under 1 GiB
+  // free, not in a tab behind others, and not while this tab's captions run.
+  if (base::SysInfo::IsLowEndDevice() ||
+      base::SysInfo::AmountOfAvailablePhysicalMemory().InMiB() < 1024 ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    return false;
+  }
+  TarkCaptionsTab* captions = TarkCaptionsTab::FromWebContents(web_contents());
+  return !(captions && captions->RunningService());
+}
+
+namespace {
+// Profile pref (browser_ui_prefs.cc): "<source>><target>" for each direction
+// this profile has translated a page in. Read off the record (it inherits the
+// regular profile's), written only on it.
+constexpr char kWarmDirections[] = "tark.page_translation.warm_directions";
+
+std::string DirectionKey(const std::string& source, const std::string& target) {
+  return source + ">" + target;
+}
+}  // namespace
+
+bool TarkPageTranslation::TranslatedBefore(const std::string& source,
+                                           const std::string& target) const {
+  PrefService* prefs = user_prefs::UserPrefs::Get(web_contents()->GetBrowserContext());
+  return prefs && std::ranges::contains(prefs->GetList(kWarmDirections),
+                                        base::Value(DirectionKey(source, target)));
+}
+
+void TarkPageTranslation::RememberTranslated(const std::string& source,
+                                             const std::string& target) {
+  if (web_contents()->GetBrowserContext()->IsOffTheRecord() ||
+      TranslatedBefore(source, target)) {
+    return;
+  }
+  PrefService* prefs = user_prefs::UserPrefs::Get(web_contents()->GetBrowserContext());
+  if (prefs) {
+    ScopedListPrefUpdate(prefs, kWarmDirections)->Append(DirectionKey(source, target));
+  }
+}
+
+void TarkPageTranslation::OnGone() {
+  translator_.reset();
+  own_service_.reset();
+  if (g_page_only_holder == this) {
+    g_page_only_holder = nullptr;
+  }
+  logic_.OnBackendGone();
+}
+
+void TarkPageTranslation::ReleaseForOtherTab() {
+  // Like the app going to the background: answers null, model let go.
+  logic_.OnAppBackgrounded();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TarkPageTranslation);
+
+}  // namespace tark_captions
