+#include "chrome/browser/tark_captions_android/page_translation.h"
+#include "chrome/services/tark_captions/public/mojom/tark_captions.mojom.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace base::android {
+class ApplicationStatusListener;
+}  // namespace base::android
+
+namespace tark_captions {
+
+// Tark for Android's page translation in one tab, tied to its main document:
+// sends the page's text in batches to the tab's captions process
+// (PageTranslator). When captions are on, that is captions' process; when
+// not, one is started for the page, without speech. Never two for a tab:
+// when captions start they take over the page's process, and when they stop
+// while the page still translates it is handed back. At most one process
+// started only for a page runs in the whole browser (the current tab's: a
+// tab starting one makes another tab's page-only process go). The process is
+// let go after three idle minutes or when the app goes to the background
+// (ApplicationStatus); a new main document cancels what is outstanding. The
+// decisions are PageTranslation's.
+class TarkPageTranslation : public content::WebContentsObserver,
+                            public content::WebContentsUserData<TarkPageTranslation>,
+                            public PageTranslation::Backend {
+ public:
+  ~TarkPageTranslation() override;
+
+  // Null results are sentences that failed: the page keeps the original.
+  void Translate(std::vector<std::string> texts,
+                 std::string source,
+                 std::string target,
+                 base::OnceCallback<void(std::vector<std::optional<std::string>>)> callback);
+  bool ModelsReady(std::string source, std::string target);
+  // The Translate offer is showing for the pair: PageTranslation::Warm.
+  void Warm(std::string source, std::string target);
+  // Asks captions' downloads for the pair's missing models (Wi-Fi unless
+  // `now`); false in a Private tab, which writes nothing.
+  bool RequestModels(std::string source, std::string target, bool now);
+  void Cancel();
+
+  // TarkCaptionsTab: captions are starting in this tab. The process the page
+  // started, if any (unbound otherwise); the page keeps translating on it.
+  mojo::Remote<mojom::CaptionService> HandOverProcess();
+  // TarkCaptionsTab: captions stopped; whether the page takes `service`
+  // (still translating) instead of it exiting.
+  bool TakeProcess(mojo::Remote<mojom::CaptionService>& service);
+  // TarkCaptionsTab: whether TakeProcess would take it. Only TarkCaptionsTab
+  // calls these three.
+  bool WantsProcess() const { return logic_.connected(); }
+
+ private:
+  explicit TarkPageTranslation(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<TarkPageTranslation>;
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+
+  // PageTranslation::Backend:
+  void Connect() override;
+  void Disconnect() override;
+  void DropSent() override;
+  void SendBatch(const std::string& source,
+                 const std::string& target,
+                 const std::vector<std::string>& units,
+                 const std::vector<std::string>& texts,
+                 PageTranslation::ResultsCallback done) override;
+  bool UnitReady(const std::string& unit) const override;
+  void SetInUse(const std::string& unit, bool in_use) override;
+  void RequestUnit(const std::string& unit, bool now) override;
+  bool CanWarm() const override;
+  bool TranslatedBefore(const std::string& source, const std::string& target) const override;
+  void RememberTranslated(const std::string& source, const std::string& target) override;
+
+  // A translator on the process the page uses (captions' or its own).
+  void BindTranslator();
+  void OnFilesOpened(uint64_t generation,
+                     std::string source,
+                     std::string target,
+                     std::vector<std::string> texts,
+                     PageTranslation::ResultsCallback done,
+                     std::map<std::string, base::File> files);
+  void OnGone();
+  // Another tab started a page-only process.
+  void ReleaseForOtherTab();
+
+  // Set only while the page holds a process captions do not.
+  mojo::Remote<mojom::CaptionService> own_service_;
+  mojo::Remote<mojom::PageTranslator> translator_;
+  // Bumped by DropSent: files opened for a dropped batch are not sent.
+  uint64_t generation_ = 0;
+  std::unique_ptr<base::android::ApplicationStatusListener> app_status_;
+  // After the remotes: its destructor lets them go.
+  PageTranslation logic_;
+  base::WeakPtrFactory<TarkPageTranslation> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TARK_PAGE_TRANSLATION_H_
