+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_captions;
+
+import android.os.Bundle;
+import android.text.format.Formatter;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+import java.util.Locale;
+
+/**
+ * Settings › Accessibility › Live captions: the caption style (Automatic, word by word, a phrase at
+ * a time) and the languages on the phone, with their sizes, to delete.
+ */
+@NullMarked
+public class TarkLiveCaptionsSettings extends ChromeBaseSettingsFragment {
+    private static final String[] STYLE_KEYS = {
+        "tark_captions_style_automatic", "tark_captions_style_word", "tark_captions_style_phrase"
+    };
+    private static final String LANGUAGES_KEY = "tark_captions_languages";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.tark_live_captions_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.tark_live_captions_preferences);
+        for (int style = 0; style < STYLE_KEYS.length; style++) {
+            final int chosen = style;
+            Preference row = findPreference(STYLE_KEYS[style]);
+            if (row == null) continue;
+            row.setOnPreferenceClickListener(
+                    p -> {
+                        TarkCaptionsBridge.setStyle(chosen);
+                        updateStyle();
+                        return true;
+                    });
+        }
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateStyle();
+        updateLanguages();
+    }
+
+    private void updateStyle() {
+        int style = TarkCaptionsBridge.getStyle();
+        for (int i = 0; i < STYLE_KEYS.length; i++) {
+            TarkCaptionStylePreference row = findPreference(STYLE_KEYS[i]);
+            if (row != null) row.setChecked(i == style);
+        }
+    }
+
+    private void updateLanguages() {
+        PreferenceCategory languages = findPreference(LANGUAGES_KEY);
+        if (languages == null) return;
+        languages.removeAll();
+        String[] codes = TarkCaptionsBridge.getReadyLanguages();
+        long[] sizes = TarkCaptionsBridge.getReadyLanguageSizes();
+        if (codes.length == 0) {
+            Preference none = new Preference(getStyledContext());
+            none.setSummary(R.string.tark_captions_no_languages);
+            none.setSelectable(false);
+            languages.addPreference(none);
+            return;
+        }
+        for (int i = 0; i < codes.length; i++) {
+            final String code = codes[i];
+            final String name = unitName(code);
+            Preference row = new Preference(getStyledContext());
+            row.setTitle(name);
+            row.setSummary(Formatter.formatShortFileSize(getStyledContext(), sizes[i]));
+            row.setOnPreferenceClickListener(
+                    p -> {
+                        new AlertDialog.Builder(
+                                        getStyledContext(),
+                                        R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                                .setMessage(getString(R.string.tark_captions_delete, name))
+                                .setPositiveButton(
+                                        R.string.delete,
+                                        (d, w) -> {
+                                            TarkCaptionsBridge.removeLanguage(code);
+                                            updateLanguages();
+                                        })
+                                .setNegativeButton(R.string.cancel, null)
+                                .show();
+                        return true;
+                    });
+            languages.addPreference(row);
+        }
+    }
+
+    /** The preferences' themed context (settings may be hosted in a tab). */
+    private android.content.Context getStyledContext() {
+        return getPreferenceManager().getContext();
+    }
+
+    // A language's name, or a translation model's ("Translation: Spanish → English").
+    private String unitName(String code) {
+        int direction = 0;
+        switch (code) {
+            case "tr_indic_en":
+                direction = R.string.tark_captions_direction_indic_en;
+                break;
+            case "tr_en_indic":
+                direction = R.string.tark_captions_direction_en_indic;
+                break;
+            case "tr_es_en":
+                direction = R.string.tark_captions_direction_es_en;
+                break;
+            default:
+                return new Locale(code).getDisplayLanguage();
+        }
+        return getString(R.string.tark_captions_translation_model, getString(direction));
+    }
+}
