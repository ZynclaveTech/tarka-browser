+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_captions;
+
+import android.app.Activity;
+import android.text.TextUtils;
+import android.text.format.Formatter;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.PopupMenu;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ActivityTabProvider;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.Locale;
+
+/**
+ * Tark for Android's live captions: the caption bar at the bottom of the tab when a video plays
+ * with sound (Captions · the language · ✕), the first download of a language, and the captions
+ * themselves. Nothing listens until Captions is tapped. The state is the tab's
+ * (TarkCaptionsBridge).
+ */
+@NullMarked
+public final class TarkCaptionBarCoordinator implements TarkCaptionsBridge.Listener {
+    private final Activity mActivity;
+    private final ViewGroup mContainer;
+    private final ActivityTabProvider mTabProvider;
+    private final View mBar;
+    private final TextView mCaptionsChip;
+    private final TextView mLanguageChip;
+    private final TextView mTranslateChip;
+    private final TextView mTargetChip;
+    private final View mCaptionBox;
+    private final TextView mFinalText;
+    private final TextView mDraftText;
+    private final TextView mTranslationText;
+    private final View mDownloadCard;
+    private final TextView mDownloadTitle;
+    private final ProgressBar mDownloadProgress;
+    private final TextView mDownloadLine;
+    private final TextView mDownloadAction;
+    private @Nullable WebContents mWebContents;
+    private final Callback<@Nullable Tab> mTabObserver = this::onTabChanged;
+
+    public TarkCaptionBarCoordinator(
+            Activity activity, ViewGroup container, ActivityTabProvider tabProvider) {
+        mActivity = activity;
+        mContainer = container;
+        mTabProvider = tabProvider;
+        mBar = LayoutInflater.from(activity).inflate(R.layout.tark_caption_bar, container, false);
+        FrameLayout.LayoutParams params =
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        Gravity.BOTTOM);
+        container.addView(mBar, params);
+        mBar.setVisibility(View.GONE);
+        mCaptionsChip = mBar.findViewById(R.id.tark_captions_chip);
+        mLanguageChip = mBar.findViewById(R.id.tark_captions_language);
+        mCaptionBox = mBar.findViewById(R.id.tark_captions_box);
+        mFinalText = mBar.findViewById(R.id.tark_captions_final);
+        mDraftText = mBar.findViewById(R.id.tark_captions_draft);
+        mTranslateChip = mBar.findViewById(R.id.tark_captions_translate);
+        mTargetChip = mBar.findViewById(R.id.tark_captions_target);
+        mTranslationText = mBar.findViewById(R.id.tark_captions_translation);
+        mDownloadCard = mBar.findViewById(R.id.tark_captions_download);
+        mDownloadTitle = mBar.findViewById(R.id.tark_captions_download_title);
+        mDownloadProgress = mBar.findViewById(R.id.tark_captions_download_progress);
+        mDownloadLine = mBar.findViewById(R.id.tark_captions_download_line);
+        mDownloadAction = mBar.findViewById(R.id.tark_captions_download_action);
+
+        mCaptionsChip.setOnClickListener(
+                v -> {
+                    if (mWebContents == null) return;
+                    TarkCaptionsBridge.setCaptionsOn(
+                            mWebContents, !TarkCaptionsBridge.getState(mWebContents).captionsOn);
+                });
+        mLanguageChip.setOnClickListener(this::showLanguages);
+        mTranslateChip.setOnClickListener(
+                v -> {
+                    if (mWebContents == null) return;
+                    TarkCaptionsBridge.State state = TarkCaptionsBridge.getState(mWebContents);
+                    TarkCaptionsBridge.setTarget(
+                            mWebContents, state.target.isEmpty() ? firstTarget(state) : "");
+                });
+        mTargetChip.setOnClickListener(this::showTargets);
+        mBar.findViewById(R.id.tark_captions_close)
+                .setOnClickListener(
+                        v -> {
+                            if (mWebContents != null) TarkCaptionsBridge.hideBar(mWebContents);
+                        });
+        mDownloadAction.setOnClickListener(
+                v -> {
+                    if (mWebContents == null) return;
+                    // Only "Download now" agrees to mobile data; "Try again" retries as
+                    // before (on Wi-Fi unless the person already said now).
+                    boolean now =
+                            cardUnitState(TarkCaptionsBridge.getState(mWebContents))
+                                    == TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI;
+                    TarkCaptionsBridge.requestDownload(mWebContents, now);
+                });
+        TarkCaptionsBridge.addListener(this);
+        mTabProvider.asObservable().addSyncObserverAndCall(mTabObserver);
+    }
+
+    public void destroy() {
+        TarkCaptionsBridge.removeListener(this);
+        mTabProvider.asObservable().removeObserver(mTabObserver);
+        mContainer.removeView(mBar);
+    }
+
+    @Override
+    public void onStateChanged(WebContents webContents) {
+        if (webContents.equals(mWebContents)) render();
+    }
+
+    private void onTabChanged(@Nullable Tab tab) {
+        mWebContents = tab == null ? null : tab.getWebContents();
+        render();
+    }
+
+    private static String languageName(String code) {
+        String name = new Locale(code).getDisplayLanguage();
+        return name.isEmpty() ? code : name.substring(0, 1).toUpperCase(Locale.getDefault())
+                + name.substring(1);
+    }
+
+    private void showLanguages(View anchor) {
+        if (mWebContents == null) return;
+        WebContents webContents = mWebContents;
+        PopupMenu menu = new PopupMenu(mActivity, anchor);
+        for (int i = 0; i < TarkCaptionsBridge.LANGUAGES.length; i++) {
+            menu.getMenu().add(0, i, i, languageName(TarkCaptionsBridge.LANGUAGES[i]));
+        }
+        menu.setOnMenuItemClickListener(
+                item -> {
+                    TarkCaptionsBridge.chooseLanguage(
+                            webContents, TarkCaptionsBridge.LANGUAGES[item.getItemId()]);
+                    return true;
+                });
+        menu.show();
+    }
+
+    // Translate's first target: English, or Hindi for English captions.
+    private static String firstTarget(TarkCaptionsBridge.State state) {
+        return state.language.equals("en") ? "hi" : "en";
+    }
+
+    private void showTargets(View anchor) {
+        if (mWebContents == null) return;
+        WebContents webContents = mWebContents;
+        String language = TarkCaptionsBridge.getState(webContents).language;
+        PopupMenu menu = new PopupMenu(mActivity, anchor);
+        for (int i = 0; i < TarkCaptionsBridge.TARGETS.length; i++) {
+            if (TarkCaptionsBridge.TARGETS[i].equals(language)) continue;
+            menu.getMenu().add(0, i, i, languageName(TarkCaptionsBridge.TARGETS[i]));
+        }
+        menu.setOnMenuItemClickListener(
+                item -> {
+                    TarkCaptionsBridge.setTarget(
+                            webContents, TarkCaptionsBridge.TARGETS[item.getItemId()]);
+                    return true;
+                });
+        menu.show();
+    }
+
+    // The language is here but its translation is not: the card shows that.
+    private static boolean translationPending(TarkCaptionsBridge.State state) {
+        return state.unitState == TarkCaptionsBridge.UNIT_READY
+                && !state.target.isEmpty()
+                && state.translationUnitState != TarkCaptionsBridge.UNIT_READY;
+    }
+
+    private static int cardUnitState(TarkCaptionsBridge.State state) {
+        return translationPending(state) ? state.translationUnitState : state.unitState;
+    }
+
+    private void render() {
+        if (mWebContents == null || mWebContents.isDestroyed()) {
+            mBar.setVisibility(View.GONE);
+            return;
+        }
+        TarkCaptionsBridge.State state = TarkCaptionsBridge.getState(mWebContents);
+        mBar.setVisibility(state.barVisible ? View.VISIBLE : View.GONE);
+        if (!state.barVisible) return;
+
+        mCaptionsChip.setSelected(state.captionsOn);
+        setTextIfChanged(
+                mLanguageChip,
+                mActivity.getString(
+                        R.string.tark_captions_language_chip, languageName(state.language)));
+
+        mTranslateChip.setVisibility(state.translateAvailable ? View.VISIBLE : View.GONE);
+        mTranslateChip.setSelected(!state.target.isEmpty());
+        mTargetChip.setVisibility(
+                state.translateAvailable && !state.target.isEmpty() ? View.VISIBLE : View.GONE);
+        if (!state.target.isEmpty()) {
+            setTextIfChanged(
+                    mTargetChip,
+                    mActivity.getString(
+                            R.string.tark_captions_target_chip, languageName(state.target)));
+        }
+
+        boolean ready = state.unitState == TarkCaptionsBridge.UNIT_READY;
+        boolean pending = translationPending(state);
+        // Captions run untranslated while the translation downloads.
+        mDownloadCard.setVisibility(
+                state.captionsOn && (!ready || pending) ? View.VISIBLE : View.GONE);
+        mCaptionBox.setVisibility(state.captionsOn && ready ? View.VISIBLE : View.GONE);
+        if (state.captionsOn && (!ready || pending)) renderDownload(state, pending);
+        if (state.captionsOn && ready) renderCaptions(state);
+    }
+
+    private void renderDownload(TarkCaptionsBridge.State state, boolean translation) {
+        long total = translation ? state.translationTotal : state.total;
+        long bytes = translation ? state.translationBytes : state.bytes;
+        String size = Formatter.formatShortFileSize(mActivity, total);
+        setTextIfChanged(
+                mDownloadTitle,
+                translation
+                        ? mActivity.getString(
+                                R.string.tark_captions_getting_translation_ready, size)
+                        : mActivity.getString(
+                                R.string.tark_captions_getting_ready,
+                                languageName(state.language),
+                                size));
+        mDownloadProgress.setMax(1000);
+        mDownloadProgress.setProgress(total > 0 ? (int) (1000 * bytes / total) : 0);
+        int line = R.string.tark_captions_on_this_phone;
+        int action = 0;
+        switch (cardUnitState(state)) {
+            case TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI:
+                line = R.string.tark_captions_waiting_for_wifi;
+                action = R.string.tark_captions_download_now;
+                break;
+            case TarkCaptionsBridge.UNIT_FAILED:
+                line = R.string.tark_captions_download_failed;
+                action = R.string.tark_captions_try_again;
+                break;
+            default:
+                break;
+        }
+        setTextIfChanged(mDownloadLine, mActivity.getString(line));
+        if (action != 0) setTextIfChanged(mDownloadAction, mActivity.getString(action));
+        // Hidden then shown again on every tick would be an accessibility event each second.
+        mDownloadAction.setVisibility(action != 0 ? View.VISIBLE : View.GONE);
+    }
+
+    private void renderCaptions(TarkCaptionsBridge.State state) {
+        if (state.cantCaption || (state.finalText.isEmpty() && state.draftText.isEmpty())) {
+            mTranslationText.setVisibility(View.GONE);
+            mDraftText.setVisibility(View.VISIBLE);
+        }
+        if (state.cantCaption) {
+            setTextIfChanged(mFinalText, "");
+            setTextIfChanged(mDraftText, mActivity.getString(R.string.tark_captions_cant_caption));
+            return;
+        }
+        if (state.finalText.isEmpty() && state.draftText.isEmpty()) {
+            setTextIfChanged(mFinalText, "");
+            setTextIfChanged(mDraftText, mActivity.getString(R.string.tark_captions_listening));
+            return;
+        }
+        boolean translated = !state.translationText.isEmpty();
+        // Translate: the original small, its translation larger beneath it (word by word, the
+        // translation of the last sentence while the next one is drafted).
+        mTranslationText.setVisibility(translated ? View.VISIBLE : View.GONE);
+        setTextIfChanged(mTranslationText, state.translationText);
+        if (translated && state.draftText.isEmpty()) {
+            setTextIfChanged(mFinalText, state.finalText);
+            setTextIfChanged(mDraftText, "");
+            mDraftText.setVisibility(View.GONE);
+            return;
+        }
+        mDraftText.setVisibility(View.VISIBLE);
+        // Word by word: the last final line above what is being said; a phrase at a time: the
+        // last phrase.
+        setTextIfChanged(mFinalText, state.draftText.isEmpty() ? "" : state.finalText);
+        setTextIfChanged(mDraftText, state.draftText.isEmpty() ? state.finalText : state.draftText);
+    }
+
+    // The tab's state arrives every second (its tick); setting the same text
+    // again would still send an accessibility "content changed" event, so a
+    // screen reader would hear the caption again and the screen never settles.
+    private static void setTextIfChanged(TextView view, CharSequence text) {
+        if (!TextUtils.equals(view.getText(), text)) view.setText(text);
+    }
+}
