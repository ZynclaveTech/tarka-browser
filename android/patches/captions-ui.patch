+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_captions;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ObserverList;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * Tark for Android's live captions: one tab's captions
+ * (chrome/browser/tark_captions_android/tark_captions_tab.h) for the caption bar, and the model
+ * downloads (caption_downloads.h) for Settings.
+ */
+@JNINamespace("tark_captions")
+@NullMarked
+public final class TarkCaptionsBridge {
+    /** CaptionDownloads::State. */
+    public static final int UNIT_MISSING = 0;
+
+    public static final int UNIT_WAITING_FOR_WIFI = 1;
+    public static final int UNIT_DOWNLOADING = 2;
+    public static final int UNIT_READY = 3;
+    public static final int UNIT_FAILED = 4;
+
+    /** The features that want a unit (CaptionDownloads' Owner). */
+    public static final int OWNER_CAPTIONS = 0;
+
+    public static final int OWNER_VOICE = 1;
+
+    /** The spoken-language detector, shared by captions and voice search. */
+    public static final String LANGUAGE_ID_UNIT = "language_id";
+
+    /** The caption style pref: Automatic, word by word, a phrase at a time. */
+    public static final int STYLE_AUTOMATIC = 0;
+
+    public static final int STYLE_WORD_BY_WORD = 1;
+    public static final int STYLE_PHRASE = 2;
+
+    /** The languages of Phase 1, in the chip's order. */
+    public static final String[] LANGUAGES = {"hi", "ta", "en", "es"};
+    /** Translate's targets. */
+    public static final String[] TARGETS = {"en", "hi", "ta"};
+
+    /** What the caption bar shows for a tab. */
+    public static final class State {
+        public final boolean barVisible;
+        public final boolean captionsOn;
+        public final String language;
+        public final int unitState;
+        public final long bytes;
+        public final long total;
+        public final boolean cantCaption;
+        public final boolean phrase;
+        public final String finalText;
+        public final String draftText;
+        // Translate.
+        public final boolean translateAvailable;
+        public final String target; // "" off
+        public final int translationUnitState;
+        public final long translationBytes;
+        public final long translationTotal;
+        public final String translationText;
+
+        State(boolean barVisible, boolean captionsOn, String language, int unitState, long bytes,
+                long total, boolean cantCaption, boolean phrase, String finalText,
+                String draftText, boolean translateAvailable, String target,
+                int translationUnitState, long translationBytes, long translationTotal,
+                String translationText) {
+            this.barVisible = barVisible;
+            this.captionsOn = captionsOn;
+            this.language = language;
+            this.unitState = unitState;
+            this.bytes = bytes;
+            this.total = total;
+            this.cantCaption = cantCaption;
+            this.phrase = phrase;
+            this.finalText = finalText;
+            this.draftText = draftText;
+            this.translateAvailable = translateAvailable;
+            this.target = target;
+            this.translationUnitState = translationUnitState;
+            this.translationBytes = translationBytes;
+            this.translationTotal = translationTotal;
+            this.translationText = translationText;
+        }
+    }
+
+    /** Told when a tab's captions change. */
+    public interface Listener {
+        void onStateChanged(WebContents webContents);
+    }
+
+    private static final ObserverList<Listener> sListeners = new ObserverList<>();
+
+    /** Told when a download unit's state or progress changes (CaptionDownloads::Observer). */
+    public interface UnitListener {
+        void onUnitChanged(String unit);
+    }
+
+    private static final ObserverList<UnitListener> sUnitListeners = new ObserverList<>();
+    private static boolean sObservingUnits;
+
+    private TarkCaptionsBridge() {}
+
+    public static void addListener(Listener listener) {
+        sListeners.addObserver(listener);
+    }
+
+    public static void removeListener(Listener listener) {
+        sListeners.removeObserver(listener);
+    }
+
+    public static void addUnitListener(UnitListener listener) {
+        if (!sObservingUnits) {
+            TarkCaptionsBridgeJni.get().observeUnits();
+            sObservingUnits = true;
+        }
+        sUnitListeners.addObserver(listener);
+    }
+
+    public static void removeUnitListener(UnitListener listener) {
+        sUnitListeners.removeObserver(listener);
+    }
+
+    @CalledByNative
+    private static void onUnitChanged(@JniType("std::string") String unit) {
+        for (UnitListener listener : sUnitListeners) listener.onUnitChanged(unit);
+    }
+
+    public static State getState(WebContents webContents) {
+        return TarkCaptionsBridgeJni.get().getState(webContents);
+    }
+
+    public static void setCaptionsOn(WebContents webContents, boolean on) {
+        TarkCaptionsBridgeJni.get().setCaptionsOn(webContents, on);
+    }
+
+    public static void chooseLanguage(WebContents webContents, String language) {
+        TarkCaptionsBridgeJni.get().chooseLanguage(webContents, language);
+    }
+
+    /** Translate's target ("" turns it off). */
+    public static void setTarget(WebContents webContents, String target) {
+        TarkCaptionsBridgeJni.get().setTarget(webContents, target);
+    }
+
+    /** "Download now" (mobile data), or try a failed download again. */
+    public static void requestDownload(WebContents webContents, boolean now) {
+        TarkCaptionsBridgeJni.get().requestDownload(webContents, now);
+    }
+
+    /** ✕: the bar goes for this page. */
+    public static void hideBar(WebContents webContents) {
+        TarkCaptionsBridgeJni.get().hideBar(webContents);
+    }
+
+    public static int getStyle() {
+        return TarkCaptionsBridgeJni.get().getStyle();
+    }
+
+    public static void setStyle(int style) {
+        TarkCaptionsBridgeJni.get().setStyle(style);
+    }
+
+    /** The languages on the phone ("hi", ...), with their sizes in bytes. */
+    public static String[] getReadyLanguages() {
+        return TarkCaptionsBridgeJni.get().getReadyLanguages();
+    }
+
+    public static long[] getReadyLanguageSizes() {
+        return TarkCaptionsBridgeJni.get().getReadyLanguageSizes();
+    }
+
+    public static void removeLanguage(String language) {
+        TarkCaptionsBridgeJni.get().removeLanguage(language);
+    }
+
+    /**
+     * A unit's download: {state (UNIT_*), bytes so far, total bytes}. While it is missing, the
+     * total includes what it still needs from "common".
+     */
+    public static long[] getUnitState(String unit) {
+        return TarkCaptionsBridgeJni.get().getUnitState(unit);
+    }
+
+    /** Whether the owner (OWNER_*) wants the unit. */
+    public static boolean isUnitWantedBy(String unit, int owner) {
+        return TarkCaptionsBridgeJni.get().isUnitWantedBy(unit, owner);
+    }
+
+    /** the owner wants the unit: fetched on Wi-Fi, or now; nothing is fetched when it is there. */
+    public static void requestUnit(String unit, int owner, boolean now) {
+        TarkCaptionsBridgeJni.get().requestUnit(unit, owner, now);
+    }
+
+    /** the owner no longer wants the unit: deleted unless another feature still wants it. */
+    public static void removeUnit(String unit, int owner) {
+        TarkCaptionsBridgeJni.get().removeUnit(unit, owner);
+    }
+
+    /** A language's download size in bytes (its model and, if missing, the common files). */
+    public static long getDownloadSize(String language) {
+        return TarkCaptionsBridgeJni.get().getDownloadSize(language);
+    }
+
+    @CalledByNative
+    private static State createState(boolean barVisible, boolean captionsOn,
+            @JniType("std::string") String language, int unitState, long bytes, long total,
+            boolean cantCaption, boolean phrase, @JniType("std::string") String finalText,
+            @JniType("std::string") String draftText, boolean translateAvailable,
+            @JniType("std::string") String target, int translationUnitState,
+            long translationBytes, long translationTotal,
+            @JniType("std::string") String translationText) {
+        return new State(barVisible, captionsOn, language, unitState, bytes, total, cantCaption,
+                phrase, finalText, draftText, translateAvailable, target, translationUnitState,
+                translationBytes, translationTotal, translationText);
+    }
+
+    @CalledByNative
+    private static void onStateChanged(WebContents webContents) {
+        for (Listener listener : sListeners) listener.onStateChanged(webContents);
+    }
+
+    @NativeMethods
+    interface Natives {
+        State getState(WebContents webContents);
+
+        void setCaptionsOn(WebContents webContents, boolean on);
+
+        void chooseLanguage(WebContents webContents, @JniType("std::string") String language);
+
+        void setTarget(WebContents webContents, @JniType("std::string") String target);
+
+        void requestDownload(WebContents webContents, boolean now);
+
+        void hideBar(WebContents webContents);
+
+        int getStyle();
+
+        void setStyle(int style);
+
+        void observeUnits();
+
+        @JniType("std::vector<std::string>")
+        String[] getReadyLanguages();
+
+        @JniType("std::vector<int64_t>")
+        long[] getReadyLanguageSizes();
+
+        void removeLanguage(@JniType("std::string") String language);
+
+        long getDownloadSize(@JniType("std::string") String language);
+
+        @JniType("std::vector<int64_t>")
+        long[] getUnitState(@JniType("std::string") String unit);
+
+        boolean isUnitWantedBy(@JniType("std::string") String unit, int owner);
+
+        void requestUnit(@JniType("std::string") String unit, int owner, boolean now);
+
+        void removeUnit(@JniType("std::string") String unit, int owner);
+    }
+}
