+
+/** A caption style row in Settings › Live captions, with a check when it is the chosen one. */
+@NullMarked
+public class TarkCaptionStylePreference extends Preference {
+    private boolean mChecked;
+
+    public TarkCaptionStylePreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setWidgetLayoutResource(R.layout.tark_captions_check);
+    }
+
+    public void setChecked(boolean checked) {
+        if (mChecked == checked) return;
+        mChecked = checked;
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        View check = holder.findViewById(R.id.tark_captions_check);
+        if (check != null) check.setVisibility(mChecked ? View.VISIBLE : View.INVISIBLE);
+    }
+}
