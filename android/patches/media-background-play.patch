+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+
+/**
+ * Settings → Background play and → Picture in Picture, both on by default. Chrome's shared
+ * preferences hold them, so the browser's C++ reads the same values
+ * (TabWebContentsDelegateAndroid::GetBackgroundMediaSettings). A tab playing with sound when Tark
+ * is left keeps telling its page "visible" while a player plays, if Background play is on, or
+ * Picture in Picture is on and its video floats.
+ */
+@NullMarked
+public final class TarkMediaPrefs {
+    private TarkMediaPrefs() {}
+
+    /** Media keeps playing when you leave Tark. */
+    public static boolean backgroundPlay() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.TARK_MEDIA_BACKGROUND_PLAY, true);
+    }
+
+    /** A playing video floats in a small window when you leave Tark. */
+    public static boolean pictureInPicture() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(ChromePreferenceKeys.TARK_MEDIA_PICTURE_IN_PICTURE, true);
+    }
+
+    public static void setBackgroundPlay(boolean on) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.TARK_MEDIA_BACKGROUND_PLAY, on);
+    }
+
+    public static void setPictureInPicture(boolean on) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.TARK_MEDIA_PICTURE_IN_PICTURE, on);
+    }
+}
diff --color -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkMediaSwitchPreference.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkMediaSwitchPreference.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkMediaSwitchPreference.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkMediaSwitchPreference.java	2026-10-29 22:46:27.318838750 +0530
@@ -0,0 +1,57 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import android.content.Context;
+import android.util.AttributeSet;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+
+/**
+ * A Settings switch for one of {@link TarkMediaPrefs}: Background play (key {@link
+ * #KEY_BACKGROUND_PLAY}) or Picture in Picture (key {@link #KEY_PICTURE_IN_PICTURE}).
+ */
+@NullMarked
+public class TarkMediaSwitchPreference extends ChromeSwitchPreference {
+    public static final String KEY_BACKGROUND_PLAY = "tark_background_play";
+    public static final String KEY_PICTURE_IN_PICTURE = "tark_picture_in_picture";
+
+    public TarkMediaSwitchPreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        // TarkMediaPrefs holds the value, not the preference screen's own storage.
+        setPersistent(false);
+        setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    write((Boolean) newValue);
+                    return true;
+                });
+    }
+
+    @Override
+    public void onAttached() {
+        super.onAttached();
+        setChecked(read());
+    }
+
+    private boolean isPictureInPicture() {
+        return KEY_PICTURE_IN_PICTURE.equals(getKey());
+    }
+
+    private boolean read() {
+        return isPictureInPicture()
+                ? TarkMediaPrefs.pictureInPicture()
+                : TarkMediaPrefs.backgroundPlay();
+    }
+
+    private void write(boolean on) {
+        if (isPictureInPicture()) {
+            TarkMediaPrefs.setPictureInPicture(on);
+        } else {
+            TarkMediaPrefs.setBackgroundPlay(on);
+        }
+    }
+}
