@@ -0,0 +1,65 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.SharedPreferences;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+/** Settings → Background play and → Picture in Picture: on by default, and kept. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class TarkMediaPrefsTest {
+    private SharedPreferences mPrefs;
+
+    @Before
+    public void setUp() {
+        mPrefs = ContextUtils.getAppSharedPreferences();
+        mPrefs.edit().clear().commit();
+    }
+
+    @Test
+    public void testBothDefaultOn() {
+        assertTrue(TarkMediaPrefs.backgroundPlay());
+        assertTrue(TarkMediaPrefs.pictureInPicture());
+    }
+
+    @Test
+    public void testBackgroundPlayPersists() {
+        TarkMediaPrefs.setBackgroundPlay(false);
+        assertFalse(TarkMediaPrefs.backgroundPlay());
+        // The other setting is separate.
+        assertTrue(TarkMediaPrefs.pictureInPicture());
+        TarkMediaPrefs.setBackgroundPlay(true);
+        assertTrue(TarkMediaPrefs.backgroundPlay());
+    }
+
+    @Test
+    public void testPictureInPicturePersists() {
+        TarkMediaPrefs.setPictureInPicture(false);
+        assertFalse(TarkMediaPrefs.pictureInPicture());
+        assertTrue(TarkMediaPrefs.backgroundPlay());
+        TarkMediaPrefs.setPictureInPicture(true);
+        assertTrue(TarkMediaPrefs.pictureInPicture());
+    }
+
+    @Test
+    public void testStoredUnderTheKeysNativeReads() {
+        // TabWebContentsDelegateAndroid::ShouldHoldVisibilityWhileAudible reads these keys
+        // from Chrome's shared preferences.
+        TarkMediaPrefs.setBackgroundPlay(false);
+        TarkMediaPrefs.setPictureInPicture(false);
+        assertEquals(false, mPrefs.getBoolean("tark.media.background_play", true));
+        assertEquals(false, mPrefs.getBoolean("tark.media.pip", true));
+    }
+}
