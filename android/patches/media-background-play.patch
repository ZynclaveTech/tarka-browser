+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/web_contents/tark_media/visibility_hold.h"
+
+namespace content::tark_media {
+
+// static
+bool VisibilityHold::Allowed(bool app_hidden,
+                             bool background_play,
+                             bool picture_in_picture,
+                             bool has_picture_in_picture_video) {
+  return app_hidden &&
+         (background_play ||
+          (picture_in_picture && has_picture_in_picture_video));
+}
+
+bool VisibilityHold::ShouldHoldVisibility(bool page_hidden,
+                                          bool audible,
+                                          bool playing,
+                                          base::FunctionRef<bool()> allowed) {
+  if (!page_hidden) {
+    held_ = false;
+    page_sees_visible_ = true;
+    return false;
+  }
+  if (held_) {
+    // A later update while hidden (occlusion, Picture in Picture starting or
+    // ending) keeps the hold while a player plays.
+    if (playing) {
+      return true;
+    }
+    held_ = false;
+  } else if (page_sees_visible_ && audible && allowed()) {
+    // Only at the moment of leaving: a page that was already told hidden
+    // isn't told visible again.
+    held_ = true;
+    return true;
+  }
+  page_sees_visible_ = false;
+  return false;
+}
+
+bool VisibilityHold::OnPlayingChanged(bool playing) {
+  if (!held_ || playing) {
+    return false;
+  }
+  held_ = false;
+  page_sees_visible_ = false;
+  return true;
+}
+
+}  // namespace content::tark_media
diff --color -ruN a/content/browser/web_contents/tark_media/visibility_hold.h b/content/browser/web_contents/tark_media/visibility_hold.h
--- a/content/browser/web_contents/tark_media/visibility_hold.h	1970-01-01 05:30:00.000000000 +0530
+++ b/content/browser/web_contents/tark_media/visibility_hold.h	2026-10-29 22:46:27.295737760 +0530
@@ -0,0 +1,69 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_WEB_CONTENTS_TARK_MEDIA_VISIBILITY_HOLD_H_
+#define CONTENT_BROWSER_WEB_CONTENTS_TARK_MEDIA_VISIBILITY_HOLD_H_
+
+#include "base/functional/function_ref.h"
+
+namespace content::tark_media {
+
+// Tark for Android: Background play and Picture in Picture. A tab that is
+// playing media with sound at the moment it is hidden keeps telling its page
+// "visible": no visibilitychange, and Blink's media player doesn't pause hidden
+// video (WebMediaPlayerImpl::IsPageHidden() stays false). Only the page's
+// frame trees are held; the tab's views are hidden as upstream, and
+// WebContentsImpl::GetPageVisibilityState() still reports hidden.
+//
+// The hold ends as soon as no media player in the tab is playing (all paused
+// or ended): the page then gets "hidden" and one visibilitychange, as it
+// would have on leaving. A silent stretch while a player still plays (a quiet
+// gap, an ad's silent start) keeps it. Showing the tab ends it too, with no
+// event (the page already sees "visible").
+//
+// One per WebContentsImpl; it only decides; WebContentsImpl sends.
+class VisibilityHold {
+ public:
+  VisibilityHold() = default;
+  VisibilityHold(const VisibilityHold&) = delete;
+  VisibilityHold& operator=(const VisibilityHold&) = delete;
+
+  // Whether a hold may start, from the embedder: only when the tab is hidden
+  // because Tark itself went to the background (`app_hidden`: Home, another
+  // app, the lock screen), never for a tab hidden inside Tark (a tab switch,
+  // the tab switcher, a new tab), which pauses as upstream. Then Background
+  // play on, or Picture in Picture on and a video of the tab is in Picture in
+  // Picture (Tark enters it before the tab is hidden). With only Picture in
+  // Picture on and no window, the page is hidden and pauses, as upstream.
+  static bool Allowed(bool app_hidden,
+                      bool background_play,
+                      bool picture_in_picture,
+                      bool has_picture_in_picture_video);
+
+  // On every visibility update. `page_hidden`: upstream would tell the page
+  // hidden (kHidden or kHiddenButPainting). `audible`: the tab plays sound
+  // now (needed to start a hold). `playing`: a media player of the tab plays
+  // (needed to keep one). `allowed`: asked only when a hold would start.
+  // Returns true when the page must be told "visible" instead.
+  bool ShouldHoldVisibility(bool page_hidden,
+                            bool audible,
+                            bool playing,
+                            base::FunctionRef<bool()> allowed);
+
+  // When the tab's playing state changes (a player started or stopped).
+  // Returns true when this releases the hold: the caller then sends the page
+  // its real visibility again.
+  bool OnPlayingChanged(bool playing);
+
+  bool held() const { return held_; }
+
+ private:
+  // The page sees "visible" (shown, or held).
+  bool page_sees_visible_ = false;
+  bool held_ = false;
+};
+
+}  // namespace content::tark_media
+
+#endif  // CONTENT_BROWSER_WEB_CONTENTS_TARK_MEDIA_VISIBILITY_HOLD_H_
diff --color -ruN a/content/browser/web_contents/tark_media/visibility_hold_unittest.cc b/content/browser/web_contents/tark_media/visibility_hold_unittest.cc
--- a/content/browser/web_contents/tark_media/visibility_hold_unittest.cc	1970-01-01 05:30:00.000000000 +0530
+++ b/content/browser/web_contents/tark_media/visibility_hold_unittest.cc	2026-10-29 22:46:27.295343630 +0530
@@ -0,0 +1,297 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/web_contents/tark_media/visibility_hold.h"
+
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace content::tark_media {
+namespace {
+
+struct Settings {
+  bool background_play = true;
+  bool picture_in_picture = true;
+};
+
+// A page as WebContentsImpl drives it: what the page's script sees
+// (document.visibilityState), the visibilitychange events it got, and whether
+// Blink's media player would pause its video (it pauses hidden video).
+class FakeTab {
+ public:
+  explicit FakeTab(Settings settings = {}) : settings_(settings) {}
+
+  // WasShown / WasHidden: UpdateVisibilityAndNotifyPageAndView. Hide():
+  // Tark went to the background; HideInsideTark(): another tab was selected.
+  void Show() { Update(/*hidden=*/false); }
+  void Hide() {
+    app_hidden_ = true;
+    Update(/*hidden=*/true);
+  }
+  void HideInsideTark() {
+    app_hidden_ = false;
+    Update(/*hidden=*/true);
+  }
+
+  // Tark entered Picture in Picture (onUserLeaveHint, before WasHidden).
+  void EnterPictureInPicture() { has_pip_video_ = true; }
+
+  // The page's own play()/pause(), a silent stretch, the end of the stream.
+  void Play() {
+    audible_ = !muted_;
+    SetPlaying(true);
+  }
+  void Pause() {
+    audible_ = false;
+    SetPlaying(false);
+  }
+  void Ended() { Pause(); }
+  void Mute() {
+    muted_ = true;
+    audible_ = false;  // OnAudioStateChanged: nothing to do.
+  }
+  void SilentStretch() { audible_ = false; }
+
+  std::string visibility_state() const {
+    return page_visible_ ? "visible" : "hidden";
+  }
+  const std::vector<std::string>& events() const { return events_; }
+  bool video_paused() const { return !playing_; }
+  int asked() const { return asked_; }
+
+ private:
+  // MediaStartedPlaying / MediaStoppedPlaying.
+  void SetPlaying(bool playing) {
+    playing_ = playing;
+    if (hold_.OnPlayingChanged(playing)) {
+      Update(/*hidden=*/true);
+    }
+  }
+
+  void Update(bool hidden) {
+    bool held = hold_.ShouldHoldVisibility(hidden, audible_, playing_, [this] {
+      ++asked_;
+      return VisibilityHold::Allowed(app_hidden_, settings_.background_play,
+                                     settings_.picture_in_picture,
+                                     has_pip_video_);
+    });
+    bool visible = !hidden || held;
+    if (visible != page_visible_) {
+      page_visible_ = visible;
+      events_.push_back(visibility_state());
+    }
+    // WebMediaPlayerImpl::OnPageHidden → PauseVideoIfNeeded(kPageHidden),
+    // except a video in Picture in Picture.
+    if (!page_visible_ && !has_pip_video_) {
+      playing_ = false;
+      audible_ = false;
+    }
+  }
+
+  const Settings settings_;
+  VisibilityHold hold_;
+  bool page_visible_ = false;
+  bool audible_ = false;
+  bool playing_ = false;
+  bool muted_ = false;
+  bool has_pip_video_ = false;
+  bool app_hidden_ = false;
+  std::vector<std::string> events_;
+  int asked_ = 0;
+};
+
+TEST(TarkVisibilityHoldTest, PlayingWithSoundThenHideStaysVisible) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+  EXPECT_EQ(std::vector<std::string>{"visible"}, tab.events());
+}
+
+TEST(TarkVisibilityHoldTest, NothingPlayingThenHideIsHidden) {
+  FakeTab tab;
+  tab.Show();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_EQ((std::vector<std::string>{"visible", "hidden"}), tab.events());
+  // Nothing to hold: the settings aren't even asked.
+  EXPECT_EQ(0, tab.asked());
+}
+
+TEST(TarkVisibilityHoldTest, MutedThenHideIsHidden) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Mute();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_TRUE(tab.video_paused());
+}
+
+TEST(TarkVisibilityHoldTest, HoldReleasedWhenMediaPauses) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  ASSERT_EQ("visible", tab.visibility_state());
+  // Released at once: no wait for the audible state.
+  tab.Pause();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  // Exactly one visibilitychange, to hidden, after the first show.
+  EXPECT_EQ((std::vector<std::string>{"visible", "hidden"}), tab.events());
+}
+
+TEST(TarkVisibilityHoldTest, HoldReleasedWhenEnded) {
+  // The stream ends with no next item.
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.Ended();
+  EXPECT_EQ("hidden", tab.visibility_state());
+}
+
+TEST(TarkVisibilityHoldTest, SilentStretchWhilePlayingKeepsTheHold) {
+  // A quiet gap, an ad's silent start, or a mute while the player plays.
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.SilentStretch();
+  EXPECT_EQ("visible", tab.visibility_state());
+  tab.Mute();
+  tab.Hide();  // A later update (occlusion) while silent.
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+  EXPECT_EQ(std::vector<std::string>{"visible"}, tab.events());
+}
+
+TEST(TarkVisibilityHoldTest, SettingsOffIsUpstream) {
+  FakeTab tab({.background_play = false, .picture_in_picture = false});
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_TRUE(tab.video_paused());
+  EXPECT_EQ(1, tab.asked());
+}
+
+TEST(TarkVisibilityHoldTest, OnlyPictureInPictureWithoutWindowIsUpstream) {
+  // Background play off, Picture in Picture on, no window opened: the sound
+  // doesn't go on in the background.
+  FakeTab tab({.background_play = false, .picture_in_picture = true});
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_TRUE(tab.video_paused());
+}
+
+TEST(TarkVisibilityHoldTest, OnlyPictureInPictureWithWindowIsHeld) {
+  FakeTab tab({.background_play = false, .picture_in_picture = true});
+  tab.Show();
+  tab.Play();
+  tab.EnterPictureInPicture();
+  tab.Hide();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+}
+
+TEST(TarkVisibilityHoldTest, BackgroundPlayOnlyIsHeld) {
+  FakeTab tab({.background_play = true, .picture_in_picture = false});
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("visible", tab.visibility_state());
+}
+
+TEST(TarkVisibilityHoldTest, TabSwitchInsideTarkIsUpstream) {
+  // Another tab selected while this one plays with sound: it pauses as
+  // upstream, whatever the settings.
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.HideInsideTark();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_TRUE(tab.video_paused());
+  EXPECT_EQ((std::vector<std::string>{"visible", "hidden"}), tab.events());
+}
+
+TEST(TarkVisibilityHoldTest, Allowed) {
+  EXPECT_TRUE(VisibilityHold::Allowed(true, true, false, false));
+  EXPECT_TRUE(VisibilityHold::Allowed(true, true, true, false));
+  EXPECT_FALSE(VisibilityHold::Allowed(true, false, true, false));
+  EXPECT_TRUE(VisibilityHold::Allowed(true, false, true, true));
+  EXPECT_FALSE(VisibilityHold::Allowed(true, false, false, true));
+  // A tab hidden inside Tark: never.
+  EXPECT_FALSE(VisibilityHold::Allowed(false, true, true, true));
+}
+
+TEST(TarkVisibilityHoldTest, LaterHiddenUpdatesKeepTheHold) {
+  // Occlusion, or Picture in Picture starting (kHiddenButPainting), re-run
+  // the update while hidden.
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.Hide();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+  EXPECT_EQ(1, tab.asked());
+}
+
+TEST(TarkVisibilityHoldTest, ShowAfterHoldSendsNoEvent) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.Show();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_EQ(std::vector<std::string>{"visible"}, tab.events());
+  // Paused once shown: nothing to release.
+  tab.Pause();
+  EXPECT_EQ("visible", tab.visibility_state());
+}
+
+TEST(TarkVisibilityHoldTest, NoHoldAgainAfterRelease) {
+  // Released, hidden: playing again in the background doesn't make the page
+  // visible again.
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.Pause();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+}
+
+TEST(TarkVisibilityHoldTest, NeverShownTabIsNotHeld) {
+  // A tab opened in the background that plays sound isn't made visible.
+  FakeTab tab;
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_EQ(0, tab.asked());
+}
+
+TEST(TarkVisibilityHoldTest, HoldAgainAfterShowingAgain) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  tab.Pause();
+  tab.Show();
+  tab.Play();
+  tab.Hide();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+}
+
+}  // namespace
+}  // namespace content::tark_media
