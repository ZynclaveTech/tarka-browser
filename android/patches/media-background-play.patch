+# Copyright 2026 The Tark Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Tark for Android: Background play. WebContentsImpl asks VisibilityHold
+# whether a tab being hidden keeps showing "visible" to its page while its
+# media plays with sound. It has no browser dependencies, so its unit tests
+# also build for the build machine (android/build.sh runs them).
+
+import("//testing/test.gni")
+
+source_set("visibility_hold") {
+  sources = [
+    "visibility_hold.cc",
+    "visibility_hold.h",
+  ]
+  deps = [ "//base" ]
+}
+
+if (!is_android) {
+  # For the build machine only, as tark_update_unittests.
+  test("tark_visibility_hold_unittests") {
+    sources = [ "visibility_hold_unittest.cc" ]
+    deps = [
+      ":visibility_hold",
+      "//base",
+      "//base/test:run_all_unittests",
+      "//testing/gtest",
+    ]
+  }
+}
+
+if (current_toolchain == default_toolchain) {
+  group("host_unittests") {
+    testonly = true
+    deps = [ ":tark_visibility_hold_unittests($host_toolchain)" ]
+  }
