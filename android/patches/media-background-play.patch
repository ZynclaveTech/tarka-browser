+content::WebContentsDelegate::BackgroundMediaSettings
+TabWebContentsDelegateAndroid::GetBackgroundMediaSettings(
+    content::WebContents* source) {
+  // Tark: Settings → Background play and → Picture in Picture (both on by
+  // default). The keys and defaults are TarkMediaPrefs.java's. Tark itself
+  // went to the background when none of its activities is running or paused
+  // (Home, another app, the lock screen; Picture in Picture pauses the
+  // activity and doesn't hide the tab): ChromeActivity.onStop hides the tab
+  // after its activity is stopped (ApplicationStatus updates in
+  // Activity.onStop). A tab switch inside Tark leaves the state running.
+  const base::android::ApplicationState app_state =
+      base::android::ApplicationStatusListener::GetState();
+  base::android::SharedPreferencesManager prefs =
+      android::shared_preferences::GetChromeSharedPreferences();
+  return {
+      .app_hidden =
+          app_state ==
+              base::android::APPLICATION_STATE_HAS_STOPPED_ACTIVITIES ||
+          app_state ==
+              base::android::APPLICATION_STATE_HAS_DESTROYED_ACTIVITIES,
+      .background_play = prefs.ReadBoolean("tark.media.background_play", true),
+      .picture_in_picture = prefs.ReadBoolean("tark.media.pip", true),
+  };
+}
