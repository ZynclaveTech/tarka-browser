+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+
+import net.openid.appauth.RedirectUriReceiverActivity;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.Shadows;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.base.test.util.Features.DisableFeatures;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.external_intents.ExternalIntentsFeatures;
+import org.chromium.components.external_intents.ExternalNavigationDelegate;
+import org.chromium.components.external_intents.ExternalNavigationHandler;
+import org.chromium.components.external_intents.ExternalNavigationHandler.OverrideUrlLoadingResult;
+import org.chromium.components.external_intents.ExternalNavigationHandler.OverrideUrlLoadingResultType;
+import org.chromium.components.external_intents.ExternalNavigationParams;
+import org.chromium.components.external_intents.RedirectHandler;
+import org.chromium.ui.base.WindowAndroid;
+import org.chromium.ui.modaldialog.ModalDialogManager;
+import org.chromium.url.GURL;
+
+/**
+ * Tests for the Zynclave sign-in redirect (spec §5.3, zynclave-redirect.patch): {@link
+ * ZynclaveRedirect}'s decision, and {@link ExternalNavigationHandler} handing a marked redirect to
+ * AppAuth ahead of its own rules.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+@DisableFeatures(ExternalIntentsFeatures.EXTERNAL_NAVIGATION_DEBUG_LOGS_NAME)
+public class ZynclaveRedirectTest {
+    private static final String TOKEN = "pending-token";
+    private Activity mActivity;
+    private String mRedirect;
+
+    @Before
+    public void setUp() {
+        mActivity = Robolectric.buildActivity(Activity.class).get();
+        mRedirect = mActivity.getPackageName() + ":/oauth2redirect?code=x&state=y";
+    }
+
+    private Intent customTabIntent(@Nullable String token) {
+        Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse("https://auth.zynclave.com/"));
+        if (token != null) intent.putExtra(ZynclaveAccount.EXTRA_AUTH_TOKEN, token);
+        return intent;
+    }
+
+    private @Nullable Intent decide(
+            String spec,
+            boolean isCustomTab,
+            boolean isIncognito,
+            @Nullable Intent tabIntent,
+            @Nullable String pending) {
+        return ZynclaveRedirect.intentFor(
+                mActivity, spec, isCustomTab, isIncognito, tabIntent, () -> pending);
+    }
+
+    /** The handler for a tab whose delegate answers with {@link ZynclaveRedirect}. */
+    private ExternalNavigationHandler handler(
+            ExternalNavigationDelegate delegate, boolean isCustomTab, @Nullable String tabToken) {
+        WindowAndroid window = mock(WindowAndroid.class);
+        when(window.getModalDialogManager()).thenReturn(mock(ModalDialogManager.class));
+        when(delegate.getWindowAndroid()).thenReturn(window);
+        when(delegate.getContext()).thenReturn(mActivity);
+        when(delegate.tarkZynclaveRedirectIntent(any()))
+                .thenAnswer(
+                        call ->
+                                decide(
+                                        call.<GURL>getArgument(0).getSpec(),
+                                        isCustomTab,
+                                        /* isIncognito= */ false,
+                                        customTabIntent(tabToken),
+                                        TOKEN));
+        return new ExternalNavigationHandler(delegate);
+    }
+
+    /** A main-frame navigation to {@code spec}, a custom scheme. */
+    private static ExternalNavigationParams navigation(
+            String spec, boolean isRedirect, boolean hasUserGesture) {
+        GURL url = mock(GURL.class);
+        when(url.getSpec()).thenReturn(spec);
+        when(url.getScheme()).thenReturn(Uri.parse(spec).getScheme());
+        when(url.isValid()).thenReturn(true);
+        when(url.isEmpty()).thenReturn(false);
+        RedirectHandler redirectHandler = mock(RedirectHandler.class);
+        ExternalNavigationParams params = mock(ExternalNavigationParams.class);
+        when(params.getUrl()).thenReturn(url);
+        when(params.isMainFrame()).thenReturn(true);
+        when(params.isRedirect()).thenReturn(isRedirect);
+        when(params.hasUserGesture()).thenReturn(hasUserGesture);
+        when(params.isRendererInitiated()).thenReturn(true);
+        when(params.getRedirectHandler()).thenReturn(redirectHandler);
+        return params;
+    }
+
+    private void assertStartedAppAuth(String spec) {
+        Intent started = Shadows.shadowOf(mActivity).getNextStartedActivity();
+        assertNotNull(started);
+        assertEquals(
+                RedirectUriReceiverActivity.class.getName(), started.getComponent().getClassName());
+        assertEquals(mActivity.getPackageName(), started.getComponent().getPackageName());
+        assertEquals(Uri.parse(spec), started.getData());
+    }
+
+    @Test
+    public void testMarkedCustomTabRedirectGoesToAppAuth() {
+        Intent intent = decide(mRedirect, true, false, customTabIntent(TOKEN), TOKEN);
+        assertNotNull(intent);
+        assertEquals(
+                "net.openid.appauth.RedirectUriReceiverActivity",
+                intent.getComponent().getClassName());
+        assertEquals(Intent.ACTION_VIEW, intent.getAction());
+        assertEquals(Uri.parse(mRedirect), intent.getData());
+
+        ExternalNavigationDelegate delegate = mock(ExternalNavigationDelegate.class);
+        OverrideUrlLoadingResult result =
+                handler(delegate, true, TOKEN)
+                        .shouldOverrideUrlLoading(
+                                navigation(mRedirect, /* isRedirect= */ false, true));
+        assertEquals(
+                OverrideUrlLoadingResultType.OVERRIDE_WITH_EXTERNAL_INTENT,
+                result.getResultType());
+        assertStartedAppAuth(mRedirect);
+        verify(delegate).tarkZynclaveRedirectStarted();
+    }
+
+    @Test
+    public void testServerRedirectWithoutGestureReachesAppAuth() {
+        // Hydra's 302 at the end of the login chain: a redirect, no gesture.
+        ExternalNavigationDelegate delegate = mock(ExternalNavigationDelegate.class);
+        OverrideUrlLoadingResult result =
+                handler(delegate, true, TOKEN)
+                        .shouldOverrideUrlLoading(
+                                navigation(mRedirect, /* isRedirect= */ true, false));
+        assertEquals(
+                OverrideUrlLoadingResultType.OVERRIDE_WITH_EXTERNAL_INTENT,
+                result.getResultType());
+        assertStartedAppAuth(mRedirect);
+        verify(delegate).tarkZynclaveRedirectStarted();
+    }
+
+    @Test
+    public void testNormalTabStaysInTab() {
+        assertNull(
+                decide(mRedirect, /* isCustomTab= */ false, false, customTabIntent(TOKEN), TOKEN));
+    }
+
+    @Test
+    public void testIncognitoStaysInTab() {
+        assertNull(decide(mRedirect, true, /* isIncognito= */ true, customTabIntent(TOKEN), TOKEN));
+    }
+
+    @Test
+    public void testUnmarkedCustomTabStaysInTab() {
+        assertNull(decide(mRedirect, true, false, customTabIntent(null), TOKEN));
+        assertNull(decide(mRedirect, true, false, null, TOKEN));
+    }
+
+    @Test
+    public void testNoPendingRequestStaysInTab() {
+        assertNull(decide(mRedirect, true, false, customTabIntent(TOKEN), null));
+    }
+
+    @Test
+    public void testWrongTokenStaysInTab() {
+        assertNull(decide(mRedirect, true, false, customTabIntent("other-token"), TOKEN));
+        assertNull(decide(mRedirect, true, false, customTabIntent(""), TOKEN));
+    }
+
+    @Test
+    public void testOtherPathStaysInTab() {
+        String pkg = mActivity.getPackageName();
+        assertNull(decide(pkg + ":/other", true, false, customTabIntent(TOKEN), TOKEN));
+        assertNull(decide(pkg + ":/oauth2redirect/x", true, false, customTabIntent(TOKEN), TOKEN));
+        assertNull(
+                decide(
+                        "com.example.app:/oauth2redirect?code=x",
+                        true,
+                        false,
+                        customTabIntent(TOKEN),
+                        TOKEN));
+        assertNull(
+                decide(
+                        "https://auth.zynclave.com/oauth2redirect",
+                        true,
+                        false,
+                        customTabIntent(TOKEN),
+                        TOKEN));
+    }
+}
