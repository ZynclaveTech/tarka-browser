+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+
+import net.openid.appauth.RedirectUriReceiverActivity;
+
+import org.chromium.base.IntentUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.function.Supplier;
+
+/**
+ * Tark: whether a navigation is the Zynclave sign-in redirect that AppAuth must get (spec §5.3).
+ * ExternalNavigationDelegateImpl asks it for every external-protocol main-frame navigation.
+ */
+@NullMarked
+public final class ZynclaveRedirect {
+    static final String REDIRECT_PATH = "/oauth2redirect";
+
+    private ZynclaveRedirect() {}
+
+    /**
+     * The explicit intent to AppAuth's RedirectUriReceiverActivity, with {@code spec} as its
+     * data, when all hold: the scheme is Tark's package name and the path is /oauth2redirect;
+     * the tab is a Custom Tab, not incognito; its intent carries {@link
+     * ZynclaveAccount#EXTRA_AUTH_TOKEN} equal to the pending sign-in's token. Null otherwise, and
+     * the navigation is handled as upstream would (a self-navigation stays in the tab).
+     *
+     * @param context The Custom Tab's activity; also gives the package name.
+     * @param tabIntent The intent that opened the tab's activity.
+     * @param pendingAuthToken Read only when everything else holds.
+     */
+    public static @Nullable Intent intentFor(
+            Context context,
+            String spec,
+            boolean isCustomTab,
+            boolean isIncognito,
+            @Nullable Intent tabIntent,
+            Supplier<@Nullable String> pendingAuthToken) {
+        Uri uri = Uri.parse(spec);
+        if (!context.getPackageName().equals(uri.getScheme())) return null;
+        if (!REDIRECT_PATH.equals(uri.getPath())) return null;
+        if (!isCustomTab || isIncognito || tabIntent == null) return null;
+        String tabToken =
+                IntentUtils.safeGetStringExtra(tabIntent, ZynclaveAccount.EXTRA_AUTH_TOKEN);
+        if (tabToken == null) return null;
+        String pending = pendingAuthToken.get();
+        if (pending == null) return null;
+        if (!MessageDigest.isEqual(
+                tabToken.getBytes(StandardCharsets.UTF_8),
+                pending.getBytes(StandardCharsets.UTF_8))) {
+            return null;
+        }
+        Intent intent = new Intent(Intent.ACTION_VIEW, uri);
+        intent.setClass(context, RedirectUriReceiverActivity.class);
+        return intent;
+    }
+}
