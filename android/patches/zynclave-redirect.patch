+        return result;
+    }
+
+    /**
+     * Tark: hands the Zynclave sign-in redirect ({@code <package>:/oauth2redirect?code=...}) to
+     * AppAuth, only from the Custom Tab Tark opened for the pending sign-in (the delegate checks
+     * the tab). It runs ahead of every upstream rule because two of them would keep the redirect
+     * in the tab: isNavigationToSelf() turns any custom-scheme URL that resolves to Tark into
+     * forNavigateTab, and navigationChainBlocksExternalNavigation() asks for a prompt when the
+     * chain has no gesture, has expired, or has already launched an app. The redirect is a
+     * server 302 at the end of the login chain, so neither may apply to it. Returns null for
+     * every other navigation.
+     */
+    private @Nullable OverrideUrlLoadingResult handleTarkZynclaveRedirect(
+            ExternalNavigationParams params) {
+        if (!params.isMainFrame()) return null;
+        if (UrlUtilities.isAcceptedScheme(params.getUrl())) return null;
+        Intent intent = mDelegate.tarkZynclaveRedirectIntent(params.getUrl());
+        if (intent == null) return null;
+        OverrideUrlLoadingResult result = startActivity(intent, params);
+        if (result.getResultType() == OverrideUrlLoadingResultType.OVERRIDE_WITH_EXTERNAL_INTENT) {
+            mDelegate.tarkZynclaveRedirectStarted();
+        }
+        // If AppAuth could not be started the redirect still never loads as a page.
         return result;
     }
 
