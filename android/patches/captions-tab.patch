+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/tark_captions_tab.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/system/sys_info.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/tark_captions_android/android/tark_captions_bridge.h"
+#include "chrome/browser/tark_captions_android/model_files.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/service_process_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr base::TimeDelta kTick = base::Seconds(1);
+constexpr char kDefaultLanguage[] = "hi";
+
+// The fastest core's top frequency (kHz), for the caption style.
+int FastestCoreKhz() {
+  int fastest = 0;
+  for (int cpu = 0; cpu < base::SysInfo::NumberOfProcessors(); ++cpu) {
+    std::string text;
+    if (base::ReadFileToString(
+            base::FilePath("/sys/devices/system/cpu/cpu" + base::NumberToString(cpu) +
+                           "/cpufreq/cpuinfo_max_freq"),
+            &text)) {
+      int khz = 0;
+      if (base::StringToInt(base::TrimWhitespaceASCII(text, base::TRIM_ALL), &khz)) {
+        fastest = std::max(fastest, khz);
+      }
+    }
+  }
+  return fastest;
+}
+
+// The files a captions process needs: the language's and common's, opened
+// read-only. Blocking.
+std::map<std::string, base::File> OpenUnit(base::FilePath unit_dir, base::FilePath common_dir,
+                                           std::string unit) {
+  std::map<std::string, base::File> files;
+  for (const auto& [dir, name] : std::vector<std::pair<base::FilePath, std::string>>{
+           {common_dir, "common"}, {unit_dir, unit}}) {
+    for (const CaptionFile* file : FilesOf(name)) {
+      base::File opened(dir.AppendASCII(file->name),
+                        base::File::FLAG_OPEN | base::File::FLAG_READ);
+      if (opened.IsValid()) {
+        files.emplace(std::string(file->name), std::move(opened));
+      }
+    }
+  }
+  return files;
+}
+
+}  // namespace
+
+TarkCaptionsTab::TarkCaptionsTab(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TarkCaptionsTab>(*web_contents) {
+  PrefService* local_state = g_browser_process->local_state();
+  const std::string language = local_state->GetString(kLanguagePref);
+  logic_.ChooseLanguage(language.empty() ? kDefaultLanguage : language);
+  CaptionDownloads::Get().AddObserver(this);
+  switches_.set_disconnect_handler(base::BindRepeating([](mojo::RemoteSetElementId) {}));
+}
+
+TarkCaptionsTab::~TarkCaptionsTab() {
+  CaptionDownloads::Get().RemoveObserver(this);
+  StopEngine();
+}
+
+// static
+void TarkCaptionsTab::BindAudio(content::RenderFrameHost* frame,
+                                mojo::PendingReceiver<mojom::CaptionAudio> receiver) {
+  content::WebContents* web_contents = content::WebContents::FromRenderFrameHost(frame);
+  if (!web_contents) {
+    return;
+  }
+  TarkCaptionsTab::CreateForWebContents(web_contents);
+  FromWebContents(web_contents)->audio_receivers_.Add(FromWebContents(web_contents),
+                                                      std::move(receiver));
+}
+
+void TarkCaptionsTab::SetCaptionsOn(bool on) {
+  logic_.SetCaptionsOn(on, base::TimeTicks::Now());
+  if (on && !UnitReady()) {
+    CaptionDownloads::Get().Request(logic_.state().language, /*now=*/false);
+  }
+  Update();
+}
+
+void TarkCaptionsTab::ChooseLanguage(const std::string& language) {
+  if (FilesOf(language).empty() || language == logic_.state().language) {
+    return;
+  }
+  g_browser_process->local_state()->SetString(kLanguagePref, language);
+  StopEngine();  // a new language is a new model
+  final_text_.clear();
+  draft_text_.clear();
+  logic_.ChooseLanguage(language);
+  logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+  if (logic_.state().captions_on && !UnitReady()) {
+    CaptionDownloads::Get().Request(language, /*now=*/false);
+  }
+  Update();
+}
+
+void TarkCaptionsTab::RequestDownload(bool now) {
+  CaptionDownloads::Get().Request(logic_.state().language, now);
+  Update();
+}
+
+void TarkCaptionsTab::HideBarForPage() {
+  bar_hidden_for_page_ = true;
+  logic_.SetCaptionsOn(false, base::TimeTicks::Now());
+  Update();
+}
+
+TarkCaptionsTab::View TarkCaptionsTab::GetView() const {
+  View view;
+  const TabCaptions::State& state = logic_.state();
+  view.bar_visible = state.bar_visible && !bar_hidden_for_page_;
+  view.captions_on = state.captions_on;
+  view.language = state.language;
+  view.unit = CaptionDownloads::Get().State(state.language);
+  view.cant_caption = state.cant_caption;
+  view.phrase = style_ == Style::kPhrase;
+  view.final_text = final_text_;
+  view.draft_text = draft_text_;
+  return view;
+}
+
+void TarkCaptionsTab::MediaStartedPlaying(const MediaPlayerInfo& info,
+                                          const content::MediaPlayerId& id) {
+  playing_[id] = info.has_audio;
+  SetPlayerAudible(id, info.has_audio && !muted_[id]);
+}
+
+void TarkCaptionsTab::MediaStoppedPlaying(const MediaPlayerInfo& info,
+                                          const content::MediaPlayerId& id,
+                                          WebContentsObserver::MediaStoppedReason reason) {
+  playing_[id] = false;
+  SetPlayerAudible(id, false);
+}
+
+void TarkCaptionsTab::MediaMutedStatusChanged(const content::MediaPlayerId& id, bool muted) {
+  muted_[id] = muted;
+  SetPlayerAudible(id, playing_[id] && !muted);
+}
+
+void TarkCaptionsTab::MediaDestroyed(const content::MediaPlayerId& id) {
+  SetPlayerAudible(id, false);
+  playing_.erase(id);
+  muted_.erase(id);
+}
+
+void TarkCaptionsTab::OnVisibilityChanged(content::Visibility visibility) {
+  logic_.OnHidden(visibility == content::Visibility::HIDDEN, base::TimeTicks::Now());
+  Update();
+}
+
+void TarkCaptionsTab::PrimaryPageChanged(content::Page& page) {
+  bar_hidden_for_page_ = false;
+  final_text_.clear();
+  draft_text_.clear();
+  Update();
+}
+
+void TarkCaptionsTab::OnUnitChanged(const std::string& unit) {
+  if (unit == logic_.state().language || unit == "common") {
+    logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+    Update();
+  }
+}
+
+void TarkCaptionsTab::Add(const std::vector<float>& mono, int32_t sample_rate) {
+  if (!logic_.ShouldForwardAudio()) {
+    return;
+  }
+  logic_.OnAudio(base::TimeTicks::Now());
+  if (service_.is_bound()) {
+    service_->AddAudio(mono, sample_rate);
+  }
+}
+
+void TarkCaptionsTab::Observe(mojo::PendingRemote<mojom::CaptionAudioSwitch> audio_switch) {
+  const mojo::RemoteSetElementId id = switches_.Add(std::move(audio_switch));
+  switches_.Get(id)->SetOn(switches_on_);
+}
+
+void TarkCaptionsTab::OnCaption(bool is_final, const std::string& text) {
+  if (is_final) {
+    final_text_ = text;
+    draft_text_.clear();
+    LOG(WARNING) << "tark captions: final " << text;
+  } else {
+    draft_text_ = text;
+  }
+  NotifyCaptionBar(web_contents());
+}
+
+int TarkCaptionsTab::PlayerKey(const content::MediaPlayerId& id) {
+  auto [it, added] = player_keys_.emplace(id, static_cast<int>(player_keys_.size()));
+  return it->second;
+}
+
+void TarkCaptionsTab::SetPlayerAudible(const content::MediaPlayerId& id, bool audible) {
+  logic_.OnPlayerAudible(PlayerKey(id), audible, base::TimeTicks::Now());
+  Update();
+}
+
+bool TarkCaptionsTab::UnitReady() const {
+  return CaptionDownloads::Get().State(logic_.state().language).state ==
+         CaptionDownloads::State::kReady;
+}
+
+void TarkCaptionsTab::Update() {
+  logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+  // Renderers send audio only while it is wanted.
+  const bool on = logic_.ShouldForwardAudio();
+  if (on != switches_on_) {
+    switches_on_ = on;
+    for (auto& audio_switch : switches_) {
+      audio_switch->SetOn(on);
+    }
+  }
+  if (logic_.WantsEngine() && !service_.is_bound()) {
+    StartEngine();
+  } else if (!logic_.WantsEngine() && service_.is_bound()) {
+    StopEngine();
+  }
+  if (logic_.state().captions_on && !tick_.IsRunning()) {
+    tick_.Start(FROM_HERE, kTick, base::BindRepeating(
+                                      [](TarkCaptionsTab* self) {
+                                        self->logic_.OnTick(base::TimeTicks::Now());
+                                        self->Update();
+                                      },
+                                      base::Unretained(this)));
+  } else if (!logic_.state().captions_on && tick_.IsRunning()) {
+    tick_.Stop();
+  }
+  NotifyCaptionBar(web_contents());
+}
+
+void TarkCaptionsTab::StartEngine() {
+  const std::string unit = logic_.state().language;
+  style_ = StyleForDevice(FastestCoreKhz(),
+                          base::SysInfo::AmountOfPhysicalMemoryMB(),
+                          g_browser_process->local_state()->GetInteger(kStylePref));
+  content::ServiceProcessHost::Launch(
+      service_.BindNewPipeAndPassReceiver(),
+      content::ServiceProcessHost::Options().WithDisplayName("Tark captions").Pass());
+  service_.set_disconnect_handler(
+      base::BindOnce(&TarkCaptionsTab::OnServiceGone, weak_factory_.GetWeakPtr()));
+  engine_unit_ = unit;
+  CaptionDownloads::Get().SetInUse(unit, true);
+  CaptionDownloads::Get().SetInUse("common", true);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&OpenUnit, CaptionDownloads::Get().UnitDir(unit),
+                     CaptionDownloads::Get().UnitDir("common"), unit),
+      base::BindOnce(&TarkCaptionsTab::OnFilesOpened, weak_factory_.GetWeakPtr(), unit));
+}
+
+void TarkCaptionsTab::OnFilesOpened(std::string unit, std::map<std::string, base::File> files) {
+  if (!service_.is_bound() || unit != engine_unit_) {
+    return;
+  }
+  base::flat_map<std::string, base::File> handles;
+  for (auto& [name, file] : files) {
+    handles.emplace(name, std::move(file));
+  }
+  auto options = mojom::CaptionOptions::New();
+  options->language = unit;
+  options->threads = 2;
+  options->phrase = style_ == Style::kPhrase;
+  client_.reset();
+  service_->Start(std::move(handles), std::move(options), client_.BindNewPipeAndPassRemote(),
+                  base::BindOnce(&TarkCaptionsTab::OnStarted, weak_factory_.GetWeakPtr()));
+}
+
+void TarkCaptionsTab::OnStarted(bool ok) {
+  LOG(WARNING) << "tark captions: engine " << (ok ? "started " : "failed ") << engine_unit_;
+  if (!ok) {
+    OnServiceGone();
+  }
+}
+
+void TarkCaptionsTab::StopEngine() {
+  if (!service_.is_bound()) {
+    return;
+  }
+  service_.reset();  // the process exits with its last remote
+  client_.reset();
+  draft_text_.clear();
+  CaptionDownloads::Get().SetInUse(engine_unit_, false);
+  CaptionDownloads::Get().SetInUse("common", false);
+  engine_unit_.clear();
+}
+
+void TarkCaptionsTab::OnServiceGone() {
+  StopEngine();
+  logic_.OnServiceGone();
+  Update();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TarkCaptionsTab);
+
+}  // namespace tark_captions
