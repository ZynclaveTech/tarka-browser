+namespace tark_captions {
+
+// Tark for Android's live captions in one tab: watches its players, takes
+// its frames' audio while captions are on, runs the captions process
+// ("Tark captions", one per captioning tab) and tells the caption bar
+// (Java, TarkCaptionsBridge) what to show. The decisions are TabCaptions'.
+class TarkCaptionsTab : public content::WebContentsObserver,
+                        public content::WebContentsUserData<TarkCaptionsTab>,
+                        public CaptionDownloads::Observer,
+                        public mojom::CaptionAudio,
+                        public mojom::CaptionClient {
+ public:
+  // What the caption bar shows.
+  struct View {
+    bool bar_visible = false;
+    bool captions_on = false;
+    std::string language;
+    CaptionDownloads::UnitState unit;
+    bool cant_caption = false;
+    bool phrase = false;      // the caption style in use
+    std::string final_text;   // the last final caption
+    std::string draft_text;   // what is being said (word by word)
+    // Translate (Phase 2a).
+    bool translate_available = false;  // 6 GB or more, another language
+    std::string target;                // "" off, "en", "hi", "ta"
+    // The first translation unit not yet on the phone (kReady when all are).
+    CaptionDownloads::UnitState translation_unit;
+    std::string translation_text;  // the last final, translated
+  };
+
+  ~TarkCaptionsTab() override;
+
+  // A frame's renderer asking to send audio (chrome_browser_interface_binders).
+  static void BindAudio(content::RenderFrameHost* frame,
+                        mojo::PendingReceiver<mojom::CaptionAudio> receiver);
+
+  void SetCaptionsOn(bool on);
+  void ChooseLanguage(const std::string& language);
+  // Translate's target ("" off); remembered for every tab.
+  void SetTarget(const std::string& target);
+  // "Download now" on mobile data, or the bar's "Try again".
+  void RequestDownload(bool now);
+  // ✕: the bar goes for this page.
+  void HideBarForPage();
+  View GetView() const;
+
+ private:
+  explicit TarkCaptionsTab(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<TarkCaptionsTab>;
+
+  // content::WebContentsObserver:
+  void MediaStartedPlaying(const MediaPlayerInfo& info, const content::MediaPlayerId& id) override;
+  void MediaStoppedPlaying(const MediaPlayerInfo& info,
+                           const content::MediaPlayerId& id,
+                           WebContentsObserver::MediaStoppedReason reason) override;
+  void MediaMutedStatusChanged(const content::MediaPlayerId& id, bool muted) override;
+  void MediaDestroyed(const content::MediaPlayerId& id) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+  void PrimaryPageChanged(content::Page& page) override;
+
+  // CaptionDownloads::Observer:
+  void OnUnitChanged(const std::string& unit) override;
+
+  // mojom::CaptionAudio:
+  void Add(const std::vector<float>& mono, int32_t sample_rate) override;
+  void Observe(mojo::PendingRemote<mojom::CaptionAudioSwitch> audio_switch) override;
+
+  // mojom::CaptionClient:
+  void OnCaption(bool is_final, const std::string& text, uint32_t caption_id) override;
+  void OnTranslation(uint32_t caption_id, const std::string& text) override;
+
+  int PlayerKey(const content::MediaPlayerId& id);
+  void SetPlayerAudible(const content::MediaPlayerId& id, bool audible);
+  // Acts on TabCaptions after any event: the renderers' switches, the
+  // captions process, the timer, the bar.
+  void Update();
+  void StartEngine();
+  void OnFilesOpened(std::string unit, std::map<std::string, base::File> files);
+  void OnStarted(bool ok);
+  void StopEngine();
+  void OnServiceGone();
+  bool UnitReady() const;
+  void CancelDownload();
+  // Translate: the units for this language and target, all on the phone.
+  std::vector<std::string> TranslationUnits() const;
+  bool TranslationReady() const;
+  void RequestTranslation();
+  void CancelTranslationDownloads();
+  // Sends the target to the running captions process when it changes.
+  void UpdateTranslation();
+  void OnTranslationFilesOpened(std::string target,
+                                std::vector<std::string> units,
+                                std::map<std::string, base::File> files);
+  void ReleaseTranslationUnits();
+  void OnTargetSet(std::string target, bool ok);
+
+  TabCaptions logic_;
+  Style style_ = Style::kPhrase;
+  std::map<content::MediaPlayerId, int> player_keys_;
+  std::map<content::MediaPlayerId, bool> playing_, muted_;
+  bool bar_hidden_for_page_ = false;
+  mojo::ReceiverSet<mojom::CaptionAudio> audio_receivers_;
+  mojo::RemoteSet<mojom::CaptionAudioSwitch> switches_;
+  bool switches_on_ = false;
+  mojo::Remote<mojom::CaptionService> service_;
+  mojo::Receiver<mojom::CaptionClient> client_{this};
+  std::string engine_unit_;  // the unit the running process holds
+  std::string final_text_, draft_text_;
+  bool engine_started_ = false;    // Start() answered true
+  std::string sent_target_;        // what the captions process translates into
+  std::vector<std::string> translation_in_use_;  // its units, held from deletion
+  uint32_t final_id_ = 0;
+  std::string translation_text_;
+  bool translation_failed_ = false;  // the process could not load the models
+  base::RepeatingTimer tick_;
+  base::WeakPtrFactory<TarkCaptionsTab> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
