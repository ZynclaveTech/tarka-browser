+constexpr base::TimeDelta kTick = base::Seconds(1);
+constexpr char kDefaultLanguage[] = "hi";
+// For android/captions/e2e/run.py only: log final captions' text.
+constexpr char kLogTextSwitch[] = "tark-captions-log-text";
+
+// The fastest core's top frequency (kHz), for the caption style.
+int FastestCoreKhz() {
+  int fastest = 0;
+  for (int cpu = 0; cpu < base::SysInfo::NumberOfProcessors(); ++cpu) {
+    std::string text;
+    if (base::ReadFileToString(
+            base::FilePath("/sys/devices/system/cpu/cpu" + base::NumberToString(cpu) +
+                           "/cpufreq/cpuinfo_max_freq"),
+            &text)) {
+      int khz = 0;
+      if (base::StringToInt(base::TrimWhitespaceASCII(text, base::TRIM_ALL), &khz)) {
+        fastest = std::max(fastest, khz);
+      }
+    }
+  }
+  return fastest;
+}
+
+// The files a captions process needs: the language's and common's, opened
+// read-only. Blocking.
+std::map<std::string, base::File> OpenUnit(base::FilePath unit_dir, base::FilePath common_dir,
+                                           std::string unit) {
+  std::map<std::string, base::File> files;
+  for (const auto& [dir, name] : std::vector<std::pair<base::FilePath, std::string>>{
+           {common_dir, "common"}, {unit_dir, unit}}) {
+    for (const CaptionFile* file : FilesOf(name)) {
+      base::File opened(dir.AppendASCII(file->name),
+                        base::File::FLAG_OPEN | base::File::FLAG_READ);
+      if (opened.IsValid()) {
+        files.emplace(std::string(file->name), std::move(opened));
+      }
+    }
+  }
+  return files;
+}
+
+// The translation units' files, keyed "<unit>/<name>", opened read-only.
+// Blocking.
+std::map<std::string, base::File> OpenTranslationUnits(
+    std::vector<std::pair<std::string, base::FilePath>> units) {
+  std::map<std::string, base::File> files;
+  for (const auto& [unit, dir] : units) {
+    for (const CaptionFile* file : FilesOf(unit)) {
+      base::File opened(dir.AppendASCII(file->name),
+                        base::File::FLAG_OPEN | base::File::FLAG_READ);
+      if (opened.IsValid()) {
+        files.emplace(unit + "/" + std::string(file->name), std::move(opened));
+      }
+    }
+  }
+  return files;
+}
+
+int RamMb() {
+  return static_cast<int>(base::SysInfo::AmountOfTotalPhysicalMemory().InMiB());
+}
+
+}  // namespace
+
+TarkCaptionsTab::TarkCaptionsTab(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TarkCaptionsTab>(*web_contents) {
+  PrefService* local_state = g_browser_process->local_state();
+  const std::string language = local_state->GetString(kLanguagePref);
+  logic_.ChooseLanguage(language.empty() ? kDefaultLanguage : language);
+  logic_.SetTarget(local_state->GetString(kTargetPref), base::TimeTicks::Now());
+  CaptionDownloads::Get().AddObserver(this);
+  switches_.set_disconnect_handler(base::BindRepeating([](mojo::RemoteSetElementId) {}));
+  // A player's connection closing: captions may follow another one.
+  audio_receivers_.set_disconnect_handler(base::BindRepeating(
+      [](TarkCaptionsTab* self) {
+        self->logic_.ForgetSource(self->audio_receivers_.current_receiver());
+      },
+      base::Unretained(this)));
+}
+
+TarkCaptionsTab::~TarkCaptionsTab() {
+  CaptionDownloads::Get().RemoveObserver(this);
+  StopEngine();
+}
+
+// static
+void TarkCaptionsTab::BindAudio(content::RenderFrameHost* frame,
+                                mojo::PendingReceiver<mojom::CaptionAudio> receiver) {
+  content::WebContents* web_contents = content::WebContents::FromRenderFrameHost(frame);
+  if (!web_contents) {
+    return;
+  }
+  TarkCaptionsTab::CreateForWebContents(web_contents);
+  FromWebContents(web_contents)->audio_receivers_.Add(FromWebContents(web_contents),
+                                                      std::move(receiver));
+}
+
+void TarkCaptionsTab::SetCaptionsOn(bool on) {
+  logic_.SetCaptionsOn(on, base::TimeTicks::Now());
+  if (on && !UnitReady()) {
+    CaptionDownloads::Get().Request(logic_.state().language, /*now=*/false);
+  }
+  if (!on) {
+    CancelDownload();
+    CancelTranslationDownloads();
+  } else {
+    RequestTranslation();
+  }
+  Update();
+}
+
+void TarkCaptionsTab::CancelDownload() {
+  // Captions off before the language arrived: its download (and any "Download
+  // now" consent to mobile data) goes too.
+  if (!UnitReady()) {
+    CaptionDownloads::Get().Cancel(logic_.state().language);
+  }
+}
+
+void TarkCaptionsTab::ChooseLanguage(const std::string& language) {
+  if (FilesOf(language).empty() || language == logic_.state().language) {
+    return;
+  }
+  g_browser_process->local_state()->SetString(kLanguagePref, language);
+  const std::string old_language = logic_.state().language;
+  const std::vector<std::string> old_units = TranslationUnits();
+  StopEngine();  // a new language is a new model
+  final_text_.clear();
+  draft_text_.clear();
+  translation_text_.clear();  // the old pair's
+  logic_.ChooseLanguage(language);
+  // Only now cancel what the old language needed: a cancel notifies at once,
+  // and while the old language was current OnUnitChanged would ask for it
+  // again. Units the new pair shares are kept.
+  CaptionDownloads& downloads = CaptionDownloads::Get();
+  if (downloads.State(old_language).state != CaptionDownloads::State::kReady) {
+    downloads.Cancel(old_language);
+  }
+  const std::vector<std::string> new_units = TranslationUnits();
+  for (const std::string& unit : old_units) {
+    if (!std::ranges::contains(new_units, unit) &&
+        downloads.State(unit).state != CaptionDownloads::State::kReady) {
+      downloads.Cancel(unit);
+    }
+  }
+  logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+  if (logic_.state().captions_on && !UnitReady()) {
+    CaptionDownloads::Get().Request(language, /*now=*/false);
+  }
+  RequestTranslation();  // the new pair's models
+  Update();
+}
+
+void TarkCaptionsTab::SetTarget(const std::string& target) {
+  if (target == logic_.state().target) {
+    return;
+  }
+  const std::vector<std::string> old_units = TranslationUnits();
+  g_browser_process->local_state()->SetString(kTargetPref, target);
+  logic_.SetTarget(target, base::TimeTicks::Now());
+  // The old pair's unfinished models, except those the new target needs
+  // (a download in progress keeps its bytes and its "Download now").
+  const std::vector<std::string> new_units = TranslationUnits();
+  for (const std::string& unit : old_units) {
+    if (!std::ranges::contains(new_units, unit) &&
+        CaptionDownloads::Get().State(unit).state != CaptionDownloads::State::kReady) {
+      CaptionDownloads::Get().Cancel(unit);
+    }
+  }
+  translation_text_.clear();
+  translation_failed_ = false;
+  if (!target.empty() && !logic_.state().captions_on) {
+    // Translate turns captions on: a translation needs a caption.
+    SetCaptionsOn(true);
+  }
+  RequestTranslation();
+  Update();
+}
+
+std::vector<std::string> TarkCaptionsTab::TranslationUnits() const {
+  if (!TranslateAvailable(RamMb(), logic_.state().language, logic_.state().target)) {
+    return {};
+  }
+  return TranslationUnitsFor(logic_.state().language, logic_.state().target);
+}
+
+bool TarkCaptionsTab::TranslationReady() const {
+  const std::vector<std::string> units = TranslationUnits();
+  return !units.empty() && std::ranges::all_of(units, [](const std::string& unit) {
+    return CaptionDownloads::Get().State(unit).state == CaptionDownloads::State::kReady;
+  });
+}
+
+void TarkCaptionsTab::RequestTranslation() {
+  if (!logic_.state().captions_on) {
+    return;
+  }
+  CaptionDownloads& downloads = CaptionDownloads::Get();
+  for (const std::string& unit : UnitsToRequest(
+           TranslationUnits(),
+           [&](const std::string& u) {
+             return downloads.State(u).state == CaptionDownloads::State::kMissing;
+           },
+           [&](const std::string& u) { return downloads.Removing(u); })) {
+    downloads.Request(unit, /*now=*/false);
+  }
+}
+
+void TarkCaptionsTab::CancelTranslationDownloads() {
+  for (const std::string& unit : TranslationUnits()) {
+    if (CaptionDownloads::Get().State(unit).state != CaptionDownloads::State::kReady) {
+      CaptionDownloads::Get().Cancel(unit);
+    }
+  }
+}
+
+void TarkCaptionsTab::RequestDownload(bool now) {
+  if (translation_failed_) {
+    // "Try again" after a translation that did not load: send it again.
+    translation_failed_ = false;
+    sent_target_.clear();
+    Update();
+    return;
+  }
+  // The card shows the translation models once the language is here.
+  if (UnitReady() && !logic_.state().target.empty() && !TranslationReady()) {
+    for (const std::string& unit : TranslationUnits()) {
+      CaptionDownloads::Get().Request(unit, now);
+    }
+  } else {
+    CaptionDownloads::Get().Request(logic_.state().language, now);
+  }
+  Update();
+}
+
+void TarkCaptionsTab::HideBarForPage() {
+  bar_hidden_for_page_ = true;
+  logic_.SetCaptionsOn(false, base::TimeTicks::Now());
+  CancelDownload();
+  CancelTranslationDownloads();
+  Update();
+}
+
+TarkCaptionsTab::View TarkCaptionsTab::GetView() const {
+  View view;
+  const TabCaptions::State& state = logic_.state();
+  view.bar_visible = state.bar_visible && !bar_hidden_for_page_;
+  view.captions_on = state.captions_on;
+  view.language = state.language;
+  view.unit = CaptionDownloads::Get().State(state.language);
+  view.cant_caption = state.cant_caption;
+  view.phrase = style_ == Style::kPhrase;
+  view.final_text = final_text_;
+  view.draft_text = draft_text_;
+  view.translate_available = TranslateAvailable(RamMb(), state.language, "");
+  view.target = state.target;
+  view.translation_unit.state = translation_failed_ ? CaptionDownloads::State::kFailed
+                                                   : CaptionDownloads::State::kReady;
+  for (const std::string& unit : TranslationUnits()) {
+    CaptionDownloads::UnitState unit_state = CaptionDownloads::Get().State(unit);
+    if (unit_state.state != CaptionDownloads::State::kReady) {
+      view.translation_unit = unit_state;
+      break;
+    }
+  }
+  view.translation_text = translation_text_;
+  return view;
+}
+
+void TarkCaptionsTab::MediaStartedPlaying(const MediaPlayerInfo& info,
+                                          const content::MediaPlayerId& id) {
+  playing_[id] = info.has_audio;
+  SetPlayerAudible(id, info.has_audio && !muted_[id]);
+}
+
+void TarkCaptionsTab::MediaStoppedPlaying(const MediaPlayerInfo& info,
+                                          const content::MediaPlayerId& id,
+                                          WebContentsObserver::MediaStoppedReason reason) {
+  playing_[id] = false;
+  SetPlayerAudible(id, false);
+}
+
+void TarkCaptionsTab::MediaMutedStatusChanged(const content::MediaPlayerId& id, bool muted) {
+  muted_[id] = muted;
+  SetPlayerAudible(id, playing_[id] && !muted);
+}
+
+void TarkCaptionsTab::MediaDestroyed(const content::MediaPlayerId& id) {
+  SetPlayerAudible(id, false);
+  playing_.erase(id);
+  muted_.erase(id);
+}
+
+void TarkCaptionsTab::OnVisibilityChanged(content::Visibility visibility) {
+  logic_.OnHidden(visibility == content::Visibility::HIDDEN, base::TimeTicks::Now());
+  Update();
+}
+
+void TarkCaptionsTab::PrimaryPageChanged(content::Page& page) {
+  bar_hidden_for_page_ = false;
+  final_text_.clear();
+  draft_text_.clear();
+  Update();
+}
+
+void TarkCaptionsTab::OnUnitChanged(const std::string& unit) {
+  // Captions on, the language never ready in this tab, and neither here nor
+  // coming (another tab cancelled it): ask again, on Wi-Fi. Not after a
+  // removal (it was ready: TabCaptions turns captions off) and not while one
+  // waits (Request would skip it and notify again).
+  if (unit == logic_.state().language && logic_.state().captions_on &&
+      !logic_.state().unit_ready && !CaptionDownloads::Get().Removing(unit) &&
+      CaptionDownloads::Get().State(unit).state == CaptionDownloads::State::kMissing) {
+    CaptionDownloads::Get().Request(unit, /*now=*/false);
+    return;  // Request notifies again
+  }
+  // A translation model deleted in Settings or cancelled by another tab:
+  // asked for again on Wi-Fi, so the card never waits without a button.
+  if (unit.starts_with("tr_") && !logic_.state().target.empty() &&
+      std::ranges::contains(TranslationUnits(), unit)) {
+    RequestTranslation();
+  }
+  if (unit == logic_.state().language || unit == "common" || unit.starts_with("tr_")) {
+    logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+    Update();
+  }
+}
+
+void TarkCaptionsTab::Add(const std::vector<float>& mono, int32_t sample_rate) {
+  if (!logic_.ShouldForwardAudio()) {
+    return;
+  }
+  const bool was_cant_caption = logic_.state().cant_caption;
+  const bool was_wanted = logic_.WantsEngine();
+  // Each player has its own connection; captions follow one of them.
+  const bool captioned =
+      logic_.OnAudio(audio_receivers_.current_receiver(), base::TimeTicks::Now());
+  if (was_cant_caption || !was_wanted) {
+    Update();  // audio came back: captions (and the model, if unloaded) again
+  }
+  if (captioned && service_.is_bound()) {
+    service_->AddAudio(mono, sample_rate);
+  }
+}
+
+void TarkCaptionsTab::Observe(mojo::PendingRemote<mojom::CaptionAudioSwitch> audio_switch) {
+  const mojo::RemoteSetElementId id = switches_.Add(std::move(audio_switch));
+  switches_.Get(id)->SetOn(switches_on_);
+}
+
+void TarkCaptionsTab::OnCaption(bool is_final, const std::string& text, uint32_t caption_id) {
+  if (is_final) {
+    final_text_ = text;
+    final_id_ = caption_id;
+    translation_text_.clear();  // until this caption's translation arrives
+    draft_text_.clear();
+    // What the person hears stays out of the log; android/captions/e2e/run.py
+    // passes --tark-captions-log-text (a debuggable device's command line).
+    if (base::CommandLine::ForCurrentProcess()->HasSwitch(kLogTextSwitch)) {
+      LOG(WARNING) << "tark captions: final " << text;
+    } else {
+      LOG(WARNING) << "tark captions: final (" << text.size() << " bytes)";
+    }
+  } else {
+    draft_text_ = text;
+  }
+  NotifyCaptionBar(web_contents());
+}
+
+void TarkCaptionsTab::OnTranslation(uint32_t caption_id, const std::string& text) {
+  if (caption_id != final_id_) {
+    return;  // a later caption is already shown
+  }
+  translation_text_ = text;
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kLogTextSwitch)) {
+    LOG(WARNING) << "tark captions: translation " << text;
+  } else {
+    LOG(WARNING) << "tark captions: translation (" << text.size() << " bytes)";
+  }
+  NotifyCaptionBar(web_contents());
+}
+
+int TarkCaptionsTab::PlayerKey(const content::MediaPlayerId& id) {
+  auto [it, added] = player_keys_.emplace(id, static_cast<int>(player_keys_.size()));
+  return it->second;
+}
+
+void TarkCaptionsTab::SetPlayerAudible(const content::MediaPlayerId& id, bool audible) {
+  logic_.OnPlayerAudible(PlayerKey(id), audible, base::TimeTicks::Now());
+  Update();
+}
+
+bool TarkCaptionsTab::UnitReady() const {
+  return CaptionDownloads::Get().State(logic_.state().language).state ==
+         CaptionDownloads::State::kReady;
+}
+
+void TarkCaptionsTab::Update() {
+  logic_.OnUnitReady(UnitReady(), base::TimeTicks::Now());
+  logic_.OnTranslationReady(TranslationReady(), base::TimeTicks::Now());
+  // Renderers send audio only while it is wanted.
+  const bool on = logic_.ShouldForwardAudio();
+  if (on != switches_on_) {
+    switches_on_ = on;
+    for (auto& audio_switch : switches_) {
+      audio_switch->SetOn(on);
+    }
+  }
+  if (logic_.WantsEngine() && !service_.is_bound()) {
+    StartEngine();
+  } else if (!logic_.WantsEngine() && service_.is_bound()) {
+    StopEngine();
+  }
+  UpdateTranslation();
+  // The timer runs while captions are on, and while a hidden tab still holds
+  // its captions process (until TabCaptions lets it go).
+  const bool tick =
+      logic_.state().captions_on &&
+      (web_contents()->GetVisibility() != content::Visibility::HIDDEN || service_.is_bound());
+  if (tick && !tick_.IsRunning()) {
+    tick_.Start(FROM_HERE, kTick, base::BindRepeating(
+                                      [](TarkCaptionsTab* self) {
+                                        self->logic_.OnTick(base::TimeTicks::Now());
+                                        self->Update();
+                                      },
+                                      base::Unretained(this)));
+  } else if (!tick && tick_.IsRunning()) {
+    tick_.Stop();
+  }
+  NotifyCaptionBar(web_contents());
+}
+
+void TarkCaptionsTab::StartEngine() {
+  const std::string unit = logic_.state().language;
+  style_ = StyleForDevice(FastestCoreKhz(),
+                          static_cast<int>(base::SysInfo::AmountOfTotalPhysicalMemory().InMiB()),
+                          g_browser_process->local_state()->GetInteger(kStylePref));
+  content::ServiceProcessHost::Launch(
+      service_.BindNewPipeAndPassReceiver(),
+      content::ServiceProcessHost::Options().WithDisplayName("Tark captions").Pass());
+  service_.set_disconnect_handler(
+      base::BindOnce(&TarkCaptionsTab::OnServiceGone, weak_factory_.GetWeakPtr()));
+  engine_unit_ = unit;
+  CaptionDownloads::Get().SetInUse(unit, true);
+  CaptionDownloads::Get().SetInUse("common", true);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&OpenUnit, CaptionDownloads::Get().UnitDir(unit),
+                     CaptionDownloads::Get().UnitDir("common"), unit),
+      base::BindOnce(&TarkCaptionsTab::OnFilesOpened, weak_factory_.GetWeakPtr(), unit));
+}
+
+void TarkCaptionsTab::OnFilesOpened(std::string unit, std::map<std::string, base::File> files) {
+  if (!service_.is_bound() || unit != engine_unit_) {
+    return;
+  }
+  base::flat_map<std::string, base::File> handles;
+  for (auto& [name, file] : files) {
+    handles.emplace(name, std::move(file));
+  }
+  auto options = mojom::CaptionOptions::New();
+  options->language = unit;
+  options->threads = 2;
+  options->phrase = style_ == Style::kPhrase;
+  client_.reset();
+  service_->Start(std::move(handles), std::move(options), client_.BindNewPipeAndPassRemote(),
+                  base::BindOnce(&TarkCaptionsTab::OnStarted, weak_factory_.GetWeakPtr()));
+}
+
+void TarkCaptionsTab::OnStarted(bool ok) {
+  LOG(WARNING) << "tark captions: engine " << (ok ? "started " : "failed ") << engine_unit_;
+  if (!ok) {
+    OnServiceGone();
+    return;
+  }
+  engine_started_ = true;
+  UpdateTranslation();
+}
+
+void TarkCaptionsTab::UpdateTranslation() {
+  if (!service_.is_bound() || !engine_started_) {
+    return;
+  }
+  const std::string want = logic_.WantsTranslation() ? logic_.state().target : std::string();
+  if (want == sent_target_ || (translation_failed_ && !want.empty())) {
+    return;
+  }
+  sent_target_ = want;
+  if (want.empty()) {
+    service_->SetTarget(std::string(), {}, base::DoNothing());
+    ReleaseTranslationUnits();
+    translation_text_.clear();
+    return;
+  }
+  std::vector<std::string> units = TranslationUnits();
+  std::vector<std::pair<std::string, base::FilePath>> dirs;
+  for (const std::string& unit : units) {
+    dirs.emplace_back(unit, CaptionDownloads::Get().UnitDir(unit));
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&OpenTranslationUnits, std::move(dirs)),
+      base::BindOnce(&TarkCaptionsTab::OnTranslationFilesOpened, weak_factory_.GetWeakPtr(), want,
+                     std::move(units)));
+}
+
+void TarkCaptionsTab::OnTranslationFilesOpened(std::string target,
+                                               std::vector<std::string> units,
+                                               std::map<std::string, base::File> files) {
+  if (!service_.is_bound() || target != sent_target_) {
+    return;  // the target changed while the files were opened
+  }
+  ReleaseTranslationUnits();
+  for (const std::string& unit : units) {
+    CaptionDownloads::Get().SetInUse(unit, true);
+  }
+  translation_in_use_ = std::move(units);
+  base::flat_map<std::string, base::File> handles;
+  for (auto& [name, file] : files) {
+    handles.emplace(name, std::move(file));
+  }
+  service_->SetTarget(target, std::move(handles),
+                      base::BindOnce(&TarkCaptionsTab::OnTargetSet, weak_factory_.GetWeakPtr(),
+                                     target));
+}
+
+void TarkCaptionsTab::OnTargetSet(std::string target, bool ok) {
+  if (ok || target != sent_target_) {
+    return;
+  }
+  // The models did not load (a file gone or damaged): the card says the
+  // translation failed, and "Try again" sends it again.
+  LOG(WARNING) << "tark captions: translation failed to load";
+  translation_failed_ = true;
+  ReleaseTranslationUnits();
+  NotifyCaptionBar(web_contents());
+}
+
+void TarkCaptionsTab::ReleaseTranslationUnits() {
+  for (const std::string& unit : translation_in_use_) {
+    CaptionDownloads::Get().SetInUse(unit, false);
+  }
+  translation_in_use_.clear();
+}
+
+void TarkCaptionsTab::StopEngine() {
+  if (!service_.is_bound()) {
+    return;
+  }
+  service_.reset();  // the process exits with its last remote
+  client_.reset();
+  draft_text_.clear();
+  engine_started_ = false;
+  sent_target_.clear();
+  translation_failed_ = false;
+  ReleaseTranslationUnits();
+  CaptionDownloads::Get().SetInUse(engine_unit_, false);
+  CaptionDownloads::Get().SetInUse("common", false);
+  engine_unit_.clear();
+}
+
+void TarkCaptionsTab::OnServiceGone() {
+  StopEngine();
+  logic_.OnServiceGone();
+  Update();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TarkCaptionsTab);
+
+}  // namespace tark_captions
