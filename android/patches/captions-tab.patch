+using base::android::JavaRef;
+using base::android::ScopedJavaLocalRef;
+
+namespace tark_captions {
+namespace {
+
+TarkCaptionsTab* TabFor(JNIEnv* env, const JavaRef<jobject>& jweb_contents) {
+  content::WebContents* web_contents = content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return nullptr;
+  }
+  TarkCaptionsTab::CreateForWebContents(web_contents);
+  return TarkCaptionsTab::FromWebContents(web_contents);
+}
+
+}  // namespace
+
+void NotifyCaptionBar(content::WebContents* web_contents) {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  Java_TarkCaptionsBridge_onStateChanged(env, web_contents->GetJavaWebContents());
+}
+
+static ScopedJavaLocalRef<jobject> JNI_TarkCaptionsBridge_GetState(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  TarkCaptionsTab* tab = TabFor(env, jweb_contents);
+  const TarkCaptionsTab::View view = tab ? tab->GetView() : TarkCaptionsTab::View();
+  return Java_TarkCaptionsBridge_createState(
+      env, view.bar_visible, view.captions_on, view.language,
+      static_cast<int32_t>(view.unit.state), view.unit.bytes, view.unit.total, view.cant_caption,
+      view.phrase, view.final_text, view.draft_text);
+}
+
+static void JNI_TarkCaptionsBridge_SetCaptionsOn(JNIEnv* env,
+                                                 const JavaRef<jobject>& jweb_contents,
+                                                 bool on) {
+  if (TarkCaptionsTab* tab = TabFor(env, jweb_contents)) {
+    tab->SetCaptionsOn(on);
+  }
+}
+
+static void JNI_TarkCaptionsBridge_ChooseLanguage(JNIEnv* env,
+                                                  const JavaRef<jobject>& jweb_contents,
+                                                  const std::string& language) {
+  if (TarkCaptionsTab* tab = TabFor(env, jweb_contents)) {
+    tab->ChooseLanguage(language);
+  }
+}
+
+static void JNI_TarkCaptionsBridge_RequestDownload(JNIEnv* env,
+                                                   const JavaRef<jobject>& jweb_contents,
+                                                   bool now) {
+  if (TarkCaptionsTab* tab = TabFor(env, jweb_contents)) {
+    tab->RequestDownload(now);
+  }
+}
+
+static void JNI_TarkCaptionsBridge_HideBar(JNIEnv* env,
+                                           const JavaRef<jobject>& jweb_contents) {
+  if (TarkCaptionsTab* tab = TabFor(env, jweb_contents)) {
+    tab->HideBarForPage();
+  }
+}
+
+static int32_t JNI_TarkCaptionsBridge_GetStyle(JNIEnv* env) {
+  return g_browser_process->local_state()->GetInteger(kStylePref);
+}
+
+static void JNI_TarkCaptionsBridge_SetStyle(JNIEnv* env, int32_t style) {
+  g_browser_process->local_state()->SetInteger(kStylePref, style);
+}
+
+static std::vector<std::string> JNI_TarkCaptionsBridge_GetReadyLanguages(JNIEnv* env) {
+  std::vector<std::string> languages;
+  for (const auto& [unit, size] : CaptionDownloads::Get().ReadyUnits()) {
+    languages.push_back(unit);
+  }
+  return languages;
+}
+
+static std::vector<int64_t> JNI_TarkCaptionsBridge_GetReadyLanguageSizes(JNIEnv* env) {
+  std::vector<int64_t> sizes;
+  for (const auto& [unit, size] : CaptionDownloads::Get().ReadyUnits()) {
+    sizes.push_back(size);
+  }
+  return sizes;
+}
+
+static void JNI_TarkCaptionsBridge_RemoveLanguage(JNIEnv* env, const std::string& language) {
+  CaptionDownloads::Get().Remove(language);
+}
+
+static int64_t JNI_TarkCaptionsBridge_GetDownloadSize(JNIEnv* env, const std::string& language) {
+  return CaptionDownloads::Get().State(language).total;
+}
+
+}  // namespace tark_captions
+
