+
+namespace content {
+class RenderFrameHost;
+}  // namespace content
+
+namespace tark_captions {
+
+// Tark for Android's live captions in one tab: watches its players, takes
+// its frames' audio while captions are on, runs the captions process
+// ("Tark captions", one per captioning tab) and tells the caption bar
+// (Java, TarkCaptionsBridge) what to show. The decisions are TabCaptions'.
+class TarkCaptionsTab : public content::WebContentsObserver,
+                        public content::WebContentsUserData<TarkCaptionsTab>,
+                        public CaptionDownloads::Observer,
+                        public mojom::CaptionAudio,
+                        public mojom::CaptionClient {
+ public:
+  // What the caption bar shows.
+  struct View {
+    bool bar_visible = false;
+    bool captions_on = false;
+    std::string language;
+    CaptionDownloads::UnitState unit;
+    bool cant_caption = false;
+    bool phrase = false;      // the caption style in use
+    std::string final_text;   // the last final caption
+    std::string draft_text;   // what is being said (word by word)
+  };
+
+  ~TarkCaptionsTab() override;
+
+  // A frame's renderer asking to send audio (chrome_browser_interface_binders).
+  static void BindAudio(content::RenderFrameHost* frame,
+                        mojo::PendingReceiver<mojom::CaptionAudio> receiver);
+
+  void SetCaptionsOn(bool on);
+  void ChooseLanguage(const std::string& language);
+  // "Download now" on mobile data, or the bar's "Try again".
+  void RequestDownload(bool now);
+  // ✕: the bar goes for this page.
+  void HideBarForPage();
+  View GetView() const;
+
+ private:
+  explicit TarkCaptionsTab(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<TarkCaptionsTab>;
+
+  // content::WebContentsObserver:
+  void MediaStartedPlaying(const MediaPlayerInfo& info, const content::MediaPlayerId& id) override;
+  void MediaStoppedPlaying(const MediaPlayerInfo& info,
+                           const content::MediaPlayerId& id,
+                           WebContentsObserver::MediaStoppedReason reason) override;
+  void MediaMutedStatusChanged(const content::MediaPlayerId& id, bool muted) override;
+  void MediaDestroyed(const content::MediaPlayerId& id) override;
