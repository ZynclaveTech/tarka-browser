+    "src/library/java/net/openid/appauth/browser/BrowserDenyList.java",
+    "src/library/java/net/openid/appauth/browser/BrowserDescriptor.java",
+    "src/library/java/net/openid/appauth/browser/BrowserMatcher.java",
+    "src/library/java/net/openid/appauth/browser/BrowserSelector.java",
