+# AppAuth for Android 0.11.1 (Apache-2.0, see README.chromium), the OAuth 2.0
+# / OpenID Connect client behind Sign in with Zynclave. src/ is put in place
+# by android/appauth/fetch.py (pinned sha256): the library's Java sources and
+# LICENSE only. Its manifest entries are in Tark's AndroidManifest.xml.
+
+import("//build/config/android/rules.gni")
+
+android_library("appauth_java") {
+  chromium_code = false
+  sources = [
