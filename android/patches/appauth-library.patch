+    "src/library/java/net/openid/appauth/AuthorizationServiceConfiguration.java",
+    "src/library/java/net/openid/appauth/AuthorizationServiceDiscovery.java",
+    "src/library/java/net/openid/appauth/ClientAuthentication.java",
+    "src/library/java/net/openid/appauth/ClientSecretBasic.java",
+    "src/library/java/net/openid/appauth/ClientSecretPost.java",
+    "src/library/java/net/openid/appauth/Clock.java",
+    "src/library/java/net/openid/appauth/CodeVerifierUtil.java",
+    "src/library/java/net/openid/appauth/EndSessionRequest.java",
+    "src/library/java/net/openid/appauth/EndSessionResponse.java",
+    "src/library/java/net/openid/appauth/GrantTypeValues.java",
+    "src/library/java/net/openid/appauth/IdToken.java",
+    "src/library/java/net/openid/appauth/JsonUtil.java",
+    "src/library/java/net/openid/appauth/NoClientAuthentication.java",
+    "src/library/java/net/openid/appauth/Preconditions.java",
+    "src/library/java/net/openid/appauth/RedirectUriReceiverActivity.java",
