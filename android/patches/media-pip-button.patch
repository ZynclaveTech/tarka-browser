+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import android.content.Context;
+import android.content.pm.PackageManager;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.tab.Tab;
+
+/**
+ * Picture in Picture from a tap: the app menu's "Picture in Picture" item and the address bar's
+ * button. Both show exactly when leaving Tark now would float the current tab's video ({@link
+ * TarkPictureInPicture#canOffer(Tab)}: a video playing with sound, Settings → Picture in Picture
+ * on), private tabs included, on a device that has Picture in Picture. A tap enters the same
+ * Picture in Picture as leaving Tark (ChromeActivity#tarkEnterPictureInPicture).
+ */
+@NullMarked
+public final class TarkPipEntryPoints {
+    private TarkPipEntryPoints() {}
+
+    /** Whether the menu item and the address-bar button show for {@code tab}. */
+    public static boolean canShow(Context context, @Nullable Tab tab) {
+        if (tab == null) return false;
+        if (!context.getPackageManager()
+                .hasSystemFeature(PackageManager.FEATURE_PICTURE_IN_PICTURE)) {
+            return false;
+        }
+        return TarkPictureInPicture.canOffer(tab);
+    }
+}
