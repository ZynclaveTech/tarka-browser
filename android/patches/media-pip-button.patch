+    private TarkPipButtonController createButtonForCurrentTab() {
+        mTabProvider.setForTesting(mTab);
+        mButton =
+                new TarkPipButtonController(
+                        mContext, mock(Drawable.class), mTabProvider, null, mEnter);
+        mButton.addObserver(mToolbar);
