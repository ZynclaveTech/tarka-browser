+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import android.content.Context;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ActivityTabProvider;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabSelectionType;
+import org.chromium.chrome.browser.toolbar.optional_button.BaseButtonDataProvider;
+import org.chromium.chrome.browser.toolbar.optional_button.ButtonData.ButtonSpec;
+import org.chromium.content_public.browser.NavigationHandle;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+import org.chromium.ui.modaldialog.ModalDialogManager;
+
+/**
+ * Tark: the address bar's Picture in Picture button (the toolbar's optional button slot, trailing
+ * the address pill). It shows while {@link TarkPipEntryPoints#canShow}, private tabs included, and
+ * a tap runs the given entry (ChromeActivity#tarkEnterPictureInPicture, the same Picture in Picture
+ * as leaving Tark).
+ *
+ * <p>It follows the current tab only: tab switches, navigations, its players starting and
+ * stopping, and what else changes whether leaving floats its video without a player starting or
+ * stopping (the page muting or unmuting, its sound starting a little after the player, a setting):
+ * {@link TarkPictureInPicture#addOfferObserver}, the signal the activity's auto-enter follows too.
+ */
+@NullMarked
+public class TarkPipButtonController extends BaseButtonDataProvider {
+    private final Context mContext;
+    private final Callback<Tab> mEnter;
+    private final ActivityTabProvider.ActivityTabTabObserver mTabObserver;
+    private final Callback<@Nullable WebContents> mOfferObserver =
+            webContents -> {
+                if (webContents == null || webContents == mObservedWebContents) recheck();
+            };
+
+    private @Nullable WebContents mObservedWebContents;
+    private @Nullable WebContentsObserver mWebContentsObserver;
+    private boolean mShowing;
+    private boolean mDestroyed;
+
+    /**
+     * @param context The context for the description.
+     * @param buttonDrawable The Picture in Picture icon (R.drawable.tark_pip_24dp).
+     * @param tabProvider The activity's current tab.
+     * @param modalDialogManager Disables the button while a dialog shows; null for none.
+     * @param enter Enters Picture in Picture for the tab (called at most once per tap).
+     */
+    public TarkPipButtonController(
+            Context context,
+            @Nullable Drawable buttonDrawable,
+            ActivityTabProvider tabProvider,
+            @Nullable ModalDialogManager modalDialogManager,
+            Callback<Tab> enter) {
+        super(
+                tabProvider,
+                modalDialogManager,
+                new ButtonSpec.Builder(
+                                buttonDrawable,
+                                context.getString(R.string.contextmenu_picture_in_picture),
+                                /* supportsTinting= */ true)
+                        .setHoverTooltipTextId(R.string.contextmenu_picture_in_picture)
+                        .build());
+        mContext = context;
+        mEnter = enter;
+        // Private tabs behave the same (spec).
+        setShouldShowOnIncognitoTabs(true);
+        mTabObserver =
+                new ActivityTabProvider.ActivityTabTabObserver(
+                        tabProvider, /* shouldTrigger= */ true) {
+                    @Override
+                    protected void onObservingDifferentTab(@Nullable Tab tab) {
+                        observeWebContents(tab);
+                        recheck();
+                    }
+
+                    @Override
+                    public void onContentChanged(Tab tab) {
+                        observeWebContents(tab);
+                        recheck();
+                    }
+
+                    @Override
+                    public void onUrlUpdated(Tab tab) {
+                        recheck();
+                    }
+
+                    @Override
+                    public void onShown(Tab tab, @TabSelectionType int type) {
+                        // Back from Settings (the Picture in Picture switch) or the window.
+                        recheck();
+                    }
+                };
+        TarkPictureInPicture.addOfferObserver(mOfferObserver);
+    }
+
+    @Override
+    protected boolean shouldShowButton(@Nullable Tab tab) {
+        if (!super.shouldShowButton(tab)) return false;
+        return TarkPipEntryPoints.canShow(mContext, tab);
+    }
+
+    @Override
+    public void onClick(View view) {
+        Tab tab = mActiveTabSupplier.get();
+        // The state may have changed since the button was drawn: check again.
+        if (!shouldShowButton(tab)) {
+            recheck();
+            return;
+        }
+        mEnter.onResult(tab);
+    }
+
+    @Override
+    public void destroy() {
+        mDestroyed = true;
+        TarkPictureInPicture.removeOfferObserver(mOfferObserver);
+        observeWebContents(null);
+        mTabObserver.destroy();
+        super.destroy();
+    }
+
+    private void observeWebContents(@Nullable Tab tab) {
+        WebContents webContents = tab != null ? tab.getWebContents() : null;
+        if (webContents == mObservedWebContents && !mDestroyed) return;
+        if (mWebContentsObserver != null) {
+            mWebContentsObserver.observe(null);
+            mWebContentsObserver = null;
+        }
+        mObservedWebContents = null;
+        if (webContents == null || mDestroyed) return;
+        mObservedWebContents = webContents;
+        TarkPictureInPicture.watch(webContents);
+        mWebContentsObserver =
+                new WebContentsObserver(webContents) {
+                    @Override
+                    public void mediaStartedPlaying(int id, boolean hasAudio, boolean hasVideo) {
+                        recheck();
+                    }
+
+                    @Override
+                    public void mediaStoppedPlaying(int id) {
+                        recheck();
+                    }
+
+                    @Override
+                    public void didFinishNavigationInPrimaryMainFrame(
+                            NavigationHandle navigationHandle) {
+                        if (navigationHandle.hasCommitted()) recheck();
+                    }
+
+                    @Override
+                    public void webContentsDestroyed() {
+                        recheck();
+                    }
+                };
+    }
+
+    /** Tells the toolbar when the button's visibility changes. */
+    private void recheck() {
+        if (mDestroyed) return;
+        boolean showing = shouldShowButton(mActiveTabSupplier.get());
+        if (showing == mShowing) return;
+        mShowing = showing;
+        notifyObservers(showing);
+    }
+}
