+    @Test
+    public void testButtonFollowsPlayback() {
+        createButtonForCurrentTab();
+        assertFalse(buttonShows());
+
+        // A player starts; the tab turns audible a little later (TarkOfferWatcher tells Java).
+        verify(mNatives).watch(mWebContents);
+        WebContentsObserver observer = webContentsObserver();
+        observer.mediaStartedPlaying(1, /* hasAudio= */ true, /* hasVideo= */ true);
+        assertFalse(buttonShows());
+        setPlayingWithSound(true);
+        TarkPictureInPicture.onOfferMayHaveChanged(mWebContents);
+        assertTrue(buttonShows());
+        verify(mToolbar).buttonDataChanged(true);
+
+        // Paused: it hides at once.
+        setPlayingWithSound(false);
+        observer.mediaStoppedPlaying(1);
+        assertFalse(buttonShows());
+        verify(mToolbar).buttonDataChanged(false);
+    }
+
+    @Test
+    public void testButtonFollowsMuteAndUnmute() {
+        setPlayingWithSound(true);
+        createButtonForCurrentTab();
+        assertTrue(buttonShows());
+
+        // The page mutes its video, which keeps playing: no player stops.
+        setPlayingWithSound(false);
+        TarkPictureInPicture.onOfferMayHaveChanged(mWebContents);
+        assertFalse(buttonShows());
+        verify(mToolbar).buttonDataChanged(false);
+
+        // Another tab's sound changing doesn't count.
+        setPlayingWithSound(true);
+        TarkPictureInPicture.onOfferMayHaveChanged(
+                mock(
+                        WebContents.class,
+                        withSettings().extraInterfaces(WebContentsObserver.Observable.class)));
+        verify(mToolbar, never()).buttonDataChanged(true);
+
+        // Unmuted.
+        TarkPictureInPicture.onOfferMayHaveChanged(mWebContents);
+        assertTrue(buttonShows());
+        verify(mToolbar).buttonDataChanged(true);
+    }
