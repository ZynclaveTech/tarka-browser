+    /** The WebContentsObserver the button put on the current tab's WebContents. */
+    private WebContentsObserver webContentsObserver() {
+        ArgumentCaptor<WebContentsObserver> captor =
+                ArgumentCaptor.forClass(WebContentsObserver.class);
+        verify((WebContentsObserver.Observable) mWebContents, atLeastOnce())
+                .addObserver(captor.capture());
+        return captor.getValue();
+    }
