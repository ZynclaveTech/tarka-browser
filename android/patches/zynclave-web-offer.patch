+
+    <TextView
+        android:id="@+id/zynclave_offer_title"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:accessibilityHeading="true"
+        android:textAppearance="@style/TextAppearance.TextLarge.Primary" />
+
+    <TextView
+        android:id="@+id/zynclave_offer_email"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="4dp"
+        android:visibility="gone"
+        android:textAppearance="@style/TextAppearance.TextMedium.Primary" />
+
+    <TextView
+        android:id="@+id/zynclave_offer_body"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="8dp"
+        android:text="@string/tark_zynclave_offer_body"
+        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="24dp"
+        android:gravity="end"
+        android:orientation="horizontal">
+
+        <org.chromium.ui.widget.ButtonCompat
+            android:id="@+id/zynclave_offer_no_thanks"
+            style="@style/TextButton"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:layout_marginEnd="8dp"
+            android:text="@string/tark_xlit_no_thanks" />
+
+        <org.chromium.ui.widget.ButtonCompat
+            android:id="@+id/zynclave_offer_sign_in"
+            style="@style/FilledButton"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="@string/tark_zynclave_offer_sign_in" />
+    </LinearLayout>
+</LinearLayout>
