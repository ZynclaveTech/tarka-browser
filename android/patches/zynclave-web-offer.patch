+        assertEquals(
+                "Sign in to Tark with your Zynclave account?", mPresenter.shown.get(0).title);
+
+        assertEquals(
+                "Sign in to Tark as s@example.com?",
+                ZynclaveWebOffer.title(
+                        RuntimeEnvironment.getApplication().getResources(), "", "s@example.com"));
+    }
+
+    @Test
+    public void testSignInTapRunsPromptNone() {
+        ZynclaveWebOffer offer = newOffer();
+        roundTrip(offer);
+        mFetcher.answer(0, new Session(ID, "Sooraj Pandey", ""));
+        Activity activity = Robolectric.buildActivity(Activity.class).get();
+        assertEquals(0, mAccount.signIns.size());
+        mPresenter.shown.get(0).choice.onSignIn(activity);
+        assertEquals(1, mAccount.signIns.size());
+        assertSame(activity, mAccount.signInActivity);
+        assertTrue(mAccount.signIns.get(0));
+        assertTrue(mStore.declined.isEmpty());
+    }
+
+    @Test
+    public void testDeclinedKeySalted() {
+        byte[] saltA = "0123456789abcdef".getBytes(StandardCharsets.US_ASCII);
+        byte[] saltB = "fedcba9876543210".getBytes(StandardCharsets.US_ASCII);
+        String a = ZynclaveWebOffer.declinedKey(ID, saltA);
+        String b = ZynclaveWebOffer.declinedKey(ID, saltB);
+        assertNotEquals(a, b);
+        assertEquals(a, ZynclaveWebOffer.declinedKey(ID, saltA));
+        assertEquals(64, a.length());
+        assertTrue(a.matches("[0-9a-f]{64}"));
+        assertFalse(a.contains(ID));
+        assertFalse(b.contains(ID));
+        assertNotEquals(a, ZynclaveWebOffer.declinedKey("other-identity", saltA));
+    }
+
+    @Test
+    public void testNoIdentityIdInPrefs() {
+        ZynclaveWebOffer.PrefsStore store = new ZynclaveWebOffer.PrefsStore();
+        ZynclaveWebOffer offer = newOffer(false, store);
+        roundTrip(offer);
+        mFetcher.answer(0, new Session(ID, "Sooraj Pandey", "s@example.com"));
+        mPresenter.shown.get(0).choice.onNoThanks();
+
+        byte[] salt = store.salt();
+        assertEquals(16, salt.length);
+        // The salt is made once and kept.
+        assertEquals(
+                new String(salt, StandardCharsets.ISO_8859_1),
+                new String(store.salt(), StandardCharsets.ISO_8859_1));
+        assertTrue(store.isDeclined(ZynclaveWebOffer.declinedKey(ID, salt)));
+
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        boolean sawDeclined = false;
+        for (Map.Entry<String, ?> entry : prefs.getAll().entrySet()) {
+            String value = String.valueOf(entry.getValue());
+            assertFalse(entry.getKey(), value.contains(ID));
+            assertFalse(entry.getKey(), value.contains("Sooraj"));
+            assertFalse(entry.getKey(), value.contains("s@example.com"));
+            if (entry.getKey().equals("tark.zynclave.declined")) sawDeclined = true;
+        }
+        assertTrue(sawDeclined);
+    }
+
+    /** Shows the sheet for {@code session} and taps Sign in. */
+    private Activity tapSignIn(Session session) {
+        ZynclaveWebOffer offer = newOffer();
+        roundTrip(offer);
+        mFetcher.answer(mFetcher.calls.size() - 1, session);
+        Activity activity = Robolectric.buildActivity(Activity.class).get();
+        mPresenter.shown.get(mPresenter.shown.size() - 1).choice.onSignIn(activity);
+        return activity;
+    }
+
+    private void assertNotWatching() {
+        ShadowLooper.idleMainLooper();
+        assertTrue(mAccount.observers.isEmpty());
+        assertTrue(mAccount.failureObservers.isEmpty());
+    }
+
+    @Test
+    public void testSheetSignInFailureShowsSnackbar() {
+        Activity activity = tapSignIn(new Session(ID, "Sooraj Pandey", "s@example.com"));
+        assertTrue(mAccount.signingIn);
+        assertEquals(0, mFailures.size());
+        mAccount.fail();
+        assertEquals(1, mFailures.size());
+        assertSame(activity, mFailures.get(0));
+        assertNotWatching();
+        // Unregistered: a later failure (from Settings, say) is not ours.
+        mAccount.fail();
+        assertEquals(1, mFailures.size());
+    }
+
+    @Test
+    public void testSheetSignInSuccessOrCancelUnregisters() {
+        tapSignIn(new Session(ID, "Sooraj Pandey", "s@example.com"));
+        mAccount.cancel();
+        assertNotWatching();
+        assertEquals(0, mFailures.size());
+
+        ZynclaveWebOffer.resetShownForTesting();
+        tapSignIn(new Session("other-identity", "Asha", ""));
+        mAccount.complete("asha@example.com");
+        assertNotWatching();
+        assertEquals(0, mFailures.size());
+        assertEquals(0, mAccount.signOuts);
+    }
+
+    @Test
+    public void testDifferentAccountSignedInIsSignedOut() {
+        tapSignIn(new Session(ID, "Sooraj Pandey", "s@example.com"));
+        mAccount.complete("mallory@example.com");
+        assertEquals(1, mAccount.signOuts);
+        assertFalse(mAccount.signedIn);
+        assertEquals(1, mFailures.size());
+        assertNotWatching();
+    }
+
+    @Test
+    public void testSameAccountStaysSignedIn() {
+        tapSignIn(new Session(ID, "Sooraj Pandey", "S@Example.com"));
+        mAccount.complete("s@example.com");
+        assertEquals(0, mAccount.signOuts);
+        assertTrue(mAccount.signedIn);
+        assertEquals(0, mFailures.size());
+
+        // Either email missing (a phone-only account): accepted.
+        assertTrue(ZynclaveWebOffer.sameAccount("", "s@example.com"));
+        assertTrue(ZynclaveWebOffer.sameAccount("s@example.com", null));
+        assertFalse(ZynclaveWebOffer.sameAccount("s@example.com", "t@example.com"));
+    }
+
+    @Test
+    public void testBidiNameStripped() {
+        String spoofed = "Sooraj\u202E\u2066 Pandey\u200F\u0007\u200B";
+        assertEquals("Sooraj Pandey", ZynclaveWebOffer.clean(spoofed, ZynclaveWebOffer.MAX_NAME));
+        assertEquals("a b c", ZynclaveWebOffer.clean("  a \n\t b\u00A0\u00A0c ", 40));
+        ZynclaveWebOffer offer = newOffer();
+        roundTrip(offer);
+        mFetcher.answer(0, new Session(ID, spoofed, "s@exa\u202Emple.com"));
+        assertEquals("Sign in to Tark as Sooraj Pandey?", mPresenter.shown.get(0).title);
+        assertEquals("s@example.com", mPresenter.shown.get(0).emailLine);
+    }
+
+    @Test
+    public void testLongNameCapped() {
+        String longName = "Sooraj Pandey " + "x".repeat(100);
+        String shown = ZynclaveWebOffer.clean(longName, ZynclaveWebOffer.MAX_NAME);
+        assertEquals(ZynclaveWebOffer.MAX_NAME, shown.codePointCount(0, shown.length()));
+        assertTrue(shown.endsWith("\u2026"));
+        assertTrue(shown.startsWith("Sooraj Pandey x"));
+        String longEmail = "a".repeat(100) + "@example.com";
+        String shownEmail = ZynclaveWebOffer.clean(longEmail, ZynclaveWebOffer.MAX_EMAIL);
+        assertEquals(ZynclaveWebOffer.MAX_EMAIL, shownEmail.length());
+        assertEquals("Sooraj", ZynclaveWebOffer.clean("Sooraj", ZynclaveWebOffer.MAX_NAME));
+    }
+
+    @Test
+    public void testEmailShownWithName() {
+        ZynclaveWebOffer offer = newOffer();
+        roundTrip(offer);
+        mFetcher.answer(0, new Session(ID, "Sooraj Pandey", "s@example.com"));
+        assertEquals("Sign in to Tark as Sooraj Pandey?", mPresenter.shown.get(0).title);
+        assertEquals("s@example.com", mPresenter.shown.get(0).emailLine);
+
+        // Email only: the title has it, no second line. Phone only: neither.
+        assertNull(ZynclaveWebOffer.emailLine("", "s@example.com"));
+        assertNull(ZynclaveWebOffer.emailLine("Sooraj", ""));
+        assertNull(ZynclaveWebOffer.emailLine(null, null));
+    }
+
+    @Test
+    public void testAttachOffTheRecordAddsNoObserver() {
+        List<String> calls = new ArrayList<>();
+        Tab tab =
+                (Tab)
+                        Proxy.newProxyInstance(
+                                Tab.class.getClassLoader(),
+                                new Class<?>[] {Tab.class},
+                                (proxy, method, args) -> {
+                                    calls.add(method.getName());
+                                    if (method.getName().equals("isOffTheRecord")) return true;
+                                    Class<?> type = method.getReturnType();
+                                    if (type == boolean.class) return false;
+                                    if (type == int.class) return 0;
+                                    if (type == long.class) return 0L;
+                                    if (type == float.class) return 0f;
+                                    return null;
+                                });
+        ZynclaveWebOffer.attach(tab);
+        assertTrue(calls.contains("isOffTheRecord"));
+        assertFalse(calls.contains("addObserver"));
+        assertFalse(calls.contains("getProfile"));
+    }
+
+    private static final class FakeFetcher implements ZynclaveWebOffer.Fetcher {
+        final List<ZynclaveWhoami.Callback> calls = new ArrayList<>();
+
+        @Override
+        public void fetch(ZynclaveWhoami.Callback callback) {
+            calls.add(callback);
+        }
+
+        void answer(int call, @Nullable Session session) {
+            calls.get(call).onResult(session);
+        }
+    }
+
+    private static final class Shown {
+        final String title;
+        final @Nullable String emailLine;
+        final ZynclaveWebOffer.Choice choice;
+
+        Shown(String title, @Nullable String emailLine, ZynclaveWebOffer.Choice choice) {
+            this.title = title;
+            this.emailLine = emailLine;
+            this.choice = choice;
+        }
+    }
+
+    private static final class FakePresenter implements ZynclaveWebOffer.Presenter {
+        final List<Shown> shown = new ArrayList<>();
+
+        @Override
+        public boolean show(
+                @Nullable String name, @Nullable String email, ZynclaveWebOffer.Choice choice) {
+            shown.add(
+                    new Shown(
+                            ZynclaveWebOffer.title(
+                                    RuntimeEnvironment.getApplication().getResources(),
+                                    name,
+                                    email),
+                            ZynclaveWebOffer.emailLine(name, email),
+                            choice));
+            return true;
+        }
+    }
+
+    /** ZynclaveAccount's order: state first, then (on failure) the failure observers. */
+    private static final class FakeAccount implements ZynclaveWebOffer.Account {
+        boolean signedInOrSigningIn;
+        boolean signingIn;
+        boolean signedIn;
+        @Nullable String email;
+        int signOuts;
+        final List<Boolean> signIns = new ArrayList<>();
+        @Nullable Activity signInActivity;
+        final List<Runnable> observers = new ArrayList<>();
+        final List<Runnable> failureObservers = new ArrayList<>();
+
+        @Override
+        public boolean isSignedInOrSigningIn() {
+            return signedInOrSigningIn || signingIn || signedIn;
+        }
+
+        @Override
+        public boolean isSigningIn() {
+            return signingIn;
+        }
+
+        @Override
+        public boolean isSignedIn() {
+            return signedIn;
+        }
+
+        @Override
+        public @Nullable String email() {
+            return email;
+        }
+
+        @Override
+        public void signIn(Activity activity, boolean promptNone) {
+            signInActivity = activity;
+            signIns.add(promptNone);
+            signingIn = true;
+            notifyState();
+        }
+
+        @Override
+        public void signOutLocally() {
+            signOuts++;
+            signedIn = false;
+            email = null;
+            notifyState();
+        }
+
+        void complete(@Nullable String userinfoEmail) {
+            signingIn = false;
+            signedIn = true;
+            email = userinfoEmail;
+            notifyState();
+        }
+
+        void cancel() {
+            signingIn = false;
+            notifyState();
+        }
+
+        void fail() {
+            signingIn = false;
+            notifyState();
+            for (Runnable r : new ArrayList<>(failureObservers)) r.run();
+        }
+
+        private void notifyState() {
+            for (Runnable r : new ArrayList<>(observers)) r.run();
+        }
+
+        @Override
+        public void addObserver(Runnable observer) {
+            observers.add(observer);
+        }
+
+        @Override
+        public void removeObserver(Runnable observer) {
+            observers.remove(observer);
+        }
+
+        @Override
+        public void addSignInFailureObserver(Runnable observer) {
+            failureObservers.add(observer);
+        }
+
+        @Override
+        public void removeSignInFailureObserver(Runnable observer) {
+            failureObservers.remove(observer);
+        }
+    }
+
+    private static final class FakeStore implements ZynclaveWebOffer.Store {
+        final Set<String> declined = new HashSet<>();
+
+        @Override
+        public byte[] salt() {
+            return "0123456789abcdef".getBytes(StandardCharsets.US_ASCII);
+        }
+
+        @Override
+        public boolean isDeclined(String key) {
+            return declined.contains(key);
+        }
+
+        @Override
+        public void decline(String key) {
+            declined.add(key);
+        }
+    }
+}
