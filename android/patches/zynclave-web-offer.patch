+#include "content/public/browser/storage_partition.h"
+#include "net/base/isolation_info.h"
+#include "net/cookies/site_for_cookies.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+#include "url/url_constants.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+constexpr base::TimeDelta kTimeout = base::Seconds(10);
+constexpr char kWhoamiPath[] = "/sessions/whoami";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_zynclave_whoami", R"(
+      semantics {
+        sender: "Tark: Sign in with Zynclave"
+        description:
+          "Asks the Zynclave Account whether the person is signed in to it on "
+          "the web in this profile, so that Tark can offer \"Sign in to Tark "
+          "as <name>?\". The name and email in the answer are shown on that "
+          "offer only; nothing is stored."
+        trigger: "Once, after a normal (not private) tab went through the "
+          "Zynclave Account's pages and then stayed on a page that is not a "
+          "sign-in screen for 3 seconds, while Tark is not signed in. Never "
+          "in private tabs, never polled."
+        data: "The profile's cookies for the Zynclave Account, sent by the "
+          "browser as for any request to that site."
+        destination: OTHER
+      }
+      policy {
+        cookies_allowed: YES
+        cookies_store: "user"
+        setting: "Choosing No thanks stops the offer for that account; "
+          "private tabs never make this request."
+        policy_exception_justification: "Tark has no enterprise policies."
+      })");
+
+void OnDownloaded(std::unique_ptr<network::SimpleURLLoader> loader,
+                  WhoamiCallback callback,
+                  std::optional<std::string> body) {
+  const network::mojom::URLResponseHead* head = loader->ResponseInfo();
+  const int status =
+      head && head->headers ? head->headers->response_code() : 0;
+  if (status != 200 || !body) {
+    std::move(callback).Run(WhoamiResult());
+    return;
+  }
+  std::move(callback).Run(ParseWhoami(*body));
+}
+
+}  // namespace
+
+void FetchWhoami(Profile* profile,
+                 const GURL& accounts_origin,
+                 WhoamiCallback callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  // Private tabs: no request at all (handoff §2a). Java attaches no observer
+  // to them either; this is the second check.
+  if (!profile || profile->IsOffTheRecord() || !accounts_origin.is_valid() ||
+      !accounts_origin.SchemeIs(url::kHttpsScheme)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), WhoamiResult()));
+    return;
+  }
+  const url::Origin origin = url::Origin::Create(accounts_origin);
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = origin.GetURL().Resolve(kWhoamiPath);
+  request->method = "GET";
+  // The browser attaches the profile's cookies for the accounts site, as a
+  // first-party request from that site would get them.
+  request->credentials_mode = network::mojom::CredentialsMode::kInclude;
+  request->site_for_cookies = net::SiteForCookies::FromOrigin(origin);
+  request->request_initiator = origin;
+  request->trusted_params = network::ResourceRequest::TrustedParams();
+  request->trusted_params->isolation_info = net::IsolationInfo::Create(
+      net::IsolationInfo::RequestType::kOther, origin, origin,
+      net::SiteForCookies::FromOrigin(origin));
+  // whoami answers in place; a redirect is not a session.
+  request->redirect_mode = network::mojom::RedirectMode::kError;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                             "application/json");
+
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetTimeoutDuration(kTimeout);
+  // A 401 is an answer, not an error to retry; its body is not read.
+  network::SimpleURLLoader* raw_loader = loader.get();
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      profile->GetDefaultStoragePartition()
+          ->GetURLLoaderFactoryForBrowserProcess();
+  raw_loader->DownloadToString(
+      factory.get(),
+      base::BindOnce(&OnDownloaded, std::move(loader), std::move(callback)),
+      kMaxWhoamiBytes);
+}
+
+}  // namespace tark_zynclave
