+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_zynclave;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+
+/**
+ * Sign in with Zynclave: whether the Zynclave Account has a web session in a profile, from the
+ * native GET /sessions/whoami in that profile's own network context (the browser sends its
+ * cookies; Tark never reads them). An off-the-record profile makes no request.
+ */
+@NullMarked
+@JNINamespace("tark_zynclave")
+public final class ZynclaveWhoami {
+    /** The web session's account, for the offer only: never stored or logged. */
+    public static final class Session {
+        public final String id;
+        public final String name;
+        public final String email;
+
+        public Session(String id, String name, String email) {
+            this.id = id;
+            this.name = name;
+            this.email = email;
+        }
+    }
+
+    /** Called on the UI thread with the session, or null when there is none. */
+    public interface Callback {
+        void onResult(@Nullable Session session);
+    }
+
+    private final Callback mCallback;
+
+    private ZynclaveWhoami(Callback callback) {
+        mCallback = callback;
+    }
+
+    /**
+     * Asks once. {@code accountsOrigin} is https://host of the Zynclave Account's pages. An
+     * off-the-record profile answers null at once, with no request (native checks again).
+     */
+    public static void fetch(Profile profile, String accountsOrigin, Callback callback) {
+        ThreadUtils.assertOnUiThread();
+        if (profile.isOffTheRecord()) {
+            callback.onResult(null);
+            return;
+        }
+        ZynclaveWhoamiJni.get().fetch(profile, accountsOrigin, new ZynclaveWhoami(callback));
+    }
+
+    @CalledByNative
+    private void onResult(
+            boolean signedIn,
+            @JniType("std::string") String id,
+            @JniType("std::string") String name,
+            @JniType("std::string") String email) {
+        mCallback.onResult(signedIn ? new Session(id, name, email) : null);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void fetch(
+                @JniType("Profile*") Profile profile,
+                @JniType("std::string") String accountsOrigin,
+                ZynclaveWhoami request);
+    }
+}
