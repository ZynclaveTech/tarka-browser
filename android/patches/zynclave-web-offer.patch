+#include <string>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tark_zynclave/whoami_fetcher.h"
+#include "url/gurl.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/tark_zynclave/android/jni_headers/ZynclaveWhoami_jni.h"
+
+using base::android::JavaRef;
+using base::android::ScopedJavaGlobalRef;
+
+namespace tark_zynclave {
+
+namespace {
+
+void Reply(const ScopedJavaGlobalRef<jobject>& request, WhoamiResult result) {
+  Java_ZynclaveWhoami_onResult(base::android::AttachCurrentThread(), request,
+                               result.signed_in, result.id, result.name,
+                               result.email);
+}
+
+}  // namespace
+
+static void JNI_ZynclaveWhoami_Fetch(JNIEnv* env,
+                                     Profile* profile,
+                                     const std::string& accounts_origin,
+                                     const JavaRef<jobject>& request) {
+  FetchWhoami(profile, GURL(accounts_origin),
+              base::BindOnce(&Reply, ScopedJavaGlobalRef<jobject>(request)));
+}
+
+}  // namespace tark_zynclave
+
+DEFINE_JNI(ZynclaveWhoami)
diff --color '--color=never' -ruN a/chrome/browser/tark_zynclave/whoami_response.cc b/chrome/browser/tark_zynclave/whoami_response.cc
--- a/chrome/browser/tark_zynclave/whoami_response.cc	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/browser/tark_zynclave/whoami_response.cc	2026-10-26 12:03:20.959168588 +0530
@@ -0,0 +1,72 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/whoami_response.h"
+
+#include <optional>
+
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+std::string NameFrom(const base::DictValue& traits) {
+  if (const std::string* name = traits.FindString("name")) {
+    return *name;
+  }
+  const base::DictValue* parts = traits.FindDict("name");
+  if (!parts) {
+    return std::string();
+  }
+  const std::string* first = parts->FindString("first");
+  const std::string* last = parts->FindString("last");
+  std::string name = first ? *first : std::string();
+  if (last && !last->empty()) {
+    if (!name.empty()) {
+      name += " ";
+    }
+    name += *last;
+  }
+  return name;
+}
+
+}  // namespace
+
+WhoamiResult ParseWhoami(std::string_view body) {
+  WhoamiResult result;
+  if (body.size() > kMaxWhoamiBytes) {
+    return result;
+  }
+  std::optional<base::DictValue> session =
+      base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+  if (!session) {
+    return result;
+  }
+  // Kratos answers 401 for no session; an inactive one is not a session
+  // either.
+  const std::optional<bool> active = session->FindBool("active");
+  if (active.has_value() && !*active) {
+    return result;
+  }
+  const base::DictValue* identity = session->FindDict("identity");
+  const std::string* id = identity ? identity->FindString("id") : nullptr;
+  if (!id || id->empty()) {
+    return result;
+  }
+  result.signed_in = true;
+  result.id = *id;
+  if (const base::DictValue* traits = identity->FindDict("traits")) {
+    result.name = std::string(base::TrimWhitespaceASCII(NameFrom(*traits),
+                                                        base::TRIM_ALL));
+    if (const std::string* email = traits->FindString("email")) {
+      result.email = *email;
+    }
+  }
+  return result;
+}
+
+}  // namespace tark_zynclave
