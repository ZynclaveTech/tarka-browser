+/** "Sign in to Tark as X?": when Tark checks the web session, and what the sheet does. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class ZynclaveWebOfferTest {
+    private static final String HOST = "accounts.zynclave.com";
+    private static final String ID = "4b7e3c1a-identity-SOORAJ";
+    private static final GURL SHODHYA = new GURL("https://shodhya.com/");
+    private static final GURL LOGIN = new GURL("https://accounts.zynclave.com/login?flow=1");
+    private static final GURL OAUTH_CONTINUE =
+            new GURL("https://accounts.zynclave.com/oauth/continue?login_challenge=2");
+    private static final GURL ACCOUNTS_HOME = new GURL("https://accounts.zynclave.com/settings");
+
+    private final FakeFetcher mFetcher = new FakeFetcher();
+    private final FakePresenter mPresenter = new FakePresenter();
+    private final FakeAccount mAccount = new FakeAccount();
+    private final FakeStore mStore = new FakeStore();
+    private final List<Activity> mFailures = new ArrayList<>();
+
+    @Before
+    public void setUp() {
+        ZynclaveWebOffer.resetShownForTesting();
+    }
+
+    private ZynclaveWebOffer newOffer() {
+        return newOffer(false, mStore);
+    }
+
+    private ZynclaveWebOffer newOffer(boolean offTheRecord, ZynclaveWebOffer.Store store) {
+        return new ZynclaveWebOffer(
+                offTheRecord, HOST, mFetcher, mPresenter, mAccount, store, mFailures::add);
+    }
+
+    /** A page committed and finished loading. */
+    private static void visit(ZynclaveWebOffer offer, GURL url) {
+        offer.onNavigationStarted();
+        offer.onNavigationCommitted(url);
+        offer.onLoadFinishedIdle(url);
+    }
+
+    private static void idle(long ms) {
+        ShadowLooper.idleMainLooper(ms, TimeUnit.MILLISECONDS);
+    }
+
+    /** Through the accounts host and back to Shodhya, then 3 s on Shodhya. */
+    private void roundTrip(ZynclaveWebOffer offer) {
+        visit(offer, SHODHYA);
+        visit(offer, LOGIN);
+        visit(offer, OAUTH_CONTINUE);
+        visit(offer, SHODHYA);
+        idle(ZynclaveWebOffer.IDLE_MS);
+    }
+
+    @Test
+    public void testIncognitoNeverFetches() {
+        assertFalse(ZynclaveWebOffer.shouldAttach(/* offTheRecord= */ true));
+        assertTrue(ZynclaveWebOffer.shouldAttach(/* offTheRecord= */ false));
+
+        // Even driven directly, as if an observer were there.
+        ZynclaveWebOffer offer = newOffer(/* offTheRecord= */ true, mStore);
+        roundTrip(offer);
+        visit(offer, ACCOUNTS_HOME);
+        idle(10_000);
+        assertEquals(0, mFetcher.calls.size());
+        assertEquals(0, mPresenter.shown.size());
+    }
+
+    @Test
+    public void testShodhyaRoundTripPromptsOnce() {
+        ZynclaveWebOffer offer = newOffer();
+        visit(offer, SHODHYA);
+        visit(offer, LOGIN);
+        visit(offer, OAUTH_CONTINUE);
+        visit(offer, SHODHYA);
+        idle(ZynclaveWebOffer.IDLE_MS - 100);
+        assertEquals(0, mFetcher.calls.size());
+        idle(100);
+        assertEquals(1, mFetcher.calls.size());
+
+        mFetcher.answer(0, new Session(ID, "Sooraj Pandey", "s@example.com"));
+        assertEquals(1, mPresenter.shown.size());
+        assertEquals("Sign in to Tark as Sooraj Pandey?", mPresenter.shown.get(0).title);
+
+        // The mark is gone: another page on Shodhya asks nothing.
+        visit(offer, SHODHYA);
+        idle(10_000);
+        assertEquals(1, mFetcher.calls.size());
+
+        // Once per account per process: another round trip asks, but shows nothing.
+        roundTrip(offer);
+        assertEquals(2, mFetcher.calls.size());
+        mFetcher.answer(1, new Session(ID, "Sooraj Pandey", "s@example.com"));
+        assertEquals(1, mPresenter.shown.size());
+    }
+
+    @Test
+    public void testSignInScreenNoFetch() {
+        ZynclaveWebOffer offer = newOffer();
