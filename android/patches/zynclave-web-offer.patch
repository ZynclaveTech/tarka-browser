+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveWebOffer.Choice;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetController;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetControllerProvider;
+import org.chromium.ui.base.WindowAndroid;
+
+/**
+ * Sign in with Zynclave: the "Sign in to Tark as X?" sheet (spec §5.6). [Sign in] [No thanks];
+ * swiping it away or Back answers neither. The name and email live only as long as the sheet.
+ */
+@NullMarked
+final class ZynclaveOfferSheet implements BottomSheetContent {
+    private final BottomSheetController mController;
+    private final Activity mActivity;
+    private final View mView;
+    private @Nullable Choice mChoice;
+
+    private ZynclaveOfferSheet(
+            Activity activity,
+            BottomSheetController controller,
+            @Nullable String name,
+            @Nullable String email,
+            Choice choice) {
+        mActivity = activity;
+        mController = controller;
+        mChoice = choice;
+        mView = LayoutInflater.from(activity).inflate(R.layout.zynclave_offer_sheet, null);
+        TextView title = mView.findViewById(R.id.zynclave_offer_title);
+        title.setText(ZynclaveWebOffer.title(activity.getResources(), name, email));
+        // The email under a name, so a name the web session made up never stands alone.
+        TextView emailLine = mView.findViewById(R.id.zynclave_offer_email);
+        String line = ZynclaveWebOffer.emailLine(name, email);
+        emailLine.setText(line);
+        emailLine.setVisibility(line == null ? View.GONE : View.VISIBLE);
+        mView.findViewById(R.id.zynclave_offer_sign_in)
+                .setOnClickListener(
+                        v -> {
+                            Choice c = mChoice;
+                            hide();
+                            if (c != null) c.onSignIn(mActivity);
+                        });
+        mView.findViewById(R.id.zynclave_offer_no_thanks)
+                .setOnClickListener(
+                        v -> {
+                            Choice c = mChoice;
+                            hide();
+                            if (c != null) c.onNoThanks();
+                        });
+    }
+
+    private void hide() {
+        mChoice = null;
+        mController.hideContent(this, /* animate= */ true);
+    }
+
+    /** Shows the sheet in a tab's activity, only while the tab is the one on screen. */
+    static final class TabPresenter implements ZynclaveWebOffer.Presenter {
+        private final Tab mTab;
+
+        TabPresenter(Tab tab) {
+            mTab = tab;
+        }
+
+        @Override
+        public boolean show(
+                @Nullable String name, @Nullable String email, Choice choice) {
+            // The tab on screen and taking input: not a background tab, not one being closed.
+            if (!mTab.isUserInteractable()) return false;
+            WindowAndroid window = mTab.getWindowAndroid();
+            if (window == null) return false;
+            Activity activity = window.getActivity().get();
+            if (activity == null || activity.isFinishing() || activity.isDestroyed()) return false;
+            BottomSheetController controller = BottomSheetControllerProvider.from(window);
+            if (controller == null
+                    || controller.getCurrentSheetContent() != null
+                    || controller.isSheetOpen()) {
+                return false;
+            }
+            return controller.requestShowContent(
+                    new ZynclaveOfferSheet(activity, controller, name, email, choice),
+                    /* animate= */ true);
+        }
+    }
+
+    @Override
+    public View getContentView() {
+        return mView;
+    }
+
+    @Override
+    public @Nullable View getToolbarView() {
+        return null;
+    }
+
+    @Override
+    public int getVerticalScrollOffset() {
+        return 0;
+    }
+
+    @Override
+    public void destroy() {
+        // Drop the name and email with the sheet.
+        mChoice = null;
+        TextView title = mView.findViewById(R.id.zynclave_offer_title);
+        title.setText(null);
+        TextView emailLine = mView.findViewById(R.id.zynclave_offer_email);
+        emailLine.setText(null);
+    }
+
+    @Override
+    public @ContentPriority int getPriority() {
+        return ContentPriority.LOW;
+    }
+
+    @Override
+    public boolean swipeToDismissEnabled() {
+        return true;
+    }
+
+    @Override
+    public int getPeekHeight() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getHalfHeightRatio() {
+        return HeightMode.DISABLED;
+    }
+
+    @Override
+    public float getFullHeightRatio() {
+        return HeightMode.WRAP_CONTENT;
+    }
+
+    @Override
+    public int getSheetHalfHeightAccessibilityStringId() {
+        return R.string.tark_zynclave_offer_title_generic;
+    }
+
+    @Override
+    public int getSheetFullHeightAccessibilityStringId() {
+        return R.string.tark_zynclave_offer_title_generic;
+    }
+
+    @Override
+    public int getSheetClosedAccessibilityStringId() {
+        return R.string.tark_zynclave_offer_closed;
+    }
+}
