@@ -0,0 +1,580 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.content.res.Resources;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.util.Base64;
+import android.widget.Toast;
+
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.ResettersForTesting;
+import org.chromium.base.ThreadUtils;
+import org.chromium.base.shared_preferences.SharedPreferencesManager;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabObserver;
+import org.chromium.chrome.browser.tark_zynclave.ZynclaveWhoami;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager.SnackbarManageable;
+import org.chromium.content_public.browser.NavigationHandle;
+import org.chromium.url.GURL;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.security.SecureRandom;
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Sign in with Zynclave (spec §5.6, handoff §2a B): "Sign in to Tark as X?" after a normal tab went
+ * through the Zynclave Account's pages.
+ *
+ * <p>Any committed navigation (or redirect) in the tab's main frame on the accounts host marks the
+ * tab. When the marked tab then finishes loading a page that is not a sign-in screen and stays on
+ * it for 3 s, the mark is cleared and the profile's web session is asked once (whoami, native, the
+ * profile's cookies). A new navigation or closing the tab cancels the wait; at most one check is in
+ * flight; nothing runs while Tark is signed in or signing in. A session shows the sheet once per
+ * account per process, never for an account the person said No thanks to, and Sign in runs the
+ * normal sign-in with prompt=none. Private tabs get no observer (TabHelpers) and the policy and
+ * native fetch refuse them as well.
+ */
+@NullMarked
+public final class ZynclaveWebOffer {
+    /** How long the page has to stay before the check. */
+    @VisibleForTesting static final long IDLE_MS = 3000;
+
+    /** The person's answer on the sheet. */
+    interface Choice {
+        void onSignIn(Activity activity);
+
+        void onNoThanks();
+    }
+
+    /** Asks the tab profile's web session once (ZynclaveWhoami in the browser). */
+    interface Fetcher {
+        void fetch(ZynclaveWhoami.Callback callback);
+    }
+
+    /** Shows the sheet; false when it can't now (another sheet, tab not current, …). */
+    interface Presenter {
+        boolean show(@Nullable String name, @Nullable String email, Choice choice);
+    }
+
+    /** The parts of ZynclaveAccount the offer uses. */
+    interface Account {
+        /** SIGNED_IN or SIGNING_IN: no check, no sheet. */
+        boolean isSignedInOrSigningIn();
+
+        boolean isSigningIn();
+
+        boolean isSignedIn();
+
+        /** The signed-in account's email (userinfo), if any. */
+        @Nullable String email();
+
+        void signIn(Activity activity, boolean promptNone);
+
+        /** Sign out of Tark only (no revoke of the web session). */
+        void signOutLocally();
+
+        void addObserver(Runnable observer);
+
+        void removeObserver(Runnable observer);
+
+        void addSignInFailureObserver(Runnable observer);
+
+        void removeSignInFailureObserver(Runnable observer);
+    }
+
+    /** Says a sign-in started from the sheet failed (the §5.3 snackbar). */
+    interface Notifier {
+        void signInFailed(Activity activity);
+    }
+
+    /** The declined accounts (salted hashes only) and the salt. */
+    interface Store {
+        byte[] salt();
+
+        boolean isDeclined(String key);
+
+        void decline(String key);
+    }
+
+    /** Longest name and email shown on the sheet, in code points (with the ellipsis). */
+    @VisibleForTesting static final int MAX_NAME = 40;
+
+    @VisibleForTesting static final int MAX_EMAIL = 64;
+
+    private static final String[] SIGN_IN_PATHS = {
+        "/login", "/registration", "/recovery", "/verification", "/error"
+    };
+
+    /** Accounts (declined keys) offered in this process: once per account per process. */
+    private static final Set<String> sShownThisProcess = new HashSet<>();
+
+    private final boolean mOffTheRecord;
+    private final String mAccountsHost;
+    private final Fetcher mFetcher;
+    private final Presenter mPresenter;
+    private final Account mAccount;
+    private final Store mStore;
+    private final Notifier mNotifier;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mCheck = this::check;
+
+    private boolean mMarked;
+    private boolean mWaiting;
+    private boolean mInFlight;
+    private boolean mDestroyed;
+
+    @VisibleForTesting
+    ZynclaveWebOffer(
+            boolean offTheRecord,
+            String accountsHost,
+            Fetcher fetcher,
+            Presenter presenter,
+            Account account,
+            Store store,
+            Notifier notifier) {
+        mOffTheRecord = offTheRecord;
+        mAccountsHost = accountsHost;
+        mFetcher = fetcher;
+        mPresenter = presenter;
+        mAccount = account;
+        mStore = store;
+        mNotifier = notifier;
+    }
+
+    /**
+     * Called by TabHelpers for every new tab: attaches the offer's observer to a normal tab, and
+     * nothing to a private one.
+     */
+    public static void attach(Tab tab) {
+        if (!shouldAttach(tab.isOffTheRecord())) return;
+        String host = ZynclaveConfig.get().accountsHost();
+        ZynclaveWebOffer offer =
+                new ZynclaveWebOffer(
+                        tab.isOffTheRecord(),
+                        host,
+                        callback ->
+                                ZynclaveWhoami.fetch(tab.getProfile(), "https://" + host, callback),
+                        new ZynclaveOfferSheet.TabPresenter(tab),
+                        new RealAccount(),
+                        new PrefsStore(),
+                        ZynclaveWebOffer::showSignInFailed);
+        tab.addObserver(offer.new Observer());
+    }
+
+    /** Whether a tab gets the observer at all: never a private (off-the-record) one. */
+    @VisibleForTesting
+    static boolean shouldAttach(boolean offTheRecord) {
+        return !offTheRecord;
+    }
+
+    /** A sign-in screen of the Zynclave Account: the sheet never shows over one. */
+    public static boolean isSignInScreen(GURL url, String accountsHost) {
+        if (!isAccountsPage(url, accountsHost)) return false;
+        String path = url.getPath();
+        if (path.equals("/oauth") || path.startsWith("/oauth/")) return true;
+        for (String screen : SIGN_IN_PATHS) {
+            if (path.equals(screen) || path.startsWith(screen + "/")) return true;
+        }
+        return false;
+    }
+
+    private static boolean isAccountsPage(GURL url, String accountsHost) {
+        return url.isValid()
+                && "https".equals(url.getScheme())
+                && accountsHost.equalsIgnoreCase(url.getHost());
+    }
+
+    /**
+     * The key kept for "No thanks": hex SHA-256 of the per-install salt and the identity id, so the
+     * id itself is never stored and the prefs can't be matched across installs.
+     */
+    public static String declinedKey(String identityId, byte[] salt) {
+        try {
+            MessageDigest digest = MessageDigest.getInstance("SHA-256");
+            digest.update(salt);
+            digest.update(identityId.getBytes(StandardCharsets.UTF_8));
+            StringBuilder hex = new StringBuilder();
+            for (byte b : digest.digest()) hex.append(String.format("%02x", b & 0xff));
+            return hex.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    /**
+     * The sheet's title: the name, else the email, else the generic question. Both come from the
+     * web session, which a page could have set (login CSRF), so they are {@link #clean}ed.
+     */
+    public static String title(Resources res, @Nullable String name, @Nullable String email) {
+        String shownName = clean(name, MAX_NAME);
+        if (!shownName.isEmpty()) {
+            return res.getString(R.string.tark_zynclave_offer_title, shownName);
+        }
+        String shownEmail = clean(email, MAX_EMAIL);
+        if (!shownEmail.isEmpty()) {
+            return res.getString(R.string.tark_zynclave_offer_title, shownEmail);
+        }
+        return res.getString(R.string.tark_zynclave_offer_title_generic);
+    }
+
+    /**
+     * The line under the title: the email whenever the title shows a name, so a made-up name never
+     * stands alone; null when the title already shows the email, or there is none.
+     */
+    public static @Nullable String emailLine(@Nullable String name, @Nullable String email) {
+        String shownEmail = clean(email, MAX_EMAIL);
+        if (shownEmail.isEmpty() || clean(name, MAX_NAME).isEmpty()) return null;
+        return shownEmail;
+    }
+
+    /**
+     * Text from the web session made safe to show: no control or format characters (Unicode Cc and
+     * Cf, which include every bidi control), whitespace runs as one space, trimmed, and at most
+     * {@code max} code points, the last an ellipsis when cut.
+     */
+    @VisibleForTesting
+    static String clean(@Nullable String text, int max) {
+        if (text == null) return "";
+        StringBuilder out = new StringBuilder();
+        boolean space = false;
+        for (int i = 0; i < text.length(); ) {
+            int c = text.codePointAt(i);
+            i += Character.charCount(c);
+            int type = Character.getType(c);
+            if (Character.isWhitespace(c) || Character.isSpaceChar(c)) {
+                space = out.length() > 0;
+                continue;
+            }
+            if (type == Character.CONTROL
+                    || type == Character.FORMAT
+                    || type == Character.UNASSIGNED
+                    || type == Character.PRIVATE_USE
+                    || type == Character.SURROGATE
+                    || isBidiControl(c)) {
+                continue;
+            }
+            if (space) out.append(' ');
+            space = false;
+            out.appendCodePoint(c);
+        }
+        String cleaned = out.toString();
+        if (cleaned.codePointCount(0, cleaned.length()) <= max) return cleaned;
+        int end = cleaned.offsetByCodePoints(0, max - 1);
+        return cleaned.substring(0, end).trim() + "\u2026";
+    }
+
+    private static boolean isBidiControl(int c) {
+        return (c >= 0x202A && c <= 0x202E)
+                || (c >= 0x2066 && c <= 0x2069)
+                || c == 0x200E
+                || c == 0x200F;
+    }
+
+    /** A main-frame navigation to a new document started: the wait ends. */
+    public void onNavigationStarted() {
+        cancelWait();
+    }
+
+    /** A main-frame redirect: a hop through the accounts host marks the tab too. */
+    public void onNavigationRedirected(GURL url) {
+        if (isAccountsPage(url, mAccountsHost)) mMarked = true;
+    }
+
+    /** A committed main-frame navigation: on the accounts host, it marks the tab. */
+    public void onNavigationCommitted(GURL url) {
+        cancelWait();
+        if (isAccountsPage(url, mAccountsHost)) mMarked = true;
+    }
+
+    /**
+     * The page {@code url} finished loading: a marked tab checks once if it stays idle for {@link
+     * #IDLE_MS}, unless the page is a sign-in screen (a later page then starts the wait).
+     */
+    public void onLoadFinishedIdle(GURL url) {
+        cancelWait();
+        if (mOffTheRecord || mDestroyed || !mMarked || mInFlight) return;
+        if (isSignInScreen(url, mAccountsHost)) return;
+        if (mAccount.isSignedInOrSigningIn()) return;
+        mWaiting = true;
+        mHandler.postDelayed(mCheck, IDLE_MS);
+    }
+
+    /** The tab closed. */
+    public void destroy() {
+        mDestroyed = true;
+        cancelWait();
+    }
+
+    private void cancelWait() {
+        if (!mWaiting) return;
+        mWaiting = false;
+        mHandler.removeCallbacks(mCheck);
+    }
+
+    private void check() {
+        mWaiting = false;
+        if (mOffTheRecord || mDestroyed || !mMarked || mInFlight) return;
+        if (mAccount.isSignedInOrSigningIn()) return;
+        // The mark is cleared before the fetch, so each accounts visit asks at most once. If the
+        // sheet then can't show (no session, declined, another sheet up, the tab gone), nothing
+        // retries: the offer waits for the next accounts visit. It never polls.
+        mMarked = false;
+        mInFlight = true;
+        mFetcher.fetch(
+                session -> {
+                    ThreadUtils.assertOnUiThread();
+                    mInFlight = false;
+                    if (session != null && !mDestroyed) offer(session);
+                });
+    }
+
+    private void offer(ZynclaveWhoami.Session session) {
+        if (mAccount.isSignedInOrSigningIn()) return;
+        String key = declinedKey(session.id, mStore.salt());
+        if (sShownThisProcess.contains(key) || mStore.isDeclined(key)) return;
+        boolean shown =
+                mPresenter.show(
+                        session.name,
+                        session.email,
+                        new Choice() {
+                            @Override
+                            public void onSignIn(Activity activity) {
+                                new SignInWatch(activity, session.email).start();
+                            }
+
+                            @Override
+                            public void onNoThanks() {
+                                mStore.decline(key);
+                            }
+                        });
+        if (shown) sShownThisProcess.add(key);
+    }
+
+    @VisibleForTesting
+    static void resetShownForTesting() {
+        sShownThisProcess.clear();
+        ResettersForTesting.register(sShownThisProcess::clear);
+    }
+
+    /**
+     * One sign-in started from the sheet, watched to its end: a failure shows the §5.3 snackbar
+     * (ZynclaveAccount shows none), and an account other than the one the sheet named (userinfo's
+     * email against whoami's, when both have one) is signed out again with the same message. The
+     * Kratos id is never compared with the OIDC sub: the sub is pairwise and never matches.
+     */
+    private final class SignInWatch {
+        private final Activity mActivity;
+        private final @Nullable String mExpectedEmail;
+        private final Runnable mStateObserver = this::onStateChanged;
+        private final Runnable mFailureObserver = this::onFailed;
+        private boolean mStarted;
+        private boolean mEnded;
+
+        SignInWatch(Activity activity, @Nullable String expectedEmail) {
+            mActivity = activity;
+            mExpectedEmail = expectedEmail;
+        }
+
+        void start() {
+            mAccount.addObserver(mStateObserver);
+            mAccount.addSignInFailureObserver(mFailureObserver);
+            mAccount.signIn(mActivity, /* promptNone= */ true);
+            mStarted = true;
+            // Signed in or signing in already: nothing of ours to watch.
+            if (!mAccount.isSigningIn()) end();
+        }
+
+        private void onStateChanged() {
+            if (mEnded || !mStarted || mAccount.isSigningIn()) return;
+            if (mAccount.isSignedIn()) {
+                end();
+                if (!sameAccount(mExpectedEmail, mAccount.email())) {
+                    mAccount.signOutLocally();
+                    mNotifier.signInFailed(mActivity);
+                }
+                return;
+            }
+            // Cancelled or failed. ZynclaveAccount resets the state before it tells the failure
+            // observers, so stop watching only after this turn.
+            mHandler.post(this::end);
+        }
+
+        private void onFailed() {
+            if (mEnded) return;
+            end();
+            mNotifier.signInFailed(mActivity);
+        }
+
+        private void end() {
+            if (mEnded) return;
+            mEnded = true;
+            mAccount.removeObserver(mStateObserver);
+            mAccount.removeSignInFailureObserver(mFailureObserver);
+        }
+    }
+
+    /** Whether the signed-in account is the one the sheet named; unknown (no email) is accepted. */
+    @VisibleForTesting
+    static boolean sameAccount(@Nullable String sheetEmail, @Nullable String signedInEmail) {
+        if (TextUtils.isEmpty(sheetEmail) || TextUtils.isEmpty(signedInEmail)) return true;
+        return sheetEmail.trim().equalsIgnoreCase(signedInEmail.trim());
+    }
+
+    /** The §5.3 message, in the tab activity's snackbar (a toast if it has none). */
+    private static void showSignInFailed(Activity activity) {
+        String text = activity.getString(R.string.tark_zynclave_sign_in_failed);
+        if (activity instanceof SnackbarManageable manageable) {
+            SnackbarManager snackbars = manageable.getSnackbarManager();
+            if (snackbars != null) {
+                snackbars.showSnackbar(
+                        Snackbar.make(
+                                text, null, Snackbar.TYPE_NOTIFICATION, Snackbar.UMA_UNKNOWN));
+                return;
+            }
+        }
+        Toast.makeText(activity.getApplicationContext(), text, Toast.LENGTH_LONG).show();
+    }
+
+    /** The tab's events, as the policy above takes them. */
+    private final class Observer implements TabObserver {
+        @Override
+        public void onDidStartNavigationInPrimaryMainFrame(Tab tab, NavigationHandle navigation) {
+            if (!navigation.isSameDocument()) onNavigationStarted();
+        }
+
+        @Override
+        public void onDidRedirectNavigation(Tab tab, NavigationHandle navigation) {
+            if (navigation.isInPrimaryMainFrame()) onNavigationRedirected(navigation.getUrl());
+        }
+
+        @Override
+        public void onDidFinishNavigationInPrimaryMainFrame(Tab tab, NavigationHandle navigation) {
+            if (!navigation.hasCommitted()) return;
+            onNavigationCommitted(navigation.getUrl());
+            // A same-document navigation (the accounts pages are a single-page app) loads
+            // nothing more: the page is already there.
+            if (navigation.isSameDocument()) onLoadFinishedIdle(navigation.getUrl());
+        }
+
+        @Override
+        public void onPageLoadFinished(Tab tab, GURL url) {
+            onLoadFinishedIdle(url);
+        }
+
+        @Override
+        public void onDestroyed(Tab tab) {
+            destroy();
+            tab.removeObserver(this);
+        }
+    }
+
+    private static final class RealAccount implements Account {
+        @Override
+        public boolean isSignedInOrSigningIn() {
+            ZynclaveAccount.State state = ZynclaveAccount.get().state();
+            return state == ZynclaveAccount.State.SIGNED_IN
+                    || state == ZynclaveAccount.State.SIGNING_IN;
+        }
+
+        @Override
+        public boolean isSigningIn() {
+            return ZynclaveAccount.get().state() == ZynclaveAccount.State.SIGNING_IN;
+        }
+
+        @Override
+        public boolean isSignedIn() {
+            return ZynclaveAccount.get().state() == ZynclaveAccount.State.SIGNED_IN;
+        }
+
+        @Override
+        public @Nullable String email() {
+            return ZynclaveAccount.get().email();
+        }
+
+        @Override
+        public void signIn(Activity activity, boolean promptNone) {
+            ZynclaveAccount.get().signIn(activity, promptNone);
+        }
+
+        @Override
+        public void signOutLocally() {
+            ZynclaveAccount.get().signOut(/* everywhere= */ false, null);
+        }
+
+        @Override
+        public void addObserver(Runnable observer) {
+            ZynclaveAccount.get().addObserver(observer);
+        }
+
+        @Override
+        public void removeObserver(Runnable observer) {
+            ZynclaveAccount.get().removeObserver(observer);
+        }
+
+        @Override
+        public void addSignInFailureObserver(Runnable observer) {
+            ZynclaveAccount.get().addSignInFailureObserver(observer);
+        }
+
+        @Override
+        public void removeSignInFailureObserver(Runnable observer) {
+            ZynclaveAccount.get().removeSignInFailureObserver(observer);
+        }
+    }
+
+    /** ChromeSharedPreferences: tark.zynclave.salt and tark.zynclave.declined (hashes only). */
+    @VisibleForTesting
+    static final class PrefsStore implements Store {
+        private static final int SALT_BYTES = 16;
+
+        @Override
+        public byte[] salt() {
+            SharedPreferencesManager prefs = ChromeSharedPreferences.getInstance();
+            @Nullable String saved = prefs.readString(ChromePreferenceKeys.TARK_ZYNCLAVE_SALT, null);
+            if (saved != null) {
+                try {
+                    byte[] salt = Base64.decode(saved, Base64.NO_WRAP);
+                    if (salt.length == SALT_BYTES) return salt;
+                } catch (IllegalArgumentException e) {
+                    // A damaged salt is replaced; earlier No thanks answers no longer match.
+                }
+            }
+            byte[] salt = new byte[SALT_BYTES];
+            new SecureRandom().nextBytes(salt);
+            prefs.writeString(
+                    ChromePreferenceKeys.TARK_ZYNCLAVE_SALT,
+                    Base64.encodeToString(salt, Base64.NO_WRAP));
+            return salt;
+        }
+
+        @Override
+        public boolean isDeclined(String key) {
+            return ChromeSharedPreferences.getInstance()
+                    .readStringSet(ChromePreferenceKeys.TARK_ZYNCLAVE_DECLINED)
+                    .contains(key);
+        }
+
+        @Override
+        public void decline(String key) {
+            ChromeSharedPreferences.getInstance()
+                    .addToStringSet(ChromePreferenceKeys.TARK_ZYNCLAVE_DECLINED, key);
+        }
+    }
+}
