+    /** The prefs the Page translation switch reads and writes (a fake in tests). */
+    interface TarkPrefs {
+        boolean getBoolean(String pref);
+
+        void setBoolean(String pref, boolean value);
+    }
+
+    private final class ProfilePrefs implements TarkPrefs {
+        @Override
+        public boolean getBoolean(String pref) {
+            return getPrefService().getBoolean(pref);
+        }
+
+        @Override
+        public void setBoolean(String pref, boolean value) {
+            getPrefService().setBoolean(pref, value);
+        }
+    }
+
+    /**
+     * Tark: Google's Translate rows (Offer to translate, the target language, always and never
+     * translate) would send pages to Google Translate, which Tark never contacts. They stay gone,
+     * with or without --translate-script-url; Tark's own Page translation switch replaces them.
+     */
+    static void hideGoogleTranslateRows(PreferenceGroup screen) {
+        for (String key : new String[] {TRANSLATION_SETTINGS_SECTION, TRANSLATE_SWITCH_KEY}) {
+            Preference row = screen.findPreference(key);
+            if (row != null) row.setVisible(false);
+        }
+    }
+
+    /**
+     * Tark: Page translation. On, pages in a language that isn't one of the person's are offered
+     * in theirs and Translate is in the menu; Tark's own model translates them on the phone.
+     */
+    static ChromeSwitchPreference createTarkPageTranslationSwitch(
+            Context context, TarkPrefs prefs) {
+        ChromeSwitchPreference pageSwitch = new ChromeSwitchPreference(context);
+        pageSwitch.setKey(TARK_PAGE_TRANSLATION_KEY);
+        // The profile's pref is the truth, not a stored copy.
+        pageSwitch.setPersistent(false);
+        pageSwitch.setTitle(R.string.tark_page_translation_title);
+        pageSwitch.setSummary(R.string.tark_page_translation_summary);
+        pageSwitch.setChecked(prefs.getBoolean(TARK_PAGE_TRANSLATION_PREF));
+        pageSwitch.setOnPreferenceChangeListener(
+                (preference, newValue) -> {
+                    prefs.setBoolean(TARK_PAGE_TRANSLATION_PREF, (boolean) newValue);
+                    return true;
+                });
+        return pageSwitch;
+    }
