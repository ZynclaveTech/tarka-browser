+package org.chromium.chrome.browser.language.settings;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceManager;
+import androidx.preference.PreferenceScreen;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.base.test.util.Features.EnableFeatures;
+import org.chromium.chrome.browser.flags.ChromeFeatureList;
+import org.chromium.chrome.browser.language.R;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** Settings › Languages › Page translation, and Google's Translate rows staying gone. */
+@RunWith(BaseRobolectricTestRunner.class)
+// LanguageSettings reads the feature in its static initializer; no native in Robolectric.
+@EnableFeatures(ChromeFeatureList.DETAILED_LANGUAGE_SETTINGS)
+public class PageTranslationSettingsTest {
+    /** The profile's prefs: a pref nobody has set reads as the browser registered it. */
+    private static final class FakePrefs implements LanguageSettings.TarkPrefs {
+        // browser_ui_prefs.cc: RegisterBooleanPref("tark.page_translation.enabled", true).
+        static final boolean REGISTERED_DEFAULT = true;
+        final Map<String, Boolean> mValues = new HashMap<>();
+
+        @Override
+        public boolean getBoolean(String pref) {
+            assertEquals(LanguageSettings.TARK_PAGE_TRANSLATION_PREF, pref);
+            Boolean value = mValues.get(pref);
+            return value == null ? REGISTERED_DEFAULT : value;
+        }
+
+        @Override
+        public void setBoolean(String pref, boolean value) {
+            mValues.put(pref, value);
+        }
+    }
+
+    private Context mContext;
+    private final FakePrefs mPrefs = new FakePrefs();
+
+    @Before
+    public void setUp() {
+        mContext = RuntimeEnvironment.getApplication();
+    }
+
+    @Test
+    public void switchDefaultsOn() {
+        assertEquals("tark.page_translation.enabled", LanguageSettings.TARK_PAGE_TRANSLATION_PREF);
+        ChromeSwitchPreference pageSwitch =
+                LanguageSettings.createTarkPageTranslationSwitch(mContext, mPrefs);
+        assertTrue(pageSwitch.isChecked());
+        assertEquals(mContext.getString(R.string.tark_page_translation_title), pageSwitch.getTitle());
+        assertEquals(
+                "Translates pages on your phone with Tark's own model. Pages never leave your"
+                        + " phone.",
+                pageSwitch.getSummary().toString());
+
+        // Turning it off is stored in the profile, and it reads back off.
+        assertTrue(pageSwitch.callChangeListener(false));
+        assertFalse(mPrefs.getBoolean(LanguageSettings.TARK_PAGE_TRANSLATION_PREF));
+        assertFalse(
+                LanguageSettings.createTarkPageTranslationSwitch(mContext, mPrefs).isChecked());
+    }
+
+    @Test
+    public void googleRowsStayHidden() {
+        PreferenceManager manager = new PreferenceManager(mContext);
+        PreferenceScreen screen = manager.createPreferenceScreen(mContext);
+        // The detailed page: the section holding Offer to translate and its advanced rows.
+        PreferenceCategory section = new PreferenceCategory(mContext);
+        section.setKey(LanguageSettings.TRANSLATION_SETTINGS_SECTION);
+        screen.addPreference(section);
+        // The basic page: the switch alone.
+        ChromeSwitchPreference googleSwitch = new ChromeSwitchPreference(mContext);
+        googleSwitch.setKey(LanguageSettings.TRANSLATE_SWITCH_KEY);
+        screen.addPreference(googleSwitch);
+        Preference languages = new Preference(mContext);
+        languages.setKey(LanguageSettings.CONTENT_LANGUAGES_KEY);
+        screen.addPreference(languages);
+
+        LanguageSettings.hideGoogleTranslateRows(screen);
+        screen.addPreference(LanguageSettings.createTarkPageTranslationSwitch(mContext, mPrefs));
+
+        assertFalse(section.isVisible());
+        assertFalse(googleSwitch.isVisible());
+        assertTrue(languages.isVisible());
+        Preference pageSwitch = screen.findPreference(LanguageSettings.TARK_PAGE_TRANSLATION_KEY);
+        assertTrue(pageSwitch != null && pageSwitch.isVisible());
+    }
+
+    @Test
+    @Config(qualifiers = "hi")
+    public void hindiStringsPresent() {
+        assertEquals("पेज का अनुवाद", mContext.getString(R.string.tark_page_translation_title));
+        assertEquals(
+                "Tark के अपने मॉडल से पेजों का अनुवाद आपके फ़ोन पर ही होता है. पेज कभी आपके फ़ोन"
+                        + " से बाहर नहीं जाते.",
+                mContext.getString(R.string.tark_page_translation_summary));
+    }
+}
