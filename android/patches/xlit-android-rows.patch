+      GURL(base::StrCat({"chrome://tark-xlit-offer/", language.tag}));
+  match.fill_into_edit = request.input.text();
+  match.contents = request.text;
+  match.contents_class.emplace_back(0, ACMatchClassification::NONE);
+  // The language's own name, which Java puts into "Type in हिन्दी?".
+  match.description = std::u16string(language.native_name);
+  match.description_class.emplace_back(0, ACMatchClassification::DIM);
+  match.allowed_to_be_default_match = false;
+  match.RecordAdditionalInfo(kOfferInfoKey, std::string(language.tag));
+  matches_.push_back(std::move(match));
