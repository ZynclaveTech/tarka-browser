+void TarkTransliterationProvider::AddOfferMatch(const Request& request) {
+  const tark_xlit::Language& language = *request.languages.front();
+  AutocompleteMatch match(this, kOfferRelevance, /*deletable=*/false,
+                          omnibox::AutocompleteMatchType::kSearchSuggest);
