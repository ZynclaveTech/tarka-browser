+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android (A3): the address bar's one offer to download the model.
+
+#include "components/tark_xlit/languages.h"
+#include "components/tark_xlit/transliterator.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_xlit {
+namespace {
+
+// The "Type in हिन्दी?" row: once, while the files are missing, never in a
+// private tab.
+TEST(TarkXlitAndroidOfferTest, ShouldOfferOnlyWhenFilesMissingAndNotAsked) {
+  EXPECT_TRUE(ShouldOffer(u"namaste", /*files_ready=*/false,
+                          OfferState::kNotAsked, /*off_the_record=*/false));
+  EXPECT_FALSE(ShouldOffer(u"namaste", /*files_ready=*/true,
+                           OfferState::kNotAsked, false));
+  EXPECT_FALSE(
+      ShouldOffer(u"namaste", false, OfferState::kAccepted, false));
+  EXPECT_FALSE(
+      ShouldOffer(u"namaste", false, OfferState::kDeclined, false));
+}
+
+TEST(TarkXlitAndroidOfferTest, ShouldOfferNeverInPrivate) {
+  EXPECT_FALSE(ShouldOffer(u"namaste", false, OfferState::kNotAsked,
+                           /*off_the_record=*/true));
+}
+
+TEST(TarkXlitAndroidOfferTest, ShouldOfferNeedsTwoLatinLetters) {
+  EXPECT_FALSE(ShouldOffer(u"n", false, OfferState::kNotAsked, false));
+  EXPECT_FALSE(ShouldOffer(u"नमस्ते", false, OfferState::kNotAsked, false));
+  EXPECT_FALSE(ShouldOffer(u"12", false, OfferState::kNotAsked, false));
+  EXPECT_TRUE(ShouldOffer(u"na", false, OfferState::kNotAsked, false));
+}
+
+TEST(TarkXlitAndroidOfferTest, OfferStateIsProcessWide) {
+  SetOfferState(OfferState::kDeclined);
+  EXPECT_EQ(GetOfferState(), OfferState::kDeclined);
+  SetOfferState(OfferState::kNotAsked);
+  EXPECT_EQ(GetOfferState(), OfferState::kNotAsked);
+}
+
+}  // namespace
+}  // namespace tark_xlit
