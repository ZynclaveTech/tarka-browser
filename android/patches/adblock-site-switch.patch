+package org.chromium.chrome.browser.page_info;
+
+import android.content.Context;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.google.android.material.materialswitch.MaterialSwitch;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.components.browser_ui.site_settings.WebsitePreferenceBridge;
+import org.chromium.components.content_settings.ContentSetting;
+import org.chromium.components.content_settings.ContentSettingsType;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+/**
+ * Tark (A2, spec §4): "Block ads on this site" in the page info sheet. On (the
+ * default) blocks ads; off allows them on this site, stored as the site's ADS
+ * content setting (ALLOW), which the ad blocker reads for every request and
+ * page. A change reloads the page.
+ */
+@NullMarked
+final class TarkAdblockSiteSwitch {
+    private TarkAdblockSiteSwitch() {}
+
+    static View create(Context context, Profile profile, WebContents webContents) {
+        GURL url = webContents.getVisibleUrl();
+        int sides = context.getResources().getDimensionPixelSize(R.dimen.page_info_popup_padding_sides);
+        int vertical =
+                context.getResources().getDimensionPixelSize(R.dimen.page_info_popup_padding_vertical);
+        float density = context.getResources().getDisplayMetrics().density;
+
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        // Aligned with the other rows' titles (icon 24dp, 8dp before, 24dp after).
+        row.setPaddingRelative(sides + Math.round(56 * density), vertical, sides, vertical);
+        row.setLayoutParams(
+                new LinearLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        TextView title = new TextView(context);
+        title.setText(R.string.tark_page_info_block_ads);
+        title.setTextAppearance(R.style.TextAppearance_TextLarge_Primary);
+        row.addView(title, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
+
+        MaterialSwitch toggle = new MaterialSwitch(context);
+        toggle.setChecked(
+                WebsitePreferenceBridge.getContentSetting(
+                                profile, ContentSettingsType.ADS, url, url)
+                        != ContentSetting.ALLOW);
+        toggle.setContentDescription(context.getString(R.string.tark_page_info_block_ads));
+        toggle.setOnCheckedChangeListener(
+                (button, checked) -> {
+                    WebsitePreferenceBridge.setContentSettingDefaultScope(
+                            profile,
+                            ContentSettingsType.ADS,
+                            url,
+                            url,
+                            checked ? ContentSetting.DEFAULT : ContentSetting.ALLOW);
+                    webContents.getNavigationController().reload(true);
+                });
+        row.addView(toggle);
+        row.setOnClickListener(v -> toggle.toggle());
+        return row;
+    }
+}
