+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android's live captions: a frame's media audio, from the
+// renderer to its tab's captions in the browser, only while the person has
+// captions on in that tab.
+module tark_captions.mojom;
+
+// The browser's side, one per frame.
+interface CaptionAudio {
+  // Mono audio at `sample_rate`, about 100 ms at a time.
+  Add(array<float> mono, int32 sample_rate);
+  // The renderer listens for whether to send audio at all.
+  Observe(pending_remote<CaptionAudioSwitch> audio_switch);
+};
+
+// The renderer's side.
+interface CaptionAudioSwitch {
+  // Captions on in this tab (and the model ready, the tab shown): send
+  // audio; off: send nothing.
+  SetOn(bool on);
+};
