+namespace tark_captions {
+
+// Tark for Android's live captions: Chromium's speech-recognition hook in
+// the media player (AudioRendererImpl) hands each decoded buffer here; it
+// goes to the browser as mono audio in ~100 ms batches, only while the
+// browser says captions are on in this tab. Nothing is recognised here.
+class TarkCaptionsAudioClient : public media::SpeechRecognitionClient,
+                                public mojom::CaptionAudioSwitch {
+ public:
+  explicit TarkCaptionsAudioClient(content::RenderFrame* render_frame);
+  TarkCaptionsAudioClient(const TarkCaptionsAudioClient&) = delete;
+  TarkCaptionsAudioClient& operator=(const TarkCaptionsAudioClient&) = delete;
+  ~TarkCaptionsAudioClient() override;
+
+  // media::SpeechRecognitionClient:
+  void AddAudio(scoped_refptr<media::AudioBuffer> buffer,
+                std::optional<base::TimeDelta> media_start_pts) override;
+  void AddAudio(const media::AudioBus& audio_bus) override;
+  bool IsSpeechRecognitionAvailable() override;
+  void SetOnReadyCallback(OnReadyCallback callback) override;
+  void Reconfigure(const media::AudioParameters& audio_parameters) override;
+
+  // mojom::CaptionAudioSwitch:
+  void SetOn(bool on) override;
+
+ private:
+  mojo::SharedRemote<mojom::CaptionAudio> audio_;
+  mojo::Receiver<mojom::CaptionAudioSwitch> switch_{this};
+  std::atomic<bool> on_{false};
+  // Buffered on the media thread (AddAudio's).
+  std::vector<float> batch_;
+  int batch_rate_ = 0;
+};
+
+}  // namespace tark_captions
