+
+namespace tark_captions {
+
+TarkCaptionsAudioClient::TarkCaptionsAudioClient(content::RenderFrame* render_frame) {
+  mojo::PendingRemote<mojom::CaptionAudio> audio;
+  render_frame->GetBrowserInterfaceBroker().GetInterface(
+      audio.InitWithNewPipeAndPassReceiver());
+  audio_ = mojo::SharedRemote<mojom::CaptionAudio>(std::move(audio));
+  audio_->Observe(switch_.BindNewPipeAndPassRemote());
+}
+
+TarkCaptionsAudioClient::~TarkCaptionsAudioClient() = default;
+
+void TarkCaptionsAudioClient::AddAudio(scoped_refptr<media::AudioBuffer> buffer,
+                                       std::optional<base::TimeDelta> media_start_pts) {
+  if (!on_.load(std::memory_order_relaxed) || !buffer || buffer->end_of_stream()) {
+    batch_.clear();
+    return;
+  }
+  const int rate = buffer->sample_rate();
+  if (rate != batch_rate_) {
+    batch_.clear();
+    batch_rate_ = rate;
+  }
+  const int channels = buffer->channel_count();
+  const int frames = buffer->frame_count();
+  std::unique_ptr<media::AudioBus> bus = media::AudioBus::Create(channels, frames);
+  buffer->ReadFrames(frames, 0, 0, bus.get());
+  for (int i = 0; i < frames; ++i) {
+    float sum = 0;
+    for (int c = 0; c < channels; ++c) {
+      sum += bus->channel(c)[i];
+    }
+    batch_.push_back(sum / channels);
+  }
+  if (static_cast<int>(batch_.size()) >= rate / 10) {
+    audio_->Add(std::move(batch_), rate);
+    batch_ = std::vector<float>();
+  }
+}
+
+void TarkCaptionsAudioClient::AddAudio(const media::AudioBus& audio_bus) {
+  // Web Audio and calls: Phase 2.
+}
+
+bool TarkCaptionsAudioClient::IsSpeechRecognitionAvailable() {
+  return true;
+}
+
+void TarkCaptionsAudioClient::SetOnReadyCallback(OnReadyCallback callback) {
+  // Ready at once: whether audio is sent is the browser's switch.
+  std::move(callback).Run();
+}
+
+void TarkCaptionsAudioClient::Reconfigure(const media::AudioParameters& audio_parameters) {}
+
+void TarkCaptionsAudioClient::SetOn(bool on) {
+  on_.store(on, std::memory_order_relaxed);
+}
+
+}  // namespace tark_captions
