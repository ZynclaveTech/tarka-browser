+    // Tark: the Mac's Settings header (spec §13): the summary line, then tiles
+    // that open the rows below. A tile opens its row as a tap on the row would:
+    // the row's own listener, else the fragment.
+    private static final String[] TARK_TILE_KEYS = {
+        "search_engine", "privacy", "appearance", "passwords",
+        "content_settings", "languages", "downloads", "about_chrome"
+    };
+
+    private void addTarkHeader() {
+        mTarkHeader = new TarkHeaderPreference(getPreferenceManager().getContext());
+        mTarkHeader.setKey("tark_header");
+        mTarkHeader.setOrder(-1);
+        mTarkHeader.setSelectable(false);
+        mTarkHeader.setTitle(R.string.tark_settings_summary_title);
+        mTarkHeader.setSummary(R.string.tark_settings_summary_detail);
+        getPreferenceScreen().addPreference(mTarkHeader);
+    }
+
+    private class TarkHeaderPreference extends Preference {
+        TarkHeaderPreference(Context context) {
+            super(context);
+        }
+
+        void refresh() {
+            notifyChanged();
+        }
+
+        @Override
+        public void onBindViewHolder(PreferenceViewHolder holder) {
+            super.onBindViewHolder(holder);
+            if (!(holder.itemView instanceof ViewGroup root)) return;
+            Context context = root.getContext();
+            root.removeAllViews();
+            root.setPaddingRelative(tarkDp(context, 12), 0, tarkDp(context, 12), 0);
+            LinearLayout column = new LinearLayout(context);
+            column.setOrientation(LinearLayout.VERTICAL);
+            // No padding below: the first section heading brings its own space.
+            column.setPadding(0, tarkDp(context, 8), 0, 0);
+
+            SpannableStringBuilder line = new SpannableStringBuilder();
+            line.append(context.getString(R.string.tark_settings_summary_title));
+            line.setSpan(new StyleSpan(Typeface.BOLD), 0, line.length(), 0);
+            line.append(' ').append(context.getString(R.string.tark_settings_summary_detail));
+            TextView summary = new TextView(context);
+            summary.setText(line);
+            summary.setTextColor(MaterialColors.getColor(context, R.attr.colorOnSurface, 0));
+            summary.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+            int pad = tarkDp(context, 12);
+            summary.setPadding(pad, pad, pad, pad);
+            GradientDrawable outline = new GradientDrawable();
+            outline.setCornerRadius(tarkDp(context, 12));
+            outline.setStroke(
+                    tarkDp(context, 1), MaterialColors.getColor(context, R.attr.colorPrimary, 0));
+            summary.setBackground(outline);
+            LinearLayout.LayoutParams summaryParams =
+                    new LinearLayout.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT);
+            summaryParams.setMargins(tarkDp(context, 4), 0, tarkDp(context, 4), tarkDp(context, 8));
+            column.addView(summary, summaryParams);
+
+            LinearLayout row = null;
+            int count = 0;
+            for (String key : TARK_TILE_KEYS) {
+                Preference target = findPreference(key);
+                if (target == null || !target.isVisible()) continue;
+                if (count % 2 == 0) {
+                    row = new LinearLayout(context);
+                    row.setOrientation(LinearLayout.HORIZONTAL);
+                    row.setBaselineAligned(false);
+                    column.addView(row);
+                }
+                // Tiles in a row share its height.
+                LinearLayout.LayoutParams params =
+                        new LinearLayout.LayoutParams(
+                                0, ViewGroup.LayoutParams.MATCH_PARENT, 1f);
+                int margin = tarkDp(context, 4);
+                params.setMargins(margin, margin, margin, margin);
+                assumeNonNull(row).addView(buildTarkTile(context, target), params);
+                count++;
+            }
+            root.addView(
+                    column,
+                    new ViewGroup.LayoutParams(
+                            ViewGroup.LayoutParams.MATCH_PARENT,
+                            ViewGroup.LayoutParams.WRAP_CONTENT));
+        }
+    }
+
+    private View buildTarkTile(Context context, Preference row) {
+        LinearLayout tile = new LinearLayout(context);
+        tile.setOrientation(LinearLayout.VERTICAL);
+        tile.setPadding(
+                tarkDp(context, 12), tarkDp(context, 10), tarkDp(context, 12), tarkDp(context, 10));
+        tile.setMinimumHeight(tarkDp(context, 64));
+        tile.setGravity(Gravity.CENTER_VERTICAL);
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(tarkDp(context, 14));
+        background.setColor(
+                MaterialColors.getColor(context, R.attr.colorSurfaceContainerHigh, 0));
+        background.setStroke(
+                tarkDp(context, 1), MaterialColors.getColor(context, R.attr.colorOutlineVariant, 0));
+        tile.setBackground(background);
+
+        TextView title = new TextView(context);
+        title.setText(row.getTitle());
+        title.setTextColor(MaterialColors.getColor(context, R.attr.colorOnSurface, 0));
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        title.setTypeface(Typeface.DEFAULT_BOLD);
+        tile.addView(title);
+        CharSequence state = row.getSummary();
+        if (!TextUtils.isEmpty(state)) {
+            TextView stateView = new TextView(context);
+            stateView.setText(state);
+            stateView.setTextColor(
+                    MaterialColors.getColor(context, R.attr.colorOnSurfaceVariant, 0));
+            stateView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+            stateView.setMaxLines(1);
+            stateView.setEllipsize(TextUtils.TruncateAt.END);
+            tile.addView(stateView);
+        }
+        tile.setContentDescription(row.getTitle());
+        tile.setOnClickListener(v -> openTarkRow(row));
+        return tile;
+    }
+
+    private void openTarkRow(Preference row) {
+        Preference.OnPreferenceClickListener listener = row.getOnPreferenceClickListener();
+        if (listener != null && listener.onPreferenceClick(row)) return;
+        onPreferenceTreeClick(row);
+    }
+
+    private static int tarkDp(Context context, int dp) {
+        return Math.round(dp * context.getResources().getDisplayMetrics().density);
+    }
