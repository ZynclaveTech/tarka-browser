+std::optional<std::vector<std::pair<std::string, int>>> ReadVocab(const ModelSource& source,
+                                                                   std::string_view name) {
+  std::optional<base::span<const uint8_t>> bytes = source.Read(name);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  if (auto entries = ParseFlatVocab(base::as_string_view(*bytes))) {
+    return entries;
+  }
+  std::optional<base::DictValue> dict = ReadJsonDict(source, name);
+  if (!dict) {
+    return std::nullopt;
+  }
+  std::vector<std::pair<std::string, int>> entries;
+  entries.reserve(dict->size());
+  for (const auto [key, value] : *dict) {
+    if (!value.is_int()) {
+      return std::nullopt;
+    }
+    entries.emplace_back(key, value.GetInt());
+  }
+  return entries;
+}
