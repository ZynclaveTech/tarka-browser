+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/tark_captions/page_translator.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+
+namespace tark_captions {
+
+namespace {
+
+constexpr char kIndicToEnglish[] = "tr_indic_en";
+constexpr char kEnglishToIndic[] = "tr_en_indic";
+constexpr char kSpanishToEnglish[] = "tr_es_en";
+
+// The 22 scheduled languages IndicTrans2 covers.
+bool IsIndian(std::string_view code) {
+  static constexpr std::string_view kIndian[] = {
+      "as", "bn", "brx", "doi", "gu",  "hi", "kn", "ks", "kok", "mai", "ml",
+      "mni", "mr", "ne", "or",  "pa", "sa",  "sat", "sd", "ta", "te",  "ur"};
+  return std::ranges::contains(kIndian, code);
+}
+
+// The leg's translation: null when the model fails or gives nothing.
+std::optional<std::string> Checked(std::optional<std::string> text) {
+  if (!text || text->empty()) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+// Captions' translator holds every model the batch needs.
+// A page text's sentences, each with what ends it: after ".", "?" or "!"
+// followed by white space, after a danda or double danda, or at a line break.
+// "3.5" and "e.g.x" stay whole.
+std::vector<std::string_view> Sentences(std::string_view text) {
+  std::vector<std::string_view> sentences;
+  size_t start = 0;
+  for (size_t i = 0; i < text.size(); ++i) {
+    size_t end = 0;  // one past the sentence's end
+    const char c = text[i];
+    if (c == '\n') {
+      end = i + 1;
+    } else if (c == '.' || c == '?' || c == '!') {
+      if (i + 1 == text.size() || text[i + 1] == ' ' || text[i + 1] == '\n' ||
+          text[i + 1] == '\t') {
+        end = i + 1;
+      }
+    } else if (text.substr(i, 3) == "\xE0\xA5\xA4" || text.substr(i, 3) == "\xE0\xA5\xA5") {
+      end = i + 3;  // । ॥
+    }
+    if (end) {
+      sentences.push_back(text.substr(start, end - start));
+      start = end;
+      i = end - 1;
+    }
+  }
+  if (start < text.size()) {
+    sentences.push_back(text.substr(start));
+  }
+  return sentences;
+}
+
+// A page text goes to the model a sentence at a time, as captions do: the
+// models read at most 255 source tokens and write at most 128, so a whole
+// paragraph was cut short, and each decoder step costs more the longer the
+// output, so it was also many times slower than its sentences. Any sentence
+// that fails keeps the whole text original.
+std::optional<std::string> TranslateText(Translator* translator,
+                                         std::string_view text,
+                                         std::string_view source,
+                                         std::string_view target) {
+  std::string joined;
+  for (std::string_view sentence : Sentences(text)) {
+    const std::string_view trimmed = base::TrimWhitespaceASCII(sentence, base::TRIM_ALL);
+    if (trimmed.empty()) {
+      continue;
+    }
+    std::optional<std::string> done = Checked(translator->Translate(trimmed, source, target));
+    if (!done) {
+      return std::nullopt;
+    }
+    if (!joined.empty()) {
+      joined += ' ';
+    }
+    joined += *done;
+  }
+  return Checked(std::move(joined));
+}
+
+size_t Chars(const std::vector<std::string>& texts) {
+  size_t chars = 0;
+  for (const std::string& text : texts) {
+    chars += text.size();
+  }
+  return chars;
+}
+
+// Diagnostics for the phone (logcat "tark-page"): one line per batch.
+void LogBatch(const char* how, size_t count, size_t chars, base::TimeTicks start) {
+  LOG(WARNING) << "tark-page: service batch " << how << " items=" << count
+               << " bytes=" << chars << " ms=" << (base::TimeTicks::Now() - start).InMilliseconds();
+}
+
+PageResults TranslateShared(Translator* translator,
+                            const std::string& source,
+                            const std::string& target,
+                            std::vector<std::string> texts) {
+  const base::TimeTicks start = base::TimeTicks::Now();
+  PageResults results;
+  results.reserve(texts.size());
+  for (const std::string& text : texts) {
+    results.push_back(TranslateText(translator, text, source, target));
+  }
+  LogBatch("shared", texts.size(), Chars(texts), start);
+  return results;
+}
+
+}  // namespace
+
+std::vector<PageLeg> PageLegsFor(std::string_view source, std::string_view target) {
+  std::vector<PageLeg> legs;
+  if (source == target) {
+    return legs;
+  }
+  const std::string to_english = source == "es"     ? kSpanishToEnglish
+                                 : IsIndian(source) ? kIndicToEnglish
+                                                    : "";
+  if (source != "en") {
+    if (to_english.empty()) {
+      return {};
+    }
+    legs.push_back({to_english, std::string(source), "en"});
+  }
+  if (target != "en") {
+    if (!IsIndian(target)) {
+      return {};
+    }
+    legs.push_back({kEnglishToIndic, "en", std::string(target)});
+  }
+  return legs;
+}
+
+struct PageTranslator::Slot {
+  explicit Slot(TranslatorFactory factory) : factory(std::move(factory)) {}
+  TranslatorFactory factory;
+  std::string unit;  // what `translator` was made from
+  std::unique_ptr<Translator> translator;
+};
+
+struct PageTranslator::Batch {
+  std::string source;
+  std::string target;
+  std::vector<PageLeg> legs;
+  std::map<std::string, base::File> files;
+  std::vector<std::string> texts;
+  PageBatchCallback callback;
+  uint64_t owner = 0;
+};
+
+namespace {
+
+// `slot` holds `unit`'s model afterwards, made from `files` unless it held
+// it already; the previous model is unloaded first. False if a file is
+// missing or the model can't be made.
+bool Load(PageTranslator::Slot* slot,
+          const std::string& unit,
+          std::map<std::string, base::File>& files) {
+  if (slot->translator && slot->unit == unit) {
+    return true;
+  }
+  slot->translator.reset();  // never two models at once
+  slot->unit.clear();
+  std::map<std::string, base::File> unit_files;
+  for (const std::string& name : CaptionSession::TranslationFiles()) {
+    auto it = files.find(unit + "/" + name);
+    if (it == files.end() || !it->second.IsValid()) {
+      return false;
+    }
+    unit_files.emplace(it->first, std::move(it->second));
+  }
+  slot->translator = slot->factory.Run(std::move(unit_files));
+  if (!slot->translator) {
+    return false;
+  }
+  slot->unit = unit;
+  return true;
+}
+
+// The page's own model slot, one leg (one model) at a time.
+PageResults TranslateOwn(PageTranslator::Slot* slot,
+                         std::vector<PageLeg> legs,
+                         std::map<std::string, base::File> files,
+                         std::vector<std::string> texts) {
+  const base::TimeTicks start = base::TimeTicks::Now();
+  PageResults results(texts.begin(), texts.end());
+  for (const PageLeg& leg : legs) {
+    const base::TimeTicks load_start = base::TimeTicks::Now();
+    const bool had = slot->translator && slot->unit == leg.unit;
+    if (!Load(slot, leg.unit, files)) {
+      return PageResults(texts.size());
+    }
+    if (!had) {
+      LOG(WARNING) << "tark-page: service made translator " << leg.unit << " ms="
+                   << (base::TimeTicks::Now() - load_start).InMilliseconds();
+    }
+    for (std::optional<std::string>& text : results) {
+      if (text) {
+        text = TranslateText(slot->translator.get(), *text, leg.source, leg.target);
+      }
+    }
+  }
+  LogBatch("own", texts.size(), Chars(texts), start);
+  return results;
+}
+
+}  // namespace
+
+PageTranslator::PageTranslator(CaptionSession* session, TranslatorFactory factory)
+    : session_(session),
+      runner_(session->translation_runner()),
+      slot_(new Slot(std::move(factory)), base::OnTaskRunnerDeleter(runner_)) {
+  session_->SetTranslationChangedCallback(base::BindRepeating(
+      &PageTranslator::OnCaptionsTranslationChanged, weak_factory_.GetWeakPtr()));
+}
+
+PageTranslator::~PageTranslator() {
+  session_->SetTranslationChangedCallback(base::RepeatingClosure());
+}
+
+void PageTranslator::TranslateBatch(const std::string& source,
+                                    const std::string& target,
+                                    std::map<std::string, base::File> files,
+                                    std::vector<std::string> texts,
+                                    PageBatchCallback callback,
+                                    uint64_t owner) {
+  auto batch = std::make_unique<Batch>();
+  batch->owner = owner;
+  batch->source = source;
+  batch->target = target;
+  batch->legs = PageLegsFor(source, target);
+  batch->files = std::move(files);
+  batch->texts = std::move(texts);
+  batch->callback = std::move(callback);
+  queue_.push_back(std::move(batch));
+  Pump();
+}
+
+void PageTranslator::DropBatches(uint64_t owner) {
+  // The front batch is running when `running_`: it stays until it is done.
+  auto first = queue_.begin() + (running_ ? 1 : 0);
+  queue_.erase(std::remove_if(first, queue_.end(),
+                              [owner](const std::unique_ptr<Batch>& batch) {
+                                return batch->owner == owner;
+                              }),
+               queue_.end());
+  Pump();
+}
+
+void PageTranslator::ReleaseModel() {
+  DropOwnModel();
+}
+
+void PageTranslator::OnCaptionsTranslationChanged() {
+  if (!session_->translation_units().empty()) {
+    DropOwnModel();  // captions win; queued before any caption translates
+  }
+  Pump();
+}
+
+void PageTranslator::DropOwnModel() {
+  runner_->PostTask(FROM_HERE, base::BindOnce(
+                                   [](Slot* slot) {
+                                     slot->translator.reset();
+                                     slot->unit.clear();
+                                   },
+                                   base::Unretained(slot_.get())));
+}
+
+void PageTranslator::Pump() {
+  while (!running_ && !queue_.empty()) {
+    Batch& batch = *queue_.front();
+    if (batch.legs.empty()) {  // no model for the pair: originals stay
+      std::unique_ptr<Batch> done = std::move(queue_.front());
+      queue_.pop_front();
+      std::move(done->callback).Run(PageResults(done->texts.size()));
+      continue;
+    }
+    const std::set<std::string>& held = session_->translation_units();
+    if (!held.empty()) {
+      for (const PageLeg& leg : batch.legs) {
+        if (!held.contains(leg.unit)) {
+          return;  // captions hold another model: wait for them
+        }
+      }
+      running_ = true;
+      // The translator is deleted on the translation sequence, after this.
+      runner_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(&TranslateShared, base::Unretained(session_->shared_translator()),
+                         batch.source, batch.target, std::move(batch.texts)),
+          base::BindOnce(&PageTranslator::OnBatchDone, weak_factory_.GetWeakPtr()));
+      return;
+    }
+    running_ = true;
+    // The slot is deleted on the translation sequence, after this.
+    runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&TranslateOwn, base::Unretained(slot_.get()), batch.legs,
+                       std::move(batch.files), std::move(batch.texts)),
+        base::BindOnce(&PageTranslator::OnBatchDone, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void PageTranslator::OnBatchDone(PageResults results) {
+  running_ = false;
+  std::unique_ptr<Batch> done = std::move(queue_.front());
+  queue_.pop_front();
+  std::move(done->callback).Run(std::move(results));
+  Pump();
+}
+
+}  // namespace tark_captions
