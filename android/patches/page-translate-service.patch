+#define COMPONENTS_TARK_CAPTIONS_FLAT_VOCAB_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_util.h"
+
+namespace tark_captions {
+
+// A flat JSON object of string keys and int32 values, {"token": id, ...}, as
+// IndicTrans2's and opus-mt's dict.SRC.json and dict.TGT.json are: its
+// entries in file order, in one pass. base::JSONReader builds a
+// base::DictValue, a sorted flat_map that moves the entries after each new
+// key: those files list their keys by id, not in key order, so
+// dict.SRC.json's 122,706 keys took about 3.6 billion element moves (18.7 s
+// on a Snapdragon 695, Tark for Android round 11).
+// Nullopt for anything else (another value type, a number that is not an
+// int32, a bad escape, invalid UTF-8, trailing text): the caller then uses
+// base::JSONReader, so a file never loads differently, only faster.
+inline std::optional<std::vector<std::pair<std::string, int>>> ParseFlatVocab(
+    std::string_view json) {
+  size_t i = 0;
+  const size_t n = json.size();
+  auto skip_space = [&] {
+    while (i < n && (json[i] == ' ' || json[i] == '\n' || json[i] == '\r' || json[i] == '\t')) {
+      ++i;
+    }
+  };
+  auto hex4 = [&](uint32_t* out) {
+    if (n - i < 4) {
+      return false;
+    }
+    uint32_t v = 0;
+    for (int k = 0; k < 4; ++k) {
+      const char c = json[i++];
+      v <<= 4;
+      if (c >= '0' && c <= '9') {
+        v |= static_cast<uint32_t>(c - '0');
+      } else if (c >= 'a' && c <= 'f') {
+        v |= static_cast<uint32_t>(c - 'a' + 10);
+      } else if (c >= 'A' && c <= 'F') {
+        v |= static_cast<uint32_t>(c - 'A' + 10);
+      } else {
+        return false;
+      }
+    }
+    *out = v;
+    return true;
+  };
+  auto append_utf8 = [](uint32_t cp, std::string* s) {
+    if (cp < 0x80) {
+      s->push_back(static_cast<char>(cp));
+    } else if (cp < 0x800) {
+      s->push_back(static_cast<char>(0xC0 | (cp >> 6)));
+      s->push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    } else if (cp < 0x10000) {
+      s->push_back(static_cast<char>(0xE0 | (cp >> 12)));
+      s->push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+      s->push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    } else {
+      s->push_back(static_cast<char>(0xF0 | (cp >> 18)));
+      s->push_back(static_cast<char>(0x80 | ((cp >> 12) & 0x3F)));
+      s->push_back(static_cast<char>(0x80 | ((cp >> 6) & 0x3F)));
+      s->push_back(static_cast<char>(0x80 | (cp & 0x3F)));
+    }
+  };
+  auto read_string = [&](std::string* s) {
+    if (i >= n || json[i] != '"') {
+      return false;
+    }
+    ++i;
+    s->clear();
+    while (i < n) {
+      const unsigned char c = static_cast<unsigned char>(json[i]);
+      if (c == '"') {
+        ++i;
+        return true;
+      }
+      if (c < 0x20) {
+        return false;
+      }
+      if (c != '\\') {
+        // A run of plain bytes at once.
+        size_t end = i + 1;
+        while (end < n && json[end] != '"' && json[end] != '\\' &&
+               static_cast<unsigned char>(json[end]) >= 0x20) {
+          ++end;
+        }
+        s->append(json.substr(i, end - i));
+        i = end;
+        continue;
+      }
+      if (++i >= n) {
+        return false;
+      }
+      const char e = json[i++];
+      switch (e) {
+        case '"':
+          s->push_back('"');
+          break;
+        case '\\':
+          s->push_back('\\');
+          break;
+        case '/':
+          s->push_back('/');
+          break;
+        case 'b':
+          s->push_back('\b');
+          break;
+        case 'f':
+          s->push_back('\f');
+          break;
+        case 'n':
+          s->push_back('\n');
+          break;
+        case 'r':
+          s->push_back('\r');
+          break;
+        case 't':
+          s->push_back('\t');
+          break;
+        case 'u': {
+          uint32_t cp = 0;
+          if (!hex4(&cp)) {
+            return false;
+          }
+          if (cp >= 0xD800 && cp <= 0xDBFF) {  // a high surrogate: its low half follows
+            uint32_t low = 0;
+            if (n - i < 2 || json[i] != '\\' || json[i + 1] != 'u') {
+              return false;
+            }
+            i += 2;
+            if (!hex4(&low) || low < 0xDC00 || low > 0xDFFF) {
+              return false;
+            }
+            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
+          } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
+            return false;  // a lone low surrogate
+          }
+          append_utf8(cp, s);
+          break;
+        }
+        default:
+          return false;
+      }
+    }
+    return false;  // no closing quote
+  };
+  auto read_int = [&](int* out) {
+    bool negative = false;
+    if (i < n && json[i] == '-') {
+      negative = true;
+      ++i;
+    }
+    if (i >= n || json[i] < '0' || json[i] > '9') {
+      return false;
+    }
+    if (json[i] == '0' && i + 1 < n && json[i + 1] >= '0' && json[i + 1] <= '9') {
+      return false;  // a leading zero is not JSON
+    }
+    int64_t v = 0;
+    while (i < n && json[i] >= '0' && json[i] <= '9') {
+      v = v * 10 + (json[i] - '0');
+      if (v > int64_t{2147483648}) {
+        return false;
+      }
+      ++i;
+    }
+    if (i < n && (json[i] == '.' || json[i] == 'e' || json[i] == 'E')) {
+      return false;  // a double: base::JSONReader's int check decides
+    }
+    v = negative ? -v : v;
+    if (v > int64_t{2147483647} || v < -int64_t{2147483648}) {
+      return false;
+    }
+    *out = static_cast<int>(v);
+    return true;
+  };
+
+  std::vector<std::pair<std::string, int>> entries;
+  skip_space();
+  if (i >= n || json[i] != '{') {
+    return std::nullopt;
+  }
+  ++i;
+  skip_space();
+  if (i < n && json[i] == '}') {
+    ++i;
+  } else {
+    std::string key;
+    for (;;) {
+      skip_space();
+      if (!read_string(&key)) {
+        return std::nullopt;
+      }
+      skip_space();
+      if (i >= n || json[i] != ':') {
+        return std::nullopt;
+      }
+      ++i;
+      skip_space();
+      int value = 0;
+      if (!read_int(&value) || !base::IsStringUTF8(key)) {
+        return std::nullopt;
+      }
+      entries.emplace_back(std::move(key), value);
+      skip_space();
+      if (i < n && json[i] == ',') {
+        ++i;
+        continue;
+      }
+      if (i < n && json[i] == '}') {
+        ++i;
+        break;
+      }
+      return std::nullopt;
+    }
+  }
+  skip_space();
+  if (i != n) {
+    return std::nullopt;
+  }
+  return entries;
+}
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_FLAT_VOCAB_H_
