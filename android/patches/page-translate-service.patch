+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/lock.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "chrome/services/tark_captions/caption_session.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+// What every fake translator saw, from any sequence. A model counts as
+// loaded from its first Translate (as TranslationEngine loads on first use)
+// until the translator is deleted.
+struct Models {
+  base::Lock lock;
+  int loaded = 0;
+  int most_loaded = 0;
+  int made = 0;
+  std::vector<std::string> events;  // "load:<unit>", "unload:<unit>"
+  std::vector<std::string> received;
+  std::string fail;   // this text comes back nullopt
+  std::string blank;  // this text comes back ""
+};
+
+class FakeTranslator : public Translator {
+ public:
+  FakeTranslator(Models* models, std::string unit) : models_(models), unit_(std::move(unit)) {
+    base::AutoLock hold(models_->lock);
+    ++models_->made;
+  }
+  ~FakeTranslator() override {
+    base::AutoLock hold(models_->lock);
+    if (loaded_) {
+      --models_->loaded;
+      models_->events.push_back("unload:" + unit_);
+    }
+  }
+  std::optional<std::string> Translate(std::string_view text,
+                                       std::string_view source,
+                                       std::string_view target) override {
+    base::AutoLock hold(models_->lock);
+    if (!loaded_) {
+      loaded_ = true;
+      ++models_->loaded;
+      models_->most_loaded = std::max(models_->most_loaded, models_->loaded);
+      EXPECT_LE(models_->loaded, 1) << "two models at once";
+      models_->events.push_back("load:" + unit_);
+    }
+    models_->received.emplace_back(text);
+    if (text == models_->fail) {
+      return std::nullopt;
+    }
+    if (text == models_->blank) {
+      return "";
+    }
+    return std::string(target) + ":" + std::string(text);
+  }
+
+ private:
+  raw_ptr<Models> models_;
+  std::string unit_;
+  bool loaded_ = false;
+};
+
+class PageTranslatorTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  TranslatorFactory Factory() {
+    return base::BindRepeating(
+        [](Models* models, std::map<std::string, base::File> files) -> std::unique_ptr<Translator> {
+          std::string units;
+          for (const auto& [name, file] : files) {
+            const std::string unit = name.substr(0, name.find('/'));
+            if (units.find(unit) == std::string::npos) {
+              units += (units.empty() ? "" : "+") + unit;
+            }
+          }
+          return std::make_unique<FakeTranslator>(models, units);
+        },
+        base::Unretained(&models_));
+  }
+
+  // The six files of each translation unit, keyed "<unit>/<name>".
+  std::map<std::string, base::File> Units(const std::vector<std::string>& units) {
+    std::map<std::string, base::File> files;
+    for (const std::string& unit : units) {
+      for (const std::string& name : CaptionSession::TranslationFiles()) {
+        const base::FilePath path = dir_.GetPath().AppendASCII(unit + "/" + name);
+        EXPECT_TRUE(base::CreateDirectory(path.DirName()));
+        EXPECT_TRUE(base::WriteFile(path, "x"));
+        files.emplace(unit + "/" + name,
+                      base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+      }
+    }
+    return files;
+  }
+
+  PageResults Translate(PageTranslator& page,
+                        const std::string& source,
+                        const std::string& target,
+                        const std::vector<std::string>& units,
+                        std::vector<std::string> texts) {
+    base::test::TestFuture<PageResults> done;
+    page.TranslateBatch(source, target, Units(units), std::move(texts), done.GetCallback());
+    return done.Take();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir dir_;
+  Models models_;
+  CaptionSession session_{base::BindRepeating(
+                              [](std::map<std::string, base::File>, const EngineOptions&,
+                                 CaptionCallback) -> std::unique_ptr<SpeechEngine> {
+                                return nullptr;
+                              }),
+                          Factory()};
+};
+
+// hi → ta goes through English: Indian → English loads, translates and
+// unloads before English → Indian loads.
+TEST_F(PageTranslatorTest, IndianToIndianUsesOneModelAtATime) {
+  PageTranslator page(&session_, Factory());
+  const PageResults results =
+      Translate(page, "hi", "ta", {"tr_indic_en", "tr_en_indic"}, {"नमस्ते", "धन्यवाद"});
+  EXPECT_EQ(results, (PageResults{"ta:en:नमस्ते", "ta:en:धन्यवाद"}));
+  base::AutoLock hold(models_.lock);
+  EXPECT_EQ(models_.events, (std::vector<std::string>{"load:tr_indic_en", "unload:tr_indic_en",
+                                                     "load:tr_en_indic"}));
+  EXPECT_EQ(models_.most_loaded, 1);
+}
+
+TEST_F(PageTranslatorTest, FailedSentenceIsNull) {
+  models_.fail = "दो";
+  PageTranslator page(&session_, Factory());
+  const PageResults results = Translate(page, "hi", "en", {"tr_indic_en"}, {"एक", "दो", "तीन"});
+  EXPECT_EQ(results, (PageResults{"en:एक", std::nullopt, "en:तीन"}));
+}
+
+TEST_F(PageTranslatorTest, EmptyOutputIsNull) {
+  models_.blank = "एक";
+  PageTranslator page(&session_, Factory());
+  const PageResults results = Translate(page, "hi", "en", {"tr_indic_en"}, {"एक"});
+  EXPECT_EQ(results, (PageResults{std::nullopt}));
+}
+
+// A sentence mixing scripts is one sentence: it is not split by script.
+TEST_F(PageTranslatorTest, MixedScriptSentenceSentWhole) {
+  PageTranslator page(&session_, Factory());
+  Translate(page, "hi", "en", {"tr_indic_en"}, {"मेरा iPhone नया है"});
+  base::AutoLock hold(models_.lock);
+  EXPECT_EQ(models_.received, (std::vector<std::string>{"मेरा iPhone नया है"}));
+}
+
+// Captions' Translate holds Indian → English and the page asks hi → en: the
+// page uses captions' model, with no second load.
+TEST_F(PageTranslatorTest, SameDirectionAsCaptionsShares) {
+  ASSERT_TRUE(session_.SetTarget("en", Units({"tr_indic_en"})));
+  PageTranslator page(&session_, Factory());
+  const PageResults results = Translate(page, "hi", "en", {"tr_indic_en"}, {"नमस्ते"});
+  EXPECT_EQ(results, (PageResults{"en:नमस्ते"}));
+  base::AutoLock hold(models_.lock);
+  EXPECT_EQ(models_.made, 1);  // captions' translator only
+  EXPECT_EQ(models_.events, (std::vector<std::string>{"load:tr_indic_en"}));
+}
+
+// Captions hold Indian → English and the page asks en → hi: captions win,
+// and the batch completes only once captions' Translate goes off.
+TEST_F(PageTranslatorTest, DifferentModelThanCaptionsWaits) {
+  ASSERT_TRUE(session_.SetTarget("en", Units({"tr_indic_en"})));
+  PageTranslator page(&session_, Factory());
+  base::test::TestFuture<PageResults> done;
+  page.TranslateBatch("en", "hi", Units({"tr_en_indic"}), {"hello"}, done.GetCallback());
+  task_environment_.RunUntilIdle();
+  EXPECT_FALSE(done.IsReady());
+  {
+    base::AutoLock hold(models_.lock);
+    EXPECT_EQ(models_.made, 1);  // the page made no model of its own
+  }
+  ASSERT_TRUE(session_.SetTarget("", {}));
+  EXPECT_EQ(done.Take(), (PageResults{"hi:hello"}));
+  base::AutoLock hold(models_.lock);
+  EXPECT_EQ(models_.most_loaded, 1);
+}
+
+// Batches complete in the order they were asked for.
+TEST_F(PageTranslatorTest, BatchesRunInOrder) {
+  PageTranslator page(&session_, Factory());
+  std::vector<int> order;
+  base::test::TestFuture<void> both;
+  page.TranslateBatch("hi", "en", Units({"tr_indic_en"}), {"एक"},
+                      base::BindOnce([](std::vector<int>* order, PageResults) { order->push_back(1); },
+                                     &order));
+  page.TranslateBatch("en", "ta", Units({"tr_en_indic"}), {"two"},
+                      base::BindOnce(
+                          [](std::vector<int>* order, base::OnceClosure done, PageResults) {
+                            order->push_back(2);
+                            std::move(done).Run();
+                          },
+                          &order, both.GetCallback()));
+  ASSERT_TRUE(both.Wait());
+  EXPECT_EQ(order, (std::vector<int>{1, 2}));
+}
+
+TEST_F(PageTranslatorTest, Legs) {
+  auto units = [](std::string_view source, std::string_view target) {
+    std::vector<std::string> names;
+    for (const PageLeg& leg : PageLegsFor(source, target)) {
+      names.push_back(leg.unit);
+    }
+    return names;
+  };
+  EXPECT_EQ(units("hi", "en"), (std::vector<std::string>{"tr_indic_en"}));
+  EXPECT_EQ(units("en", "mni"), (std::vector<std::string>{"tr_en_indic"}));
+  EXPECT_EQ(units("ta", "hi"), (std::vector<std::string>{"tr_indic_en", "tr_en_indic"}));
+  EXPECT_EQ(units("es", "en"), (std::vector<std::string>{"tr_es_en"}));
+  EXPECT_TRUE(units("fr", "en").empty());
+  EXPECT_TRUE(units("hi", "hi").empty());
+}
