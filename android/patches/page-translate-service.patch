+#ifndef CHROME_SERVICES_TARK_CAPTIONS_PAGE_TRANSLATOR_H_
+#define CHROME_SERVICES_TARK_CAPTIONS_PAGE_TRANSLATOR_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/circular_deque.h"
+#include "base/files/file.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/services/tark_captions/caption_session.h"
+
+namespace tark_captions {
+
+// One model hop of a page batch: `unit` ("tr_indic_en", ...) translating
+// `source` into `target`.
+struct PageLeg {
+  std::string unit;
+  std::string source;
+  std::string target;
+};
+
+// The hops from `source` into `target` (ISO codes), in order: Indian and
+// Spanish sources go through English, so Indian ↔ Indian is two legs, one
+// model each. Empty when there is no model for the pair (or they are equal).
+std::vector<PageLeg> PageLegsFor(std::string_view source, std::string_view target);
+
+using PageResults = std::vector<std::optional<std::string>>;
+using PageBatchCallback = base::OnceCallback<void(PageResults results)>;
+
+// Tark for Android's page translation, without mojo. It owns no model of its
+// own: it uses the process's one model slot, shared with `session`'s
+// Translate. Never two IndicTrans2 models at once:
+// - captions' Translate holds every model the batch needs: the batch uses
+//   captions' translator (no second load);
+// - captions hold another model: the batch waits until they let it go
+//   (captions win);
+// - captions hold none: the batch loads one model at a time, leg by leg,
+//   unloading the previous one first.
+// Batches run one after another, in order, on the session's translation
+// sequence. Each sentence is translated whole; a failed or empty one comes
+// back null (the page keeps the original).
+class PageTranslator {
+ public:
+  // `session` outlives this; `factory` makes a translator from one unit's
+  // files and is run on the translation sequence.
+  PageTranslator(CaptionSession* session, TranslatorFactory factory);
+  PageTranslator(const PageTranslator&) = delete;
+  PageTranslator& operator=(const PageTranslator&) = delete;
+  ~PageTranslator();
+
+  // `files` are the units for the direction, keyed "<unit>/<name>" (both
+  // legs for Indian ↔ Indian). Results align with `texts`.
+  void TranslateBatch(const std::string& source,
+                      const std::string& target,
+                      std::map<std::string, base::File> files,
+                      std::vector<std::string> texts,
