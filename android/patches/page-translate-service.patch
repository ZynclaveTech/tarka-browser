+// What every fake translator saw, from any sequence. A model counts as
+// loaded from its first Translate (as TranslationEngine loads on first use)
+// until the translator is deleted.
+struct Models {
+  base::Lock lock;
+  int loaded = 0;
+  int most_loaded = 0;
+  int made = 0;
+  std::vector<std::string> events;  // "load:<unit>", "unload:<unit>"
+  std::vector<std::string> received;
+  std::string fail;   // this text comes back nullopt
+  std::string blank;  // this text comes back ""
+};
+
+class FakeTranslator : public Translator {
+ public:
+  FakeTranslator(Models* models, std::string unit) : models_(models), unit_(std::move(unit)) {
+    base::AutoLock hold(models_->lock);
+    ++models_->made;
+  }
+  ~FakeTranslator() override {
+    base::AutoLock hold(models_->lock);
+    if (loaded_) {
+      --models_->loaded;
+      models_->events.push_back("unload:" + unit_);
+    }
+  }
+  std::optional<std::string> Translate(std::string_view text,
+                                       std::string_view source,
+                                       std::string_view target) override {
+    base::AutoLock hold(models_->lock);
+    if (!loaded_) {
+      loaded_ = true;
+      ++models_->loaded;
+      models_->most_loaded = std::max(models_->most_loaded, models_->loaded);
+      EXPECT_LE(models_->loaded, 1) << "two models at once";
+      models_->events.push_back("load:" + unit_);
+    }
+    models_->received.emplace_back(text);
+    if (text == models_->fail) {
+      return std::nullopt;
+    }
+    if (text == models_->blank) {
+      return "";
+    }
+    return std::string(target) + ":" + std::string(text);
+  }
+
+ private:
+  raw_ptr<Models> models_;
+  std::string unit_;
+  bool loaded_ = false;
+};
+
+class PageTranslatorTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  // Each test's PageTranslator is gone by now: let its model (and captions')
+  // be deleted on the translation sequence while `models_` is alive.
+  void TearDown() override {
+    session_.Stop();
+    task_environment_.RunUntilIdle();
+  }
+
+  TranslatorFactory Factory() {
+    return base::BindRepeating(
+        [](Models* models, std::map<std::string, base::File> files) -> std::unique_ptr<Translator> {
+          std::string units;
+          for (const auto& [name, file] : files) {
+            const std::string unit = name.substr(0, name.find('/'));
+            if (units.find(unit) == std::string::npos) {
+              units += (units.empty() ? "" : "+") + unit;
+            }
+          }
+          return std::make_unique<FakeTranslator>(models, units);
+        },
+        base::Unretained(&models_));
+  }
+
+  // The six files of each translation unit, keyed "<unit>/<name>".
+  std::map<std::string, base::File> Units(const std::vector<std::string>& units) {
+    std::map<std::string, base::File> files;
+    for (const std::string& unit : units) {
+      for (const std::string& name : CaptionSession::TranslationFiles()) {
+        const base::FilePath path = dir_.GetPath().AppendASCII(unit + "/" + name);
+        EXPECT_TRUE(base::CreateDirectory(path.DirName()));
+        EXPECT_TRUE(base::WriteFile(path, "x"));
+        files.emplace(unit + "/" + name,
+                      base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+      }
+    }
+    return files;
+  }
+
+  PageResults Translate(PageTranslator& page,
+                        const std::string& source,
+                        const std::string& target,
+                        const std::vector<std::string>& units,
+                        std::vector<std::string> texts) {
+    base::test::TestFuture<PageResults> done;
+    page.TranslateBatch(source, target, Units(units), std::move(texts), done.GetCallback());
+    return done.Take();
+  }
+
+  // Torn down last: the fakes may still be deleted on the pool until the
+  // environment goes.
+  base::ScopedTempDir dir_;
+  Models models_;
+  base::test::TaskEnvironment task_environment_;
+  CaptionSession session_{base::BindRepeating(
+                              [](std::map<std::string, base::File>, const EngineOptions&,
+                                 CaptionCallback) -> std::unique_ptr<SpeechEngine> {
+                                return nullptr;
+                              }),
+                          Factory()};
+};
