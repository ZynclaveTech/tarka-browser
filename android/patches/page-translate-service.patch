+// Page translation, in this same process: it shares the one model slot with
+// captions' Translate (never two IndicTrans2 models in memory; captions win
+// on a different model, and the two share the same direction).
+interface PageTranslator {
+  // `source`/`target` are ISO codes; `files` the model units for that
+  // direction, keyed "<unit>/<name>" (both legs for Indian↔Indian). Results
+  // align with `texts`; null = failed (keep original).
+  TranslateBatch(string source, string target,
+                 map<string, mojo_base.mojom.ReadOnlyFile> files,
+                 array<string> texts) => (array<string?> results);
+};
