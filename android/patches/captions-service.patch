+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
+#define CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace tark_captions {
+
+// What the captions process runs: Tark's caption engine (CaptionEngine), or
+// a fake in tests.
+class SpeechEngine {
+ public:
+  virtual ~SpeechEngine() = default;
+  // Interleaved-free mono audio at any rate; captions come through the
+  // callback the engine was made with.
+  virtual void AddAudio(base::span<const float> pcm, int sample_rate) = 0;
+};
+
+struct EngineOptions {
+  std::string language;  // "hi", "ta", "en", "es"
+  int threads = 2;
+  bool phrase = false;   // a phrase at a time: no drafts
+  double draft_every = 0.8;
+  double max_segment = 5.0;
+};
+
+using CaptionCallback = base::RepeatingCallback<void(bool is_final, std::string text)>;
+using EngineFactory = base::RepeatingCallback<std::unique_ptr<SpeechEngine>(
+    std::map<std::string, base::File> files,
+    const EngineOptions& options,
+    CaptionCallback on_caption)>;
+
+// Translate (Phase 2a): Tark's TranslationEngine, or a fake in tests. Runs on
+// its own sequence and may block for a fraction of a second per caption.
+class Translator {
+ public:
+  virtual ~Translator() = default;
+  // `caption` in `source` ("hi", "ta", "en", "es") into `target` ("en",
+  // "hi", "ta"); nullopt or "" shows the caption alone.
+  virtual std::optional<std::string> Translate(std::string_view caption,
+                                               std::string_view source,
+                                               std::string_view target) = 0;
+};
+
+// The translation units' files, keyed "<unit>/<name>".
+using TranslatorFactory =
+    base::RepeatingCallback<std::unique_ptr<Translator>(std::map<std::string, base::File> files)>;
+// What the session tells its client: finals are numbered from 1, so that a
+// translation arriving later is paired with its caption.
+using SessionCaptionCallback =
+    base::RepeatingCallback<void(bool is_final, std::string text, uint32_t caption_id)>;
+using TranslationCallback = base::RepeatingCallback<void(uint32_t caption_id, std::string text)>;
+
+// Tark for Android's captions process, without mojo: one tab's captions.
+// The model arrives as file handles (the sandbox opens nothing); a session
+// missing a file refuses to start.
+class CaptionSession {
+ public:
+  CaptionSession(EngineFactory factory, TranslatorFactory translator_factory);
+  CaptionSession(const CaptionSession&) = delete;
+  CaptionSession& operator=(const CaptionSession&) = delete;
+  ~CaptionSession();
+
+  // The model folder's files a session needs (a speech unit and Silero VAD).
+  static std::vector<std::string> RequiredFiles();
+  // Each translation unit's files (TranslationEngine's six).
+  static std::vector<std::string> TranslationFiles();
+
+  bool Start(std::map<std::string, base::File> files,
+             const EngineOptions& options,
+             SessionCaptionCallback on_caption,
+             TranslationCallback on_translation);
+  // Dropped unless started.
+  void AddAudio(base::span<const float> pcm, int sample_rate);
+  // Translate finals into `target` with the units in `files`; "" turns it
+  // off and unloads the models. Speech goes on either way. False (and no
+  // translation) when a unit lacks one of its files.
+  bool SetTarget(const std::string& target, std::map<std::string, base::File> files);
+  void Stop();
+
+ private:
+  void OnEngineCaption(bool is_final, std::string text);
+  void OnTranslated(uint64_t generation, uint32_t caption_id, std::optional<std::string> text);
+
+  EngineFactory factory_;
+  TranslatorFactory translator_factory_;
+  std::unique_ptr<SpeechEngine> engine_;
+  SessionCaptionCallback on_caption_;
+  TranslationCallback on_translation_;
+  std::string language_;
+  uint32_t next_caption_id_ = 1;
+  // Finals are translated in order on this sequence; the translator lives
+  // and dies on it.
+  scoped_refptr<base::SequencedTaskRunner> translation_runner_;
+  std::unique_ptr<Translator, base::OnTaskRunnerDeleter> translator_;
+  std::string target_;
+  uint64_t generation_ = 0;  // a translation for an older target is dropped
+  base::WeakPtrFactory<CaptionSession> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
