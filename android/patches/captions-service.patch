+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android's live captions: one tab's captions, in a sandboxed
+// utility process ("Tark captions"). The browser hands it the language's
+// model files, already opened; the process opens nothing itself.
+module tark_captions.mojom;
+
+import "mojo/public/mojom/base/file.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+struct CaptionOptions {
+  // "hi", "ta", "en", "es".
+  string language;
+  // ONNX Runtime's threads for the speech model.
+  int32 threads;
+  // A phrase at a time (no drafts), or word by word.
+  bool phrase;
+};
+
+interface CaptionClient {
+  // A draft of what is being said, or a segment's final text (UTF-8).
+  OnCaption(bool is_final, string text);
+};
+
+[ServiceSandbox=sandbox.mojom.Sandbox.kUtility]
+interface CaptionService {
+  // `files`: the model folder's files by name (CaptionSession's list).
+  // False if one is missing or the model does not load.
+  Start(map<string, mojo_base.mojom.ReadOnlyFile> files,
+        CaptionOptions options,
+        pending_remote<CaptionClient> client) => (bool ok);
+  // Mono audio at `sample_rate`, 100 ms at a time.
+  AddAudio(array<float> pcm, int32 sample_rate);
+  Stop();
+};
