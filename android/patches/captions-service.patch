+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/tark_captions/caption_session.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+class FakeEngine : public SpeechEngine {
+ public:
+  explicit FakeEngine(std::vector<int>* fed) : fed_(fed) {}
+  void AddAudio(base::span<const float> pcm, int sample_rate) override {
+    fed_->push_back(static_cast<int>(pcm.size()));
+  }
+
+ private:
+  raw_ptr<std::vector<int>> fed_;
+};
+
+class CaptionSessionTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  std::map<std::string, base::File> Files(const std::vector<std::string>& names) {
+    std::map<std::string, base::File> files;
+    for (const std::string& name : names) {
+      const base::FilePath path = dir_.GetPath().AppendASCII(name);
+      EXPECT_TRUE(base::WriteFile(path, "x"));
+      files.emplace(name, base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+    }
+    return files;
+  }
+
+  CaptionSession Session() {
+    return CaptionSession(base::BindRepeating(
+        [](CaptionSessionTest* self, std::map<std::string, base::File> files,
+           const EngineOptions& options, CaptionCallback) -> std::unique_ptr<SpeechEngine> {
+          ++self->engines_;
+          for (const auto& [name, file] : files) {
+            self->names_.push_back(name);
+          }
+          self->options_ = options;
+          return std::make_unique<FakeEngine>(&self->fed_);
+        },
+        base::Unretained(this)));
+  }
+
+  base::ScopedTempDir dir_;
+  int engines_ = 0;
+  std::vector<std::string> names_;
+  EngineOptions options_;
+  std::vector<int> fed_;
+};
+
+// The sandboxed process opens nothing itself: a model arrives as handles,
+// and a missing one refuses the session before any engine is built.
+TEST_F(CaptionSessionTest, StartsWithFilesNotPaths) {
+  CaptionSession session = Session();
+  std::vector<std::string> names = CaptionSession::RequiredFiles();
+  ASSERT_EQ(names.size(), 8u);
+  names.pop_back();
+  EXPECT_FALSE(session.Start(Files(names), EngineOptions(), base::DoNothing()));
+  EXPECT_EQ(engines_, 0);
+  EXPECT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), EngineOptions(),
+                            base::DoNothing()));
+  EXPECT_EQ(engines_, 1);
+  EXPECT_EQ(names_.size(), 8u);
+}
+
+TEST_F(CaptionSessionTest, PhraseStyleReachesTheEngine) {
+  CaptionSession session = Session();
+  EngineOptions options;
+  options.phrase = true;
+  options.threads = 1;
+  options.language = "ta";
+  ASSERT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), options, base::DoNothing()));
+  EXPECT_TRUE(options_.phrase);
+  EXPECT_EQ(options_.threads, 1);
+  EXPECT_EQ(options_.language, "ta");
+}
+
+TEST_F(CaptionSessionTest, AudioOnlyReachesAStartedEngine) {
+  CaptionSession session = Session();
+  const std::vector<float> pcm(160, 0.0f);
+  session.AddAudio(pcm, 16000);  // before Start: dropped
+  ASSERT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), EngineOptions(),
+                            base::DoNothing()));
+  session.AddAudio(pcm, 16000);
+  session.Stop();
+  session.AddAudio(pcm, 16000);  // after Stop: dropped
+  EXPECT_EQ(fed_, (std::vector<int>{160}));
+}
+
+}  // namespace
+}  // namespace tark_captions
