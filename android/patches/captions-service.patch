+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/tark_captions/caption_session.h"
+
+#include <set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+
+namespace tark_captions {
+
+CaptionSession::CaptionSession(EngineFactory factory, TranslatorFactory translator_factory)
+    : factory_(std::move(factory)),
+      translator_factory_(std::move(translator_factory)),
+      translation_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE})),
+      translator_(nullptr, base::OnTaskRunnerDeleter(translation_runner_)) {}
+
+CaptionSession::~CaptionSession() = default;
+
+// static
+std::vector<std::string> CaptionSession::RequiredFiles() {
+  return {"encoder.int8.onnx", "ctc_decoder.onnx",    "window.f32",  "mel_fb.f32",
+          "vocab.json",        "language_masks.json", "engine.json", "silero_vad.onnx"};
+}
+
+// static
+std::vector<std::string> CaptionSession::TranslationFiles() {
+  return {"config.json",       "dict.SRC.json",    "dict.TGT.json",
+          "model.SRC",         "encoder.int8.onnx", "decoder_step.int8.onnx"};
+}
+
+bool CaptionSession::Start(std::map<std::string, base::File> files,
+                           const EngineOptions& options,
+                           SessionCaptionCallback on_caption,
+                           TranslationCallback on_translation) {
+  engine_.reset();
+  on_caption_ = std::move(on_caption);
+  on_translation_ = std::move(on_translation);
+  language_ = options.language;
+  for (const std::string& name : RequiredFiles()) {
+    auto it = files.find(name);
+    if (it == files.end() || !it->second.IsValid()) {
+      return false;
+    }
+  }
+  engine_ = factory_.Run(std::move(files), options,
+                         base::BindRepeating(&CaptionSession::OnEngineCaption,
+                                             weak_factory_.GetWeakPtr()));
+  return engine_ != nullptr;
+}
+
+void CaptionSession::OnEngineCaption(bool is_final, std::string text) {
+  const uint32_t id = is_final ? next_caption_id_++ : 0;
+  if (on_caption_) {
+    on_caption_.Run(is_final, text, id);
+  }
+  if (!is_final || !translator_ || target_.empty()) {
+    return;
+  }
+  // The translator is deleted on its own sequence, after any task posted
+  // before; so it outlives this one.
+  translation_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&Translator::Translate, base::Unretained(translator_.get()), std::move(text),
+                     language_, target_),
+      base::BindOnce(&CaptionSession::OnTranslated, weak_factory_.GetWeakPtr(), generation_, id));
+}
+
+void CaptionSession::OnTranslated(uint64_t generation,
+                                  uint32_t caption_id,
+                                  std::optional<std::string> text) {
+  if (generation != generation_ || !text || text->empty() || !on_translation_) {
+    return;
+  }
+  on_translation_.Run(caption_id, std::move(*text));
+}
+
+bool CaptionSession::SetTarget(const std::string& target, std::map<std::string, base::File> files) {
+  ++generation_;
+  target_.clear();
+  translator_.reset();  // deleted on the translation sequence
+  if (target.empty()) {
+    return true;
+  }
+  // Every unit named in `files` must be whole.
+  std::set<std::string> units;
+  for (const auto& [name, file] : files) {
+    const size_t slash = name.find('/');
+    if (slash == std::string::npos || !file.IsValid()) {
+      return false;
+    }
+    units.insert(name.substr(0, slash));
+  }
+  if (units.empty()) {
+    return false;
+  }
+  for (const std::string& unit : units) {
+    for (const std::string& name : TranslationFiles()) {
+      if (!files.contains(unit + "/" + name)) {
+        return false;
+      }
+    }
+  }
+  std::unique_ptr<Translator> translator = translator_factory_.Run(std::move(files));
+  if (!translator) {
+    return false;
+  }
+  translator_ = std::unique_ptr<Translator, base::OnTaskRunnerDeleter>(
+      translator.release(), base::OnTaskRunnerDeleter(translation_runner_));
+  target_ = target;
+  return true;
+}
+
+void CaptionSession::AddAudio(base::span<const float> pcm, int sample_rate) {
+  if (engine_) {
+    engine_->AddAudio(pcm, sample_rate);
+  }
+}
+
+void CaptionSession::Stop() {
+  engine_.reset();
+  SetTarget("", {});
+}
+
+}  // namespace tark_captions
