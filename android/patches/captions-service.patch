+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
+#define CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/functional/callback.h"
+
+namespace tark_captions {
+
+// What the captions process runs: Tark's caption engine (CaptionEngine), or
+// a fake in tests.
+class SpeechEngine {
+ public:
+  virtual ~SpeechEngine() = default;
+  // Interleaved-free mono audio at any rate; captions come through the
+  // callback the engine was made with.
+  virtual void AddAudio(base::span<const float> pcm, int sample_rate) = 0;
+};
+
+struct EngineOptions {
+  std::string language;  // "hi", "ta", "en", "es"
+  int threads = 2;
+  bool phrase = false;   // a phrase at a time: no drafts
+  double draft_every = 0.8;
+  double max_segment = 5.0;
+};
+
+using CaptionCallback = base::RepeatingCallback<void(bool is_final, std::string text)>;
+using EngineFactory = base::RepeatingCallback<std::unique_ptr<SpeechEngine>(
+    std::map<std::string, base::File> files,
+    const EngineOptions& options,
+    CaptionCallback on_caption)>;
+
+// Tark for Android's captions process, without mojo: one tab's captions.
+// The model arrives as file handles (the sandbox opens nothing); a session
+// missing a file refuses to start.
+class CaptionSession {
+ public:
+  explicit CaptionSession(EngineFactory factory);
+  CaptionSession(CaptionSession&&);
+  CaptionSession& operator=(CaptionSession&&);
+  ~CaptionSession();
+
+  // The model folder's files a session needs (a speech unit and Silero VAD).
+  static std::vector<std::string> RequiredFiles();
+
+  bool Start(std::map<std::string, base::File> files,
+             const EngineOptions& options,
+             CaptionCallback on_caption);
+  // Dropped unless started.
+  void AddAudio(base::span<const float> pcm, int sample_rate);
+  void Stop();
+
+ private:
+  EngineFactory factory_;
+  std::unique_ptr<SpeechEngine> engine_;
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_SERVICES_TARK_CAPTIONS_CAPTION_SESSION_H_
