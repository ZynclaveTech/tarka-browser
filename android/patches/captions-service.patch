+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/tark_captions/caption_session.h"
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/waitable_event.h"
+#include "base/test/task_environment.h"
+#include "base/threading/thread_restrictions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+class FakeEngine : public SpeechEngine {
+ public:
+  explicit FakeEngine(std::vector<int>* fed) : fed_(fed) {}
+  void AddAudio(base::span<const float> pcm, int sample_rate) override {
+    fed_->push_back(static_cast<int>(pcm.size()));
+  }
+
+ private:
+  raw_ptr<std::vector<int>> fed_;
+};
+
+// Translates by tagging the caption; the first call can be held back.
+class FakeTranslator : public Translator {
+ public:
+  FakeTranslator(int* alive, base::WaitableEvent* hold) : alive_(alive), hold_(hold) {
+    ++*alive_;
+  }
+  ~FakeTranslator() override { --*alive_; }
+  std::optional<std::string> Translate(std::string_view caption,
+                                       std::string_view source,
+                                       std::string_view target) override {
+    if (hold_ && first_) {
+      first_ = false;
+      base::ScopedAllowBaseSyncPrimitivesForTesting allow;
+      hold_->Wait();
+    }
+    return std::string(target) + ":" + std::string(caption);
+  }
+
+ private:
+  raw_ptr<int> alive_;
+  raw_ptr<base::WaitableEvent> hold_;
+  bool first_ = true;
+};
+
+class CaptionSessionTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  std::map<std::string, base::File> Files(const std::vector<std::string>& names) {
+    std::map<std::string, base::File> files;
+    for (const std::string& name : names) {
+      const base::FilePath path = dir_.GetPath().AppendASCII(name);
+      EXPECT_TRUE(base::WriteFile(path, "x"));
+      files.emplace(name, base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+    }
+    return files;
+  }
+
+  CaptionSession Session() {
+    return CaptionSession(
+        base::BindRepeating(
+            [](CaptionSessionTest* self, std::map<std::string, base::File> files,
+               const EngineOptions& options,
+               CaptionCallback on_caption) -> std::unique_ptr<SpeechEngine> {
+              ++self->engines_;
+              self->speak_ = on_caption;
+          for (const auto& [name, file] : files) {
+            self->names_.push_back(name);
+          }
+              self->options_ = options;
+              return std::make_unique<FakeEngine>(&self->fed_);
+            },
+            base::Unretained(this)),
+        base::BindRepeating(
+            [](CaptionSessionTest* self,
+               std::map<std::string, base::File> files) -> std::unique_ptr<Translator> {
+              ++self->translators_made_;
+              return std::make_unique<FakeTranslator>(&self->translators_alive_, self->hold_);
+            },
+            base::Unretained(this)));
+  }
+
+  // A started Hindi session that records captions and translations.
+  void Started(CaptionSession& session) {
+    EngineOptions options;
+    options.language = "hi";
+    ASSERT_TRUE(session.Start(
+        Files(CaptionSession::RequiredFiles()), options,
+        base::BindRepeating(
+            [](CaptionSessionTest* self, bool is_final, std::string text, uint32_t id) {
+              if (is_final) {
+                self->final_ids_.push_back(id);
+              }
+            },
+            base::Unretained(this)),
+        base::BindRepeating(
+            [](CaptionSessionTest* self, uint32_t id, std::string text) {
+              self->translations_.emplace_back(id, text);
+            },
+            base::Unretained(this))));
+  }
+
+  // The six files of each translation unit, keyed "<unit>/<name>".
+  std::map<std::string, base::File> TranslationFiles(const std::vector<std::string>& units) {
+    std::vector<std::string> names;
+    for (const std::string& unit : units) {
+      for (const std::string& name : CaptionSession::TranslationFiles()) {
+        names.push_back(unit + "/" + name);
+      }
+    }
+    for (const std::string& name : names) {
+      base::CreateDirectory(dir_.GetPath().AppendASCII(name).DirName());
+    }
+    return Files(names);
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  CaptionCallback speak_;
+  int translators_made_ = 0;
+  int translators_alive_ = 0;
+  raw_ptr<base::WaitableEvent> hold_ = nullptr;
+  std::vector<uint32_t> final_ids_;
+  std::vector<std::pair<uint32_t, std::string>> translations_;
+
+  base::ScopedTempDir dir_;
+  int engines_ = 0;
+  std::vector<std::string> names_;
+  EngineOptions options_;
+  std::vector<int> fed_;
+};
+
+// The sandboxed process opens nothing itself: a model arrives as handles,
+// and a missing one refuses the session before any engine is built.
+TEST_F(CaptionSessionTest, StartsWithFilesNotPaths) {
+  CaptionSession session = Session();
+  std::vector<std::string> names = CaptionSession::RequiredFiles();
+  ASSERT_EQ(names.size(), 8u);
+  names.pop_back();
+  EXPECT_FALSE(session.Start(Files(names), EngineOptions(), base::DoNothing(), base::DoNothing()));
+  EXPECT_EQ(engines_, 0);
+  EXPECT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), EngineOptions(),
+                            base::DoNothing(), base::DoNothing()));
+  EXPECT_EQ(engines_, 1);
+  EXPECT_EQ(names_.size(), 8u);
+}
+
+TEST_F(CaptionSessionTest, PhraseStyleReachesTheEngine) {
+  CaptionSession session = Session();
+  EngineOptions options;
+  options.phrase = true;
+  options.threads = 1;
+  options.language = "ta";
+  ASSERT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), options, base::DoNothing(),
+                            base::DoNothing()));
+  EXPECT_TRUE(options_.phrase);
+  EXPECT_EQ(options_.threads, 1);
+  EXPECT_EQ(options_.language, "ta");
+}
+
+TEST_F(CaptionSessionTest, AudioOnlyReachesAStartedEngine) {
+  CaptionSession session = Session();
+  const std::vector<float> pcm(160, 0.0f);
+  session.AddAudio(pcm, 16000);  // before Start: dropped
+  ASSERT_TRUE(session.Start(Files(CaptionSession::RequiredFiles()), EngineOptions(),
+                            base::DoNothing(), base::DoNothing()));
+  session.AddAudio(pcm, 16000);
+  session.Stop();
+  session.AddAudio(pcm, 16000);  // after Stop: dropped
+  EXPECT_EQ(fed_, (std::vector<int>{160}));
+}
+
+// Translate on, another target, off: the speech model is never rebuilt.
+TEST_F(CaptionSessionTest, SetTargetDoesNotRestartSpeech) {
+  CaptionSession session = Session();
+  Started(session);
+  EXPECT_TRUE(session.SetTarget("en", TranslationFiles({"tr_indic_en"})));
+  EXPECT_TRUE(session.SetTarget("hi", TranslationFiles({"tr_indic_en", "tr_en_indic"})));
+  EXPECT_TRUE(session.SetTarget("", {}));
+  EXPECT_EQ(engines_, 1);
+}
+
+TEST_F(CaptionSessionTest, OnlyFinalsAreTranslated) {
+  CaptionSession session = Session();
+  Started(session);
+  ASSERT_TRUE(session.SetTarget("en", TranslationFiles({"tr_indic_en"})));
+  speak_.Run(false, "नम");
+  speak_.Run(false, "नमस्ते");
+  speak_.Run(false, "नमस्ते दु");
+  speak_.Run(true, "नमस्ते दुनिया");
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(final_ids_, (std::vector<uint32_t>{1}));
+  ASSERT_EQ(translations_.size(), 1u);
+  EXPECT_EQ(translations_[0], (std::pair<uint32_t, std::string>{1, "en:नमस्ते दुनिया"}));
+}
+
+// A slow translation and fast speech: each translation stays with its own
+// caption, in order.
+TEST_F(CaptionSessionTest, TranslationsKeepCaptionOrder) {
+  base::WaitableEvent hold;
+  hold_ = &hold;
+  CaptionSession session = Session();
+  Started(session);
+  ASSERT_TRUE(session.SetTarget("en", TranslationFiles({"tr_indic_en"})));
+  speak_.Run(true, "एक");
+  speak_.Run(true, "दो");  // queued behind the held first one
+  hold.Signal();
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(translations_.size(), 2u);
+  EXPECT_EQ(translations_[0], (std::pair<uint32_t, std::string>{1, "en:एक"}));
+  EXPECT_EQ(translations_[1], (std::pair<uint32_t, std::string>{2, "en:दो"}));
+}
+
+// Translate off: the translation models leave memory.
+TEST_F(CaptionSessionTest, TargetOffUnloadsTranslator) {
+  CaptionSession session = Session();
+  Started(session);
+  ASSERT_TRUE(session.SetTarget("ta", TranslationFiles({"tr_indic_en", "tr_en_indic"})));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(translators_alive_, 1);
+  ASSERT_TRUE(session.SetTarget("", {}));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(translators_alive_, 0);
+  speak_.Run(true, "कुछ");
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(translations_.empty());
+}
+
+// A unit missing a file: no translator, captions go on untranslated.
+TEST_F(CaptionSessionTest, MissingFileRejectsTarget) {
+  CaptionSession session = Session();
+  Started(session);
+  std::map<std::string, base::File> files = TranslationFiles({"tr_indic_en"});
+  files.erase("tr_indic_en/model.SRC");
+  EXPECT_FALSE(session.SetTarget("en", std::move(files)));
+  EXPECT_EQ(translators_made_, 0);
+  speak_.Run(true, "फिर भी");
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(final_ids_, (std::vector<uint32_t>{1}));
+  EXPECT_TRUE(translations_.empty());
+}
