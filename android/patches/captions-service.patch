+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/tark_captions/caption_service_impl.h"
+
+#include <map>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "components/tark_captions/asr_model.h"
+#include "components/tark_captions/caption_engine.h"
+#include "components/tark_captions/model_source.h"
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/translation_engine.h"
+
+namespace tark_captions {
+namespace {
+
+// ONNX Runtime's library, in the APK beside libchrome.so (extracted at
+// install), found by name.
+constexpr char kOrtLibrary[] = "libonnxruntime.so";
+
+class RealEngine : public SpeechEngine {
+ public:
+  RealEngine(std::unique_ptr<CaptionEngine> engine, CaptionCallback on_caption)
+      : engine_(std::move(engine)), on_caption_(std::move(on_caption)) {}
+
+  void AddAudio(base::span<const float> pcm, int sample_rate) override {
+    engine_->AddAudio(pcm, 1, sample_rate,
+                      base::BindRepeating(
+                          [](CaptionCallback* on_caption, CaptionEvent event) {
+                            on_caption->Run(event.is_final, std::move(event.text));
+                          },
+                          base::Unretained(&on_caption_)));
+  }
+
+ private:
+  std::unique_ptr<CaptionEngine> engine_;
+  CaptionCallback on_caption_;
+};
+
+std::unique_ptr<SpeechEngine> MakeEngine(std::map<std::string, base::File> files,
+                                         const EngineOptions& options,
+                                         CaptionCallback on_caption) {
+  CaptionEngine::Options engine_options;
+  engine_options.threads = options.threads;
+  engine_options.segmenter.phrase = options.phrase;
+  engine_options.segmenter.draft_every = options.draft_every;
+  engine_options.segmenter.max_segment = options.max_segment;
+  std::unique_ptr<CaptionEngine> engine = CaptionEngine::Create(
+      std::make_unique<MappedFilesSource>(std::move(files)), base::FilePath(kOrtLibrary),
+      engine_options);
+  if (!engine) {
+    LOG(WARNING) << "tark captions: the model did not load";
+    return nullptr;
+  }
+  if (std::optional<Language> language = LanguageFromCode(options.language)) {
+    engine->SetLanguage(*language);
+  }
+  return std::make_unique<RealEngine>(std::move(engine), std::move(on_caption));
+}
+
+class RealTranslator : public Translator {
+ public:
+  explicit RealTranslator(std::unique_ptr<TranslationEngine> engine) : engine_(std::move(engine)) {}
+
+  std::optional<std::string> Translate(std::string_view caption,
+                                       std::string_view source,
+                                       std::string_view target) override {
+    const std::optional<Target> to = TargetFromCode(target);
+    if (!to) {
+      return std::nullopt;
+    }
+    return engine_->TranslateFrom(caption, source, *to);
+  }
+
+ private:
+  std::unique_ptr<TranslationEngine> engine_;
+};
+
+// The units' files ("tr_indic_en/model.SRC", ...) as one source per
+// direction; the models load on the translation sequence, on first use.
+std::unique_ptr<Translator> MakeTranslator(std::map<std::string, base::File> files) {
+  static constexpr std::pair<const char*, TranslationDirection> kUnits[] = {
+      {"tr_indic_en", TranslationDirection::kIndicToEnglish},
+      {"tr_en_indic", TranslationDirection::kEnglishToIndic},
+      {"tr_es_en", TranslationDirection::kSpanishToEnglish},
+  };
+  std::map<TranslationDirection, std::map<std::string, base::File>> by_direction;
+  for (auto& [name, file] : files) {
+    const size_t slash = name.find('/');
+    for (const auto& [unit, direction] : kUnits) {
+      if (name.substr(0, slash) == unit) {
+        by_direction[direction].emplace(name.substr(slash + 1), std::move(file));
+      }
+    }
+  }
+  std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources;
+  for (auto& [direction, unit_files] : by_direction) {
+    sources[direction] = std::make_unique<MappedFilesSource>(std::move(unit_files));
+  }
+  std::unique_ptr<TranslationEngine> engine =
+      TranslationEngine::Create(OrtRuntime::Load(base::FilePath(kOrtLibrary)), std::move(sources));
+  if (!engine) {
+    LOG(WARNING) << "tark captions: no translation runtime";
+    return nullptr;
+  }
+  return std::make_unique<RealTranslator>(std::move(engine));
+}
+
+}  // namespace
+
+CaptionServiceImpl::CaptionServiceImpl(mojo::PendingReceiver<mojom::CaptionService> receiver)
+    : receiver_(this, std::move(receiver)),
+      session_(base::BindRepeating(&MakeEngine), base::BindRepeating(&MakeTranslator)) {}
+
+CaptionServiceImpl::~CaptionServiceImpl() = default;
+
+void CaptionServiceImpl::Start(base::flat_map<std::string, base::File> files,
+                               mojom::CaptionOptionsPtr options,
+                               mojo::PendingRemote<mojom::CaptionClient> client,
+                               StartCallback callback) {
+  client_.reset();
+  client_.Bind(std::move(client));
+  EngineOptions engine_options;
+  engine_options.language = options->language;
+  engine_options.threads = options->threads;
+  engine_options.phrase = options->phrase;
+  std::map<std::string, base::File> by_name;
+  for (auto& [name, file] : files) {
+    by_name.emplace(name, std::move(file));
+  }
+  std::move(callback).Run(session_.Start(
+      std::move(by_name), engine_options,
+      base::BindRepeating(
+          [](mojo::Remote<mojom::CaptionClient>* client, bool is_final, std::string text,
+             uint32_t caption_id) {
+            if (client->is_bound()) {
+              (*client)->OnCaption(is_final, text, caption_id);
+            }
+          },
+          base::Unretained(&client_)),
+      base::BindRepeating(
+          [](mojo::Remote<mojom::CaptionClient>* client, uint32_t caption_id, std::string text) {
+            if (client->is_bound()) {
+              (*client)->OnTranslation(caption_id, text);
+            }
+          },
+          base::Unretained(&client_))));
+}
+
+void CaptionServiceImpl::SetTarget(const std::string& target,
+                                   base::flat_map<std::string, base::File> files,
+                                   SetTargetCallback callback) {
+  std::map<std::string, base::File> by_name;
+  for (auto& [name, file] : files) {
+    by_name.emplace(name, std::move(file));
+  }
+  const bool ok = session_.SetTarget(target, std::move(by_name));
+  LOG(WARNING) << "tark captions: translation " << (target.empty() ? "off" : target)
+               << (ok ? "" : " (not loaded)");
+  std::move(callback).Run(ok);
+}
+
+void CaptionServiceImpl::AddAudio(const std::vector<float>& pcm, int32_t sample_rate) {
+  session_.AddAudio(pcm, sample_rate);
+}
+
+void CaptionServiceImpl::Stop() {
+  session_.Stop();
+}
+
+}  // namespace tark_captions
