+bool AdsAllowed(const HostContentSettingsMap* settings,
+                const std::optional<url::Origin>& top_frame_origin) {
+  if (!settings || !top_frame_origin || top_frame_origin->opaque()) {
+    return false;
+  }
+  const GURL url = top_frame_origin->GetURL();
+  return settings->GetContentSetting(url, url, ContentSettingsType::ADS) ==
+         CONTENT_SETTING_ALLOW;
+}
+
+class ProxyingURLLoaderFactory::InProgressRequest
+    : public network::mojom::URLLoader,
+      public network::mojom::URLLoaderClient {
+ public:
+  InProgressRequest(
+      ProxyingURLLoaderFactory* factory,
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      : factory_(factory),
+        request_(request),
+        request_type_(RequestType(request.resource_type)),
+        request_id_(request_id),
+        options_(options),
+        traffic_annotation_(traffic_annotation),
+        loader_receiver_(this, std::move(loader_receiver)),
+        target_client_(std::move(client)) {
+    // The page cancelled or went away: nothing more to do.
+    loader_receiver_.set_disconnect_handler(base::BindOnce(
+        &InProgressRequest::OnDisconnect, base::Unretained(this)));
+    target_client_.set_disconnect_handler(base::BindOnce(
+        &InProgressRequest::OnDisconnect, base::Unretained(this)));
+  }
+  InProgressRequest(const InProgressRequest&) = delete;
+  InProgressRequest& operator=(const InProgressRequest&) = delete;
+  ~InProgressRequest() override = default;
+
+  void Start() {
+    if (!ShouldCheck(request_.url)) {
+      StartTarget();
+      return;
+    }
+    AdblockService::Get()->ShouldBlock(
+        request_.url, *request_.request_initiator, request_type_,
+        request_.method,
+        base::BindOnce(&InProgressRequest::OnDecision,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  // network::mojom::URLLoader:
+  void FollowRedirect(
+      network::HttpRequestHeadersUpdateParams headers_update_params,
+      const std::optional<GURL>& new_url) override {
+    if (target_loader_) {
+      target_loader_->FollowRedirect(std::move(headers_update_params),
+                                     new_url);
+    }
+  }
+  void SetPriority(net::RequestPriority priority,
+                   int32_t intra_priority_value) override {
+    if (target_loader_) {
+      target_loader_->SetPriority(priority, intra_priority_value);
+    } else {
+      request_.priority = priority;
+    }
+  }
+
+  // network::mojom::URLLoaderClient:
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr early_hints) override {
+    target_client_->OnReceiveEarlyHints(std::move(early_hints));
+  }
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> cached_metadata) override {
+    target_client_->OnReceiveResponse(std::move(head), std::move(body),
+                                      std::move(cached_metadata));
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& redirect_info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    if (!ShouldCheck(redirect_info.new_url)) {
+      target_client_->OnReceiveRedirect(redirect_info, std::move(head));
+      return;
+    }
+    // A redirect to an ad is blocked like a request for one.
+    AdblockService::Get()->ShouldBlock(
+        redirect_info.new_url, *request_.request_initiator, request_type_,
+        redirect_info.new_method,
+        base::BindOnce(&InProgressRequest::OnRedirectDecision,
+                       weak_factory_.GetWeakPtr(), redirect_info,
+                       std::move(head)));
+  }
+  void OnUploadProgress(int64_t current_position,
+                        int64_t total_size,
+                        OnUploadProgressCallback callback) override {
+    target_client_->OnUploadProgress(current_position, total_size,
+                                     std::move(callback));
+  }
+  void OnTransferSizeUpdated(int32_t transfer_size_diff) override {
+    target_client_->OnTransferSizeUpdated(transfer_size_diff);
+  }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    target_client_->OnComplete(status);
+  }
+
+ private:
+  // Only page-initiated http(s) subresources and subframes are checked,
+  // and none on a site where the person turned ad blocking off.
+  bool ShouldCheck(const GURL& url) const {
+    return url.SchemeIsHTTPOrHTTPS() && request_.request_initiator &&
+           request_.resource_type !=
+               static_cast<int>(blink::mojom::ResourceType::kMainFrame) &&
+           !AdsAllowed(factory_->settings_.get(), TopFrameOrigin());
+  }
+
+  std::optional<url::Origin> TopFrameOrigin() const {
+    if (factory_->top_frame_origin_) {
+      return factory_->top_frame_origin_;
+    }
+    if (request_.trusted_params &&
+        request_.trusted_params->isolation_info.top_frame_origin()) {
+      return request_.trusted_params->isolation_info.top_frame_origin();
+    }
+    return request_.request_initiator;
+  }
+
+  void OnDecision(BlockResult result) {
+    if (!result.block) {
+      StartTarget();
+    } else if (result.redirect) {
+      ServeStub(*result.redirect);
+    } else {
+      Fail();
+    }
+  }
+
+  void OnRedirectDecision(const net::RedirectInfo& redirect_info,
+                          network::mojom::URLResponseHeadPtr head,
+                          BlockResult result) {
+    if (!result.block) {
+      target_client_->OnReceiveRedirect(redirect_info, std::move(head));
+      return;
+    }
+    target_loader_.reset();
+    client_receiver_.reset();
+    Fail();
+  }
+
+  void StartTarget() {
+    if (!factory_->target_factory_.is_bound()) {
+      target_client_->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_FAILED));
+      return;
+    }
+    factory_->target_factory_->CreateLoaderAndStart(
+        target_loader_.BindNewPipeAndPassReceiver(), request_id_, options_,
+        request_, client_receiver_.BindNewPipeAndPassRemote(),
+        traffic_annotation_);
+  }
+
+  // As uBlock Origin: the request fails as if blocked by the client, and
+  // the element that made it collapses.
+  void Fail() {
+    network::URLLoaderCompletionStatus status(net::ERR_BLOCKED_BY_CLIENT);
+    status.should_collapse_initiator = true;
+    target_client_->OnComplete(status);
+  }
+
+  // A $redirect rule: answer with the resource (a data: URL) instead.
+  void ServeStub(const std::string& data_url) {
+    auto head = network::mojom::URLResponseHead::New();
+    std::string body;
+    brave_shields::MakeStubResponse(data_url, request_, &head, &body);
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    if (mojo::CreateDataPipe(
+            static_cast<uint32_t>(std::max<size_t>(body.size(), 1)), producer,
+            consumer) != MOJO_RESULT_OK ||
+        (!body.empty() &&
+         producer->WriteAllData(base::as_byte_span(body)) != MOJO_RESULT_OK)) {
+      Fail();
+      return;
+    }
+    producer.reset();
+    head->content_length = body.size();
+    target_client_->OnReceiveResponse(std::move(head), std::move(consumer),
+                                      std::nullopt);
+    network::URLLoaderCompletionStatus status(net::OK);
+    status.encoded_data_length = body.size();
+    status.encoded_body_length = body.size();
+    status.decoded_body_length = body.size();
+    target_client_->OnComplete(status);
+  }
+
+  void OnDisconnect() {
+    // Destroys `this`.
+    factory_->RemoveRequest(this);
+  }
+
+  const raw_ptr<ProxyingURLLoaderFactory> factory_;
+  network::ResourceRequest request_;
+  const std::string request_type_;
+  const int32_t request_id_;
+  const uint32_t options_;
+  const net::MutableNetworkTrafficAnnotationTag traffic_annotation_;
+
+  mojo::Receiver<network::mojom::URLLoader> loader_receiver_;
+  mojo::Remote<network::mojom::URLLoaderClient> target_client_;
+  mojo::Receiver<network::mojom::URLLoaderClient> client_receiver_{this};
+  mojo::Remote<network::mojom::URLLoader> target_loader_;
+
+  base::WeakPtrFactory<InProgressRequest> weak_factory_{this};
+};
+
+// static
+void ProxyingURLLoaderFactory::MaybeProxyRequest(
+    content::BrowserContext* browser_context,
+    content::ContentBrowserClient::URLLoaderFactoryType type,
+    const net::IsolationInfo& isolation_info,
+    network::URLLoaderFactoryBuilder& factory_builder) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  using Type = content::ContentBrowserClient::URLLoaderFactoryType;
+  if (type == Type::kDownload || type == Type::kDevTools) {
+    return;
+  }
+  BrowserContextData::StartProxying(browser_context, isolation_info,
+                                    factory_builder);
+}
+
+// static
+void ProxyingURLLoaderFactory::MaybeConnectWebSocket(
+    content::RenderFrameHost* frame,
+    content::ContentBrowserClient::WebSocketFactory factory,
+    const GURL& url,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> header_client) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto connect = base::BindOnce(
+      [](content::ContentBrowserClient::WebSocketFactory factory,
+         const GURL& url,
+         mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+             handshake_client,
+         mojo::PendingRemote<network::mojom::TrustedHeaderClient>
+             header_client,
+         BlockResult result) {
+        // A blocked socket never connects: dropping the handshake client
+        // fails it in the page.
+        if (result.block) {
+          return;
+        }
+        std::move(factory).Run(url, {}, std::move(handshake_client),
+                               mojo::NullRemote(), std::move(header_client));
+      },
+      std::move(factory), url, std::move(handshake_client),
+      std::move(header_client));
+  const HostContentSettingsMap* settings =
+      HostContentSettingsMapFactory::GetForProfile(frame->GetBrowserContext());
+  if (!url.SchemeIsWSOrWSS() ||
+      AdsAllowed(settings,
+                 frame->GetOutermostMainFrame()->GetLastCommittedOrigin())) {
+    std::move(connect).Run(BlockResult());
+    return;
+  }
+  AdblockService::Get()->ShouldBlock(url, frame->GetLastCommittedOrigin(),
+                                     "websocket", "GET", std::move(connect));
+}
+
+ProxyingURLLoaderFactory::ProxyingURLLoaderFactory(
+    scoped_refptr<HostContentSettingsMap> settings,
+    const net::IsolationInfo& isolation_info,
+    network::URLLoaderFactoryBuilder& factory_builder,
+    DisconnectCallback on_disconnect)
+    : settings_(std::move(settings)),
+      top_frame_origin_(isolation_info.top_frame_origin()),
+      on_disconnect_(std::move(on_disconnect)) {
+  auto [loader_receiver, target_factory] = factory_builder.Append();
+  target_factory_.Bind(std::move(target_factory));
+  target_factory_.set_disconnect_handler(
+      base::BindOnce(&ProxyingURLLoaderFactory::OnTargetFactoryError,
+                     base::Unretained(this)));
+  proxy_receivers_.Add(this, std::move(loader_receiver));
+  proxy_receivers_.set_disconnect_handler(
+      base::BindRepeating(&ProxyingURLLoaderFactory::OnProxyBindingError,
+                          base::Unretained(this)));
+}
+
+ProxyingURLLoaderFactory::~ProxyingURLLoaderFactory() = default;
+
+void ProxyingURLLoaderFactory::CreateLoaderAndStart(
+    mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+    int32_t request_id,
+    uint32_t options,
+    const network::ResourceRequest& request,
+    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+    const net::MutableNetworkTrafficAnnotationTag& traffic_annotation) {
+  auto in_progress = std::make_unique<InProgressRequest>(
+      this, std::move(loader_receiver), request_id, options, request,
+      std::move(client), traffic_annotation);
+  InProgressRequest* raw = in_progress.get();
+  requests_.insert(std::move(in_progress));
+  raw->Start();
+}
+
+void ProxyingURLLoaderFactory::Clone(
+    mojo::PendingReceiver<network::mojom::URLLoaderFactory> loader_receiver) {
+  proxy_receivers_.Add(this, std::move(loader_receiver));
+}
+
+void ProxyingURLLoaderFactory::OnTargetFactoryError() {
+  // Stop calls to CreateLoaderAndStart() when `target_factory_` is invalid.
+  target_factory_.reset();
+  proxy_receivers_.Clear();
+  MaybeDestroySelf();
+}
+
+void ProxyingURLLoaderFactory::OnProxyBindingError() {
+  if (proxy_receivers_.empty()) {
+    target_factory_.reset();
+  }
+  MaybeDestroySelf();
+}
+
+void ProxyingURLLoaderFactory::RemoveRequest(InProgressRequest* request) {
+  auto it = requests_.find(request);
+  CHECK(it != requests_.end());
+  requests_.erase(it);
+  MaybeDestroySelf();
+}
+
+void ProxyingURLLoaderFactory::MaybeDestroySelf() {
+  // Even with every factory pipe closed, it stays alive until all active
+  // requests have completed.
+  if (target_factory_.is_bound() || !requests_.empty()) {
+    return;
+  }
+  // Deletes `this`.
+  std::move(on_disconnect_).Run(this);
+}
+
