--- a/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveNoTokenLogsTest.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveNoTokenLogsTest.java	2026-10-26 12:05:40.878063436 +0530
@@ -0,0 +1,100 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.app.Activity;
+
+import net.openid.appauth.AuthorizationException;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowLog;
+import org.robolectric.shadows.ShadowLooper;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccount.State;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccountTest.CountingStore;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccountTest.FakeBackend;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccountTest.Rotate;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+
+/** Sign-in, refresh and sign-out log nothing secret (spec §5.4). */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class ZynclaveNoTokenLogsTest {
+    private static final String[] SECRETS = {
+        "RT-SECRET", "AT-SECRET", "CODE-SECRET", "IDT-SECRET", "SUB-SECRET"
+    };
+
+    @Rule public TemporaryFolder mTemp = new TemporaryFolder();
+
+    @Test
+    public void testNoSecretsInLogs() {
+        ShadowLog.clear();
+        FakeBackend backend = new FakeBackend();
+        backend.mCode = "CODE-SECRET";
+        backend.mAccessToken = "AT-SECRET";
+        backend.mRefreshToken = "RT-SECRET";
+        backend.mIdToken = "IDT-SECRET";
+        // userinfo's sub, as the name too: what the row shows may be logged by nothing either.
+        backend.mName = "SUB-SECRET";
+        CountingStore store = new CountingStore(new File(mTemp.getRoot(), "zynclave"));
+        backend.mStore = store;
+        ZynclaveAccount account =
+                ZynclaveAccount.forTesting(backend, store, ZynclaveAccountTest.DIRECT);
+        Activity activity = Robolectric.buildActivity(Activity.class).setup().get();
+
+        // Sign in.
+        account.signIn(activity, false);
+        ShadowLooper.idleMainLooper();
+        account.onAuthorizationResult(
+                activity, backend.successFor(backend.lastRequest()), null);
+        ShadowLooper.idleMainLooper();
+        assertEquals(State.SIGNED_IN, account.state());
+
+        // A refresh that rotates, one that fails offline, then sign out everywhere.
+        backend.mRefreshResults.add(new Rotate("AT-SECRET-2", "RT-SECRET-2"));
+        account.freshTokens(token -> {});
+        ShadowLooper.idleMainLooper();
+        backend.mRefreshResults.add(
+                AuthorizationException.GeneralErrors.NETWORK_ERROR);
+        account.freshTokens(token -> {});
+        ShadowLooper.idleMainLooper();
+        backend.mRevokeFails = new IOException("offline");
+        account.signOut(true, activity);
+        ShadowLooper.idleMainLooper();
+        assertEquals(State.SIGNED_OUT, account.state());
+        assertEquals(1, backend.mOpened.size());
+
+        boolean logged = false;
+        for (ShadowLog.LogItem item : ShadowLog.getLogs()) {
+            if (item.tag != null && item.tag.contains("TarkZynclave")) logged = true;
+            StringBuilder text = new StringBuilder().append(item.tag).append(' ').append(item.msg);
+            if (item.throwable != null) {
+                StringWriter trace = new StringWriter();
+                item.throwable.printStackTrace(new PrintWriter(trace));
+                text.append(' ').append(trace);
+            }
+            for (String secret : SECRETS) {
+                assertFalse(
+                        "log line has " + secret + " (level " + item.type + ")",
+                        text.toString().contains(secret));
+            }
+        }
+        assertTrue("the flow logged its state changes", logged);
+    }
+}
