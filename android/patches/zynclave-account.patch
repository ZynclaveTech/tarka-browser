+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+
+import net.openid.appauth.AuthorizationException;
+import net.openid.appauth.AuthorizationResponse;
+
+import org.chromium.base.IntentUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Tark: a translucent, non-exported activity that opens AppAuth's sign-in intent (its
+ * AuthorizationManagementActivity, which opens Tark's Custom Tab) for a result, and hands that
+ * result to {@link ZynclaveAccount}. It finishes as soon as the result is in; the account goes
+ * on without it.
+ */
+@NullMarked
+public class ZynclaveAuthActivity extends Activity {
+    private static final String EXTRA_AUTH_INTENT =
+            "org.chromium.chrome.browser.tark.zynclave.AUTH_INTENT";
+    private static final int REQUEST_AUTH = 1;
+
+    static Intent createIntent(Context context, Intent authIntent) {
+        return new Intent(context, ZynclaveAuthActivity.class)
+                .putExtra(EXTRA_AUTH_INTENT, authIntent);
+    }
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        // Recreated (e.g. rotated) while AppAuth is open: its result still comes here.
+        if (savedInstanceState != null) return;
+        Intent authIntent = IntentUtils.safeGetParcelableExtra(getIntent(), EXTRA_AUTH_INTENT);
+        if (authIntent == null) {
+            deliver(null, null);
+            return;
+        }
+        try {
+            startActivityForResult(authIntent, REQUEST_AUTH);
+        } catch (ActivityNotFoundException e) {
+            deliver(
+                    null,
+                    AuthorizationException.fromTemplate(
+                            AuthorizationException.GeneralErrors.PROGRAM_CANCELED_AUTH_FLOW,
+                            null));
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, @Nullable Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode != REQUEST_AUTH) return;
+        AuthorizationResponse response = null;
+        AuthorizationException exception = null;
+        if (data != null) {
+            try {
+                response = AuthorizationResponse.fromIntent(data);
+                exception = AuthorizationException.fromIntent(data);
+            } catch (IllegalArgumentException e) {
+                exception =
+                        AuthorizationException.fromTemplate(
+                                AuthorizationException.GeneralErrors.JSON_DESERIALIZATION_ERROR,
+                                null);
+            }
+        }
+        if (response != null) exception = null;
+        // No data at all means the person backed out.
+        deliver(response, exception);
+    }
+
+    private void deliver(
+            @Nullable AuthorizationResponse response, @Nullable AuthorizationException exception) {
+        ZynclaveAccount.get().onAuthorizationResult(this, response, exception);
+        finish();
+    }
+}
diff --color '--color=never' -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlow.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlow.java
