+
+/**
+ * Tark: the Zynclave Account Tark is signed in to (spec §5.3–5.5, handoff §2). A UI-thread
+ * singleton: every public method is called on the UI thread, and observers run there.
+ *
+ * <p>All network, crypto and file work runs on one serial background executor ({@code bg}), so a
+ * refresh, a sign-in and a sign-out never overlap and a rotated refresh token is always saved
+ * before the next use. The {@link AuthState} and the {@link AuthStateStore} belong to {@code bg}.
+ *
+ * <p>Nothing is read at startup: the store is read on {@code bg} the first time {@link #state},
+ * {@link #name}, {@link #email}, {@link #freshTokens} or {@link #signOut} is called. Until that
+ * read finishes the state is {@link State#SIGNED_OUT}; observers run after it.
+ *
+ * <p>Logs (tag {@code TarkZynclave}) name only state changes and error types: never a token, a
+ * code, an id token, a {@code sub} or a URL with a query.
+ */
+@NullMarked
+public final class ZynclaveAccount {
+    private static final String TAG = "TarkZynclave";
+
+    /** The intent extra on the sign-in Custom Tab: {@link #pendingAuthToken} (spec §5.3). */
+    public static final String EXTRA_AUTH_TOKEN = "org.chromium.chrome.browser.tark.ZYNCLAVE_AUTH";
+
+    /** The OAuth error a refresh ends with when the refresh token is no longer valid. */
+    private static final String INVALID_GRANT = "invalid_grant";
+
+    /** Discovery's revocation endpoint (RFC 7009), which AppAuth doesn't model. */
+    private static final String REVOCATION_ENDPOINT = "revocation_endpoint";
+
+    public enum State {
+        SIGNED_OUT,
+        SIGNING_IN,
+        SIGNED_IN,
+        /** The refresh token was refused (invalid_grant): signed out, the last name kept. */
+        NEEDS_SIGN_IN_AGAIN,
+    }
+
+    /** What userinfo said; either may be missing. */
+    public static final class Profile {
+        private final @Nullable String mName;
+        private final @Nullable String mEmail;
+
+        public Profile(@Nullable String name, @Nullable String email) {
+            mName = name;
+            mEmail = email;
+        }
+
+        public @Nullable String name() {
+            return mName;
+        }
+
+        public @Nullable String email() {
+            return mEmail;
+        }
+    }
+
+    /**
+     * AppAuth and HTTP, replaced in tests. {@link #authorize} and {@link #openCustomTab} run on
+     * the UI thread, the rest on {@code bg} (they block).
+     */
+    interface Backend {
+        /** The issuer's OpenID Connect discovery document. */
+        @WorkerThread
+        AuthorizationServiceConfiguration fetchConfig(Uri issuer) throws IOException;
+
+        /** The code exchange, with AppAuth's ID token checks. */
+        @WorkerThread
+        TokenResponse exchange(TokenRequest request) throws AuthorizationException;
+
+        /** A refresh-token grant. The response carries the rotated refresh token. */
+        @WorkerThread
+        TokenResponse refresh(TokenRequest request) throws AuthorizationException;
+
+        @WorkerThread
+        Profile userinfo(Uri endpoint, String accessToken) throws IOException;
+
+        /** RFC 7009: POST token and client_id to {@code endpoint}. */
+        @WorkerThread
+        void revoke(Uri endpoint, String clientId, String refreshToken) throws IOException;
+
+        /**
+         * Opens {@code request} in Tark's own Custom Tab, marked with {@code authToken}; the
+         * result comes to {@link ZynclaveAccount#onAuthorizationResult}.
+         *
+         * @return false if Tark isn't available as the Custom Tab browser (nothing is opened).
+         */
+        @MainThread
+        boolean authorize(Activity activity, AuthorizationRequest request, String authToken);
+
+        /** Opens {@code uri} in Tark's own Custom Tab (normal profile). */
+        @MainThread
+        void openCustomTab(@Nullable Activity activity, Uri uri);
+    }
+
+    private static @Nullable ZynclaveAccount sInstance;
+
+    private final Backend mBackend;
+    private final Supplier<AuthStateStore> mStoreFactory;
+    private final Executor mBg;
+    private final ZynclaveConfig mConfig;
+    private final ObserverList<Runnable> mObservers = new ObserverList<>();
+    private final ObserverList<Runnable> mFailureObservers = new ObserverList<>();
+    private final SecureRandom mRandom = new SecureRandom();
+
+    /** Bumped by every sign-out: bg work begun before it doesn't write or change state. */
+    private final AtomicInteger mGeneration = new AtomicInteger();
+
+    // UI thread.
+    private State mState = State.SIGNED_OUT;
+    private @Nullable String mName;
+    private @Nullable String mEmail;
+    private boolean mLoadStarted;
+    // The state to return to if a sign-in is cancelled or fails.
+    private State mStateBeforeSignIn = State.SIGNED_OUT;
+    private @Nullable String mPendingAuthToken;
+    private boolean mPendingPromptNone;
+
+    // Discovery, cached in memory and dropped on any sign-in failure (spec §5.3). Set on bg, read
+    // on the UI thread to build a retry.
+    private volatile @Nullable AuthorizationServiceConfiguration mServiceConfig;
+
+    // bg only.
+    private @Nullable AuthStateStore mStore;
+    private @Nullable AuthState mAuth;
+    private @Nullable String mStoredName;
+    private @Nullable String mStoredEmail;
+
+    private ZynclaveAccount(
+            Backend backend,
+            Supplier<AuthStateStore> storeFactory,
+            Executor bg,
+            ZynclaveConfig config) {
+        mBackend = backend;
+        mStoreFactory = storeFactory;
+        mBg = bg;
+        mConfig = config;
+    }
+
+    /** The account. Creating it does no I/O. */
+    @MainThread
+    public static ZynclaveAccount get() {
+        ThreadUtils.assertOnUiThread();
+        if (sInstance == null) {
+            Executor bg =
+                    Executors.newSingleThreadExecutor(
+                            runnable -> {
+                                Thread thread = new Thread(runnable, "TarkZynclave");
+                                thread.setDaemon(true);
+                                return thread;
+                            });
+            sInstance =
+                    new ZynclaveAccount(
+                            new ZynclaveAuthFlow.AppAuthBackend(),
+                            () -> AuthStateStore.create(ContextUtils.getApplicationContext()),
+                            bg,
+                            ZynclaveConfig.get());
+        }
+        return sInstance;
+    }
+
+    /** Makes {@link #get} return an account on {@code backend}, {@code store} and {@code bg}. */
+    @VisibleForTesting
+    static ZynclaveAccount forTesting(Backend backend, AuthStateStore store, Executor bg) {
+        ZynclaveAccount account =
+                new ZynclaveAccount(backend, () -> store, bg, ZynclaveConfig.get());
+        ZynclaveAccount old = sInstance;
+        sInstance = account;
+        ResettersForTesting.register(() -> sInstance = old);
+        return account;
+    }
+
+    // ---- State -------------------------------------------------------------------------------
+
+    @MainThread
+    public State state() {
+        ensureLoaded();
+        return mState;
+    }
+
+    /** The display name from userinfo; kept in NEEDS_SIGN_IN_AGAIN for the row. */
+    @MainThread
+    public @Nullable String name() {
+        ensureLoaded();
+        return mName;
+    }
+
+    @MainThread
+    public @Nullable String email() {
+        ensureLoaded();
+        return mEmail;
+    }
+
+    /** {@code observer} runs on the UI thread after every state, name or email change. */
+    @MainThread
+    public void addObserver(Runnable observer) {
+        mObservers.addObserver(observer);
+    }
+
+    @MainThread
+    public void removeObserver(Runnable observer) {
+        mObservers.removeObserver(observer);
+    }
+
+    /**
+     * {@code observer} runs once for each sign-in that failed (not one that was cancelled):
+     * whoever started it shows "Couldn't sign in. Try again." (IDS_TARK_ZYNCLAVE_SIGN_IN_FAILED).
+     */
+    @MainThread
+    public void addSignInFailureObserver(Runnable observer) {
+        mFailureObservers.addObserver(observer);
+    }
+
+    @MainThread
+    public void removeSignInFailureObserver(Runnable observer) {
+        mFailureObservers.removeObserver(observer);
+    }
+
+    /** The random token on the pending sign-in Custom Tab's intent; null when none is pending. */
+    @MainThread
+    public @Nullable String pendingAuthToken() {
+        return mPendingAuthToken;
+    }
+
+    // ---- Sign-in -----------------------------------------------------------------------------
+
+    /**
+     * Starts a sign-in in Tark's own Custom Tab, from {@code activity}. With {@code promptNone}
+     * it first asks without a page (prompt=none) and asks once more with the page if the server
+     * says the person has to sign in. Does nothing while signing in or signed in.
+     */
+    @MainThread
+    public void signIn(Activity activity, boolean promptNone) {
+        ThreadUtils.assertOnUiThread();
+        ensureLoaded();
+        if (mState == State.SIGNING_IN || mState == State.SIGNED_IN) return;
+        mStateBeforeSignIn = mState;
+        setState(State.SIGNING_IN);
+        WeakReference<Activity> activityRef = new WeakReference<>(activity);
+        int generation = mGeneration.get();
+        mBg.execute(
+                () -> {
+                    AuthorizationServiceConfiguration config = mServiceConfig;
+                    if (config == null) {
+                        try {
+                            config = mBackend.fetchConfig(mConfig.issuer());
+                            mServiceConfig = config;
+                        } catch (IOException | RuntimeException e) {
+                            Log.i(TAG, "discovery failed: %s", e.getClass().getSimpleName());
+                            ThreadUtils.postOnUiThread(() -> signInFailed(generation));
+                            return;
+                        }
+                    }
+                    AuthorizationServiceConfiguration fetched = config;
+                    ThreadUtils.postOnUiThread(
+                            () -> {
+                                if (generation != mGeneration.get()) return;
+                                Activity from = activityRef.get();
+                                if (from == null || from.isFinishing() || from.isDestroyed()) {
+                                    // The person left before the page could open: like a cancel.
+                                    signInCancelled();
+                                    return;
+                                }
+                                launch(from, fetched, promptNone);
+                            });
+                });
+    }
+
+    @MainThread
+    private void launch(
+            Activity activity, AuthorizationServiceConfiguration config, boolean promptNone) {
+        AuthorizationRequest request = ZynclaveAuthFlow.buildRequest(mConfig, config, promptNone);
+        String token = newAuthToken();
+        mPendingAuthToken = token;
+        mPendingPromptNone = promptNone;
+        if (!mBackend.authorize(activity, request, token)) {
+            Log.i(TAG, "no custom tab");
+            mPendingAuthToken = null;
+            signInFailed(mGeneration.get());
+        }
+    }
+
+    /**
+     * The Custom Tab's result, from {@link ZynclaveAuthActivity}: exactly one of {@code response}
+     * and {@code exception} is non-null. {@code activity} is where a prompt=none retry opens; the
+     * rest goes on without it.
+     */
+    @MainThread
+    void onAuthorizationResult(
+            @Nullable Activity activity,
+            @Nullable AuthorizationResponse response,
+            @Nullable AuthorizationException exception) {
+        ThreadUtils.assertOnUiThread();
+        ensureLoaded();
+        boolean wasPromptNone = mPendingPromptNone;
+        mPendingAuthToken = null;
+        mPendingPromptNone = false;
+        if (mState != State.SIGNING_IN) {
+            // Not pending here: this branch exists for AppAuth's process-restore delivery. The
+            // process died while the tab was open, and AppAuth kept the request and hands its
+            // result to the new process. A stray or replayed result can't sign anyone in:
+            // AppAuth's own state check (the request's state parameter against the response's)
+            // rejects it before it reaches this method.
+            if (mState == State.SIGNED_IN) return;
+            mStateBeforeSignIn = mState;
+            setState(State.SIGNING_IN);
+        }
+        if (response != null) {
+            exchange(response);
+            return;
+        }
+        if (isCancel(exception)) {
+            Log.i(TAG, "sign-in cancelled");
+            signInCancelled();
+            return;
+        }
+        AuthorizationServiceConfiguration config = mServiceConfig;
+        if (wasPromptNone
+                && ZynclaveAuthFlow.shouldRetryInteractive(exception)
+                && config != null
+                && activity != null
+                && !activity.isFinishing()) {
+            Log.i(TAG, "prompt=none needs the page");
+            launch(activity, config, /* promptNone= */ false);
+            return;
+        }
+        Log.i(TAG, "authorization failed: %s", errorType(exception));
+        signInFailed(mGeneration.get());
+    }
+
+    @MainThread
+    private void exchange(AuthorizationResponse response) {
+        int generation = mGeneration.get();
+        mBg.execute(
+                () -> {
+                    AuthState auth = new AuthState(response, null);
+                    try {
+                        TokenResponse tokens =
+                                mBackend.exchange(response.createTokenExchangeRequest());
+                        auth.update(tokens, null);
+                    } catch (AuthorizationException | RuntimeException e) {
+                        Log.i(TAG, "code exchange failed: %s", errorType(e));
+                        ThreadUtils.postOnUiThread(() -> signInFailed(generation));
+                        return;
+                    }
+                    Profile profile = fetchProfile(auth);
+                    if (generation != mGeneration.get()) return;
+                    try {
+                        store().write(
+                                        new Stored(
+                                                auth.jsonSerializeString(),
+                                                profile.name(),
+                                                profile.email()));
+                    } catch (IOException | RuntimeException e) {
+                        Log.i(TAG, "saving failed: %s", e.getClass().getSimpleName());
+                        ThreadUtils.postOnUiThread(() -> signInFailed(generation));
+                        return;
+                    }
+                    mAuth = auth;
+                    mStoredName = profile.name();
+                    mStoredEmail = profile.email();
+                    ThreadUtils.postOnUiThread(
+                            () -> {
+                                if (generation != mGeneration.get()) return;
+                                mName = profile.name();
+                                mEmail = profile.email();
+                                Log.i(TAG, "signed in");
+                                setState(State.SIGNED_IN);
+                            });
+                });
+    }
+
+    @WorkerThread
+    private Profile fetchProfile(AuthState auth) {
+        AuthorizationServiceConfiguration config = auth.getAuthorizationServiceConfiguration();
+        String accessToken = auth.getAccessToken();
+        @Nullable Uri endpoint =
+                config == null || config.discoveryDoc == null
+                        ? null
+                        : config.discoveryDoc.getUserinfoEndpoint();
+        if (endpoint == null || accessToken == null) return new Profile(null, null);
+        try {
+            return mBackend.userinfo(endpoint, accessToken);
+        } catch (IOException | RuntimeException e) {
+            // Signed in all the same; the row says "Zynclave Account".
+            Log.i(TAG, "userinfo failed: %s", e.getClass().getSimpleName());
+            return new Profile(null, null);
+        }
+    }
+
+    @MainThread
+    private void signInCancelled() {
+        if (mState != State.SIGNING_IN) return;
+        setState(mStateBeforeSignIn);
+    }
+
+    @MainThread
+    private void signInFailed(int generation) {
+        mServiceConfig = null; // Refetched next time.
+        if (generation != mGeneration.get() || mState != State.SIGNING_IN) return;
+        setState(mStateBeforeSignIn);
+        for (Runnable observer : mFailureObservers) observer.run();
+    }
+
+    private static boolean isCancel(@Nullable AuthorizationException exception) {
+        return exception == null
+                || (exception.type == AuthorizationException.TYPE_GENERAL_ERROR
+                        && exception.code
+                                == AuthorizationException.GeneralErrors.USER_CANCELED_AUTH_FLOW
+                                        .code);
+    }
+
+    // ---- Tokens ------------------------------------------------------------------------------
+
+    /**
+     * Gives {@code callback} (on the UI thread) a valid access token, refreshing it first if it
+     * has expired, or null: signed out, offline, or the refresh token was refused (then the state
+     * becomes NEEDS_SIGN_IN_AGAIN). The rotated refresh token is saved before the callback runs.
+     * No retries.
+     */
+    @MainThread
+    public void freshTokens(Callback<@Nullable String> callback) {
+        ThreadUtils.assertOnUiThread();
+        ensureLoaded();
+        int generation = mGeneration.get();
+        mBg.execute(
+                () -> {
+                    String token = freshTokensOnBg(generation);
+                    ThreadUtils.postOnUiThread(() -> callback.onResult(token));
+                });
+    }
+
+    @WorkerThread
+    private @Nullable String freshTokensOnBg(int generation) {
+        AuthState auth = mAuth;
+        if (auth == null || generation != mGeneration.get()) return null;
+        if (!auth.getNeedsTokenRefresh()) return auth.getAccessToken();
+        TokenResponse tokens;
+        try {
+            tokens = mBackend.refresh(auth.createTokenRefreshRequest());
+        } catch (AuthorizationException e) {
+            if (e.type == AuthorizationException.TYPE_OAUTH_TOKEN_ERROR
+                    && INVALID_GRANT.equals(e.error)) {
+                Log.i(TAG, "refresh refused: needs sign-in again");
+                if (generation == mGeneration.get() && mAuth == auth) {
+                    mAuth = null;
+                    store().clear();
+                    ThreadUtils.postOnUiThread(
+                            () -> {
+                                if (generation != mGeneration.get()) return;
+                                if (mState == State.SIGNED_IN) setState(State.NEEDS_SIGN_IN_AGAIN);
+                            });
+                }
+            } else {
+                Log.i(TAG, "refresh failed: %s", errorType(e));
+            }
+            return null;
+        } catch (RuntimeException e) {
+            Log.i(TAG, "refresh failed: %s", e.getClass().getSimpleName());
+            return null;
+        }
+        // The same object a sign-out on bg would read next, so a revoke uses the new token.
+        auth.update(tokens, null);
+        if (generation != mGeneration.get() || mAuth != auth) return null; // Signed out meanwhile.
+        try {
+            store().write(new Stored(auth.jsonSerializeString(), mStoredName, mStoredEmail));
+        } catch (IOException | RuntimeException e) {
+            // Kept in memory for this run; the next run may have to sign in again.
+            Log.i(TAG, "saving failed: %s", e.getClass().getSimpleName());
+        }
+        return auth.getAccessToken();
+    }
+
+    // ---- Sign-out ----------------------------------------------------------------------------
+
+    /**
+     * Signs Tark out at once: revokes the refresh token, then deletes the stored account (even if
+     * the revoke failed, e.g. offline). With {@code everywhere} it then opens the Zynclave
+     * end-session page in Tark's Custom Tab, from {@code forEndSession}, to end the web session
+     * too. No post-logout redirect: Zynclave shows its own page.
+     */
+    @MainThread
+    public void signOut(boolean everywhere, @Nullable Activity forEndSession) {
+        ThreadUtils.assertOnUiThread();
+        ensureLoaded();
+        mGeneration.incrementAndGet();
+        mPendingAuthToken = null;
+        mPendingPromptNone = false;
+        mName = null;
+        mEmail = null;
+        Log.i(TAG, "signing out");
+        setState(State.SIGNED_OUT);
+        @Nullable WeakReference<Activity> activityRef =
+                forEndSession == null ? null : new WeakReference<>(forEndSession);
+        mBg.execute(
+                () -> {
+                    AuthState auth = mAuth;
+                    mAuth = null;
+                    mStoredName = null;
+                    mStoredEmail = null;
+                    @Nullable Uri endSession = null;
+                    try {
+                        if (auth != null) {
+                            revoke(auth);
+                            if (everywhere) endSession = endSessionUri(auth, mConfig.clientId());
+                        }
+                    } finally {
+                        store().clear();
+                    }
+                    if (endSession == null) return;
+                    Uri uri = endSession;
+                    ThreadUtils.postOnUiThread(
+                            () ->
+                                    mBackend.openCustomTab(
+                                            activityRef == null ? null : activityRef.get(), uri));
+                });
+    }
+
+    @WorkerThread
+    private void revoke(AuthState auth) {
+        String refreshToken = auth.getRefreshToken();
+        AuthorizationServiceConfiguration config = auth.getAuthorizationServiceConfiguration();
+        if (refreshToken == null || config == null || config.discoveryDoc == null) return;
+        String endpoint = config.discoveryDoc.docJson.optString(REVOCATION_ENDPOINT, "");
+        if (endpoint.isEmpty()) return;
+        try {
+            mBackend.revoke(Uri.parse(endpoint), mConfig.clientId(), refreshToken);
+        } catch (IOException | RuntimeException e) {
+            // Signed out locally all the same; the token expires on its own.
+            Log.i(TAG, "revoke failed: %s", e.getClass().getSimpleName());
+        }
+    }
+
+    /**
+     * The end-session page, identified by client_id (OpenID Connect RP-Initiated Logout 1.0).
+     * Never id_token_hint: the URL opens in a normal-profile Custom Tab, so it lands in history,
+     * and no token may be in any URL (spec §5.5, review ruling 2026-10-26).
+     */
+    @WorkerThread
+    private static @Nullable Uri endSessionUri(AuthState auth, String clientId) {
+        AuthorizationServiceConfiguration config = auth.getAuthorizationServiceConfiguration();
+        if (config == null) return null;
+        @Nullable Uri endpoint = config.endSessionEndpoint;
+        if (endpoint == null && config.discoveryDoc != null) {
+            endpoint = config.discoveryDoc.getEndSessionEndpoint();
+        }
+        if (endpoint == null) return null;
+        return endpoint.buildUpon().appendQueryParameter("client_id", clientId).build();
+    }
+
+    // ---- Loading -----------------------------------------------------------------------------
+
+    @MainThread
+    private void ensureLoaded() {
+        if (mLoadStarted) return;
+        mLoadStarted = true;
+        int generation = mGeneration.get();
+        mBg.execute(
+                () -> {
+                    Stored stored = store().read();
+                    AuthState auth = null;
+                    if (stored != null) {
+                        auth = parse(stored.authStateJson());
+                        if (auth == null) {
+                            store().clear();
+                        } else {
+                            mStoredName = stored.name();
+                            mStoredEmail = stored.email();
+                        }
+                    }
+                    mAuth = auth;
+                    AuthState loaded = auth;
+                    String name = mStoredName;
+                    String email = mStoredEmail;
+                    ThreadUtils.postOnUiThread(
+                            () -> {
+                                if (loaded != null && generation == mGeneration.get()) {
+                                    if (mState == State.SIGNED_OUT) {
+                                        mName = name;
+                                        mEmail = email;
+                                        mState = State.SIGNED_IN;
+                                        Log.i(TAG, "loaded: signed in");
+                                    } else if (mState == State.SIGNING_IN
+                                            && mStateBeforeSignIn == State.SIGNED_OUT) {
+                                        // A sign-in started before the load finished, while
+                                        // state() still said signed out. The stored account
+                                        // is what it started from: a cancel or a failure goes
+                                        // back to it, and a completed sign-in replaces it.
+                                        mName = name;
+                                        mEmail = email;
+                                        mStateBeforeSignIn = State.SIGNED_IN;
+                                        Log.i(TAG, "loaded: signed in, sign-in pending");
+                                    }
+                                }
+                                notifyObservers();
+                            });
+                });
+    }
+
+    @WorkerThread
+    private static @Nullable AuthState parse(String json) {
+        try {
+            AuthState auth = AuthState.jsonDeserialize(json);
+            return auth.getRefreshToken() == null ? null : auth;
+        } catch (JSONException | RuntimeException e) {
+            Log.i(TAG, "stored account unreadable: %s", e.getClass().getSimpleName());
+            return null;
+        }
+    }
+
+    @WorkerThread
+    private AuthStateStore store() {
+        if (mStore == null) mStore = mStoreFactory.get();
+        return mStore;
+    }
+
+    // ---- Helpers -----------------------------------------------------------------------------
+
+    @MainThread
+    private void setState(State state) {
+        if (mState == state) {
+            notifyObservers();
+            return;
+        }
+        mState = state;
+        Log.i(TAG, "state %s", state);
+        notifyObservers();
+    }
+
+    @MainThread
+    private void notifyObservers() {
+        for (Runnable observer : mObservers) observer.run();
+    }
+
+    private String newAuthToken() {
+        byte[] bytes = new byte[16];
+        mRandom.nextBytes(bytes);
+        return Base64.encodeToString(bytes, Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
+    }
+
+    /** An exception's type for the log: AppAuth's type and code, never its description. */
+    private static String errorType(@Nullable Exception e) {
+        if (e instanceof AuthorizationException ae) return "appauth " + ae.type + "/" + ae.code;
+        return e == null ? "none" : e.getClass().getSimpleName();
+    }
+}
