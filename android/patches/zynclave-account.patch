+    }
+}
diff --color '--color=never' -ruN a/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlowTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlowTest.java
--- a/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlowTest.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlowTest.java	2026-10-26 12:05:40.905414347 +0530
@@ -0,0 +1,137 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.net.Uri;
+
+import net.openid.appauth.AuthorizationException;
+import net.openid.appauth.AuthorizationException.AuthorizationRequestErrors;
+import net.openid.appauth.AuthorizationException.GeneralErrors;
+import net.openid.appauth.AuthorizationRequest;
+import net.openid.appauth.AuthorizationServiceConfiguration;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+
+import java.util.Arrays;
+import java.util.HashSet;
+
+/** Tests for {@link ZynclaveAuthFlow}'s request and {@link ZynclaveConfig}'s environments. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class ZynclaveAuthFlowTest {
+    private static AuthorizationServiceConfiguration service(ZynclaveConfig cfg) {
+        return new AuthorizationServiceConfiguration(
+                cfg.issuer().buildUpon().appendPath("oauth2").appendPath("auth").build(),
+                cfg.issuer().buildUpon().appendPath("oauth2").appendPath("token").build());
+    }
+
+    private static AuthorizationException oauthError(String error) {
+        return AuthorizationException.fromOAuthTemplate(
+                AuthorizationRequestErrors.byString(error), error, null, null);
+    }
+
+    /** A test environment: made-up values, never a real client's. */
+    private static ZynclaveConfig testConfig(boolean staging) {
+        return ZynclaveConfig.forTesting(
+                staging,
+                "https://auth.example.test/",
+                "test-client-" + (staging ? "staging" : "production"),
+                "accounts.example.test");
+    }
+
+    @Test
+    public void testRequest() {
+        ZynclaveConfig cfg = testConfig(false);
+        assertFalse(cfg.isStaging());
+        assertEquals(Uri.parse("https://auth.example.test/"), cfg.issuer());
+        assertEquals("accounts.example.test", cfg.accountsHost());
+
+        AuthorizationRequest request =
+                ZynclaveAuthFlow.buildRequest(cfg, service(cfg), /* promptNone= */ false);
+        assertEquals("test-client-production", request.clientId);
+        assertEquals(Uri.parse("com.gettarka.tarka:/oauth2redirect"), request.redirectUri);
+        assertEquals("code", request.responseType);
+        assertEquals("openid profile email offline_access", request.scope);
+        assertEquals(
+                new HashSet<>(Arrays.asList("openid", "profile", "email", "offline_access")),
+                request.getScopeSet());
+        assertEquals("S256", request.codeVerifierChallengeMethod);
+        assertNotNull(request.codeVerifier);
+        assertNotNull(request.state);
+        assertNotNull(request.nonce);
+        assertNull(request.prompt);
+    }
+
+    @Test
+    public void testStagingConfigKeepsItsValues() {
+        ZynclaveConfig cfg = testConfig(true);
+        assertTrue(cfg.isStaging());
+        AuthorizationRequest request =
+                ZynclaveAuthFlow.buildRequest(cfg, service(cfg), /* promptNone= */ false);
+        assertEquals("test-client-staging", request.clientId);
+        assertEquals(Uri.parse("com.gettarka.tarka:/oauth2redirect"), request.redirectUri);
+    }
+
+    @Test
+    public void testBuildConfigIsOneEnvironment() {
+        // get() is the generated class's one environment; a production build has production's.
+        ZynclaveConfig cfg = ZynclaveConfig.get();
+        assertEquals(TarkZynclaveBuildConfig.STAGING, cfg.isStaging());
+        assertEquals(TarkZynclaveBuildConfig.CLIENT_ID, cfg.clientId());
+        assertEquals(Uri.parse(TarkZynclaveBuildConfig.ISSUER), cfg.issuer());
+        assertEquals(TarkZynclaveBuildConfig.ACCOUNTS_HOST, cfg.accountsHost());
+        if (!cfg.isStaging()) {
+            assertEquals(Uri.parse("https://auth.zynclave.com/"), cfg.issuer());
+            assertEquals("fa54f2e8-2dfe-4c73-8002-01caea05f849", cfg.clientId());
+            assertEquals("accounts.zynclave.com", cfg.accountsHost());
+        } else {
+            assertTrue(cfg.accountsHost().contains("staging"));
+        }
+    }
+
+    @Test
+    public void testEachRequestIsFresh() {
+        ZynclaveConfig cfg = testConfig(false);
+        AuthorizationRequest a = ZynclaveAuthFlow.buildRequest(cfg, service(cfg), false);
+        AuthorizationRequest b = ZynclaveAuthFlow.buildRequest(cfg, service(cfg), false);
+        assertNotEquals(a.state, b.state);
+        assertNotEquals(a.nonce, b.nonce);
+        assertNotEquals(a.codeVerifier, b.codeVerifier);
+    }
+
+    @Test
+    public void testPromptNone() {
+        ZynclaveConfig cfg = testConfig(false);
+        AuthorizationRequest request =
+                ZynclaveAuthFlow.buildRequest(cfg, service(cfg), /* promptNone= */ true);
+        assertEquals("none", request.prompt);
+        assertEquals("none", request.toUri().getQueryParameter("prompt"));
+    }
+
+    @Test
+    public void testRetryOnlyOnInteractionErrors() {
+        assertTrue(ZynclaveAuthFlow.shouldRetryInteractive(oauthError("login_required")));
+        assertTrue(ZynclaveAuthFlow.shouldRetryInteractive(oauthError("interaction_required")));
+        assertTrue(ZynclaveAuthFlow.shouldRetryInteractive(oauthError("consent_required")));
+
+        assertFalse(ZynclaveAuthFlow.shouldRetryInteractive(oauthError("access_denied")));
+        assertFalse(
+                ZynclaveAuthFlow.shouldRetryInteractive(AuthorizationRequestErrors.ACCESS_DENIED));
+        assertFalse(ZynclaveAuthFlow.shouldRetryInteractive(GeneralErrors.NETWORK_ERROR));
+        assertFalse(ZynclaveAuthFlow.shouldRetryInteractive(GeneralErrors.USER_CANCELED_AUTH_FLOW));
+        assertFalse(ZynclaveAuthFlow.shouldRetryInteractive(null));
+    }
+}
