+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.net.Uri;
+
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Tark: the Zynclave Account that Sign in with Zynclave talks to (spec §5.1). Every published APK
+ * uses production; a test APK built with the GN arg tark_zynclave_staging uses staging. The values
+ * come from the generated TarkZynclaveBuildConfig, which holds one environment only.
+ */
+@NullMarked
+public final class ZynclaveConfig {
+    /** The redirect registered for both clients (scheme: Tark's package name). */
+    private static final String REDIRECT_URI = "com.gettarka.tarka:/oauth2redirect";
+
+    // The build's own environment only (TarkZynclaveBuildConfig.template): a production build has
+    // no staging values to choose.
+    private static final ZynclaveConfig BUILD =
+            new ZynclaveConfig(
+                    TarkZynclaveBuildConfig.STAGING,
+                    TarkZynclaveBuildConfig.ISSUER,
+                    TarkZynclaveBuildConfig.CLIENT_ID,
+                    TarkZynclaveBuildConfig.ACCOUNTS_HOST);
+
+    private final boolean mStaging;
+    private final Uri mIssuer;
+    private final String mClientId;
+    private final String mAccountsHost;
+    private final Uri mRedirectUri;
+
+    private ZynclaveConfig(boolean staging, String issuer, String clientId, String accountsHost) {
+        mStaging = staging;
+        mIssuer = Uri.parse(issuer);
+        mClientId = clientId;
+        mAccountsHost = accountsHost;
+        mRedirectUri = Uri.parse(REDIRECT_URI);
+    }
+
+    /** The build's environment. */
+    public static ZynclaveConfig get() {
+        return BUILD;
+    }
+
+    /** An environment with the test's own values; the build's real ones stay in {@link #get}. */
+    @VisibleForTesting
+    public static ZynclaveConfig forTesting(
+            boolean staging, String issuer, String clientId, String accountsHost) {
+        return new ZynclaveConfig(staging, issuer, clientId, accountsHost);
+    }
+
+    /** The OpenID Connect issuer (Hydra), with its trailing slash. */
+    public Uri issuer() {
+        return mIssuer;
+    }
+
+    /** Tark's public OAuth client (no secret: PKCE). */
+    public String clientId() {
+        return mClientId;
+    }
+
+    /** The host of the Zynclave Account web pages (handoff §2a). */
+    public String accountsHost() {
+        return mAccountsHost;
+    }
+
+    public Uri redirectUri() {
+        return mRedirectUri;
+    }
+
+    public boolean isStaging() {
+        return mStaging;
+    }
+}
