+
+        // The first question starts the read, on bg; until it's done the answer is signed out.
+        assertEquals(State.SIGNED_OUT, account.state());
+        assertEquals(0, store.mReads);
+        assertEquals(1, bg.size());
+
+        bg.poll().run();
