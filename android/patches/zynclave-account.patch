@@ -0,0 +1,330 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+
+import androidx.annotation.MainThread;
+import androidx.annotation.WorkerThread;
+import androidx.browser.customtabs.CustomTabsIntent;
+
+import net.openid.appauth.AppAuthConfiguration;
+import net.openid.appauth.AuthorizationException;
+import net.openid.appauth.AuthorizationRequest;
+import net.openid.appauth.AuthorizationService;
+import net.openid.appauth.AuthorizationServiceConfiguration;
+import net.openid.appauth.AuthorizationServiceDiscovery;
+import net.openid.appauth.NoClientAuthentication;
+import net.openid.appauth.ResponseTypeValues;
+import net.openid.appauth.TokenRequest;
+import net.openid.appauth.TokenResponse;
+import net.openid.appauth.connectivity.ConnectionBuilder;
+import net.openid.appauth.connectivity.DefaultConnectionBuilder;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Tark: Sign in with Zynclave's authorization request (spec §5.3): the code flow with PKCE (S256,
+ * AppAuth's default code verifier), a random state and nonce (AppAuth's defaults), the scopes
+ * {@code openid profile email offline_access} and Tark's redirect.
+ */
+@NullMarked
+public final class ZynclaveAuthFlow {
+    private ZynclaveAuthFlow() {}
+
+    /**
+     * The authorization request for {@code cfg}'s client at {@code svc}. With {@code promptNone}
+     * it asks for {@code prompt=none}: no page is shown, and the request fails instead if the
+     * person would have to sign in or consent (see {@link #shouldRetryInteractive}).
+     */
+    public static AuthorizationRequest buildRequest(
+            ZynclaveConfig cfg, AuthorizationServiceConfiguration svc, boolean promptNone) {
+        AuthorizationRequest.Builder builder =
+                new AuthorizationRequest.Builder(
+                                svc, cfg.clientId(), ResponseTypeValues.CODE, cfg.redirectUri())
+                        .setScopes(
+                                AuthorizationRequest.Scope.OPENID,
+                                AuthorizationRequest.Scope.PROFILE,
+                                AuthorizationRequest.Scope.EMAIL,
+                                AuthorizationRequest.Scope.OFFLINE_ACCESS);
+        if (promptNone) builder.setPrompt(AuthorizationRequest.Prompt.NONE);
+        return builder.build();
+    }
+
+    /**
+     * Whether a failed {@code prompt=none} request should be asked again with the sign-in page:
+     * only when the authorization server said the person has to sign in, interact or consent. Any
+     * other failure (access denied, network, a state mismatch) is final.
+     */
+    public static boolean shouldRetryInteractive(@Nullable AuthorizationException ex) {
+        if (ex == null || ex.type != AuthorizationException.TYPE_OAUTH_AUTHORIZATION_ERROR) {
+            return false;
+        }
+        // OpenID Connect Core §3.1.2.6: the errors a prompt=none request ends with when the
+        // person must act. AppAuth maps them to OTHER and keeps the server's string.
+        String error = ex.error;
+        return "login_required".equals(error)
+                || "interaction_required".equals(error)
+                || "consent_required".equals(error);
+    }
+
+    /** AppAuth's settings for Tark: the only browser it may open is Tark itself (spec §5.3). */
+    static AppAuthConfiguration appAuthConfiguration(Context context) {
+        String self = context.getPackageName();
+        return new AppAuthConfiguration.Builder()
+                .setBrowserMatcher(descriptor -> self.equals(descriptor.packageName))
+                .setConnectionBuilder(DefaultConnectionBuilder.INSTANCE)
+                .build();
+    }
+
+    /**
+     * A Custom Tab in Tark itself (normal profile): never another browser, never a WebView. The
+     * sign-in tab also carries {@code authToken}, which the redirect handling checks.
+     */
+    static CustomTabsIntent tarkCustomTab(Context context, @Nullable String authToken) {
+        CustomTabsIntent tab = new CustomTabsIntent.Builder().build();
+        tab.intent.setPackage(context.getPackageName());
+        if (authToken != null) tab.intent.putExtra(ZynclaveAccount.EXTRA_AUTH_TOKEN, authToken);
+        return tab;
+    }
+
+    /**
+     * The real {@link ZynclaveAccount.Backend}: AppAuth, and HttpURLConnection through its
+     * {@link ConnectionBuilder} (HTTPS only, with timeouts).
+     */
+    static final class AppAuthBackend implements ZynclaveAccount.Backend {
+        /** Longer than the connection builder's connect and read timeouts together. */
+        private static final long TOKEN_WAIT_SECONDS = 60;
+
+        private static final int MAX_BODY_BYTES = 64 * 1024;
+
+        private final ConnectionBuilder mConnections = DefaultConnectionBuilder.INSTANCE;
+        // For token requests only: it matches no browser, so it binds no Custom Tab service.
+        private @Nullable AuthorizationService mTokenService;
+
+        @Override
+        @WorkerThread
+        public AuthorizationServiceConfiguration fetchConfig(Uri issuer) throws IOException {
+            Uri uri =
+                    issuer.buildUpon()
+                            .appendPath(".well-known")
+                            .appendPath("openid-configuration")
+                            .build();
+            HttpURLConnection connection = mConnections.openConnection(uri);
+            try {
+                connection.setRequestMethod("GET");
+                connection.setRequestProperty("Accept", "application/json");
+                String body = readBody(connection);
+                return new AuthorizationServiceConfiguration(
+                        new AuthorizationServiceDiscovery(new JSONObject(body)));
+            } catch (JSONException | AuthorizationServiceDiscovery.MissingArgumentException e) {
+                throw new IOException("bad discovery document");
+            } finally {
+                connection.disconnect();
+            }
+        }
+
+        @Override
+        @WorkerThread
+        public TokenResponse exchange(TokenRequest request) throws AuthorizationException {
+            return tokenRequest(request);
+        }
+
+        @Override
+        @WorkerThread
+        public TokenResponse refresh(TokenRequest request) throws AuthorizationException {
+            return tokenRequest(request);
+        }
+
+        /**
+         * AppAuth's token request (which checks the ID token's iss, aud, exp, iat and nonce),
+         * started on the UI thread as AppAuth expects; this thread waits for its answer.
+         */
+        @WorkerThread
+        private TokenResponse tokenRequest(TokenRequest request) throws AuthorizationException {
+            CountDownLatch done = new CountDownLatch(1);
+            AtomicReference<@Nullable TokenResponse> response = new AtomicReference<>();
+            AtomicReference<@Nullable AuthorizationException> error = new AtomicReference<>();
+            ThreadUtils.postOnUiThread(
+                    () -> {
+                        try {
+                            tokenService()
+                                    .performTokenRequest(
+                                            request,
+                                            NoClientAuthentication.INSTANCE,
+                                            (tokens, ex) -> {
+                                                response.set(tokens);
+                                                error.set(ex);
+                                                done.countDown();
+                                            });
+                        } catch (RuntimeException e) {
+                            error.set(
+                                    AuthorizationException.fromTemplate(
+                                            AuthorizationException.GeneralErrors.NETWORK_ERROR,
+                                            null));
+                            done.countDown();
+                        }
+                    });
+            try {
+                if (!done.await(TOKEN_WAIT_SECONDS, TimeUnit.SECONDS)) {
+                    throw AuthorizationException.fromTemplate(
+                            AuthorizationException.GeneralErrors.NETWORK_ERROR, null);
+                }
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                throw AuthorizationException.fromTemplate(
+                        AuthorizationException.GeneralErrors.NETWORK_ERROR, null);
+            }
+            TokenResponse tokens = response.get();
+            if (tokens != null) return tokens;
+            AuthorizationException ex = error.get();
+            throw ex != null
+                    ? ex
+                    : AuthorizationException.fromTemplate(
+                            AuthorizationException.GeneralErrors.SERVER_ERROR, null);
+        }
+
+        @MainThread
+        private AuthorizationService tokenService() {
+            if (mTokenService == null) {
+                mTokenService =
+                        new AuthorizationService(
+                                ContextUtils.getApplicationContext(),
+                                new AppAuthConfiguration.Builder()
+                                        .setBrowserMatcher(descriptor -> false)
+                                        .setConnectionBuilder(mConnections)
+                                        .build());
+            }
+            return mTokenService;
+        }
+
+        @Override
+        @WorkerThread
+        public ZynclaveAccount.Profile userinfo(Uri endpoint, String accessToken)
+                throws IOException {
+            HttpURLConnection connection = mConnections.openConnection(endpoint);
+            try {
+                connection.setRequestMethod("GET");
+                connection.setRequestProperty("Accept", "application/json");
+                connection.setRequestProperty("Authorization", "Bearer " + accessToken);
+                JSONObject json = new JSONObject(readBody(connection));
+                return new ZynclaveAccount.Profile(
+                        optNonEmpty(json, "name"), optNonEmpty(json, "email"));
+            } catch (JSONException e) {
+                throw new IOException("bad userinfo");
+            } finally {
+                connection.disconnect();
+            }
+        }
+
+        @Override
+        @WorkerThread
+        public void revoke(Uri endpoint, String clientId, String refreshToken)
+                throws IOException {
+            byte[] form =
+                    ("token="
+                                    + URLEncoder.encode(refreshToken, "UTF-8")
+                                    + "&token_type_hint=refresh_token"
+                                    + "&client_id="
+                                    + URLEncoder.encode(clientId, "UTF-8"))
+                            .getBytes(StandardCharsets.UTF_8);
+            HttpURLConnection connection = mConnections.openConnection(endpoint);
+            try {
+                connection.setRequestMethod("POST");
+                connection.setDoOutput(true);
+                connection.setRequestProperty(
+                        "Content-Type", "application/x-www-form-urlencoded");
+                connection.setFixedLengthStreamingMode(form.length);
+                try (OutputStream out = connection.getOutputStream()) {
+                    out.write(form);
+                }
+                int code = connection.getResponseCode();
+                if (code != HttpURLConnection.HTTP_OK) throw new IOException("revoke " + code);
+            } finally {
+                connection.disconnect();
+            }
+        }
+
+        @Override
+        @MainThread
+        public boolean authorize(
+                Activity activity, AuthorizationRequest request, String authToken) {
+            AuthorizationService service =
+                    new AuthorizationService(activity, appAuthConfiguration(activity));
+            Intent authIntent;
+            try {
+                authIntent =
+                        service.getAuthorizationRequestIntent(
+                                request, tarkCustomTab(activity, authToken));
+            } catch (ActivityNotFoundException e) {
+                return false;
+            } finally {
+                service.dispose();
+            }
+            activity.startActivity(ZynclaveAuthActivity.createIntent(activity, authIntent));
+            return true;
+        }
+
+        @Override
+        @MainThread
+        public void openCustomTab(@Nullable Activity activity, Uri uri) {
+            Context context =
+                    activity != null && !activity.isFinishing()
+                            ? activity
+                            : ContextUtils.getApplicationContext();
+            CustomTabsIntent tab = tarkCustomTab(context, null);
+            if (!(context instanceof Activity)) {
+                tab.intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            }
+            try {
+                tab.launchUrl(context, uri);
+            } catch (ActivityNotFoundException e) {
+                // Nothing to open it in; Tark is signed out all the same.
+            }
+        }
+
+        private static String readBody(HttpURLConnection connection) throws IOException {
+            int code = connection.getResponseCode();
+            if (code != HttpURLConnection.HTTP_OK) throw new IOException("http " + code);
+            try (InputStream in = connection.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buffer = new byte[4096];
+                int n;
+                while ((n = in.read(buffer)) != -1) {
+                    out.write(buffer, 0, n);
+                    if (out.size() > MAX_BODY_BYTES) throw new IOException("too large");
+                }
+                return out.toString("UTF-8");
+            }
+        }
+
+        private static @Nullable String optNonEmpty(JSONObject json, String name) {
+            if (!json.has(name) || json.isNull(name)) return null;
+            String value = json.optString(name, "").trim();
+            return value.isEmpty() ? null : value;
+        }
+    }
+}
diff --color '--color=never' -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveConfig.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveConfig.java
