+/** Tests for {@link ZynclaveAccount}, on a fake backend and a direct background executor. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class ZynclaveAccountTest {
+    static final String ISSUER = "https://auth.staging.zynclave.com/";
+    static final String USERINFO = "https://auth.staging.zynclave.com/userinfo";
+    static final String REVOKE = "https://auth.staging.zynclave.com/oauth2/revoke";
+    static final String END_SESSION = "https://auth.staging.zynclave.com/oauth2/sessions/logout";
+
+    /** An AES-256 key held in memory: Robolectric has no AndroidKeyStore. */
+    static class SoftwareKeys implements KeyProvider {
+        private SecretKey mKey;
+
+        @Override
+        public SecretKey getOrCreate() throws GeneralSecurityException {
+            if (mKey == null) {
+                KeyGenerator generator = KeyGenerator.getInstance("AES");
+                generator.init(256);
+                mKey = generator.generateKey();
+            }
+            return mKey;
+        }
+
+        @Override
+        public void delete() {
+            mKey = null;
+        }
+    }
+
+    /** A store that counts its reads. */
+    static class CountingStore extends AuthStateStore {
+        int mReads;
+
+        CountingStore(File dir) {
+            super(dir, new SoftwareKeys());
+        }
+
+        @Override
+        public synchronized Stored read() {
+            mReads++;
+            return super.read();
+        }
+    }
+
+    /** A Zynclave Account in memory: hands out tokens with the given values, counts calls. */
+    static class FakeBackend implements ZynclaveAccount.Backend {
+        String mCode = "CODE-1";
+        String mAccessToken = "AT-1";
+        String mRefreshToken = "RT-1";
+        String mIdToken = "IDT-1";
+        String mName = "Asha Rao";
+        String mEmail = "asha@example.com";
+
+        final List<AuthorizationRequest> mAuthorizeRequests = new ArrayList<>();
+        final List<String> mAuthTokens = new ArrayList<>();
+        final List<TokenRequest> mRefreshRequests = new ArrayList<>();
+        final List<String> mRevoked = new ArrayList<>();
+        final List<Uri> mOpened = new ArrayList<>();
+        int mFetchConfigCalls;
+        int mUserinfoCalls;
+        String mUserinfoToken;
+        Uri mUserinfoEndpoint;
+        boolean mAuthorizeSucceeds = true;
+        IOException mRevokeFails;
+        /** Refresh results, in order: a {@link Rotate} to answer or an exception to throw. */
+        final ArrayDeque<Object> mRefreshResults = new ArrayDeque<>();
+        /** Runs inside the next refresh, before it returns. */
+        Runnable mDuringRefresh;
+        /** What revoke saw in the store when it ran. */
+        Stored mStoredAtRevoke;
+        AuthStateStore mStore;
+
+        @Override
+        public AuthorizationServiceConfiguration fetchConfig(Uri issuer) throws IOException {
+            mFetchConfigCalls++;
+            try {
+                JSONObject doc =
+                        new JSONObject()
+                                .put("issuer", ISSUER)
+                                .put("authorization_endpoint", ISSUER + "oauth2/auth")
+                                .put("token_endpoint", ISSUER + "oauth2/token")
+                                .put("jwks_uri", ISSUER + ".well-known/jwks.json")
+                                .put("userinfo_endpoint", USERINFO)
+                                .put("revocation_endpoint", REVOKE)
+                                .put("end_session_endpoint", END_SESSION)
+                                .put("response_types_supported", new JSONArray().put("code"))
+                                .put("subject_types_supported", new JSONArray().put("public"))
+                                .put(
+                                        "id_token_signing_alg_values_supported",
+                                        new JSONArray().put("RS256"));
+                return new AuthorizationServiceConfiguration(
+                        new AuthorizationServiceDiscovery(doc));
+            } catch (Exception e) {
+                throw new AssertionError(e);
+            }
+        }
+
+        TokenResponse tokens(TokenRequest request, String accessToken, String refreshToken) {
+            return new TokenResponse.Builder(request)
+                    .setTokenType("Bearer")
+                    .setAccessToken(accessToken)
+                    .setRefreshToken(refreshToken)
+                    .setIdToken(mIdToken)
+                    // Already expired: the next freshTokens refreshes.
+                    .setAccessTokenExpirationTime(System.currentTimeMillis() - 3_600_000L)
+                    .build();
+        }
+
+        @Override
+        public TokenResponse exchange(TokenRequest request) {
+            assertEquals(mCode, request.authorizationCode);
+            return tokens(request, mAccessToken, mRefreshToken);
+        }
+
+        @Override
+        public TokenResponse refresh(TokenRequest request) throws AuthorizationException {
+            mRefreshRequests.add(request);
+            if (mDuringRefresh != null) {
+                Runnable during = mDuringRefresh;
+                mDuringRefresh = null;
+                during.run();
+            }
+            Object result = mRefreshResults.poll();
+            if (result instanceof AuthorizationException e) throw e;
+            if (result instanceof Rotate r) return tokens(request, r.accessToken, r.refreshToken);
+            throw new AssertionError("unexpected refresh");
+        }
+
+        @Override
+        public ZynclaveAccount.Profile userinfo(Uri endpoint, String accessToken) {
+            mUserinfoCalls++;
+            mUserinfoEndpoint = endpoint;
+            mUserinfoToken = accessToken;
+            return new ZynclaveAccount.Profile(mName, mEmail);
+        }
+
+        @Override
+        public void revoke(Uri endpoint, String clientId, String refreshToken)
+                throws IOException {
+            assertEquals(REVOKE, endpoint.toString());
+            mRevoked.add(clientId + " " + refreshToken);
+            if (mStore != null) mStoredAtRevoke = mStore.read();
+            if (mRevokeFails != null) throw mRevokeFails;
+        }
+
+        @Override
+        public boolean authorize(
+                Activity activity, AuthorizationRequest request, String authToken) {
+            mAuthorizeRequests.add(request);
+            mAuthTokens.add(authToken);
+            return mAuthorizeSucceeds;
+        }
+
+        @Override
+        public void openCustomTab(Activity activity, Uri uri) {
+            mOpened.add(uri);
+        }
+
+        AuthorizationRequest lastRequest() {
+            return mAuthorizeRequests.get(mAuthorizeRequests.size() - 1);
+        }
+
+        AuthorizationResponse successFor(AuthorizationRequest request) {
+            return new AuthorizationResponse.Builder(request)
+                    .setAuthorizationCode(mCode)
+                    .setState(request.state)
+                    .build();
+        }
+    }
+
+    /** A refresh's answer: new tokens, the refresh token rotated. */
+    static final class Rotate {
+        final String accessToken;
+        final String refreshToken;
+
+        Rotate(String accessToken, String refreshToken) {
+            this.accessToken = accessToken;
+            this.refreshToken = refreshToken;
+        }
+    }
+
+    static final Executor DIRECT = Runnable::run;
+
+    @Rule public TemporaryFolder mTemp = new TemporaryFolder();
+
+    private FakeBackend mBackend;
+    private CountingStore mStore;
+    private ZynclaveAccount mAccount;
+    private Activity mActivity;
+    private int mFailures;
