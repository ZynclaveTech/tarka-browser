@@ -0,0 +1,80 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.net.Uri;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Tark: the Zynclave Account that Sign in with Zynclave talks to (spec §5.1). Every published APK
+ * uses production; a test APK built with the GN arg tark_zynclave_staging uses staging.
+ */
+@NullMarked
+public final class ZynclaveConfig {
+    /** The redirect registered for both clients (scheme: Tark's package name). */
+    private static final String REDIRECT_URI = "com.gettarka.tarka:/oauth2redirect";
+
+    private static final ZynclaveConfig PRODUCTION =
+            new ZynclaveConfig(
+                    /* staging= */ false,
+                    "https://auth.zynclave.com/",
+                    "fa54f2e8-2dfe-4c73-8002-01caea05f849",
+                    "accounts.zynclave.com");
+
+    private static final ZynclaveConfig STAGING =
+            new ZynclaveConfig(
+                    /* staging= */ true,
+                    "https://auth.staging.zynclave.com/",
+                    "1664a81e-6fe5-4eb9-9869-ca0c7a7a04c4",
+                    "accounts.staging.zynclave.com");
+
+    private final boolean mStaging;
+    private final Uri mIssuer;
+    private final String mClientId;
+    private final String mAccountsHost;
+    private final Uri mRedirectUri;
+
+    private ZynclaveConfig(boolean staging, String issuer, String clientId, String accountsHost) {
+        mStaging = staging;
+        mIssuer = Uri.parse(issuer);
+        mClientId = clientId;
+        mAccountsHost = accountsHost;
+        mRedirectUri = Uri.parse(REDIRECT_URI);
+    }
+
+    /** The build's environment. */
+    public static ZynclaveConfig get() {
+        return TarkZynclaveBuildConfig.STAGING ? STAGING : PRODUCTION;
+    }
+
+    /** Either environment, whatever the build's. */
+    public static ZynclaveConfig forTesting(boolean staging) {
+        return staging ? STAGING : PRODUCTION;
+    }
+
+    /** The OpenID Connect issuer (Hydra), with its trailing slash. */
+    public Uri issuer() {
+        return mIssuer;
+    }
+
+    /** Tark's public OAuth client (no secret: PKCE). */
+    public String clientId() {
+        return mClientId;
+    }
+
+    /** The host of the Zynclave Account web pages (handoff §2a). */
+    public String accountsHost() {
+        return mAccountsHost;
+    }
+
+    public Uri redirectUri() {
+        return mRedirectUri;
+    }
+
+    public boolean isStaging() {
+        return mStaging;
+    }
+}
