diff '--color=never' -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/AuthStateStore.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/AuthStateStore.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/AuthStateStore.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/AuthStateStore.java	2026-10-26 02:46:14.618469575 +0530
@@ -0,0 +1,198 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.content.Context;
+import android.security.keystore.KeyGenParameterSpec;
+import android.security.keystore.KeyProperties;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.StandardCopyOption;
+import java.security.GeneralSecurityException;
+import java.security.KeyStore;
+import java.util.Arrays;
+
+import javax.crypto.Cipher;
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+import javax.crypto.spec.GCMParameterSpec;
+
+/**
+ * Tark: Sign in with Zynclave's account store (spec §5.4). AppAuth's serialized state (the refresh
+ * token is in it) and the cached name and email are one JSON document, encrypted with AES-256-GCM
+ * under a non-exportable Android Keystore key and kept in {@code dir/account.bin} as a 12-byte IV
+ * followed by the ciphertext.
+ *
+ * <p>If the file can't be decrypted, or the key is gone or invalidated, the file is deleted, the
+ * key is dropped and the person is simply signed out. Nothing here throws on the read path. Calls
+ * are blocking: run them on the account executor, never on the UI thread.
+ */
+@NullMarked
+public class AuthStateStore {
+    private static final String TAG = "TarkZynclave";
+    private static final String KEY_ALIAS = "tark_zynclave_v1";
+    private static final String FILE_NAME = "account.bin";
+    private static final String TEMP_NAME = "account.bin.tmp";
+    private static final String TRANSFORMATION = "AES/GCM/NoPadding";
+    private static final int IV_BYTES = 12;
+    private static final int TAG_BITS = 128;
+    private static final int VERSION = 1;
+
+    /** What the store keeps: the AppAuth state JSON plus the cached userinfo. */
+    public record Stored(String authStateJson, @Nullable String name, @Nullable String email) {}
+
+    /** The encryption key's home, so tests can use a software key. */
+    public interface KeyProvider {
+        /** The existing key, or a new one if there is none. */
+        SecretKey getOrCreate() throws GeneralSecurityException;
+
+        /** Forgets the key. Never throws. */
+        void delete();
+    }
+
+    private final File mDir;
+    private final KeyProvider mKeys;
+
+    public AuthStateStore(File dir, KeyProvider keys) {
+        mDir = dir;
+        mKeys = keys;
+    }
+
+    /** The store for the app: {@code files/zynclave/} and the Keystore key {@code tark_zynclave_v1}. */
+    public static AuthStateStore create(Context context) {
+        return new AuthStateStore(
+                new File(context.getFilesDir(), "zynclave"), new KeystoreKeyProvider());
+    }
+
+    /** The stored account, or null if there is none or it can't be read (then it is cleared). */
+    public synchronized @Nullable Stored read() {
+        File file = new File(mDir, FILE_NAME);
+        if (!file.exists()) return null;
+        try {
+            byte[] blob = Files.readAllBytes(file.toPath());
+            if (blob.length <= IV_BYTES) throw new GeneralSecurityException("short file");
+            SecretKey key = mKeys.getOrCreate();
+            Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+            cipher.init(
+                    Cipher.DECRYPT_MODE,
+                    key,
+                    new GCMParameterSpec(TAG_BITS, blob, 0, IV_BYTES));
+            byte[] plain = cipher.doFinal(blob, IV_BYTES, blob.length - IV_BYTES);
+            JSONObject json = new JSONObject(new String(plain, StandardCharsets.UTF_8));
+            if (json.getInt("v") != VERSION) throw new GeneralSecurityException("version");
+            return new Stored(
+                    json.getString("auth"), optString(json, "name"), optString(json, "email"));
+        } catch (GeneralSecurityException | JSONException | IOException | RuntimeException e) {
+            Log.i(TAG, "Account file unreadable (%s); signing out", e.getClass().getSimpleName());
+            clear();
+            mKeys.delete();
+            return null;
+        }
+    }
+
+    /**
+     * Encrypts and saves {@code stored}, through a temp file and a rename so a crash leaves either
+     * the old file or the new one.
+     *
+     * @throws IOException if the key or the disk fails; the previous file is left as it was.
+     */
+    public synchronized void write(Stored stored) throws IOException {
+        try {
+            JSONObject json = new JSONObject();
+            json.put("v", VERSION);
+            json.put("auth", stored.authStateJson());
+            json.put("name", stored.name());
+            json.put("email", stored.email());
+            byte[] plain = json.toString().getBytes(StandardCharsets.UTF_8);
+
+            Cipher cipher = Cipher.getInstance(TRANSFORMATION);
+            cipher.init(Cipher.ENCRYPT_MODE, mKeys.getOrCreate());
+            byte[] iv = cipher.getIV();
+            if (iv == null || iv.length != IV_BYTES) {
+                throw new GeneralSecurityException("unexpected IV");
+            }
+            byte[] sealed = cipher.doFinal(plain);
+            byte[] blob = new byte[IV_BYTES + sealed.length];
+            System.arraycopy(iv, 0, blob, 0, IV_BYTES);
+            System.arraycopy(sealed, 0, blob, IV_BYTES, sealed.length);
+            Arrays.fill(plain, (byte) 0);
+
+            if (!mDir.isDirectory() && !mDir.mkdirs()) throw new IOException("no directory");
+            File temp = new File(mDir, TEMP_NAME);
+            try (FileOutputStream out = new FileOutputStream(temp)) {
+                out.write(blob);
+                out.getFD().sync();
+            }
+            Files.move(
+                    temp.toPath(),
+                    new File(mDir, FILE_NAME).toPath(),
+                    StandardCopyOption.ATOMIC_MOVE,
+                    StandardCopyOption.REPLACE_EXISTING);
+        } catch (GeneralSecurityException | JSONException e) {
+            throw new IOException("could not encrypt the account", e);
+        }
+    }
+
+    /** Deletes the account file (and any leftover temp file). The key is kept. */
+    public synchronized void clear() {
+        new File(mDir, FILE_NAME).delete();
+        new File(mDir, TEMP_NAME).delete();
+    }
+
+    private static @Nullable String optString(JSONObject json, String name) {
+        return json.isNull(name) ? null : json.optString(name, null);
+    }
+
+    /** The Android Keystore key: AES-256-GCM, random IVs, no user authentication. */
+    private static class KeystoreKeyProvider implements KeyProvider {
+        private static final String PROVIDER = "AndroidKeyStore";
+
+        @Override
+        public SecretKey getOrCreate() throws GeneralSecurityException {
+            try {
+                KeyStore store = KeyStore.getInstance(PROVIDER);
+                store.load(null);
+                if (store.getKey(KEY_ALIAS, null) instanceof SecretKey existing) return existing;
+                KeyGenerator generator =
+                        KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, PROVIDER);
+                generator.init(
+                        new KeyGenParameterSpec.Builder(
+                                        KEY_ALIAS,
+                                        KeyProperties.PURPOSE_ENCRYPT
+                                                | KeyProperties.PURPOSE_DECRYPT)
+                                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                                .setKeySize(256)
+                                .setRandomizedEncryptionRequired(true)
+                                .build());
+                return generator.generateKey();
+            } catch (IOException e) {
+                throw new GeneralSecurityException(e);
+            }
+        }
+
+        @Override
+        public void delete() {
+            try {
+                KeyStore store = KeyStore.getInstance(PROVIDER);
+                store.load(null);
+                store.deleteEntry(KEY_ALIAS);
+            } catch (GeneralSecurityException | IOException | RuntimeException e) {
+                Log.i(TAG, "Could not delete the key (%s)", e.getClass().getSimpleName());
+            }
+        }
+    }
+}
