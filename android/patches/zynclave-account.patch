--- a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlow.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAuthFlow.java	2026-10-26 02:33:08.778543128 +0530
@@ -0,0 +1,59 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import net.openid.appauth.AuthorizationException;
+import net.openid.appauth.AuthorizationRequest;
+import net.openid.appauth.AuthorizationServiceConfiguration;
+import net.openid.appauth.ResponseTypeValues;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Tark: Sign in with Zynclave's authorization request (spec §5.3): the code flow with PKCE (S256,
+ * AppAuth's default code verifier), a random state and nonce (AppAuth's defaults), the scopes
+ * {@code openid profile email offline_access} and Tark's redirect.
+ */
+@NullMarked
+public final class ZynclaveAuthFlow {
+    private ZynclaveAuthFlow() {}
+
+    /**
+     * The authorization request for {@code cfg}'s client at {@code svc}. With {@code promptNone}
+     * it asks for {@code prompt=none}: no page is shown, and the request fails instead if the
+     * person would have to sign in or consent (see {@link #shouldRetryInteractive}).
+     */
+    public static AuthorizationRequest buildRequest(
+            ZynclaveConfig cfg, AuthorizationServiceConfiguration svc, boolean promptNone) {
+        AuthorizationRequest.Builder builder =
+                new AuthorizationRequest.Builder(
+                                svc, cfg.clientId(), ResponseTypeValues.CODE, cfg.redirectUri())
+                        .setScopes(
+                                AuthorizationRequest.Scope.OPENID,
+                                AuthorizationRequest.Scope.PROFILE,
+                                AuthorizationRequest.Scope.EMAIL,
+                                AuthorizationRequest.Scope.OFFLINE_ACCESS);
+        if (promptNone) builder.setPrompt(AuthorizationRequest.Prompt.NONE);
+        return builder.build();
+    }
+
+    /**
+     * Whether a failed {@code prompt=none} request should be asked again with the sign-in page:
+     * only when the authorization server said the person has to sign in, interact or consent. Any
+     * other failure (access denied, network, a state mismatch) is final.
+     */
+    public static boolean shouldRetryInteractive(@Nullable AuthorizationException ex) {
+        if (ex == null || ex.type != AuthorizationException.TYPE_OAUTH_AUTHORIZATION_ERROR) {
+            return false;
+        }
+        // OpenID Connect Core §3.1.2.6: the errors a prompt=none request ends with when the
+        // person must act. AppAuth maps them to OTHER and keeps the server's string.
+        String error = ex.error;
+        return "login_required".equals(error)
+                || "interaction_required".equals(error)
+                || "consent_required".equals(error);
+    }
+}
diff '--color=never' -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveConfig.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveConfig.java
