+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.security.keystore.KeyPermanentlyInvalidatedException;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.tark.zynclave.AuthStateStore.KeyProvider;
+import org.chromium.chrome.browser.tark.zynclave.AuthStateStore.Stored;
+
+import java.io.File;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.security.GeneralSecurityException;
+
+import javax.crypto.KeyGenerator;
+import javax.crypto.SecretKey;
+
+/** Tests for {@link AuthStateStore}, with a software key: Robolectric has no AndroidKeyStore. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE)
+public class AuthStateStoreTest {
+    private static final String REFRESH_TOKEN = "rt-very-secret-refresh-token";
+    private static final String AUTH_JSON =
+            "{\"refreshToken\":\"" + REFRESH_TOKEN + "\",\"scope\":\"openid\"}";
+
+    /** An AES-256 key held in memory; counts the calls the store makes. */
+    private static class SoftwareKeys implements KeyProvider {
+        private SecretKey mKey;
+        int mDeleteCalls;
+
+        @Override
+        public SecretKey getOrCreate() throws GeneralSecurityException {
+            if (mKey == null) {
+                KeyGenerator generator = KeyGenerator.getInstance("AES");
+                generator.init(256);
+                mKey = generator.generateKey();
+            }
+            return mKey;
+        }
+
+        @Override
+        public void delete() {
+            mDeleteCalls++;
+            mKey = null;
+        }
+    }
+
+    @Rule public TemporaryFolder mTemp = new TemporaryFolder();
+
+    private File mDir;
+    private SoftwareKeys mKeys;
+    private AuthStateStore mStore;
+
+    @Before
+    public void setUp() {
+        mDir = new File(mTemp.getRoot(), "zynclave");
+        mKeys = new SoftwareKeys();
+        mStore = new AuthStateStore(mDir, mKeys);
+    }
+
+    private File accountFile() {
+        return new File(mDir, "account.bin");
+    }
+
+    @Test
+    public void testNothingStoredIsSignedOut() {
+        assertNull(mStore.read());
+        assertEquals(0, mKeys.mDeleteCalls);
+    }
+
+    @Test
+    public void testRoundTrip() throws Exception {
+        Stored saved = new Stored(AUTH_JSON, "Asha", "asha@example.com");
+        mStore.write(saved);
+        assertEquals(saved, mStore.read());
+
+        // A second store over the same file and key, as after a process restart.
+        assertEquals(saved, new AuthStateStore(mDir, mKeys).read());
+
+        Stored noProfile = new Stored(AUTH_JSON, null, null);
+        mStore.write(noProfile);
+        assertEquals(noProfile, mStore.read());
+        assertFalse(new File(mDir, "account.bin.tmp").exists());
+    }
+
+    @Test
+    public void testFileIsIvThenCiphertext() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, null, null));
+        byte[] first = Files.readAllBytes(accountFile().toPath());
+        assertTrue(first.length > 12 + 16);
+        mStore.write(new Stored(AUTH_JSON, null, null));
+        byte[] second = Files.readAllBytes(accountFile().toPath());
+        // Same plaintext, different IV: the bytes differ.
+        assertFalse(java.util.Arrays.equals(first, second));
+    }
+
+    @Test
+    public void testUndecryptableIsSignedOut() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, "Asha", "asha@example.com"));
+        byte[] bytes = Files.readAllBytes(accountFile().toPath());
+        bytes[bytes.length - 1] ^= 0x01;
+        Files.write(accountFile().toPath(), bytes);
+
+        assertNull(mStore.read());
+        assertFalse(accountFile().exists());
+        assertEquals(1, mKeys.mDeleteCalls);
+    }
+
+    @Test
+    public void testTruncatedFileIsSignedOut() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, null, null));
+        Files.write(accountFile().toPath(), new byte[5]);
+
+        assertNull(mStore.read());
+        assertFalse(accountFile().exists());
+        assertEquals(1, mKeys.mDeleteCalls);
+    }
+
+    @Test
+    public void testKeyLostIsSignedOut() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, "Asha", "asha@example.com"));
+        SoftwareKeys lost =
+                new SoftwareKeys() {
+                    @Override
+                    public SecretKey getOrCreate() throws GeneralSecurityException {
+                        throw new KeyPermanentlyInvalidatedException();
+                    }
+                };
+
+        assertNull(new AuthStateStore(mDir, lost).read());
+        assertFalse(accountFile().exists());
+        assertEquals(1, lost.mDeleteCalls);
+    }
+
+    @Test
+    public void testNewKeyCannotReadOldFile() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, null, null));
+
+        assertNull(new AuthStateStore(mDir, new SoftwareKeys()).read());
+        assertFalse(accountFile().exists());
+    }
+
+    @Test
+    public void testNoPlaintextOnDisk() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, "Asha", "asha@example.com"));
+        String onDisk =
+                new String(Files.readAllBytes(accountFile().toPath()), StandardCharsets.ISO_8859_1);
+
+        assertFalse(onDisk.contains(REFRESH_TOKEN));
+        assertFalse(onDisk.contains("Asha"));
+        assertFalse(onDisk.contains("asha@example.com"));
+        assertFalse(onDisk.contains("refreshToken"));
+    }
+
+    @Test
+    public void testClear() throws Exception {
+        mStore.write(new Stored(AUTH_JSON, "Asha", "asha@example.com"));
+        mStore.clear();
+
+        assertFalse(accountFile().exists());
+        assertNull(mStore.read());
+        mStore.clear();
+    }
+}
