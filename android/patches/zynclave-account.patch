+        ShadowLooper.idleMainLooper();
+        assertEquals(State.SIGNED_IN, mAccount.state());
+    }
+
+    private String[] freshToken() {
+        String[] result = {"not called"};
+        mAccount.freshTokens(token -> result[0] = token);
+        ShadowLooper.idleMainLooper();
+        return result;
+    }
