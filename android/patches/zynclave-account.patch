+        store.write(new Stored(signedInJson(), "Asha Rao", "asha@example.com"));
+        ArrayDeque<Runnable> bg = new ArrayDeque<>();
+        ZynclaveAccount account = ZynclaveAccount.forTesting(mBackend, store, bg::add);
+
+        // A tap before the load finished: the load and then the sign-in's discovery queue on bg.
+        account.signIn(mActivity, false);
+        assertEquals(State.SIGNING_IN, account.state());
+        while (!bg.isEmpty()) {
+            bg.poll().run();
+            ShadowLooper.idleMainLooper();
+        }
