+    {u'ছ', "chh"}, {u'জ', "j"},  {u'ঝ', "jh"}, {u'ঞ', "n"},  {u'ট', "t"},  {u'ঠ', "th"},
+    {u'ড', "d"},  {u'ঢ', "dh"}, {u'ণ', "n"},  {u'ত', "t"},  {u'থ', "th"}, {u'দ', "d"},
+    {u'ধ', "dh"}, {u'ন', "n"},  {u'প', "p"},  {u'ফ', "f"}, {u'ব', "b"},  {u'ভ', "bh"},
+    {u'ম', "m"},  {u'য', "j"},  {u'র', "r"},  {u'ল', "l"},  {u'শ', "sh"}, {u'ষ', "sh"},
+    {u'স', "s"},  {u'হ', "h"},  {u'\u09DC', "r"}, {u'\u09DD', "rh"}, {u'\u09DF', "y"}, {u'ৎ', "t"},
+};
+constexpr std::pair<char16_t, const char*> kBengaliNuktaConsonants[] = {
+    {u'ড', "r"}, {u'ঢ', "rh"}, {u'য', "y"},
+};
+constexpr std::pair<char16_t, const char*> kBengaliVowels[] = {
+    {u'অ', "o"}, {u'আ', "a"}, {u'ই', "i"},  {u'ঈ', "i"}, {u'উ', "u"}, {u'ঊ', "u"},
+    {u'ঋ', "ri"}, {u'এ', "e"}, {u'ঐ', "oi"}, {u'ও', "o"}, {u'ঔ', "ou"},
+};
+constexpr std::pair<char16_t, const char*> kBengaliSigns[] = {
+    {u'া', "a"}, {u'ি', "i"}, {u'ী', "i"},  {u'ু', "u"}, {u'ূ', "u"},
+    {u'ৃ', "ri"}, {u'ে', "e"}, {u'ৈ', "oi"}, {u'ো', "o"}, {u'ৌ', "ou"},
+};
+constexpr std::pair<char16_t, const char*> kBengaliCodas[] = {
+    {u'ং', "ng"}, {u'ঁ', "n"}, {u'ঃ', "h"},
+};
+
+const Table& TableFor(Language language) {
+  static const Table kHindi = {0x0900, 0x097F, "a", true, 0x094D, 0x093C,
+                               kHindiConsonants, kHindiNuktaConsonants, kHindiVowels,
+                               kHindiSigns, kHindiCodas};
+  static const Table kTamil = {0x0B80, 0x0BFF, "a", false, 0x0BCD, 0,
+                               kTamilConsonants, {}, kTamilVowels, kTamilSigns, kTamilCodas};
+  static const Table kBengali = {0x0980, 0x09FF, "o", true, 0x09CD, 0x09BC,
+                                 kBengaliConsonants, kBengaliNuktaConsonants, kBengaliVowels,
+                                 kBengaliSigns, kBengaliCodas};
+  switch (language) {
+    case Language::kHindi:
+      return kHindi;
+    case Language::kTamil:
+      return kTamil;
+    case Language::kBengali:
+      return kBengali;
+  }
+}
+
+const char* Find(base::span<const std::pair<char16_t, const char*>> list, char16_t c) {
+  for (const auto& [key, value] : list) {
+    if (key == c) {
+      return value;
+    }
+  }
+  return nullptr;
+}
+
+// Composite nukta letters (क़ U+0958 ... य़ U+095F) as consonant + nukta.
+std::u16string DecomposeNuktas(std::u16string_view text) {
+  static constexpr std::pair<char16_t, char16_t> kComposites[] = {
+      {0x0958, u'क'}, {0x0959, u'ख'}, {0x095A, u'ग'}, {0x095B, u'ज'},
+      {0x095C, u'ड'}, {0x095D, u'ढ'}, {0x095E, u'फ'}, {0x095F, u'य'},
+  };
+  std::u16string out;
+  for (char16_t c : text) {
+    bool done = false;
+    for (const auto& [composite, base] : kComposites) {
+      if (c == composite) {
+        out += base;
+        out += u'़';
+        done = true;
+        break;
+      }
+    }
+    if (!done) {
+      out += c;
+    }
+  }
+  return out;
+}
+
+// A written syllable: consonants (or none, for an independent vowel), its
+// vowel, and a nasal or visarga after it.
+struct Syllable {
+  std::string onset;
+  int consonants = 0;
+  std::string vowel;
+  bool inherent = false;  // `vowel` is the script's inherent vowel.
+  bool dropped = false;   // ... and it is silent.
+  std::string coda;
+};
+
+std::string RomanizeWord(std::u16string_view word, const Table& t) {
+  std::vector<Syllable> syllables;
+  size_t i = 0;
+  auto consonant_at = [&](size_t k, std::string* latin, size_t* used) {
+    const char16_t c = word[k];
+    if (t.nukta && k + 1 < word.size() && word[k + 1] == t.nukta) {
+      if (const char* n = Find(t.nukta_consonants, c)) {
+        *latin = n;
+        *used = 2;
+        return true;
+      }
+    }
+    if (const char* plain = Find(t.consonants, c)) {
+      *latin = plain;
+      *used = (t.nukta && k + 1 < word.size() && word[k + 1] == t.nukta) ? 2 : 1;
+      return true;
+    }
+    return false;
+  };
+  while (i < word.size()) {
+    Syllable s;
+    std::string latin;
+    size_t used = 0;
+    if (const char* v = Find(t.vowels, word[i])) {
+      s.vowel = v;
+      ++i;
+    } else if (consonant_at(i, &latin, &used)) {
+      std::vector<char16_t> cluster = {word[i]};
+      s.onset = latin;
+      s.consonants = 1;
+      i += used;
+      while (i + 1 < word.size() && word[i] == t.virama &&
+             consonant_at(i + 1, &latin, &used)) {
+        // Bengali য after a virama is the "y" sound (য-ফলা).
+        if (t.first == 0x0980 && word[i + 1] == u'য') {
+          latin = "y";
+        }
+        cluster.push_back(word[i + 1]);
+        s.onset += latin;
+        ++s.consonants;
+        i += 1 + used;
+      }
+      // Tamil clusters as they are said: ன்ற "ndr" (நன்றி "nandri"),
+      // ற்ற "tr" (மற்றும் "matrum"), ங்க "ng" (விளங்கும் "vilangum").
+      if (t.first == 0x0B80) {
+        if (cluster == std::vector<char16_t>{u'ன', u'ற'}) {
+          s.onset = "ndr";
+        } else if (cluster == std::vector<char16_t>{u'ற', u'ற'}) {
+          s.onset = "tr";
+        } else if (cluster == std::vector<char16_t>{u'ங', u'க'}) {
+          s.onset = "ng";
+        }
+      }
+      if (i < word.size() && Find(t.signs, word[i])) {
+        s.vowel = Find(t.signs, word[i]);
+        ++i;
+      } else if (i < word.size() && word[i] == t.virama) {
+        ++i;  // No vowel.
+      } else {
+        s.vowel = t.inherent;
+        s.inherent = true;
+      }
+    } else {
+      // Not a letter Tark knows (a sign or mark): kept as it is.
+      return base::UTF16ToUTF8(word);
+    }
+    while (i < word.size() && Find(t.codas, word[i])) {
+      s.coda += Find(t.codas, word[i]);
+      ++i;
+    }
+    syllables.push_back(std::move(s));
+  }
+  if (t.drops_inherent && syllables.size() > 1) {
+    // The last inherent vowel is silent (भारत "bharat").
+    Syllable& last = syllables.back();
+    if (last.inherent && last.coda.empty()) {
+      last.dropped = true;
+    }
+    // In the middle, a single consonant's inherent vowel is silent between
+    // an open syllable and a single consonant that has a vowel
+    // (कमला "kamla"; but ज़िंदगी "zindagi", नमस्ते "namaste").
+    for (size_t k = syllables.size() - 2; k >= 1; --k) {
+      Syllable& s = syllables[k];
+      const Syllable& before = syllables[k - 1];
+      const Syllable& after = syllables[k + 1];
+      const bool before_open = !before.vowel.empty() && !before.dropped && before.coda.empty();
+      const bool after_voiced = after.consonants == 1 && !after.vowel.empty() && !after.dropped;
+      if (s.inherent && s.consonants == 1 && s.coda.empty() && before_open && after_voiced) {
+        s.dropped = true;
+      }
+    }
+  }
+  std::string out;
+  for (size_t k = 0; k < syllables.size(); ++k) {
+    const Syllable& s = syllables[k];
+    out += s.onset;
+    if (!s.dropped) {
+      out += s.vowel;
+    }
+    // A nasal before p, b or m is said "m" (लंबी "lambi").
+    const bool before_labial = k + 1 < syllables.size() && !syllables[k + 1].onset.empty() &&
+                               (syllables[k + 1].onset[0] == 'p' ||
+                                syllables[k + 1].onset[0] == 'b' ||
+                                syllables[k + 1].onset[0] == 'm');
+    out += (before_labial && s.coda == "n") ? "m" : s.coda;
+  }
+  return out;
+}
+
+}  // namespace
+
+std::u16string Romanize(std::u16string_view input, Language language) {
+  const Table& t = TableFor(language);
+  const std::u16string text = DecomposeNuktas(input);
+  std::u16string out;
+  std::u16string word;
+  auto flush = [&] {
+    if (!word.empty()) {
+      out += base::UTF8ToUTF16(RomanizeWord(word, t));
+      word.clear();
+    }
+  };
+  for (char16_t c : text) {
+    if (c >= t.first && c <= t.last && c != 0x0964 && c != 0x0965) {
+      word += c;
+    } else {
+      flush();
+      out += c;
+    }
+  }
+  flush();
+  return out;
+}
+
+}  // namespace tark_captions
