+TEST(ClientLanguageTest, LockClearsTheGuess) {
+  ClientLanguage language(true);
+  language.Guessed("ta");
+  language.Detected("hi");
+  EXPECT_EQ(language.code(), "hi");
+  EXPECT_EQ(language.guess(), "");
+}
+
+TEST(ClientLanguageTest, PickDuringGuessWins) {
+  ClientLanguage language(true);
+  language.Guessed("hi");
+  language.Choose("ta");
+  EXPECT_EQ(language.guess(), "");
+  EXPECT_FALSE(language.Guessed("bn"));
+  language.Detected("hi");
+  EXPECT_EQ(language.code(), "ta");
+  EXPECT_FALSE(language.detected());
+}
+
+TEST(ClientLanguageTest, GuessFromAnotherPlayerReplaces) {
+  ClientLanguage language(true);
+  EXPECT_TRUE(language.Guessed("hi"));
+  EXPECT_TRUE(language.Guessed("ta"));
+  EXPECT_FALSE(language.Guessed("ta"));
+  EXPECT_EQ(language.guess(), "ta");
+}
+
+TEST(ClientLanguageTest, UrduGuessIsHindi) {
+  ClientLanguage language(true);
+  EXPECT_TRUE(language.Guessed("ur"));
+  EXPECT_EQ(language.guess(), "hi");
+}
+
+TEST(ClientLanguageTest, AppleCaptionsAcceptedForTheGuess) {
+  ClientLanguage language(true);
+  language.Guessed("es");
+  EXPECT_TRUE(language.AcceptsAppleCaptions("es-US"));
+  EXPECT_FALSE(language.AcceptsAppleCaptions("fr"));
+}
+
+// Without macOS 26's speech an Apple language can't be captioned: no guess.
+TEST(ClientLanguageTest, GuessOfAppleLanguageNeedsAppleSpeech) {
+  ClientLanguage language(/*apple_available=*/false);
+  EXPECT_FALSE(language.Guessed("es"));
+  EXPECT_EQ(language.guess(), "");
+  EXPECT_FALSE(language.Guessed("sw"));
+}
+
+TEST(ClientLanguageTest, LastLockIsRemembered) {
+  ClientLanguage language(true);
+  language.Detected("bn");
+  language.ChooseAuto();
+  EXPECT_EQ(language.last_locked(), "bn");
+  language.Choose("ta");
+  EXPECT_EQ(language.last_locked(), "bn");
+}
+
+// Review fix: a guess this machine can't caption (an Apple language without
+// macOS 26's speech) ends the current guess: the speech process stopped its
+// captions for it, and starts again from the first word on the next one.
+TEST(ClientLanguageTest, UnservableAppleGuessDropsTheGuess) {
+  ClientLanguage language(/*apple_available=*/false);
+  EXPECT_TRUE(language.Guessed("hi"));
+  EXPECT_TRUE(language.Guessed("es"));
+  EXPECT_EQ(language.guess(), "");
