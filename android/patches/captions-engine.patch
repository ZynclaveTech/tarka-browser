+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_RENDER_QUEUE_H_
+#define COMPONENTS_TARK_CAPTIONS_RENDER_QUEUE_H_
+
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+
+namespace tark_captions {
+
+struct RenderRequest {
+  bool is_final = false;
+  std::string text;
+  // The language it was heard in.
+  std::string source = "hi";  // The language code the caption was heard in.
+  // The choices (script, translation) it was asked with.
+  uint64_t generation = 0;
+  // A final's row in the captions history; 0 for drafts.
+  uint64_t history_id = 0;
+};
+
+// Which caption to send to the translator next (D4 Phase 2). Drafts come
+// every 0.8 s while someone speaks and a translation takes ~0.1 s, so:
+// one request at a time; a newer draft replaces a waiting one; finals are
+// all sent, in order, before a draft; a final replaces the draft waiting
+// before it; a result asked with old choices is not shown.
+class RenderQueue {
+ public:
+  RenderQueue();
+  RenderQueue(const RenderQueue&) = delete;
+  RenderQueue& operator=(const RenderQueue&) = delete;
+  ~RenderQueue();
+
+  void Add(bool is_final,
+           std::string text,
+           std::string source = "hi",
+           uint64_t history_id = 0);
+  // The next request, when none is in flight.
+  std::optional<RenderRequest> Next();
+  // The request in flight is done; true if its result is still current.
+  bool Done(uint64_t generation);
+  // The user changed a choice: results asked before are stale, and the
+  // waiting draft goes (the next one comes within a second).
+  void ChoicesChanged();
+  // The finals still waiting (not the one in flight), taken out; the
+  // waiting draft goes too.
+  std::vector<std::string> TakeWaitingFinals();
+  void Clear();
+
+ private:
+  struct Waiting {
+    std::string text;
+    std::string source;
+    uint64_t history_id = 0;
+  };
+  std::deque<Waiting> finals_;
+  std::optional<Waiting> draft_;
+  bool in_flight_ = false;
+  uint64_t generation_ = 0;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_RENDER_QUEUE_H_
