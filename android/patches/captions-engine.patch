+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_TEXT_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_TEXT_H_
+
+#include <string>
+
+namespace tark_captions {
+
+// What the caption box shows: the latest final text, followed by the draft
+// of what is being said now (drawn faded; it firms up when its final
+// arrives and replaces it). Only the newest characters that fit are kept,
+// cut at a word boundary, so the box stays at about two lines.
+class CaptionText {
+ public:
+  struct Display {
+    std::u16string committed;
+    std::u16string draft;
+  };
+
+  void AddFinal(const std::string& text);
+  void SetDraft(const std::string& text);
+  void Clear();
+
+  // At most `max_chars` (plus a joining space) of committed + draft.
+  Display GetDisplay(size_t max_chars) const;
+
+ private:
+  std::u16string committed_;
+  std::u16string draft_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_TEXT_H_
