+// found in the LICENSE file.
+
+// tark_captions_bench: cores used and draft lag of the caption engine on a
+// 5-minute Hindi track (the test clips repeated, with 0.8-2 s pauses).
+// tark_captions_bench --translate: translation time per caption (whole and
+// half captions, as finals and drafts) and peak memory with captions and
+// translation loaded.
+// tark_captions_bench --romanize: the test captions in English letters, to
+// review the spellings.
+
+#include <sys/resource.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "components/tark_captions/romanize.h"
+#include "components/tark_captions/translation_engine.h"
+
+#include "base/functional/callback_helpers.h"
+#include "components/tark_captions/caption_engine.h"
+#include "components/tark_captions/segmenter.h"
+#include "components/tark_captions/test_util.h"
+
+namespace {
+
+double CpuSeconds() {
+  rusage u;
+  getrusage(RUSAGE_SELF, &u);
+  return u.ru_utime.tv_sec + u.ru_utime.tv_usec / 1e6 + u.ru_stime.tv_sec + u.ru_stime.tv_usec / 1e6;
+}
+
+double PeakMegabytes() {
+  rusage u;
+  getrusage(RUSAGE_SELF, &u);
+  return u.ru_maxrss / 1048576.0;  // Bytes on macOS.
+}
+
+double Median(std::vector<double> v) {
+  std::sort(v.begin(), v.end());
+  return v[v.size() / 2];
+}
+
+int Translate(const base::FilePath& ort, const base::FilePath& models,
+              const base::FilePath& testdata) {
+  using namespace tark_captions;
+  std::unique_ptr<CaptionEngine> captions = CaptionEngine::Create(models, ort);
+  std::unique_ptr<TranslationEngine> engine = TranslationEngine::Create(models, ort);
+  if (!captions || !engine) {
+    fprintf(stderr, "engines not created\n");
+    return 1;
+  }
+  std::vector<double> full, draft, pivot;
+  for (const base::Value& v : test::MtGoldenCases(testdata)) {
+    const std::string caption = *v.GetDict().FindString("caption");
+    const Language language = *LanguageFromCode(*v.GetDict().FindString("lang"));
+    std::vector<std::string> words = base::SplitString(caption, " ", base::TRIM_WHITESPACE,
+                                                       base::SPLIT_WANT_NONEMPTY);
+    words.resize(std::max<size_t>(1, words.size() / 2));
+    base::TimeTicks t = base::TimeTicks::Now();
+    engine->Translate(caption, language, Target::kEnglish);
+    full.push_back((base::TimeTicks::Now() - t).InSecondsF());
+    t = base::TimeTicks::Now();
+    engine->Translate(base::JoinString(words, " "), language, Target::kEnglish);
+    draft.push_back((base::TimeTicks::Now() - t).InSecondsF());
+  }
+  const double peak_one = PeakMegabytes();
+  for (const base::Value& v : test::MtGoldenCases(testdata)) {
+    const Language language = *LanguageFromCode(*v.GetDict().FindString("lang"));
+    const Target target = language == Language::kHindi ? Target::kTamil : Target::kHindi;
+    base::TimeTicks t = base::TimeTicks::Now();
+    engine->Translate(*v.GetDict().FindString("caption"), language, target);
+    pivot.push_back((base::TimeTicks::Now() - t).InSecondsF());
+  }
+  printf("to English: whole %.3f s, half (draft) %.3f s; Indian to Indian %.3f s; "
+         "peak RSS captions + to-English %.0f MB, + both directions %.0f MB\n",
+         Median(full), Median(draft), Median(pivot), peak_one, PeakMegabytes());
+  return 0;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  using namespace tark_captions;
+  std::optional<base::FilePath> ort = test::OrtPath();
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    fprintf(stderr, "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA\n");
+    return 2;
+  }
+  if (argc > 1 && strcmp(argv[1], "--romanize") == 0) {
+    for (const base::Value& v : test::MtGoldenCases(*testdata)) {
+      const std::string caption = *v.GetDict().FindString("caption");
+      printf("%s\n  %s\n", caption.c_str(),
+             base::UTF16ToUTF8(Romanize(base::UTF8ToUTF16(caption),
+                                        *LanguageFromCode(*v.GetDict().FindString("lang"))))
+                 .c_str());
+    }
+    return 0;
+  }
+  if (argc > 1 && strcmp(argv[1], "--translate") == 0) {
+    return Translate(*ort, *models, *testdata);
+  }
+  std::vector<std::vector<float>> clips;
+  for (const base::Value& clip : test::GoldenClips(*testdata)) {
+    if (*clip.GetDict().FindString("lang") == "hi") {
+      int rate = 0;
+      clips.push_back(test::ReadWav(testdata->AppendASCII(*clip.GetDict().FindString("wav")), &rate));
+    }
+  }
+  std::vector<float> track;
+  for (int i = 0; track.size() < 300u * 16000; ++i) {
+    const std::vector<float>& clip = clips[i % clips.size()];
+    track.insert(track.end(), clip.begin(), clip.end());
+    track.insert(track.end(), static_cast<size_t>((0.8 + 0.4 * (i % 4)) * 16000), 0.0f);
+  }
+  std::unique_ptr<CaptionEngine> engine = CaptionEngine::Create(*models, *ort);
+  if (!engine) {
+    fprintf(stderr, "engine not created\n");
+    return 1;
+  }
+  const double cpu0 = CpuSeconds();
+  for (size_t i = 0; i < track.size(); i += 160) {
+    engine->AddAudio(base::span(track).subspan(i, std::min<size_t>(160, track.size() - i)), 1,
+                     16000, base::DoNothing());
+  }
+  engine->Flush(base::DoNothing());
+  const double cpu = CpuSeconds() - cpu0;
+  std::vector<double> times = engine->stats().decode_seconds;
+  std::sort(times.begin(), times.end());
+  const double audio = track.size() / 16000.0;
+  printf("audio %.0f s, decodes %d, cores used %.2f, decode median %.3f s p90 %.3f s, draft lag %.2f s\n",
+         audio, engine->stats().decodes, cpu / audio, times[times.size() / 2],
+         times[times.size() * 9 / 10], Segmenter::kDraftEvery / 2 + times[times.size() / 2]);
+  return 0;
+}
