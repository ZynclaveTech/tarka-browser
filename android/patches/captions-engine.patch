+namespace tark_captions {
+namespace {
+
+// IndicTrans2's model_max_length: 255 tokens and </s>.
+constexpr size_t kMaxSourceTokens = 255;
+constexpr char kEnglishTag[] = "eng_Latn";
+
+const char* FloresTag(Language language) {
+  switch (language) {
+    case Language::kHindi:
+      return "hin_Deva";
+    case Language::kTamil:
+      return "tam_Taml";
+    case Language::kBengali:
+      return "ben_Beng";
+  }
+}
+
+std::optional<Language> IndianLanguage(Target target) {
+  switch (target) {
+    case Target::kHindi:
+      return Language::kHindi;
+    case Target::kTamil:
+      return Language::kTamil;
+    case Target::kBengali:
+      return Language::kBengali;
+    case Target::kNone:
+    case Target::kEnglish:
+      return std::nullopt;
+  }
+}
+
+// A dict.*.json's {"token": id} entries: ParseFlatVocab, or base::JSONReader
+// when that declines (same result, slower). Nullopt when missing or not all
+// values are ints.
+std::optional<std::vector<std::pair<std::string, int>>> ReadVocab(const ModelSource& source,
+                                                                   std::string_view name);
+
+std::optional<base::DictValue> ReadJsonDict(const ModelSource& source, std::string_view name) {
+  std::optional<base::span<const uint8_t>> bytes = source.Read(name);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> value =
+      base::JSONReader::Read(base::as_string_view(*bytes), base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*value).TakeDict();
+}
+
+std::optional<std::vector<std::pair<std::string, int>>> ReadVocab(const ModelSource& source,
+                                                                   std::string_view name) {
+  std::optional<base::span<const uint8_t>> bytes = source.Read(name);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  const char* why = "";
+  size_t at = 0;
+  if (auto entries = ParseFlatVocab(base::as_string_view(*bytes), &why, &at)) {
+    DVLOG(1) << "tark-page: vocab " << name << " fast entries=" << entries->size();
+    return entries;
+  }
+  // The slow path is ~20 s on a phone: worth a warning.
+  LOG(WARNING) << "Tark translation: " << name << " fast path declined (" << why << " at byte "
+               << at << "), using base::JSONReader";
+  std::optional<base::DictValue> dict = ReadJsonDict(source, name);
+  if (!dict) {
+    return std::nullopt;
+  }
+  std::vector<std::pair<std::string, int>> entries;
+  entries.reserve(dict->size());
+  for (const auto [key, value] : *dict) {
+    if (!value.is_int()) {
+      return std::nullopt;
+    }
+    entries.emplace_back(key, value.GetInt());
+  }
+  return entries;
+}
+
+bool IsIndianCode(std::string_view code) {
+  return code == "hi" || code == "ta" || code == "bn";
+}
+
+}  // namespace
+
+std::vector<TranslationDirection> DirectionsFor(std::string_view source_code, Target target) {
+  using D = TranslationDirection;
+  if (target == Target::kNone) {
+    return {};
+  }
+  const bool to_english = target == Target::kEnglish;
+  if (IsIndianCode(source_code)) {
+    if (to_english) {
+      return {D::kIndicToEnglish};
+    }
+    if (IndianLanguage(target) == LanguageFromCode(source_code)) {
+      return {};
+    }
+    return {D::kIndicToEnglish, D::kEnglishToIndic};
+  }
+  if (source_code == "en") {
+    return to_english ? std::vector<D>{} : std::vector<D>{D::kEnglishToIndic};
+  }
+  if (source_code == "es") {
+    return to_english ? std::vector<D>{D::kSpanishToEnglish}
+                      : std::vector<D>{D::kSpanishToEnglish, D::kEnglishToIndic};
+  }
+  return {};
+}
+
+std::optional<Target> TargetFromCode(std::string_view code) {
+  if (code.empty()) {
+    return Target::kNone;
+  }
+  if (code == "en") {
+    return Target::kEnglish;
+  }
+  if (code == "hi") {
+    return Target::kHindi;
+  }
+  if (code == "ta") {
+    return Target::kTamil;
+  }
+  if (code == "bn") {
+    return Target::kBengali;
+  }
+  return std::nullopt;
+}
+
+// One translation direction: tokenizer, vocabularies and the two models.
+class TranslationEngine::Direction {
+ public:
+  // config.json, dict.SRC.json, dict.TGT.json, model.SRC (SentencePiece),
+  // encoder.int8.onnx and decoder_step.int8.onnx, from `source`.
+  // `threads`: ONNX Runtime's intra-op threads for each of the two models.
+  static std::unique_ptr<Direction> Load(OrtRuntime* runtime,
+                                         const ModelSource& source,
+                                         int threads) {
+    auto d = base::WrapUnique(new Direction());
+    // Diagnostics (DVLOG): where a model's load time goes.
+    const base::TimeTicks load_start = base::TimeTicks::Now();
+    auto ms = [](base::TimeTicks since) {
+      return (base::TimeTicks::Now() - since).InMilliseconds();
+    };
+    std::optional<base::DictValue> config = ReadJsonDict(source, "config.json");
+    std::optional<std::vector<std::pair<std::string, int>>> src =
+        ReadVocab(source, "dict.SRC.json");
+    std::optional<std::vector<std::pair<std::string, int>>> tgt =
+        ReadVocab(source, "dict.TGT.json");
+    const int64_t dicts_ms = ms(load_start);
+    const base::TimeTicks spm_start = base::TimeTicks::Now();
+    std::optional<base::span<const uint8_t>> spm = source.Read("model.SRC");
+    if (!config || !src || !tgt || !spm ||
+        !d->spm_.LoadFromSerializedProto(base::as_string_view(*spm)).ok()) {
+      LOG(ERROR) << "Tark translation: model files missing";
+      return nullptr;
+    }
+    // IndicTrans2 starts the source with its language tags; opus-mt has none.
+    d->language_tags_ = config->FindBool("language_tags").value_or(true);
+    std::optional<int> layers = config->FindInt("decoder_layers");
+    std::optional<int> heads = config->FindInt("decoder_attention_heads");
+    std::optional<int> dim = config->FindInt("decoder_embed_dim");
+    std::optional<int> start = config->FindInt("decoder_start_token_id");
+    std::optional<int> eos = config->FindInt("eos_token_id");
+    if (!layers || !heads || !dim || !start || !eos || *heads <= 0) {
+      return nullptr;
+    }
+    d->layers_ = *layers;
+    d->heads_ = *heads;
+    d->head_dim_ = *dim / *heads;
+    d->start_ = *start;
+    d->eos_ = *eos;
+    // A key given twice keeps its last id, as base::JSONReader did: flat_map
+    // keeps the first of equal keys, so the entries go in newest first.
+    std::vector<std::pair<std::string, int64_t>> src_entries;
+    src_entries.reserve(src->size());
+    for (auto it = src->rbegin(); it != src->rend(); ++it) {
+      src_entries.emplace_back(std::move(it->first), it->second);
+    }
+    d->src_vocab_ = base::flat_map<std::string, int64_t>(std::move(src_entries));
+    // The same for the target: one id per token, the last one given, then
+    // read in key order, so ids given twice resolve as base::JSONReader's
+    // sorted DictValue did.
+    std::vector<std::pair<std::string, int>> tgt_newest_first(
+        std::make_move_iterator(tgt->rbegin()), std::make_move_iterator(tgt->rend()));
+    const base::flat_map<std::string, int> tgt_map(std::move(tgt_newest_first));
+    for (const auto& [token, id] : tgt_map) {
+      if (id < 0) {
+        return nullptr;
+      }
+      if (static_cast<size_t>(id) >= d->tgt_vocab_.size()) {
+        d->tgt_vocab_.resize(id + 1);
+      }
+      d->tgt_vocab_[id] = token;
+    }
+    auto unk = d->src_vocab_.find("<unk>");
+    auto end = d->src_vocab_.find("</s>");
+    if (unk == d->src_vocab_.end() || end == d->src_vocab_.end()) {
+      return nullptr;
+    }
+    d->unk_ = unk->second;
+    d->end_ = end->second;
+    const int64_t vocab_ms = ms(spm_start);  // SentencePiece and the vocabularies' maps
+    const base::TimeTicks encoder_start = base::TimeTicks::Now();
+    d->encoder_ = runtime->LoadModel(source, "encoder.int8.onnx", threads);
+    const int64_t encoder_ms = ms(encoder_start);
+    const base::TimeTicks decoder_start = base::TimeTicks::Now();
+    d->decoder_ = runtime->LoadModel(source, "decoder_step.int8.onnx", threads);
+    const int64_t decoder_ms = ms(decoder_start);
+    DVLOG(1) << "tark-page: model load json_dicts_ms=" << dicts_ms << " vocab_ms=" << vocab_ms
+             << " encoder_session_ms=" << encoder_ms << " decoder_session_ms=" << decoder_ms
+             << " total_ms=" << ms(load_start);
+    if (!d->encoder_ || !d->decoder_) {
+      LOG(ERROR) << "Tark translation: models not loaded";
+      return nullptr;
+    }
+    return d;
+  }
+
+  // The language tags, then the SentencePiece pieces of `body`; at most
+  // 255 ids, then </s>.
+  std::vector<int64_t> Encode(std::string_view src_tag,
+                              std::string_view tgt_tag,
+                              std::string_view body) const {
+    std::vector<std::string> pieces;
+    if (language_tags_) {
+      pieces = {std::string(src_tag), std::string(tgt_tag)};
+    }
+    std::vector<std::string> body_pieces;
+    if (spm_.Encode(body, &body_pieces).ok()) {
+      pieces.insert(pieces.end(), body_pieces.begin(), body_pieces.end());
+    }
+    std::vector<int64_t> ids;
+    for (const std::string& piece : pieces) {
+      if (ids.size() == kMaxSourceTokens) {
+        break;
+      }
+      auto it = src_vocab_.find(piece);
+      ids.push_back(it == src_vocab_.end() ? unk_ : it->second);
+    }
+    ids.push_back(end_);
+    return ids;
+  }
+
+  std::optional<std::vector<int64_t>> Greedy(const std::vector<int64_t>& ids) {
+    const base::TimeTicks start = base::TimeTicks::Now();
+    std::vector<Tensor> encoded;
+    if (!encoder_->Run({Tensor{.name = "ids",
+                               .shape = {1, static_cast<int64_t>(ids.size())},
+                               .i64 = ids}},
+                       {"cross_mask", "cross_k", "cross_v"}, &encoded)) {
+      return std::nullopt;
+    }
+    const base::TimeDelta encoder_time = base::TimeTicks::Now() - start;
+    const std::vector<int64_t> empty_cache = {layers_, 1, heads_, 0, head_dim_};
+    std::vector<Tensor> inputs = {
+        Tensor{.name = "token", .shape = {1, 1}, .i64 = {start_}},
+        Tensor{.name = "step", .shape = {}, .i64 = {0}},
+        Tensor{.name = "past_k", .shape = empty_cache},
+        Tensor{.name = "past_v", .shape = empty_cache},
+        std::move(encoded[1]),
+        std::move(encoded[2]),
+        std::move(encoded[0]),
+    };
+    std::vector<int64_t> out;
+    std::vector<Tensor> step_out;
+    for (int step = 0; step < kMaxOutputTokens; ++step) {
+      inputs[1].i64[0] = step;
+      if (!decoder_->Run(inputs, {"logits", "new_k", "new_v"}, &step_out) ||
+          step_out[0].f32.empty()) {
+        return std::nullopt;
+      }
+      const std::vector<float>& logits = step_out[0].f32;
+      const int64_t token = std::max_element(logits.begin(), logits.end()) - logits.begin();
+      if (token == eos_) {
+        break;
+      }
+      out.push_back(token);
+      inputs[0].i64[0] = token;
+      inputs[2] = std::move(step_out[1]);
+      inputs[2].name = "past_k";
+      inputs[3] = std::move(step_out[2]);
+      inputs[3].name = "past_v";
+    }
+    if (!ran_.exchange(true)) {  // the first inference after a load (diagnostics)
+      DVLOG(1) << "tark-page: first inference source_tokens=" << ids.size()
+               << " output_tokens=" << out.size()
+               << " encoder_ms=" << encoder_time.InMilliseconds()
+               << " total_ms=" << (base::TimeTicks::Now() - start).InMilliseconds();
+    }
+    if (out.size() == static_cast<size_t>(kMaxOutputTokens)) {
+      // No end token within the output limit: the translation was cut off.
+      // Nullopt keeps the original (a page's text, or a caption shown alone)
+      // rather than half a sentence.
+      return std::nullopt;
+    }
+    return out;
+  }
+
+  // Target tokens joined, without <s>, <pad>, </s>, <unk>; ▁ is a space.
+  std::string Decode(const std::vector<int64_t>& ids) const {
+    std::string text;
+    for (int64_t id : ids) {
+      if (id < 0 || static_cast<size_t>(id) >= tgt_vocab_.size()) {
+        continue;
+      }
+      const std::string& token = tgt_vocab_[id];
+      if (token.empty() || token == "<s>" || token == "<pad>" || token == "</s>" ||
+          token == "<unk>") {
+        continue;
+      }
+      text += token;
+    }
+    base::ReplaceSubstringsAfterOffset(&text, 0, "\xE2\x96\x81", " ");
+    return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  }
+
+ private:
+  Direction() = default;
+
+
+  std::unique_ptr<OrtModel> encoder_;
+  std::unique_ptr<OrtModel> decoder_;
+  sentencepiece::SentencePieceProcessor spm_;
+  base::flat_map<std::string, int64_t> src_vocab_;
+  std::vector<std::string> tgt_vocab_;
+  int64_t layers_ = 0;
+  int64_t heads_ = 0;
+  int64_t head_dim_ = 0;
+  int64_t start_ = 0;
+  int64_t eos_ = 0;
+  int64_t unk_ = 0;
+  int64_t end_ = 0;
+  bool language_tags_ = true;
+  // Greedy runs on several threads at once (TranslatePages).
+  std::atomic<bool> ran_ = false;
+};
+
+// static
+std::unique_ptr<TranslationEngine> TranslationEngine::Create(const base::FilePath& models_dir,
+                                                             const base::FilePath& ort_dylib,
+                                                             int threads) {
+  std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources;
+  sources[TranslationDirection::kIndicToEnglish] =
+      std::make_unique<DirectorySource>(models_dir.Append("it2_indic_en"));
+  sources[TranslationDirection::kEnglishToIndic] =
+      std::make_unique<DirectorySource>(models_dir.Append("it2_en_indic"));
+  sources[TranslationDirection::kSpanishToEnglish] =
+      std::make_unique<DirectorySource>(models_dir.Append("opus_es_en"));
+  return Create(OrtRuntime::Load(ort_dylib), std::move(sources), threads);
+}
+
+// static
+std::unique_ptr<TranslationEngine> TranslationEngine::Create(
+    std::unique_ptr<OrtRuntime> runtime,
+    std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources,
+    int threads) {
+  if (!runtime) {
+    return nullptr;
+  }
+  return base::WrapUnique(new TranslationEngine(std::move(runtime), std::move(sources), threads));
+}
+
+TranslationEngine::TranslationEngine(
+    std::unique_ptr<OrtRuntime> runtime,
+    std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources,
+    int threads)
+    : runtime_(std::move(runtime)), sources_(std::move(sources)), threads_(threads) {}
+
+TranslationEngine::~TranslationEngine() {
+  // The models before the runtime that loaded them.
+  loaded_.clear();
+}
+
+TranslationEngine::Direction* TranslationEngine::Get(TranslationDirection direction) {
+  auto loaded = loaded_.find(direction);
+  if (loaded != loaded_.end()) {
+    return loaded->second.get();
+  }
+  // TranslatePages' workers run on several threads: loaded_ is read-only
+  // then (everything they need loaded before they started).
+  DCHECK(!lookup_only_) << "a model loads during a parallel run";
+  if (lookup_only_) {
+    return nullptr;
+  }
+  auto source = sources_.find(direction);
+  if (source == sources_.end()) {
+    return nullptr;
+  }
+  // Not remembered when missing: the models may arrive later.
+  std::unique_ptr<Direction> d = Direction::Load(runtime_.get(), *source->second, threads_);
+  Direction* raw = d.get();
+  if (d) {
+    loaded_[direction] = std::move(d);
+  }
+  return raw;
+}
+
+std::optional<std::string> TranslationEngine::Translate(std::string_view caption,
+                                                        Language source,
+                                                        Target target,
+                                                        TranslationTrace* trace) {
+  const std::optional<Language> indian_target = IndianLanguage(target);
+  if (target == Target::kNone || indian_target == source) {
+    return std::string();
+  }
+  Direction* to_english = Get(TranslationDirection::kIndicToEnglish);
+  if (!to_english) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> src_ids =
+      to_english->Encode(FloresTag(source), kEnglishTag, ModelInput(caption, source));
+  std::optional<std::vector<int64_t>> out_ids = to_english->Greedy(src_ids);
+  if (!out_ids) {
+    return std::nullopt;
+  }
+  if (trace) {
+    trace->src_ids = src_ids;
+    trace->out_ids = *out_ids;
+  }
+  const std::string english_tokens = to_english->Decode(*out_ids);
+  if (!indian_target) {
+    return DetokenizeEnglish(english_tokens);
+  }
+  // Indian to Indian: the English model tokens go straight into the second
+  // hop.
+  return IntoIndian(english_tokens, *indian_target,
+                    trace ? &trace->pivot_src_ids : nullptr,
+                    trace ? &trace->pivot_out_ids : nullptr);
+}
+
+std::optional<std::string> TranslationEngine::TranslateFrom(std::string_view caption,
+                                                            std::string_view source_code,
+                                                            Target target,
+                                                            TranslationTrace* trace) {
+  if (base::TrimWhitespaceASCII(caption, base::TRIM_ALL).empty() ||
+      DirectionsFor(source_code, target).empty()) {
+    return std::string();
+  }
+  if (IsIndianCode(source_code)) {
+    return Translate(caption, *LanguageFromCode(source_code), target, trace);
+  }
+  if (source_code == "en") {
+    return TranslateEnglish(caption, target, trace);
+  }
+  // Spanish: opus-mt into English, then (an Indian target) English → Indian.
+  Direction* spanish = Get(TranslationDirection::kSpanishToEnglish);
+  if (!spanish) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> src_ids = spanish->Encode("", "", caption);
+  std::optional<std::vector<int64_t>> out_ids = spanish->Greedy(src_ids);
+  if (!out_ids) {
+    return std::nullopt;
+  }
+  if (trace) {
+    trace->src_ids = src_ids;
+    trace->out_ids = *out_ids;
+  }
+  const std::string english = spanish->Decode(*out_ids);
+  const std::optional<Language> indian_target = IndianLanguage(target);
+  if (!indian_target) {
+    return english;
+  }
+  return IntoIndian(EnglishModelInput(english), *indian_target,
+                    trace ? &trace->pivot_src_ids : nullptr,
+                    trace ? &trace->pivot_out_ids : nullptr);
+}
+
+bool TranslationEngine::Preload(TranslationDirection direction) {
+  return Get(direction) != nullptr;
+}
+
+int TranslationEngine::LoadedDirectionsForTesting() const {
+  return static_cast<int>(loaded_.size());
+}
+
+std::optional<std::string> TranslationEngine::TranslateEnglish(std::string_view text,
+                                                               Target target,
+                                                               TranslationTrace* trace) {
+  const std::optional<Language> indian_target = IndianLanguage(target);
+  if (!indian_target) {
+    return std::string();
+  }
+  return IntoIndian(EnglishModelInput(text), *indian_target,
+                    trace ? &trace->src_ids : nullptr, trace ? &trace->out_ids : nullptr);
+}
+
+std::optional<std::string> TranslationEngine::IntoIndian(std::string_view model_input,
+                                                         Language target,
+                                                         std::vector<int64_t>* src_ids,
+                                                         std::vector<int64_t>* out_ids) {
+  Direction* from_english = Get(TranslationDirection::kEnglishToIndic);
+  if (!from_english) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> src =
+      from_english->Encode(kEnglishTag, FloresTag(target), model_input);
+  std::optional<std::vector<int64_t>> out = from_english->Greedy(src);
+  if (!out) {
+    return std::nullopt;
+  }
+  if (src_ids) {
+    *src_ids = src;
+    *out_ids = *out;
+  }
+  // IndicTrans2 writes every Indian language in Devanagari.
+  return base::UTF16ToUTF8(DetokenizeIndic(ConvertScript(
+      base::UTF8ToUTF16(from_english->Decode(*out)), Script::kDevanagari, ScriptOf(target))));
+}
+
+// Page translation: the 22 Indian languages.
+
+namespace {
+
+constexpr IndicLanguage kIndicLanguages[] = {
+    {"as", "asm_Beng", 0x0980},  {"bn", "ben_Beng", 0x0980}, {"brx", "brx_Deva", 0x0900},
+    {"doi", "doi_Deva", 0x0900}, {"gu", "guj_Gujr", 0x0A80}, {"hi", "hin_Deva", 0x0900},
+    {"kn", "kan_Knda", 0x0C80},  {"ks", "kas_Arab", 0},      {"kok", "gom_Deva", 0x0900},
+    {"mai", "mai_Deva", 0x0900}, {"ml", "mal_Mlym", 0x0D00}, {"mni", "mni_Beng", 0x0980},
+    {"mr", "mar_Deva", 0x0900},  {"ne", "npi_Deva", 0x0900}, {"or", "ory_Orya", 0x0B00},
+    {"pa", "pan_Guru", 0x0A00},  {"sa", "san_Deva", 0x0900}, {"sat", "sat_Olck", 0},
+    {"sd", "snd_Arab", 0},       {"ta", "tam_Taml", 0x0B80}, {"te", "tel_Telu", 0x0C00},
+    {"ur", "urd_Arab", 0},
+};
+
+// IndicNLP's UnicodeIndicTransliterator between two Brahmi blocks: the
+// letter at the same offset (dandas kept); a 0 block leaves the text alone.
+std::u16string ShiftBlock(std::u16string_view text, char16_t from, char16_t to) {
+  if (from == 0 || to == 0 || from == to) {
+    return std::u16string(text);
+  }
+  std::u16string out;
+  out.reserve(text.size());
+  for (char16_t c : text) {
+    const int offset = static_cast<int>(c) - from;
+    if (offset >= 0 && offset <= 0x6F && c != u'\u0964' && c != u'\u0965') {
+      out.push_back(static_cast<char16_t>(to + offset));
+    } else {
+      out.push_back(c);
+    }
+  }
+  return out;
+}
+
+// What IndicTransToolkit feeds the model for page text in `language`:
+// spaces collapsed, tokenised, in Devanagari for a Brahmi script.
+std::string PageModelInput(std::string_view text, const IndicLanguage& language) {
+  std::u16string s = base::UTF8ToUTF16(text);
+  s = std::u16string(base::CollapseWhitespace(s, /*trim_sequences_with_line_breaks=*/true));
+  s = TokenizeIndic(s);
+  s = ShiftBlock(s, language.block, 0x0900);
+  base::ReplaceSubstringsAfterOffset(&s, 0, u" \u094D ", u"\u094D");
+  return base::UTF16ToUTF8(base::TrimWhitespace(s, base::TRIM_ALL));
+}
+
+bool IsCaptionsCode(std::string_view code) {
+  return code == "hi" || code == "ta" || code == "bn" || code == "en" || code == "es";
+}
+
+}  // namespace
+
+base::span<const IndicLanguage> IndicLanguages() {
+  return kIndicLanguages;
+}
+
+const IndicLanguage* IndicLanguageFromCode(std::string_view code) {
+  for (const IndicLanguage& language : kIndicLanguages) {
+    if (language.code == code) {
+      return &language;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<TranslationDirection> PageDirectionsFor(std::string_view source_code,
+                                                    std::string_view target_code) {
+  using D = TranslationDirection;
+  if (source_code == target_code) {
+    return {};
+  }
+  std::vector<D> directions;
+  if (IndicLanguageFromCode(source_code)) {
+    directions.push_back(D::kIndicToEnglish);
+  } else if (source_code == "es") {
+    directions.push_back(D::kSpanishToEnglish);
+  } else if (source_code != "en") {
+    return {};
+  }
+  if (IndicLanguageFromCode(target_code)) {
+    directions.push_back(D::kEnglishToIndic);
+  } else if (target_code != "en") {
+    return {};
+  }
+  return directions;
+}
+
+std::optional<std::string> TranslationEngine::TranslatePage(std::string_view text,
+                                                            std::string_view source_code,
+                                                            std::string_view target_code) {
+  if (base::TrimWhitespaceASCII(text, base::TRIM_ALL).empty() ||
+      PageDirectionsFor(source_code, target_code).empty()) {
+    return std::string();
+  }
+  const std::optional<Target> captions_target = TargetFromCode(target_code);
+  if (IsCaptionsCode(source_code) && captions_target) {
+    return TranslateFrom(text, source_code, *captions_target);
+  }
+  const IndicLanguage* target = IndicLanguageFromCode(target_code);  // null: English
+  std::string english;        // the English model input for the second hop
+  if (source_code == "en") {
+    english = EnglishModelInput(text);
+  } else if (source_code == "es") {
+    std::optional<std::string> spanish = TranslateFrom(text, "es", Target::kEnglish);
+    if (!spanish || spanish->empty()) {
+      return std::nullopt;
+    }
+    english = EnglishModelInput(*spanish);
+  } else {
+    const IndicLanguage* source = IndicLanguageFromCode(source_code);
+    Direction* to_english = Get(TranslationDirection::kIndicToEnglish);
+    if (!to_english) {
+      return std::nullopt;
+    }
+    // Hindi, Tamil and Bengali keep captions' normaliser.
+    const std::optional<Language> captions_source = LanguageFromCode(source_code);
+    std::optional<std::vector<int64_t>> out_ids = to_english->Greedy(to_english->Encode(
+        source->tag, kEnglishTag,
+        captions_source ? ModelInput(text, *captions_source) : PageModelInput(text, *source)));
+    if (!out_ids) {
+      return std::nullopt;
+    }
+    english = to_english->Decode(*out_ids);
+    if (!target) {
+      return DetokenizeEnglish(english);
+    }
+  }
+  // Hindi, Tamil (its own letter mapping) and Bengali as captions write them.
+  if (const std::optional<Language> indian = LanguageFromCode(target_code)) {
+    return IntoIndian(english, *indian, nullptr, nullptr);
+  }
+  return IntoTag(english, *target);
+}
+
+void RunInParallel(size_t count, int parallel, base::RepeatingCallback<void(size_t)> work) {
+  class Worker : public base::DelegateSimpleThread::Delegate {
+   public:
+    Worker(size_t count, const base::RepeatingCallback<void(size_t)>& work)
+        : count_(count), work_(work) {}
+    void Run() override {
+      for (size_t i = next_++; i < count_; i = next_++) {
+        work_->Run(i);
+      }
+    }
+
+   private:
+    const size_t count_;
+    raw_ref<const base::RepeatingCallback<void(size_t)>> work_;
+    std::atomic<size_t> next_ = 0;
+  };
+  Worker worker(count, work);
+  const size_t helpers_wanted =
+      std::min(static_cast<size_t>(std::max(parallel, 1)), std::max<size_t>(count, 1)) - 1;
+  std::vector<std::unique_ptr<base::DelegateSimpleThread>> helpers;
+  for (size_t t = 0; t < helpers_wanted; ++t) {
+    helpers.push_back(std::make_unique<base::DelegateSimpleThread>(&worker, "TarkPageTranslate"));
+    helpers.back()->Start();
+  }
+  worker.Run();  // this thread is one of them
+  base::ScopedBlockingCall blocking(FROM_HERE, base::BlockingType::MAY_BLOCK);
+  for (const std::unique_ptr<base::DelegateSimpleThread>& helper : helpers) {
+    helper->Join();
+  }
+}
+
+std::vector<std::optional<std::string>> TranslationEngine::TranslatePages(
+    const std::vector<std::string>& texts,
+    std::string_view source_code,
+    std::string_view target_code,
+    int parallel) {
+  std::vector<std::optional<std::string>> results(texts.size());
+  if (parallel <= 1 || texts.size() <= 1) {
+    for (size_t i = 0; i < texts.size(); ++i) {
+      results[i] = TranslatePage(texts[i], source_code, target_code);
+    }
+    return results;
+  }
+  // Every model the pair needs loads here, first: the workers only read
+  // loaded_. A model that doesn't load fails every text, as TranslatePage
+  // would (blank ones stay "").
+  for (TranslationDirection direction : PageDirectionsFor(source_code, target_code)) {
+    if (!Get(direction)) {
+      for (size_t i = 0; i < texts.size(); ++i) {
+        if (base::TrimWhitespaceASCII(texts[i], base::TRIM_ALL).empty()) {
+          results[i] = std::string();
+        }
+      }
+      return results;
+    }
+  }
+  // Workers only look models up from here on (Get).
+  lookup_only_ = true;
+  RunInParallel(texts.size(), parallel, base::BindRepeating(
+                                            [](TranslationEngine* engine,
+                                               const std::vector<std::string>* texts,
+                                               const std::string& source,
+                                               const std::string& target,
+                                               std::vector<std::optional<std::string>>* results,
+                                               size_t i) {
+                                              (*results)[i] =
+                                                  engine->TranslatePage((*texts)[i], source, target);
+                                            },
+                                            base::Unretained(this), base::Unretained(&texts),
+                                            std::string(source_code), std::string(target_code),
+                                            base::Unretained(&results)));
+  lookup_only_ = false;
+  return results;
+}
+
+std::optional<std::string> TranslationEngine::IntoTag(std::string_view model_input,
+                                                      const IndicLanguage& target) {
+  Direction* from_english = Get(TranslationDirection::kEnglishToIndic);
+  if (!from_english) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<int64_t>> out =
+      from_english->Greedy(from_english->Encode(kEnglishTag, target.tag, model_input));
+  if (!out) {
+    return std::nullopt;
+  }
+  // IndicTrans2 writes every Brahmi script in Devanagari.
+  return base::UTF16ToUTF8(DetokenizeIndic(
+      ShiftBlock(base::UTF8ToUTF16(from_english->Decode(*out)), 0x0900, target.block)));
+}
