+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_model_store.h"
+
+#include <string>
+#include <utility>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "crypto/hash.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr char kDownloadDir[] = ".download";
+
+base::FilePath PathOf(const base::FilePath& dir, const ModelFile& file) {
+  return dir.AppendASCII(file.path);
+}
+
+// Where a file downloads before its hash is checked: one flat folder that
+// units downloading at the same time share.
+base::FilePath PartialOf(const base::FilePath& dir, const ModelFile& file) {
+  std::string name(file.path);
+  base::ReplaceChars(name, "/", "_", &name);
+  return dir.AppendASCII(kDownloadDir).AppendASCII(name);
+}
+
+base::FilePath MarkerOf(const base::FilePath& dir, const ModelUnitInfo& info) {
+  return dir.AppendASCII(std::string(".ready-") + info.id);
+}
+
+// What the marker holds: the manifest's hashes, so a new manifest (new
+// models) is not mistaken for the old one.
+std::string Fingerprint(const ModelUnitInfo& info) {
+  std::string out;
+  for (const ModelFile& file : info.files) {
+    out += std::string(file.path) + " " + file.sha256 + "\n";
+  }
+  return out;
+}
+
+bool HashMatches(const base::FilePath& path, const ModelFile& file) {
+  base::File in(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!in.IsValid() || in.GetLength() != file.size) {
+    return false;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::HashKind::kSha256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> read = in.ReadAtCurrentPos(buffer);
+    if (!read) {
+      return false;
+    }
+    if (*read == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*read));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::HexEncodeLower(digest) == file.sha256;
+}
+
+bool SizesMatch(const base::FilePath& dir, const ModelUnitInfo& info) {
+  for (const ModelFile& file : info.files) {
+    std::optional<int64_t> size = base::GetFileSize(PathOf(dir, file));
+    if (!size || *size != file.size) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Blocking: whether `info` is on disk. A marker for this manifest and the
+// right sizes are enough; without a marker every file is hashed once.
+bool CheckUnit(const base::FilePath& dir, const ModelUnitInfo& info) {
+  if (!SizesMatch(dir, info)) {
+    return false;
+  }
+  std::string marker;
+  if (base::ReadFileToString(MarkerOf(dir, info), &marker) && marker == Fingerprint(info)) {
+    return true;
+  }
+  for (const ModelFile& file : info.files) {
+    if (!HashMatches(PathOf(dir, file), file)) {
+      return false;
+    }
+  }
+  return base::WriteFile(MarkerOf(dir, info), Fingerprint(info));
+}
+
+// Blocking: checks a downloaded file and moves it into place, or deletes it.
+bool VerifyAndPlace(const base::FilePath& dir, const ModelFile& file, const base::FilePath& path) {
+  const bool ok = HashMatches(path, file) && base::CreateDirectory(PathOf(dir, file).DirName()) &&
+                  base::Move(path, PathOf(dir, file));
+  if (!ok) {
+    base::DeleteFile(path);
+  }
+  return ok;
+}
+
+void DeleteUnit(const base::FilePath& dir, const ModelUnitInfo& info) {
+  base::DeleteFile(MarkerOf(dir, info));
+  for (const ModelFile& file : info.files) {
+    base::DeleteFile(PathOf(dir, file));
+    // Empty folders it leaves (it2_indic_en/) go too; full ones stay.
+    if (PathOf(dir, file).DirName() != dir) {
+      base::DeleteFile(PathOf(dir, file).DirName());
+    }
+  }
+}
+
+// Blocking: what a cancelled or failed download leaves, its partial file and
+// the files already in place, goes; other units' downloads are untouched.
+void DiscardUnit(const base::FilePath& dir, const ModelUnitInfo& info) {
+  for (const ModelFile& file : info.files) {
+    base::DeleteFile(PartialOf(dir, file));
+  }
+  DeleteUnit(dir, info);
+}
+
+}  // namespace
+
+CaptionModelStore::CaptionModelStore(const base::FilePath& models_dir,
+                                     scoped_refptr<network::SharedURLLoaderFactory> factory,
+                                     const GURL& base_url,
+                                     base::span<const ModelUnitInfo> manifest,
+                                     const net::NetworkTrafficAnnotationTag& annotation,
+                                     scoped_refptr<base::SequencedTaskRunner> file_runner)
+    : models_dir_(models_dir),
+      factory_(std::move(factory)),
+      base_url_(base_url),
+      manifest_(manifest),
+      annotation_(annotation),
+      files_(file_runner ? std::move(file_runner)
+                         : base::ThreadPool::CreateSequencedTaskRunner(
+                               {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+                                base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})) {
+  // Partial files from a download that never finished are never models.
+  files_->PostTask(FROM_HERE, base::BindOnce(
+                                  [](const base::FilePath& dir) {
+                                    base::DeletePathRecursively(dir.AppendASCII(kDownloadDir));
+                                  },
+                                  models_dir_));
+  for (const ModelUnitInfo& info : manifest_) {
+    Unit& unit = units_[info.unit];
+    unit.status.total = UnitSize(info);
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&CheckUnit, models_dir_, info),
+        base::BindOnce(&CaptionModelStore::OnChecked, weak_factory_.GetWeakPtr(), info.unit));
+  }
+}
+
+CaptionModelStore::~CaptionModelStore() = default;
+
+const ModelUnitInfo* CaptionModelStore::Info(ModelUnit unit) const {
+  for (const ModelUnitInfo& info : manifest_) {
+    if (info.unit == unit) {
+      return &info;
+    }
+  }
+  return nullptr;
+}
+
+CaptionModelStore::Status CaptionModelStore::status(ModelUnit unit) const {
+  auto it = units_.find(unit);
+  return it == units_.end() ? Status() : it->second.status;
+}
+
+bool CaptionModelStore::in_use(ModelUnit unit) const {
+  auto it = units_.find(unit);
+  return it != units_.end() && it->second.in_use;
+}
+
+void CaptionModelStore::OnChecked(ModelUnit unit, bool ready) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Unit& u = units_[unit];
+  if (u.status.state != State::kChecking) {
+    return;
+  }
+  u.status.state = ready ? State::kReady : State::kMissing;
+  Notify(unit);
+  if (std::exchange(u.download_when_checked, false) && !ready) {
+    Download(unit);
+  }
+}
+
+void CaptionModelStore::Download(ModelUnit unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Unit& u = units_[unit];
+  if (!Info(unit) || u.status.state == State::kReady || u.status.state == State::kDownloading) {
+    return;
+  }
+  if (u.status.state == State::kChecking) {
+    // Pressed before the folder was checked: start once it is.
+    u.download_when_checked = true;
+    return;
+  }
+  ++u.generation;
+  u.status.state = State::kDownloading;
+  u.status.done = 0;
+  u.next_file = 0;
+  u.done_before_file = 0;
+  Notify(unit);
+  files_->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce(base::IgnoreResult(&base::CreateDirectory),
+                     models_dir_.AppendASCII(kDownloadDir)),
+      base::BindOnce(&CaptionModelStore::StartNextFile, weak_factory_.GetWeakPtr(), unit,
+                     u.generation));
+}
+
+bool CaptionModelStore::IsCurrent(ModelUnit unit, uint64_t generation) {
+  const Unit& u = units_[unit];
+  return u.status.state == State::kDownloading && u.generation == generation;
+}
+
+void CaptionModelStore::StartNextFile(ModelUnit unit, uint64_t generation) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  Unit& u = units_[unit];
+  const ModelUnitInfo& info = *Info(unit);
+  if (u.next_file == info.files.size()) {
+    files_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(
+            [](const base::FilePath& path, std::string fingerprint) {
+              return base::WriteFile(path, fingerprint);
+            },
+            MarkerOf(models_dir_, info), Fingerprint(info)),
+        base::BindOnce(&CaptionModelStore::OnMarkerWritten, weak_factory_.GetWeakPtr(), unit,
+                       generation));
+    return;
+  }
+  // A file already in place from an earlier try (a retry after a dropped
+  // connection) is hashed again rather than fetched again.
+  const ModelFile& file = info.files[u.next_file];
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&HashMatches, PathOf(models_dir_, file), file),
+      base::BindOnce(&CaptionModelStore::OnPlacedChecked, weak_factory_.GetWeakPtr(), unit,
+                     generation));
+}
+
+void CaptionModelStore::OnPlacedChecked(ModelUnit unit, uint64_t generation, bool in_place) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  if (in_place) {
+    OnFileVerified(unit, generation, true);
+    return;
+  }
+  Unit& u = units_[unit];
+  const ModelFile& file = Info(unit)->files[u.next_file];
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = base_url_.Resolve(file.path);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  u.loader = network::SimpleURLLoader::Create(std::move(request), annotation_);
+  u.loader->SetOnRedirectCallback(base::BindRepeating(
+      &CaptionModelStore::OnRedirect, weak_factory_.GetWeakPtr(), unit, generation));
+  u.loader->SetOnDownloadProgressCallback(base::BindRepeating(
+      &CaptionModelStore::OnProgress, weak_factory_.GetWeakPtr(), unit));
+  u.loader->DownloadToFile(factory_.get(),
+                           base::BindOnce(&CaptionModelStore::OnFileDownloaded,
+                                          weak_factory_.GetWeakPtr(), unit, generation),
+                           PartialOf(models_dir_, file), file.size);
+}
+
+void CaptionModelStore::OnRedirect(ModelUnit unit,
+                                   uint64_t generation,
+                                   const GURL& url_before_redirect,
+                                   const net::RedirectInfo& redirect_info,
+                                   const network::mojom::URLResponseHead& response_head,
+                                   std::vector<std::string>* removed_headers) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  // Models come from the models folder on gettarka.com and nowhere else.
+  const GURL& to = redirect_info.new_url;
+  if (to.DeprecatedGetOriginAsURL() != base_url_.DeprecatedGetOriginAsURL() ||
+      !to.path().starts_with(base_url_.path())) {
+    LOG(WARNING) << "Tark captions: download of " << Info(unit)->id
+                 << " redirected away from the models folder";
+    Fail(unit);  // Deletes the loader, which is allowed here.
+  }
+}
+
+void CaptionModelStore::OnProgress(ModelUnit unit, uint64_t current) {
+  // The network reports every read (~8 a megabyte); the pill and Settings
+  // show whole megabytes, so they hear only when that number changes.
+  constexpr int64_t kMegabyte = 1'000'000;
+  Unit& u = units_[unit];
+  const int64_t before = u.status.done / kMegabyte;
+  u.status.done = u.done_before_file + static_cast<int64_t>(current);
+  if (u.status.done / kMegabyte != before) {
+    Notify(unit);
+  }
+}
+
+void CaptionModelStore::OnFileDownloaded(ModelUnit unit, uint64_t generation, base::FilePath path) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  Unit& u = units_[unit];
+  const int net_error = u.loader ? u.loader->NetError() : 0;
+  u.loader.reset();
+  if (path.empty()) {
+    // The error code and size only.
+    LOG(WARNING) << "Tark captions: download of " << Info(unit)->id << " failed, net error "
+                 << net_error;
+    Fail(unit);
+    return;
+  }
+  const ModelFile& file = Info(unit)->files[u.next_file];
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&VerifyAndPlace, models_dir_, file, path),
+      base::BindOnce(&CaptionModelStore::OnFileVerified, weak_factory_.GetWeakPtr(), unit,
+                     generation));
+}
+
+void CaptionModelStore::OnFileVerified(ModelUnit unit, uint64_t generation, bool ok) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  if (!ok) {
+    LOG(WARNING) << "Tark captions: a file of " << Info(unit)->id
+                 << " did not match its hash";
+    Fail(unit);
+    return;
+  }
+  Unit& u = units_[unit];
+  u.done_before_file += Info(unit)->files[u.next_file].size;
+  u.status.done = u.done_before_file;
+  ++u.next_file;
+  StartNextFile(unit, generation);
+}
+
+void CaptionModelStore::OnMarkerWritten(ModelUnit unit, uint64_t generation, bool ok) {
+  if (!IsCurrent(unit, generation)) {
+    return;
+  }
+  if (!ok) {
+    Fail(unit);
+    return;
+  }
+  Unit& u = units_[unit];
+  u.status.state = State::kReady;
+  u.status.done = u.status.total;
+  Notify(unit);
+}
+
+void CaptionModelStore::Fail(ModelUnit unit) {
+  Unit& u = units_[unit];
+  ++u.generation;
+  u.loader.reset();
+  u.status.state = State::kFailed;
+  u.status.done = 0;
+  // Every file was in place and the ready marker failed: nothing to remove,
+  // and a retry checks the files again and writes the marker.
+  if (u.next_file >= Info(unit)->files.size()) {
+    Notify(unit);
+    return;
+  }
+  // Only the file being fetched goes: the ones already checked and in place
+  // stay, so a retry fetches what is left. Observers hear once it is gone.
+  files_->PostTaskAndReply(
+      FROM_HERE,
+      base::BindOnce(base::IgnoreResult(&base::DeleteFile),
+                     PartialOf(models_dir_, Info(unit)->files[u.next_file])),
+      base::BindOnce(&CaptionModelStore::Notify, weak_factory_.GetWeakPtr(), unit));
+}
+
+void CaptionModelStore::Cancel(ModelUnit unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Unit& u = units_[unit];
+  u.download_when_checked = false;
+  if (u.status.state != State::kDownloading) {
+    return;
+  }
+  ++u.generation;
+  u.loader.reset();
+  u.status.state = State::kMissing;
+  u.status.done = 0;
+  // Nothing of the unit stays. Observers hear once its files are gone.
+  files_->PostTaskAndReply(
+      FROM_HERE, base::BindOnce(&DiscardUnit, models_dir_, *Info(unit)),
+      base::BindOnce(&CaptionModelStore::Notify, weak_factory_.GetWeakPtr(), unit));
+}
+
+bool CaptionModelStore::Remove(ModelUnit unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  Unit& u = units_[unit];
+  if (u.in_use || u.status.state == State::kDownloading ||
+      u.status.state == State::kChecking || !Info(unit)) {
+    return false;
+  }
+  u.status.state = State::kMissing;
+  u.status.done = 0;
+  // Observers hear once the files are gone.
+  files_->PostTaskAndReply(
+      FROM_HERE, base::BindOnce(&DeleteUnit, models_dir_, *Info(unit)),
+      base::BindOnce(&CaptionModelStore::Notify, weak_factory_.GetWeakPtr(), unit));
+  return true;
+}
+
+void CaptionModelStore::SetInUse(ModelUnit unit, bool in_use) {
+  units_[unit].in_use = in_use;
+  Notify(unit);
+}
+
+int64_t CaptionModelStore::BytesOnDisk() const {
+  int64_t bytes = 0;
+  for (const ModelUnitInfo& info : manifest_) {
+    if (status(info.unit).state == State::kReady) {
+      bytes += UnitSize(info);
+    }
+  }
+  return bytes;
+}
+
+void CaptionModelStore::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void CaptionModelStore::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void CaptionModelStore::Notify(ModelUnit unit) {
+  observers_.Notify(&Observer::OnModelStatusChanged, unit);
+}
+
