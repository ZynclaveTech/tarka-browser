+
+#include "components/tark_captions/call_state.h"
+
+namespace tark_captions {
+
+void CallState::OnMicCapturing(bool capturing) {
+  if (capturing == in_call_) {
+    return;
+  }
+  in_call_ = capturing;
+  captions_on_ = false;
+}
+
+void CallState::OnSoundPlaying(bool playing) {
+  playing_sound_ = playing;
+}
+
+bool CallState::SetCaptionsOn(bool on, bool sound_recently) {
+  if (on && !in_call_ && !playing_sound_ && !sound_recently) {
+    return false;
+  }
+  captions_on_ = on;
+  return true;
+}
+
+void CallState::OnLeftSite() {
+  captions_on_ = false;
+}
+
+CallState::Phase CallState::phase() const {
+  if (captions_on_) {
+    return Phase::kCaptioning;
+  }
+  if (in_call_) {
+    return Phase::kInCall;
+  }
+  return playing_sound_ ? Phase::kSound : Phase::kIdle;
+}
+
+}  // namespace tark_captions
