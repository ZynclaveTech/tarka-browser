+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/asr_model.h"
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "components/tark_captions/model_source.h"
+
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(AsrModelTest, MatchesGoldenText) {
+  std::optional<base::FilePath> ort = test::OrtPath();
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(*ort);
+  ASSERT_TRUE(runtime);
+  std::unique_ptr<AsrModel> asr = AsrModel::Load(runtime.get(), *models, /*threads=*/2);
+  ASSERT_TRUE(asr);
+  base::ListValue clips = test::GoldenClips(*testdata);
+  ASSERT_EQ(clips.size(), 4u);
+  for (const base::Value& clip : clips) {
+    const std::string& wav = *clip.GetDict().FindString("wav");
+    std::optional<Language> language = LanguageFromCode(*clip.GetDict().FindString("lang"));
+    ASSERT_TRUE(language) << wav;
+    int rate = 0;
+    std::vector<float> pcm = test::ReadWav(testdata->AppendASCII(wav), &rate);
+    EXPECT_EQ(asr->Decode(pcm, *language), *clip.GetDict().FindString("ctc_text")) << wav;
+  }
+}
+
+TEST(AsrModelTest, LanguageCodes) {
+  EXPECT_EQ(LanguageFromCode("hi"), Language::kHindi);
+  EXPECT_EQ(LanguageFromCode("ta"), Language::kTamil);
+  EXPECT_EQ(LanguageFromCode("bn"), Language::kBengali);
+  EXPECT_EQ(LanguageFromCode("sw"), std::nullopt);
+  EXPECT_STREQ(LanguageCode(Language::kTamil), "ta");
+}
+
+TEST(AsrModelTest, BlankFromEngineJson) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath json = dir.GetPath().AppendASCII("engine.json");
+  ASSERT_TRUE(base::WriteFile(
+      json, R"({"lang": "en", "blank": 1024, "valid_frames": "n/hop", "pad": "constant"})"));
+  std::optional<ModelConventions> conventions = ReadConventions(DirectorySource(dir.GetPath()));
+  ASSERT_TRUE(conventions);
+  EXPECT_EQ(conventions->blank, 1024);
+  EXPECT_EQ(conventions->frames, ModelConventions::Frames::kHop);
+  EXPECT_EQ(conventions->pad, ModelConventions::Pad::kZero);
+  // An engine.json the engine does not understand refuses the model rather
+  // than decoding it wrongly.
+  ASSERT_TRUE(base::WriteFile(json, R"({"blank": 1024, "pad": "wrap"})"));
+  EXPECT_FALSE(ReadConventions(DirectorySource(dir.GetPath())));
+}
+
+// Android's per-language models (one language each, FastConformer's
+// English and Spanish too) load with the languages they have.
+TEST(AsrModelTest, ReadsWhateverLanguagesTheModelHas) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("vocab.json"),
+                              R"({"en": ["a", "b", "<blank>"]})"));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("language_masks.json"),
+                              R"({"en": [true, true, true]})"));
+  std::optional<std::map<std::string, AsrModel::Vocabulary>> vocabularies =
+      ReadVocabularies(DirectorySource(dir.GetPath()), /*blank=*/2);
+  ASSERT_TRUE(vocabularies);
+  ASSERT_EQ(vocabularies->size(), 1u);
+  EXPECT_EQ(vocabularies->at("en").tokens.size(), 3u);
+  EXPECT_EQ(vocabularies->at("en").logit_indices, (std::vector<int>{0, 1, 2}));
+  // A vocabulary that does not reach past the blank is refused.
+  EXPECT_FALSE(ReadVocabularies(DirectorySource(dir.GetPath()), /*blank=*/3));
+}
+
+}  // namespace
+}  // namespace tark_captions
