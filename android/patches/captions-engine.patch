+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/render_queue.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(RenderQueueTest, OneRequestInFlight) {
+  RenderQueue queue;
+  queue.Add(false, "a");
+  std::optional<RenderRequest> first = queue.Next();
+  ASSERT_TRUE(first);
+  queue.Add(false, "b");
+  EXPECT_FALSE(queue.Next());
+  EXPECT_TRUE(queue.Done(first->generation));
+  EXPECT_EQ(queue.Next()->text, "b");
+}
+
+TEST(RenderQueueTest, DraftsCoalesce) {
+  RenderQueue queue;
+  queue.Add(false, "a");
+  const uint64_t generation = queue.Next()->generation;
+  queue.Add(false, "b");
+  queue.Add(false, "c");
+  queue.Add(false, "d");
+  queue.Done(generation);
+  std::optional<RenderRequest> next = queue.Next();
+  EXPECT_EQ(next->text, "d");
+  queue.Done(next->generation);
+  EXPECT_FALSE(queue.Next());
+}
+
+TEST(RenderQueueTest, FinalsNeverDropped) {
+  RenderQueue queue;
+  queue.Add(false, "draft 1");
+  uint64_t generation = queue.Next()->generation;
+  queue.Add(true, "final 1");
+  queue.Add(true, "final 2");
+  queue.Add(false, "draft 2");
+  queue.Done(generation);
+  std::vector<std::string> order;
+  while (std::optional<RenderRequest> next = queue.Next()) {
+    order.push_back(next->text);
+    queue.Done(next->generation);
+  }
+  EXPECT_EQ(order, (std::vector<std::string>{"final 1", "final 2", "draft 2"}));
+}
+
+// A final replaces the draft of the same words still waiting.
+TEST(RenderQueueTest, FinalSupersedesWaitingDraft) {
+  RenderQueue queue;
+  queue.Add(false, "a");
+  const uint64_t generation = queue.Next()->generation;
+  queue.Add(false, "draft");
+  queue.Add(true, "final");
+  queue.Done(generation);
+  std::optional<RenderRequest> next = queue.Next();
+  EXPECT_TRUE(next->is_final);
+  queue.Done(next->generation);
+  EXPECT_FALSE(queue.Next());
+}
+
+TEST(RenderQueueTest, StaleResultIsDropped) {
+  RenderQueue queue;
+  queue.Add(false, "a");
+  const uint64_t old_generation = queue.Next()->generation;
+  queue.ChoicesChanged();
+  EXPECT_FALSE(queue.Done(old_generation));
+}
+
+TEST(RenderQueueTest, ClearForgetsEverything) {
+  RenderQueue queue;
+  queue.Add(true, "a");
+  queue.Next();
+  queue.Add(true, "b");
+  queue.Clear();
+  EXPECT_FALSE(queue.Next());
+  queue.Add(true, "c");
+  EXPECT_EQ(queue.Next()->text, "c");
+}
+
+// A caption is translated from the language it was heard in, even if the
+// user changes the client's language while it waits.
+// The language each caption was heard in, macOS's too (D4 Phase 3).
+TEST(RenderQueueTest, RequestKeepsItsLanguage) {
+  RenderQueue queue;
+  queue.Add(true, "a", "es");
+  EXPECT_EQ(queue.Next()->source, "es");
+}
+
+// Translate turned off: the finals still waiting are shown as they are.
+TEST(RenderQueueTest, TakeWaitingFinals) {
+  RenderQueue queue;
+  queue.Add(false, "draft 1", "hi");
+  queue.Next();
+  queue.Add(true, "final 1", "hi");
+  queue.Add(true, "final 2", "hi");
+  queue.Add(false, "draft 2", "hi");
+  EXPECT_EQ(queue.TakeWaitingFinals(), (std::vector<std::string>{"final 1", "final 2"}));
+  queue.Done(0);
+  EXPECT_FALSE(queue.Next());
+}
+
+// The captions history pairs a final with its render by this id.
+TEST(RenderQueueTest, CarriesTheHistoryId) {
+  RenderQueue queue;
+  queue.Add(true, "a", "hi", 7);
+  std::optional<RenderRequest> next = queue.Next();
+  ASSERT_TRUE(next);
+  EXPECT_EQ(next->history_id, 7u);
+  queue.Done(next->generation);
+  queue.Add(false, "b", "hi");
+  EXPECT_EQ(queue.Next()->history_id, 0u);
+}
+
+}  // namespace
+}  // namespace tark_captions
