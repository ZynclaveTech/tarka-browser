+// The first-time download notice: whole MB in the bar ("88 MB"), and
+// "about" sizes in Settings rounded to the nearest 10 MB.
+TEST(ModelManifestTest, Megabytes) {
+  EXPECT_EQ(Megabytes(88'999'999), 88);
+  EXPECT_EQ(Megabytes(999'999), 0);
