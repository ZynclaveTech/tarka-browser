+  spanish.Detected("es");
+  EXPECT_TRUE(spanish.AcceptsAppleCaptions("es"));
+  EXPECT_TRUE(spanish.AcceptsAppleCaptions("es-US"));
+  EXPECT_FALSE(spanish.AcceptsAppleCaptions("en"));
+  ClientLanguage tamil(true);
+  tamil.Detected("ta");
+  EXPECT_FALSE(tamil.AcceptsAppleCaptions("en"));
+  ClientLanguage detecting(true);
+  EXPECT_FALSE(detecting.AcceptsAppleCaptions("es"));
+}
+
+// D4 any-media: a new video (a new audio stream in a tab that isn't in a
+// call) is listened to afresh when its language was detected, so a new
