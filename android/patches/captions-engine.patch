+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/segmenter.h"
+
+#include <algorithm>
+
+namespace tark_captions {
+
+Segmenter::Segmenter() : Segmenter(Options()) {}
+Segmenter::Segmenter(Options options) : options_(options) {}
+Segmenter::~Segmenter() = default;
+
+SegmenterAction Segmenter::Make(SegmenterAction::Kind kind, double start_s, double end_s) const {
+  if (end_s - start_s < kMinSegment) {
+    return {};
+  }
+  return {.kind = kind, .start_s = start_s, .end_s = end_s};
+}
+
+SegmenterAction Segmenter::OnChunk(double now, float speech_prob) {
+  if (speech_prob >= kSpeech) {
+    last_speech_ = now;
+    if (!speaking_) {
+      speaking_ = true;
+      segment_start_ = std::max(0.0, now - kPreRoll);
+      last_draft_ = now;
+      probs_.clear();
+    }
+  }
+  if (!speaking_) {
+    return {};
+  }
+  probs_.emplace_back(now, speech_prob);
+  if (now - last_speech_ >= kPause) {
+    speaking_ = false;
+    return Make(SegmenterAction::kFinal, segment_start_, last_speech_ + kPostRoll);
+  }
+  if (now - segment_start_ >= options_.max_segment) {
+    double cut = now;
+    float lowest = 2.0f;
+    for (const auto& [t, p] : probs_) {
+      if (t >= now - options_.max_segment / 2 && t >= segment_start_ + 1.0 && p < lowest) {
+        cut = t;
+        lowest = p;
+      }
+    }
+    const double start = segment_start_;
+    segment_start_ = cut;
+    std::erase_if(probs_, [cut](const auto& tp) { return tp.first <= cut; });
+    return Make(SegmenterAction::kFinal, start, cut);
+  }
+  if (!options_.phrase && now - last_draft_ >= options_.draft_every) {
+    last_draft_ = now;
+    return Make(SegmenterAction::kDraft, segment_start_, now);
+  }
+  return {};
+}
+
+std::optional<SegmenterAction> Segmenter::Flush(double audio_end_s) {
+  if (!speaking_) {
+    return std::nullopt;
+  }
+  speaking_ = false;
+  SegmenterAction a = Make(SegmenterAction::kFinal, segment_start_, audio_end_s);
+  return a.kind == SegmenterAction::kNone ? std::nullopt : std::optional(a);
+}
+
+}  // namespace tark_captions
