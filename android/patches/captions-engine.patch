+// TranslatePages' thread loop, without models: a slow fake sentence
+// translation that fails on chosen indices. Every index runs once, on more
+// than one thread; each result lands at its own index, in order, and a
+// failure nulls only its own.
+TEST(TranslationEngineNoRuntimeTest, RunInParallelKeepsOrderAndFailures) {
+  constexpr size_t kCount = 13;
+  const std::set<size_t> failing = {2, 7, 12};
+  std::vector<std::optional<std::string>> results(kCount);
+  std::vector<std::atomic<int>> calls(kCount);
+  base::Lock lock;
+  std::set<base::PlatformThreadId> threads;
+  RunInParallel(kCount, 4, base::BindLambdaForTesting([&](size_t i) {
+                  {
+                    base::AutoLock hold(lock);
+                    threads.insert(base::PlatformThread::CurrentId());
+                  }
+                  // Later indices finish sooner, so completion order differs.
+                  base::PlatformThread::Sleep(base::Milliseconds(2 * (kCount - i)));
+                  ++calls[i];
+                  results[i] = failing.contains(i) ? std::nullopt
+                                                   : std::optional<std::string>(
+                                                         "s" + base::NumberToString(i));
+                }));
+  for (size_t i = 0; i < kCount; ++i) {
+    EXPECT_EQ(calls[i], 1) << i;
+    EXPECT_EQ(results[i], failing.contains(i) ? std::nullopt
+                                              : std::optional<std::string>(
+                                                    "s" + base::NumberToString(i)))
+        << i;
+  }
+  EXPECT_GT(threads.size(), 1u);
+  EXPECT_LE(threads.size(), 4u);
+
+  // One at a time, and nothing to do.
+  std::vector<size_t> order;
+  RunInParallel(3, 1, base::BindLambdaForTesting([&](size_t i) { order.push_back(i); }));
+  EXPECT_EQ(order, (std::vector<size_t>{0, 1, 2}));
+  RunInParallel(0, 4, base::BindLambdaForTesting([&](size_t) { ADD_FAILURE(); }));
+}
