+std::optional<base::FilePath> PathFromEnv(base::cstring_view name) {
+  std::optional<std::string> value = base::Environment::Create()->GetVar(name);
+  if (!value || value->empty()) {
+    return std::nullopt;
+  }
+  return base::FilePath(*value);
+}
+
+uint32_t U32(const std::string& s, size_t at) {
+  uint32_t v;
+  memcpy(&v, s.data() + at, 4);
+  return v;
+}
+
+uint16_t U16(const std::string& s, size_t at) {
+  uint16_t v;
+  memcpy(&v, s.data() + at, 2);
+  return v;
+}
+
+}  // namespace
+
+std::optional<base::FilePath> OrtPath() {
+  return PathFromEnv("TARK_CAPTIONS_ORT");
+}
+std::optional<base::FilePath> ModelsDir() {
+  return PathFromEnv("TARK_CAPTIONS_MODELS");
+}
+std::optional<base::FilePath> TestDataDir() {
+  return PathFromEnv("TARK_CAPTIONS_TESTDATA");
+}
+
+std::vector<float> ReadWav(const base::FilePath& path, int* sample_rate) {
+  std::string bytes;
+  if (!base::ReadFileToString(path, &bytes) || bytes.size() < 12 ||
+      bytes.compare(0, 4, "RIFF") != 0 || bytes.compare(8, 4, "WAVE") != 0) {
+    return {};
+  }
+  size_t at = 12;
+  int format = 0;  // 1: 16-bit PCM, 3: 32-bit float
+  while (at + 8 <= bytes.size()) {
+    const std::string id = bytes.substr(at, 4);
+    const uint32_t size = U32(bytes, at + 4);
+    const size_t body = at + 8;
+    if (body + size > bytes.size()) {
+      return {};
+    }
+    if (id == "fmt ") {
+      const bool mono = size >= 16 && U16(bytes, body + 2) == 1;
+      const uint16_t tag = U16(bytes, body);
+      const uint16_t bits = U16(bytes, body + 14);
+      format = !mono ? 0 : (tag == 1 && bits == 16) ? 1 : (tag == 3 && bits == 32) ? 3 : 0;
+      *sample_rate = static_cast<int>(U32(bytes, body + 4));
+    } else if (id == "data" && format == 1) {
+      std::vector<float> out(size / 2);
+      for (size_t i = 0; i < out.size(); ++i) {
+        out[i] = static_cast<int16_t>(U16(bytes, body + 2 * i)) / 32768.0f;
+      }
+      return out;
+    } else if (id == "data" && format == 3) {
+      std::vector<float> out(size / 4);
+      memcpy(out.data(), bytes.data() + body, out.size() * 4);
+      return out;
+    }
+    at = body + size + (size & 1);
+  }
+  return {};
+}
+
+namespace {
+
+base::ListValue ReadList(const base::FilePath& file, std::string_view key) {
+  std::string json;
+  if (!base::ReadFileToString(file, &json)) {
+    return {};
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict() || !value->GetDict().FindList(key)) {
+    return {};
+  }
+  return value->GetDict().FindList(key)->Clone();
+}
+
+}  // namespace
+
+base::ListValue GoldenClips(const base::FilePath& testdata) {
+  return ReadList(testdata.Append("golden.json"), "clips");
+}
+
+base::ListValue MtGoldenCases(const base::FilePath& testdata) {
+  return ReadList(testdata.Append("mt_golden.json"), "cases");
+}
+
+base::ListValue EsMtGoldenCases(const base::FilePath& testdata) {
+  return ReadList(testdata.Append("es_mt_golden.json"), "cases");
+}
+
+base::ListValue LidGoldenCases(const base::FilePath& testdata) {
+  return ReadList(testdata.Append("lid_golden.json"), "cases");
+}
+
+base::DictValue EnMtGolden(const base::FilePath& testdata) {
+  std::string json;
+  if (!base::ReadFileToString(testdata.Append("en_mt_golden.json"), &json)) {
+    return {};
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return {};
+  }
+  return std::move(value->GetDict());
+}
+
+std::unique_ptr<ModelSource> MappedFilesSourceFor(const base::FilePath& dir) {
+  std::map<std::string, base::File> files;
+  base::FileEnumerator it(dir, /*recursive=*/false, base::FileEnumerator::FILES);
+  for (base::FilePath path = it.Next(); !path.empty(); path = it.Next()) {
+    files.emplace(path.BaseName().MaybeAsASCII(),
+                  base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+  }
+  return std::make_unique<MappedFilesSource>(std::move(files));
+}
