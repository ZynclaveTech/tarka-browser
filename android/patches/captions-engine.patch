+// What Tark downloads for live captions (D4 Phase 4), in three units: the
+// Indian captions models, translation into English, and translation into
+// Indian languages.
+enum class ModelUnit { kCaptions, kToEnglish, kFromEnglish, kLanguageId };
+
+// One file of a unit: its path in the models folder, size and SHA-256
+// (lowercase hex). Tark uses a file only when both match.
+struct ModelFile {
+  const char* path;
+  int64_t size;
+  const char* sha256;
+};
+
+struct ModelUnitInfo {
+  ModelUnit unit;
+  const char* id;  // "captions", "to_english", "from_english"
+  base::span<const ModelFile> files;
+};
+
+// Generated by utils/captions_manifest.py (model_manifest.cc).
+base::span<const ModelUnitInfo> ModelManifest();
+
+int64_t UnitSize(const ModelUnitInfo& info);
+int64_t UnitSize(ModelUnit unit);
+
+// Sizes as people read them (the first-time download notice): whole MB
+// (1,000,000 bytes) in the caption bar, and "about" sizes in Settings
+// rounded to the nearest 10 MB.
+int64_t Megabytes(int64_t bytes);
+int64_t AboutMegabytes(int64_t bytes);
+
+// The units a translation into `target` needs: none, to English, or (for an
+// Indian target, which goes through English) both.
+std::vector<ModelUnit> UnitsForTranslation(Target target);
+
+class ClientLanguage;
+// What a call needs downloaded (D4 Phase 3). Captions: language_id (the
+// detector and the VAD) always, the captions unit for Tark's own languages.
+std::vector<ModelUnit> UnitsForCaptions(const ClientLanguage& language);
+// Translation: Tark's models for its own languages; for one macOS captions,
+// only English→Indian for an Indian target (Apple translates into English).
+std::vector<ModelUnit> UnitsForTranslating(const ClientLanguage& language, Target target);
+
