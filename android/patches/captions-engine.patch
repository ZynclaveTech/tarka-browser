+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/media_players.h"
+
+namespace tark_captions {
+
+MediaPlayers::MediaPlayers() = default;
+MediaPlayers::~MediaPlayers() = default;
+
+void MediaPlayers::OnStarted(const PlayerKey& key,
+                             bool has_video,
+                             bool has_audio,
+                             base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  Player& player = players_[key];
+  player.has_video = has_video;
+  player.has_audio = has_audio;
+  player.playing = true;
+  player.started = now;
+  Update(was_audible, now);
+}
+
+void MediaPlayers::OnStopped(const PlayerKey& key, base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  const base::flat_map<PlayerKey, bool> before = AudibleNow();
+  if (auto it = players_.find(key); it != players_.end()) {
+    it->second.playing = false;
+  }
+  MarkSilenced(before, now);
+  Update(was_audible, now);
+}
+
+void MediaPlayers::OnMuted(const PlayerKey& key, bool muted, base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  const base::flat_map<PlayerKey, bool> before = AudibleNow();
+  players_[key].muted = muted;
+  MarkSilenced(before, now);
+  Update(was_audible, now);
+}
+
+void MediaPlayers::OnDestroyed(const PlayerKey& key, base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  players_.erase(key);
+  Update(was_audible, now);
+}
+
+void MediaPlayers::OnVideoRect(const PlayerKey& key, std::optional<gfx::Rect> rect) {
+  if (auto it = players_.find(key); it != players_.end()) {
+    it->second.rect = rect;
+  }
+}
+
+void MediaPlayers::SetTabMuted(bool muted, base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  const base::flat_map<PlayerKey, bool> before = AudibleNow();
+  tab_muted_ = muted;
+  MarkSilenced(before, now);
+  Update(was_audible, now);
+}
+
+base::flat_map<PlayerKey, bool> MediaPlayers::AudibleNow() const {
+  base::flat_map<PlayerKey, bool> audible;
+  for (const auto& [key, player] : players_) {
+    audible[key] = Audible(player);
+  }
+  return audible;
+}
+
+void MediaPlayers::MarkSilenced(const base::flat_map<PlayerKey, bool>& was_audible,
+                                base::TimeTicks now) {
+  for (auto& [key, player] : players_) {
+    auto it = was_audible.find(key);
+    if (it != was_audible.end() && it->second && !Audible(player)) {
+      player.heard_until = now;
+    }
+  }
+}
+
+bool MediaPlayers::Audible(const Player& player) const {
+  return player.playing && player.has_audio && !player.muted && !tab_muted_;
+}
+
+void MediaPlayers::OnMetadata(const PlayerKey& key,
+                              bool has_video,
+                              bool has_audio,
+                              base::TimeTicks now) {
+  auto it = players_.find(key);
+  if (it == players_.end()) {
+    return;
+  }
+  const bool was_audible = AnyAudible();
+  const base::flat_map<PlayerKey, bool> before = AudibleNow();
+  it->second.has_video = has_video;
+  it->second.has_audio = has_audio;
+  MarkSilenced(before, now);
+  Update(was_audible, now);
+}
+
+void MediaPlayers::SetTabAudible(bool audible, base::TimeTicks now) {
+  const bool was_audible = AnyAudible();
+  tab_audible_ = audible;
+  Update(was_audible, now);
+}
+
+bool MediaPlayers::AnyAudible() const {
+  if (tab_audible_ && !tab_muted_) {
+    return true;
+  }
+  for (const auto& [key, player] : players_) {
+    if (Audible(player)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void MediaPlayers::Update(bool was_audible, base::TimeTicks now) {
+  const bool audible = AnyAudible();
+  if (audible == was_audible) {
+    return;
+  }
+  if (audible) {
+    // Sound again within the linger after the button showed: the same
+    // stretch, so the button doesn't wait again.
+    const bool continues = sound_since_ && silent_since_ &&
+                           now - *silent_since_ < kButtonLingerDelay;
+    if (!continues) {
+      sound_since_ = now;
+    }
+    silent_since_.reset();
+    return;
+  }
+  // Sound stopped before the button showed: nothing lingers.
+  if (sound_since_ && now - *sound_since_ < kButtonAppearDelay) {
+    sound_since_.reset();
+    return;
+  }
+  silent_since_ = now;
+}
+
+bool MediaPlayers::ButtonShown(bool in_call, base::TimeTicks now) const {
+  if (in_call) {
+    return true;
+  }
+  if (!sound_since_) {
+    return false;
+  }
+  if (silent_since_ && now - *silent_since_ >= kButtonLingerDelay) {
+    return false;
+  }
+  return now - *sound_since_ >= kButtonAppearDelay;
+}
+
+std::optional<base::TimeTicks> MediaPlayers::NextChange(bool in_call,
+                                                        base::TimeTicks now) const {
+  if (in_call || !sound_since_) {
+    return std::nullopt;
+  }
+  const base::TimeTicks appear = *sound_since_ + kButtonAppearDelay;
+  if (now < appear) {
+    return appear;
+  }
+  if (silent_since_) {
+    const base::TimeTicks leave = *silent_since_ + kButtonLingerDelay;
+    if (now < leave) {
+      return leave;
+    }
+  }
+  return std::nullopt;
+}
+
+const MediaPlayers::Player* MediaPlayers::Anchor() const {
+  const Player* anchor = nullptr;
+  for (const auto& [key, player] : players_) {
+    if (Audible(player) && (!anchor || player.started > anchor->started)) {
+      anchor = &player;
+    }
+  }
+  if (anchor) {
+    return anchor;
+  }
+  // Nothing audible: the video heard last (paused, the button lingering or
+  // captions still on).
+  for (const auto& [key, player] : players_) {
+    if (player.has_video && player.heard_until &&
+        (!anchor || *player.heard_until > *anchor->heard_until)) {
+      anchor = &player;
+    }
+  }
+  return anchor;
+}
+
+std::optional<gfx::Rect> MediaPlayers::AnchorVideo() const {
+  const Player* anchor = Anchor();
+  if (!anchor || !anchor->has_video) {
+    return std::nullopt;
+  }
+  return anchor->rect;
+}
+
+std::optional<gfx::Rect> PlaceButton(const MediaPlayers& players,
+                                     bool in_call,
+                                     const gfx::Size& content_area,
+                                     const gfx::Size& button) {
+  const gfx::Rect area(content_area);
+  const gfx::Rect corner(area.right() - kWindowCornerMargin - button.width(),
+                         area.bottom() - kWindowCornerMargin - button.height(),
+                         button.width(), button.height());
+  const std::optional<gfx::Rect> video = players.AnchorVideo();
+  if (in_call || !video) {
+    // No video to sit on (a call, sound only), or one whose box isn't known.
+    return corner;
+  }
+  if (!video->Intersects(area)) {
+    return std::nullopt;
+  }
+  gfx::Rect place(video->right() - kButtonInset - button.width(),
+                  video->bottom() - kButtonLift - button.height(), button.width(),
+                  button.height());
+  place.AdjustToFit(area);
+  return place;
+}
+
+}  // namespace tark_captions
