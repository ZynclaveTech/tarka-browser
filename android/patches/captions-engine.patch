+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_CLIENT_LANGUAGE_H_
+#define COMPONENTS_TARK_CAPTIONS_CLIENT_LANGUAGE_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace tark_captions {
+
+// The language the client speaks on one call (D4 Phase 3): Auto-detect
+// until the speech process says which (it locks; it never switches by
+// itself), or the language the user picked, which wins over a detection
+// still on its way. Never remembered past the call.
+class ClientLanguage {
+ public:
+  enum class State {
+    kDetecting,         // Auto-detect, nothing decided yet.
+    kCaptioning,        // Tark's own captions (hi, ta, bn).
+    kApple,             // macOS 26 captions it.
+    kAppleUnavailable,  // macOS captions it, but not this Mac (before 26).
+    kPlanned,           // An Indian language not listed yet.
+    kUnsupported,       // Tark can't caption it.
+  };
+
+  explicit ClientLanguage(bool apple_available);
+  ClientLanguage(const ClientLanguage&) = delete;
+  ClientLanguage& operator=(const ClientLanguage&) = delete;
+  ~ClientLanguage();
+
+  // macOS 26's speech for the Apple languages (it loads in the background).
+  void set_apple_available(bool available) { apple_available_ = available; }
+
+  // Auto-detect: a new call, or "Auto-detect" picked again. Captions at
+  // once: `hint` ("hi", "es"...) is where captions start before the speech
+  // process guesses; empty for none.
+  void ChooseAuto(const std::string& hint = std::string());
+  // The user picked `code` for this call.
+  void Choose(const std::string& code);
+  // The speech process heard `code` ("und": it couldn't tell). Ignored once
+  // a language is locked or picked. Returns what every recognizer in the
+  // call's tab must now be told (the lock, or the language they heard
+  // otherwise), or nothing.
+  std::optional<std::string> Detected(const std::string& code);
+
+  // Captions at once: the speech process captions on a guess, `code`, while
+  // it listens. True when the guess changed: a new one, or none when `code`
+  // is one nothing on this machine can caption (the speech process stopped
+  // the old one's captions). Ignored once a language is locked or picked.
+  bool Guessed(const std::string& code);
+  // The language being guessed while detecting; "" when none.
+  const std::string& guess() const { return guess_; }
+  // The language the last detection in this tab locked on ("" if none),
+  // kept in memory only: a new video in the tab starts on it.
+  const std::string& last_locked() const { return last_locked_; }
+
+  State state() const { return state_; }
+  // "" while detecting.
+  const std::string& code() const { return code_; }
+  bool automatic() const { return automatic_; }
+  // Locked by detection (the pill says "· detected").
+  bool detected() const { return automatic_ && !code_.empty(); }
+  // D4 any-media: a new audio stream started (a new video) in a tab that
+  // isn't in a call, and the language was detected rather than picked:
+  // listen afresh. In a call a new stream is another participant.
+  bool ShouldRestartForNewStream(bool in_call) const { return !in_call && detected(); }
+  // Bumped by every choice, so answers about an older one can be dropped.
+  uint64_t generation() const { return generation_; }
+  // Captions macOS made for a tap in `tap_language` ("es", "es-US") belong
+  // to this call: its language is that Apple language.
+  bool AcceptsAppleCaptions(const std::string& tap_language) const;
+
+  // Captions at once, several players: while captioning on a guess, captions
+  // from a recognizer on another language ("" unknown: accepted) wait.
+  bool AcceptsCaptionsFrom(const std::string& source_language) const;
+
+  // What the recognizers are told: "auto" (or "auto:<hint>") until a
+  // language is known, then
+  // that language, or "none" when nothing on this Mac can caption it.
+  std::string recognizer_code() const;
+
+ private:
+  void Set(const std::string& code);
+
+  bool apple_available_;
+  State state_ = State::kDetecting;
+  std::string code_;
+  bool automatic_ = true;
+  std::string guess_;
+  std::string hint_;
+  std::string last_locked_;
+  uint64_t generation_ = 0;
+};
+
+}  // namespace tark_captions
+
