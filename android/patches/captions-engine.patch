+namespace tark_captions {
+
+class ModelSource;
+class OrtRuntime;
+
+// What a caption is translated into (D4 Phase 2). English is the default;
+// Indian targets go through English.
+enum class Target { kNone, kEnglish, kHindi, kTamil, kBengali };
+
+// "" (none), "en", "hi", "ta" or "bn".
+std::optional<Target> TargetFromCode(std::string_view code);
+
+// One model: IndicTrans2 Indian → English and English → Indian (200M
+// distilled), and opus-mt Spanish → English (Tark for Android).
+enum class TranslationDirection { kIndicToEnglish, kEnglishToIndic, kSpanishToEnglish };
+
+// The models a caption in `source_code` ("hi", "ta", "bn", "en", "es")
+// passes through into `target`, in order: Indian and Spanish targets go
+// through English. Empty when nothing is translated (no target, the same
+// language, a source with no model).
+std::vector<TranslationDirection> DirectionsFor(std::string_view source_code, Target target);
+
+// Page translation (Tark for Android): the 22 Indian languages IndicTrans2
+// covers, by ISO code, with the model's language tag and the Unicode block of
+// the script IndicTrans2 unifies into Devanagari (0 when the script is not
+// a Brahmi one and the model reads and writes it as it is: Perso-Arabic,
+// Ol Chiki).
+struct IndicLanguage {
+  std::string_view code;  // "hi", "kok", "mni"...
+  std::string_view tag;   // "hin_Deva", "gom_Deva", "mni_Beng"...
+  char16_t block;         // 0x0900 Devanagari, 0x0B80 Tamil...; 0 for none
+};
+base::span<const IndicLanguage> IndicLanguages();
+// Null when `code` is not one of the 22.
+const IndicLanguage* IndicLanguageFromCode(std::string_view code);
+// DirectionsFor with codes on both sides: any of the 22, "en" or (as a
+// source) "es". Empty when nothing is translated.
+std::vector<TranslationDirection> PageDirectionsFor(std::string_view source_code,
+                                                    std::string_view target_code);
+
+// A translation stops after this many tokens (a caption is a few seconds).
+inline constexpr int kMaxOutputTokens = 128;
+
+// ONNX Runtime's intra-op threads per model unless Create() is told otherwise
+// (captions run beside speech recognition).
+inline constexpr int kTranslationThreads = 2;
+
+// The model's token ids, for tests: the first hop (to English) and, for an
+// Indian target, the second.
+struct TranslationTrace {
+  std::vector<int64_t> src_ids;
+  std::vector<int64_t> out_ids;
+  std::vector<int64_t> pivot_src_ids;
+  std::vector<int64_t> pivot_out_ids;
+};
+
+// Calls `work` with 0 .. count-1, each index once, on up to `parallel`
+// threads (this one and parallel - 1 more, which take the next index until
+// none is left); returns when every call has. The caller must allow base
+// sync primitives when `parallel` > 1 (it joins the threads).
+void RunInParallel(size_t count, int parallel, base::RepeatingCallback<void(size_t)> work);
+
+// AI4Bharat's IndicTrans2 distilled 200M (MIT), int8 ONNX encoder and
+// cached decoder step (utils/indictrans_export.py), greedy, one sentence at
+// a time (TranslatePages runs several on threads sharing the models). Each direction loads from the models folder (it2_indic_en/,
+// it2_en_indic/) the first time it is needed. Use on one sequence; it
+// blocks while it loads or decodes.
+class TranslationEngine {
+ public:
+  // Null if ONNX Runtime is missing; a missing model shows up in Translate().
+  // `threads` is each model's ONNX Runtime intra-op thread count.
+  static std::unique_ptr<TranslationEngine> Create(const base::FilePath& models_dir,
+                                                   const base::FilePath& ort_dylib,
+                                                   int threads = kTranslationThreads);
+  // Tark for Android: each direction's files by handle (the sandboxed
+  // captions process opens nothing). A direction without a source fails
+  // in Translate(). Null if `runtime` is.
+  static std::unique_ptr<TranslationEngine> Create(
+      std::unique_ptr<OrtRuntime> runtime,
+      std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources,
+      int threads = kTranslationThreads);
+
+  TranslationEngine(const TranslationEngine&) = delete;
+  TranslationEngine& operator=(const TranslationEngine&) = delete;
+  ~TranslationEngine();
+
+  // `caption` (UTF-8) in `source`, translated into `target`: "" for
+  // kNone or the source's own language (nothing loads), nullopt when a model
+  // it needs is missing or fails.
+  std::optional<std::string> Translate(std::string_view caption,
+                                       Language source,
+                                       Target target,
+                                       TranslationTrace* trace = nullptr);
+
+  // English `text` (UTF-8, macOS's captions) translated into `target`, in
+  // one hop: "" for kNone or kEnglish (nothing loads), nullopt when the
+  // model is missing or fails. `trace` gets its src_ids and out_ids.
+  std::optional<std::string> TranslateEnglish(std::string_view text,
+                                              Target target,
+                                              TranslationTrace* trace = nullptr);
+
+  // `caption` in `source_code` ("hi", "ta", "bn", "en", "es") into
+  // `target` (DirectionsFor): "" when nothing is translated or the caption
+  // is blank, nullopt when a model it needs is missing or fails.
+  std::optional<std::string> TranslateFrom(std::string_view caption,
+                                           std::string_view source_code,
+                                           Target target,
+                                           TranslationTrace* trace = nullptr);
+
+  // A page's sentence in `source_code` into `target_code`
+  // (PageDirectionsFor): hi, ta, bn, en and es into en, hi, ta and bn are
+  // exactly TranslateFrom; the other Indian languages go through the same
+  // models with their own tags and scripts. "" when nothing is translated,
+  // nullopt when a model it needs is missing or fails.
+  std::optional<std::string> TranslatePage(std::string_view text,
+                                           std::string_view source_code,
+                                           std::string_view target_code);
+
+  // TranslatePage for each of `texts`, aligned with them and exactly what
+  // it gives: `parallel` texts at a time, each on its own thread sharing the
+  // loaded models (no second copy). Every model the pair needs loads first,
+  // on the calling thread. With `parallel` > 1 the caller must allow base
+  // sync primitives (it joins threads).
+  std::vector<std::optional<std::string>> TranslatePages(const std::vector<std::string>& texts,
+                                                         std::string_view source_code,
+                                                         std::string_view target_code,
+                                                         int parallel = 1);
+
+  // Loads `direction`'s model now rather than at its first translation
+  // (page translation warms it). False when its files are missing or bad.
+  bool Preload(TranslationDirection direction);
+
+  int LoadedDirectionsForTesting() const;
+
+ private:
+  class Direction;
+
+  TranslationEngine(std::unique_ptr<OrtRuntime> runtime,
+                    std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources,
+                    int threads);
+  // Loads the direction on first use; null if its files are missing or bad.
+  Direction* Get(TranslationDirection direction);
+  // English model input (tokens) into `target`; the ids go to `src_ids` and
+  // `out_ids` when given.
+  std::optional<std::string> IntoIndian(std::string_view model_input,
+                                        Language target,
+                                        std::vector<int64_t>* src_ids,
+                                        std::vector<int64_t>* out_ids);
+
+  // English model input into one of the 22 (its tag and script).
+  std::optional<std::string> IntoTag(std::string_view model_input, const IndicLanguage& target);
+
+  std::unique_ptr<OrtRuntime> runtime_;
+  std::map<TranslationDirection, std::unique_ptr<ModelSource>> sources_;
+  std::map<TranslationDirection, std::unique_ptr<Direction>> loaded_;
+  const int threads_;
+  // While TranslatePages' workers run: Get() only looks up.
+  std::atomic<bool> lookup_only_ = false;
+};
