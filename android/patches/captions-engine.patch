+  language.Choose("ta");
+  EXPECT_FALSE(language.ShouldRestartForNewStream(false));
+}
+
+// A call's new streams are new participants: the lock holds.
+TEST(ClientLanguageTest, NewStreamInCallKeepsLock) {
+  ClientLanguage language(/*apple_available=*/false);
+  language.ChooseAuto();
+  language.Detected("hi");
+  EXPECT_FALSE(language.ShouldRestartForNewStream(/*in_call=*/true));
+}
+
+TEST(ClientLanguageTest, NewStreamWhileDetectingChangesNothing) {
+  ClientLanguage language(/*apple_available=*/false);
+  language.ChooseAuto();
+  EXPECT_FALSE(language.ShouldRestartForNewStream(false));
+}
+
+// Captions at once: captions run on a guess until the lock.
+TEST(ClientLanguageTest, GuessWhileDetecting) {
+  ClientLanguage language(true);
+  EXPECT_TRUE(language.Guessed("hi"));
+  EXPECT_EQ(language.state(), State::kDetecting);
+  EXPECT_EQ(language.guess(), "hi");
+  EXPECT_EQ(language.code(), "");
+  EXPECT_EQ(language.recognizer_code(), "auto");
