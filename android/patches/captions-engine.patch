+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/client_language.h"
+
+#include "components/tark_captions/detection_policy.h"
+
+namespace tark_captions {
+
+ClientLanguage::ClientLanguage(bool apple_available) : apple_available_(apple_available) {}
+
+ClientLanguage::~ClientLanguage() = default;
+
+void ClientLanguage::ChooseAuto(const std::string& hint) {
+  ++generation_;
+  automatic_ = true;
+  code_.clear();
+  guess_.clear();
+  hint_ = hint;
+  state_ = State::kDetecting;
+}
+
+void ClientLanguage::Choose(const std::string& code) {
+  ++generation_;
+  automatic_ = false;
+  guess_.clear();
+  hint_.clear();
+  Set(code);
+}
+
+bool ClientLanguage::Guessed(const std::string& code) {
+  if (!automatic_ || !code_.empty() || code.empty() || code == "und") {
+    return false;
+  }
+  const std::string guess = code == "ur" ? "hi" : code;
+  const Detection::Kind kind = KindOfLanguage(guess);
+  if (guess == guess_) {
+    return false;
+  }
+  if (!(kind == Detection::Kind::kCaption ||
+        (kind == Detection::Kind::kApple && apple_available_))) {
+    // The speech process stopped the current guess's captions for one this
+    // machine can't caption: that guess ends too (its text goes, and the
+    // next guess or the lock starts again from the first word).
+    if (guess_.empty()) {
+      return false;
+    }
+    guess_.clear();
+    return true;
+  }
+  guess_ = guess;
+  return true;
+}
+
+std::optional<std::string> ClientLanguage::Detected(const std::string& code) {
+  if (code == "und" || code.empty()) {
+    return std::nullopt;
+  }
+  if (automatic_ && code_.empty()) {
+    Set(code);
+    guess_.clear();
+    last_locked_ = code_;
+    return recognizer_code();
+  }
+  // Locked or picked already: a recognizer that heard otherwise is told.
+  const std::string heard = code == "ur" ? "hi" : code;
+  return heard == code_ ? std::nullopt : std::optional<std::string>(recognizer_code());
+}
+
+bool ClientLanguage::AcceptsAppleCaptions(const std::string& tap_language) const {
+  const std::string base = tap_language.substr(0, tap_language.find('-'));
+  // Captions at once: macOS captions a guessed Apple language too.
+  return (state_ == State::kApple && base == code_) ||
+         (state_ == State::kDetecting && !guess_.empty() && base == guess_);
+}
+
+bool ClientLanguage::AcceptsCaptionsFrom(const std::string& source_language) const {
+  if (state_ != State::kDetecting || guess_.empty() || source_language.empty()) {
+    return true;
+  }
+  return (source_language == "ur" ? "hi" : source_language) == guess_;
+}
+
+std::string ClientLanguage::recognizer_code() const {
+  switch (state_) {
+    case State::kDetecting:
+      return hint_.empty() ? "auto" : "auto:" + hint_;
+    case State::kCaptioning:
+    case State::kApple:
+      return code_;
+    case State::kAppleUnavailable:
+    case State::kPlanned:
+    case State::kUnsupported:
+      return "none";
+  }
+}
+
+void ClientLanguage::Set(const std::string& code) {
+  code_ = code == "ur" ? "hi" : code;
+  switch (KindOfLanguage(code_)) {
+    case Detection::Kind::kCaption:
+      state_ = State::kCaptioning;
+      break;
+    case Detection::Kind::kApple:
+      state_ = apple_available_ ? State::kApple : State::kAppleUnavailable;
+      break;
+    case Detection::Kind::kPlanned:
+      state_ = State::kPlanned;
+      break;
+    case Detection::Kind::kUnsure:
+    case Detection::Kind::kUnsupported:
+      state_ = State::kUnsupported;
+      break;
+  }
+}
+
+}  // namespace tark_captions
