+TEST(ClientLanguageTest, CaptionsFromAnotherLanguageWaitWhileGuessing) {
+  ClientLanguage language(true);
+  language.Guessed("hi");
+  EXPECT_FALSE(language.AcceptsCaptionsFrom("ta"));
+  EXPECT_TRUE(language.AcceptsCaptionsFrom("hi"));
