+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_CHOICES_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_CHOICES_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+
+class PrefRegistrySimple;
+class PrefService;
+
+namespace tark_captions {
+
+// The caption choices Tark remembers for every call (D4): the script the
+// user reads their client's words in ("" their own, "latn" English letters,
+// or "hi"/"ta"/"bn" for that language's script) and the language
+// translations go into ("en", "hi", "ta", "bn"). Kept in local state, so
+// for every profile; the client's language is not remembered. Incognito
+// starts from them and keeps its own changes in memory only.
+class CaptionChoices {
+ public:
+  static constexpr char kShowInPref[] = "tark.captions.show_in";
+  static constexpr char kTranslateToPref[] = "tark.captions.translate_to";
+  // D4 any-media: Settings › Live captions › "Show the captions button".
+  static constexpr char kShowButtonPref[] = "tark.captions.show_button";
+
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+  static void ResetIncognitoForTesting();
+
+  explicit CaptionChoices(PrefService* local_state);
+  CaptionChoices(const CaptionChoices&) = delete;
+  CaptionChoices& operator=(const CaptionChoices&) = delete;
+  ~CaptionChoices();
+
+  std::string show_in(bool off_the_record) const;
+  std::string translate_to(bool off_the_record) const;
+  // Unknown codes are ignored.
+  void SetShowIn(const std::string& code, bool off_the_record);
+  void SetTranslateTo(const std::string& code, bool off_the_record);
+  // The CC button on videos and calls (Settings only; incognito reads it).
+  bool show_button() const;
+  void SetShowButton(bool show);
+
+ private:
+  raw_ptr<PrefService> local_state_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_CHOICES_H_
