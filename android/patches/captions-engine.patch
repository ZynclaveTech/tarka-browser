+#include "components/tark_captions/vad.h"
+
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "components/tark_captions/model_source.h"
+#include "components/tark_captions/ort_runtime.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr size_t kContext = 64;
+constexpr size_t kState = 2 * 1 * 128;
+
+}  // namespace
+
+// static
+std::unique_ptr<Vad> Vad::Load(OrtRuntime* runtime, const base::FilePath& models_dir) {
+  return Load(runtime, DirectorySource(models_dir));
+}
+
+// static
+std::unique_ptr<Vad> Vad::Load(OrtRuntime* runtime, const ModelSource& source) {
+  std::unique_ptr<OrtModel> model = runtime->LoadModel(source, "silero_vad.onnx", 1);
+  return model ? base::WrapUnique(new Vad(std::move(model))) : nullptr;
+}
+
+Vad::Vad(std::unique_ptr<OrtModel> model) : model_(std::move(model)) {
+  Reset();
+}
+
+Vad::~Vad() = default;
+
+void Vad::Reset() {
+  state_.assign(kState, 0.0f);
+  context_.assign(kContext, 0.0f);
+}
+
+float Vad::Process(base::span<const float, kChunk> chunk) {
+  std::vector<Tensor> inputs(3);
+  inputs[0] = {.name = "input", .shape = {1, static_cast<int64_t>(kContext + kChunk)}};
+  inputs[0].f32 = context_;
+  inputs[0].f32.insert(inputs[0].f32.end(), chunk.begin(), chunk.end());
+  inputs[1] = {.name = "state", .shape = {2, 1, 128}, .f32 = state_};
+  inputs[2] = {.name = "sr", .shape = {}, .i64 = {16000}};
+  std::vector<Tensor> outputs;
+  context_.assign(chunk.end() - kContext, chunk.end());
+  if (!model_->Run(inputs, {"output", "stateN"}, &outputs) || outputs[0].f32.empty() ||
+      outputs[1].f32.size() != kState) {
+    return 0.0f;
+  }
+  state_ = std::move(outputs[1].f32);
+  return outputs[0].f32[0];
+}
+
