+#ifndef COMPONENTS_TARK_CAPTIONS_LANGUAGE_DETECTOR_H_
+#define COMPONENTS_TARK_CAPTIONS_LANGUAGE_DETECTOR_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace tark_captions {
+
+class OrtModel;
+class OrtRuntime;
+
+// Which language someone speaks (D4 Phase 3): SpeechBrain's VoxLingua107
+// ECAPA, exported by utils/lid_export.py to lid.onnx (16 kHz audio in, a
+// log-probability per language out) with its labels in lid_labels.txt. Runs
+// in the speech process; DecideLanguage (detection_policy.h) reads the
+// scores. Use on one sequence.
+class LanguageDetector {
+ public:
+  // Null when the models folder has no detector (the language_id unit).
+  static std::unique_ptr<LanguageDetector> Load(OrtRuntime* runtime,
+                                                const base::FilePath& models_dir);
+
+  LanguageDetector(const LanguageDetector&) = delete;
+  LanguageDetector& operator=(const LanguageDetector&) = delete;
+  ~LanguageDetector();
+
+  // One score per label for 16 kHz mono speech; empty if the model fails.
+  std::vector<float> Logits(base::span<const float> pcm16k);
+  const std::vector<std::string>& labels() const { return labels_; }
+
+ private:
+  LanguageDetector(std::unique_ptr<OrtModel> model, std::vector<std::string> labels);
+
+  std::unique_ptr<OrtModel> model_;
+  std::vector<std::string> labels_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_LANGUAGE_DETECTOR_H_
