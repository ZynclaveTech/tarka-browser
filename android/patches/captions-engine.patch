+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/language_gate.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/rand_util.h"
+#include "components/tark_captions/test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+class LanguageGateTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ort_ = test::OrtPath();
+    models_ = test::ModelsDir();
+    testdata_ = test::TestDataDir();
+    if (!ort_ || !models_ || !testdata_) {
+      GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+    }
+    gate_ = LanguageGate::Create(*models_, *ort_);
+    ASSERT_TRUE(gate_);
+  }
+
+  // Feeds `pcm` in 10 ms blocks; the first decision, if any. Guesses are
+  // kept in `guesses_`, each with the seconds of speech it came at.
+  std::optional<Detection> Feed(const std::vector<float>& pcm) {
+    std::optional<Detection> first;
+    for (size_t i = 0; i < pcm.size(); i += 160) {
+      LanguageGate::Result r =
+          gate_->AddMono16k(base::span(pcm).subspan(i, std::min<size_t>(160, pcm.size() - i)));
+      if (r.guess) {
+        guesses_.emplace_back(*r.guess, gate_->speech_seconds());
+        if (!first) {
+          heard_at_guess_ = gate_->heard().size();
+        }
+      }
+      if (r.decision && !first) {
+        first = r.decision;
+      }
+    }
+    return first;
+  }
+
+  std::vector<float> Clip(const std::string& name) {
+    int rate = 0;
+    std::vector<float> pcm = test::ReadWav(testdata_->AppendASCII(name), &rate);
+    EXPECT_EQ(rate, 16000);
+    return pcm;
+  }
+
+  std::optional<base::FilePath> ort_, models_, testdata_;
+  std::unique_ptr<LanguageGate> gate_;
+  std::vector<std::pair<std::string, double>> guesses_;
+  size_t heard_at_guess_ = 0;
+};
+
+TEST_F(LanguageGateTest, DecidesSpanishAndKeepsWhatItHeard) {
+  std::optional<Detection> d = Feed(Clip("lid/es_1.wav"));
+  ASSERT_TRUE(d);
+  EXPECT_EQ(d->kind, Detection::Kind::kApple);
+  EXPECT_EQ(d->code, "es");
+  EXPECT_GE(gate_->TakeHeard().size(), 3u * 16000);
+  EXPECT_TRUE(gate_->TakeHeard().empty());
+}
+
+TEST_F(LanguageGateTest, DecidesOnce) {
+  std::vector<float> pcm = Clip("lid/hi_1.wav");
+  ASSERT_TRUE(Feed(pcm));
+  EXPECT_FALSE(Feed(pcm));
+}
+
+TEST_F(LanguageGateTest, SilenceAndNoiseNeverDecide) {
+  std::vector<float> pcm(10 * 16000, 0.0f);
+  float last = 0;
+  for (int i = 0; i < 10 * 16000; ++i) {
+    // Low-passed white noise, roughly pink.
+    last = 0.95f * last + 0.05f * static_cast<float>(base::RandDouble() * 2 - 1);
+    pcm.push_back(last * 2);
+  }
+  EXPECT_FALSE(Feed(pcm));
+  EXPECT_LT(gate_->speech_seconds(), kFirstDecision);
+  EXPECT_TRUE(guesses_.empty());
+}
+
+// Captions at once: a guess comes from the first 1 to 2 s of speech, the
+// decision later.
+TEST_F(LanguageGateTest, GuessesBeforeDeciding) {
+  std::optional<Detection> d = Feed(Clip("lid/hi_1.wav"));
+  ASSERT_TRUE(d);
+  EXPECT_EQ(d->code, "hi");
+  ASSERT_FALSE(guesses_.empty());
+  EXPECT_EQ(guesses_.front().first, "hi");
+  // A guess is made when the speech crosses a check (one VAD chunk late at most).
+  EXPECT_LE(guesses_.front().second, kGuessChecks[std::size(kGuessChecks) - 1] + 0.05);
+}
+
+TEST_F(LanguageGateTest, GuessIsReportedOnce) {
+  ASSERT_TRUE(Feed(Clip("lid/es_1.wav")));
+  ASSERT_EQ(guesses_.size(), 1u);
+  EXPECT_EQ(guesses_.front().first, "es");
+}
+
+// The audio since the speech began stays for a replay; the decision takes it.
+TEST_F(LanguageGateTest, HeardIsKeptForReplay) {
+  std::vector<float> pcm = Clip("lid/es_1.wav");
+  // Up to 2.5 s of the clip: past the guesses, before the decision.
+  pcm.resize(std::min<size_t>(pcm.size(), 40000));
+  Feed(pcm);
+  ASSERT_FALSE(guesses_.empty());
+  EXPECT_GT(heard_at_guess_, 0u);
+  const size_t kept = gate_->heard().size();
+  EXPECT_GE(kept, heard_at_guess_);
+  EXPECT_EQ(gate_->TakeHeard().size(), kept);
+}
+
+TEST_F(LanguageGateTest, MissingDetectorIsNull) {
+  EXPECT_FALSE(LanguageGate::Create(base::FilePath("/nonexistent"), *ort_));
+}
+
