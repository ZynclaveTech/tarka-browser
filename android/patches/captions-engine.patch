+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_MEDIA_PLAYERS_H_
+#define COMPONENTS_TARK_CAPTIONS_MEDIA_PLAYERS_H_
+
+#include <optional>
+
+#include "base/containers/flat_map.h"
+#include "base/time/time.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace tark_captions {
+
+// One media player in a tab: content::MediaPlayerId without content.
+struct PlayerKey {
+  int child_id = 0;
+  int frame_routing_id = 0;
+  int player_id = 0;
+  friend auto operator<=>(const PlayerKey&, const PlayerKey&) = default;
+};
+
+// The captions button (D4 any-media) shows a moment after sound starts and
+// stays a few seconds after it stops, so a pause doesn't make it blink.
+inline constexpr base::TimeDelta kButtonAppearDelay = base::Milliseconds(500);
+inline constexpr base::TimeDelta kButtonLingerDelay = base::Seconds(3);
+// On a video: in from its right edge, and lifted above the player's own
+// control bar. Otherwise: from the content area's bottom-right corner.
+inline constexpr int kButtonInset = 10;
+inline constexpr int kButtonLift = 50;
+inline constexpr int kWindowCornerMargin = 16;
+
+// The tab's media players, as the browser hears of them: which play sound,
+// and where the playing videos are. Times come from the caller.
+class MediaPlayers {
+ public:
+  MediaPlayers();
+  MediaPlayers(const MediaPlayers&) = delete;
+  MediaPlayers& operator=(const MediaPlayers&) = delete;
+  ~MediaPlayers();
+
+  void OnStarted(const PlayerKey& key, bool has_video, bool has_audio, base::TimeTicks now);
+  void OnStopped(const PlayerKey& key, base::TimeTicks now);
+  void OnMuted(const PlayerKey& key, bool muted, base::TimeTicks now);
+  void OnDestroyed(const PlayerKey& key, base::TimeTicks now);
+  // The video's box in the content area's coordinates (DIP): nullopt when it
+  // isn't known (never reported, or a frame that can't be mapped), an empty
+  // rect when it isn't visible.
+  void OnVideoRect(const PlayerKey& key, std::optional<gfx::Rect> rect);
+  void SetTabMuted(bool muted, base::TimeTicks now);
+  // A player's tracks changed (a muted autoplay video unmuted gains audio).
+  void OnMetadata(const PlayerKey& key, bool has_video, bool has_audio, base::TimeTicks now);
+  // The tab plays sound from no media element (Web Audio).
+  void SetTabAudible(bool audible, base::TimeTicks now);
+
+  // Sound now: a player playing, with audio, not muted, in an unmuted tab;
+  // or the tab audible (Web Audio).
+  bool AnyAudible() const;
+  // Whether the button shows at `now`; a call always shows it.
+  bool ButtonShown(bool in_call, base::TimeTicks now) const;
+  // When ButtonShown() changes next by itself, if it does.
+  std::optional<base::TimeTicks> NextChange(bool in_call, base::TimeTicks now) const;
+  // The box of the audible video that started last or, with none audible,
+  // of the video heard last (paused: the button stays on it), if its box is
+  // known (possibly empty: not visible).
+  std::optional<gfx::Rect> AnchorVideo() const;
+
+ private:
+  struct Player {
+    bool has_video = false;
+    bool has_audio = false;
+    bool playing = false;
+    bool muted = false;
+    base::TimeTicks started;
+    // When it last stopped being audible.
+    std::optional<base::TimeTicks> heard_until;
+    std::optional<gfx::Rect> rect;
+  };
+
+  bool Audible(const Player& player) const;
+  // Players that were audible before a change and aren't now were last
+  // heard `now`.
+  void MarkSilenced(const base::flat_map<PlayerKey, bool>& was_audible, base::TimeTicks now);
+  base::flat_map<PlayerKey, bool> AudibleNow() const;
+  const Player* Anchor() const;
+  // After any change: starts or ends a stretch of sound.
+  void Update(bool was_audible, base::TimeTicks now);
+
+  base::flat_map<PlayerKey, Player> players_;
+  bool tab_muted_ = false;
+  bool tab_audible_ = false;
+  // When the current stretch of sound began (pauses shorter than the linger
+  // don't end it), and when the sound last stopped.
+  std::optional<base::TimeTicks> sound_since_;
+  std::optional<base::TimeTicks> silent_since_;
+};
+
+// Where the button goes, in the content area's coordinates: on the audible
+// video that started last (or the video heard last), lifted above its
+// controls; the content area's
+// bottom-right corner in a call, for sound with no video, or when that
+// video's box isn't known; nowhere (nullopt) when it is off screen.
+std::optional<gfx::Rect> PlaceButton(const MediaPlayers& players,
+                                     bool in_call,
+                                     const gfx::Size& content_area,
+                                     const gfx::Size& button);
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_MEDIA_PLAYERS_H_
