+#ifndef COMPONENTS_TARK_CAPTIONS_VAD_H_
+#define COMPONENTS_TARK_CAPTIONS_VAD_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace tark_captions {
+
+class OrtModel;
+class ModelSource;
+class OrtRuntime;
+
+// Silero VAD (MIT): the probability that a 32 ms chunk of 16 kHz audio is
+// speech. Keeps the model's recurrent state and a 64-sample context
+// between chunks, as Silero's own wrapper does.
+class Vad {
+ public:
+  static constexpr size_t kChunk = 512;
+
+  // Reads silero_vad.onnx from `models_dir`; null if missing or invalid.
+  static std::unique_ptr<Vad> Load(OrtRuntime* runtime, const base::FilePath& models_dir);
+  static std::unique_ptr<Vad> Load(OrtRuntime* runtime, const ModelSource& source);
+
+  Vad(const Vad&) = delete;
+  Vad& operator=(const Vad&) = delete;
+  ~Vad();
+
+  // 0 on a model error.
+  float Process(base::span<const float, kChunk> chunk);
+  void Reset();
+
+ private:
+  explicit Vad(std::unique_ptr<OrtModel> model);
+
+  std::unique_ptr<OrtModel> model_;
+  std::vector<float> state_;    // (2, 1, 128)
+  std::vector<float> context_;  // the previous chunk's last 64 samples
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_VAD_H_
