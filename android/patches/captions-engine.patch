+namespace tark_captions {
+namespace {
+
+TEST(MelFrontendTest, MatchesGolden) {
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  std::unique_ptr<MelFrontend> frontend = MelFrontend::Load(*models);
+  ASSERT_TRUE(frontend);
+  base::ListValue clips = test::GoldenClips(*testdata);
+  ASSERT_EQ(clips.size(), 4u);
+  for (const base::Value& clip : clips) {
+    const std::string& wav = *clip.GetDict().FindString("wav");
+    int rate = 0;
+    std::vector<float> pcm = test::ReadWav(testdata->AppendASCII(wav), &rate);
+    ASSERT_EQ(rate, 16000) << wav;
+    int frames = 0;
+    std::vector<float> features = frontend->Compute(pcm, &frames);
+    ASSERT_EQ(frames, *clip.GetDict().FindInt("features_frames")) << wav;
+    ASSERT_EQ(features.size(), static_cast<size_t>(80 * frames)) << wav;
+    const base::ListValue& head = *clip.GetDict().FindList("features_head");
+    float worst = 0;
+    for (int f = 0; f < 5; ++f) {
+      const base::ListValue& row = head[f].GetList();
+      for (int m = 0; m < 80; ++m) {
+        worst = std::max(worst, std::abs(features[m * frames + f] -
+                                         static_cast<float>(row[m].GetDouble())));
+      }
+    }
+    EXPECT_LE(worst, 1e-3f) << wav;
+  }
+}
+
+// NeMo 3's per-language models (IndicConformer 130M, FastConformer): n/hop
+// valid frames normalised and the rest zeroed, the STFT padded with zeros.
+// The golden is the spike's reference (scripts/models.py engine_mel), which
+// matched NeMo's own preprocessor to 2.4e-4.
+TEST(MelFrontendTest, ZeroPadHopFramesMatchNemo) {
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(testdata->AppendASCII("mel_golden.json"), &json));
+  std::optional<base::Value> golden = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(golden && golden->is_dict());
+  const base::DictValue& g = golden->GetDict();
+  DirectorySource source(testdata->AppendASCII(*g.FindString("models")));
+  std::optional<ModelConventions> conventions = ReadConventions(source);
+  ASSERT_TRUE(conventions);
+  EXPECT_EQ(conventions->frames, ModelConventions::Frames::kHop);
+  EXPECT_EQ(conventions->pad, ModelConventions::Pad::kZero);
+  std::unique_ptr<MelFrontend> frontend = MelFrontend::Load(source, *conventions);
+  ASSERT_TRUE(frontend);
+  int rate = 0;
+  std::vector<float> pcm = test::ReadWav(testdata->AppendASCII(*g.FindString("wav")), &rate);
+  int frames = 0;
+  int valid = 0;
+  std::vector<float> features = frontend->Compute(pcm, &frames, &valid);
+  ASSERT_EQ(frames, *g.FindInt("frames"));
+  ASSERT_EQ(valid, *g.FindInt("valid"));
+  float worst = 0;
+  auto compare = [&](const base::ListValue& rows, int first_frame) {
+    for (int m = 0; m < MelFrontend::kMels; ++m) {
+      const base::ListValue& row = rows[m].GetList();
+      for (size_t i = 0; i < row.size(); ++i) {
+        worst = std::max(worst, std::abs(features[m * frames + first_frame + i] -
+                                         static_cast<float>(row[i].GetDouble())));
+      }
+    }
+  };
+  compare(*g.FindList("head"), 0);
+  compare(*g.FindList("tail"), frames - 5);
+  EXPECT_LE(worst, 1e-3f);
+}
+
+TEST(MelFrontendTest, DefaultsAreTheMacs) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::optional<ModelConventions> conventions = ReadConventions(DirectorySource(dir.GetPath()));
+  ASSERT_TRUE(conventions);
+  EXPECT_EQ(conventions->frames, ModelConventions::Frames::kHopPlusOne);
+  EXPECT_EQ(conventions->pad, ModelConventions::Pad::kReflect);
+  EXPECT_EQ(conventions->blank, 256);
+}
+
