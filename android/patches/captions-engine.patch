+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_SEGMENTER_H_
+#define COMPONENTS_TARK_CAPTIONS_SEGMENTER_H_
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+namespace tark_captions {
+
+// What to decode after a chunk: nothing, a draft of the current segment,
+// or the segment's final text. Times are seconds of audio.
+struct SegmenterAction {
+  enum Kind { kNone, kDraft, kFinal } kind = kNone;
+  double start_s = 0;
+  double end_s = 0;
+};
+
+// Turns per-chunk speech probabilities into decode actions (the D4 spike's
+// CPU fix, measured at ~25% of a core and ~0.5 s lag): nothing is decoded
+// in silence; while someone speaks the segment is redrafted every 0.8 s;
+// a 0.5 s pause makes it final; a segment reaching 5 s is cut at its
+// quietest chunk of the last 2.5 s (never in its first second) so a draft
+// never spans more than 5 s. Segments under 0.3 s are not decoded.
+class Segmenter {
+ public:
+  static constexpr float kSpeech = 0.5f;
+  static constexpr double kPreRoll = 0.3;
+  static constexpr double kPostRoll = 0.2;
+  static constexpr double kPause = 0.5;
+  static constexpr double kDraftEvery = 0.8;
+  static constexpr double kMaxSegment = 5.0;
+  static constexpr double kMinSegment = 0.3;
+
+  // The knobs Android varies per phone; the defaults are the Mac's.
+  struct Options {
+    double draft_every = kDraftEvery;
+    double max_segment = kMaxSegment;
+    // Phrase at a time: no drafts, only each segment's final.
+    bool phrase = false;
+  };
+
+  Segmenter();
+  explicit Segmenter(Options options);
+  ~Segmenter();
+
+  // `chunk_end_s`: the end of the chunk `speech_prob` describes.
+  SegmenterAction OnChunk(double chunk_end_s, float speech_prob);
+  // At the end of the audio: the open segment's final, if any.
+  std::optional<SegmenterAction> Flush(double audio_end_s);
+
+ private:
+  SegmenterAction Make(SegmenterAction::Kind kind, double start_s, double end_s) const;
+
+  const Options options_;
+  bool speaking_ = false;
+  double segment_start_ = 0;
+  double last_speech_ = 0;
+  double last_draft_ = 0;
+  std::vector<std::pair<double, float>> probs_;  // this segment's chunks
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_SEGMENTER_H_
