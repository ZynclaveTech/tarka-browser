+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_engine.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/test/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/tark_captions/test_util.h"
+#include "media/base/sinc_resampler.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+// Character error rate of `hyp` against `ref` (UTF-16 units; the test
+// scripts are in the BMP).
+double Cer(const std::string& ref, const std::string& hyp) {
+  const std::u16string r = base::UTF8ToUTF16(ref);
+  const std::u16string h = base::UTF8ToUTF16(hyp);
+  std::vector<size_t> row(h.size() + 1);
+  for (size_t j = 0; j <= h.size(); ++j) {
+    row[j] = j;
+  }
+  for (size_t i = 1; i <= r.size(); ++i) {
+    size_t diagonal = row[0];
+    row[0] = i;
+    for (size_t j = 1; j <= h.size(); ++j) {
+      const size_t up = row[j];
+      row[j] = std::min({row[j] + 1, row[j - 1] + 1, diagonal + (r[i - 1] != h[j - 1])});
+      diagonal = up;
+    }
+  }
+  return r.empty() ? 0 : static_cast<double>(row[h.size()]) / r.size();
+}
+
+std::string NoSpaces(std::string s) {
+  std::erase(s, ' ');
+  return s;
+}
+
+class CaptionEngineTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    std::optional<base::FilePath> ort = test::OrtPath();
+    std::optional<base::FilePath> models = test::ModelsDir();
+    std::optional<base::FilePath> testdata = test::TestDataDir();
+    if (!ort || !models || !testdata) {
+      GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+    }
+    ort_ = *ort;
+    models_ = *models;
+    // The two Hindi clips joined by 1 s of silence, and their golden text.
+    for (const base::Value& clip : test::GoldenClips(*testdata)) {
+      if (*clip.GetDict().FindString("lang") != "hi") {
+        continue;
+      }
+      int rate = 0;
+      std::vector<float> pcm =
+          test::ReadWav(testdata->AppendASCII(*clip.GetDict().FindString("wav")), &rate);
+      track_.insert(track_.end(), pcm.begin(), pcm.end());
+      track_.insert(track_.end(), 16000, 0.0f);
+      reference_ += *clip.GetDict().FindString("ctc_text") + " ";
+    }
+    ASSERT_GT(track_.size(), 16000u * 10);
+  }
+
+  // Feeds `audio` in 10 ms blocks and returns the finals, joined.
+  std::string Finals(const std::vector<float>& audio, int channels, int rate) {
+    std::unique_ptr<CaptionEngine> engine = CaptionEngine::Create(models_, ort_);
+    EXPECT_TRUE(engine);
+    if (!engine) {
+      return std::string();
+    }
+    engine->SetLanguage(Language::kHindi);
+    std::string finals;
+    auto on_event = base::BindLambdaForTesting([&](CaptionEvent e) {
+      if (e.is_final) {
+        finals += e.text + " ";
+      }
+    });
+    const size_t block = static_cast<size_t>(rate / 100) * channels;
+    for (size_t i = 0; i < audio.size(); i += block) {
+      engine->AddAudio(base::span(audio).subspan(i, std::min(block, audio.size() - i)), channels,
+                       rate, on_event);
+    }
+    engine->Flush(on_event);
+    return finals;
+  }
+
+  base::FilePath ort_;
+  base::FilePath models_;
+  std::vector<float> track_;
+  std::string reference_;
+};
+
+TEST_F(CaptionEngineTest, JoinedTrackFinals) {
+  const std::string finals = Finals(track_, 1, 16000);
+  EXPECT_LE(Cer(NoSpaces(reference_), NoSpaces(finals)), 0.05) << finals;
+}
+
+TEST_F(CaptionEngineTest, Resample48kMatches16k) {
+  // The track at 48 kHz stereo, as Meet plays it.
+  std::vector<float> mono48;
+  size_t read = 0;
+  media::SincResampler up(16000.0 / 48000.0, media::SincResampler::kDefaultRequestSize,
+                          base::BindLambdaForTesting([&](base::span<float> dest) {
+                            for (float& s : dest) {
+                              s = read < track_.size() ? track_[read++] : 0.0f;
+                            }
+                          }));
+  mono48.resize(track_.size() * 3);
+  up.Resample(mono48);
+  std::vector<float> stereo48;
+  for (float s : mono48) {
+    stereo48.push_back(s);
+    stereo48.push_back(s);
+  }
+  const std::string at16 = Finals(track_, 1, 16000);
+  const std::string at48 = Finals(stereo48, 2, 48000);
+  const double cer16 = Cer(NoSpaces(reference_), NoSpaces(at16));
+  const double cer48 = Cer(NoSpaces(reference_), NoSpaces(at48));
+  // 48 kHz stereo is captioned as well as 16 kHz mono (within a point).
+  EXPECT_LE(cer48, cer16 + 0.01) << "16k " << cer16 << ": " << at16 << " | 48k " << cer48 << ": " << at48;
+}
+
+// A call page with several audio players gets one recognizer (and engine)
+// per player: they must share one loaded model, not load ~600 MB each.
+TEST_F(CaptionEngineTest, EnginesShareTheModel) {
+  EXPECT_EQ(CaptionEngine::LoadedModelsForTesting(), 0);
+  std::unique_ptr<CaptionEngine> first = CaptionEngine::Create(models_, ort_);
+  std::unique_ptr<CaptionEngine> second = CaptionEngine::Create(models_, ort_);
+  ASSERT_TRUE(first && second);
+  EXPECT_EQ(CaptionEngine::LoadedModelsForTesting(), 1);
+  first.reset();
+  EXPECT_EQ(CaptionEngine::LoadedModelsForTesting(), 1);
+  second.reset();
+  EXPECT_EQ(CaptionEngine::LoadedModelsForTesting(), 0);
+}
+
+TEST_F(CaptionEngineTest, MissingModelsFail) {
+  EXPECT_FALSE(CaptionEngine::Create(base::FilePath("/nonexistent"), ort_));
+}
+
+}  // namespace
+}  // namespace tark_captions
