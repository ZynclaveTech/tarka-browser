+namespace tark_captions {
+
+int64_t UnitSize(const ModelUnitInfo& info) {
+  int64_t size = 0;
+  for (const ModelFile& file : info.files) {
+    size += file.size;
+  }
+  return size;
+}
+
+int64_t UnitSize(ModelUnit unit) {
+  for (const ModelUnitInfo& info : ModelManifest()) {
+    if (info.unit == unit) {
+      return UnitSize(info);
+    }
+  }
+  return 0;
+}
+
+int64_t Megabytes(int64_t bytes) {
+  return bytes / 1'000'000;
+}
+
+int64_t AboutMegabytes(int64_t bytes) {
+  return (bytes + 5'000'000) / 10'000'000 * 10;
+}
+
+std::vector<ModelUnit> UnitsForTranslation(Target target) {
+  switch (target) {
+    case Target::kNone:
+      return {};
+    case Target::kEnglish:
+      return {ModelUnit::kToEnglish};
+    case Target::kHindi:
+    case Target::kTamil:
+    case Target::kBengali:
+      return {ModelUnit::kToEnglish, ModelUnit::kFromEnglish};
+  }
+}
+
+std::vector<ModelUnit> UnitsForCaptions(const ClientLanguage& language) {
+  std::vector<ModelUnit> units = {ModelUnit::kLanguageId};
+  const bool own = language.state() == ClientLanguage::State::kCaptioning ||
+                   (!language.automatic() && language.state() == ClientLanguage::State::kDetecting);
+  if (own) {
+    units.push_back(ModelUnit::kCaptions);
+  }
+  return units;
+}
+
+std::vector<ModelUnit> UnitsForTranslating(const ClientLanguage& language, Target target) {
+  if (language.state() != ClientLanguage::State::kApple) {
+    return UnitsForTranslation(target);
+  }
+  if (target == Target::kEnglish || target == Target::kNone) {
+    return {};
+  }
+  return {ModelUnit::kFromEnglish};
+}
+
