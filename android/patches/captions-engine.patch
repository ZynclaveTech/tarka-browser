+namespace tark_captions {
+
+namespace english_text_internal {
+
+bool IsAlpha(char32_t c) {
+  return u_hasBinaryProperty(c, UCHAR_ALPHABETIC);
+}
+
+bool IsNumber(char32_t c) {
+  // sacremoses' table holds a newline too (how the table is stored); text
+  // has none by the time it is used.
+  return c == '\n' || (U_GET_GC_MASK(c) & U_GC_N_MASK) != 0;
+}
+
+bool IsAlnum(char32_t c) {
+  return IsAlpha(c) || u_charType(c) == U_DECIMAL_DIGIT_NUMBER;
+}
+
+bool IsLower(char32_t c) {
+  return u_hasBinaryProperty(c, UCHAR_LOWERCASE);
+}
+
+bool IsSpace(char32_t c) {
+  // Python's str.isspace(): Unicode White_Space plus the ASCII separators.
+  return u_isUWhiteSpace(c) || (c >= 0x1C && c <= 0x1F);
+}
+
+}  // namespace english_text_internal
+
+namespace {
+
+using english_text_internal::IsAlnum;
+using english_text_internal::IsAlpha;
+using english_text_internal::IsLower;
+using english_text_internal::IsNumber;
+using english_text_internal::IsSpace;
+
+using Text = std::u32string;
+using CharTest = bool (*)(char32_t);
+
+constexpr char32_t kNbsp = 0xA0;
+
+bool IsDigit(char32_t c) {  // Python's \d.
+  return u_charType(c) == U_DECIMAL_DIGIT_NUMBER;
+}
+bool IsNotAlpha(char32_t c) {
+  return !IsAlpha(c);
+}
+bool IsNotNumber(char32_t c) {
+  return !IsNumber(c);
+}
+bool IsNotAlphaOrNumber(char32_t c) {
+  return !IsAlpha(c) && !IsNumber(c);
+}
+template <char32_t C>
+bool Is(char32_t c) {
+  return c == C;
+}
+bool IsBracketPunct(char32_t c) {
+  return c == '.' || c == '!' || c == ':' || c == '?' || c == ';' || c == ',';
+}
+
+Text Decode(std::string_view utf8) {
+  Text out;
+  for (size_t i = 0; i < utf8.size(); ++i) {
+    base_icu::UChar32 c;
+    out.push_back(base::ReadUnicodeCharacter(utf8, &i, &c)
+                      ? static_cast<char32_t>(c)
+                      : U'\uFFFD');
+  }
+  return out;
+}
+
+std::string Encode(const Text& text) {
+  std::string out;
+  for (char32_t c : text) {
+    base::WriteUnicodeCharacter(static_cast<base_icu::UChar32>(c), &out);
+  }
+  return out;
+}
+
+// re.sub with a literal pattern.
+void Replace(Text& text, std::u32string_view from, std::u32string_view to) {
+  Text out;
+  size_t at = 0;
+  for (size_t found; (found = text.find(from, at)) != Text::npos; at = found + from.size()) {
+    out.append(text, at, found - at);
+    out.append(to);
+  }
+  out.append(text, at);
+  text = std::move(out);
+}
+
+// re.sub with a pattern of one character class per position: leftmost
+// matches, never overlapping.
+void Replace(Text& text,
+             std::initializer_list<CharTest> pattern,
+             base::FunctionRef<Text(std::u32string_view)> to) {
+  const size_t n = pattern.size();
+  Text out;
+  size_t i = 0;
+  while (i < text.size()) {
+    bool match = i + n <= text.size();
+    for (size_t k = 0; match && k < n; ++k) {
+      match = pattern.begin()[k](text[i + k]);
+    }
+    if (match) {
+      out += to(std::u32string_view(text).substr(i, n));
+      i += n;
+    } else {
+      out.push_back(text[i++]);
+    }
+  }
+  text = std::move(out);
+}
+
+// re.sub(" +", " ") (or "[ ]{2,}", the same).
+void CollapseAsciiSpaces(Text& text) {
+  Text out;
+  for (char32_t c : text) {
+    if (!(c == ' ' && !out.empty() && out.back() == ' ')) {
+      out.push_back(c);
+    }
+  }
+  text = std::move(out);
+}
+
+// re.sub(r"\s+", " ").
+void CollapseSpaces(Text& text) {
+  Text out;
+  bool in_run = false;
+  for (char32_t c : text) {
+    if (!IsSpace(c)) {
+      out.push_back(c);
+    } else if (!in_run) {
+      out.push_back(' ');
+    }
+    in_run = IsSpace(c);
+  }
+  text = std::move(out);
+}
+
+// str.strip().
+void Strip(Text& text) {
+  size_t begin = 0;
+  size_t end = text.size();
+  while (begin < end && IsSpace(text[begin])) {
+    ++begin;
+  }
+  while (end > begin && IsSpace(text[end - 1])) {
+    --end;
+  }
+  text = text.substr(begin, end - begin);
+}
+
+void MapChars(Text& text, std::u32string_view from, char32_t to) {
+  for (char32_t& c : text) {
+    if (from.find(c) != std::u32string_view::npos) {
+      c = to;
+    }
+  }
+}
+
+// `"([,.]+)` -> `\1"`.
+void QuoteAfterCommas(Text& text) {
+  Text out;
+  for (size_t i = 0; i < text.size();) {
+    size_t run = i + 1;
+    while (text[i] == '"' && run < text.size() && (text[run] == ',' || text[run] == '.')) {
+      ++run;
+    }
+    if (text[i] == '"' && run > i + 1) {
+      out.append(text, i + 1, run - i - 1);
+      out.push_back('"');
+      i = run;
+    } else {
+      out.push_back(text[i++]);
+    }
+  }
+  text = std::move(out);
+}
+
+Text Join(std::u32string_view a, std::u32string_view b, std::u32string_view c = U"") {
+  Text out(a);
+  out += b;
+  out += c;
+  return out;
+}
+
+// IndicProcessor._punc_norm.
+void IndicProcessorPunctuation(Text& text) {
+  Replace(text, U"\r", U"");
+  {  // \(\s* -> (
+    Text out;
+    for (size_t i = 0; i < text.size(); ++i) {
+      out.push_back(text[i]);
+      if (text[i] == '(') {
+        while (i + 1 < text.size() && IsSpace(text[i + 1])) {
+          ++i;
+        }
+      }
+    }
+    text = std::move(out);
+  }
+  {  // \s*\) -> )
+    Text out;
+    for (char32_t c : text) {
+      if (c == ')') {
+        while (!out.empty() && IsSpace(out.back())) {
+          out.pop_back();
+        }
+      }
+      out.push_back(c);
+    }
+    text = std::move(out);
+  }
+  for (char32_t mark : {U':', U';'}) {  // \s:\s? -> :
+    Text out;
+    for (size_t i = 0; i < text.size();) {
+      if (IsSpace(text[i]) && i + 1 < text.size() && text[i + 1] == mark) {
+        out.push_back(mark);
+        i += 2;
+        if (i < text.size() && IsSpace(text[i])) {
+          ++i;
+        }
+      } else {
+        out.push_back(text[i++]);
+      }
+    }
+    text = std::move(out);
+  }
+  MapChars(text, U"`\u00B4\u2018\u201A\u2019", '\'');
+  MapChars(text, U"\u201E\u201C\u201D\u00AB\u00BB", '"');
+  MapChars(text, U"\u2013\u2014", '-');
+  Replace(text, U"\u00A0%", U"%");
+  Replace(text, U"n\u00BA\u00A0", U"n\u00BA ");
+  Replace(text, U"\u00A0\u00BAC", U" \u00BAC");
+  Replace(text, {&Is<kNbsp>, [](char32_t c) { return c == '?' || c == '!' || c == ';'; }},
+          [](std::u32string_view m) { return Text(m.substr(1)); });
+  Replace(text, U",\u00A0", U", ");
+  CollapseAsciiSpaces(text);
+  Replace(text, {&Is<')'>, &Is<' '>, &IsBracketPunct},
+          [](std::u32string_view m) { return Join(U")", m.substr(2)); });
+  Replace(text, {&IsDigit, &Is<' '>, &Is<'%'>},
+          [](std::u32string_view m) { return Join(m.substr(0, 1), U"%"); });
+  QuoteAfterCommas(text);
+  Replace(text, {&IsDigit, &Is<kNbsp>, &IsDigit},
+          [](std::u32string_view m) { return Join(m.substr(0, 1), U".", m.substr(2)); });
+  Strip(text);
+}
+
+// sacremoses' MosesPunctNormalizer(lang="en", penn=True).normalize.
+void MosesNormalize(Text& text) {
+  // EXTRA_WHITESPACE.
+  Replace(text, U"\r", U"");
+  Replace(text, U"(", U" (");
+  Replace(text, U")", U") ");
+  CollapseAsciiSpaces(text);
+  Replace(text, {&Is<')'>, &Is<' '>, &IsBracketPunct},
+          [](std::u32string_view m) { return Join(U")", m.substr(2)); });
+  Replace(text, U"( ", U"(");
+  Replace(text, U" )", U")");
+  Replace(text, {&IsDigit, &Is<' '>, &Is<'%'>},
+          [](std::u32string_view m) { return Join(m.substr(0, 1), U"%"); });
+  Replace(text, U" :", U":");
+  Replace(text, U" ;", U";");
+  // NORMALIZE_UNICODE_IF_NOT_PENN (which sacremoses applies when penn).
+  Replace(text, U"`", U"'");
+  Replace(text, U"''", U" \" ");
+  // NORMALIZE_UNICODE. Its ‘ and ’ between ASCII letters become ' like
+  // every other ‘ and ’.
+  Replace(text, U"\u201E", U"\"");
+  Replace(text, U"\u201C", U"\"");
+  Replace(text, U"\u201D", U"\"");
+  Replace(text, U"\u2013", U"-");
+  Replace(text, U"\u2014", U" - ");
+  CollapseAsciiSpaces(text);
+  Replace(text, U"\u00B4", U"'");
+  MapChars(text, U"\u2018\u201A\u2019", '\'');
+  Replace(text, U"''", U"\"");
+  Replace(text, U"\u00B4\u00B4", U"\"");
+  Replace(text, U"\u2026", U"...");
+  // FRENCH_QUOTES.
+  Replace(text, U"\u00A0\u00AB\u00A0", U"\"");
+  Replace(text, U"\u00AB\u00A0", U"\"");
+  Replace(text, U"\u00AB", U"\"");
+  Replace(text, U"\u00A0\u00BB\u00A0", U"\"");
+  Replace(text, U"\u00A0\u00BB", U"\"");
+  Replace(text, U"\u00BB", U"\"");
+  // HANDLE_PSEUDO_SPACES.
+  Replace(text, U"\u00A0%", U"%");
+  Replace(text, U"n\u00BA\u00A0", U"n\u00BA ");
+  Replace(text, U"\u00A0:", U":");
+  Replace(text, U"\u00A0\u00BAC", U" \u00BAC");
+  Replace(text, U"\u00A0cm", U" cm");
+  Replace(text, U"\u00A0?", U"?");
+  Replace(text, U"\u00A0!", U"!");
+  Replace(text, U"\u00A0;", U";");
+  Replace(text, U",\u00A0", U", ");
+  CollapseAsciiSpaces(text);
+  // EN_QUOTATION_FOLLOWED_BY_COMMA, then OTHER (numbers).
+  QuoteAfterCommas(text);
+  Replace(text, {&IsDigit, &Is<kNbsp>, &IsDigit},
+          [](std::u32string_view m) { return Join(m.substr(0, 1), U".", m.substr(2)); });
+  Strip(text);
+}
+
+std::vector<Text> Split(const Text& text) {
+  std::vector<Text> tokens;
+  Text token;
+  for (char32_t c : text) {
+    if (IsSpace(c)) {
+      if (!token.empty()) {
+        tokens.push_back(std::move(token));
+        token.clear();
+      }
+    } else {
+      token.push_back(c);
+    }
+  }
+  if (!token.empty()) {
+    tokens.push_back(std::move(token));
+  }
+  return tokens;
+}
+
+// sacremoses' English nonbreaking prefixes; No, Art and pp only before a
+// number.
+constexpr auto kNonbreaking = base::MakeFixedFlatSet<std::u32string_view>({
+    U"A",     U"B",    U"C",    U"D",     U"E",    U"F",    U"G",    U"H",    U"I",
+    U"J",     U"K",    U"L",    U"M",     U"N",    U"O",    U"P",    U"Q",    U"R",
+    U"S",     U"T",    U"U",    U"V",     U"W",    U"X",    U"Y",    U"Z",    U"Adj",
+    U"Adm",   U"Adv",  U"Asst", U"Bart",  U"Bldg", U"Brig", U"Bros", U"Capt", U"Cmdr",
+    U"Col",   U"Comdr", U"Con", U"Corp",  U"Cpl",  U"DR",   U"Dr",   U"Drs",  U"Ens",
+    U"Gen",   U"Gov",  U"Hon",  U"Hr",    U"Hosp", U"Insp", U"Lt",   U"MM",   U"MR",
+    U"MRS",   U"MS",   U"Maj",  U"Messrs", U"Mlle", U"Mme", U"Mr",   U"Mrs",  U"Ms",
+    U"Msgr",  U"Op",   U"Ord",  U"Pfc",   U"Ph",   U"Prof", U"Pvt",  U"Rep",  U"Reps",
+    U"Res",   U"Rev",  U"Rt",   U"Sen",   U"Sens", U"Sfc",  U"Sgt",  U"Sr",   U"St",
+    U"Supt",  U"Surg", U"v",    U"vs",    U"i.e",  U"rev",  U"e.g",  U"Rs",   U"Nos",
+    U"Nr",    U"Jan",  U"Feb",  U"Mar",   U"Apr",  U"Jun",  U"Jul",  U"Aug",  U"Sep",
+    U"Oct",   U"Nov",  U"Dec",
+});
+constexpr auto kNumericOnly = base::MakeFixedFlatSet<std::u32string_view>({U"No", U"Art", U"pp"});
+
+// MosesTokenizer.handles_nonbreaking_prefixes.
+void NonbreakingPrefixes(Text& text) {
+  std::vector<Text> tokens = Split(text);
+  for (size_t i = 0; i < tokens.size(); ++i) {
+    Text& token = tokens[i];
+    if (token.size() < 2 || token.back() != '.') {
+      continue;
+    }
+    const Text prefix = token.substr(0, token.size() - 1);
+    const bool has_alpha = std::any_of(prefix.begin(), prefix.end(), &IsAlpha);
+    const bool next = i + 1 < tokens.size();
+    if ((prefix.find('.') != Text::npos && has_alpha) || kNonbreaking.contains(prefix) ||
+        (next && IsLower(tokens[i + 1][0]))) {
+      continue;
+    }
+    if (kNumericOnly.contains(prefix) && next && tokens[i + 1][0] >= '0' &&
+        tokens[i + 1][0] <= '9') {
+      continue;
+    }
+    token = prefix + U" .";
+  }
+  Text joined;
+  for (const Text& token : tokens) {
+    if (!joined.empty()) {
+      joined.push_back(' ');
+    }
+    joined += token;
+  }
+  text = std::move(joined);
+}
+
+// MosesTokenizer.replace_multidots: a run of k dots becomes
+// " " + "DOT" * k + "MULTI", with a space after unless it ends the text.
+void ReplaceMultidots(Text& text) {
+  Text out;
+  for (size_t i = 0; i < text.size();) {
+    size_t run = i;
+    while (run < text.size() && text[run] == '.') {
+      ++run;
+    }
+    if (run - i >= 2) {
+      out.push_back(' ');
+      for (size_t k = i; k < run; ++k) {
+        out += U"DOT";
+      }
+      out += U"MULTI";
+      if (run < text.size()) {
+        out.push_back(' ');
+      }
+      i = run;
+    } else {
+      out.push_back(text[i++]);
+    }
+  }
+  text = std::move(out);
+}
+
+// MosesTokenizer.restore_multidots: (?:DOT)+MULTI -> one dot per DOT.
+void RestoreMultidots(Text& text) {
+  Text out;
+  for (size_t i = 0; i < text.size();) {
+    size_t at = i;
+    size_t dots = 0;
+    while (text.compare(at, 3, U"DOT") == 0) {
+      at += 3;
+      ++dots;
+    }
+    if (dots > 0 && text.compare(at, 5, U"MULTI") == 0) {
+      out.append(dots, '.');
+      i = at + 5;
+    } else {
+      out.push_back(text[i++]);
+    }
+  }
+  text = std::move(out);
+}
+
+// sacremoses' MosesTokenizer(lang="en").tokenize(escape=False), joined.
+void MosesTokenize(Text& text) {
+  CollapseSpaces(text);
+  std::erase_if(text, [](char32_t c) { return c <= 0x1F; });
+  Strip(text);
+  {  // PAD_NOT_ISALNUM.
+    Text out;
+    for (char32_t c : text) {
+      if (IsAlnum(c) || IsSpace(c) || c == '.' || c == '\'' || c == '`' || c == ',' ||
+          c == '-') {
+        out.push_back(c);
+      } else {
+        out += Join(U" ", std::u32string_view(&c, 1), U" ");
+      }
+    }
+    text = std::move(out);
+  }
+  ReplaceMultidots(text);
+  // Commas, except within numbers.
+  Replace(text, {&IsNotNumber, &Is<','>},
+          [](std::u32string_view m) { return Join(m.substr(0, 1), U" , "); });
+  Replace(text, {&Is<','>, &IsNotNumber},
+          [](std::u32string_view m) { return Join(U" , ", m.substr(1)); });
+  if (text.size() >= 2 && text.back() == ',' && IsNumber(text[text.size() - 2])) {
+    text.insert(text.size() - 1, U" ");
+    text.push_back(' ');
+  }
+  // English apostrophes.
+  const auto split = [](std::u32string_view m) {
+    return Join(m.substr(0, 1), U" ' ", m.substr(2));
+  };
+  const auto attach = [](std::u32string_view m) {
+    return Join(m.substr(0, 1), U" '", m.substr(2));
+  };
+  Replace(text, {&IsNotAlpha, &Is<'\''>, &IsNotAlpha}, split);
+  Replace(text, {&IsNotAlphaOrNumber, &Is<'\''>, &IsAlpha}, split);
+  Replace(text, {&IsAlpha, &Is<'\''>, &IsNotAlpha}, split);
+  Replace(text, {&IsAlpha, &Is<'\''>, &IsAlpha}, attach);
+  Replace(text, {&IsNumber, &Is<'\''>, &Is<'s'>}, attach);
+  NonbreakingPrefixes(text);
+  CollapseSpaces(text);
+  Strip(text);
+  // A final ".'" (or ".' ") splits.
+  for (std::u32string_view tail : {U".'", U".' "}) {
+    if (text.size() >= tail.size() && text.ends_with(tail)) {
+      text.replace(text.size() - tail.size(), tail.size(), U" . ' ");
+      break;
+    }
+  }
+  RestoreMultidots(text);
+  // The tokens, joined by spaces.
+  CollapseSpaces(text);
+  Strip(text);
+}
+
+}  // namespace
+
+std::string EnglishModelInput(std::string_view input) {
+  Text text = Decode(input);
+  IndicProcessorPunctuation(text);
+  Strip(text);
+  MosesNormalize(text);
+  MosesTokenize(text);
+  return Encode(text);
+}
+
+}  // namespace tark_captions
