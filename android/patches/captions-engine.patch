+#ifndef COMPONENTS_TARK_CAPTIONS_MODEL_SOURCE_H_
+#define COMPONENTS_TARK_CAPTIONS_MODEL_SOURCE_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/memory_mapped_file.h"
+
+namespace tark_captions {
+
+// Where a model's files come from: a folder (the Mac, tests) or files
+// opened by someone else and handed over (Android's sandboxed captions
+// process, which may not open paths itself). Use on one sequence.
+class ModelSource {
+ public:
+  virtual ~ModelSource();
+
+  // The bytes of the model folder's file `name`; nullopt if it is missing.
+  // The span lives as long as the source.
+  virtual std::optional<base::span<const uint8_t>> Read(std::string_view name) const = 0;
+  // The file's path, when it has one (ONNX Runtime then maps the file
+  // itself instead of copying it).
+  virtual std::optional<base::FilePath> PathOf(std::string_view name) const;
+};
+
+// How a model's audio features and output are laid out (engine.json beside
+// the model). The Mac's 600M has no engine.json: its preprocessor counts
+// samples / hop + 1 frames and reflects at the edges, blank 256. NeMo 3's
+// per-language models count samples / hop valid frames (the rest zeroed)
+// and pad the STFT with zeros; FastConformer's blank is 1024.
+struct ModelConventions {
+  enum class Frames { kHopPlusOne, kHop };
+  enum class Pad { kReflect, kZero };
+  Frames frames = Frames::kHopPlusOne;
+  Pad pad = Pad::kReflect;
+  int blank = 256;
+};
+
+// engine.json's `valid_frames` ("n/hop+1" / "n/hop"), `pad` ("reflect" /
+// "constant") and `blank`; the defaults above without the file; nullopt
+// for a file the engine does not understand.
+std::optional<ModelConventions> ReadConventions(const ModelSource& source);
+
+class DirectorySource final : public ModelSource {
+ public:
+  explicit DirectorySource(base::FilePath dir);
+  ~DirectorySource() override;
+
+  std::optional<base::span<const uint8_t>> Read(std::string_view name) const override;
+  std::optional<base::FilePath> PathOf(std::string_view name) const override;
+
+ private:
+  const base::FilePath dir_;
+  mutable std::map<std::string, std::vector<uint8_t>, std::less<>> cache_;
+};
+
+class MappedFilesSource final : public ModelSource {
+ public:
+  explicit MappedFilesSource(std::map<std::string, base::File> files);
+  ~MappedFilesSource() override;
+
+  std::optional<base::span<const uint8_t>> Read(std::string_view name) const override;
+
+ private:
+  mutable std::map<std::string, base::File, std::less<>> files_;
+  mutable std::map<std::string, std::unique_ptr<base::MemoryMappedFile>, std::less<>> mapped_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_MODEL_SOURCE_H_
