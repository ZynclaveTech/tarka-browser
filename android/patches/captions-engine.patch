+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
+#define COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
+
+#include "base/memory/raw_ptr.h"
+
+namespace tark_captions {
+
+// One tab's captions state. Captions can start while the tab is in a call
+// (it captures the microphone) or plays sound (a video, a podcast), and only
+// when the user turns them on: nothing listens before that, and a call
+// starting doesn't turn them on (D4 any-media). They stay on until the user
+// turns them off, the tab goes to another site, or the call ends.
+class CallState {
+ public:
+  enum class Phase { kIdle, kInCall, kSound, kCaptioning };
+
+  void OnMicCapturing(bool capturing);
+  void OnSoundPlaying(bool playing);
+  // False (and no change) when turning on with neither a call nor sound.
+  // `sound_recently`: the sound stopped moments ago and the captions button
+  // is still there.
+  bool SetCaptionsOn(bool on, bool sound_recently = false);
+  // The tab went to another site: captions off.
+  void OnLeftSite();
+
+  Phase phase() const;
+  bool in_call() const { return in_call_; }
+  bool playing_sound() const { return playing_sound_; }
+  bool captions_on() const { return captions_on_; }
+  // Captions are on, or could be turned on now.
+  bool can_caption() const { return in_call_ || playing_sound_ || captions_on_; }
+
+ private:
+  bool in_call_ = false;
+  bool playing_sound_ = false;
+  bool captions_on_ = false;
+};
+
+// Which tab has captions on. One tab captions at a time: the engine decodes
+// one language for the profile, and only that tab's audio may reach it.
+// Turning captions on in a tab takes them from the other one.
+template <typename Call>
+class CaptioningCall {
+ public:
+  // Makes `call` the captioning call; returns the call that was captioning
+  // before, which must turn its captions off, or null.
+  Call* Take(Call* call) {
+    Call* previous = current_ == call ? nullptr : current_.get();
+    current_ = call;
+    return previous;
+  }
+  // `call`'s captions are off; nothing changes if another call has them.
+  void Release(Call* call) {
+    if (current_ == call) {
+      current_ = nullptr;
+    }
+  }
+  Call* current() const { return current_; }
+
+ private:
+  raw_ptr<Call> current_ = nullptr;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
