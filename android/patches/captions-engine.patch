+#include "components/tark_captions/caption_history.h"
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/tick_clock.h"
+
+namespace tark_captions {
+namespace {
+
+std::u16string Trimmed(const std::string& text) {
+  return std::u16string(base::TrimWhitespace(base::UTF8ToUTF16(text), base::TRIM_ALL));
+}
+
+size_t CharsOf(const CaptionHistory::Row& row) {
+  return row.text.size() + row.translation.size();
+}
+
+}  // namespace
+
+std::u16string HistoryTime(base::TimeDelta at) {
+  const int64_t total = at.InSeconds();
+  const int64_t hours = total / 3600;
+  const int64_t minutes = (total / 60) % 60;
+  const int64_t seconds = total % 60;
+  const std::string text =
+      hours > 0 ? base::StringPrintf("%lld:%02lld:%02lld", static_cast<long long>(hours),
+                                     static_cast<long long>(minutes),
+                                     static_cast<long long>(seconds))
+                : base::StringPrintf("%lld:%02lld", static_cast<long long>(minutes),
+                                     static_cast<long long>(seconds));
+  return base::ASCIIToUTF16(text);
+}
+
+CaptionHistory::CaptionHistory(const base::TickClock* clock) : clock_(clock) {}
+
+CaptionHistory::~CaptionHistory() = default;
+
+void CaptionHistory::Start() {
+  if (!origin_) {
+    origin_ = clock_->NowTicks();
+  }
+}
+
+uint64_t CaptionHistory::AddFinal(const std::string& text) {
+  Start();
+  draft_ = Draft();
+  std::u16string trimmed = Trimmed(text);
+  if (trimmed.empty()) {
+    return 0;
+  }
+  Row row;
+  row.id = next_id_++;
+  row.at = clock_->NowTicks() - *origin_;
+  row.text = std::move(trimmed);
+  chars_ += CharsOf(row);
+  rows_.push_back(std::move(row));
+  Trim();
+  return rows_.empty() ? 0 : rows_.back().id;
+}
+
+void CaptionHistory::Rendered(uint64_t id, const std::string& shown,
+                              const std::string& translation) {
+  for (Row& row : rows_) {
+    if (row.id != id) {
+      continue;
+    }
+    chars_ -= CharsOf(row);
+    if (!shown.empty()) {
+      row.text = Trimmed(shown);
+    }
+    row.translation = Trimmed(translation);
+    chars_ += CharsOf(row);
+    ++row.version;
+    Trim();
+    return;
+  }
+}
+
+void CaptionHistory::SetDraft(const std::string& text, const std::string& translation) {
+  draft_.text = Trimmed(text);
+  draft_.translation = Trimmed(translation);
+}
+
+void CaptionHistory::AddDivider(Kind kind) {
+  if (rows_.empty() || rows_.back().kind != Kind::kLine) {
+    return;
+  }
+  Start();
+  Row row;
+  row.id = next_id_++;
+  row.kind = kind;
+  row.at = clock_->NowTicks() - *origin_;
+  rows_.push_back(std::move(row));
+}
+
+void CaptionHistory::BeginGuess() {
+  guess_from_ = next_id_;
+}
+
+void CaptionHistory::DropGuess() {
+  if (!guess_from_) {
+    return;
+  }
+  while (!rows_.empty() && rows_.back().id >= *guess_from_) {
+    chars_ -= CharsOf(rows_.back());
+    rows_.pop_back();
+  }
+  draft_ = Draft();
+  guess_from_.reset();
+}
+
+void CaptionHistory::KeepGuess() {
+  guess_from_.reset();
+}
+
+void CaptionHistory::Clear() {
+  origin_.reset();
+  rows_.clear();
+  draft_ = Draft();
+  chars_ = 0;
+  dropped_ = false;
+  guess_from_.reset();
+}
+
+std::u16string CaptionHistory::CopyText(const std::u16string& new_video,
+                                        const std::u16string& restarted) const {
+  std::u16string out;
+  for (const Row& row : rows_) {
+    switch (row.kind) {
+      case Kind::kNewVideo:
+        base::StrAppend(&out, {u"— ", new_video, u" —\n"});
+        break;
+      case Kind::kRestarted:
+        base::StrAppend(&out, {u"— ", restarted, u" —\n"});
+        break;
+      case Kind::kLine:
+        base::StrAppend(&out, {HistoryTime(row.at), u"  ", row.text, u"\n"});
+        if (!row.translation.empty()) {
+          base::StrAppend(&out, {u"      ", row.translation, u"\n"});
+        }
+        break;
+    }
+  }
+  return out;
+}
+
+void CaptionHistory::Trim() {
+  const base::TimeDelta now = clock_->NowTicks() - *origin_;
+  // Always keep the newest row, however long.
+  while (rows_.size() > 1 &&
+         (now - rows_.front().at > kMaxAge || chars_ > kMaxChars)) {
+    chars_ -= CharsOf(rows_.front());
+    rows_.pop_front();
+    dropped_ = true;
+  }
+  // A divider left at the top separates nothing.
+  while (!rows_.empty() && rows_.front().kind != Kind::kLine) {
+    rows_.pop_front();
+  }
+}
+
