+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_ASR_MODEL_H_
+#define COMPONENTS_TARK_CAPTIONS_ASR_MODEL_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+
+namespace tark_captions {
+
+class MelFrontend;
+class OrtModel;
+class ModelSource;
+class OrtRuntime;
+
+// The languages Phase 1 captions (measured in the D4 spike).
+enum class Language { kHindi, kTamil, kBengali };
+
+// "hi", "ta", "bn" (also the keys of vocab.json and language_masks.json).
+const char* LanguageCode(Language language);
+std::optional<Language> LanguageFromCode(std::string_view code);
+
+// AI4Bharat IndicConformer 600M (MIT), its int8 encoder and CTC decoder:
+// whole-segment recognition, greedy CTC per language.
+class AsrModel {
+ public:
+  // Null if a model file is missing or invalid.
+  static std::unique_ptr<AsrModel> Load(OrtRuntime* runtime,
+                                        const base::FilePath& models_dir,
+                                        int threads);
+  // The same from any source (Android's captions process gets files).
+  static std::unique_ptr<AsrModel> Load(OrtRuntime* runtime,
+                                        const ModelSource& source,
+                                        int threads);
+
+  AsrModel(const AsrModel&) = delete;
+  AsrModel& operator=(const AsrModel&) = delete;
+  ~AsrModel();
+
+  // UTF-8 text of 16 kHz mono speech; empty if nothing was recognised or
+  // the model failed.
+  std::string Decode(base::span<const float> pcm16k, Language language);
+
+  struct Vocabulary {
+    std::vector<int> logit_indices;   // the language's columns of the logits
+    std::vector<std::string> tokens;  // token id -> piece
+  };
+
+ private:
+
+  AsrModel(std::unique_ptr<MelFrontend> frontend,
+           std::unique_ptr<OrtModel> encoder,
+           std::unique_ptr<OrtModel> ctc,
+           std::map<std::string, Vocabulary> vocabularies,
+           int blank);
+
+  std::unique_ptr<MelFrontend> frontend_;
+  std::unique_ptr<OrtModel> encoder_;
+  std::unique_ptr<OrtModel> ctc_;
+  std::map<std::string, Vocabulary> vocabularies_;  // by language code
+  const int blank_;
+};
+
+// vocab.json and language_masks.json: each language the model has, by code
+// ("hi", "en", ...). The 600M has 22; Android's per-language models one.
+// Nullopt if either file is missing or a language's vocabulary does not
+// reach past `blank`.
+std::optional<std::map<std::string, AsrModel::Vocabulary>> ReadVocabularies(
+    const ModelSource& source,
+    int blank);
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_ASR_MODEL_H_
