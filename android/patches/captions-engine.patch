+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/segmenter.h"
+
+#include <cmath>
+#include <functional>
+#include <vector>
+
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/test_util.h"
+#include "components/tark_captions/vad.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr double kChunk = 512.0 / 16000.0;  // 32 ms
+
+// Feeds `seconds` of chunks whose probability is prob(chunk end time) and
+// returns every action that is not kNone.
+std::vector<SegmenterAction> Feed(Segmenter& segmenter, double seconds,
+                                  const std::function<float(double)>& prob) {
+  std::vector<SegmenterAction> actions;
+  for (int i = 1; i * kChunk <= seconds + 1e-9; ++i) {
+    const double t = i * kChunk;
+    SegmenterAction a = segmenter.OnChunk(t, prob(t));
+    if (a.kind != SegmenterAction::kNone) {
+      actions.push_back(a);
+    }
+  }
+  return actions;
+}
+
+TEST(SegmenterTest, NoSpeechNoDecode) {
+  Segmenter segmenter;
+  EXPECT_TRUE(Feed(segmenter, 60, [](double) { return 0.05f; }).empty());
+  EXPECT_FALSE(segmenter.Flush(60));
+}
+
+TEST(SegmenterTest, PauseFinalises) {
+  Segmenter segmenter;
+  std::vector<SegmenterAction> actions =
+      Feed(segmenter, 2.6, [](double t) { return t <= 2.0 ? 0.9f : 0.05f; });
+  const double last_speech = std::floor(2.0 / kChunk) * kChunk;
+  int finals = 0;
+  for (const SegmenterAction& a : actions) {
+    if (a.kind == SegmenterAction::kFinal) {
+      ++finals;
+      EXPECT_NEAR(a.start_s, 0.0, 1e-9);
+      EXPECT_NEAR(a.end_s, last_speech + 0.2, 1e-9);
+    }
+  }
+  EXPECT_EQ(finals, 1);
+}
+
+TEST(SegmenterTest, DraftEveryPointEight) {
+  Segmenter segmenter;
+  std::vector<double> draft_ends;
+  for (const SegmenterAction& a : Feed(segmenter, 4.0, [](double) { return 0.9f; })) {
+    ASSERT_EQ(a.kind, SegmenterAction::kDraft);
+    draft_ends.push_back(a.end_s);
+  }
+  ASSERT_GE(draft_ends.size(), 4u);
+  for (size_t i = 1; i < draft_ends.size(); ++i) {
+    const double gap = draft_ends[i] - draft_ends[i - 1];
+    EXPECT_GE(gap, 0.8 - 1e-9);
+    EXPECT_LT(gap, 0.8 + kChunk + 1e-9);
+  }
+}
+
+TEST(SegmenterTest, LongSpeechCutAtFive) {
+  Segmenter segmenter;
+  const double dip = std::round(4.1 / kChunk) * kChunk;
+  std::vector<SegmenterAction> actions = Feed(segmenter, 20, [&](double t) {
+    return std::abs(t - dip) < 1e-6 ? 0.3f : 0.9f;
+  });
+  bool first_final = true;
+  for (const SegmenterAction& a : actions) {
+    EXPECT_LE(a.end_s - a.start_s, 5.0 + 1e-9);
+    if (a.kind == SegmenterAction::kFinal && first_final) {
+      EXPECT_NEAR(a.end_s, dip, 1e-9);
+      first_final = false;
+    }
+  }
+  EXPECT_FALSE(first_final);
+}
+
+TEST(SegmenterTest, ShortBlipIsNotDecoded) {
+  Segmenter segmenter;
+  // One 32 ms chunk of speech: its segment would be [0, 0.232], under 0.3 s.
+  EXPECT_TRUE(Feed(segmenter, 2, [](double t) { return t <= kChunk ? 0.9f : 0.05f; }).empty());
+}
+
+TEST(SegmenterTest, PhraseModeEmitsOnlyFinals) {
+  // Phrase at a time (Android's mid-range default): with drafts off, a 3 s
+  // utterance then 0.6 s of silence is decoded once, as its final.
+  Segmenter segmenter({.phrase = true});
+  std::vector<SegmenterAction> actions =
+      Feed(segmenter, 3.6, [](double t) { return t <= 3.0 ? 0.9f : 0.05f; });
+  ASSERT_EQ(actions.size(), 1u);
+  EXPECT_EQ(actions[0].kind, SegmenterAction::kFinal);
+  EXPECT_NEAR(actions[0].start_s, 0.0, 1e-9);
+}
+
+TEST(VadTest, VadMatchesGolden) {
+  std::optional<base::FilePath> ort = test::OrtPath();
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(*ort);
+  ASSERT_TRUE(runtime);
+  for (const base::Value& clip : test::GoldenClips(*testdata)) {
+    std::unique_ptr<Vad> vad = Vad::Load(runtime.get(), *models);
+    ASSERT_TRUE(vad);
+    const std::string& wav = *clip.GetDict().FindString("wav");
+    int rate = 0;
+    std::vector<float> pcm = test::ReadWav(testdata->AppendASCII(wav), &rate);
+    const base::ListValue& golden = *clip.GetDict().FindList("vad_probs");
+    ASSERT_EQ(golden.size(), pcm.size() / 512) << wav;
+    float worst = 0;
+    for (size_t i = 0; i < golden.size(); ++i) {
+      const float p = vad->Process(base::span(pcm).subspan(i * 512).first<512>());
+      worst = std::max(worst, std::abs(p - static_cast<float>(golden[i].GetDouble())));
+    }
+    EXPECT_LE(worst, 0.02f) << wav;
+  }
+}
