+
+#ifndef COMPONENTS_TARK_CAPTIONS_MEL_FRONTEND_H_
+#define COMPONENTS_TARK_CAPTIONS_MEL_FRONTEND_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "components/tark_captions/model_source.h"
+
+struct PFFFT_Setup;
+
+namespace tark_captions {
+
+// IndicConformer's audio front end (its TorchScript preprocessor), in C++:
+// pre-emphasis 0.97; reflect padding of 256 on each side; 512-point STFT,
+// hop 160, the model's 400-sample window centred in 512; power spectrum;
+// 80 mel bands (the model's 257x80 matrix); log(x + 2^-24); each band
+// normalised to zero mean and unit deviation over the clip.
+class MelFrontend {
+ public:
+  static constexpr int kMels = 80;
+
+  // Reads window.f32 and mel_fb.f32 (utils/captions_export.py export) from
+  // `models_dir`; null if either is missing or the wrong size.
+  static std::unique_ptr<MelFrontend> Load(const base::FilePath& models_dir);
+  // The same from any source, with the model's conventions.
+  static std::unique_ptr<MelFrontend> Load(const ModelSource& source,
+                                           const ModelConventions& conventions);
+
+  MelFrontend(const MelFrontend&) = delete;
+  MelFrontend& operator=(const MelFrontend&) = delete;
+  ~MelFrontend();
+
+  // Features of 16 kHz mono audio, [kMels x frames] row-major (the
+  // encoder's audio_signal); `frames` = samples / 160 + 1.
+  std::vector<float> Compute(base::span<const float> pcm16k, int* frames) const;
+  // The same, also giving the frames the model counts as valid (the
+  // encoder's `length`): all of them, or samples / 160 with the rest zero.
+  std::vector<float> Compute(base::span<const float> pcm16k, int* frames, int* valid) const;
+
+ private:
+  MelFrontend(std::vector<float> window512,
+              std::vector<float> mel_fb,
+              const ModelConventions& conventions);
+
+  std::vector<float> window512_;  // the 400-sample window, zero-padded to 512
+  std::vector<float> mel_fb_;     // 257 x 80
+  const ModelConventions conventions_;
+  PFFFT_Setup* fft_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_MEL_FRONTEND_H_
