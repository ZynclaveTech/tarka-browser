+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/mel_frontend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/memory/ptr_util.h"
+#include "third_party/pffft/src/pffft.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr int kFft = 512;
+constexpr int kBins = kFft / 2 + 1;  // 257
+constexpr int kHop = 160;
+constexpr int kWindow = 400;
+constexpr int kPad = kFft / 2;  // reflect padding on each side
+constexpr float kPreemphasis = 0.97f;
+constexpr float kLogGuard = 5.960464477539063e-08f;  // 2^-24
+constexpr float kStdGuard = 1e-5f;
+
+std::vector<float> ReadFloats(const ModelSource& source, std::string_view name, size_t count) {
+  std::optional<base::span<const uint8_t>> bytes = source.Read(name);
+  if (!bytes || bytes->size() != count * sizeof(float)) {
+    return {};
+  }
+  std::vector<float> out(count);
+  memcpy(out.data(), bytes->data(), bytes->size());
+  return out;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<MelFrontend> MelFrontend::Load(const base::FilePath& models_dir) {
+  DirectorySource source(models_dir);
+  std::optional<ModelConventions> conventions = ReadConventions(source);
+  return conventions ? Load(source, *conventions) : nullptr;
+}
+
+// static
+std::unique_ptr<MelFrontend> MelFrontend::Load(const ModelSource& source,
+                                               const ModelConventions& conventions) {
+  std::vector<float> window = ReadFloats(source, "window.f32", kWindow);
+  std::vector<float> mel_fb = ReadFloats(source, "mel_fb.f32", kBins * kMels);
+  if (window.empty() || mel_fb.empty()) {
+    return nullptr;
+  }
+  // torch.stft centres a shorter window in n_fft.
+  std::vector<float> window512(kFft, 0.0f);
+  std::copy(window.begin(), window.end(), window512.begin() + (kFft - kWindow) / 2);
+  return base::WrapUnique(new MelFrontend(std::move(window512), std::move(mel_fb), conventions));
+}
+
+MelFrontend::MelFrontend(std::vector<float> window512,
+                         std::vector<float> mel_fb,
+                         const ModelConventions& conventions)
+    : window512_(std::move(window512)),
+      mel_fb_(std::move(mel_fb)),
+      conventions_(conventions),
+      fft_(pffft_new_setup(kFft, PFFFT_REAL)) {}
+
+MelFrontend::~MelFrontend() {
+  pffft_destroy_setup(fft_);
+}
+
+std::vector<float> MelFrontend::Compute(base::span<const float> pcm16k, int* frames) const {
+  int valid = 0;
+  return Compute(pcm16k, frames, &valid);
+}
+
+std::vector<float> MelFrontend::Compute(base::span<const float> pcm16k,
+                                        int* frames,
+                                        int* valid) const {
+  const int n = static_cast<int>(pcm16k.size());
+  *frames = n / kHop + 1;
+  // NeMo 3's models count samples / hop frames and zero the last one.
+  *valid = conventions_.frames == ModelConventions::Frames::kHop ? std::max(n / kHop, 1) : *frames;
+  const bool zero_pad = conventions_.pad == ModelConventions::Pad::kZero;
+  // Pre-emphasis, then reflect padding (the edge sample is not repeated).
+  std::vector<float> y(n);
+  for (int i = 0; i < n; ++i) {
+    y[i] = pcm16k[i] - kPreemphasis * (i > 0 ? pcm16k[i - 1] : 0.0f);
+  }
+  std::vector<float> padded(n + 2 * kPad, 0.0f);
+  for (int i = 0; i < n + 2 * kPad; ++i) {
+    int j = i - kPad;
+    if (j < 0) {
+      j = -j;
+    } else if (j >= n) {
+      j = 2 * (n - 1) - j;
+    }
+    if (zero_pad) {
+      j = i - kPad;
+    }
+    padded[i] = (n > 0 && j >= 0 && j < n) ? y[j] : 0.0f;
+  }
+
+  float* in = static_cast<float*>(pffft_aligned_malloc(kFft * sizeof(float)));
+  float* out = static_cast<float*>(pffft_aligned_malloc(kFft * sizeof(float)));
+  float* work = static_cast<float*>(pffft_aligned_malloc(kFft * sizeof(float)));
+  std::vector<float> power(kBins);
+  std::vector<float> features(static_cast<size_t>(kMels) * *frames);
+  for (int f = 0; f < *frames; ++f) {
+    const float* frame = padded.data() + f * kHop;
+    for (int i = 0; i < kFft; ++i) {
+      in[i] = frame[i] * window512_[i];
+    }
+    pffft_transform_ordered(fft_, in, out, work, PFFFT_FORWARD);
+    // Ordered real output: out[0] = F(0), out[1] = F(n/2), then re/im pairs.
+    power[0] = out[0] * out[0];
+    power[kBins - 1] = out[1] * out[1];
+    for (int k = 1; k < kBins - 1; ++k) {
+      power[k] = out[2 * k] * out[2 * k] + out[2 * k + 1] * out[2 * k + 1];
+    }
+    for (int m = 0; m < kMels; ++m) {
+      float sum = 0;
+      for (int k = 0; k < kBins; ++k) {
+        sum += power[k] * mel_fb_[k * kMels + m];
+      }
+      features[m * *frames + f] = std::log(sum + kLogGuard);
+    }
+  }
+  pffft_aligned_free(in);
+  pffft_aligned_free(out);
+  pffft_aligned_free(work);
+
+  // Per band: mean and (n - 1) deviation over the valid frames; the rest
+  // are zero.
+  const int used = *valid;
+  for (int m = 0; m < kMels; ++m) {
+    float* band = features.data() + m * *frames;
+    double mean = 0;
+    for (int f = 0; f < used; ++f) {
+      mean += band[f];
+    }
+    mean /= used;
+    double var = 0;
+    for (int f = 0; f < used; ++f) {
+      var += (band[f] - mean) * (band[f] - mean);
+    }
+    var = std::max(var / std::max(used - 1, 1), static_cast<double>(kLogGuard));
+    const double scale = 1.0 / (std::sqrt(var) + kStdGuard);
+    for (int f = 0; f < *frames; ++f) {
+      band[f] = f < used ? static_cast<float>((band[f] - mean) * scale) : 0.0f;
+    }
+  }
+  return features;
+}
+
