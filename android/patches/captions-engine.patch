+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/asr_model.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/memory/ptr_util.h"
+#include "base/strings/string_util.h"
+#include "components/tark_captions/mel_frontend.h"
+#include "components/tark_captions/model_source.h"
+#include "components/tark_captions/ort_runtime.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr Language kLanguages[] = {Language::kHindi, Language::kTamil, Language::kBengali};
+
+std::optional<base::Value> ReadJson(const ModelSource& source, std::string_view name) {
+  std::optional<base::span<const uint8_t>> bytes = source.Read(name);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  return base::JSONReader::Read(
+      std::string_view(reinterpret_cast<const char*>(bytes->data()), bytes->size()),
+      base::JSON_PARSE_RFC);
+}
+
+}  // namespace
+
+const char* LanguageCode(Language language) {
+  switch (language) {
+    case Language::kHindi:
+      return "hi";
+    case Language::kTamil:
+      return "ta";
+    case Language::kBengali:
+      return "bn";
+  }
+}
+
+std::optional<Language> LanguageFromCode(std::string_view code) {
+  for (Language language : kLanguages) {
+    if (code == LanguageCode(language)) {
+      return language;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::map<std::string, AsrModel::Vocabulary>> ReadVocabularies(
+    const ModelSource& source,
+    int blank) {
+  std::optional<base::Value> vocab = ReadJson(source, "vocab.json");
+  std::optional<base::Value> masks = ReadJson(source, "language_masks.json");
+  if (!vocab || !vocab->is_dict() || !masks || !masks->is_dict() || vocab->GetDict().empty()) {
+    return std::nullopt;
+  }
+  std::map<std::string, AsrModel::Vocabulary> vocabularies;
+  for (const auto [code, tokens] : vocab->GetDict()) {
+    const base::ListValue* mask = masks->GetDict().FindList(code);
+    if (!tokens.is_list() || !mask) {
+      return std::nullopt;
+    }
+    AsrModel::Vocabulary v;
+    for (size_t i = 0; i < mask->size(); ++i) {
+      if ((*mask)[i].is_bool() && (*mask)[i].GetBool()) {
+        v.logit_indices.push_back(static_cast<int>(i));
+      }
+    }
+    for (const base::Value& token : tokens.GetList()) {
+      v.tokens.push_back(token.is_string() ? token.GetString() : std::string());
+    }
+    if (v.logit_indices.size() != v.tokens.size() ||
+        v.tokens.size() <= static_cast<size_t>(blank)) {
+      return std::nullopt;
+    }
+    vocabularies.emplace(code, std::move(v));
+  }
+  return vocabularies;
+}
+
+// static
+std::unique_ptr<AsrModel> AsrModel::Load(OrtRuntime* runtime,
+                                         const base::FilePath& models_dir,
+                                         int threads) {
+  return Load(runtime, DirectorySource(models_dir), threads);
+}
+
+// static
+std::unique_ptr<AsrModel> AsrModel::Load(OrtRuntime* runtime,
+                                         const ModelSource& source,
+                                         int threads) {
+  std::optional<ModelConventions> conventions = ReadConventions(source);
+  if (!conventions) {
+    return nullptr;
+  }
+  std::unique_ptr<MelFrontend> frontend = MelFrontend::Load(source, *conventions);
+  std::unique_ptr<OrtModel> encoder = runtime->LoadModel(source, "encoder.int8.onnx", threads);
+  std::unique_ptr<OrtModel> ctc = runtime->LoadModel(source, "ctc_decoder.onnx", threads);
+  std::optional<std::map<std::string, Vocabulary>> vocabularies =
+      ReadVocabularies(source, conventions->blank);
+  if (!frontend || !encoder || !ctc || !vocabularies) {
+    return nullptr;
+  }
+  return base::WrapUnique(new AsrModel(std::move(frontend), std::move(encoder), std::move(ctc),
+                                       std::move(*vocabularies), conventions->blank));
+}
+
+AsrModel::AsrModel(std::unique_ptr<MelFrontend> frontend,
+                   std::unique_ptr<OrtModel> encoder,
+                   std::unique_ptr<OrtModel> ctc,
+                   std::map<std::string, Vocabulary> vocabularies,
+                   int blank)
+    : frontend_(std::move(frontend)),
+      encoder_(std::move(encoder)),
+      ctc_(std::move(ctc)),
+      vocabularies_(std::move(vocabularies)),
+      blank_(blank) {}
+
+AsrModel::~AsrModel() = default;
+
+std::string AsrModel::Decode(base::span<const float> pcm16k, Language language) {
+  // A one-language model captions its own language whatever is asked.
+  auto found = vocabularies_.find(LanguageCode(language));
+  if (found == vocabularies_.end() && vocabularies_.size() == 1) {
+    found = vocabularies_.begin();
+  }
+  if (found == vocabularies_.end()) {
+    return std::string();
+  }
+  const Vocabulary& v = found->second;
+  int frames = 0;
+  int valid = 0;
+  std::vector<float> features = frontend_->Compute(pcm16k, &frames, &valid);
+  std::vector<Tensor> inputs(2);
+  inputs[0] = {.name = "audio_signal", .shape = {1, MelFrontend::kMels, frames}, .f32 = std::move(features)};
+  inputs[1] = {.name = "length", .shape = {1}, .i64 = {valid}};
+  std::vector<Tensor> encoded;
+  if (!encoder_->Run(inputs, {"outputs"}, &encoded)) {
+    return std::string();
+  }
+  encoded[0].name = "encoder_output";
+  std::vector<Tensor> logits;
+  if (!ctc_->Run(encoded, {"logprobs"}, &logits) || logits[0].shape.size() != 3) {
+    return std::string();
+  }
+  const int64_t steps = logits[0].shape[1];
+  const int64_t width = logits[0].shape[2];
+  std::string text;
+  int previous = -1;
+  for (int64_t t = 0; t < steps; ++t) {
+    const float* row = logits[0].f32.data() + t * width;
+    int best = 0;
+    for (size_t i = 1; i < v.logit_indices.size(); ++i) {
+      if (row[v.logit_indices[i]] > row[v.logit_indices[best]]) {
+        best = static_cast<int>(i);
+      }
+    }
+    if (best != previous && best != blank_) {
+      text += v.tokens[best];
+    }
+    previous = best;
+  }
+  base::ReplaceSubstringsAfterOffset(&text, 0, "\xE2\x96\x81", " ");  // '▁'
+  return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+}
+
+}  // namespace tark_captions
