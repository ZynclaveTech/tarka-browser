+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_engine.h"
+
+#include <algorithm>
+#include <map>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "components/tark_captions/model_source.h"
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/segmenter.h"
+#include "components/tark_captions/vad.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr int kRate = 16000;
+// Audio kept for decoding: more than a 5 s segment plus its pre-roll.
+constexpr int64_t kKeep = 12 * kRate;
+
+}  // namespace
+
+// One loaded speech model (ONNX Runtime and IndicConformer) for a models
+// folder, shared by every engine in the process that uses it. Loading,
+// lookup and release all happen under one lock, so an engine never picks up
+// a model that is being unloaded.
+class SharedAsr {
+ public:
+  // Null if ONNX Runtime or the model is missing.
+  static SharedAsr* Acquire(const base::FilePath& models_dir,
+                            const base::FilePath& ort_dylib,
+                            int threads) {
+    base::AutoLock lock(RegistryLock());
+    auto key = std::make_pair(models_dir, ort_dylib);
+    auto it = Registry().find(key);
+    if (it != Registry().end()) {
+      ++it->second->users_;
+      return it->second.get();
+    }
+    std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_dylib);
+    if (!runtime) {
+      return nullptr;
+    }
+    std::unique_ptr<AsrModel> asr = AsrModel::Load(runtime.get(), models_dir, threads);
+    if (!asr) {
+      return nullptr;
+    }
+    auto shared = base::WrapUnique(new SharedAsr(key, std::move(runtime), std::move(asr), nullptr));
+    ++Loads();
+    SharedAsr* raw = shared.get();
+    Registry().emplace(key, std::move(shared));
+    return raw;
+  }
+
+  // A model of its own, outside the registry (Android: one per process).
+  static std::unique_ptr<SharedAsr> CreateOwned(std::unique_ptr<ModelSource> source,
+                                                const base::FilePath& ort_library,
+                                                int threads) {
+    std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_library);
+    if (!runtime) {
+      return nullptr;
+    }
+    std::unique_ptr<AsrModel> asr = AsrModel::Load(runtime.get(), *source, threads);
+    if (!asr) {
+      return nullptr;
+    }
+    return base::WrapUnique(
+        new SharedAsr(Key(), std::move(runtime), std::move(asr), std::move(source)));
+  }
+
+  static void Release(SharedAsr* shared) {
+    base::AutoLock lock(RegistryLock());
+    if (--shared->users_ == 0) {
+      // Erase by iterator: the key lives in the object being erased.
+      Registry().erase(Registry().find(shared->key_));
+    }
+  }
+
+  // Every time a model was loaded (tests: no needless reloads).
+  static int& Loads() {
+    static int loads = 0;
+    return loads;
+  }
+
+  static int LoadCount() {
+    base::AutoLock lock(RegistryLock());
+    return Loads();
+  }
+
+  static int Count() {
+    base::AutoLock lock(RegistryLock());
+    return static_cast<int>(Registry().size());
+  }
+
+  SharedAsr(const SharedAsr&) = delete;
+  SharedAsr& operator=(const SharedAsr&) = delete;
+  ~SharedAsr() {
+    // The model before the runtime that loaded it.
+    asr_.reset();
+  }
+
+  // Engines run on their own sequences and the runtime and the model's
+  // front end are not made for concurrent use, so their uses take turns.
+  std::unique_ptr<Vad> LoadVad(const base::FilePath& models_dir) {
+    base::AutoLock lock(lock_);
+    return source_ ? Vad::Load(runtime_.get(), *source_) : Vad::Load(runtime_.get(), models_dir);
+  }
+  std::string Decode(base::span<const float> pcm16k, Language language) {
+    base::AutoLock lock(lock_);
+    return asr_->Decode(pcm16k, language);
+  }
+
+ private:
+  using Key = std::pair<base::FilePath, base::FilePath>;
+
+  static base::Lock& RegistryLock() {
+    static base::NoDestructor<base::Lock> lock;
+    return *lock;
+  }
+  static std::map<Key, std::unique_ptr<SharedAsr>>& Registry() {
+    static base::NoDestructor<std::map<Key, std::unique_ptr<SharedAsr>>> registry;
+    return *registry;
+  }
+
+  SharedAsr(Key key,
+            std::unique_ptr<OrtRuntime> runtime,
+            std::unique_ptr<AsrModel> asr,
+            std::unique_ptr<ModelSource> source)
+      : key_(std::move(key)),
+        runtime_(std::move(runtime)),
+        asr_(std::move(asr)),
+        source_(std::move(source)) {}
+
+  const Key key_;
+  int users_ = 1;  // Guarded by RegistryLock().
+  std::unique_ptr<OrtRuntime> runtime_;
+  std::unique_ptr<AsrModel> asr_;
+  // An owned model's files (its VAD loads from them too).
+  std::unique_ptr<ModelSource> source_;
+  base::Lock lock_;
+};
+
+// static
+std::unique_ptr<CaptionEngine> CaptionEngine::Create(const base::FilePath& models_dir,
+                                                     const base::FilePath& ort_dylib) {
+  return Create(models_dir, ort_dylib, Options());
+}
+
+// static
+std::unique_ptr<CaptionEngine> CaptionEngine::Create(const base::FilePath& models_dir,
+                                                     const base::FilePath& ort_dylib,
+                                                     const Options& options) {
+  SharedAsr* asr = SharedAsr::Acquire(models_dir, ort_dylib, options.threads);
+  if (!asr) {
+    return nullptr;
+  }
+  // VAD keeps state per stream, so each engine has its own (2 MB).
+  std::unique_ptr<Vad> vad = asr->LoadVad(models_dir);
+  if (!vad) {
+    SharedAsr::Release(asr);
+    return nullptr;
+  }
+  return base::WrapUnique(new CaptionEngine(asr, nullptr, std::move(vad), options.segmenter));
+}
+
+// static
+std::unique_ptr<CaptionEngine> CaptionEngine::Create(std::unique_ptr<ModelSource> source,
+                                                     const base::FilePath& ort_library,
+                                                     const Options& options) {
+  std::unique_ptr<SharedAsr> owned =
+      SharedAsr::CreateOwned(std::move(source), ort_library, options.threads);
+  if (!owned) {
+    return nullptr;
+  }
+  std::unique_ptr<Vad> vad = owned->LoadVad(base::FilePath());
+  if (!vad) {
+    return nullptr;
+  }
+  SharedAsr* raw = owned.get();
+  return base::WrapUnique(
+      new CaptionEngine(raw, std::move(owned), std::move(vad), options.segmenter));
+}
+
+// static
+int CaptionEngine::LoadedModelsForTesting() {
+  return SharedAsr::Count();
+}
+
+// static
+int CaptionEngine::ModelLoadsForTesting() {
+  return SharedAsr::LoadCount();
+}
+
+CaptionEngine::CaptionEngine(SharedAsr* asr,
+                             std::unique_ptr<SharedAsr> owned_asr,
+                             std::unique_ptr<Vad> vad,
+                             const Segmenter::Options& segmenter)
+    : asr_(asr),
+      owned_asr_(std::move(owned_asr)),
+      vad_(std::move(vad)),
+      segmenter_(std::make_unique<Segmenter>(segmenter)) {}
+
+CaptionEngine::~CaptionEngine() {
+  // The VAD before the shared runtime that loaded it.
+  vad_.reset();
+  SharedAsr* asr = asr_.ExtractAsDangling();
+  if (owned_asr_) {
+    owned_asr_.reset();
+  } else {
+    SharedAsr::Release(asr);
+  }
+}
+
+void CaptionEngine::SetLanguage(Language language) {
+  language_ = language;
+}
+
+void CaptionEngine::AddAudio(base::span<const float> interleaved, int channels, int sample_rate,
+                             const EventCallback& on_event) {
+  std::vector<float> mono16k;
+  resampler_.Add(interleaved, channels, sample_rate, &mono16k);
+  if (!mono16k.empty()) {
+    AddMono16k(mono16k, on_event);
+  }
+}
+
+void CaptionEngine::AddMono16k(base::span<const float> pcm, const EventCallback& on_event) {
+  audio_.insert(audio_.end(), pcm.begin(), pcm.end());
+  for (float sample : pcm) {
+    chunk_.push_back(sample);
+    if (chunk_.size() < Vad::kChunk) {
+      continue;
+    }
+    total_ += Vad::kChunk;
+    const float p = vad_->Process(base::span(chunk_).first<Vad::kChunk>());
+    chunk_.clear();
+    const SegmenterAction a = segmenter_->OnChunk(static_cast<double>(total_) / kRate, p);
+    if (a.kind != SegmenterAction::kNone) {
+      Decode(a.kind == SegmenterAction::kFinal, a.start_s, a.end_s, on_event);
+    }
+  }
+  if (static_cast<int64_t>(audio_.size()) > 2 * kKeep) {
+    const int64_t drop = static_cast<int64_t>(audio_.size()) - kKeep;
+    audio_.erase(audio_.begin(), audio_.begin() + drop);
+    audio_start_ += drop;
+  }
+}
+
+void CaptionEngine::Flush(const EventCallback& on_event) {
+  if (std::optional<SegmenterAction> a = segmenter_->Flush(static_cast<double>(total_) / kRate)) {
+    Decode(/*is_final=*/true, a->start_s, a->end_s, on_event);
+  }
+}
+
+void CaptionEngine::Decode(bool is_final, double start_s, double end_s,
+                           const EventCallback& on_event) {
+  const int64_t end_total = audio_start_ + static_cast<int64_t>(audio_.size());
+  const int64_t begin = std::clamp<int64_t>(start_s * kRate, audio_start_, end_total);
+  const int64_t end = std::clamp<int64_t>(end_s * kRate, begin, end_total);
+  if (end - begin < kRate / 4) {
+    return;
+  }
+  const base::TimeTicks started = base::TimeTicks::Now();
+  std::string text = asr_->Decode(
+      base::span(audio_).subspan(static_cast<size_t>(begin - audio_start_),
+                                 static_cast<size_t>(end - begin)),
+      language_);
+  stats_.decodes++;
+  stats_.decode_seconds.push_back((base::TimeTicks::Now() - started).InSecondsF());
+  if (!text.empty()) {
+    on_event.Run({.is_final = is_final, .text = std::move(text)});
+  }
+}
+
+}  // namespace tark_captions
