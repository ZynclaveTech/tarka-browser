+
+TEST(LanguageDetectorTest, MatchesGolden) {
+  std::optional<base::FilePath> ort = test::OrtPath();
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(*ort);
+  ASSERT_TRUE(runtime);
+  std::unique_ptr<LanguageDetector> detector = LanguageDetector::Load(runtime.get(), *models);
+  ASSERT_TRUE(detector);
+  ASSERT_EQ(detector->labels().size(), 107u);
+  base::ListValue cases = test::LidGoldenCases(*testdata);
+  ASSERT_EQ(cases.size(), 12u);
+  for (const base::Value& value : cases) {
+    const base::DictValue& c = value.GetDict();
+    const std::string& file = *c.FindString("file");
+    int rate = 0;
+    std::vector<float> pcm = test::ReadWav(testdata->AppendASCII(file), &rate);
+    ASSERT_EQ(rate, 16000) << file;
+    pcm.resize(static_cast<size_t>(*c.FindDouble("seconds") * 16000));
+    std::vector<float> got = detector->Logits(pcm);
+    const base::ListValue& want = *c.FindList("logits");
+    ASSERT_EQ(got.size(), want.size()) << file;
+    for (size_t i = 0; i < got.size(); ++i) {
+      EXPECT_NEAR(got[i], want[i].GetDouble(), 1e-3) << file << " " << detector->labels()[i];
+    }
+    const size_t top = std::max_element(got.begin(), got.end()) - got.begin();
+    EXPECT_EQ(detector->labels()[top], *c.FindString("top")) << file;
+  }
+}
+
+TEST(LanguageDetectorTest, MissingModelIsNull) {
+  std::optional<base::FilePath> ort = test::OrtPath();
+  if (!ort) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT";
+  }
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(*ort);
+  ASSERT_TRUE(runtime);
+  EXPECT_FALSE(LanguageDetector::Load(runtime.get(), base::FilePath("/nonexistent")));
+}
