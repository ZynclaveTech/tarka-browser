+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/render_queue.h"
+
+#include <utility>
+
+namespace tark_captions {
+
+RenderQueue::RenderQueue() = default;
+RenderQueue::~RenderQueue() = default;
+
+void RenderQueue::Add(bool is_final,
+                      std::string text,
+                      std::string source,
+                      uint64_t history_id) {
+  if (is_final) {
+    draft_.reset();
+    finals_.push_back({std::move(text), std::move(source), history_id});
+  } else {
+    draft_ = Waiting{std::move(text), std::move(source)};
+  }
+}
+
+std::optional<RenderRequest> RenderQueue::Next() {
+  if (in_flight_) {
+    return std::nullopt;
+  }
+  RenderRequest request;
+  request.generation = generation_;
+  if (!finals_.empty()) {
+    request.is_final = true;
+    request.text = std::move(finals_.front().text);
+    request.source = std::move(finals_.front().source);
+    request.history_id = finals_.front().history_id;
+    finals_.pop_front();
+  } else if (draft_) {
+    request.text = std::move(draft_->text);
+    request.source = std::move(draft_->source);
+    draft_.reset();
+  } else {
+    return std::nullopt;
+  }
+  in_flight_ = true;
+  return request;
+}
+
+bool RenderQueue::Done(uint64_t generation) {
+  in_flight_ = false;
+  return generation == generation_;
+}
+
+void RenderQueue::ChoicesChanged() {
+  ++generation_;
+  draft_.reset();
+}
+
+std::vector<std::string> RenderQueue::TakeWaitingFinals() {
+  std::vector<std::string> finals;
+  for (Waiting& waiting : finals_) {
+    finals.push_back(std::move(waiting.text));
+  }
+  finals_.clear();
+  draft_.reset();
+  return finals;
+}
+
+void RenderQueue::Clear() {
+  finals_.clear();
+  draft_.reset();
+  in_flight_ = false;
+  ++generation_;
+}
+
+}  // namespace tark_captions
