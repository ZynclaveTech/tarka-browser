+std::optional<base::FilePath> PathFromEnv(base::cstring_view name) {
+  std::optional<std::string> value = base::Environment::Create()->GetVar(name);
+  if (!value || value->empty()) {
+    return std::nullopt;
+  }
+  return base::FilePath(*value);
+}
+
+class OrtRuntimeTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    std::optional<base::FilePath> ort = PathFromEnv("TARK_CAPTIONS_ORT");
+    std::optional<base::FilePath> models = PathFromEnv("TARK_CAPTIONS_MODELS");
+    if (!ort || !models) {
+      GTEST_SKIP() << "set TARK_CAPTIONS_ORT and TARK_CAPTIONS_MODELS";
+    }
+    ort_path_ = *ort;
+    models_ = *models;
+  }
+
+  base::FilePath ort_path_;
+  base::FilePath models_;
+};
+
+TEST_F(OrtRuntimeTest, LoadsRuntime) {
+  EXPECT_TRUE(OrtRuntime::Load(ort_path_));
+}
+
+// Microsoft's official builds send telemetry unless ORT_DISABLE_TELEMETRY=1
+// is set before ONNX Runtime initialises (the release's Privacy.md); Tark
+// sends nothing home.
+TEST_F(OrtRuntimeTest, DisablesTelemetryBeforeLoading) {
+  ASSERT_TRUE(OrtRuntime::Load(ort_path_));
+  std::optional<std::string> value = base::Environment::Create()->GetVar("ORT_DISABLE_TELEMETRY");
+  EXPECT_EQ(value, "1");
+}
+
+TEST_F(OrtRuntimeTest, MissingRuntimeFails) {
+  EXPECT_FALSE(OrtRuntime::Load(base::FilePath("/nonexistent/libonnxruntime.dylib")));
+}
+
+TEST_F(OrtRuntimeTest, RunsVadOnSilence) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_path_);
+  ASSERT_TRUE(runtime);
+  std::unique_ptr<OrtModel> vad =
+      runtime->LoadModel(models_.Append("silero_vad.onnx"), /*threads=*/1);
+  ASSERT_TRUE(vad);
+  std::vector<Tensor> inputs(3);
+  inputs[0] = {.name = "input", .shape = {1, 576}, .f32 = std::vector<float>(576)};
+  inputs[1] = {.name = "state", .shape = {2, 1, 128}, .f32 = std::vector<float>(256)};
+  inputs[2] = {.name = "sr", .shape = {}, .i64 = {16000}};
+  std::vector<Tensor> outputs;
+  ASSERT_TRUE(vad->Run(inputs, {"output", "stateN"}, &outputs));
+  ASSERT_EQ(outputs.size(), 2u);
+  ASSERT_EQ(outputs[0].f32.size(), 1u);
+  EXPECT_LT(outputs[0].f32[0], 0.1f);
+  EXPECT_EQ(outputs[1].shape, (std::vector<int64_t>{2, 1, 128}));
+}
+
+// Android's captions process gets model files as handles, not paths.
+TEST_F(OrtRuntimeTest, LoadsModelFromMemory) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_path_);
+  ASSERT_TRUE(runtime);
+  std::string bytes;
+  ASSERT_TRUE(base::ReadFileToString(models_.Append("silero_vad.onnx"), &bytes));
+  EXPECT_TRUE(runtime->LoadModelFromMemory(base::as_byte_span(bytes), /*threads=*/1));
+  const std::string junk = "not onnx";
+  EXPECT_FALSE(runtime->LoadModelFromMemory(base::as_byte_span(junk), /*threads=*/1));
+}
+
+TEST_F(OrtRuntimeTest, MissingModelFails) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_path_);
+  ASSERT_TRUE(runtime);
+  EXPECT_FALSE(runtime->LoadModel(base::FilePath("/nonexistent/model.onnx"), 1));
+}
