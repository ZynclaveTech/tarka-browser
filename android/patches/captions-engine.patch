+#include "components/tark_captions/caption_text.h"
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace tark_captions {
+namespace {
+
+// Keeps the last `max` characters of `s`, starting at a word.
+std::u16string Tail(const std::u16string& s, size_t max) {
+  if (s.size() <= max) {
+    return s;
+  }
+  std::u16string tail = s.substr(s.size() - max);
+  const size_t space = tail.find(u' ');
+  if (space != std::u16string::npos && space + 1 < tail.size()) {
+    tail = tail.substr(space + 1);
+  }
+  return tail;
+}
+
+}  // namespace
+
+void CaptionText::AddFinal(const std::string& text) {
+  draft_.clear();
+  const std::u16string final_text =
+      std::u16string(base::TrimWhitespace(base::UTF8ToUTF16(text), base::TRIM_ALL));
+  if (final_text.empty()) {
+    return;
+  }
+  committed_ = committed_.empty() ? final_text : committed_ + u" " + final_text;
+  // Bounded memory: no caption box shows more than this.
+  committed_ = Tail(committed_, 1000);
+}
+
+void CaptionText::SetDraft(const std::string& text) {
+  draft_ = std::u16string(base::TrimWhitespace(base::UTF8ToUTF16(text), base::TRIM_ALL));
+}
+
+void CaptionText::Clear() {
+  committed_.clear();
+  draft_.clear();
+}
+
+CaptionText::Display CaptionText::GetDisplay(size_t max_chars) const {
+  Display d;
+  d.draft = Tail(draft_, max_chars);
+  const size_t room = max_chars > d.draft.size() ? max_chars - d.draft.size() : 0;
+  d.committed = room ? Tail(committed_, room) : std::u16string();
+  return d;
+}
+
+}  // namespace tark_captions
