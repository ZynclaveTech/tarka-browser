+#include "components/tark_captions/caption_choices.h"
+
+#include <optional>
+
+#include "base/no_destructor.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+
+namespace tark_captions {
+namespace {
+
+bool IsShowIn(const std::string& code) {
+  return code.empty() || code == "latn" || code == "hi" || code == "ta" || code == "bn";
+}
+
+bool IsTranslateTo(const std::string& code) {
+  return code == "en" || code == "hi" || code == "ta" || code == "bn";
+}
+
+// Incognito's own choices, for this run only.
+struct Incognito {
+  std::optional<std::string> show_in;
+  std::optional<std::string> translate_to;
+};
+
+Incognito& IncognitoChoices() {
+  static base::NoDestructor<Incognito> choices;
+  return *choices;
+}
+
+}  // namespace
+
+// static
+void CaptionChoices::RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterStringPref(kShowInPref, "");
+  registry->RegisterStringPref(kTranslateToPref, "en");
+  registry->RegisterBooleanPref(kShowButtonPref, true);
+}
+
+// static
+void CaptionChoices::ResetIncognitoForTesting() {
+  IncognitoChoices() = Incognito();
+}
+
+CaptionChoices::CaptionChoices(PrefService* local_state) : local_state_(local_state) {}
+
+CaptionChoices::~CaptionChoices() = default;
+
+std::string CaptionChoices::show_in(bool off_the_record) const {
+  if (off_the_record && IncognitoChoices().show_in) {
+    return *IncognitoChoices().show_in;
+  }
+  const std::string code = local_state_->GetString(kShowInPref);
+  return IsShowIn(code) ? code : std::string();
+}
+
+std::string CaptionChoices::translate_to(bool off_the_record) const {
+  if (off_the_record && IncognitoChoices().translate_to) {
+    return *IncognitoChoices().translate_to;
+  }
+  const std::string code = local_state_->GetString(kTranslateToPref);
+  return IsTranslateTo(code) ? code : "en";
+}
+
+void CaptionChoices::SetShowIn(const std::string& code, bool off_the_record) {
+  if (!IsShowIn(code)) {
+    return;
+  }
+  if (off_the_record) {
+    IncognitoChoices().show_in = code;
+  } else {
+    local_state_->SetString(kShowInPref, code);
+  }
+}
+
+void CaptionChoices::SetTranslateTo(const std::string& code, bool off_the_record) {
+  if (!IsTranslateTo(code)) {
+    return;
+  }
+  if (off_the_record) {
+    IncognitoChoices().translate_to = code;
+  } else {
+    local_state_->SetString(kTranslateToPref, code);
+  }
+}
+
+bool CaptionChoices::show_button() const {
+  return local_state_->GetBoolean(kShowButtonPref);
+}
+
+void CaptionChoices::SetShowButton(bool show) {
+  local_state_->SetBoolean(kShowButtonPref, show);
+}
+
+}  // namespace tark_captions
