+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(CaptionTextTest, DraftFaded) {
+  CaptionText text;
+  text.AddFinal("first sentence");
+  text.SetDraft("second so far");
+  CaptionText::Display d = text.GetDisplay(200);
+  EXPECT_EQ(d.committed, u"first sentence");
+  EXPECT_EQ(d.draft, u"second so far");
+}
+
+TEST(CaptionTextTest, FinalReplacesDraft) {
+  CaptionText text;
+  text.SetDraft("half a sen");
+  text.AddFinal("half a sentence");
+  CaptionText::Display d = text.GetDisplay(200);
+  EXPECT_EQ(d.committed, u"half a sentence");
+  EXPECT_TRUE(d.draft.empty());
+}
+
+TEST(CaptionTextTest, KeepsLastTwoLines) {
+  CaptionText text;
+  for (int i = 0; i < 20; ++i) {
+    text.AddFinal("word" + base::NumberToString(i) + " and more words here");
+  }
+  text.SetDraft("the newest draft");
+  CaptionText::Display d = text.GetDisplay(60);
+  EXPECT_LE(d.committed.size() + d.draft.size(), 60u + 1);
+  EXPECT_EQ(d.draft, u"the newest draft");
+  // The newest final is kept, cut at a word boundary from the front.
+  EXPECT_NE(d.committed.find(u"word19"), std::u16string::npos);
+  EXPECT_NE(d.committed[0], u' ');
+}
+
+TEST(CaptionTextTest, ClearForgetsEverything) {
+  CaptionText text;
+  text.AddFinal("x");
+  text.SetDraft("y");
+  text.Clear();
+  CaptionText::Display d = text.GetDisplay(100);
+  EXPECT_TRUE(d.committed.empty());
+  EXPECT_TRUE(d.draft.empty());
+}
