+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/call_state.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(CallStateTest, MicCaptureStartsCall) {
+  CallState state;
+  EXPECT_EQ(state.phase(), CallState::Phase::kIdle);
+  state.OnMicCapturing(true);
+  EXPECT_EQ(state.phase(), CallState::Phase::kInCall);
+  EXPECT_TRUE(state.in_call());
+}
+
+TEST(CallStateTest, CaptionsOffByDefault) {
+  CallState state;
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.captions_on());
+  EXPECT_TRUE(state.SetCaptionsOn(true));
+  EXPECT_EQ(state.phase(), CallState::Phase::kCaptioning);
+}
+
+// Nothing plays and no call: the button isn't there and captions can't
+// start.
+TEST(CallStateTest, SilenceRefusesCaptions) {
+  CallState state;
+  EXPECT_FALSE(state.SetCaptionsOn(true));
+  EXPECT_FALSE(state.captions_on());
+  EXPECT_EQ(state.phase(), CallState::Phase::kIdle);
+}
+
+TEST(CallStateTest, CallEndTurnsCaptionsOff) {
+  CallState state;
+  state.OnSoundPlaying(true);
+  state.OnMicCapturing(true);
+  state.SetCaptionsOn(true);
+  state.OnMicCapturing(false);
+  EXPECT_FALSE(state.captions_on());
+  // The next call starts with captions off again.
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.captions_on());
+}
+
+TEST(CallStateTest, CallStartDoesNotTurnCaptionsOn) {
+  CallState state;
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.captions_on());
+}
+
+// D4 any-media: sound playing in the tab (a video, a podcast) is enough.
+TEST(CallStateTest, SoundLetsCaptionsOn) {
+  CallState state;
+  state.OnSoundPlaying(true);
+  EXPECT_TRUE(state.playing_sound());
+  EXPECT_EQ(state.phase(), CallState::Phase::kSound);
+  EXPECT_TRUE(state.SetCaptionsOn(true));
+  EXPECT_EQ(state.phase(), CallState::Phase::kCaptioning);
+}
+
+TEST(CallStateTest, PauseKeepsCaptions) {
+  CallState state;
+  state.OnSoundPlaying(true);
+  state.SetCaptionsOn(true);
+  state.OnSoundPlaying(false);
+  EXPECT_TRUE(state.captions_on());
+  EXPECT_TRUE(state.can_caption());
+  EXPECT_TRUE(state.SetCaptionsOn(false));
+  EXPECT_FALSE(state.can_caption());
+}
+
+// The button stays a few seconds after the sound stops; pressing it then
+// still turns captions on.
+TEST(CallStateTest, RecentSoundLetsCaptionsOn) {
+  CallState state;
+  EXPECT_FALSE(state.SetCaptionsOn(true, /*sound_recently=*/false));
+  EXPECT_TRUE(state.SetCaptionsOn(true, /*sound_recently=*/true));
+  EXPECT_TRUE(state.captions_on());
+}
+
+TEST(CallStateTest, LeavingTheSiteTurnsCaptionsOff) {
+  CallState state;
+  state.OnSoundPlaying(true);
+  state.SetCaptionsOn(true);
+  state.OnLeftSite();
+  EXPECT_FALSE(state.captions_on());
+}
+
+// One call captions at a time: its language is the profile's, and only its
+// audio may reach the engine.
+TEST(CaptioningCallTest, TurningOnTakesCaptionsFromTheOtherCall) {
+  int a = 0;
+  int b = 0;
+  CaptioningCall<int> captioning;
+  EXPECT_EQ(captioning.Take(&a), nullptr);
+  EXPECT_EQ(captioning.Take(&b), &a);
+  EXPECT_EQ(captioning.current(), &b);
+  EXPECT_EQ(captioning.Take(&b), nullptr);
+}
+
+TEST(CaptioningCallTest, OnlyTheCaptioningCallReleases) {
+  int a = 0;
+  int b = 0;
+  CaptioningCall<int> captioning;
+  captioning.Take(&a);
+  captioning.Release(&b);
+  EXPECT_EQ(captioning.current(), &a);
+  captioning.Release(&a);
+  EXPECT_EQ(captioning.current(), nullptr);
+}
+
+}  // namespace
+}  // namespace tark_captions
