+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_choices.h"
+
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+class CaptionChoicesTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    CaptionChoices::RegisterLocalStatePrefs(local_state_.registry());
+    CaptionChoices::ResetIncognitoForTesting();
+  }
+
+  TestingPrefServiceSimple local_state_;
+};
+
+TEST_F(CaptionChoicesTest, DefaultsAreOwnScriptAndEnglish) {
+  CaptionChoices choices(&local_state_);
+  EXPECT_EQ(choices.show_in(/*off_the_record=*/false), "");
+  EXPECT_EQ(choices.translate_to(/*off_the_record=*/false), "en");
+}
+
+TEST_F(CaptionChoicesTest, RemembersChoices) {
+  CaptionChoices(&local_state_).SetShowIn("latn", false);
+  CaptionChoices(&local_state_).SetTranslateTo("ta", false);
+  CaptionChoices later(&local_state_);
+  EXPECT_EQ(later.show_in(false), "latn");
+  EXPECT_EQ(later.translate_to(false), "ta");
+  // Incognito starts from the remembered choices.
+  EXPECT_EQ(later.translate_to(/*off_the_record=*/true), "ta");
+}
+
+TEST_F(CaptionChoicesTest, IncognitoWritesNothing) {
+  CaptionChoices(&local_state_).SetShowIn("hi", /*off_the_record=*/true);
+  CaptionChoices(&local_state_).SetTranslateTo("bn", /*off_the_record=*/true);
+  EXPECT_FALSE(local_state_.GetUserPref(CaptionChoices::kShowInPref));
+  EXPECT_FALSE(local_state_.GetUserPref(CaptionChoices::kTranslateToPref));
+  CaptionChoices later(&local_state_);
+  EXPECT_EQ(later.show_in(/*off_the_record=*/true), "hi");
+  EXPECT_EQ(later.translate_to(/*off_the_record=*/true), "bn");
+  EXPECT_EQ(later.show_in(/*off_the_record=*/false), "");
+  EXPECT_EQ(later.translate_to(/*off_the_record=*/false), "en");
+}
+
+TEST_F(CaptionChoicesTest, UnknownCodesAreIgnored) {
+  CaptionChoices choices(&local_state_);
+  choices.SetShowIn("klingon", false);
+  choices.SetTranslateTo("", false);
+  EXPECT_EQ(choices.show_in(false), "");
+  EXPECT_EQ(choices.translate_to(false), "en");
+}
+
+// D4 any-media: the CC button shows unless the user turned it off in
+// Settings; incognito follows the setting and never changes it.
+TEST_F(CaptionChoicesTest, CaptionsButtonShowsByDefault) {
+  EXPECT_TRUE(CaptionChoices(&local_state_).show_button());
+  CaptionChoices(&local_state_).SetShowButton(false);
+  EXPECT_FALSE(CaptionChoices(&local_state_).show_button());
+  EXPECT_FALSE(local_state_.GetBoolean(CaptionChoices::kShowButtonPref));
+}
+
