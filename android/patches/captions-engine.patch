+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "components/tark_captions/asr_model.h"
+#include "components/tark_captions/mono_resampler.h"
+#include "components/tark_captions/segmenter.h"
+
+namespace tark_captions {
+
+class ModelSource;
+class SharedAsr;
+class Vad;
+
+// A caption: a draft of what is being said, or the final text of a segment.
+struct CaptionEvent {
+  bool is_final = false;
+  std::string text;
+};
+
+// Live captions of a call's audio: speech detection, segmenting and
+// IndicConformer, in the D4 spike's measured configuration (2 threads,
+// drafts every 0.8 s, segments of at most 5 s). Not thread-safe; use on one
+// sequence. Decoding happens inside AddAudio(), so call it off the audio
+// thread.
+class CaptionEngine {
+ public:
+  struct Stats {
+    int decodes = 0;
+    std::vector<double> decode_seconds;  // wall time of each decode
+  };
+
+  // Null if ONNX Runtime or any model is missing. Engines in one process
+  // share the loaded speech model (a call page can have several audio
+  // players, each with its own recognizer); it unloads with the last one.
+  static std::unique_ptr<CaptionEngine> Create(const base::FilePath& models_dir,
+                                               const base::FilePath& ort_dylib);
+
+  // What Android varies per phone; the defaults are the Mac's.
+  struct Options {
+    int threads = 2;  // ONNX Runtime's intra-op threads for the speech model
+    Segmenter::Options segmenter;
+  };
+  // The same with `options` (a model already loaded for the folder keeps
+  // the threads it was loaded with).
+  static std::unique_ptr<CaptionEngine> Create(const base::FilePath& models_dir,
+                                               const base::FilePath& ort_dylib,
+                                               const Options& options);
+  // Android's captions process: a speech model of its own (not shared),
+  // read from `source` (the files it was handed).
+  static std::unique_ptr<CaptionEngine> Create(std::unique_ptr<ModelSource> source,
+                                               const base::FilePath& ort_library,
+                                               const Options& options);
+  // How many speech models are loaded in this process.
+  static int LoadedModelsForTesting();
+  // How many times a speech model has been loaded in this process.
+  static int ModelLoadsForTesting();
+
+  CaptionEngine(const CaptionEngine&) = delete;
+  CaptionEngine& operator=(const CaptionEngine&) = delete;
+  ~CaptionEngine();
+
+  void SetLanguage(Language language);
+
+  // Interleaved float audio at any rate and channel count; downmixed and
+  // resampled to 16 kHz mono. `on_event` runs for each draft and final.
+  using EventCallback = base::RepeatingCallback<void(CaptionEvent)>;
+  void AddAudio(base::span<const float> interleaved, int channels, int sample_rate,
+                const EventCallback& on_event);
+  // The end of the audio: finalises an open segment.
+  void Flush(const EventCallback& on_event);
+
+  const Stats& stats() const { return stats_; }
+
+ private:
+  CaptionEngine(SharedAsr* asr,
+                std::unique_ptr<SharedAsr> owned_asr,
+                std::unique_ptr<Vad> vad,
+                const Segmenter::Options& segmenter);
+
+  void AddMono16k(base::span<const float> pcm, const EventCallback& on_event);
+  void Decode(bool is_final, double start_s, double end_s, const EventCallback& on_event);
+
+  // Shared with other engines; released (not owned) on destruction.
+  // Shared with other engines and released on destruction, or (Android)
+  // this engine's own.
+  raw_ptr<SharedAsr> asr_;
+  std::unique_ptr<SharedAsr> owned_asr_;
+  std::unique_ptr<Vad> vad_;
+  std::unique_ptr<Segmenter> segmenter_;
+  Language language_ = Language::kHindi;
+
+  // 16 kHz mono audio from absolute sample `audio_start_` to `total_`.
+  std::vector<float> audio_;
+  int64_t audio_start_ = 0;
+  int64_t total_ = 0;
+  std::vector<float> chunk_;  // the next VAD chunk, being filled
+
+  MonoResampler resampler_;
+
+  Stats stats_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
