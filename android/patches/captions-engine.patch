+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_MODEL_STORE_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_MODEL_STORE_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "components/tark_captions/model_manifest.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "url/gurl.h"
+
+namespace net {
+struct RedirectInfo;
+}  // namespace net
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+namespace mojom {
+class URLResponseHead;
+}  // namespace mojom
+}  // namespace network
+
+namespace tark_captions {
+
+// The live captions models on this Mac (D4 Phase 4): which download units
+// are ready, and getting the rest from gettarka.com. Each file is
+// downloaded to `models_dir/.download/`, checked against the manifest's size
+// and SHA-256, then moved into place; a unit is ready once a marker for the
+// manifest's files is written. Models a developer copied by hand are
+// checked once and then trusted the same way. Use on one sequence.
+class CaptionModelStore {
+ public:
+  enum class State { kChecking, kMissing, kDownloading, kReady, kFailed };
+  struct Status {
+    State state = State::kChecking;
+    int64_t done = 0;   // Bytes downloaded so far.
+    int64_t total = 0;  // The unit's size.
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnModelStatusChanged(ModelUnit unit) = 0;
+  };
+
+  CaptionModelStore(const base::FilePath& models_dir,
+                    scoped_refptr<network::SharedURLLoaderFactory> factory,
+                    const GURL& base_url,
+                    base::span<const ModelUnitInfo> manifest,
+                    const net::NetworkTrafficAnnotationTag& annotation,
+                    // Tests pass their own runner for the file work.
+                    scoped_refptr<base::SequencedTaskRunner> file_runner = nullptr);
+  CaptionModelStore(const CaptionModelStore&) = delete;
+  CaptionModelStore& operator=(const CaptionModelStore&) = delete;
+  ~CaptionModelStore();
+
+  Status status(ModelUnit unit) const;
+  bool ready(ModelUnit unit) const { return status(unit).state == State::kReady; }
+
+  // Starts getting `unit` (also a retry after kFailed); nothing if it is
+  // ready, downloading or still being checked.
+  void Download(ModelUnit unit);
+  void Cancel(ModelUnit unit);
+  // Deletes a ready unit's files. False while it is in use or downloading.
+  bool Remove(ModelUnit unit);
+  // A call is using the unit: it can't be removed.
+  void SetInUse(ModelUnit unit, bool in_use);
+  bool in_use(ModelUnit unit) const;
+  // The size of the units that are ready.
+  int64_t BytesOnDisk() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  struct Unit {
+    Status status;
+    bool in_use = false;
+    bool download_when_checked = false;
+    // Bumped by every Download, Cancel and failure; replies from an older
+    // download are dropped.
+    uint64_t generation = 0;
+    size_t next_file = 0;
+    int64_t done_before_file = 0;
+    std::unique_ptr<network::SimpleURLLoader> loader;
+  };
+
+  const ModelUnitInfo* Info(ModelUnit unit) const;
+  void OnChecked(ModelUnit unit, bool ready);
+  bool IsCurrent(ModelUnit unit, uint64_t generation);
+  void StartNextFile(ModelUnit unit, uint64_t generation);
+  void OnPlacedChecked(ModelUnit unit, uint64_t generation, bool in_place);
+  void OnRedirect(ModelUnit unit,
+                  uint64_t generation,
+                  const GURL& url_before_redirect,
+                  const net::RedirectInfo& redirect_info,
+                  const network::mojom::URLResponseHead& response_head,
+                  std::vector<std::string>* removed_headers);
+  void OnProgress(ModelUnit unit, uint64_t current);
+  void OnFileDownloaded(ModelUnit unit, uint64_t generation, base::FilePath path);
+  void OnFileVerified(ModelUnit unit, uint64_t generation, bool ok);
+  void OnMarkerWritten(ModelUnit unit, uint64_t generation, bool ok);
+  void Fail(ModelUnit unit);
+  void Notify(ModelUnit unit);
+
+  const base::FilePath models_dir_;
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const GURL base_url_;
+  const base::span<const ModelUnitInfo> manifest_;
+  const net::NetworkTrafficAnnotationTag annotation_;
+  // File work (checking, hashing, moving) runs here, in order.
+  scoped_refptr<base::SequencedTaskRunner> files_;
+  std::map<ModelUnit, Unit> units_;
+  base::ObserverList<Observer> observers_;
+  SEQUENCE_CHECKER(sequence_checker_);
+  base::WeakPtrFactory<CaptionModelStore> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_MODEL_STORE_H_
