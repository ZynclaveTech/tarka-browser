+#include "components/tark_captions/client_language.h"
+
+#include <optional>
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+using State = ClientLanguage::State;
+
+TEST(ClientLanguageTest, StartsDetecting) {
+  ClientLanguage language(/*apple_available=*/true);
+  EXPECT_EQ(language.state(), State::kDetecting);
+  EXPECT_TRUE(language.automatic());
+  EXPECT_EQ(language.code(), "");
+  EXPECT_EQ(language.recognizer_code(), "auto");
+}
+
+TEST(ClientLanguageTest, DetectedTamilCaptions) {
+  ClientLanguage language(true);
+  language.Detected("ta");
+  EXPECT_EQ(language.state(), State::kCaptioning);
+  EXPECT_EQ(language.code(), "ta");
+  EXPECT_TRUE(language.detected());
+  // Captions off and on again in the same call keep what was heard.
+  EXPECT_EQ(language.recognizer_code(), "ta");
+}
+
+TEST(ClientLanguageTest, ManualChoiceBeatsLateDetection) {
+  ClientLanguage language(true);
+  language.Choose("bn");
+  language.Detected("ta");
+  EXPECT_EQ(language.state(), State::kCaptioning);
+  EXPECT_EQ(language.code(), "bn");
+  EXPECT_FALSE(language.detected());
+  EXPECT_FALSE(language.automatic());
+}
+
+TEST(ClientLanguageTest, DetectionLocks) {
+  ClientLanguage language(true);
+  language.Detected("ta");
+  language.Detected("hi");
+  EXPECT_EQ(language.code(), "ta");
+}
+
+TEST(ClientLanguageTest, AutoAgainRedetects) {
+  ClientLanguage language(true);
+  language.Choose("hi");
+  const uint64_t before = language.generation();
+  language.ChooseAuto();
+  EXPECT_EQ(language.state(), State::kDetecting);
+  EXPECT_GT(language.generation(), before);
+  EXPECT_EQ(language.recognizer_code(), "auto");
+  language.Detected("bn");
+  EXPECT_EQ(language.code(), "bn");
+}
+
+TEST(ClientLanguageTest, AppleLanguageWithoutAppleSpeech) {
+  ClientLanguage language(/*apple_available=*/false);
+  language.Detected("es");
+  EXPECT_EQ(language.state(), State::kAppleUnavailable);
+  EXPECT_EQ(language.code(), "es");
+}
+
+TEST(ClientLanguageTest, AppleLanguageWithAppleSpeech) {
+  ClientLanguage language(true);
+  language.Detected("es");
+  EXPECT_EQ(language.state(), State::kApple);
+}
+
+TEST(ClientLanguageTest, UrduShownAsHindi) {
+  ClientLanguage language(true);
+  language.Detected("ur");
+  EXPECT_EQ(language.state(), State::kCaptioning);
+  EXPECT_EQ(language.code(), "hi");
+}
+
+TEST(ClientLanguageTest, UndeterminedKeepsDetecting) {
+  ClientLanguage language(true);
+  language.Detected("und");
+  EXPECT_EQ(language.state(), State::kDetecting);
+  EXPECT_FALSE(language.detected());
+}
+
+TEST(ClientLanguageTest, PlannedAndUnsupported) {
+  ClientLanguage telugu(true);
+  telugu.Detected("te");
+  EXPECT_EQ(telugu.state(), State::kPlanned);
+  ClientLanguage swahili(true);
+  swahili.Detected("sw");
+  EXPECT_EQ(swahili.state(), State::kUnsupported);
+  EXPECT_EQ(swahili.code(), "sw");
+}
+
+// Every recognizer in the call's tab hears the lock: the first to decide
+// sets the language, and one that decides otherwise is told it.
+TEST(ClientLanguageTest, LockTellsEveryRecognizer) {
+  ClientLanguage language(true);
+  EXPECT_EQ(language.Detected("ta"), std::optional<std::string>("ta"));
+  EXPECT_EQ(language.Detected("hi"), std::optional<std::string>("ta"));
+  EXPECT_EQ(language.Detected("ta"), std::nullopt);
+  EXPECT_EQ(language.Detected("und"), std::nullopt);
+  language.Choose("bn");
+  EXPECT_EQ(language.Detected("ta"), std::optional<std::string>("bn"));
+}
+
+// Nothing to decode for a language Tark can't caption: recognizers idle
+// ("none"), never an error that would hide the notice.
+TEST(ClientLanguageTest, CantCaptionTellsRecognizersNone) {
+  ClientLanguage swahili(true);
+  EXPECT_EQ(swahili.Detected("sw"), std::optional<std::string>("none"));
+  EXPECT_EQ(swahili.recognizer_code(), "none");
+  ClientLanguage telugu(true);
+  telugu.Detected("te");
+  EXPECT_EQ(telugu.recognizer_code(), "none");
+  ClientLanguage spanish(/*apple_available=*/false);
+  spanish.Detected("es");
+  EXPECT_EQ(spanish.recognizer_code(), "none");
+  ClientLanguage apple(/*apple_available=*/true);
+  apple.Detected("es");
+  EXPECT_EQ(apple.recognizer_code(), "es");
+}
+
+// macOS speech loads in the background: it can become available after the
+// call's language object is made, and before a detection.
+TEST(ClientLanguageTest, AppleAvailabilityCanArriveLater) {
+  ClientLanguage language(/*apple_available=*/false);
+  language.set_apple_available(true);
+  language.Detected("es");
+  EXPECT_EQ(language.state(), State::kApple);
+  EXPECT_EQ(language.recognizer_code(), "es");
