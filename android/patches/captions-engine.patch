+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/media_players.h"
+
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr PlayerKey kVideo{1, 2, 3};
+constexpr PlayerKey kOther{1, 2, 4};
+constexpr gfx::Size kArea(1200, 800);
+constexpr gfx::Size kButton(30, 22);
+
+class MediaPlayersTest : public testing::Test {
+ protected:
+  base::TimeTicks At(base::TimeDelta d) const { return t0_ + d; }
+
+  const base::TimeTicks t0_ = base::TimeTicks() + base::Seconds(100);
+  MediaPlayers players_;
+};
+
+TEST_F(MediaPlayersTest, ButtonAppearsAfterHalfASecond) {
+  players_.OnStarted(kVideo, /*has_video=*/true, /*has_audio=*/true, t0_);
+  EXPECT_TRUE(players_.AnyAudible());
+  EXPECT_FALSE(players_.ButtonShown(false, At(base::Milliseconds(499))));
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Milliseconds(500))));
+  EXPECT_EQ(players_.NextChange(false, t0_), At(base::Milliseconds(500)));
+}
+
+// A pause keeps the button for 3 s, and playing again within them shows it
+// at once.
+TEST_F(MediaPlayersTest, ButtonStaysThroughShortPause) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnStopped(kVideo, At(base::Seconds(5)));
+  EXPECT_FALSE(players_.AnyAudible());
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Milliseconds(7900))));
+  EXPECT_FALSE(players_.ButtonShown(false, At(base::Seconds(8))));
+  EXPECT_EQ(players_.NextChange(false, At(base::Seconds(6))), At(base::Seconds(8)));
+  players_.OnStarted(kVideo, true, true, At(base::Seconds(6)));
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Seconds(6))));
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Seconds(9))));
+}
+
+TEST_F(MediaPlayersTest, ShortBlipShowsNothing) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnStopped(kVideo, At(base::Milliseconds(200)));
+  EXPECT_FALSE(players_.ButtonShown(false, At(base::Milliseconds(600))));
+  EXPECT_EQ(players_.NextChange(false, At(base::Milliseconds(300))), std::nullopt);
+}
+
+TEST_F(MediaPlayersTest, MutedPlayerIsNotSound) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnMuted(kVideo, true, t0_);
+  EXPECT_FALSE(players_.AnyAudible());
+  EXPECT_FALSE(players_.ButtonShown(false, At(base::Seconds(1))));
+}
+
+TEST_F(MediaPlayersTest, SilentVideoIsNotSound) {
+  players_.OnStarted(kVideo, true, /*has_audio=*/false, t0_);
+  EXPECT_FALSE(players_.AnyAudible());
+}
+
+TEST_F(MediaPlayersTest, TabMutedMeansNoButton) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.SetTabMuted(true, t0_);
+  EXPECT_FALSE(players_.AnyAudible());
+  EXPECT_FALSE(players_.ButtonShown(false, At(base::Seconds(1))));
+  players_.SetTabMuted(false, At(base::Seconds(2)));
+  EXPECT_TRUE(players_.AnyAudible());
+}
+
+TEST_F(MediaPlayersTest, CallShowsTheButtonAtOnce) {
+  EXPECT_TRUE(players_.ButtonShown(/*in_call=*/true, t0_));
+}
+
+TEST_F(MediaPlayersTest, CallUsesWindowCorner) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(100, 100, 640, 360));
+  EXPECT_EQ(PlaceButton(players_, /*in_call=*/true, kArea, kButton),
+            gfx::Rect(1200 - 16 - 30, 800 - 16 - 22, 30, 22));
+}
+
+TEST_F(MediaPlayersTest, ButtonSitsOnTheVideo) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(100, 100, 640, 360));
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton),
+            gfx::Rect(100 + 640 - 10 - 30, 100 + 360 - 50 - 22, 30, 22));
+}
+
+TEST_F(MediaPlayersTest, LatestAudibleVideoWins) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(0, 0, 400, 300));
+  players_.OnStarted(kOther, true, true, At(base::Seconds(1)));
+  players_.OnVideoRect(kOther, gfx::Rect(500, 400, 400, 300));
+  EXPECT_EQ(players_.AnchorVideo(), gfx::Rect(500, 400, 400, 300));
+  players_.OnStopped(kOther, At(base::Seconds(2)));
+  EXPECT_EQ(players_.AnchorVideo(), gfx::Rect(0, 0, 400, 300));
+}
+
+// Spec: a video scrolled away hides its button.
+TEST_F(MediaPlayersTest, OffScreenVideoHidesButton) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect());
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton), std::nullopt);
+  players_.OnVideoRect(kVideo, gfx::Rect(0, 900, 640, 360));
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton), std::nullopt);
+}
+
+// A video whose box isn't known (an embed Tark can't map): the window corner.
+TEST_F(MediaPlayersTest, UnknownBoxUsesCorner) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton),
+            gfx::Rect(1200 - 16 - 30, 800 - 16 - 22, 30, 22));
+}
+
+TEST_F(MediaPlayersTest, AudioOnlyUsesCorner) {
+  players_.OnStarted(kVideo, /*has_video=*/false, true, t0_);
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton),
+            gfx::Rect(1200 - 16 - 30, 800 - 16 - 22, 30, 22));
+}
+
+TEST_F(MediaPlayersTest, ButtonStaysInsideTheArea) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(800, 700, 640, 360));
+  const std::optional<gfx::Rect> place = PlaceButton(players_, false, kArea, kButton);
+  ASSERT_TRUE(place);
+  EXPECT_TRUE(gfx::Rect(kArea).Contains(*place));
+}
+
+// After a pause the button stays on the video it belongs to (the linger,
+// or captions still on), not the window's corner.
+TEST_F(MediaPlayersTest, PausedVideoKeepsTheButton) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(100, 100, 640, 360));
+  players_.OnStopped(kVideo, At(base::Seconds(5)));
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton),
+            gfx::Rect(100 + 640 - 10 - 30, 100 + 360 - 50 - 22, 30, 22));
+}
+
+// Of two silent videos, the one heard last keeps it.
+TEST_F(MediaPlayersTest, LastHeardVideoKeepsTheButton) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(0, 0, 400, 300));
+  players_.OnStarted(kOther, true, true, At(base::Seconds(1)));
+  players_.OnVideoRect(kOther, gfx::Rect(500, 400, 400, 300));
+  players_.OnStopped(kOther, At(base::Seconds(2)));
+  players_.OnStopped(kVideo, At(base::Seconds(3)));
+  EXPECT_EQ(players_.AnchorVideo(), gfx::Rect(0, 0, 400, 300));
+}
+
+// A muted autoplay video the person unmutes: its metadata gains audio.
+TEST_F(MediaPlayersTest, UnmutedAutoplayGetsTheButton) {
+  players_.OnStarted(kVideo, true, /*has_audio=*/false, t0_);
+  EXPECT_FALSE(players_.AnyAudible());
+  players_.OnMetadata(kVideo, /*has_video=*/true, /*has_audio=*/true, At(base::Seconds(2)));
+  EXPECT_TRUE(players_.AnyAudible());
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Milliseconds(2500))));
+}
+
+// Sound from no media element (Web Audio): the tab is audible; the corner.
+TEST_F(MediaPlayersTest, WebAudioUsesCorner) {
+  players_.SetTabAudible(true, t0_);
+  EXPECT_TRUE(players_.AnyAudible());
+  EXPECT_TRUE(players_.ButtonShown(false, At(base::Milliseconds(500))));
+  EXPECT_EQ(PlaceButton(players_, false, kArea, kButton),
+            gfx::Rect(1200 - 16 - 30, 800 - 16 - 22, 30, 22));
+  players_.SetTabAudible(false, At(base::Seconds(5)));
+  EXPECT_FALSE(players_.AnyAudible());
+}
+
+TEST_F(MediaPlayersTest, DestroyedPlayerIsForgotten) {
+  players_.OnStarted(kVideo, true, true, t0_);
+  players_.OnVideoRect(kVideo, gfx::Rect(100, 100, 640, 360));
+  players_.OnDestroyed(kVideo, At(base::Seconds(1)));
+  EXPECT_FALSE(players_.AnyAudible());
+  EXPECT_EQ(players_.AnchorVideo(), std::nullopt);
+}
+
+}  // namespace
+}  // namespace tark_captions
