+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/indic_text.h"
+
+#include <string>
+
+#include "base/strings/utf_string_conversions.h"
+#include "components/tark_captions/test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+
+namespace tark_captions {
+namespace {
+
+// The golden cases (utils/indictrans_export.py golden): real caption
+// hypotheses through IndicTransToolkit's IndicProcessor.
+base::ListValue Cases() {
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  return testdata ? test::MtGoldenCases(*testdata) : base::ListValue();
+}
+
+Language LanguageOf(const base::DictValue& c) {
+  return *LanguageFromCode(*c.FindString("lang"));
+}
+
+TEST(IndicTextTest, NormalizeMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(base::UTF16ToUTF8(NormalizeIndic(base::UTF8ToUTF16(*c.FindString("caption")),
+                                               LanguageOf(c))),
+              *c.FindString("normalized"))
+        << *c.FindString("id");
+  }
+}
+
+TEST(IndicTextTest, ModelInputMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(ModelInput(*c.FindString("caption"), LanguageOf(c)), *c.FindString("model_input"))
+        << *c.FindString("id");
+  }
+}
+
+TEST(IndicTextTest, EnglishDetokenizeMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(DetokenizeEnglish(*c.FindString("english_tokens")), *c.FindString("english"))
+        << *c.FindString("id");
+  }
+}
+
+// Tamil has no voiced or aspirated plosives: ग and ड become க and ட.
+TEST(IndicTextTest, TamilTargetUsesUnvoicedPlosives) {
+  EXPECT_EQ(ConvertScript(u"गड", Script::kDevanagari, Script::kTamil), u"கட");
+}
+
+TEST(IndicTextTest, DandasUnchanged) {
+  EXPECT_EQ(ConvertScript(u"क।", Script::kDevanagari, Script::kBengali), u"ক।");
+}
+
+TEST(IndicTextTest, ScriptsOfLanguages) {
+  EXPECT_EQ(ScriptOf(Language::kHindi), Script::kDevanagari);
+  EXPECT_EQ(ScriptOf(Language::kTamil), Script::kTamil);
+  EXPECT_EQ(ScriptOf(Language::kBengali), Script::kBengali);
+}
+
+// "Show their words in" another Indian script: offsets that land on empty
+// code points (Tamil has no voiced plosives, Bengali no ன ற ழ வ...) are
+// replaced by the nearest letter, never shown as empty boxes.
+TEST(IndicTextTest, DisplayConversionHasNoEmptyLetters) {
+  const Script kScripts[] = {Script::kDevanagari, Script::kTamil, Script::kBengali};
+  const char16_t kStart[] = {0x0900, 0x0B80, 0x0980};
+  for (int from = 0; from < 3; ++from) {
+    std::u16string every;
+    for (char16_t c = kStart[from]; c <= kStart[from] + 0x6F; ++c) {
+      if (u_isdefined(c)) {
+        every += c;
+      }
+    }
+    std::vector<std::u16string> inputs = {every};
+    base::ListValue cases = Cases();
+    for (const base::Value& v : cases) {
+      if (ScriptOf(LanguageOf(v.GetDict())) == kScripts[from]) {
+        inputs.push_back(base::UTF8ToUTF16(*v.GetDict().FindString("caption")));
+      }
+    }
+    for (int to = 0; to < 3; ++to) {
+      if (to == from) {
+        continue;
+      }
+      for (const std::u16string& input : inputs) {
+        for (char16_t c : ConvertScriptForDisplay(input, kScripts[from], kScripts[to])) {
+          EXPECT_TRUE(u_isdefined(c)) << "U+" << std::hex << static_cast<int>(c) << " from "
+                                      << from << " to " << to;
+        }
+      }
+    }
+  }
+}
+
+TEST(IndicTextTest, DisplayConversionKeepsCommonLetters) {
+  EXPECT_EQ(ConvertScriptForDisplay(u"நன்றி", Script::kTamil, Script::kBengali), u"নন্রি");
+  EXPECT_EQ(ConvertScriptForDisplay(u"विकास", Script::kDevanagari, Script::kBengali), u"বিকাস");
+}
+
