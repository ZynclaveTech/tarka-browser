+    @Test
+    public void testSecondStartWhileLive() {
+        start(NATIVE_1, "hi-IN");
+        SpeechRecognizer olderRecognizer = mFactory.mCreated.get(0);
+        SpeechRecognitionImpl newer = start(NATIVE_2, "hi-IN");
+
+        // The newer session wins: the older one ends aborted, its recognizer cancelled and
+        // destroyed exactly once.
+        verifyEndedWith(NATIVE_1, SpeechRecognitionErrorCode.ABORTED);
+        verify(olderRecognizer, times(1)).destroy();
+
+        // The newer one gets its own recognizer and starts listening.
+        assertEquals(2, mFactory.mCreated.size());
+        SpeechRecognizer newerRecognizer = mFactory.mCreated.get(1);
+        verify(newerRecognizer).startListening(any());
+        verify(newerRecognizer, never()).destroy();
+        verify(mNatives, never()).onRecognitionError(eq(NATIVE_2), anyInt());
+
+        // It works and ends normally; a late abort of the older one changes nothing.
+        Bundle results = new Bundle();
+        results.putStringArrayList(
+                SpeechRecognizer.RESULTS_RECOGNITION, new ArrayList<>(Arrays.asList("नमस्ते")));
+        newer.getListenerForTesting().onResults(results);
+        verify(mNatives).onRecognitionResults(eq(NATIVE_2), any(), any(), eq(false));
+        verify(mNatives, times(1)).onRecognitionEnd(NATIVE_2);
+        verify(mNatives, never()).onRecognitionError(eq(NATIVE_2), anyInt());
+        verify(newerRecognizer, times(1)).destroy();
+        verify(olderRecognizer, times(1)).destroy();
+        verify(mNatives, times(1)).onRecognitionEnd(NATIVE_1);
+    }
