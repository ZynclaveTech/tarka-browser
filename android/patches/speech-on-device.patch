+        assertFalse(SpeechRecognitionImpl.initialize());
+        start(NATIVE_1, "hi-IN");
+
+        assertEquals(0, mFactory.mCreated.size());
+        verifyEndedWith(NATIVE_1, SpeechRecognitionErrorCode.SERVICE_NOT_ALLOWED);
+    }
+
+    @Test
+    public void testNoOnDeviceIsServiceNotAllowed() {
+        mFactory.mAvailable = false;
+        assertFalse(SpeechRecognitionImpl.initialize());
+        start(NATIVE_1, "hi-IN");
+
+        assertEquals(0, mFactory.mCreated.size());
+        verifyEndedWith(NATIVE_1, SpeechRecognitionErrorCode.SERVICE_NOT_ALLOWED);
+    }
