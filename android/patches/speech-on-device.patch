+    @Test
+    public void testErrorNames() {
+        assertEquals(
+                SpeechRecognitionErrorCode.NO_SPEECH,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_NO_MATCH));
+        assertEquals(
+                SpeechRecognitionErrorCode.NO_SPEECH,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_SPEECH_TIMEOUT));
+        assertEquals(
+                SpeechRecognitionErrorCode.AUDIO_CAPTURE,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_AUDIO));
+        assertEquals(
+                SpeechRecognitionErrorCode.NOT_ALLOWED,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS));
+        assertEquals(
+                SpeechRecognitionErrorCode.LANGUAGE_NOT_SUPPORTED,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_LANGUAGE_NOT_SUPPORTED));
+        assertEquals(
+                SpeechRecognitionErrorCode.LANGUAGE_NOT_SUPPORTED,
+                SpeechRecognitionImpl.mapError(SpeechRecognizer.ERROR_LANGUAGE_UNAVAILABLE));
+        for (int error :
+                Arrays.asList(
+                        SpeechRecognizer.ERROR_NETWORK,
+                        SpeechRecognizer.ERROR_NETWORK_TIMEOUT,
+                        SpeechRecognizer.ERROR_SERVER,
+                        SpeechRecognizer.ERROR_TOO_MANY_REQUESTS,
+                        SpeechRecognizer.ERROR_SERVER_DISCONNECTED,
+                        14, // ERROR_CANNOT_CHECK_SUPPORT (API 33)
+                        15, // ERROR_CANNOT_LISTEN_TO_DOWNLOAD_EVENTS (API 33)
