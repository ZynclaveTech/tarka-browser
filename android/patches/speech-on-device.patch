+/** Tark: speech recognition runs on the device only, and every error ends the session. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(manifest = Config.NONE, sdk = 31)
+public class SpeechRecognitionImplTest {
+    private static final long NATIVE_1 = 1;
+    private static final long NATIVE_2 = 2;
+
+    @Rule public final MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private SpeechRecognitionImpl.Natives mNatives;
+    @Mock private SpeechRecognitionImpl.LanguageDelegate mLanguageDelegate;
+
+    /** Stands in for Android: only on-device recognizers exist here. */
+    private static class FakeFactory implements SpeechRecognitionImpl.RecognizerFactory {
+        boolean mAvailable = true;
+        final List<SpeechRecognizer> mCreated = new ArrayList<>();
+
+        @Override
+        public boolean isOnDeviceRecognitionAvailable(Context context) {
+            return mAvailable;
+        }
+
+        @Override
+        public SpeechRecognizer createOnDeviceSpeechRecognizer(Context context) {
+            SpeechRecognizer recognizer = mock(SpeechRecognizer.class);
+            mCreated.add(recognizer);
+            return recognizer;
+        }
+    }
+
+    private final FakeFactory mFactory = new FakeFactory();
+
+    @Before
+    public void setUp() {
+        SpeechRecognitionImplJni.setInstanceForTesting(mNatives);
+        SpeechRecognitionImpl.setRecognizerFactoryForTesting(mFactory);
+    }
+
+    @After
+    public void tearDown() {
+        SpeechRecognitionImpl.resetForTesting();
+    }
+
+    private static SpeechRecognitionImpl start(long nativePtr, String language) {
+        SpeechRecognitionImpl session = SpeechRecognitionImpl.createSpeechRecognition(nativePtr);
+        session.startRecognition(language, false, true);
+        return session;
+    }
+
+    private void verifyEndedWith(long nativePtr, int code) {
+        verify(mNatives).onRecognitionError(nativePtr, code);
+        verify(mNatives).onRecognitionEnd(nativePtr);
+    }
+
+    @Test
+    public void testUsesOnDeviceRecognizer() {
+        assertTrue(SpeechRecognitionImpl.initialize());
+        start(NATIVE_1, "hi-IN");
+
+        // The only recognizer comes from the on-device factory, which is the only way
+        // SpeechRecognitionImpl creates one (it never calls createSpeechRecognizer).
+        assertEquals(1, mFactory.mCreated.size());
+        ArgumentCaptor<Intent> intent = ArgumentCaptor.forClass(Intent.class);
+        verify(mFactory.mCreated.get(0)).startListening(intent.capture());
+        assertEquals("hi-IN", intent.getValue().getStringExtra(RecognizerIntent.EXTRA_LANGUAGE));
+        verify(mNatives, never()).onRecognitionError(anyLong(), anyInt());
+    }
+
+    @Test
+    public void testEmptyLanguageIsThePhones() {
+        Locale saved = Locale.getDefault();
+        Locale.setDefault(Locale.forLanguageTag("ta-IN"));
+        try {
+            start(NATIVE_1, "");
+        } finally {
+            Locale.setDefault(saved);
+        }
+        ArgumentCaptor<Intent> intent = ArgumentCaptor.forClass(Intent.class);
+        verify(mFactory.mCreated.get(0)).startListening(intent.capture());
+        assertEquals("ta-IN", intent.getValue().getStringExtra(RecognizerIntent.EXTRA_LANGUAGE));
+    }
+
