--- /dev/null
+++ b/components/tark_xlit/android_files_unittest.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android (A3): the model and one word-list file per language are
+// downloaded into the app's data directory, not shipped in the APK.
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/path_service.h"
+#include "components/tark_xlit/transliterator.h"
+#include "components/tark_xlit/word_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_xlit {
+namespace {
+
+// android/build.sh puts two of android/xlit/files.py's per-language files here,
+// next to the Mac's model (test/data/xlit-model.bin).
+base::FilePath TestDataDir() {
+  return base::PathService::CheckedGet(base::DIR_SRC_TEST_DATA_ROOT)
+      .AppendASCII("components/tark_xlit/test/data");
+}
+
+base::FilePath AndroidFile(std::string_view name) {
+  return TestDataDir().AppendASCII("android").AppendASCII(name);
+}
+
+std::unique_ptr<base::MemoryMappedFile> Map(const base::FilePath& path) {
+  auto file = std::make_unique<base::MemoryMappedFile>();
+  EXPECT_TRUE(file->Initialize(path)) << path;
+  return file;
+}
+
+std::unique_ptr<WordList> LoadFiles(std::vector<std::string> names) {
+  std::vector<std::unique_ptr<base::MemoryMappedFile>> files;
+  for (const std::string& name : names) {
+    files.push_back(Map(AndroidFile(name)));
+  }
+  return WordList::Load(std::move(files));
+}
+
+TEST(TarkXlitAndroidFilesTest, CountComesFromTheLanguagesFile) {
+  std::unique_ptr<WordList> words =
+      LoadFiles({"xlit-words-hi.bin", "xlit-words-ta.bin"});
+  ASSERT_TRUE(words);
+  EXPECT_TRUE(words->HasLanguage("hi"));
+  EXPECT_TRUE(words->HasLanguage("ta"));
+  EXPECT_TRUE(words->Count("hi", u"नमस्ते").has_value());
+  EXPECT_TRUE(words->Count("ta", u"வணக்கம்").has_value());
+  EXPECT_FALSE(words->Count("hi", u"வணக்கம்").has_value());
+}
+
+TEST(TarkXlitAndroidFilesTest, MissingLanguageIsNotFound) {
+  std::unique_ptr<WordList> words = LoadFiles({"xlit-words-hi.bin"});
+  ASSERT_TRUE(words);
+  EXPECT_FALSE(words->HasLanguage("ta"));
+  EXPECT_FALSE(words->HasLanguage("bn"));
+  EXPECT_FALSE(words->Count("ta", u"வணக்கம்").has_value());
+}
+
+TEST(TarkXlitAndroidFilesTest, EnglishFromAnyFile) {
+  for (const char* name : {"xlit-words-hi.bin", "xlit-words-ta.bin"}) {
+    std::unique_ptr<WordList> words = LoadFiles({name});
+    ASSERT_TRUE(words) << name;
+    EXPECT_TRUE(words->IsCommonEnglish("the")) << name;
+    EXPECT_FALSE(words->IsCommonEnglish("namaste")) << name;
+  }
+}
+
+TEST(TarkXlitAndroidFilesTest, AnInvalidFileFailsTheLoad) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath bad = dir.GetPath().AppendASCII("xlit-words-ta.bin");
+  ASSERT_TRUE(base::WriteFile(bad, "not a word list"));
+  std::vector<std::unique_ptr<base::MemoryMappedFile>> files;
+  files.push_back(Map(AndroidFile("xlit-words-hi.bin")));
+  files.push_back(Map(bad));
+  EXPECT_FALSE(WordList::Load(std::move(files)));
+  EXPECT_FALSE(
+      WordList::Load(std::vector<std::unique_ptr<base::MemoryMappedFile>>()));
+}
+
+// A directory laid out as the download service leaves it.
+class TarkXlitAndroidDirectoryTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    ASSERT_TRUE(base::CopyFile(TestDataDir().AppendASCII("xlit-model.bin"),
+                               Path("xlit-model.bin")));
+  }
+  void TearDown() override {
+    SetResourceDirectory(base::FilePath());
+    SetFilesReady(false);
+  }
+  base::FilePath Path(std::string_view name) const {
+    return dir_.GetPath().AppendASCII(name);
+  }
+  void Add(std::string_view name, std::string_view as) {
+    ASSERT_TRUE(base::CopyFile(AndroidFile(name), Path(as)));
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(TarkXlitAndroidDirectoryTest, LoadsModelWithOnlyOneLanguage) {
+  Add("xlit-words-hi.bin", "xlit-words-hi.bin");
+  scoped_refptr<Resources> resources =
+      LoadResourcesFromDirectory(dir_.GetPath());
+  ASSERT_TRUE(resources);
+  EXPECT_TRUE(resources->words->HasLanguage("hi"));
+  EXPECT_FALSE(resources->words->HasLanguage("ta"));
+  Transliterator transliterator(resources);
+  EXPECT_EQ(transliterator.Phrase(u"namaste", "hi"), u"नमस्ते");
+}
+
+TEST_F(TarkXlitAndroidDirectoryTest, ModelWithoutAnyWordListLoadsNothing) {
+  EXPECT_FALSE(LoadResourcesFromDirectory(dir_.GetPath()));
+}
+
+TEST_F(TarkXlitAndroidDirectoryTest, IgnoresPartFiles) {
+  Add("xlit-words-hi.bin", "xlit-words-hi.bin.part");
+  EXPECT_FALSE(LoadResourcesFromDirectory(dir_.GetPath()));
+  Add("xlit-words-ta.bin", "xlit-words-ta.bin");
+  scoped_refptr<Resources> resources =
+      LoadResourcesFromDirectory(dir_.GetPath());
+  ASSERT_TRUE(resources);
+  EXPECT_TRUE(resources->words->HasLanguage("ta"));
+  EXPECT_FALSE(resources->words->HasLanguage("hi"));
+}
+
+TEST_F(TarkXlitAndroidDirectoryTest, NotReadyLoadsNothing) {
+  Add("xlit-words-hi.bin", "xlit-words-hi.bin");
+  SetResourceDirectory(dir_.GetPath());
+  SetFilesReady(false);
+  EXPECT_FALSE(FilesReady());
+  EXPECT_FALSE(LoadResourcesFromBundle());
+}
+
+TEST_F(TarkXlitAndroidDirectoryTest, ReloadsAfterFilesBecomeReady) {
+  SetResourceDirectory(dir_.GetPath());
+  EXPECT_FALSE(LoadResourcesFromBundle());
+  Add("xlit-words-hi.bin", "xlit-words-hi.bin");
+  SetFilesReady(true);
+  EXPECT_TRUE(FilesReady());
+  scoped_refptr<Resources> resources = LoadResourcesFromBundle();
+  ASSERT_TRUE(resources);
+  EXPECT_TRUE(resources->words->HasLanguage("hi"));
+}
+
+}  // namespace
+}  // namespace tark_xlit
