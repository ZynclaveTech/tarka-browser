+void HTMLVideoElement::RequestTarkFullscreenForPictureInPicture(
+    RequestTarkFullscreenForPictureInPictureCallback callback) {
+  // Tark: Picture in Picture on leave. The browser asked (not the page), as
+  // it does on a rotation to landscape. The allowance covers this element's
+  // request only, made here; the browser waives transient activation for the
+  // frame's request sent before the reply below, and for nothing after it.
+  {
+    ScopedAllowFullscreen allow(ScopedAllowFullscreen::kOrientationChange);
+    EnterFullscreen();
+  }
+  std::move(callback).Run();
+}
