+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
+#define CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
+
+#include <optional>
+
+#include "content/common/content_export.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content {
+
+class WebContents;
+
+namespace tark_media {
+
+// Tark for Android: Picture in Picture on leave. When the user leaves Tark
+// while the current tab plays a video with sound, the browser activity enters
+// Android's Picture in Picture, and that video becomes the fullscreen element
+// so the window shows only the video, inline or already fullscreen.
+
+// Whether `web_contents` plays sound and a video now. A muted video doesn't
+// count, nor a tab whose video is already in video Picture in Picture.
+CONTENT_EXPORT bool CanEnterPictureInPictureOnLeave(WebContents* web_contents);
+
+// The natural size of the first playing video, for the window's aspect ratio.
+CONTENT_EXPORT std::optional<gfx::Size> GetPlayingVideoSize(
+    WebContents* web_contents);
+
+// Makes the first playing video the fullscreen element. Browser-initiated:
+// the fullscreen request this causes in the player's frame needs no user
+// activation (one request, before the renderer answers; nothing else is
+// waived). Returns whether it was requested (the renderer enters fullscreen
+// asynchronously).
+CONTENT_EXPORT bool RequestFullscreenForPictureInPicture(
+    WebContents* web_contents);
+
+}  // namespace tark_media
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
