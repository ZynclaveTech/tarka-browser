+
+#ifndef CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
+#define CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+namespace tark_media {
+
+// Tark for Android: Picture in Picture on leave. When the user leaves Tark
+// while the current tab plays a video with sound, Tark floats that video in
+// video Picture in Picture (the window requestPictureInPicture() opens),
+// inline or fullscreen, before the tab is hidden.
+
+// Whether `web_contents` plays sound and a video now (or one of its videos is
+// already in Picture in Picture). A muted video doesn't count.
+CONTENT_EXPORT bool CanEnterPictureInPictureOnLeave(WebContents* web_contents);
+
+// Floats the first playing video of `web_contents`. It's a browser-initiated
+// request: no page enterpictureinpicture handler, any number of players, and
+// a page's disablePictureInPicture doesn't stop it. Returns whether it was
+// requested (Blink opens the window asynchronously), or true if a video is
+// already in Picture in Picture.
+CONTENT_EXPORT bool EnterPictureInPictureOnLeave(WebContents* web_contents);
+
+}  // namespace tark_media
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_TARK_PICTURE_IN_PICTURE_H_
