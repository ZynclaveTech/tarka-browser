+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import static org.junit.Assert.assertEquals;
+
+import android.content.SharedPreferences;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.tark.media.TarkLeaveDecision.LeaveAction;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/** What leaving Tark does to the current tab's media. */
+@RunWith(BaseRobolectricTestRunner.class)
+public class TarkLeaveDecisionTest {
+    private SharedPreferences mPrefs;
+
+    @Before
+    public void setUp() {
+        mPrefs = ContextUtils.getAppSharedPreferences();
+        mPrefs.edit().clear().commit();
+    }
+
+    @Test
+    public void testPlayingWithSoundPipOn() {
+        assertEquals(LeaveAction.PIP, TarkLeaveDecision.decide(true, true, true));
+        // Picture in Picture alone is enough: the window keeps the page playing.
+        assertEquals(LeaveAction.PIP, TarkLeaveDecision.decide(true, false, true));
+    }
+
+    @Test
+    public void testPipOffBackgroundOn() {
+        assertEquals(LeaveAction.SOUND_ONLY, TarkLeaveDecision.decide(true, true, false));
+    }
+
+    @Test
+    public void testBothOff() {
+        assertEquals(LeaveAction.NONE, TarkLeaveDecision.decide(true, false, false));
+    }
+
+    @Test
+    public void testMutedAutoplayNeverFloats() {
+        // A muted video that plays isn't "playing with sound" (the native side asks
+        // WebContents::IsCurrentlyAudible()): nothing floats, nothing plays on.
+        assertEquals(LeaveAction.NONE, TarkLeaveDecision.decide(false, true, true));
+    }
+
+    @Test
+    public void testOnlyCurrentTabCounts() {
+        // The current tab is paused while a background tab plays: the caller passes the
+        // current tab's state only, so nothing floats.
+        boolean currentTabPlayingWithSound = false;
+        assertEquals(
+                LeaveAction.NONE, TarkLeaveDecision.decide(currentTabPlayingWithSound, true, true));
+    }
+
+    @Test
+    public void testIncognitoFloatsNothingStored() {
+        // An incognito tab playing with sound floats like any other, and deciding writes
+        // nothing: the prefs file is the same before and after.
+        TarkMediaPrefs.setBackgroundPlay(true);
