+TEST(TarkVisibilityHoldTest, PausedInPictureInPictureStaysHeld) {
+  // Paused from the Picture in Picture window: YouTube keeps its player (it
+  // tears it down on "hidden"), and play resumes from the window.
+  FakeTab tab({.background_play = false, .picture_in_picture = true});
+  tab.Show();
+  tab.Play();
+  tab.EnterPictureInPicture();
+  tab.Hide();
+  tab.Pause();
+  EXPECT_EQ("visible", tab.visibility_state());
+  tab.Hide();  // A later update (the window moved, occlusion) while paused.
+  EXPECT_EQ("visible", tab.visibility_state());
+  tab.Play();
+  EXPECT_EQ("visible", tab.visibility_state());
+  EXPECT_FALSE(tab.video_paused());
+  EXPECT_EQ(std::vector<std::string>{"visible"}, tab.events());
+}
+
+TEST(TarkVisibilityHoldTest, PictureInPictureClosedWhilePausedReleases) {
+  FakeTab tab;
+  tab.Show();
+  tab.Play();
+  tab.EnterPictureInPicture();
+  tab.Hide();
+  tab.Pause();
+  ASSERT_EQ("visible", tab.visibility_state());
+  tab.LeavePictureInPicture();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  // Exactly one visibilitychange, to hidden.
+  EXPECT_EQ((std::vector<std::string>{"visible", "hidden"}), tab.events());
+  // Nothing re-holds it.
+  tab.Hide();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_EQ(1, tab.asked());
+}
+
+TEST(TarkVisibilityHoldTest, PictureInPictureCloseButtonReleases) {
+  // The window's close button: the window closes first, then the video is
+  // paused (the pause reaches the renderer asynchronously).
+  FakeTab tab({.background_play = false, .picture_in_picture = true});
+  tab.Show();
+  tab.Play();
+  tab.EnterPictureInPicture();
+  tab.Hide();
+  tab.LeavePictureInPicture();
+  EXPECT_EQ("visible", tab.visibility_state());  // Still playing.
+  tab.Pause();
+  EXPECT_EQ("hidden", tab.visibility_state());
+  EXPECT_EQ((std::vector<std::string>{"visible", "hidden"}), tab.events());
+}
