+std::optional<gfx::Size> WebContentsImpl::TarkPlayingVideoSize() const {
+  // Only video players are ever resized (MediaResized).
+  for (const MediaPlayerId& id : tark_playing_players_) {
+    if (auto it = cached_video_sizes_.find(id);
+        it != cached_video_sizes_.end() && !it->second.IsEmpty()) {
+      return it->second;
+    }
+  }
+  return std::nullopt;
+}
+
+bool WebContentsImpl::TarkRequestFullscreenForPictureInPicture() {
+  if (!media_web_contents_observer_) {
+    return false;
+  }
+  for (const MediaPlayerId& id : tark_playing_players_) {
+    auto it = cached_video_sizes_.find(id);
+    if (it == cached_video_sizes_.end() || it->second.IsEmpty() ||
+        !media_web_contents_observer_->IsMediaPlayerRemoteAvailable(id)) {
+      continue;
+    }
+    // The waiver is armed for this player's frame only, until the renderer
+    // replies (TarkFullscreenForPictureInPictureReplied).
+    tark_pip_fullscreen_waiver_ = {.frame = id.frame_routing_id,
+                                   .armed_at = base::TimeTicks::Now(),
+                                   .request = ++tark_pip_fullscreen_requests_};
+    media_web_contents_observer_->GetMediaPlayerRemote(id)
+        ->RequestTarkFullscreenForPictureInPicture(base::BindOnce(
+            &WebContentsImpl::TarkFullscreenForPictureInPictureReplied,
+            weak_factory_.GetWeakPtr(), tark_pip_fullscreen_requests_));
+    return true;
+  }
+  return false;
+}
+
+void WebContentsImpl::TarkFullscreenForPictureInPictureReplied(
+    uint64_t request) {
+  // The player's interface and LocalFrameHost share the frame's channel, so
+  // the frame's EnterFullscreen() for Tark's request arrived before this
+  // reply. Whatever came of it (entered, or Blink refused: an iframe without
+  // allowfullscreen), nothing else gets the waiver.
+  if (tark_pip_fullscreen_waiver_ &&
+      tark_pip_fullscreen_waiver_->request == request) {
+    tark_pip_fullscreen_waiver_.reset();
+  }
+}
+
+bool WebContentsImpl::TarkConsumePictureInPictureFullscreenWaiver(
+    RenderFrameHostImpl* requesting_frame) {
+  if (!tark_pip_fullscreen_waiver_ || !requesting_frame ||
+      requesting_frame->GetGlobalId() != tark_pip_fullscreen_waiver_->frame) {
+    return false;
+  }
+  static constexpr base::TimeDelta kMaxWait = base::Seconds(1);
+  const bool fresh =
+      base::TimeTicks::Now() - tark_pip_fullscreen_waiver_->armed_at <=
+      kMaxWait;
+  // Single use, fresh or not.
+  tark_pip_fullscreen_waiver_.reset();
+  return fresh;
+}
+
+namespace tark_media {
+
+bool CanEnterPictureInPictureOnLeave(WebContents* web_contents) {
+  // A video already in video Picture in Picture (the page's own request)
+  // floats on its own.
+  return web_contents && web_contents->IsCurrentlyAudible() &&
+         !web_contents->HasPictureInPictureVideo() &&
+         static_cast<WebContentsImpl*>(web_contents)
+             ->TarkPlayingVideoSize()
+             .has_value();
+}
+
+std::optional<gfx::Size> GetPlayingVideoSize(WebContents* web_contents) {
+  return web_contents ? static_cast<WebContentsImpl*>(web_contents)
+                            ->TarkPlayingVideoSize()
+                      : std::nullopt;
+}
+
+bool RequestFullscreenForPictureInPicture(WebContents* web_contents) {
+  return web_contents && static_cast<WebContentsImpl*>(web_contents)
+                             ->TarkRequestFullscreenForPictureInPicture();
+}
+
