+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.ActivityTabProvider;
+import org.chromium.chrome.browser.fullscreen.FullscreenManager;
+import org.chromium.chrome.browser.media.FullscreenVideoPictureInPictureController;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+
+/**
+ * The activity's auto-enter Picture in Picture (33+) follows whether leaving floats the current
+ * tab's video, whatever changed it: the page muting or unmuting (no player stops), Settings →
+ * Picture in Picture, or switching to another tab.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(sdk = Build.VERSION_CODES.TIRAMISU)
+public class TarkAutoPictureInPictureTest {
+    @Rule public MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private TarkPictureInPicture.Natives mNatives;
+    @Mock private LibraryLoader mLibraryLoader;
+    @Mock private Activity mActivity;
+    @Mock private FullscreenManager mFullscreenManager;
+    @Mock private PowerManager mPowerManager;
+    @Mock private Tab mTab;
+
+    private final UserDataHost mUserDataHost = new UserDataHost();
+    private final ActivityTabProvider mTabProvider = new ActivityTabProvider();
+    private WebContents mWebContents;
+    private FullscreenVideoPictureInPictureController mController;
+
+    @Before
+    public void setUp() {
+        Context context = ContextUtils.getApplicationContext();
+        ContextUtils.getAppSharedPreferences().edit().clear().commit();
+        shadowOf(context.getPackageManager())
+                .setSystemFeature(PackageManager.FEATURE_PICTURE_IN_PICTURE, true);
+
+        TarkPictureInPictureJni.setInstanceForTesting(mNatives);
+        LibraryLoader.setLibraryLoaderForTesting(mLibraryLoader);
+        when(mLibraryLoader.isInitialized()).thenReturn(true);
+        when(mNatives.getPlayingVideoSize(any())).thenReturn(new int[] {1920, 1080});
+
+        when(mActivity.getSystemService(Context.ACTIVITY_SERVICE))
+                .thenReturn((ActivityManager) context.getSystemService(Context.ACTIVITY_SERVICE));
+        when(mActivity.getSystemService(Context.POWER_SERVICE)).thenReturn(mPowerManager);
+        when(mActivity.getPackageManager()).thenReturn(context.getPackageManager());
+        when(mPowerManager.isInteractive()).thenReturn(true);
+
+        mWebContents = newWebContents();
+        when(mTab.getWebContents()).thenReturn(mWebContents);
+        when(mTab.getUserDataHost()).thenReturn(mUserDataHost);
+        mTabProvider.setForTesting(mTab);
+
+        mController =
+                new FullscreenVideoPictureInPictureController(
+                        mActivity, mTabProvider, mFullscreenManager);
+        idle();
+    }
+
+    @After
+    public void tearDown() {
+        mController.onDestroy();
+    }
+
+    private static WebContents newWebContents() {
+        return mock(
+                WebContents.class,
+                withSettings().extraInterfaces(WebContentsObserver.Observable.class));
+    }
+
+    private void setPlayingWithSound(WebContents webContents, boolean playing) {
+        when(mNatives.isPlayingVideoWithSound(webContents)).thenReturn(playing);
+    }
+
+    private static void idle() {
+        shadowOf(Looper.getMainLooper()).idle();
+    }
+
+    /** The params last given to the framework. */
+    private PictureInPictureParams lastParams() {
+        ArgumentCaptor<PictureInPictureParams> captor =
+                ArgumentCaptor.forClass(PictureInPictureParams.class);
+        verify(mActivity, atLeastOnce()).setPictureInPictureParams(captor.capture());
+        return captor.getValue();
+    }
+
+    /** The page's sound started, or it muted or unmuted itself (TarkOfferWatcher). */
+    private void audibleChanged(WebContents webContents) {
+        TarkPictureInPicture.onOfferMayHaveChanged(webContents);
+    }
+
+    @Test
+    public void testWatchesTheCurrentTab() {
+        verify(mNatives).watch(mWebContents);
+    }
+
+    @Test
+    public void testPlayingWithSoundAutoEntersInTheVideosShape() {
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        PictureInPictureParams params = lastParams();
+        assertTrue(params.isAutoEnterEnabled());
+        assertEquals(new Rational(1778, 1000), params.getAspectRatio());
+    }
+
+    @Test
+    public void testExtremeVideoShapeIsClamped() {
+        when(mNatives.getPlayingVideoSize(any())).thenReturn(new int[] {4000, 1000});
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertEquals(new Rational(2390, 1000), lastParams().getAspectRatio());
+    }
+
+    @Test
+    public void testMutedTurnsAutoEnterOffAndUnmutedOn() {
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertTrue(lastParams().isAutoEnterEnabled());
+
+        // The page mutes its video: it keeps playing (no player stops), only the sound ends.
+        setPlayingWithSound(mWebContents, false);
+        audibleChanged(mWebContents);
+        assertFalse(lastParams().isAutoEnterEnabled());
+
+        // Unmuted again.
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertTrue(lastParams().isAutoEnterEnabled());
+    }
+
+    @Test
+    public void testSettingOffTurnsAutoEnterOff() {
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertTrue(lastParams().isAutoEnterEnabled());
+
+        TarkMediaPrefs.setPictureInPicture(false);
+        idle();
+        assertFalse(lastParams().isAutoEnterEnabled());
+
+        // Off means none at all: not even upstream's fullscreen video that allows it.
+        when(mWebContents.hasActiveEffectivelyFullscreenVideo()).thenReturn(true);
+        when(mWebContents.isPictureInPictureAllowedForFullscreenVideo()).thenReturn(true);
+        audibleChanged(mWebContents);
+        assertFalse(lastParams().isAutoEnterEnabled());
+
+        TarkMediaPrefs.setPictureInPicture(true);
+        idle();
+        assertTrue(lastParams().isAutoEnterEnabled());
+    }
+
+    @Test
+    public void testAnotherTabTurnsAutoEnterOff() {
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertTrue(lastParams().isAutoEnterEnabled());
+
+        // Switched to a tab that plays nothing; the first tab still plays with sound.
+        Tab other = mock(Tab.class);
+        WebContents otherContents = newWebContents();
+        when(other.getWebContents()).thenReturn(otherContents);
+        when(other.getUserDataHost()).thenReturn(new UserDataHost());
+        setPlayingWithSound(otherContents, false);
+        mTabProvider.setForTesting(other);
+        idle();
+        assertFalse(lastParams().isAutoEnterEnabled());
+        verify(mNatives).watch(otherContents);
+
+        // The first tab's sound changing doesn't count any more.
+        audibleChanged(mWebContents);
+        assertFalse(lastParams().isAutoEnterEnabled());
+    }
+
+    @Test
+    public void testMutedFullscreenVideoDoesNotAutoEnter() {
+        // Upstream would float any fullscreen video that allows it; Tark only one with sound.
+        when(mWebContents.hasActiveEffectivelyFullscreenVideo()).thenReturn(true);
+        when(mWebContents.isPictureInPictureAllowedForFullscreenVideo()).thenReturn(true);
+        setPlayingWithSound(mWebContents, false);
+        audibleChanged(mWebContents);
+        assertFalse(lastParams().isAutoEnterEnabled());
+
+        setPlayingWithSound(mWebContents, true);
+        audibleChanged(mWebContents);
+        assertTrue(lastParams().isAutoEnterEnabled());
+    }
+}
