@@ -0,0 +1,39 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * What leaving Tark does to the current tab's media: float its video in Picture in Picture, keep
+ * only its sound going (Background play, the visibility hold), or nothing (upstream: the page is
+ * hidden and its video pauses). Only the current tab counts, and only while it plays with sound: a
+ * muted video, or another tab's, never floats. Incognito tabs are treated the same; nothing is
+ * stored.
+ */
+@NullMarked
+public final class TarkLeaveDecision {
+    /** The outcome of leaving Tark. */
+    public enum LeaveAction {
+        PIP,
+        SOUND_ONLY,
+        NONE
+    }
+
+    private TarkLeaveDecision() {}
+
+    /**
+     * @param currentTabPlayingWithSound The current tab plays a video with sound now.
+     * @param backgroundPlay Settings → Background play.
+     * @param pip Settings → Picture in Picture.
+     */
+    public static LeaveAction decide(
+            boolean currentTabPlayingWithSound, boolean backgroundPlay, boolean pip) {
+        if (!currentTabPlayingWithSound) return LeaveAction.NONE;
+        if (pip) return LeaveAction.PIP;
+        if (backgroundPlay) return LeaveAction.SOUND_ONLY;
+        return LeaveAction.NONE;
+    }
+}
diff --color -ruN a/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkPictureInPicture.java b/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkPictureInPicture.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkPictureInPicture.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/android/java/src/org/chromium/chrome/browser/tark/media/TarkPictureInPicture.java	2026-10-29 22:47:18.412895473 +0530
@@ -0,0 +1,203 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.media;
+
+import android.content.SharedPreferences;
+import android.graphics.Rect;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ObserverList;
+import org.chromium.base.ResettersForTesting;
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.preferences.ChromePreferenceKeys;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tark.media.TarkLeaveDecision.LeaveAction;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import java.util.WeakHashMap;
+
+/**
+ * Picture in Picture on leave. When the user leaves Tark while the current tab plays a video with
+ * sound and Settings → Picture in Picture is on, the browser activity enters Android's Picture in
+ * Picture (FullscreenVideoPictureInPictureController: auto-enter on 33+, onUserLeaveHint on every
+ * level), inline video included, whatever the page's disablePictureInPicture says (the attribute
+ * is about video Picture in Picture; this is the activity's). As it enters, Tark makes the video
+ * the fullscreen element (browser-initiated), so the window shows only the video, and leaves
+ * fullscreen again when the window ends.
+ *
+ * <p>Whether leaving floats a tab's video changes without a player starting or stopping: the page
+ * mutes or unmutes, its sound starts a little after the player, the video gets its size, or a
+ * setting changes. {@link #addOfferObserver} hears about all of them, for the tabs passed to
+ * {@link #watch}; the auto-enter params and the Picture in Picture button both follow it.
+ */
+@NullMarked
+public final class TarkPictureInPicture {
+    private static final ObserverList<Callback<@Nullable WebContents>> sOfferObservers =
+            new ObserverList<>();
+
+    // SharedPreferences holds its listeners weakly: this one lives while there are observers.
+    private static final SharedPreferences.OnSharedPreferenceChangeListener sPrefListener =
+            (prefs, key) -> {
+                if (ChromePreferenceKeys.TARK_MEDIA_PICTURE_IN_PICTURE.equals(key)
+                        || ChromePreferenceKeys.TARK_MEDIA_BACKGROUND_PLAY.equals(key)) {
+                    notifyOfferObservers(null);
+                }
+            };
+
+    // The tabs whose video Tark made fullscreen for a Picture in Picture window that hasn't ended.
+    // Static, so a ChromeActivity recreated while in the window (a theme or locale change) still
+    // ends that fullscreen when the window ends.
+    private static final Set<WebContents> sMadeFullscreen =
+            Collections.newSetFromMap(new WeakHashMap<>());
+
+    private static @Nullable Boolean sPlayingVideoWithSoundForTesting;
+
+    private TarkPictureInPicture() {}
+
+    /** Whether leaving Tark now floats this tab's video. */
+    public static boolean canOffer(@Nullable Tab tab) {
+        return canOffer(tab != null ? tab.getWebContents() : null);
+    }
+
+    /** {@link #canOffer(Tab)} for a tab's WebContents. */
+    public static boolean canOffer(@Nullable WebContents webContents) {
+        return decide(webContents) == LeaveAction.PIP;
+    }
+
+    /**
+     * Tark's part of entering Picture in Picture: makes the tab's playing video the fullscreen
+     * element, if {@link #canOffer(Tab)}. Returns whether it was requested (the page enters
+     * fullscreen asynchronously); if so, {@link #exitFullscreenItMade} ends it.
+     */
+    public static boolean enter(@Nullable Tab tab) {
+        WebContents webContents = tab != null ? tab.getWebContents() : null;
+        if (webContents == null || !canOffer(webContents)) return false;
+        if (!TarkPictureInPictureJni.get().requestFullscreen(webContents)) return false;
+        sMadeFullscreen.add(webContents);
+        return true;
+    }
+
+    /** Whether a fullscreen Tark made for a Picture in Picture window is still to be ended. */
+    public static boolean hasFullscreenItMade() {
+        return !sMadeFullscreen.isEmpty();
+    }
+
+    /** Ends every fullscreen Tark made for Picture in Picture (the window ended). */
+    public static void exitFullscreenItMade() {
+        List<WebContents> made = new ArrayList<>(sMadeFullscreen);
+        sMadeFullscreen.clear();
+        for (WebContents webContents : made) {
+            if (!webContents.isDestroyed()) webContents.exitFullscreen();
+        }
+    }
+
+    /** The playing video's natural size as a Rect at 0,0, for the window's aspect ratio. */
+    public static @Nullable Rect playingVideoSize(@Nullable WebContents webContents) {
+        if (webContents == null || !isUsable(webContents)) return null;
+        int[] size = TarkPictureInPictureJni.get().getPlayingVideoSize(webContents);
+        if (size.length != 2 || size[0] <= 0 || size[1] <= 0) return null;
+        return new Rect(0, 0, size[0], size[1]);
+    }
+
+    /** What leaving Tark does to this tab's media, by the settings. */
+    public static LeaveAction decide(@Nullable WebContents webContents) {
+        Boolean playingForTesting = sPlayingVideoWithSoundForTesting;
+        boolean playingWithSound =
+                webContents != null
+                        && (playingForTesting != null
+                                ? playingForTesting.booleanValue()
+                                : isUsable(webContents)
+                                        && TarkPictureInPictureJni.get()
+                                                .isPlayingVideoWithSound(webContents));
+        return TarkLeaveDecision.decide(
+                playingWithSound,
+                TarkMediaPrefs.backgroundPlay(),
+                TarkMediaPrefs.pictureInPicture());
+    }
+
+    /**
+     * Whether the activity may enter Picture in Picture for the current tab (auto-enter, leaving):
+     * only when leaving floats the tab's video ({@link #canOffer}: Settings → Picture in Picture on
+     * and a video playing with sound), inline or fullscreen. Replaces upstream's rule (any
+     * fullscreen video that allows it): a muted or silent video never floats, fullscreen or not.
+     *
+     * @param webContents The current tab's.
+     */
+    public static boolean allowsPictureInPicture(@Nullable WebContents webContents) {
+        return canOffer(webContents);
+    }
+
+    /**
+     * Hear about {@code webContents}'s audibility and video size changing (see {@link
+     * #addOfferObserver}). Idempotent; lasts as long as the WebContents.
+     */
+    public static void watch(@Nullable WebContents webContents) {
+        if (webContents == null || !isUsable(webContents)) return;
+        TarkPictureInPictureJni.get().watch(webContents);
+    }
+
+    /**
+     * Adds an observer told when {@link #canOffer} may have changed without a player starting or
+     * stopping: with the WebContents (one passed to {@link #watch}), or null when a setting
+     * changed (every tab).
+     */
+    public static void addOfferObserver(Callback<@Nullable WebContents> observer) {
+        // Registering again is a no-op (and covers a new preferences instance in tests).
+        ContextUtils.getAppSharedPreferences()
+                .registerOnSharedPreferenceChangeListener(sPrefListener);
+        sOfferObservers.addObserver(observer);
+    }
+
+    public static void removeOfferObserver(Callback<@Nullable WebContents> observer) {
+        if (!sOfferObservers.removeObserver(observer) || !sOfferObservers.isEmpty()) return;
+        ContextUtils.getAppSharedPreferences()
+                .unregisterOnSharedPreferenceChangeListener(sPrefListener);
+    }
+
+    /** From native (TarkOfferWatcher): the tab turned audible or silent, or a video resized. */
+    @CalledByNative
+    public static void onOfferMayHaveChanged(WebContents webContents) {
+        notifyOfferObservers(webContents);
+    }
+
+    private static void notifyOfferObservers(@Nullable WebContents webContents) {
+        for (Callback<@Nullable WebContents> observer : sOfferObservers) {
+            observer.onResult(webContents);
+        }
+    }
+
+    private static boolean isUsable(WebContents webContents) {
+        return LibraryLoader.getInstance().isInitialized() && !webContents.isDestroyed();
+    }
+
+    /** Tests outside this package: whether every tab plays a video with sound (null: ask). */
+    public static void setPlayingVideoWithSoundForTesting(@Nullable Boolean playing) {
+        sPlayingVideoWithSoundForTesting = playing;
+        ResettersForTesting.register(() -> sPlayingVideoWithSoundForTesting = null);
+    }
+
+    @NativeMethods
+    interface Natives {
+        boolean isPlayingVideoWithSound(WebContents webContents);
+
+        @JniType("std::vector<int32_t>")
+        int[] getPlayingVideoSize(WebContents webContents);
+
+        boolean requestFullscreen(WebContents webContents);
+
+        void watch(WebContents webContents);
+    }
+}
