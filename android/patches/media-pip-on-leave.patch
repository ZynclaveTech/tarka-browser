 }
 
+bool MediaSessionImpl::TarkPlayingVideo(bool float_it) {
+  for (const auto& player : normal_players_) {
+    const PlayerIdentifier& id = player.first;
+    if (!id.observer->HasVideo(id.player_id) ||
+        id.observer->IsPaused(id.player_id)) {
+      continue;
+    }
+    if (float_it) {
+      // No details: a browser-initiated request, which Blink lets through a
+      // page's disablePictureInPicture (Tark,
+      // picture_in_picture_controller_impl.cc).
+      id.observer->OnEnterPictureInPicture(id.player_id, std::nullopt);
+    }
+    return true;
+  }
+  return false;
+}
+
+namespace tark_media {
+
+bool CanEnterPictureInPictureOnLeave(WebContents* web_contents) {
+  if (!web_contents || !web_contents->IsCurrentlyAudible()) {
+    return false;
+  }
+  if (web_contents->HasPictureInPictureVideo()) {
+    return true;
+  }
+  MediaSessionImpl* session = MediaSessionImpl::FromWebContents(web_contents);
+  return session && session->TarkPlayingVideo(/*float_it=*/false);
+}
+
+bool EnterPictureInPictureOnLeave(WebContents* web_contents) {
+  if (!CanEnterPictureInPictureOnLeave(web_contents)) {
+    return false;
+  }
+  if (web_contents->HasPictureInPictureVideo()) {
+    return true;
+  }
+  return MediaSessionImpl::FromWebContents(web_contents)
+      ->TarkPlayingVideo(/*float_it=*/true);
+}
+
+}  // namespace tark_media
+
 void MediaSessionImpl::ExitPictureInPicture() {
   static_cast<WebContentsImpl*>(web_contents())->ExitPictureInPicture();
 }
