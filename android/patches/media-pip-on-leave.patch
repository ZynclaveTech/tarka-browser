+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.ui;
+
+import org.junit.Assert;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.Mockito;
+import org.mockito.junit.MockitoJUnit;
+import org.mockito.junit.MockitoRule;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+
+/**
+ * Tark: the fullscreen notice ("To exit full screen, press |Esc|") isn't shown in Picture in
+ * Picture, and shows again on leaving it while the page is still fullscreen.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+public class TarkExclusiveAccessPipTest {
+    @Rule public MockitoRule mMockitoRule = MockitoJUnit.rule();
+
+    @Mock private ExclusiveAccessContext mContext;
+    @Mock private SnackbarManager mSnackbarManager;
+
+    @Before
+    public void setUp() {
+        Mockito.when(mContext.getSnackbarManager()).thenReturn(mSnackbarManager);
+    }
+
+    private void setInPictureInPicture(boolean inPicture) {
+        Mockito.when(mContext.isInPictureInPictureMode()).thenReturn(inPicture);
+    }
+
+    @Test
+    public void testEnterPipWhileFullscreenThenLeaveShowsNoticeAgain() {
+        ExclusiveAccessBubble bubble = ExclusiveAccessBubble.create(mContext);
+        bubble.update("To exit full screen, press |Esc|");
+        Assert.assertTrue(bubble.isVisible());
+        Mockito.verify(mSnackbarManager, Mockito.times(1)).showSnackbar(Mockito.any(Snackbar.class));
+
+        // Enter Picture in Picture, still fullscreen: no notice in the window.
+        setInPictureInPicture(true);
+        bubble.onPictureInPictureModeChanged(true);
+        Assert.assertFalse(bubble.isVisible());
+        Mockito.verify(mSnackbarManager, Mockito.times(1)).dismissSnackbars(Mockito.any());
+        // Native asking again (a forced update) shows nothing in Picture in Picture.
+        bubble.show();
+        Assert.assertFalse(bubble.isVisible());
+        Mockito.verify(mSnackbarManager, Mockito.times(1)).showSnackbar(Mockito.any(Snackbar.class));
+
+        // Leave Picture in Picture, still fullscreen: the notice shows again.
+        setInPictureInPicture(false);
+        bubble.onPictureInPictureModeChanged(false);
+        Assert.assertTrue(bubble.isVisible());
+        Mockito.verify(mSnackbarManager, Mockito.times(2)).showSnackbar(Mockito.any(Snackbar.class));
+    }
+
+    @Test
+    public void testNoticeFirstAskedInPipShowsOnLeaving() {
+        setInPictureInPicture(true);
+        ExclusiveAccessBubble bubble = ExclusiveAccessBubble.create(mContext);
+        bubble.update("To exit full screen, press |Esc|");
+        Assert.assertFalse(bubble.isVisible());
+        setInPictureInPicture(false);
+        bubble.onPictureInPictureModeChanged(false);
+        Assert.assertTrue(bubble.isVisible());
+    }
+
+    @Test
+    public void testFullscreenEndedInPipShowsNothingOnLeaving() {
+        ExclusiveAccessBubble bubble = ExclusiveAccessBubble.create(mContext);
+        bubble.update("To exit full screen, press |Esc|");
+        setInPictureInPicture(true);
+        bubble.onPictureInPictureModeChanged(true);
+        // Fullscreen ends (video Picture in Picture exits it): native hides the notice.
+        bubble.hide();
+        setInPictureInPicture(false);
+        bubble.onPictureInPictureModeChanged(false);
+        Assert.assertFalse(bubble.isVisible());
+        Mockito.verify(mSnackbarManager, Mockito.times(1)).showSnackbar(Mockito.any(Snackbar.class));
+    }
+}
