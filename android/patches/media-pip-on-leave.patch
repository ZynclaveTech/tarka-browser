+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android: Picture in Picture on leave. TarkPictureInPicture.java's
+// natives: whether the current tab plays a video with sound, its size, making
+// it the fullscreen element for the Picture in Picture window, and telling
+// Java when the first of these may have changed.
+
+#include <optional>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_array.h"
+#include "base/android/jni_string.h"
+#include "content/public/browser/media_player_id.h"
+#include "content/public/browser/tark_picture_in_picture.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/gfx/geometry/size.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/TarkPictureInPicture_jni.h"
+
+using base::android::JavaRef;
+
+namespace {
+
+// Tells TarkPictureInPicture.java when whether its WebContents plays a video
+// with sound may have changed: it turned audible or silent (the page muted or
+// unmuted, or its sound started a little after the player), or a video got
+// its size. Players starting and stopping have their own Java signal.
+class TarkOfferWatcher : public content::WebContentsObserver,
+                         public content::WebContentsUserData<TarkOfferWatcher> {
+ public:
+  TarkOfferWatcher(const TarkOfferWatcher&) = delete;
+  TarkOfferWatcher& operator=(const TarkOfferWatcher&) = delete;
+  ~TarkOfferWatcher() override = default;
+
+  // content::WebContentsObserver:
+  void OnAudioStateChanged(bool audible) override { Notify(); }
+  void MediaResized(const gfx::Size& size,
+                    const content::MediaPlayerId& id) override {
+    Notify();
+  }
+
+ private:
+  friend class content::WebContentsUserData<TarkOfferWatcher>;
+
+  explicit TarkOfferWatcher(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<TarkOfferWatcher>(*web_contents) {}
+
+  void Notify() {
+    JNIEnv* env = base::android::AttachCurrentThread();
+    Java_TarkPictureInPicture_onOfferMayHaveChanged(
+        env, web_contents()->GetJavaWebContents());
+  }
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TarkOfferWatcher);
+
+}  // namespace
+
+static bool JNI_TarkPictureInPicture_IsPlayingVideoWithSound(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  return content::tark_media::CanEnterPictureInPictureOnLeave(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+}
+
+// {width, height}, or empty when no video plays.
+static std::vector<int32_t> JNI_TarkPictureInPicture_GetPlayingVideoSize(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  std::optional<gfx::Size> size = content::tark_media::GetPlayingVideoSize(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+  if (!size) {
+    return {};
+  }
+  return {size->width(), size->height()};
+}
+
+static bool JNI_TarkPictureInPicture_RequestFullscreen(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  return content::tark_media::RequestFullscreenForPictureInPicture(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+}
+
+// Idempotent: one watcher per WebContents, for its lifetime.
+static void JNI_TarkPictureInPicture_Watch(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (web_contents) {
+    TarkOfferWatcher::CreateForWebContents(web_contents);
+  }
+}
+
+DEFINE_JNI(TarkPictureInPicture)
