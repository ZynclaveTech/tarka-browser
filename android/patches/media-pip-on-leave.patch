+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark for Android: Picture in Picture on leave. TarkPictureInPicture.java's
+// natives: whether the current tab plays a video with sound, its size, and
+// making it the fullscreen element for the Picture in Picture window.
+
+#include <optional>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "content/public/browser/tark_picture_in_picture.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/geometry/size.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/TarkPictureInPicture_jni.h"
+
+using base::android::JavaRef;
+
+static bool JNI_TarkPictureInPicture_IsPlayingVideoWithSound(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  return content::tark_media::CanEnterPictureInPictureOnLeave(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+}
+
+// {width, height}, or empty when no video plays.
+static std::vector<int32_t> JNI_TarkPictureInPicture_GetPlayingVideoSize(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  std::optional<gfx::Size> size = content::tark_media::GetPlayingVideoSize(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+  if (!size) {
+    return {};
+  }
+  return {size->width(), size->height()};
+}
+
+static bool JNI_TarkPictureInPicture_RequestFullscreen(
+    JNIEnv* env,
+    const JavaRef<jobject>& jweb_contents) {
+  return content::tark_media::RequestFullscreenForPictureInPicture(
+      content::WebContents::FromJavaWebContents(jweb_contents));
+}
+
+DEFINE_JNI(TarkPictureInPicture)
