+TEST(CaptionStyleTest, PrefWins) {
+  EXPECT_EQ(StyleForDevice(2200000, 7600, /*pref=*/1), Style::kWordByWord);
+  EXPECT_EQ(StyleForDevice(3300000, 11500, /*pref=*/2), Style::kPhrase);
+}
