+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/model_files.h"
+
+#include <deque>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+// sha256("abc") and sha256("vad").
+constexpr char kAbc[] = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+constexpr char kVad[] = "651bfad0aa5b42c5a5b8dad76f49c4a122fe1d1658fc55cfdd1ea9923fe3fd9e";
+
+constexpr CaptionFile kTable[] = {
+    {"common", "silero_vad.onnx", 3, kVad},
+    {"hi", "encoder.int8.onnx", 3, kAbc},
+    {"hi", "vocab.json", 3, kAbc},
+    {"ta", "vocab.json", 3, kAbc},
+};
+
+TEST(TarkCaptionFilesTest, UnitNeedsCommon) {
+  EXPECT_EQ(UnitsToFetch("hi"), (std::vector<std::string>{"common", "hi"}));
+  EXPECT_EQ(UnitsToFetch("common"), (std::vector<std::string>{"common"}));
+  // The APK's own table has the Phase 1 units.
+  for (const char* unit : {"common", "hi", "ta", "en", "es"}) {
+    EXPECT_FALSE(FilesOf(unit).empty()) << unit;
+  }
+}
+
+TEST(TarkCaptionFilesTest, MismatchDeletesFile) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("vocab.json");
+  ASSERT_TRUE(base::WriteFile(path, "abd"));  // right size, wrong bytes
+  EXPECT_FALSE(VerifyFile(path, kTable[2]));
+  EXPECT_FALSE(base::PathExists(path));
+  ASSERT_TRUE(base::WriteFile(path, "abc"));
+  EXPECT_TRUE(VerifyFile(path, kTable[2]));
+  EXPECT_TRUE(base::PathExists(path));
+}
+
+TEST(TarkCaptionFilesTest, PartFilesRemovedAtStart) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII(PartFileName("vocab.json", 3)), "ab"));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("vocab.json"), "abc"));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("old-model.onnx"), "x"));
+  EXPECT_EQ(ScanUnit(dir.GetPath(), "hi", kTable), (std::vector<std::string>{"vocab.json"}));
+  EXPECT_FALSE(base::PathExists(dir.GetPath().AppendASCII(PartFileName("vocab.json", 3))));
+  // A file the table does not name (an older APK's) goes too.
+  EXPECT_FALSE(base::PathExists(dir.GetPath().AppendASCII("old-model.onnx")));
+}
+
+TEST(TarkCaptionFilesTest, ReadyNeedsEveryFileOfTheUnit) {
+  EXPECT_FALSE(UnitReady("hi", {"vocab.json"}, kTable));
+  EXPECT_TRUE(UnitReady("hi", {"encoder.int8.onnx", "vocab.json"}, kTable));
+  EXPECT_FALSE(UnitReady("bn", {}, kTable));  // not in the table: never ready
+}
+
+TEST(TarkCaptionFilesTest, RemoveInUseUnitWaitsForRelease) {
+  UnitUse use;
+  use.SetInUse("hi", true);
+  EXPECT_FALSE(use.RequestRemove("hi"));  // captioning: removed when released
+  EXPECT_TRUE(use.RequestRemove("ta"));   // not in use: now
+  EXPECT_TRUE(use.SetInUse("hi", false)); // released: the pending removal is due
+  EXPECT_FALSE(use.SetInUse("hi", false));
+}
+
+// Deleted in Settings while captioning: the language stops counting as
+// ready at once (captions go off, Settings drops the row), and the files go
+// when the captions process lets them go.
+TEST(TarkCaptionFilesTest, PendingRemovalIsNotReady) {
+  UnitUse use;
+  use.SetInUse("hi", true);
+  EXPECT_FALSE(use.Removing("hi"));
+  EXPECT_FALSE(use.RequestRemove("hi"));
+  EXPECT_TRUE(use.Removing("hi"));
+  EXPECT_FALSE(use.Removing("ta"));
+  EXPECT_TRUE(use.SetInUse("hi", false));
+  EXPECT_FALSE(use.Removing("hi"));  // removed: a new download may start
+}
+
+// On mobile data: Hindi waits for Wi-Fi; English, with "Download now",
+// starts although it was queued after Hindi.
+TEST(TarkCaptionFilesTest, QueueSkipsAUnitWaitingForWifi) {
+  const std::deque<std::string> queue = {"hi", "en"};
+  auto allowed = [](const std::string& unit) { return unit == "en"; };
+  EXPECT_EQ(NextToFetch(queue, allowed), "en");
+  EXPECT_EQ(NextToFetch(queue, [](const std::string&) { return true; }), "hi");
+  EXPECT_EQ(NextToFetch(queue, [](const std::string&) { return false; }), std::nullopt);
+}
+
+// Translate (Phase 2a): the translation models a caption passes through,
+// each a download of its own; Indian and Spanish into an Indian language go
+// through English.
+TEST(TarkCaptionFilesTest, TranslationUnitsPivot) {
+  using V = std::vector<std::string>;
+  EXPECT_EQ(TranslationUnitsFor("ta", "hi"), (V{"tr_indic_en", "tr_en_indic"}));
+  EXPECT_EQ(TranslationUnitsFor("hi", "en"), (V{"tr_indic_en"}));
+  EXPECT_EQ(TranslationUnitsFor("en", "hi"), (V{"tr_en_indic"}));
+  EXPECT_EQ(TranslationUnitsFor("en", "ta"), (V{"tr_en_indic"}));
+  EXPECT_EQ(TranslationUnitsFor("es", "en"), (V{"tr_es_en"}));
+  EXPECT_EQ(TranslationUnitsFor("es", "ta"), (V{"tr_es_en", "tr_en_indic"}));
+  EXPECT_TRUE(TranslationUnitsFor("hi", "hi").empty());
+  EXPECT_TRUE(TranslationUnitsFor("en", "en").empty());
+  EXPECT_TRUE(TranslationUnitsFor("hi", "").empty());  // Translate off
+  EXPECT_TRUE(TranslationUnitsFor("hi", "fr").empty());  // not a target
+}
+
+// A translation model needs no voice detector: nothing else is fetched.
+TEST(TarkCaptionFilesTest, TranslationUnitsNeedNoCommon) {
+  EXPECT_EQ(UnitsToFetch("tr_es_en"), (std::vector<std::string>{"tr_es_en"}));
+  EXPECT_EQ(UnitsToFetch("hi"), (std::vector<std::string>{"common", "hi"}));
+}
+
+// A translation model deleted in Settings, or cancelled by another tab: the
+// card asks for it again (never stuck without a button); not while its
+// removal waits, and not when it is here or already coming.
+TEST(TarkCaptionFilesTest, TranslationUnitsToRequestAgain) {
+  const std::vector<std::string> units = {"tr_indic_en", "tr_en_indic"};
+  auto missing = [](const std::string& unit) { return unit == "tr_en_indic"; };
+  auto none = [](const std::string&) { return false; };
+  EXPECT_EQ(UnitsToRequest(units, missing, none), (std::vector<std::string>{"tr_en_indic"}));
+  EXPECT_TRUE(UnitsToRequest(units, missing, missing).empty());  // removal waits
+  EXPECT_TRUE(UnitsToRequest(units, none, none).empty());
+}
+
+TEST(TarkCaptionFilesTest, UrlIsContentAddressed) {
+  // gettarka.com serves a path without an extension as a folder's
+  // index.html, so the files carry ".bin", as xlit's do.
+  EXPECT_EQ(FileUrl(kTable[1]),
+            std::string("https://gettarka.com/models/android/v1/") + kAbc + ".bin");
+}
+
+}  // namespace
+}  // namespace tark_captions
