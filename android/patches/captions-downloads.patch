+# found in the LICENSE file.
+#
+# Tark for Android's live captions: the model files' rules (table, check,
+# scan, use), with no browser dependencies, so that their unit tests also
+# build for the build machine (android/build.sh runs them).
+
+import("//testing/test.gni")
+
+static_library("files") {
+  sources = [
+    "model_files.cc",
+    "model_files.h",
+    "model_files.inc",
+  ]
+  deps = [
+    "//base",
+    "//crypto",
+  ]
+}
+
+if (!is_android) {
+  test("tark_captions_files_unittests") {
+    sources = [ "model_files_unittest.cc" ]
+    deps = [
+      ":files",
+      "//base",
+      "//base/test:run_all_unittests",
+      "//base/test:test_support",
+      "//testing/gtest",
+    ]
+  }
+}
+
+if (current_toolchain == default_toolchain) {
+  group("host_unittests") {
+    testonly = true
+    deps = [ ":tark_captions_files_unittests($host_toolchain)" ]
+  }
+}
