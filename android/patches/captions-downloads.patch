+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/model_files.h"
+
+#include <algorithm>
+#include <optional>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/strcat.h"
+#include "crypto/hash.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr CaptionFile kFiles[] = {
+#include "chrome/browser/tark_captions_android/model_files.inc"
+};
+
+constexpr char kCommon[] = "common";
+constexpr char kBaseUrl[] = "https://gettarka.com/models/android/v1/";
+constexpr char kRecordSuffix[] = ".sha256";
+constexpr char kPartSuffix[] = ".part";
+
+const CaptionFile* Find(base::span<const CaptionFile> table,
+                        std::string_view unit,
+                        std::string_view name) {
+  for (const CaptionFile& file : table) {
+    if (file.unit == unit && file.name == name) {
+      return &file;
+    }
+  }
+  return nullptr;
+}
+
+std::optional<std::string> HashOf(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::vector<uint8_t> buffer(1 << 20);
+  while (true) {
+    std::optional<size_t> read = file.ReadAtCurrentPos(buffer);
+    if (!read) {
+      return std::nullopt;
+    }
+    if (*read == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*read));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::ToLowerASCII(base::HexEncode(digest));
+}
+
+base::FilePath RecordPath(const base::FilePath& path) {
+  return path.AddExtensionASCII("sha256");
+}
+
+}  // namespace
+
+base::span<const CaptionFile> AllFiles() {
+  return kFiles;
+}
+
+std::vector<const CaptionFile*> FilesOf(std::string_view unit,
+                                        base::span<const CaptionFile> table) {
+  std::vector<const CaptionFile*> out;
+  for (const CaptionFile& file : table) {
+    if (file.unit == unit) {
+      out.push_back(&file);
+    }
+  }
+  return out;
+}
+
+std::vector<std::string> UnitsToFetch(std::string_view unit) {
+  // Translation models need no voice detector; the language detector has its
+  // own copy (desktop's unit, published with the same files).
+  if (unit.starts_with("tr_") || unit == kLanguageIdUnit) {
+    return {std::string(unit)};
+  }
+  std::vector<std::string> units = {kCommon};
+  if (unit != kCommon) {
+    units.emplace_back(unit);
+  }
+  return units;
+}
+
+std::vector<std::string> TranslationUnitsFor(std::string_view source, std::string_view target) {
+  const bool indian_source = source == "hi" || source == "ta";
+  const bool indian_target = target == "hi" || target == "ta";
+  if ((target != "en" && !indian_target) || source == target) {
+    return {};
+  }
+  std::vector<std::string> units;
+  if (indian_source) {
+    units.emplace_back("tr_indic_en");
+  } else if (source == "es") {
+    units.emplace_back("tr_es_en");
+  } else if (source != "en") {
+    return {};
+  }
+  if (indian_target) {
+    units.emplace_back("tr_en_indic");
+  }
+  return units;
+}
+
+std::string FileUrl(const CaptionFile& file) {
+  return base::StrCat({kBaseUrl, file.sha256, ".bin"});
+}
+
+bool VerifyFile(const base::FilePath& path, const CaptionFile& file) {
+  std::optional<int64_t> size = base::GetFileSize(path);
+  const bool ok = size && *size == file.size && HashOf(path) == file.sha256;
+  if (!ok) {
+    base::DeleteFile(path);
+    base::DeleteFile(RecordPath(path));
+  }
+  return ok;
+}
+
+bool WriteRecord(const base::FilePath& path, const CaptionFile& file) {
+  return base::WriteFile(RecordPath(path), file.sha256);
+}
+
+std::string PartFileName(std::string_view name, uint64_t generation) {
+  return base::StrCat({name, ".", base::NumberToString(generation), kPartSuffix});
+}
+
+std::vector<std::string> ScanUnit(const base::FilePath& unit_dir,
+                                  std::string_view unit,
+                                  base::span<const CaptionFile> table) {
+  std::vector<std::string> present;
+  base::FileEnumerator files(unit_dir, /*recursive=*/false, base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    const std::string name = path.BaseName().AsUTF8Unsafe();
+    if (base::EndsWith(name, kRecordSuffix)) {
+      // Kept beside its file; removed with it.
+      const std::string data = name.substr(0, name.size() - strlen(kRecordSuffix));
+      if (!Find(table, unit, data) || !base::PathExists(unit_dir.AppendASCII(data))) {
+        base::DeleteFile(path);
+      }
+      continue;
+    }
+    const CaptionFile* file = Find(table, unit, name);
+    if (!file || base::EndsWith(name, kPartSuffix)) {
+      base::DeleteFile(path);
+      continue;
+    }
+    std::optional<int64_t> size = base::GetFileSize(path);
+    if (!size || *size != file->size) {
+      base::DeleteFile(path);
+      base::DeleteFile(RecordPath(path));
+      continue;
+    }
+    std::string record;
+    if (base::ReadFileToString(RecordPath(path), &record) && record == file->sha256) {
+      present.push_back(name);
+    } else if (VerifyFile(path, *file)) {
+      WriteRecord(path, *file);
+      present.push_back(name);
+    }
+  }
+  std::sort(present.begin(), present.end());
+  return present;
+}
+
+bool UnitReady(std::string_view unit,
+               const std::vector<std::string>& present,
+               base::span<const CaptionFile> table) {
+  std::vector<const CaptionFile*> files = FilesOf(unit, table);
+  return !files.empty() && std::ranges::all_of(files, [&](const CaptionFile* file) {
+    return std::ranges::find(present, file->name) != present.end();
+  });
+}
+
+std::optional<std::string> NextToFetch(const std::deque<std::string>& queue,
+                                       base::FunctionRef<bool(const std::string&)> can_start) {
+  for (const std::string& unit : queue) {
+    if (can_start(unit)) {
+      return unit;
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<std::string> UnitsToRequest(const std::vector<std::string>& units,
+                                        base::FunctionRef<bool(const std::string&)> missing,
+                                        base::FunctionRef<bool(const std::string&)> removing) {
+  std::vector<std::string> again;
+  for (const std::string& unit : units) {
+    if (missing(unit) && !removing(unit)) {
+      again.push_back(unit);
+    }
+  }
+  return again;
+}
+
+std::vector<std::string> UnitsToQueue(std::string_view unit,
+                                      base::FunctionRef<bool(const std::string&)> ready,
+                                      base::FunctionRef<bool(const std::string&)> removing,
+                                      const std::deque<std::string>& queue) {
+  std::vector<std::string> out;
+  for (const std::string& u : UnitsToFetch(unit)) {
+    if (!ready(u) && !removing(u) && std::ranges::find(queue, u) == queue.end()) {
+      out.push_back(u);
+    }
+  }
+  return out;
+}
+
+namespace {
+
+constexpr std::pair<Owner, std::string_view> kOwnerNames[] = {
+    {Owner::kCaptions, "captions"},
+    {Owner::kVoice, "voice"},
+};
+
+}  // namespace
+
+UnitOwners::UnitOwners() = default;
+UnitOwners::UnitOwners(const UnitOwners&) = default;
+UnitOwners& UnitOwners::operator=(const UnitOwners&) = default;
+UnitOwners::~UnitOwners() = default;
+
+UnitOwners::UnitOwners(const base::DictValue& saved) {
+  for (const auto [unit, names] : saved) {
+    if (!names.is_list()) {
+      continue;
+    }
+    for (const base::Value& name : names.GetList()) {
+      for (const auto& [owner, owner_name] : kOwnerNames) {
+        if (name.is_string() && name.GetString() == owner_name) {
+          SetWanted(unit, owner, true);
+        }
+      }
+    }
+  }
+}
+
+bool UnitOwners::SetWanted(std::string_view unit, Owner owner, bool wanted) {
+  auto it = owners_.find(unit);
+  if (wanted) {
+    if (it == owners_.end()) {
+      it = owners_.emplace(std::string(unit), std::set<Owner>()).first;
+    }
+    return it->second.insert(owner).second;
+  }
+  if (it == owners_.end() || !it->second.erase(owner)) {
+    return false;
+  }
+  if (it->second.empty()) {
+    owners_.erase(it);
+  }
+  return true;
+}
+
+bool UnitOwners::WantedBy(std::string_view unit, Owner owner) const {
+  auto it = owners_.find(unit);
+  return it != owners_.end() && it->second.contains(owner);
+}
+
+bool UnitOwners::Wanted(std::string_view unit) const {
+  return owners_.find(unit) != owners_.end();
+}
+
+std::vector<std::string> UnitOwners::Units() const {
+  std::vector<std::string> units;
+  for (const auto& [unit, owners] : owners_) {
+    units.push_back(unit);
+  }
+  return units;
+}
+
+base::DictValue UnitOwners::ToDict() const {
+  base::DictValue dict;
+  for (const auto& [unit, owners] : owners_) {
+    base::ListValue names;
+    for (const auto& [owner, owner_name] : kOwnerNames) {
+      if (owners.contains(owner)) {
+        names.Append(owner_name);
+      }
+    }
+    dict.Set(unit, std::move(names));
+  }
+  return dict;
+}
+
+Removal DecideRemoval(std::string_view unit, const UnitOwners& owners, UnitUse& use) {
+  if (owners.Wanted(unit)) {
+    return Removal::kKeep;
+  }
+  return use.RequestRemove(unit) ? Removal::kNow : Removal::kOnRelease;
+}
+
+std::vector<Resume> UnitsToResume(const UnitOwners& owners,
+                                  const std::vector<std::string>& cellular_ok,
+                                  base::FunctionRef<bool(const std::string&)> ready) {
+  std::vector<Resume> out;
+  auto add = [&](const std::string& unit) {
+    if (ready(unit) || FilesOf(unit).empty() ||
+        std::ranges::any_of(out, [&](const Resume& r) { return r.unit == unit; })) {
+      return;
+    }
+    out.push_back({unit, std::ranges::find(cellular_ok, unit) != cellular_ok.end()});
+  };
+  for (const std::string& unit : cellular_ok) {
+    add(unit);
+  }
+  for (const std::string& unit : owners.Units()) {
+    add(unit);
+  }
+  return out;
+}
+
+std::optional<base::TimeDelta> RetryDelay(int failures) {
+  constexpr base::TimeDelta kDelays[] = {base::Seconds(5), base::Seconds(15), base::Seconds(45),
+                                         base::Minutes(2), base::Minutes(5)};
+  if (failures < 1 || failures > static_cast<int>(std::size(kDelays))) {
+    return std::nullopt;
+  }
+  return kDelays[failures - 1];
+}
+
+bool ReleaseDeletes(std::string_view unit, const UnitOwners& owners, UnitUse& use) {
+  return use.SetInUse(unit, false) && !owners.Wanted(unit);
+}
+
+UnitUse::UnitUse() = default;
+UnitUse::~UnitUse() = default;
+
+bool UnitUse::SetInUse(std::string_view unit, bool in_use) {
+  auto it = in_use_.find(unit);
+  if (in_use) {
+    if (it == in_use_.end()) {
+      in_use_.emplace(std::string(unit), 1);
+    } else {
+      ++it->second;
+    }
+    return false;
+  }
+  if (it == in_use_.end()) {
+    return false;
+  }
+  if (--it->second > 0) {
+    return false;
+  }
+  in_use_.erase(it);
+  auto pending = pending_remove_.find(unit);
+  if (pending == pending_remove_.end()) {
+    return false;
+  }
+  pending_remove_.erase(pending);
+  return true;
+}
+
+bool UnitUse::RequestRemove(std::string_view unit) {
+  if (in_use_.find(unit) == in_use_.end()) {
+    return true;
+  }
+  pending_remove_.emplace(unit);
+  return false;
+}
+
+bool UnitUse::Removing(std::string_view unit) const {
+  return pending_remove_.contains(unit);
+}
+
+void UnitUse::CancelRemove(std::string_view unit) {
+  auto it = pending_remove_.find(unit);
+  if (it != pending_remove_.end()) {
+    pending_remove_.erase(it);
+  }
+}
+
+}  // namespace tark_captions
