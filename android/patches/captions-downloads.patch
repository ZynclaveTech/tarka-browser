+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace tark_captions {
+
+// Tark for Android's live captions: the model files the phone downloads from
+// gettarka.com, by unit ("common", then one per language), each pinned in
+// the APK by size and sha256 (android/captions/models.py writes the table,
+// model_files.inc, from android/captions/files.json). Base-only, so the rules
+// build for the build machine's tests.
+struct CaptionFile {
+  std::string_view unit;
+  std::string_view name;
+  int64_t size;
+  std::string_view sha256;  // Lower-case hex.
+};
+
+// The APK's table.
+base::span<const CaptionFile> AllFiles();
+std::vector<const CaptionFile*> FilesOf(std::string_view unit,
+                                        base::span<const CaptionFile> table = AllFiles());
+
+// The spoken-language detector (lid.onnx, its labels and its own copy of
+// Silero VAD), shared by voice search and captions: one copy on disk.
+inline constexpr char kLanguageIdUnit[] = "language_id";
+
+// What turning `unit` on downloads: "common" (Silero VAD) and the unit. A
+// translation model and the detector bring what they need themselves.
+std::vector<std::string> UnitsToFetch(std::string_view unit);
+
+// The translation units a caption in `source` ("hi", "ta", "en", "es") needs
+// to reach `target` ("en", "hi", "ta"; "" is Translate off), in order:
+// Indian and Spanish into Hindi or Tamil go through English. Empty when
+// nothing is translated.
+std::vector<std::string> TranslationUnitsFor(std::string_view source, std::string_view target);
+
+// Content-addressed: https://gettarka.com/models/android/v1/<sha256>.bin (the
+// site serves extension-less paths as folders).
+std::string FileUrl(const CaptionFile& file);
+
+// Whether `path` is `file` (size, then sha256); a file that is not is
+// deleted. Blocking.
+bool VerifyFile(const base::FilePath& path, const CaptionFile& file);
+// "<name>.sha256" beside a checked file, so that a start trusts it without
+// hashing 138 MB again. Blocking.
+bool WriteRecord(const base::FilePath& path, const CaptionFile& file);
+// A download attempt's own file: "<name>.<generation>.part".
+std::string PartFileName(std::string_view name, uint64_t generation);
+
+// The unit's files present in `unit_dir`, by name. Deletes unfinished
+// downloads (*.part), files of the wrong size or hash, and files the table
+// does not name. A file with no record is hashed once. Blocking.
+std::vector<std::string> ScanUnit(const base::FilePath& unit_dir,
+                                  std::string_view unit,
+                                  base::span<const CaptionFile> table = AllFiles());
+
+// Whether every file of `unit` is in `present` (and the unit is known).
+bool UnitReady(std::string_view unit,
+               const std::vector<std::string>& present,
+               base::span<const CaptionFile> table = AllFiles());
+
+// Which units are captioning. A unit deleted in Settings while it is in use
+// is removed when it is released, never under a running engine.
+// The first unit in `queue` that `can_start` allows (the network, the
+// person's "Download now"), so one waiting for Wi-Fi blocks no other.
+std::optional<std::string> NextToFetch(const std::deque<std::string>& queue,
+                                       base::FunctionRef<bool(const std::string&)> can_start);
+
+// Of `units`, those to request again: missing (deleted, or cancelled by
+// another tab) and not waiting to be removed.
+std::vector<std::string> UnitsToRequest(const std::vector<std::string>& units,
+                                        base::FunctionRef<bool(const std::string&)> missing,
+                                        base::FunctionRef<bool(const std::string&)> removing);
+
+// Of UnitsToFetch(unit), the units a request queues: not ready, not waiting
+// to be removed, not queued already. A unit that is ready is never fetched
+// again, whoever asks for it.
+std::vector<std::string> UnitsToQueue(std::string_view unit,
+                                      base::FunctionRef<bool(const std::string&)> ready,
+                                      base::FunctionRef<bool(const std::string&)> removing,
+                                      const std::deque<std::string>& queue);
+
+// The features that download units. A unit may be wanted by both (the
+// detector: voice search and captions), and stays while either wants it.
+enum class Owner { kCaptions, kVoice };
+
+// Which features want each unit, kept in local state (kOwnersPref) as
+// {"<unit>": ["captions", "voice"]}. A unit no feature wants may be deleted.
+class UnitOwners {
+ public:
+  UnitOwners();
+  // Unknown names and malformed entries are dropped.
+  explicit UnitOwners(const base::DictValue& saved);
+  UnitOwners(const UnitOwners&);
+  UnitOwners& operator=(const UnitOwners&);
+  ~UnitOwners();
+
+  // Returns whether this changed anything.
+  bool SetWanted(std::string_view unit, Owner owner, bool wanted);
+  bool WantedBy(std::string_view unit, Owner owner) const;
+  // By any feature.
+  bool Wanted(std::string_view unit) const;
+  // Every unit some feature wants.
+  std::vector<std::string> Units() const;
+  base::DictValue ToDict() const;
+
+ private:
+  std::map<std::string, std::set<Owner>, std::less<>> owners_;
+};
+
+class UnitUse;
+
+// After a start: the units to queue again, each with whether it may use
+// mobile data. A unit a feature still wants and that is not in place resumes
+// (an interrupted download; ScanUnit removed its .part files), with the
+// person's "Download now" if they chose it; so does a pending "Download now".
+struct Resume {
+  std::string unit;
+  bool now = false;
+  bool operator==(const Resume&) const = default;
+};
+std::vector<Resume> UnitsToResume(const UnitOwners& owners,
+                                  const std::vector<std::string>& cellular_ok,
+                                  base::FunctionRef<bool(const std::string&)> ready);
+
+// How long to wait before trying a failed file again: 5 s, 15 s, 45 s, 2 min
+// and 5 min after the 1st to 5th failure in a row; then none ("Couldn't
+// download"). A request or a network change starts the count over.
+std::optional<base::TimeDelta> RetryDelay(int failures);
+
+// What CaptionDownloads::Remove() does with a unit.
+enum class Removal {
+  kKeep,       // another feature still wants it: nothing is deleted
+  kNow,        // deleted now
+  kOnRelease,  // in use: deleted when the engine lets it go
+};
+Removal DecideRemoval(std::string_view unit, const UnitOwners& owners, UnitUse& use);
+
+// An engine lets `unit` go: whether its pending removal deletes it now. A
+// unit some feature wants again (asked for after Remove) is kept.
+bool ReleaseDeletes(std::string_view unit, const UnitOwners& owners, UnitUse& use);
+
+class UnitUse {
+ public:
+  UnitUse();
+  ~UnitUse();
+
+  // True when releasing `unit` makes a pending removal due.
+  bool SetInUse(std::string_view unit, bool in_use);
+  // True when `unit` can be removed now; otherwise it is removed on release.
+  bool RequestRemove(std::string_view unit);
+  // Whether `unit` waits to be removed (no longer ready to the person).
+  bool Removing(std::string_view unit) const;
+  // A feature wants `unit` again: its pending removal is dropped.
+  void CancelRemove(std::string_view unit);
+
+ private:
+  std::map<std::string, int, std::less<>> in_use_;
+  std::set<std::string, std::less<>> pending_remove_;
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_ANDROID_MODEL_FILES_H_
