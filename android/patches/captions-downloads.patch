+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// CaptionDownloads' sharing rules: the language detector (language_id) is
+// one unit on disk that captions and voice search both may want. The
+// decisions live in model_files (UnitOwners, DecideRemoval, UnitsToQueue,
+// UnitsToFetch), which CaptionDownloads calls as they are tested here; the
+// class itself needs a browser and does not build for the build machine.
+
+#include <deque>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "chrome/browser/tark_captions_android/model_files.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr char kLidSha256[] = "7cfabee2653ac9d6e80f9f766514dedb0983fc6cd6e078b499fc6d644164f0a4";
+
+// Plays CaptionDownloads' part: the units on disk and the queue of fetches.
+struct Disk {
+  std::set<std::string> ready;
+  std::deque<std::string> queue;
+  UnitOwners owners;
+  UnitUse use;
+
+  // CaptionDownloads::Request.
+  void Request(const std::string& unit, Owner owner) {
+    owners.SetWanted(unit, owner, true);
+    for (std::string& u : UnitsToQueue(
+             unit, [&](const std::string& x) { return ready.contains(x); },
+             [&](const std::string& x) { return use.Removing(x); }, queue)) {
+      queue.push_back(std::move(u));
+    }
+  }
+
+  // The queue's fetches finish.
+  void Download() {
+    for (const std::string& unit : queue) {
+      ready.insert(unit);
+    }
+    queue.clear();
+  }
+
+  // CaptionDownloads::Request cancels a removal waiting for the release.
+  void RequestAgain(const std::string& unit, Owner owner) {
+    owners.SetWanted(unit, owner, true);
+    use.CancelRemove(unit);
+    Request(unit, owner);
+  }
+
+  // CaptionDownloads::Remove.
+  void Remove(const std::string& unit) {
+    if (DecideRemoval(unit, owners, use) == Removal::kNow) {
+      ready.erase(unit);
+    }
+  }
+
+  // CaptionDownloads::SetInUse(unit, false).
+  void Release(const std::string& unit) {
+    if (ReleaseDeletes(unit, owners, use)) {
+      ready.erase(unit);
+    }
+  }
+};
+
+// Plan Review Focus 4: turning detection off while captions uses the
+// detector leaves its files, and captions keeps working.
+TEST(CaptionDownloadsTest, RemoveKeepsUnitCaptionsUses) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kCaptions);
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  disk.Download();
+  ASSERT_TRUE(disk.ready.contains(kLanguageIdUnit));
+
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  EXPECT_EQ(DecideRemoval(kLanguageIdUnit, disk.owners, disk.use), Removal::kKeep);
+  disk.Remove(kLanguageIdUnit);
+  EXPECT_TRUE(disk.ready.contains(kLanguageIdUnit));  // State: kReady
+  EXPECT_TRUE(disk.owners.WantedBy(kLanguageIdUnit, Owner::kCaptions));
+  EXPECT_FALSE(disk.owners.WantedBy(kLanguageIdUnit, Owner::kVoice));
+  // Nothing waits to delete it later either.
+  EXPECT_FALSE(disk.use.Removing(kLanguageIdUnit));
+}
+
+TEST(CaptionDownloadsTest, RemoveDeletesWhenNoOwner) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  disk.Download();
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  EXPECT_FALSE(disk.owners.Wanted(kLanguageIdUnit));
+  disk.Remove(kLanguageIdUnit);
+  EXPECT_FALSE(disk.ready.contains(kLanguageIdUnit));
+
+  // In use by a running engine: deleted when it is let go, as before.
+  Disk busy;
+  busy.Request(kLanguageIdUnit, Owner::kCaptions);
+  busy.Download();
+  busy.use.SetInUse(kLanguageIdUnit, true);
+  busy.owners.SetWanted(kLanguageIdUnit, Owner::kCaptions, false);
+  EXPECT_EQ(DecideRemoval(kLanguageIdUnit, busy.owners, busy.use), Removal::kOnRelease);
+  busy.Release(kLanguageIdUnit);
+  EXPECT_FALSE(busy.ready.contains(kLanguageIdUnit));
+}
+
+// In use, removed (no owner), then asked for again before the engine lets
+// go: the removal is dropped, nothing is fetched, and the release keeps it.
+TEST(CaptionDownloadsTest, RequestAfterPendingRemoveKeepsUnit) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  disk.Download();
+  disk.use.SetInUse(kLanguageIdUnit, true);
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  disk.Remove(kLanguageIdUnit);
+  ASSERT_TRUE(disk.use.Removing(kLanguageIdUnit));
+
+  disk.RequestAgain(kLanguageIdUnit, Owner::kVoice);
+  EXPECT_FALSE(disk.use.Removing(kLanguageIdUnit));  // ready again at once
+  EXPECT_TRUE(disk.queue.empty());
+  disk.Release(kLanguageIdUnit);
+  EXPECT_TRUE(disk.ready.contains(kLanguageIdUnit));
+}
+
+// The release re-checks the owners even if a removal was due: an owner that
+// wants the unit by then keeps it.
+TEST(CaptionDownloadsTest, ReleaseKeepsUnitWantedAgain) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  disk.Download();
+  disk.use.SetInUse(kLanguageIdUnit, true);
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  disk.Remove(kLanguageIdUnit);
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kCaptions, true);
+  disk.Release(kLanguageIdUnit);
+  EXPECT_TRUE(disk.ready.contains(kLanguageIdUnit));
+}
+
+// In use, and Remove while captions still want it: kept, and the release
+// deletes nothing either.
+TEST(CaptionDownloadsTest, InUseRemoveWhileKeptThenRelease) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kCaptions);
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  disk.Download();
+  disk.use.SetInUse(kLanguageIdUnit, true);
+  disk.owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  disk.Remove(kLanguageIdUnit);
+  EXPECT_FALSE(disk.use.Removing(kLanguageIdUnit));
+  disk.Release(kLanguageIdUnit);
+  EXPECT_TRUE(disk.ready.contains(kLanguageIdUnit));
+}
+
+// The detector came with captions: voice asking for it fetches nothing.
+TEST(CaptionDownloadsTest, SharedNoSecondDownload) {
+  Disk disk;
+  disk.Request(kLanguageIdUnit, Owner::kCaptions);
+  EXPECT_EQ(disk.queue, (std::deque<std::string>{kLanguageIdUnit}));
+  disk.Download();
+
+  disk.Request(kLanguageIdUnit, Owner::kVoice);
+  EXPECT_TRUE(disk.queue.empty());
+  EXPECT_TRUE(disk.owners.WantedBy(kLanguageIdUnit, Owner::kVoice));
+  // Nor while it is still coming: it is queued once.
+  Disk coming;
+  coming.Request(kLanguageIdUnit, Owner::kCaptions);
+  coming.Request(kLanguageIdUnit, Owner::kVoice);
+  EXPECT_EQ(coming.queue, (std::deque<std::string>{kLanguageIdUnit}));
+}
+
+// The detector brings its own Silero VAD (the three files desktop
+// publishes), so it needs no "common".
+TEST(CaptionDownloadsTest, LanguageIdIsOneUnit) {
+  EXPECT_EQ(UnitsToFetch(kLanguageIdUnit), (std::vector<std::string>{kLanguageIdUnit}));
+  std::set<std::string> names;
+  int64_t total = 0;
+  for (const CaptionFile* file : FilesOf(kLanguageIdUnit)) {
+    names.emplace(file->name);
+    total += file->size;
+    if (file->name == "lid.onnx") {
+      EXPECT_EQ(file->size, 86063323);
+      EXPECT_EQ(file->sha256, kLidSha256);
+    }
+  }
+  EXPECT_EQ(names, (std::set<std::string>{"lid.onnx", "lid_labels.txt", "silero_vad.onnx"}));
+  EXPECT_EQ(total / 1'000'000, 88);  // "88 MB" in Settings
+}
+
+// Owners survive a restart (local state), and a damaged pref drops only the
+// entries it cannot read.
+TEST(CaptionDownloadsTest, OwnersPersist) {
+  UnitOwners owners;
+  EXPECT_TRUE(owners.SetWanted(kLanguageIdUnit, Owner::kVoice, true));
+  EXPECT_FALSE(owners.SetWanted(kLanguageIdUnit, Owner::kVoice, true));
+  EXPECT_TRUE(owners.SetWanted("hi", Owner::kCaptions, true));
+  const base::DictValue saved = owners.ToDict();
+  const UnitOwners restored(saved);
+  EXPECT_TRUE(restored.WantedBy(kLanguageIdUnit, Owner::kVoice));
+  EXPECT_FALSE(restored.WantedBy(kLanguageIdUnit, Owner::kCaptions));
+  EXPECT_TRUE(restored.WantedBy("hi", Owner::kCaptions));
+  EXPECT_EQ(restored.ToDict(), saved);
+
+  base::DictValue damaged;
+  damaged.Set("ta", "voice");  // not a list
+  base::ListValue names;
+  names.Append("search");
+  names.Append(3);
+  names.Append("voice");
+  damaged.Set(kLanguageIdUnit, std::move(names));
+  const UnitOwners read(damaged);
+  EXPECT_FALSE(read.Wanted("ta"));
+  EXPECT_TRUE(read.WantedBy(kLanguageIdUnit, Owner::kVoice));
+  EXPECT_FALSE(read.WantedBy(kLanguageIdUnit, Owner::kCaptions));
+
+  // The last owner gone: the unit has no entry left.
+  UnitOwners one;
+  one.SetWanted(kLanguageIdUnit, Owner::kVoice, true);
+  EXPECT_TRUE(one.SetWanted(kLanguageIdUnit, Owner::kVoice, false));
+  EXPECT_TRUE(one.ToDict().empty());
+  EXPECT_FALSE(one.SetWanted(kLanguageIdUnit, Owner::kVoice, false));
+}
+
+// A failed file is tried again later, each wait longer, five times; then
+// "Couldn't download" until the person asks again or the network changes.
+TEST(CaptionDownloadsTest, RetryBacksOffThenGivesUp) {
+  EXPECT_FALSE(RetryDelay(0).has_value());
+  EXPECT_EQ(RetryDelay(1), base::Seconds(5));
+  EXPECT_EQ(RetryDelay(2), base::Seconds(15));
+  EXPECT_EQ(RetryDelay(3), base::Seconds(45));
+  EXPECT_EQ(RetryDelay(4), base::Minutes(2));
+  EXPECT_EQ(RetryDelay(5), base::Minutes(5));
+  EXPECT_FALSE(RetryDelay(6).has_value());
+}
+
+// Tark restarted in the middle of the detector's download: it is queued
+// again on Wi-Fi, as voice asked; a ready unit is not.
+TEST(CaptionDownloadsTest, InterruptedDownloadResumes) {
+  UnitOwners owners;
+  owners.SetWanted(kLanguageIdUnit, Owner::kVoice, true);
+  owners.SetWanted("hi", Owner::kCaptions, true);
+  auto ready = [](const std::string& unit) { return unit == "hi"; };
+  EXPECT_EQ(UnitsToResume(owners, {}, ready),
+            (std::vector<Resume>{{kLanguageIdUnit, /*now=*/false}}));
+  // Nobody wants it any more (Remove, captions turned off): nothing resumes.
+  owners.SetWanted(kLanguageIdUnit, Owner::kVoice, false);
+  EXPECT_TRUE(UnitsToResume(owners, {}, ready).empty());
+}
+
+// With "Download now", it resumes on mobile data too; a pending "Download
+// now" with no owner (an older APK's) still resumes, once.
+TEST(CaptionDownloadsTest, ResumeKeepsDownloadNow) {
+  UnitOwners owners;
+  owners.SetWanted(kLanguageIdUnit, Owner::kVoice, true);
+  auto none = [](const std::string&) { return false; };
+  EXPECT_EQ(UnitsToResume(owners, {kLanguageIdUnit, "ta"}, none),
+            (std::vector<Resume>{{kLanguageIdUnit, true}, {"ta", true}}));
+  EXPECT_TRUE(UnitsToResume(UnitOwners(), {"not-a-unit"}, none).empty());
+}
