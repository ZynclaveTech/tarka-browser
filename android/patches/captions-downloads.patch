+namespace tark_captions {
+
+// Local state: the units the person chose "Download now" for, until they
+// are in place.
+inline constexpr char kCellularOkPref[] = "tark.captions.cellular_ok";
+// Caption style: 0 Automatic, 1 word by word, 2 a phrase at a time.
+inline constexpr char kStylePref[] = "tark.captions.style";
+// The language last chosen in the caption bar ("hi", "ta", "en", "es").
+inline constexpr char kLanguagePref[] = "tark.captions.language";
+// Translate's target: "" (off), "en", "hi", "ta".
+inline constexpr char kTargetPref[] = "tark.captions.target";
+// Which features want each unit (UnitOwners): a unit captions and voice
+// search share stays until neither wants it.
+inline constexpr char kOwnersPref[] = "tark.captions.owners";
+
+// Tark for Android's live captions: downloads a language's model files (and
+// "common", Silero VAD) into the app's data directory when the person turns
+// captions on for it, on Wi-Fi unless they chose "Download now"; three tries,
+// no redirects, a file that does not match is deleted. One per browser
+// process, on the UI thread. Nothing is fetched until the person asks.
+// Voice search shares the spoken-language detector (kLanguageIdUnit) with
+// captions: one copy, kept while either feature wants it.
+class CaptionDownloads : public net::NetworkChangeNotifier::NetworkChangeObserver {
+ public:
+  enum class State { kMissing, kWaitingForWifi, kDownloading, kReady, kFailed };
+  struct UnitState {
+    State state = State::kMissing;
+    int64_t bytes = 0;  // downloaded so far (kDownloading)
+    int64_t total = 0;  // the unit's size, "common" included while missing
+    // kWaitingForWifi only: not waiting for Wi-Fi but for the next try after
+    // a failure (RetryDelay).
+    bool retrying = false;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnUnitChanged(const std::string& unit) = 0;
+  };
+
+  static void RegisterPrefs(PrefRegistrySimple* registry);
+  // Created at browser start (chrome_browser_main_android.cc).
+  static CaptionDownloads& Get();
+
+  CaptionDownloads(const CaptionDownloads&) = delete;
+  CaptionDownloads& operator=(const CaptionDownloads&) = delete;
+
+  // `owner` wants `unit` (captions: the person turned captions on in its
+  // language): its files (and common's), on Wi-Fi, or now on any network.
+  // Nothing is fetched for a unit already in place.
+  void Request(std::string_view unit, bool now, Owner owner = Owner::kCaptions);
+  // Captions no longer want `unit` (turned off before it arrived): its
+  // download stops unless another feature wants it.
+  void Cancel(std::string_view unit);
+  // Deletes the unit's files (Settings) unless a feature still wants it
+  // (SetWantedBy); while it is captioning, when it is released.
+  void Remove(std::string_view unit);
+  // Whether `owner` wants `unit`; kept in local state (kOwnersPref). A
+  // feature that turns a unit off says so before Remove().
+  void SetWantedBy(std::string_view unit, Owner owner, bool wanted);
+  bool WantedBy(std::string_view unit, Owner owner) const {
+    return owners_.WantedBy(unit, owner);
+  }
+  UnitState State(std::string_view unit) const;
+  // The caption and translation units whose files are all in place
+  // (Settings), with their sizes; not "common" or the language detector.
+  std::map<std::string, int64_t> ReadyUnits() const;
+  // Engines hold their unit while they run.
+  void SetInUse(std::string_view unit, bool in_use);
+  // Whether `unit` waits to be removed (in use when Remove() was called).
+  bool Removing(std::string_view unit) const { return use_.Removing(unit); }
+  // Where a unit's files are: <app data>/captions/<unit>.
+  base::FilePath UnitDir(std::string_view unit) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  friend class base::NoDestructor<CaptionDownloads>;
+  CaptionDownloads();
+  ~CaptionDownloads() override;
+
+  // NetworkChangeObserver:
+  void OnNetworkChanged(net::NetworkChangeNotifier::ConnectionType type) override;
+
+  void OnScanned(std::map<std::string, std::vector<std::string>> present);
+  // Queues what `unit` still needs; no owner changes.
+  void Enqueue(std::string_view unit, bool now);
+  bool Ready(std::string_view unit) const;
+  // Starts the next missing file of the first queued unit if allowed.
+  void MaybeDownloadNext();
+  // Closes the system network context's connections, then MaybeDownloadNext.
+  void RestartAfterClosingConnections();
+  // Stops `unit`'s download, whoever wants it.
+  void Abort(std::string_view unit);
+  // Retries are spent (RetryDelay), or a redirect was refused.
+  bool GaveUp() const;
+  void OnProgress(uint64_t current);
+  void OnDownloaded(uint64_t generation, const CaptionFile* file, base::FilePath part);
+  void OnVerified(uint64_t generation, const CaptionFile* file, bool ok);
+  void DeleteUnit(const std::string& unit);
+  void Notify(const std::string& unit);
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const base::FilePath dir_;
+  bool scanned_ = false;
+  std::map<std::string, std::vector<std::string>, std::less<>> present_;
+  // Units asked for and not yet in place, oldest first.
+  std::deque<std::string> queue_;
+  std::map<std::string, bool, std::less<>> failed_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  const CaptionFile* current_ = nullptr;
+  int64_t current_bytes_ = 0;
+  uint64_t generation_ = 0;
+  // Failures in a row (RetryDelay); a request or a network change resets it.
+  int failures_ = 0;
+  bool refused_ = false;
+  // The kind of network the fetch in flight started on.
+  net::NetworkChangeNotifier::ConnectionType fetch_network_ =
+      net::NetworkChangeNotifier::CONNECTION_UNKNOWN;
+  base::OneShotTimer retry_timer_;
+  UnitUse use_;
+  UnitOwners owners_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<CaptionDownloads> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_ANDROID_CAPTION_DOWNLOADS_H_
