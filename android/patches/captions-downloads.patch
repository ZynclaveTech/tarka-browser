+TEST_F(TabCaptionsTest, TranslationWaitsForItsUnit) {
+  Captioning();
+  tab_.SetTarget("en", At(2));
+  EXPECT_EQ(tab_.state().target, "en");
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_FALSE(tab_.WantsTranslation());
+  tab_.OnTranslationReady(true, At(20));
+  EXPECT_TRUE(tab_.WantsTranslation());
+  EXPECT_EQ(tab_.engine_starts(), 1);
+}
+
+TEST(TranslateAvailableTest, HiddenUnder6GBAndForTheSameLanguage) {
+  EXPECT_FALSE(TranslateAvailable(5000, "hi", "en"));
+  EXPECT_TRUE(TranslateAvailable(7600, "hi", "en"));
+  EXPECT_FALSE(TranslateAvailable(7600, "hi", "hi"));
+  EXPECT_TRUE(TranslateAvailable(6144, "es", "ta"));
+  // Phones sold as 6 GB report about 5.3–5.7 GiB: they get Translate; 4 GB
+  // phones do not.
+  EXPECT_TRUE(TranslateAvailable(5600, "hi", "en"));
+  EXPECT_FALSE(TranslateAvailable(3800, "hi", "en"));
+}
+
+// The translation model deleted in Settings: captions go on, Translate
+// keeps its target and offers the download again.
+TEST_F(TabCaptionsTest, TranslationUnitRemovedKeepsCaptions) {
+  Captioning();
+  tab_.SetTarget("hi", At(2));
+  tab_.OnTranslationReady(true, At(3));
+  tab_.OnTranslationReady(false, At(4));
+  EXPECT_TRUE(tab_.state().captions_on);
+  EXPECT_EQ(tab_.state().target, "hi");
+  EXPECT_FALSE(tab_.WantsTranslation());
+  EXPECT_TRUE(tab_.WantsEngine());
+}
+
+TEST_F(TabCaptionsTest, TargetSurvivesLanguageChange) {
+  Captioning();
+  tab_.SetTarget("hi", At(2));
+  tab_.ChooseLanguage("ta");
+  EXPECT_EQ(tab_.state().target, "hi");
+  tab_.ChooseLanguage("en");
+  EXPECT_EQ(tab_.state().target, "hi");
+  EXPECT_FALSE(tab_.state().translation_ready);  // the units differ per pair
+}
+
+TEST_F(TabCaptionsTest, TranslateOffWantsNoTranslation) {
+  Captioning();
+  tab_.SetTarget("en", At(2));
+  tab_.OnTranslationReady(true, At(3));
+  tab_.SetTarget("", At(4));
+  EXPECT_FALSE(tab_.WantsTranslation());
+  EXPECT_TRUE(tab_.WantsEngine());
+}
+
+TEST(CaptionStyleTest, AutomaticIsPhraseOnMidRange) {
+  // Snapdragon 695: 8 cores, the fastest at 2.2 GHz, 8 GB.
+  EXPECT_EQ(StyleForDevice(/*fastest_khz=*/2200000, /*ram_mb=*/7600, /*pref=*/0), Style::kPhrase);
+  // A recent flagship: 3.3 GHz, 12 GB.
