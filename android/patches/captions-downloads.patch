+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TAB_CAPTIONS_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TAB_CAPTIONS_H_
+
+#include <stdint.h>
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/time/time.h"
+
+namespace tark_captions {
+
+enum class Style { kWordByWord, kPhrase };
+
+// Caption style from the phone: `pref` 1 word by word, 2 a phrase at a time;
+// 0 (Automatic) is word by word only on a flagship (a core of 2.8 GHz or
+// more and 8 GB or more), a phrase at a time otherwise (the spike: 0.75 core
+// word by word on a Snapdragon 695, 0.32 a phrase at a time).
+Style StyleForDevice(int fastest_khz, int ram_mb, int pref);
+
+// Whether the bar offers Translate: phones sold as 6 GB or more (until
+// measured on smaller ones), and only into another language than the
+// captions'.
+bool TranslateAvailable(int ram_mb, const std::string& language, const std::string& target);
+
+// One tab's live captions, without the browser: what the caption bar shows,
+// whether the tab's audio goes to the captions process, and when that
+// process is wanted. TarkCaptionsTab feeds it events and acts on it.
+class TabCaptions {
+ public:
+  struct State {
+    bool bar_visible = false;   // a player plays with sound
+    bool captions_on = false;   // the person turned captions on
+    std::string language;       // the chip: "hi", "ta", "en", "es"
+    bool unit_ready = false;    // the language's model is on the phone
+    bool cant_caption = false;  // on, ready, playing, but no audio arrives
+    std::string target;         // Translate: "" off, "en", "hi", "ta"
+    bool translation_ready = false;  // its translation models are on the phone
+  };
+
+  // How long captions wait for the tab's audio before saying they can't
+  // caption this video.
+  static constexpr base::TimeDelta kNoAudio = base::Seconds(10);
+  // A tab hidden this long (Home, the lock screen, the tab switcher) lets
+  // its captions process go; back sooner, captions go on without reloading.
+  static constexpr base::TimeDelta kHiddenGrace = base::Seconds(60);
+  // Captions on but no audio this long (a paused video, a page without
+  // media): the model is unloaded; audio coming back loads it again.
+  static constexpr base::TimeDelta kIdleUnload = base::Minutes(3);
+  // A source silent this long hands captions to another one.
+  static constexpr base::TimeDelta kSourceQuiet = base::Seconds(1);
+
+  TabCaptions();
+  ~TabCaptions();
+
+  void OnPlayerAudible(int player_id, bool audible, base::TimeTicks now);
+  void OnHidden(bool hidden, base::TimeTicks now);
+  void SetCaptionsOn(bool on, base::TimeTicks now);
+  void ChooseLanguage(const std::string& language);
+  // Translate's target ("" turns it off); kept across languages.
+  void SetTarget(const std::string& target, base::TimeTicks now);
+  void OnTranslationReady(bool ready, base::TimeTicks now);
+  void OnUnitReady(bool ready, base::TimeTicks now);
+  // Audio from `source` (one player's connection). Captions follow one
+  // source at a time: the one that started most recently, or any once that
+  // one is quiet or gone. Returns whether this audio goes to the engine.
+  bool OnAudio(uint64_t source, base::TimeTicks now);
+  // `source`'s player went away.
+  void ForgetSource(uint64_t source);
+  void OnTick(base::TimeTicks now);
+  // The captions process died (Android reclaimed its memory).
+  void OnServiceGone();
+
+  const State& state() const { return state_; }
+  // Whether the tab's renderers send audio (captions on, the model ready,
+  // the tab shown). Audio still arrives while captions can't caption, so
+  // that audio coming back clears it.
+  bool ShouldForwardAudio() const;
+  // Whether the captions process should be running for this tab.
+  bool WantsEngine() const { return wanted_; }
+  // Whether the running captions process should translate.
+  bool WantsTranslation() const {
+    return wanted_ && !state_.target.empty() && state_.translation_ready;
+  }
+  // How many times WantsEngine() went from false to true (one process each).
+  int engine_starts() const { return engine_starts_; }
+
+ private:
+  // Updates what follows from the state after an event at `now`.
+  void Recompute(base::TimeTicks now);
+
+  State state_;
+  std::set<int> audible_;
+  bool hidden_ = false;
+  base::TimeTicks hidden_since_;
+  base::TimeTicks last_event_;
+  std::map<uint64_t, base::TimeTicks> source_last_;  // each source's last audio
+  std::optional<uint64_t> source_;                    // the one captioned
+  bool forwarding_ = false;
+  bool wanted_ = false;
+  base::TimeTicks waiting_since_;  // the last audio, or when forwarding began
+  int engine_starts_ = 0;
+};
+
+}  // namespace tark_captions
+
