+# Copyright 2026 The Tark Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Tark for Android's live captions: the model files' rules (table, check,
+# scan, use) and one tab's captions logic (TabCaptions), with no browser
+# dependencies, so that their unit tests also build for the build machine
+# (android/build.sh runs them).
+
+import("//testing/test.gni")
+
+static_library("rules") {
+  sources = [
+    "model_files.cc",
+    "model_files.h",
+    "model_files.inc",
+    "tab_captions.cc",
+    "tab_captions.h",
+  ]
+  deps = [
+    "//base",
+    "//crypto",
+  ]
+}
+
+if (!is_android) {
+  test("tark_captions_android_unittests") {
+    sources = [
+      "caption_downloads_unittest.cc",
+      "model_files_unittest.cc",
+      "tab_captions_unittest.cc",
+    ]
+    deps = [
+      ":rules",
+      "//base",
+      "//base/test:run_all_unittests",
+      "//base/test:test_support",
+      "//testing/gtest",
+    ]
+  }
+}
+
+if (current_toolchain == default_toolchain) {
+  group("host_unittests") {
+    testonly = true
+    deps = [ ":tark_captions_android_unittests($host_toolchain)" ]
+  }
+}
