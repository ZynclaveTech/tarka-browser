+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/tab_captions.h"
+
+namespace tark_captions {
+namespace {
+
+// A flagship: a core of 2.8 GHz or more and about 8 GB or more (phones sold
+// as 8 GB report a little under 7.5 GB).
+constexpr int kFlagshipKhz = 2800000;
+constexpr int kFlagshipRamMb = 7000;
+
+}  // namespace
+
+bool TranslateAvailable(int ram_mb, const std::string& language, const std::string& target) {
+  // Phones sold as 6 GB report about 5.3–5.7 GiB; 4 GB phones about 3.7.
+  constexpr int kTranslateRamMb = 5120;
+  return ram_mb >= kTranslateRamMb && language != target;
+}
+
+Style StyleForDevice(int fastest_khz, int ram_mb, int pref) {
+  if (pref == 1) {
+    return Style::kWordByWord;
+  }
+  if (pref == 2) {
+    return Style::kPhrase;
+  }
+  return fastest_khz >= kFlagshipKhz && ram_mb >= kFlagshipRamMb ? Style::kWordByWord
+                                                                  : Style::kPhrase;
+}
+
+TabCaptions::TabCaptions() = default;
+TabCaptions::~TabCaptions() = default;
+
+void TabCaptions::OnPlayerAudible(int player_id, bool audible, base::TimeTicks now) {
+  if (audible) {
+    if (audible_.insert(player_id).second) {
+      waiting_since_ = now;  // a player (re)starting is a fresh wait
+    }
+  } else {
+    audible_.erase(player_id);
+  }
+  state_.bar_visible = !audible_.empty() || state_.captions_on;
+  Recompute(now);
+}
+
+void TabCaptions::OnHidden(bool hidden, base::TimeTicks now) {
+  if (hidden && !hidden_) {
+    hidden_since_ = now;
+  }
+  hidden_ = hidden;
+  Recompute(now);
+}
+
+void TabCaptions::SetCaptionsOn(bool on, base::TimeTicks now) {
+  state_.captions_on = on;
+  state_.cant_caption = false;
+  state_.bar_visible = !audible_.empty() || on;
+  Recompute(now);
+}
+
+void TabCaptions::ChooseLanguage(const std::string& language) {
+  if (language != state_.language) {
+    state_.language = language;
+    state_.unit_ready = false;
+    state_.cant_caption = false;
+    state_.translation_ready = false;  // another pair, other models
+  }
+}
+
+void TabCaptions::SetTarget(const std::string& target, base::TimeTicks now) {
+  if (target != state_.target) {
+    state_.target = target;
+    state_.translation_ready = false;
+  }
+  Recompute(now);
+}
+
+void TabCaptions::OnTranslationReady(bool ready, base::TimeTicks now) {
+  state_.translation_ready = ready;
+  Recompute(now);
+}
+
+void TabCaptions::OnUnitReady(bool ready, base::TimeTicks now) {
+  if (state_.unit_ready && !ready) {
+    // Deleted (Settings): captions go off; the next tap downloads it again.
+    state_.captions_on = false;
+    state_.cant_caption = false;
+    state_.bar_visible = !audible_.empty();
+  }
+  state_.unit_ready = ready;
+  Recompute(now);
+}
+
+bool TabCaptions::OnAudio(uint64_t source, base::TimeTicks now) {
+  auto last = source_last_.find(source);
+  const bool starting = last == source_last_.end() || now - last->second > kSourceQuiet;
+  const bool current_quiet =
+      !source_ || (*source_ != source && now - source_last_[*source_] > kSourceQuiet);
+  if (starting || current_quiet) {
+    source_ = source;
+  }
+  source_last_[source] = now;
+  waiting_since_ = now;
+  state_.cant_caption = false;
+  Recompute(now);
+  return *source_ == source;
+}
+
+void TabCaptions::ForgetSource(uint64_t source) {
+  source_last_.erase(source);
+  if (source_ == source) {
+    source_.reset();
+  }
+}
+
+void TabCaptions::OnTick(base::TimeTicks now) {
+  if (forwarding_ && !audible_.empty() && !state_.cant_caption &&
+      now - waiting_since_ > kNoAudio) {
+    state_.cant_caption = true;
+  }
+  Recompute(now);
+}
+
+void TabCaptions::OnServiceGone() {
+  state_.captions_on = false;
+  state_.cant_caption = false;
+  Recompute(last_event_);
+}
+
+bool TabCaptions::ShouldForwardAudio() const {
+  return state_.captions_on && state_.unit_ready && !hidden_;
+}
+
+void TabCaptions::Recompute(base::TimeTicks now) {
+  last_event_ = now;
+  const bool forwarding = ShouldForwardAudio();
+  if (forwarding && !forwarding_) {
+    waiting_since_ = now;  // hidden or off time is not "no audio"
+  }
+  forwarding_ = forwarding;
+  // The process outlives a short hide and "can't caption" (a rebuffer), so
+  // that neither reloads the ~500 MB model; it goes after a long hide or a
+  // few minutes without audio.
+  bool wanted = state_.captions_on && state_.unit_ready;
+  if (hidden_) {
+    wanted = wanted && now - hidden_since_ < kHiddenGrace;
+  } else {
+    wanted = wanted && now - waiting_since_ < kIdleUnload;
+  }
+  if (wanted && !wanted_) {
+    ++engine_starts_;
+  }
+  wanted_ = wanted;
+}
+
+}  // namespace tark_captions
