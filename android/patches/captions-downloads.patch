+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/caption_downloads.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/strings/strcat.h"
+#include "base/task/thread_pool.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "net/base/net_errors.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "url/gurl.h"
+
+namespace tark_captions {
+namespace {
+
+using tark_xlit::Network;
+using tark_xlit::ShouldStartNow;
+
+constexpr base::TimeDelta kTimeout = base::Minutes(30);
+// For android/captions/e2e/run.py only: where the files are served instead
+// of gettarka.com (read from the command-line file on a debuggable device).
+constexpr char kBaseUrlSwitch[] = "tark-captions-models-url";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_captions_models", R"(
+      semantics {
+        sender: "Tark live captions"
+        description:
+          "Downloads the speech model of one language (AI4Bharat's "
+          "IndicConformer or NVIDIA's FastConformer) and Silero's speech "
+          "detector from gettarka.com, so that videos are captioned on the "
+          "phone. Nothing the person hears is sent anywhere."
+        trigger:
+          "The person turned on captions in a language whose model is not "
+          "on the phone yet. On Wi-Fi unless they chose to download now."
+        data: "None: no cookies, no identifiers, no query string."
+        destination: OTHER
+        destination_other: "gettarka.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > Accessibility > Live captions."
+        policy_exception_justification: "Tark has no enterprise policies."
+      })");
+
+Network CurrentNetwork() {
+  const auto type = net::NetworkChangeNotifier::GetConnectionType();
+  if (type == net::NetworkChangeNotifier::CONNECTION_NONE) {
+    return Network::kNone;
+  }
+  if (type == net::NetworkChangeNotifier::CONNECTION_WIFI ||
+      type == net::NetworkChangeNotifier::CONNECTION_ETHERNET) {
+    return Network::kUnmetered;
+  }
+  return Network::kMetered;
+}
+
+base::FilePath CaptionsDirectory() {
+  base::FilePath data;
+  base::PathService::Get(base::DIR_ANDROID_APP_DATA, &data);
+  return data.AppendASCII("captions");
+}
+
+std::vector<std::string> KnownUnits() {
+  std::vector<std::string> units;
+  for (const CaptionFile& file : AllFiles()) {
+    if (std::ranges::find(units, file.unit) == units.end()) {
+      units.emplace_back(file.unit);
+    }
+  }
+  return units;
+}
+
+bool CellularOk(std::string_view unit) {
+  const base::ListValue& units = g_browser_process->local_state()->GetList(kCellularOkPref);
+  return std::ranges::any_of(units, [&](const base::Value& v) {
+    return v.is_string() && v.GetString() == unit;
+  });
+}
+
+void SetCellularOk(std::string_view unit, bool ok) {
+  ScopedListPrefUpdate update(g_browser_process->local_state(), kCellularOkPref);
+  update->EraseValue(base::Value(unit));
+  if (ok) {
+    update->Append(unit);
+  }
+}
+
+// Checks a finished download, puts it in place and records its hash.
+bool VerifyAndPlace(const base::FilePath& part, const base::FilePath& target, CaptionFile file) {
+  return VerifyFile(part, file) && base::ReplaceFile(part, target, nullptr) &&
+         WriteRecord(target, file);
+}
+
+}  // namespace
+
+// static
+void CaptionDownloads::RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterListPref(kCellularOkPref);
+  registry->RegisterIntegerPref(kStylePref, 0);
+  registry->RegisterStringPref(kLanguagePref, std::string());
+  registry->RegisterStringPref(kTargetPref, std::string());
+  registry->RegisterDictionaryPref(kOwnersPref);
+}
+
+// static
+CaptionDownloads& CaptionDownloads::Get() {
+  static base::NoDestructor<CaptionDownloads> downloads;
+  return *downloads;
+}
+
+CaptionDownloads::CaptionDownloads()
+    : dir_(CaptionsDirectory()),
+      owners_(g_browser_process->local_state()->GetDict(kOwnersPref)) {
+  net::NetworkChangeNotifier::AddNetworkChangeObserver(this);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            std::map<std::string, std::vector<std::string>> present;
+            base::CreateDirectory(dir);
+            for (const std::string& unit : KnownUnits()) {
+              const base::FilePath unit_dir = dir.AppendASCII(unit);
+              if (base::DirectoryExists(unit_dir)) {
+                present[unit] = ScanUnit(unit_dir, unit);
+              }
+            }
+            return present;
+          },
+          dir_),
+      base::BindOnce(&CaptionDownloads::OnScanned, weak_factory_.GetWeakPtr()));
+}
+
+CaptionDownloads::~CaptionDownloads() {
+  net::NetworkChangeNotifier::RemoveNetworkChangeObserver(this);
+}
+
+void CaptionDownloads::OnScanned(std::map<std::string, std::vector<std::string>> present) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  for (auto& [unit, files] : present) {
+    present_[unit] = std::move(files);
+    if (Ready(unit)) {
+      LOG(WARNING) << "tark captions: ready " << unit;
+    }
+  }
+  scanned_ = true;
+  // A download Tark stopped in the middle (a restart) resumes: every unit a
+  // feature still wants and that is not in place, with its "Download now".
+  // Copied first: Enqueue() rewrites this list (SetCellularOk).
+  std::vector<std::string> cellular_ok;
+  for (const base::Value& unit : g_browser_process->local_state()->GetList(kCellularOkPref)) {
+    if (unit.is_string()) {
+      cellular_ok.push_back(unit.GetString());
+    }
+  }
+  for (const Resume& resume :
+       UnitsToResume(owners_, cellular_ok, [&](const std::string& u) { return Ready(u); })) {
+    LOG(WARNING) << "tark captions: resuming " << resume.unit;
+    Enqueue(resume.unit, resume.now);
+  }
+  MaybeDownloadNext();
+}
+
+bool CaptionDownloads::Ready(std::string_view unit) const {
+  auto it = present_.find(unit);
+  // A removal waiting for the captions process is not ready: tabs turn
+  // captions off and let it go, and Settings drops the row.
+  return it != present_.end() && UnitReady(unit, it->second) && !use_.Removing(unit);
+}
+
+void CaptionDownloads::Request(std::string_view unit, bool now, Owner owner) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (FilesOf(unit).empty()) {
+    return;
+  }
+  SetWantedBy(unit, owner, true);
+  // Removed while in use and wanted again before the release: its files are
+  // still here, so it is ready again with nothing fetched.
+  use_.CancelRemove(unit);
+  Enqueue(unit, now);
+}
+
+void CaptionDownloads::Enqueue(std::string_view unit, bool now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (FilesOf(unit).empty()) {
+    return;
+  }
+  for (const std::string& u : UnitsToFetch(unit)) {
+    failed_.erase(u);
+  }
+  // A ready unit is never fetched again (voice asking for the detector that
+  // captions already has); one being removed is not queued.
+  for (std::string& u : UnitsToQueue(
+           unit, [&](const std::string& x) { return Ready(x); },
+           [&](const std::string& x) { return use_.Removing(x); }, queue_)) {
+    queue_.push_back(std::move(u));
+  }
+  if (now) {
+    for (const std::string& u : UnitsToFetch(unit)) {
+      if (std::ranges::find(queue_, u) != queue_.end()) {
+        SetCellularOk(u, true);
+      }
+    }
+  }
+  g_browser_process->local_state()->CommitPendingWrite();
+  // The person asked again: a spent budget starts over.
+  failures_ = 0;
+  refused_ = false;
+  retry_timer_.Stop();
+  Notify(std::string(unit));
+  MaybeDownloadNext();
+}
+
+void CaptionDownloads::Cancel(std::string_view unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Captions no longer want it; a download another feature wants goes on.
+  SetWantedBy(unit, Owner::kCaptions, false);
+  if (owners_.Wanted(unit)) {
+    Notify(std::string(unit));
+    return;
+  }
+  Abort(unit);
+}
+
+void CaptionDownloads::Abort(std::string_view unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  std::erase(queue_, std::string(unit));
+  SetCellularOk(unit, false);
+  if (current_ && current_->unit == unit) {
+    ++generation_;  // its .part file is removed at the next start
+    loader_.reset();
+    current_ = nullptr;
+  }
+  Notify(std::string(unit));
+  MaybeDownloadNext();
+}
+
+void CaptionDownloads::Remove(std::string_view unit) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const Removal removal = DecideRemoval(unit, owners_, use_);
+  if (removal == Removal::kKeep) {
+    // Another feature still wants it (the detector, for captions or voice):
+    // its files and any download of it stay.
+    Notify(std::string(unit));
+    return;
+  }
+  Abort(unit);
+  if (removal == Removal::kNow) {
+    DeleteUnit(std::string(unit));
+  } else {
+    Notify(std::string(unit));  // in use: tabs see it is no longer ready
+  }
+}
+
+void CaptionDownloads::SetWantedBy(std::string_view unit, Owner owner, bool wanted) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (owners_.SetWanted(unit, owner, wanted)) {
+    g_browser_process->local_state()->SetDict(kOwnersPref, owners_.ToDict());
+  }
+}
+
+void CaptionDownloads::SetInUse(std::string_view unit, bool in_use) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (in_use) {
+    use_.SetInUse(unit, true);
+    return;
+  }
+  if (ReleaseDeletes(unit, owners_, use_)) {
+    DeleteUnit(std::string(unit));
+  }
+}
+
+void CaptionDownloads::DeleteUnit(const std::string& unit) {
+  present_.erase(unit);
+  base::ThreadPool::PostTask(FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+                             base::GetDeletePathRecursivelyCallback(UnitDir(unit)));
+  Notify(unit);
+}
+
+CaptionDownloads::UnitState CaptionDownloads::State(std::string_view unit) const {
+  UnitState state;
+  for (const std::string& u : UnitsToFetch(unit)) {
+    if (Ready(u)) {
+      continue;
+    }
+    for (const CaptionFile* file : FilesOf(u)) {
+      state.total += file->size;
+    }
+  }
+  if (state.total == 0) {
+    state.state = State::kReady;
+    for (const CaptionFile* file : FilesOf(unit)) {
+      state.total += file->size;
+    }
+    return state;
+  }
+  auto present_bytes = [&](const std::string& u) {
+    int64_t bytes = 0;
+    auto it = present_.find(u);
+    for (const CaptionFile* file : FilesOf(u)) {
+      if (it != present_.end() && std::ranges::find(it->second, file->name) != it->second.end()) {
+        bytes += file->size;
+      }
+    }
+    return bytes;
+  };
+  const bool queued = std::ranges::any_of(UnitsToFetch(unit), [&](const std::string& u) {
+    return std::ranges::find(queue_, u) != queue_.end();
+  });
+  const std::vector<std::string> fetch = UnitsToFetch(unit);
+  if (std::ranges::any_of(fetch, [&](const std::string& u) { return failed_.contains(u); })) {
+    state.state = State::kFailed;
+  } else if (queued && current_ && std::ranges::contains(UnitsToFetch(unit), current_->unit)) {
+    state.state = State::kDownloading;
+  } else if (queued) {
+    state.state = State::kWaitingForWifi;
+    state.retrying = retry_timer_.IsRunning();
+  }
+  for (const std::string& u : UnitsToFetch(unit)) {
+    if (!Ready(u)) {
+      state.bytes += present_bytes(u);
+    }
+  }
+  if (current_ && std::ranges::contains(fetch, current_->unit)) {
+    state.bytes += current_bytes_;
+  }
+  return state;
+}
+
+std::map<std::string, int64_t> CaptionDownloads::ReadyUnits() const {
+  std::map<std::string, int64_t> units;
+  for (const auto& [unit, files] : present_) {
+    if (unit != "common" && unit != kLanguageIdUnit && Ready(unit)) {
+      int64_t size = 0;
+      for (const CaptionFile* file : FilesOf(unit)) {
+        size += file->size;
+      }
+      units[unit] = size;
+    }
+  }
+  return units;
+}
+
+base::FilePath CaptionDownloads::UnitDir(std::string_view unit) const {
+  return dir_.AppendASCII(unit);
+}
+
+void CaptionDownloads::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void CaptionDownloads::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void CaptionDownloads::Notify(const std::string& unit) {
+  for (Observer& observer : observers_) {
+    observer.OnUnitChanged(unit);
+  }
+}
+
+void CaptionDownloads::OnNetworkChanged(net::NetworkChangeNotifier::ConnectionType type) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (type == net::NetworkChangeNotifier::CONNECTION_NONE ||
+      (current_ && type == fetch_network_)) {
+    // None: the fetch in flight fails and waits for the next network. The
+    // same kind of network as the fetch's: it goes on.
+    return;
+  }
+  // A new network: a fetch still on the old one starts again on a fresh
+  // loader, the budget starts over, and connections pinned to the old network
+  // (a QUIC session: ERR_QUIC_PROTOCOL_ERROR after Wi-Fi came back) are
+  // closed first.
+  if (current_) {
+    const std::string unit(current_->unit);
+    ++generation_;  // its .part file is removed at the next start
+    loader_.reset();
+    current_ = nullptr;
+    current_bytes_ = 0;
+    Notify(unit);
+  }
+  failures_ = 0;
+  failed_.clear();
+  retry_timer_.Stop();
+  RestartAfterClosingConnections();
+}
+
+void CaptionDownloads::RestartAfterClosingConnections() {
+  SystemNetworkContextManager* manager = SystemNetworkContextManager::GetInstance();
+  if (!manager) {
+    MaybeDownloadNext();
+    return;
+  }
+  manager->GetContext()->CloseAllConnections(
+      base::BindOnce(&CaptionDownloads::MaybeDownloadNext, weak_factory_.GetWeakPtr()));
+}
+
+bool CaptionDownloads::GaveUp() const {
+  return refused_ || (failures_ > 0 && !RetryDelay(failures_));
+}
+
+void CaptionDownloads::MaybeDownloadNext() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!scanned_ || current_ || retry_timer_.IsRunning() || GaveUp()) {
+    return;
+  }
+  std::vector<std::string> done;
+  std::erase_if(queue_, [&](const std::string& unit) {
+    if (!Ready(unit)) {
+      return false;
+    }
+    done.push_back(unit);
+    return true;
+  });
+  for (const std::string& unit : done) {
+    SetCellularOk(unit, false);
+    LOG(WARNING) << "tark captions: ready " << unit;
+    Notify(unit);
+  }
+  if (current_) {
+    return;  // a Notify above may have started the next one
+  }
+  const std::optional<std::string> next = NextToFetch(queue_, [&](const std::string& unit) {
+    return !use_.Removing(unit) && ShouldStartNow(CurrentNetwork(), CellularOk(unit));
+  });
+  if (!next) {
+    return;
+  }
+  const std::string unit = *next;
+  const std::vector<std::string>& present = present_[unit];
+  for (const CaptionFile* file : FilesOf(unit)) {
+    if (std::ranges::find(present, file->name) == present.end()) {
+      current_ = file;
+      break;
+    }
+  }
+  if (!current_) {
+    // Nothing missing yet not ready: drop it rather than fetch nothing.
+    std::erase(queue_, unit);
+    Notify(unit);
+    return;
+  }
+  current_bytes_ = 0;
+  fetch_network_ = net::NetworkChangeNotifier::GetConnectionType();
+  const uint64_t generation = ++generation_;
+  base::CreateDirectory(UnitDir(unit));
+  auto request = std::make_unique<network::ResourceRequest>();
+  const base::CommandLine& command_line = *base::CommandLine::ForCurrentProcess();
+  request->url = command_line.HasSwitch(kBaseUrlSwitch)
+                     ? GURL(base::StrCat({command_line.GetSwitchValueASCII(kBaseUrlSwitch),
+                                          current_->sha256, ".bin"}))
+                     : GURL(FileUrl(*current_));
+  LOG(WARNING) << "tark captions: downloading " << unit << "/" << current_->name;
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kTimeout);
+  // The files are served as they are; a redirect anywhere is refused.
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<CaptionDownloads> self, const GURL&, const net::RedirectInfo&,
+         const network::mojom::URLResponseHead&, std::vector<std::string>*) {
+        if (self) {
+          self->loader_.reset();
+          if (self->current_) {
+            self->failed_[std::string(self->current_->unit)] = true;
+            self->Notify(std::string(self->current_->unit));
+          }
+          self->current_ = nullptr;
+          self->refused_ = true;
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->SetOnDownloadProgressCallback(
+      base::BindRepeating(&CaptionDownloads::OnProgress, weak_factory_.GetWeakPtr()));
+  loader_->DownloadToFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&CaptionDownloads::OnDownloaded, weak_factory_.GetWeakPtr(), generation,
+                     current_),
+      UnitDir(unit).AppendASCII(PartFileName(current_->name, generation)), current_->size);
+}
+
+void CaptionDownloads::OnProgress(uint64_t current) {
+  current_bytes_ = static_cast<int64_t>(current);
+  if (current_) {
+    Notify(std::string(current_->unit));
+  }
+}
+
+void CaptionDownloads::OnDownloaded(uint64_t generation,
+                                    const CaptionFile* file,
+                                    base::FilePath part) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (generation != generation_) {
+    return;
+  }
+  const int error = loader_ ? loader_->NetError() : net::ERR_ABORTED;
+  loader_.reset();
+  if (error != net::OK || part.empty()) {
+    LOG(WARNING) << "tark captions: " << file->name << " failed: " << net::ErrorToString(error);
+    OnVerified(generation, file, false);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&VerifyAndPlace, part,
+                     UnitDir(file->unit).AppendASCII(std::string(file->name)), *file),
+      base::BindOnce(&CaptionDownloads::OnVerified, weak_factory_.GetWeakPtr(), generation,
+                     file));
+}
+
+void CaptionDownloads::OnVerified(uint64_t generation, const CaptionFile* file, bool ok) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (generation != generation_) {
+    return;  // cancelled meanwhile
+  }
+  current_ = nullptr;
+  current_bytes_ = 0;
+  const std::string unit(file->unit);
+  if (ok) {
+    present_[unit].emplace_back(file->name);
+    std::ranges::sort(present_[unit]);
+    Notify(unit);
+    MaybeDownloadNext();
+    return;
+  }
+  LOG(WARNING) << "tark captions: " << file->name << " not accepted";
+  if (const std::optional<base::TimeDelta> delay = RetryDelay(++failures_)) {
+    // Again on fresh connections: a broken one (QUIC) is not reused.
+    retry_timer_.Start(FROM_HERE, *delay,
+                       base::BindOnce(&CaptionDownloads::RestartAfterClosingConnections,
+                                      weak_factory_.GetWeakPtr()));
+  } else {
+    failed_[unit] = true;
+  }
+  Notify(unit);
+}
+
+}  // namespace tark_captions
