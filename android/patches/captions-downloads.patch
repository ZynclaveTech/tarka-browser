+
+class TabCaptionsTest : public testing::Test {
+ protected:
+  base::TimeTicks At(double seconds) { return start_ + base::Seconds(seconds); }
+
+  // A video plays with sound, captions are turned on, the model is ready.
+  void Captioning() {
+    tab_.OnPlayerAudible(1, true, At(0));
+    tab_.ChooseLanguage("hi");
+    tab_.SetCaptionsOn(true, At(1));
+    tab_.OnUnitReady(true, At(1));
+  }
+
+  const base::TimeTicks start_ = base::TimeTicks() + base::Seconds(100);
+  TabCaptions tab_;
+};
+
+TEST_F(TabCaptionsTest, BarShowsOnlyForAudiblePlayer) {
+  EXPECT_FALSE(tab_.state().bar_visible);
+  tab_.OnPlayerAudible(1, false, At(0));  // muted or silent
+  EXPECT_FALSE(tab_.state().bar_visible);
+  tab_.OnPlayerAudible(1, true, At(0));
+  EXPECT_TRUE(tab_.state().bar_visible);
+  // Nothing listens until a tap.
+  EXPECT_FALSE(tab_.ShouldForwardAudio());
+  EXPECT_FALSE(tab_.WantsEngine());
+}
+
+TEST_F(TabCaptionsTest, CaptionsOffForwardsNoAudio) {
+  Captioning();
+  EXPECT_TRUE(tab_.ShouldForwardAudio());
+  tab_.SetCaptionsOn(false, At(2));
+  EXPECT_FALSE(tab_.ShouldForwardAudio());
+  EXPECT_FALSE(tab_.WantsEngine());
+}
+
+TEST_F(TabCaptionsTest, CaptionsWaitForTheModel) {
+  tab_.OnPlayerAudible(1, true, At(0));
+  tab_.ChooseLanguage("ta");
+  tab_.SetCaptionsOn(true, At(1));
+  EXPECT_FALSE(tab_.ShouldForwardAudio());  // "Getting Tamil ready"
+  tab_.OnUnitReady(true, At(30));
+  EXPECT_TRUE(tab_.ShouldForwardAudio());
+}
+
+// Android's own player (HLS, a cast) never reaches the renderer's hook.
+TEST_F(TabCaptionsTest, NoAudioForTenSecondsShowsCantCaption) {
+  Captioning();
+  tab_.OnTick(At(10.5));
+  EXPECT_FALSE(tab_.state().cant_caption);
+  tab_.OnTick(At(11.5));
+  EXPECT_TRUE(tab_.state().cant_caption);
+  // The model stays loaded: a long rebuffer is no reason to reload it.
+  EXPECT_TRUE(tab_.WantsEngine());
+  // Audio after all (a seek, an ad ending) clears it.
+  tab_.OnAudio(1, At(12));
+  EXPECT_FALSE(tab_.state().cant_caption);
+  EXPECT_EQ(tab_.engine_starts(), 1);
+}
+
+TEST_F(TabCaptionsTest, AudioKeepsCantCaptionAway) {
+  Captioning();
+  for (double t = 1.5; t < 30; t += 1) {
+    tab_.OnAudio(1, At(t));
+    tab_.OnTick(At(t + 0.5));
+  }
+  EXPECT_FALSE(tab_.state().cant_caption);
+}
+
+TEST_F(TabCaptionsTest, SecondPlayerDoesNotLoadSecondEngine) {
+  Captioning();
+  EXPECT_EQ(tab_.engine_starts(), 1);
+  tab_.OnPlayerAudible(2, true, At(5));  // an ad, an iframe
+  tab_.OnPlayerAudible(1, false, At(6));
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_EQ(tab_.engine_starts(), 1);
+}
+
+// Several players can send audio (an ad iframe and the video); captions
+// follow one, the most recently started, never a mix of both.
+TEST_F(TabCaptionsTest, OneSourceAtATime) {
+  Captioning();
+  EXPECT_TRUE(tab_.OnAudio(/*source=*/7, At(2)));
+  EXPECT_TRUE(tab_.OnAudio(7, At(2.1)));
+  EXPECT_TRUE(tab_.OnAudio(9, At(2.2)));   // a second player starts: it wins
+  EXPECT_FALSE(tab_.OnAudio(7, At(2.3)));  // the first keeps going: dropped
+  EXPECT_TRUE(tab_.OnAudio(9, At(2.4)));
+  EXPECT_FALSE(tab_.OnAudio(7, At(2.5)));
+}
+
+TEST_F(TabCaptionsTest, QuietSourceHandsOver) {
+  Captioning();
+  const double quiet = TabCaptions::kSourceQuiet.InSecondsF();
+  EXPECT_TRUE(tab_.OnAudio(7, At(2)));
+  EXPECT_TRUE(tab_.OnAudio(9, At(2.1)));
+  EXPECT_FALSE(tab_.OnAudio(7, At(2.2)));
+  // 9 stops (the ad ended); 7 still plays.
+  EXPECT_FALSE(tab_.OnAudio(7, At(2.1 + quiet / 2)));
+  EXPECT_TRUE(tab_.OnAudio(7, At(2.1 + quiet + 0.1)));
+}
+
+TEST_F(TabCaptionsTest, ForgottenSourceHandsOver) {
+  Captioning();
+  EXPECT_TRUE(tab_.OnAudio(7, At(2)));
+  EXPECT_TRUE(tab_.OnAudio(9, At(2.1)));
+  tab_.ForgetSource(9);  // its player went away
+  EXPECT_TRUE(tab_.OnAudio(7, At(2.2)));
+}
+
+TEST_F(TabCaptionsTest, HiddenTabForwardsNoAudio) {
+  Captioning();
+  tab_.OnHidden(true, At(3));
+  EXPECT_FALSE(tab_.ShouldForwardAudio());
+  tab_.OnTick(At(30));  // hidden time is not "no audio"
+  tab_.OnHidden(false, At(31));
+  EXPECT_TRUE(tab_.ShouldForwardAudio());
+  EXPECT_FALSE(tab_.state().cant_caption);
+}
+
+// Home, the lock screen, the tab switcher, Settings: back within a minute,
+// captions go on without reloading the model.
+TEST_F(TabCaptionsTest, BriefHideKeepsTheEngine) {
+  Captioning();
+  tab_.OnAudio(1, At(2));
+  tab_.OnHidden(true, At(3));
+  tab_.OnTick(At(3 + TabCaptions::kHiddenGrace.InSecondsF() - 1));
+  EXPECT_TRUE(tab_.WantsEngine());
+  tab_.OnHidden(false, At(3 + TabCaptions::kHiddenGrace.InSecondsF() - 0.5));
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_EQ(tab_.engine_starts(), 1);
+}
+
+TEST_F(TabCaptionsTest, LongHideStopsTheEngine) {
+  Captioning();
+  tab_.OnHidden(true, At(3));
+  tab_.OnTick(At(3 + TabCaptions::kHiddenGrace.InSecondsF() + 1));
+  EXPECT_FALSE(tab_.WantsEngine());
+  tab_.OnHidden(false, At(200));  // back: a new process
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_EQ(tab_.engine_starts(), 2);
+}
+
+// A paused video, or a page without media, with captions left on: the
+// ~500 MB model is unloaded after a few minutes without audio.
+TEST_F(TabCaptionsTest, IdleUnloadsTheEngine) {
+  Captioning();
+  tab_.OnAudio(1, At(2));
+  const double idle = TabCaptions::kIdleUnload.InSecondsF();
+  tab_.OnTick(At(2 + idle - 1));
+  EXPECT_TRUE(tab_.WantsEngine());
+  tab_.OnTick(At(2 + idle + 1));
+  EXPECT_FALSE(tab_.WantsEngine());
+  EXPECT_TRUE(tab_.ShouldForwardAudio());  // so that audio can bring it back
+  EXPECT_TRUE(tab_.state().captions_on);
+  tab_.OnAudio(1, At(2 + idle + 30));  // play again
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_EQ(tab_.engine_starts(), 2);
+}
+
+// The language is deleted in Settings: captions go off, the chip stays, and
+// the next tap offers the download again (no card stuck without a button).
+TEST_F(TabCaptionsTest, UnitRemovedTurnsCaptionsOff) {
+  Captioning();
+  tab_.OnUnitReady(false, At(4));
+  EXPECT_FALSE(tab_.state().captions_on);
+  EXPECT_EQ(tab_.state().language, "hi");
+  EXPECT_FALSE(tab_.ShouldForwardAudio());
+  EXPECT_FALSE(tab_.WantsEngine());
+}
+
+// Choosing a language not yet on the phone is not a removal.
+TEST_F(TabCaptionsTest, NewLanguageIsNotARemoval) {
+  Captioning();
+  tab_.ChooseLanguage("ta");
+  tab_.OnUnitReady(false, At(5));
+  EXPECT_TRUE(tab_.state().captions_on);  // "Getting Tamil ready"
+  EXPECT_FALSE(tab_.WantsEngine());
+}
+
+TEST_F(TabCaptionsTest, ServiceDisconnectTurnsCaptionsOff) {
+  Captioning();
+  tab_.OnServiceGone();
+  EXPECT_FALSE(tab_.state().captions_on);
+  EXPECT_EQ(tab_.state().language, "hi");  // the chip stays
+  EXPECT_FALSE(tab_.WantsEngine());
+  tab_.SetCaptionsOn(true, At(9));  // the next tap starts a new process
+  EXPECT_TRUE(tab_.WantsEngine());
+  EXPECT_EQ(tab_.engine_starts(), 2);
+}
+
+// Translate on, the speech model here, the translation model not yet:
+// captions run untranslated; when it arrives, translation starts without a
