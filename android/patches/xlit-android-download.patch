+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_XLIT_XLIT_FILES_H_
+#define CHROME_BROWSER_TARK_XLIT_XLIT_FILES_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace tark_xlit {
+
+// Tark for Android (A3, spec §5): the IndicXlit files the phone downloads from
+// gettarka.com, each pinned in the APK by its size and sha256
+// (android/xlit/files.py writes the table, xlit_files.inc, at build time).
+struct XlitFile {
+  std::string_view name;
+  int64_t size;
+  std::string_view sha256;  // Lower-case hex.
+};
+
+inline constexpr char kModelFileName[] = "xlit-model.bin";
+
+// Every file, the model and one word list per language.
+base::span<const XlitFile> AllFiles();
+const XlitFile* FindFile(std::string_view name);
+// "xlit-words-<tag>.bin".
+std::string WordsFileName(std::string_view tag);
+// Where `file` is published: content-addressed, so a URL never changes what
+// it serves. https://gettarka.com/xlit/android/v1/<sha256>.bin
+std::string FileUrl(const XlitFile& file);
+
+// Whether `path` is `file`: its size, then its sha256. A file that is not is
+// deleted. Blocking.
+bool VerifyFile(const base::FilePath& path, const XlitFile& file);
+
+// What is in `dir`, by name: the table's files of the right size (the hash was
+// checked when each was downloaded). Deletes what a download left unfinished
+// (*.part) and table files of the wrong size. Blocking.
+std::vector<std::string> ScanDirectory(const base::FilePath& dir);
+
+// The files to download for the languages `tags`, the model first, leaving out
+// the files in `present` and tags with no word list.
+std::vector<const XlitFile*> Missing(const std::vector<std::string>& present,
+                                     const std::vector<std::string>& tags);
+// Their total size in bytes.
+int64_t DownloadSize(const std::vector<std::string>& present,
+                     const std::vector<std::string>& tags);
+
+// Whether rows can work: the model and at least one word list are present.
+bool Ready(const std::vector<std::string>& present);
+
+enum class Network { kNone, kUnmetered, kMetered };
+// Whether a download may start: on Wi-Fi or Ethernet, or on mobile data when
+// the person chose "Download now".
+bool ShouldStartNow(Network network, bool now);
+
+// At most three tries of a failed file per run of the browser.
+class Attempts {
+ public:
+  bool TryAgain();
+  void Reset() { count_ = 0; }
+
+ private:
+  int count_ = 0;
+};
+
+}  // namespace tark_xlit
+
+#endif  // CHROME_BROWSER_TARK_XLIT_XLIT_FILES_H_
