+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_xlit/xlit_files.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_xlit {
+namespace {
+
+// sha256("abc").
+constexpr char kAbcSha256[] =
+    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+
+class TarkXlitFilesTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  base::FilePath Write(std::string_view name, std::string_view data) {
+    const base::FilePath path = dir_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::WriteFile(path, data));
+    return path;
+  }
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(TarkXlitFilesTest, TheTableHasTheModelAndEveryLanguage) {
+  ASSERT_TRUE(FindFile(kModelFileName));
+  for (const char* tag : {"hi", "ta", "bn", "gom", "ur"}) {
+    EXPECT_TRUE(FindFile(WordsFileName(tag))) << tag;
+  }
+  EXPECT_FALSE(FindFile(WordsFileName("si")));
+  for (const XlitFile& file : AllFiles()) {
+    EXPECT_GT(file.size, 0) << file.name;
+    EXPECT_EQ(file.sha256.size(), 64u) << file.name;
+  }
+}
+
+TEST_F(TarkXlitFilesTest, AMatchingFileIsKept) {
+  const XlitFile file{"x.bin", 3, kAbcSha256};
+  const base::FilePath path = Write("x.bin", "abc");
+  EXPECT_TRUE(VerifyFile(path, file));
+  EXPECT_TRUE(base::PathExists(path));
+}
+
+TEST_F(TarkXlitFilesTest, HashMismatchDeletesFile) {
+  const XlitFile file{"x.bin", 3, kAbcSha256};
+  const base::FilePath path = Write("x.bin", "abd");
+  EXPECT_FALSE(VerifyFile(path, file));
+  EXPECT_FALSE(base::PathExists(path));
+}
+
+TEST_F(TarkXlitFilesTest, SizeMismatchDeletesFile) {
+  const XlitFile file{"x.bin", 3, kAbcSha256};
+  const base::FilePath path = Write("x.bin", "abcd");
+  EXPECT_FALSE(VerifyFile(path, file));
+  EXPECT_FALSE(base::PathExists(path));
+  EXPECT_FALSE(VerifyFile(dir_.GetPath().AppendASCII("missing.bin"), file));
+}
+
+TEST_F(TarkXlitFilesTest, PartialFileIsIgnoredAndRemoved) {
+  const XlitFile* model = FindFile(kModelFileName);
+  ASSERT_TRUE(model);
+  const base::FilePath part = Write("xlit-model.bin.part", "half");
+  Write("unrelated.txt", "x");
+  EXPECT_TRUE(ScanDirectory(dir_.GetPath()).empty());
+  EXPECT_FALSE(base::PathExists(part));
+  EXPECT_TRUE(base::PathExists(dir_.GetPath().AppendASCII("unrelated.txt")));
+}
+
+TEST_F(TarkXlitFilesTest, ScanKeepsOnlyFilesOfTheRightSize) {
+  // A file of the wrong size is from an older table or was cut short.
+  const base::FilePath words = Write(WordsFileName("hi"), "too short");
+  EXPECT_TRUE(ScanDirectory(dir_.GetPath()).empty());
+  EXPECT_FALSE(base::PathExists(words));
+}
+
+TEST_F(TarkXlitFilesTest, MissingListsOnlyTheAbsent) {
+  const std::vector<std::string> tags = {"hi", "ta", "xx"};
+  std::vector<const XlitFile*> missing = Missing({}, tags);
+  ASSERT_EQ(missing.size(), 3u);
+  EXPECT_EQ(missing[0]->name, kModelFileName);  // The model first.
+  EXPECT_EQ(missing[1]->name, WordsFileName("hi"));
+  EXPECT_EQ(missing[2]->name, WordsFileName("ta"));
+
+  missing = Missing({std::string(kModelFileName), WordsFileName("hi")}, tags);
+  ASSERT_EQ(missing.size(), 1u);
+  EXPECT_EQ(missing[0]->name, WordsFileName("ta"));
+}
+
+TEST_F(TarkXlitFilesTest, ReadyNeedsTheModelAndAWordList) {
+  EXPECT_FALSE(Ready({}));
+  EXPECT_FALSE(Ready({std::string(kModelFileName)}));
+  EXPECT_FALSE(Ready({WordsFileName("hi")}));
+  EXPECT_TRUE(Ready({std::string(kModelFileName), WordsFileName("hi")}));
+}
+
+TEST_F(TarkXlitFilesTest, WaitsForWifi) {
+  EXPECT_FALSE(ShouldStartNow(Network::kNone, /*now=*/false));
+  EXPECT_FALSE(ShouldStartNow(Network::kNone, /*now=*/true));
+  EXPECT_FALSE(ShouldStartNow(Network::kMetered, /*now=*/false));
+  EXPECT_TRUE(ShouldStartNow(Network::kMetered, /*now=*/true));
+  EXPECT_TRUE(ShouldStartNow(Network::kUnmetered, /*now=*/false));
+}
+
+TEST_F(TarkXlitFilesTest, RetriesAtMostThreeTimes) {
+  Attempts attempts;
+  EXPECT_TRUE(attempts.TryAgain());
+  EXPECT_TRUE(attempts.TryAgain());
+  EXPECT_TRUE(attempts.TryAgain());
+  EXPECT_FALSE(attempts.TryAgain());
+  attempts.Reset();
+  EXPECT_TRUE(attempts.TryAgain());
+}
+
+TEST_F(TarkXlitFilesTest, DownloadSizeCountsOnlyWhatIsMissing) {
+  const int64_t model = FindFile(kModelFileName)->size;
+  const int64_t hi = FindFile(WordsFileName("hi"))->size;
+  EXPECT_EQ(DownloadSize({}, {"hi"}), model + hi);
+  EXPECT_EQ(DownloadSize({std::string(kModelFileName)}, {"hi"}), hi);
+}
+
+TEST_F(TarkXlitFilesTest, UrlIsContentAddressed) {
+  const XlitFile file{"x.bin", 3, kAbcSha256};
+  EXPECT_EQ(FileUrl(file),
+            "https://gettarka.com/xlit/android/v1/" + std::string(kAbcSha256) +
+                ".bin");
+}
+
+// Settings > Languages: a language added after saying yes downloads its list;
+// one removed keeps its file.
+TEST_F(TarkXlitFilesTest, AddedLanguageDownloadsItsList) {
+  const std::vector<std::string> present = {std::string(kModelFileName),
+                                            WordsFileName("hi")};
+  std::vector<const XlitFile*> missing = Missing(present, {"hi", "ta"});
+  ASSERT_EQ(missing.size(), 1u);
+  EXPECT_EQ(missing[0]->name, WordsFileName("ta"));
+}
+
+TEST_F(TarkXlitFilesTest, RemovedLanguageKeepsItsFile) {
+  const XlitFile* ta = FindFile(WordsFileName("ta"));
+  ASSERT_TRUE(ta);
+  // ScanDirectory checks sizes only; a list no longer wanted stays.
+  Write(WordsFileName("ta"), std::string(static_cast<size_t>(ta->size), '\0'));
+  EXPECT_EQ(ScanDirectory(dir_.GetPath()),
+            std::vector<std::string>{WordsFileName("ta")});
+  EXPECT_TRUE(Missing({WordsFileName("ta")}, {"hi"}).size() == 2u);
+}
+
+}  // namespace
+}  // namespace tark_xlit
