+      "//base",
+      "//base/test:run_all_unittests",
+      "//base/test:test_support",
+      "//testing/gtest",
+    ]
+  }
+}
+
+if (current_toolchain == default_toolchain) {
+  group("host_unittests") {
+    testonly = true
+    deps = [ ":tark_xlit_files_unittests($host_toolchain)" ]
+  }
+}
