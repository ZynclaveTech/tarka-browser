+
+/**
+ * Tark for Android (A3, spec §5): what the address bar's "Type in हिन्दी?" row opens. It asks once
+ * whether to download the suggestions, on Wi-Fi (the default) or now; "No thanks" hides the row,
+ * and Settings > Languages turns it on later.
+ */
+@NullMarked
+public final class TarkXlitOffer {
+    private TarkXlitOffer() {}
+
+    /**
+     * @param tag The row language, such as "hi".
+     * @param languageName Its own name, such as "हिन्दी".
+     */
+    public static void show(Context context, String tag, String languageName) {
+        String size = Formatter.formatShortFileSize(context, TarkXlitBridge.getDownloadSize(""));
+        new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(context.getString(R.string.tark_xlit_offer, languageName))
+                .setMessage(context.getString(R.string.tark_xlit_offer_message, languageName, size))
+                .setPositiveButton(
+                        R.string.tark_xlit_download_on_wifi,
+                        (dialog, which) -> TarkXlitBridge.accept(/* now= */ false))
+                .setNeutralButton(
+                        R.string.tark_xlit_download_now,
+                        (dialog, which) -> TarkXlitBridge.accept(/* now= */ true))
+                .setNegativeButton(
+                        R.string.tark_xlit_no_thanks, (dialog, which) -> TarkXlitBridge.decline())
+                .show();
+    }
+}
