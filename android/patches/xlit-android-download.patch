+#ifndef CHROME_BROWSER_TARK_XLIT_XLIT_DOWNLOAD_SERVICE_H_
+#define CHROME_BROWSER_TARK_XLIT_XLIT_DOWNLOAD_SERVICE_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/sequence_checker.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/tark_xlit/xlit_files.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/tark_xlit/languages.h"
+#include "net/base/network_change_notifier.h"
+
+class PrefRegistrySimple;
+
+namespace network {
+class SimpleURLLoader;
+}  // namespace network
+
+namespace tark_xlit {
+
+// Local state: OfferState (components/tark_xlit/languages.h), and whether the
+// person chose "Download now" for the download that is not finished.
+inline constexpr char kOfferStatePref[] = "tark.xlit.offer";
+inline constexpr char kCellularOkPref[] = "tark.xlit.cellular_ok";
+
+// Tark for Android (A3, spec §5): downloads IndicXlit's model and the word
+// lists of the person's Indian languages into the app's data directory, after
+// they say yes, on Wi-Fi unless they chose "Now". One per browser process, on
+// the UI thread. Nothing is fetched until the person accepts; nothing is ever
+// fetched while typing.
+class XlitDownloadService
+    : public net::NetworkChangeNotifier::NetworkChangeObserver {
+ public:
+  static void RegisterPrefs(PrefRegistrySimple* registry);
+  // Created at browser start (chrome_browser_main_android.cc).
+  static XlitDownloadService& Get();
+
+  XlitDownloadService(const XlitDownloadService&) = delete;
+  XlitDownloadService& operator=(const XlitDownloadService&) = delete;
+
+  // The person said yes (the offer row's dialog, or the switch in Settings →
+  // Languages): their row languages, on Wi-Fi, or now on any network.
+  void Accept(bool now);
+  // The person said no, or turned the switch off: no rows, no offer row. The
+  // files stay, so that turning it on again is instant.
+  void Decline();
+
+  OfferState offer_state() const;
+  // The languages whose word list is in place, by tag.
+  std::vector<std::string> DownloadedLanguages() const;
+  // The same, by their own names ("हिन्दी"), in UTF-8, for Settings.
+  std::vector<std::string> DownloadedLanguageNames() const;
+  // Accepted, something left to download, and waiting for Wi-Fi.
+  bool IsWaitingForWifi() const;
+  // Bytes still to download for the row languages, or for `tag` if given.
+  int64_t DownloadSize(const std::string& tag) const;
+
+ private:
+  friend class base::NoDestructor<XlitDownloadService>;
+  XlitDownloadService();
+  ~XlitDownloadService() override;
+
+  // NetworkChangeObserver:
+  void OnNetworkChanged(
+      net::NetworkChangeNotifier::ConnectionType type) override;
+
+  void OnScanned(std::vector<std::string> present);
+  // The person's row languages (RowLanguages of the profile's accept
+  // languages), by tag.
+  std::vector<std::string> WantedTags() const;
+  void OnAcceptLanguagesChanged();
+  // Watches the profile's accept languages once a profile is loaded.
+  void EnsureObservingLanguages();
+  // Starts the next missing file if allowed; no-op while one is running.
+  void MaybeDownloadNext();
+  void OnDownloaded(const XlitFile* file, base::FilePath part);
+  void OnVerified(const XlitFile* file, bool ok);
+  void UpdateFilesReady();
+
+  SEQUENCE_CHECKER(sequence_checker_);
+  const base::FilePath dir_;
+  bool scanned_ = false;
+  std::vector<std::string> present_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  // The file `loader_` (or the check after it) is working on.
+  const XlitFile* current_ = nullptr;
+  Attempts attempts_;
+  base::OneShotTimer retry_timer_;
+  PrefChangeRegistrar accept_languages_;
+  base::WeakPtrFactory<XlitDownloadService> weak_factory_{this};
+};
+
+}  // namespace tark_xlit
+
+#endif  // CHROME_BROWSER_TARK_XLIT_XLIT_DOWNLOAD_SERVICE_H_
