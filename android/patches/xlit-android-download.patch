+// For android/xlit/e2e/run.py only: where the files are served instead of
+// gettarka.com. Chrome reads command-line flags from a file only on a
+// debuggable or rooted device, as with A2's --tark-adblock-extra-list.
+constexpr char kBaseUrlSwitch[] = "tark-xlit-base-url";
+constexpr base::TimeDelta kRetryDelay = base::Seconds(30);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_xlit_download", R"(
+      semantics {
+        sender: "Tark Indian-language suggestions"
+        description:
+          "Downloads AI4Bharat's IndicXlit transliteration model and the word "
+          "lists of the person's Indian languages from gettarka.com, once, so "
+          "that typing in Latin letters in the address bar suggests the same "
+          "words in Indian scripts, worked out on the phone."
+        trigger:
+          "The person tapped the address bar's offer to type in an Indian "
+          "language, or turned on Indian-language suggestions in Settings, "
+          "or added an Indian language after doing so. On Wi-Fi unless they "
+          "chose to download now."
+        data: "None: no cookies, no identifiers, no query string."
+        destination: OTHER
+        destination_other: "gettarka.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > Languages > Indian-language suggestions."
+        policy_exception_justification: "Tark has no enterprise policies."
+      })");
+
+Network CurrentNetwork() {
+  const auto type = net::NetworkChangeNotifier::GetConnectionType();
+  if (type == net::NetworkChangeNotifier::CONNECTION_NONE) {
+    return Network::kNone;
+  }
+  if (type == net::NetworkChangeNotifier::CONNECTION_WIFI ||
+      type == net::NetworkChangeNotifier::CONNECTION_ETHERNET) {
+    return Network::kUnmetered;
+  }
+  return Network::kMetered;
+}
+
+base::FilePath FilesDirectory() {
+  base::FilePath data;
+  base::PathService::Get(base::DIR_ANDROID_APP_DATA, &data);
+  return data.AppendASCII("indicxlit");
+}
+
+PrefService* AcceptLanguagesPrefs() {
+  Profile* profile = ProfileManager::GetLastUsedProfileIfLoaded();
+  return profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+}
+
+// Checks a finished download and puts it in place. Blocking.
+bool VerifyAndPlace(const base::FilePath& part,
+                    const base::FilePath& target,
+                    XlitFile file) {
+  return VerifyFile(part, file) && base::ReplaceFile(part, target, nullptr);
+}
+
+}  // namespace
+
+// static
+void XlitDownloadService::RegisterPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterIntegerPref(kOfferStatePref,
+                                static_cast<int>(OfferState::kNotAsked));
+  registry->RegisterBooleanPref(kCellularOkPref, false);
+}
+
+// static
+XlitDownloadService& XlitDownloadService::Get() {
+  static base::NoDestructor<XlitDownloadService> service;
+  return *service;
+}
+
+XlitDownloadService::XlitDownloadService() : dir_(FilesDirectory()) {
+  SetResourceDirectory(dir_);
+  const int state = g_browser_process->local_state()->GetInteger(
+      kOfferStatePref);
+  SetOfferState(state == static_cast<int>(OfferState::kAccepted)
+                    ? OfferState::kAccepted
+                : state == static_cast<int>(OfferState::kDeclined)
+                    ? OfferState::kDeclined
+                    : OfferState::kNotAsked);
+  net::NetworkChangeNotifier::AddNetworkChangeObserver(this);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath dir) {
+            base::CreateDirectory(dir);
+            return ScanDirectory(dir);
+          },
+          dir_),
+      base::BindOnce(&XlitDownloadService::OnScanned,
+                     weak_factory_.GetWeakPtr()));
+}
+
+XlitDownloadService::~XlitDownloadService() {
+  net::NetworkChangeNotifier::RemoveNetworkChangeObserver(this);
+}
+
+void XlitDownloadService::OnScanned(std::vector<std::string> present) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  present_ = std::move(present);
+  scanned_ = true;
+  UpdateFilesReady();
+  EnsureObservingLanguages();
+  MaybeDownloadNext();
+}
+
+void XlitDownloadService::Accept(bool now) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  PrefService* local_state = g_browser_process->local_state();
+  local_state->SetInteger(kOfferStatePref,
+                          static_cast<int>(OfferState::kAccepted));
+  local_state->SetBoolean(kCellularOkPref, now);
+  SetOfferState(OfferState::kAccepted);
+  attempts_.Reset();
+  UpdateFilesReady();
+  EnsureObservingLanguages();
+  MaybeDownloadNext();
+}
+
+void XlitDownloadService::Decline() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  g_browser_process->local_state()->SetInteger(
+      kOfferStatePref, static_cast<int>(OfferState::kDeclined));
+  SetOfferState(OfferState::kDeclined);
+  // A download in progress stops; its .part file is removed at the next start.
+  loader_.reset();
+  retry_timer_.Stop();
+  current_ = nullptr;
+  UpdateFilesReady();
+}
+
+OfferState XlitDownloadService::offer_state() const {
+  return GetOfferState();
+}
+
+std::vector<std::string> XlitDownloadService::DownloadedLanguages() const {
+  std::vector<std::string> tags;
+  for (const std::string& name : present_) {
+    if (name.starts_with("xlit-words-") && name.ends_with(".bin")) {
+      tags.push_back(name.substr(11, name.size() - 11 - 4));
+    }
+  }
+  return tags;
+}
+
+std::vector<std::string> XlitDownloadService::DownloadedLanguageNames() const {
+  std::vector<std::string> names;
+  const base::span<const Language> languages = AllLanguages();
+  for (const std::string& tag : DownloadedLanguages()) {
+    // Konkani has two accept codes and one tag; its first entry names it.
+    const auto language = std::ranges::find(languages, tag, &Language::tag);
+    if (language != languages.end()) {
+      names.push_back(base::UTF16ToUTF8(language->native_name));
+    }
+  }
+  return names;
+}
+
+bool XlitDownloadService::IsWaitingForWifi() const {
+  return GetOfferState() == OfferState::kAccepted &&
+         !Missing(present_, WantedTags()).empty() &&
+         !ShouldStartNow(
+             CurrentNetwork(),
+             g_browser_process->local_state()->GetBoolean(kCellularOkPref));
+}
+
+int64_t XlitDownloadService::DownloadSize(const std::string& tag) const {
+  return tark_xlit::DownloadSize(
+      present_, tag.empty() ? WantedTags() : std::vector<std::string>{tag});
+}
+
+void XlitDownloadService::OnNetworkChanged(
+    net::NetworkChangeNotifier::ConnectionType type) {
+  MaybeDownloadNext();
+}
+
+std::vector<std::string> XlitDownloadService::WantedTags() const {
+  PrefService* prefs = AcceptLanguagesPrefs();
+  std::vector<std::string> tags;
+  for (const Language* language : RowLanguages(
+           prefs ? prefs->GetString(language::prefs::kAcceptLanguages)
+                 : std::string())) {
+    tags.emplace_back(language->tag);
+  }
+  return tags;
+}
+
+void XlitDownloadService::EnsureObservingLanguages() {
+  PrefService* prefs = AcceptLanguagesPrefs();
+  if (!prefs || !accept_languages_.IsEmpty()) {
+    return;
+  }
+  accept_languages_.Init(prefs);
+  accept_languages_.Add(
+      language::prefs::kAcceptLanguages,
+      base::BindRepeating(&XlitDownloadService::OnAcceptLanguagesChanged,
+                          base::Unretained(this)));
+}
+
+void XlitDownloadService::OnAcceptLanguagesChanged() {
+  // A language added after saying yes downloads its list; one removed keeps
+  // its file.
+  attempts_.Reset();
+  MaybeDownloadNext();
+}
+
+void XlitDownloadService::MaybeDownloadNext() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!scanned_ || current_ || retry_timer_.IsRunning() ||
+      GetOfferState() != OfferState::kAccepted) {
+    return;
+  }
+  PrefService* local_state = g_browser_process->local_state();
+  const std::vector<const XlitFile*> missing = Missing(present_, WantedTags());
+  if (missing.empty()) {
+    local_state->SetBoolean(kCellularOkPref, false);
+    return;
+  }
+  if (!ShouldStartNow(CurrentNetwork(),
+                      local_state->GetBoolean(kCellularOkPref))) {
+    return;
+  }
+  current_ = missing.front();
+  auto request = std::make_unique<network::ResourceRequest>();
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  request->url =
+      command_line.HasSwitch(kBaseUrlSwitch)
+          ? GURL(base::StrCat({command_line.GetSwitchValueASCII(kBaseUrlSwitch),
+                               current_->sha256, ".bin"}))
+          : GURL(FileUrl(*current_));
+  LOG(WARNING) << "tark xlit: downloading " << current_->name;
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->SetTimeoutDuration(kTimeout);
+  // The files are served as they are; a redirect anywhere is refused.
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<XlitDownloadService> service, const GURL&,
+         const net::RedirectInfo&, const network::mojom::URLResponseHead&,
+         std::vector<std::string>*) {
+        if (service) {
+          service->loader_.reset();
+          service->current_ = nullptr;
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  const base::FilePath part =
+      dir_.AppendASCII(std::string(current_->name) + ".part");
+  loader_->DownloadToFile(
+      g_browser_process->shared_url_loader_factory().get(),
+      base::BindOnce(&XlitDownloadService::OnDownloaded,
+                     weak_factory_.GetWeakPtr(), current_),
+      part, current_->size);
+}
+
+void XlitDownloadService::OnDownloaded(const XlitFile* file,
+                                       base::FilePath part) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const int error = loader_ ? loader_->NetError() : net::ERR_ABORTED;
+  loader_.reset();
+  if (error != net::OK || part.empty()) {
+    LOG(WARNING) << "tark xlit: " << file->name << " failed: "
+                 << net::ErrorToString(error);
+    OnVerified(file, false);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&VerifyAndPlace, part,
+                     dir_.AppendASCII(std::string(file->name)), *file),
+      base::BindOnce(&XlitDownloadService::OnVerified,
+                     weak_factory_.GetWeakPtr(), file));
+}
+
+void XlitDownloadService::OnVerified(const XlitFile* file, bool ok) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (current_ != file) {
+    return;  // Declined meanwhile.
+  }
+  current_ = nullptr;
+  if (ok) {
+    present_.emplace_back(file->name);
+    std::ranges::sort(present_);
+    UpdateFilesReady();
+    MaybeDownloadNext();
+    return;
+  }
+  LOG(WARNING) << "tark xlit: " << file->name << " not accepted";
+  if (attempts_.TryAgain()) {
+    retry_timer_.Start(FROM_HERE, kRetryDelay,
+                       base::BindOnce(&XlitDownloadService::MaybeDownloadNext,
+                                      weak_factory_.GetWeakPtr()));
+  }
+}
+
+void XlitDownloadService::UpdateFilesReady() {
+  const bool ready =
+      GetOfferState() == OfferState::kAccepted && Ready(present_);
+  if (ready && !FilesReady()) {
+    LOG(WARNING) << "tark xlit: ready";
+  }
+  SetFilesReady(ready);
+}
