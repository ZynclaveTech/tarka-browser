+#
+# Tark for Android (A3, spec §5): the download of IndicXlit's model and word
+# lists. The service builds as part of //chrome/browser on Android; the file
+# table and its checks have no browser dependencies, so their unit tests also
+# build for the build machine (android/build.sh runs them).
+
+import("//testing/test.gni")
+
+static_library("files") {
+  sources = [
+    # Written at build time by android/xlit/files.py (android/build.sh).
+    "xlit_files.inc",
+    "xlit_files.cc",
+    "xlit_files.h",
+  ]
+  deps = [
+    "//base",
+    "//crypto",
+  ]
+}
+
+if (!is_android) {
+  # For the build machine only: an Android variant would be an APK, and its
+  # runner script would collide with this one's.
+  test("tark_xlit_files_unittests") {
+    sources = [ "xlit_files_unittest.cc" ]
+    deps = [
