+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_xlit/xlit_files.h"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+
+#include "base/files/file.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hash.h"
+
+namespace tark_xlit {
+
+namespace {
+
+constexpr XlitFile kFiles[] = {
+#include "chrome/browser/tark_xlit/xlit_files.inc"
+};
+
+constexpr char kFilesBase[] = "https://gettarka.com/xlit/android/v1/";
+
+// The sha256 of the file at `path`, read in pieces, as lower-case hex.
+std::optional<std::string> HashFile(const base::FilePath& path) {
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!file.IsValid()) {
+    return std::nullopt;
+  }
+  crypto::hash::Hasher hasher(crypto::hash::kSha256);
+  std::array<uint8_t, 64 * 1024> buffer;
+  while (true) {
+    const std::optional<size_t> read = file.ReadAtCurrentPos(buffer);
+    if (!read) {
+      return std::nullopt;
+    }
+    if (*read == 0) {
+      break;
+    }
+    hasher.Update(base::span(buffer).first(*read));
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hasher.Finish(digest);
+  return base::HexEncodeLower(digest);
+}
+
+}  // namespace
+
+base::span<const XlitFile> AllFiles() {
+  return kFiles;
+}
+
+const XlitFile* FindFile(std::string_view name) {
+  const auto it = std::ranges::find(kFiles, name, &XlitFile::name);
+  return it == std::end(kFiles) ? nullptr : &*it;
+}
+
+std::string WordsFileName(std::string_view tag) {
+  return base::StrCat({"xlit-words-", tag, ".bin"});
+}
+
+std::string FileUrl(const XlitFile& file) {
+  return base::StrCat({kFilesBase, file.sha256, ".bin"});
+}
+
+bool VerifyFile(const base::FilePath& path, const XlitFile& file) {
+  std::optional<int64_t> size = base::GetFileSize(path);
+  bool ok = size && *size == file.size;
+  if (ok) {
+    const std::optional<std::string> hash = HashFile(path);
+    ok = hash && *hash == file.sha256;
+  }
+  if (!ok) {
+    base::DeleteFile(path);
+  }
+  return ok;
+}
+
+std::vector<std::string> ScanDirectory(const base::FilePath& dir) {
+  std::vector<std::string> present;
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    const std::string name = path.BaseName().MaybeAsASCII();
+    if (name.ends_with(".part")) {
+      base::DeleteFile(path);
+      continue;
+    }
+    const XlitFile* file = FindFile(name);
+    if (!file) {
+      continue;
+    }
+    if (files.GetInfo().GetSize() != file->size) {
+      base::DeleteFile(path);
+      continue;
+    }
+    present.push_back(name);
+  }
+  std::ranges::sort(present);
+  return present;
+}
+
+std::vector<const XlitFile*> Missing(const std::vector<std::string>& present,
+                                     const std::vector<std::string>& tags) {
+  std::vector<const XlitFile*> missing;
+  auto add = [&](std::string_view name) {
+    const XlitFile* file = FindFile(name);
+    if (file && !std::ranges::contains(present, name) &&
+        !std::ranges::contains(missing, file)) {
+      missing.push_back(file);
+    }
+  };
+  add(kModelFileName);
+  for (const std::string& tag : tags) {
+    add(WordsFileName(tag));
+  }
+  return missing;
+}
+
+int64_t DownloadSize(const std::vector<std::string>& present,
+                     const std::vector<std::string>& tags) {
+  int64_t total = 0;
+  for (const XlitFile* file : Missing(present, tags)) {
+    total += file->size;
+  }
+  return total;
+}
+
+bool Ready(const std::vector<std::string>& present) {
+  return std::ranges::contains(present, kModelFileName) &&
+         std::ranges::any_of(present, [](const std::string& name) {
+           return name.starts_with("xlit-words-");
+         });
+}
+
+bool ShouldStartNow(Network network, bool now) {
+  switch (network) {
+    case Network::kNone:
+      return false;
+    case Network::kUnmetered:
+      return true;
+    case Network::kMetered:
+      return now;
+  }
+  return false;
+}
+
+bool Attempts::TryAgain() {
+  return ++count_ <= 3;
+}
+
+}  // namespace tark_xlit
