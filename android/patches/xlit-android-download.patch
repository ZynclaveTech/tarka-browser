+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_xlit;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+
+/**
+ * Tark for Android (A3): the download of the Indian-language suggestions' model and word lists
+ * (chrome/browser/tark_xlit/xlit_download_service.h), for the address bar's offer and Settings.
+ */
+@JNINamespace("tark_xlit")
+@NullMarked
+public final class TarkXlitBridge {
+    /** OfferState in components/tark_xlit/languages.h. */
+    public static final int NOT_ASKED = 0;
+
+    public static final int ACCEPTED = 1;
+    public static final int DECLINED = 2;
+
+    private TarkXlitBridge() {}
+
+    /** Download the person's row languages: on Wi-Fi, or now on any network. */
+    public static void accept(boolean now) {
+        TarkXlitBridgeJni.get().accept(now);
+    }
+
+    /** No suggestions and no offer; the files stay. */
+    public static void decline() {
+        TarkXlitBridgeJni.get().decline();
+    }
+
+    public static int getOfferState() {
+        return TarkXlitBridgeJni.get().getOfferState();
+    }
+
+    /** The languages whose word list is in place, by their own names ("हिन्दी"). */
+    public static String[] getDownloadedLanguageNames() {
+        return TarkXlitBridgeJni.get().getDownloadedLanguageNames();
+    }
+
+    public static boolean isWaitingForWifi() {
+        return TarkXlitBridgeJni.get().isWaitingForWifi();
+    }
+
+    /** Bytes still to download for {@code tag}, or for the row languages if it is empty. */
+    public static long getDownloadSize(String tag) {
+        return TarkXlitBridgeJni.get().getDownloadSize(tag);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void accept(boolean now);
+
+        void decline();
+
+        int getOfferState();
+
+        @JniType("std::vector<std::string>")
+        String[] getDownloadedLanguageNames();
+
+        boolean isWaitingForWifi();
+
+        long getDownloadSize(@JniType("std::string") String tag);
+    }
+}
