+#ifndef CHROME_RENDERER_TARK_ADBLOCK_TARK_ADBLOCK_FRAME_OBSERVER_H_
+#define CHROME_RENDERER_TARK_ADBLOCK_TARK_ADBLOCK_FRAME_OBSERVER_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/common/tark_adblock/tark_adblock.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace tark_adblock {
+
+// Tark's ad blocker in a frame (spec §4), as brave-core's cosmetic filters
+// do it: at commit the frame asks the browser (synchronously) for its page's
+// resources; at document start, before the page's own scripts, it runs the
+// scriptlets in the page's world and hides the page's selectors with a user
+// stylesheet; then a small script in an isolated world collects class and id
+// names as they appear, and the generic rules for them are hidden too.
+// uBlock Origin's behaviour: no first-party exemptions.
+class FrameObserver : public content::RenderFrameObserver,
+                      public content::RenderFrameObserverTracker<FrameObserver> {
+ public:
+  explicit FrameObserver(content::RenderFrame* render_frame);
+  FrameObserver(const FrameObserver&) = delete;
+  FrameObserver& operator=(const FrameObserver&) = delete;
+  ~FrameObserver() override;
+
+  // From ChromeContentRendererClient::RunScriptsAtDocumentStart, first.
+  void RunScriptsAtDocumentStart();
+
+ private:
+  // content::RenderFrameObserver:
+  void ReadyToCommitNavigation(
+      blink::WebDocumentLoader* document_loader) override;
+  void OnDestruct() override;
+
+  mojom::CosmeticResources* Resources();
+  void InsertHideRules(const std::vector<std::string>& selectors);
+  void ScheduleCollect();
+  void Collect();
+
+  mojo::Remote<mojom::CosmeticResources> remote_;
+  std::optional<base::DictValue> resources_;
+  std::vector<std::string> exceptions_;
+  base::OneShotTimer collect_timer_;
+  int collect_count_ = 0;
+  base::WeakPtrFactory<FrameObserver> weak_factory_{this};
+};
+
+}  // namespace tark_adblock
+
