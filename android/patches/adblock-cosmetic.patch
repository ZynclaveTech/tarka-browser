+module tark_adblock.mojom;
+
+import "mojo/public/mojom/base/values.mojom";
+
+// A frame asks Tark's ad blocker (browser process) what to hide and which
+// scriptlets to run on its page (spec §4).
+interface CosmeticResources {
+  // adblock-rust's UrlSpecificResources for the page about to commit:
+  // hide_selectors, exceptions, injected_script, generichide (empty when
+  // blocking is off for the site). Sync: the scriptlets must run before the
+  // page's own scripts (YouTube's ads need that).
+  [Sync]
+  UrlCosmeticResources(string url) => (mojo_base.mojom.DictionaryValue resources);
+
+  // The generic hide selectors for class and id names seen on the page.
+  HiddenClassIdSelectors(array<string> classes, array<string> ids,
+                         array<string> exceptions) => (array<string> selectors);
+};
