+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/tark_adblock/tark_adblock_proxying_url_loader_factory.h"
+#include "chrome/browser/tark_adblock/tark_adblock_service.h"
+#include "content/public/browser/global_routing_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace tark_adblock {
+
+namespace {
+
+class CosmeticResourcesImpl : public mojom::CosmeticResources {
+ public:
+  explicit CosmeticResourcesImpl(content::GlobalRenderFrameHostId frame_id)
+      : frame_id_(frame_id) {}
+  CosmeticResourcesImpl(const CosmeticResourcesImpl&) = delete;
+  CosmeticResourcesImpl& operator=(const CosmeticResourcesImpl&) = delete;
+  ~CosmeticResourcesImpl() override = default;
+
+  // mojom::CosmeticResources:
+  void UrlCosmeticResources(const std::string& url,
+                            UrlCosmeticResourcesCallback callback) override {
+    const GURL gurl(url);
+    if (!gurl.SchemeIsHTTPOrHTTPS() || AdsAllowedFor(gurl)) {
+      std::move(callback).Run(base::DictValue());
+      return;
+    }
+    AdblockService::Get()->UrlCosmeticResources(gurl, std::move(callback));
+  }
+
+  void HiddenClassIdSelectors(
+      const std::vector<std::string>& classes,
+      const std::vector<std::string>& ids,
+      const std::vector<std::string>& exceptions,
+      HiddenClassIdSelectorsCallback callback) override {
+    AdblockService::Get()->HiddenClassIdSelectors(
+        classes, ids, exceptions,
+        base::BindOnce(
+            [](HiddenClassIdSelectorsCallback callback,
+               base::ListValue selectors) {
+              std::vector<std::string> out;
+              for (const base::Value& selector : selectors) {
+                if (selector.is_string()) {
+                  out.push_back(selector.GetString());
+                }
+              }
+              std::move(callback).Run(std::move(out));
+            },
+            std::move(callback)));
+  }
+
+ private:
+  // Whether "Block ads on this site" is off for the page's top frame. For a
+  // main frame the page is the one about to commit, `url`.
+  bool AdsAllowedFor(const GURL& url) const {
+    content::RenderFrameHost* frame =
+        content::RenderFrameHost::FromID(frame_id_);
+    if (!frame) {
+      return false;
+    }
+    const std::optional<url::Origin> top =
+        frame->GetParentOrOuterDocument()
+            ? frame->GetOutermostMainFrame()->GetLastCommittedOrigin()
+            : url::Origin::Create(url);
+    return AdsAllowed(
+        HostContentSettingsMapFactory::GetForProfile(frame->GetBrowserContext()),
+        top);
+  }
+
+  const content::GlobalRenderFrameHostId frame_id_;
+};
+
+}  // namespace
+
+void BindCosmeticResources(
+    content::RenderFrameHost* frame,
+    mojo::PendingReceiver<mojom::CosmeticResources> receiver) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<CosmeticResourcesImpl>(frame->GetGlobalId()),
+      std::move(receiver));
+}
+
+}  // namespace tark_adblock
