+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/renderer/tark_adblock/tark_adblock_frame_observer.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/time/time.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/renderer/render_frame.h"
+#include "content/public/renderer/v8_value_converter.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/scheduler/web_agent_group_scheduler.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/platform/web_url.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_document_loader.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include "url/gurl.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-isolate.h"
+#include "v8/include/v8-local-handle.h"
+
+namespace tark_adblock {
+
+namespace {
+
+// Chromium's world for internal features; the collector keeps to one
+// global, so nothing else that runs there is disturbed.
+constexpr int kWorldId = ISOLATED_WORLD_ID_CHROME_INTERNAL;
+
+// uBlock Origin's scriptlets expect `scriptletGlobals` (as brave-core
+// provides it: a Map that also answers property reads).
+constexpr char kScriptletPrelude[] = R"js(
+const scriptletGlobals = (() => {
+  const methods = ['has', 'get', 'set'];
+  return new Proxy(new Map(), {
+    get(target, prop) {
+      return methods.includes(prop) ? Map.prototype[prop].bind(target)
+                                    : target.get(prop);
+    },
+    set(target, prop, value) {
+      if (!methods.includes(prop)) target.set(prop, value);
+      return true;
+    },
+  });
+})();
+)js";
+
+// Runs in the isolated world: gathers class and id names as elements appear
+// or change; __tarkAdblockCollect() hands over the new ones.
+constexpr char kCollectorScript[] = R"js((() => {
+  if (window.__tarkAdblockCollect) return;
+  const seen = new Set();
+  let classes = [], ids = [];
+  const add = (el) => {
+    if (el.id && !seen.has('#' + el.id)) { seen.add('#' + el.id); ids.push(el.id); }
+    if (el.classList) {
+      for (const c of el.classList) {
+        if (!seen.has('.' + c)) { seen.add('.' + c); classes.push(c); }
+      }
+    }
+  };
+  const scan = (node) => {
+    if (node.nodeType !== Node.ELEMENT_NODE) return;
+    add(node);
+    for (const el of node.querySelectorAll('[id],[class]')) add(el);
+  };
+  new MutationObserver((records) => {
+    for (const r of records) {
+      if (r.type === 'attributes') add(r.target);
+      else for (const n of r.addedNodes) scan(n);
+    }
+  }).observe(document, {subtree: true, childList: true, attributes: true,
+                        attributeFilter: ['id', 'class']});
+  if (document.documentElement) scan(document.documentElement);
+  window.__tarkAdblockCollect = () => {
+    const out = [classes, ids];
+    classes = [];
+    ids = [];
+    return out;
+  };
+})();)js";
+
+std::vector<std::string> Strings(const base::ListValue* list) {
+  std::vector<std::string> out;
+  if (list) {
+    for (const base::Value& value : *list) {
+      if (value.is_string()) {
+        out.push_back(value.GetString());
+      }
+    }
+  }
+  return out;
+}
+
+}  // namespace
+
+FrameObserver::FrameObserver(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame),
+      content::RenderFrameObserverTracker<FrameObserver>(render_frame) {}
+
+FrameObserver::~FrameObserver() = default;
+
+void FrameObserver::OnDestruct() {
+  delete this;
+}
+
+mojom::CosmeticResources* FrameObserver::Resources() {
+  if (!remote_.is_bound()) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        remote_.BindNewPipeAndPassReceiver());
+    remote_.reset_on_disconnect();
+  }
+  return remote_.get();
+}
+
+void FrameObserver::ReadyToCommitNavigation(
+    blink::WebDocumentLoader* document_loader) {
+  resources_.reset();
+  exceptions_.clear();
+  collect_timer_.Stop();
+  collect_count_ = 0;
+  weak_factory_.InvalidateWeakPtrs();
+  const GURL url(document_loader->GetUrl());
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  // Synchronous: the page's scriptlets must be ready before its scripts run.
+  base::DictValue resources;
+  if (Resources()->UrlCosmeticResources(url.spec(), &resources) &&
+      !resources.empty()) {
+    resources_ = std::move(resources);
+  }
+}
+
+void FrameObserver::RunScriptsAtDocumentStart() {
+  if (!resources_) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  const std::string* script = resources_->FindString("injected_script");
+  if (script && !script->empty()) {
+    frame->ExecuteScript(blink::WebScriptSource(blink::WebString::FromUTF8(
+        base::StrCat({"(function() {\n", kScriptletPrelude, *script,
+                      "\n})();"}))));
+  }
+  InsertHideRules(Strings(resources_->FindList("hide_selectors")));
+  exceptions_ = Strings(resources_->FindList("exceptions"));
+  if (!resources_->FindBool("generichide").value_or(false)) {
+    frame->ExecuteScriptInIsolatedWorld(
+        kWorldId, blink::WebScriptSource(blink::WebString::FromUTF8(
+                      kCollectorScript)),
+        blink::BackForwardCacheAware::kAllow);
+    ScheduleCollect();
+  }
+}
+
+void FrameObserver::InsertHideRules(const std::vector<std::string>& selectors) {
+  if (selectors.empty()) {
+    return;
+  }
+  // One rule per selector: one the browser cannot parse drops only itself.
+  std::string css;
+  for (const std::string& selector : selectors) {
+    base::StrAppend(&css, {selector, "{display:none !important}\n"});
+  }
+  render_frame()->GetWebFrame()->GetDocument().InsertStyleSheet(
+      blink::WebString::FromUTF8(css), nullptr, blink::WebCssOrigin::kUser);
+}
+
+void FrameObserver::ScheduleCollect() {
+  // Often while the page builds itself, then every two seconds.
+  const base::TimeDelta delay = collect_count_ < 20 ? base::Milliseconds(500)
+                                                    : base::Seconds(2);
+  collect_timer_.Start(FROM_HERE, delay,
+                       base::BindOnce(&FrameObserver::Collect,
+                                      base::Unretained(this)));
+}
+
+void FrameObserver::Collect() {
+  ++collect_count_;
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  v8::Isolate* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Value> result = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+      kWorldId,
+      blink::WebScriptSource(blink::WebString::FromUTF8(
+          "window.__tarkAdblockCollect ? __tarkAdblockCollect() : null")),
+      blink::BackForwardCacheAware::kAllow);
+  v8::Local<v8::Context> context =
+      frame->GetScriptContextFromWorldId(isolate, kWorldId);
+  std::unique_ptr<base::Value> value =
+      result.IsEmpty() || context.IsEmpty()
+          ? nullptr
+          : content::V8ValueConverter::Create()->FromV8Value(result, context);
+  if (value && value->is_list() && value->GetList().size() == 2 &&
+      value->GetList()[0].is_list() && value->GetList()[1].is_list()) {
+    std::vector<std::string> classes = Strings(&value->GetList()[0].GetList());
+    std::vector<std::string> ids = Strings(&value->GetList()[1].GetList());
+    if (!classes.empty() || !ids.empty()) {
+      Resources()->HiddenClassIdSelectors(
+          classes, ids, exceptions_,
+          base::BindOnce(&FrameObserver::InsertHideRules,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
+  ScheduleCollect();
+}
+
+}  // namespace tark_adblock
