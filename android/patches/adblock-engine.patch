+
+#ifndef CHROME_BROWSER_TARK_ADBLOCK_TARK_ADBLOCK_SERVICE_H_
+#define CHROME_BROWSER_TARK_ADBLOCK_TARK_ADBLOCK_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/threading/sequence_bound.h"
+#include "base/values.h"
+
+class GURL;
+
+namespace url {
+class Origin;
+}  // namespace url
+
+namespace tark_adblock {
+
+// What the engine says about one request.
+struct BlockResult {
+  bool block = false;
+  // A data: URL to answer with instead of failing ($redirect rules).
+  std::optional<std::string> redirect;
+};
+
+// What a load did, for the log.
+struct LoadResult {
+  bool ok = false;
+  std::string source;
+  size_t lists = 0;
+  int64_t ms = 0;
+  std::string created;
+};
+
+class EngineHolder;
+
+// Tark's ad blocker (spec §4): adblock-rust, compiled on the phone from the
+// newest list bundle (the APK's copy or a verified download) and cached.
+// Each engine lives on its own sequence; a new one serves only once it is
+// ready, so a compile never holds up a page (until the first engine is ready
+// nothing is blocked). UI thread only.
+class AdblockService {
+ public:
+  static AdblockService* Get();
+
+  AdblockService(const AdblockService&) = delete;
+  AdblockService& operator=(const AdblockService&) = delete;
+
+  // `request_type` is adblock-rust's ("script", "image", "websocket", …).
+  // Replies on the calling sequence; at once, with "do not block", while no
+  // engine is ready.
+  void ShouldBlock(const GURL& url,
+                   const url::Origin& initiator,
+                   const std::string& request_type,
+                   const std::string& method,
+                   base::OnceCallback<void(BlockResult)> reply);
+
+  // adblock-rust's UrlSpecificResources for a page, as a dictionary (empty
+  // while no engine is ready).
+  void UrlCosmeticResources(const GURL& url,
+                            base::OnceCallback<void(base::DictValue)> reply);
+
+  // The generic hide selectors for classes and ids seen on a page.
+  void HiddenClassIdSelectors(std::vector<std::string> classes,
+                              std::vector<std::string> ids,
+                              std::vector<std::string> exceptions,
+                              base::OnceCallback<void(base::ListValue)> reply);
+
+  bool IsReady() const;
+
+  // Loads the newest bundle again, after a download. The current engine
+  // keeps serving until the new one is ready.
+  void Reload();
