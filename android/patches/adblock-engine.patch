+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_adblock/tark_adblock_service.h"
+
+#include <stdint.h>
+
+#include <string_view>
+#include <utility>
+
+#include "base/android/apk_assets.h"
+#include "base/command_line.h"
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/json/json_reader.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/sequence_checker.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/platform_thread.h"
+#include "base/timer/elapsed_timer.h"
+#include "chrome/browser/tark_adblock/tark_adblock_bundle.h"
+#include "chrome/common/chrome_paths.h"
+#include "content/public/browser/browser_thread.h"
+#include "crypto/sha2.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "third_party/brave_adblock/rs/src/lib.rs.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace tark_adblock {
+
+namespace {
+
+// The crate the compiled engine cache belongs to (android/adblock/crates.py):
+// a cached engine from another version is never loaded.
+constexpr char kCrateVersion[] = "adblock 0.13.3";
+constexpr char kApkBundle[] = "assets/tark_adblock/lists.zip";
+// Test hooks, read from Chrome's command line (on a phone only through
+// /data/local/tmp/chrome-command-line, which only debug builds or a debug
+// app read): an extra list with permission 1, and a delayed compile.
+constexpr char kExtraListSwitch[] = "tark-adblock-extra-list";
+constexpr char kDelayCompileSwitch[] = "tark-adblock-delay-compile";
+
+std::vector<uint8_t> Bytes(std::string_view text) {
+  return std::vector<uint8_t>(text.begin(), text.end());
+}
+
+std::string ReadApkBundle() {
+  base::MemoryMappedFile::Region region =
+      base::MemoryMappedFile::Region::kWholeFile;
+  const int fd = base::android::OpenApkAsset(kApkBundle, &region);
+  if (fd < 0) {
+    return std::string();
+  }
+  base::MemoryMappedFile file;
+  if (!file.Initialize(base::File(fd), region)) {
+    return std::string();
+  }
+  return std::string(base::as_string_view(file.bytes()));
+}
+
+}  // namespace
+
+// One adblock-rust engine, on its own sequence.
+class EngineHolder {
+ public:
+  EngineHolder() : engine_(adblock::new_engine()) {
+    DETACH_FROM_SEQUENCE(sequence_checker_);
+  }
+  EngineHolder(const EngineHolder&) = delete;
+  EngineHolder& operator=(const EngineHolder&) = delete;
+  ~EngineHolder() = default;
+
+  // Loads the newest bundle: the APK's, or a downloaded one whose signature
+  // checks. The compiled engine is cached in `dir`, keyed by the bundle, the
+  // crate and the extra list.
+  LoadResult Load(const base::FilePath& dir,
+                  const base::FilePath& extra_list,
+                  base::TimeDelta delay) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    base::ElapsedTimer timer;
+    adblock::set_domain_resolver();
+
+    LoadResult result;
+    std::optional<Bundle> bundle = ReadBundle(ReadApkBundle());
+    if (bundle) {
+      result.source = "apk";
+    }
+    std::string zip;
+    std::string index;
+    if (base::ReadFileToStringWithMaxSize(dir.AppendASCII("lists.zip"), &zip,
+                                          kMaxBundleSize) &&
+        base::ReadFileToString(dir.AppendASCII("lists.json"), &index) &&
+        CheckIndex(zip, index, ListsPublicKey()).empty()) {
+      std::optional<Bundle> downloaded = ReadBundle(zip);
+      if (downloaded && (!bundle || downloaded->created > bundle->created)) {
+        bundle = std::move(downloaded);
+        result.source = "download";
+      }
+    }
+    if (!bundle) {
+      LOG(ERROR) << "tark adblock: no list bundle";
+      return result;
+    }
+    std::string extra;
+    if (!extra_list.empty()) {
+      base::ReadFileToString(extra_list, &extra);
+    }
+    const std::string key =
+        bundle->sha256 + " " + kCrateVersion + " " +
+        base::HexEncodeLower(crypto::SHA256Hash(base::as_byte_span(extra)));
+
+    std::string cached_key;
+    std::string dat;
+    bool loaded = false;
+    if (base::ReadFileToString(dir.AppendASCII("engine.key"), &cached_key) &&
+        cached_key == key &&
+        base::ReadFileToString(dir.AppendASCII("engine.dat"), &dat)) {
+      rust::Box<adblock::Engine> engine = adblock::new_engine();
+      if (engine->deserialize(Bytes(dat))) {
+        engine_ = std::move(engine);
+        result.source += ", cache";
+        loaded = true;
+      }
+    }
+    if (!loaded) {
+      if (delay.is_positive()) {
+        base::PlatformThread::Sleep(delay);
+      }
+      rust::Box<adblock::FilterSet> filter_set = adblock::new_filter_set();
+      for (const BundleList& list : bundle->lists) {
+        filter_set->add_filter_list_with_permissions(Bytes(list.text),
+                                                     list.permission);
+      }
+      if (!extra.empty()) {
+        filter_set->add_filter_list_with_permissions(Bytes(extra), 1);
+      }
+      engine_ = adblock::engine_from_filter_set(std::move(filter_set));
+      const rust::Vec<uint8_t> serialized = engine_->serialize();
+      if (!serialized.empty() && base::CreateDirectory(dir)) {
+        // The engine first, then the key that vouches for it.
+        base::ImportantFileWriter::WriteFileAtomically(
+            dir.AppendASCII("engine.dat"),
+            std::string_view(reinterpret_cast<const char*>(serialized.data()),
+                             serialized.size()));
+        base::ImportantFileWriter::WriteFileAtomically(
+            dir.AppendASCII("engine.key"), key);
+      }
+    }
+    rust::Box<adblock::BraveCoreResourceStorage> storage =
+        adblock::new_resource_storage(bundle->resources_json);
+    engine_->use_resource_storage(*storage);
+
+    result.ok = true;
+    result.lists = bundle->lists.size();
+    result.created = bundle->created;
+    result.ms = timer.Elapsed().InMilliseconds();
+    return result;
+  }
+
+  BlockResult ShouldBlock(const GURL& url,
+                          const url::Origin& initiator,
+                          const std::string& request_type,
+                          const std::string& method) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    const bool third_party =
+        !net::registry_controlled_domains::SameDomainOrHost(
+            url, initiator,
+            net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+    const adblock::BlockerResult matched = engine_->matches(
+        url.spec(), std::string(url.host()), initiator.host(),
+        request_type, third_party, method);
+    BlockResult result;
+    result.block = matched.matched;
+    if (matched.matched && matched.redirect.has_value) {
+      result.redirect = std::string(matched.redirect.value);
+    }
+    return result;
+  }
+
+  base::DictValue UrlCosmeticResources(const GURL& url) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    const rust::String json = engine_->url_cosmetic_resources(url.spec());
+    std::optional<base::DictValue> resources = base::JSONReader::ReadDict(
+        std::string_view(json.data(), json.size()), base::JSON_PARSE_RFC);
+    return resources ? std::move(*resources) : base::DictValue();
+  }
+
+  base::ListValue HiddenClassIdSelectors(
+      const std::vector<std::string>& classes,
+      const std::vector<std::string>& ids,
+      const std::vector<std::string>& exceptions) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    base::ListValue selectors;
+    for (const rust::String& selector :
+         engine_->hidden_class_id_selectors(classes, ids, exceptions)) {
+      selectors.Append(std::string(selector));
+    }
+    return selectors;
+  }
+
+ private:
+  rust::Box<adblock::Engine> engine_ GUARDED_BY_CONTEXT(sequence_checker_);
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+// static
+AdblockService* AdblockService::Get() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<AdblockService> service;
+  return service.get();
+}
+
+AdblockService::AdblockService() {
+  Load();
+}
+
+AdblockService::~AdblockService() = default;
+
+void AdblockService::ShouldBlock(const GURL& url,
+                                 const url::Origin& initiator,
+                                 const std::string& request_type,
+                                 const std::string& method,
+                                 base::OnceCallback<void(BlockResult)> reply) {
+  if (!active_) {
+    std::move(reply).Run(BlockResult());
+    return;
+  }
+  active_.AsyncCall(&EngineHolder::ShouldBlock)
+      .WithArgs(url, initiator, request_type, method)
+      .Then(std::move(reply));
+}
+
+void AdblockService::UrlCosmeticResources(
+    const GURL& url,
+    base::OnceCallback<void(base::DictValue)> reply) {
+  if (!active_) {
+    std::move(reply).Run(base::DictValue());
+    return;
+  }
+  active_.AsyncCall(&EngineHolder::UrlCosmeticResources)
+      .WithArgs(url)
+      .Then(std::move(reply));
+}
+
+void AdblockService::HiddenClassIdSelectors(
+    std::vector<std::string> classes,
+    std::vector<std::string> ids,
+    std::vector<std::string> exceptions,
+    base::OnceCallback<void(base::ListValue)> reply) {
+  if (!active_) {
+    std::move(reply).Run(base::ListValue());
+    return;
+  }
+  active_.AsyncCall(&EngineHolder::HiddenClassIdSelectors)
+      .WithArgs(std::move(classes), std::move(ids), std::move(exceptions))
+      .Then(std::move(reply));
+}
+
+bool AdblockService::IsReady() const {
+  return !!active_;
+}
+
+void AdblockService::Reload() {
+  if (pending_) {
+    reload_requested_ = true;
+    return;
+  }
+  Load();
+}
+
+void AdblockService::Load() {
+  base::FilePath dir;
+  base::PathService::Get(chrome::DIR_USER_DATA, &dir);
+  dir = dir.AppendASCII("TarkAdblock");
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  int delay_seconds = 0;
+  base::StringToInt(command_line.GetSwitchValueASCII(kDelayCompileSwitch),
+                    &delay_seconds);
+
+  pending_ = base::SequenceBound<EngineHolder>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  pending_.AsyncCall(&EngineHolder::Load)
+      .WithArgs(dir, command_line.GetSwitchValuePath(kExtraListSwitch),
+                base::Seconds(delay_seconds))
+      .Then(base::BindOnce(&AdblockService::OnLoaded,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void AdblockService::OnLoaded(LoadResult result) {
+  if (result.ok) {
+    // WARNING so that release builds print it: the emulator checks read it.
+    LOG(WARNING) << "tark adblock: ready, " << result.lists << " lists from "
+                 << result.source << " (" << result.created << "), "
+                 << result.ms << " ms";
+    active_ = std::move(pending_);
+  } else {
+    pending_.Reset();
+  }
+  if (reload_requested_) {
+    reload_requested_ = false;
+    Load();
+  }
+}
+
+}  // namespace tark_adblock
