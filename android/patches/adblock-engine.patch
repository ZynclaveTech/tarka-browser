+// Modifications Copyright 2026 The Tark Authors: trimmed; one check per
+// request (no previously-matched subset), results without debug info.
+
+use std::collections::HashSet;
+
+use crate::ffi::{resolve_domain_position, BlockerResult, OptionalString};
+use crate::filter_set::FilterSet;
+use crate::resource_storage::BraveCoreResourceStorage;
+use adblock::url_parser::ResolvesDomain;
+use adblock::Engine as InnerEngine;
+use cxx::{let_cxx_string, CxxString, CxxVector};
+
+pub struct Engine {
+    engine: InnerEngine,
+}
+
+pub fn new_engine() -> Box<Engine> {
+    Box::new(Engine { engine: InnerEngine::default() })
+}
+
+pub fn engine_from_filter_set(filter_set: Box<FilterSet>) -> Box<Engine> {
+    Box::new(Engine { engine: InnerEngine::new_with_filter_set(filter_set.0) })
+}
+
+struct DomainResolver;
+
+impl ResolvesDomain for DomainResolver {
+    fn get_host_domain(&self, host: &str) -> (usize, usize) {
+        let_cxx_string!(host_cxx_string = host);
+        let position = resolve_domain_position(&host_cxx_string);
+        (position.start as usize, position.end as usize)
+    }
+}
+
+pub fn set_domain_resolver() -> bool {
+    adblock::url_parser::set_domain_resolver(Box::new(DomainResolver)).is_ok()
+}
+
+fn optional(value: Option<String>) -> OptionalString {
+    match value {
+        Some(value) => OptionalString { has_value: true, value },
+        None => OptionalString::default(),
+    }
+}
+
+fn strings<C: FromIterator<String>>(value: &CxxVector<CxxString>) -> Option<C> {
+    value.iter().map(|s| s.to_str().ok().map(str::to_string)).collect()
+}
+
+impl Engine {
+    pub fn matches(
+        &self,
+        url: &CxxString,
+        hostname: &CxxString,
+        initiator_hostname: &CxxString,
+        request_type: &CxxString,
+        third_party_request: bool,
+        method: &CxxString,
+    ) -> BlockerResult {
+        // URLs and hosts come from GURL and url::Origin: always UTF-8.
+        let result = self.engine.check_network_request(&adblock::request::Request::preparsed(
+            url.to_str().unwrap_or_default(),
+            hostname.to_str().unwrap_or_default(),
+            initiator_hostname.to_str().unwrap_or_default(),
+            request_type.to_str().unwrap_or_default(),
+            third_party_request,
+            method.to_str().unwrap_or_default(),
+        ));
+        BlockerResult {
+            matched: result.should_block(),
+            important: result.important,
+            has_exception: result.exception.is_some(),
+            redirect: optional(result.redirect),
+            rewritten_url: optional(result.rewritten_url),
+        }
+    }
+
+    /// An empty vector means serialization failed.
+    pub fn serialize(&self) -> Vec<u8> {
+        self.engine.serialize()
+    }
+
+    pub fn deserialize(&mut self, serialized: &CxxVector<u8>) -> bool {
+        self.engine.deserialize(serialized.as_slice()).is_ok()
+    }
+
+    pub fn use_resource_storage(&mut self, storage: &BraveCoreResourceStorage) {
+        self.engine.use_resource_storage(storage.clone());
+    }
+
+    pub fn url_cosmetic_resources(&self, url: &CxxString) -> String {
+        let resources = self.engine.url_cosmetic_resources(url.to_str().unwrap_or_default());
+        serde_json::to_string(&resources).unwrap_or_default()
+    }
+
+    pub fn hidden_class_id_selectors(
+        &self,
+        classes: &CxxVector<CxxString>,
+        ids: &CxxVector<CxxString>,
+        exceptions: &CxxVector<CxxString>,
+    ) -> Vec<String> {
+        let (Some(classes), Some(ids), Some(exceptions)) = (
+            strings::<Vec<String>>(classes),
+            strings::<Vec<String>>(ids),
+            strings::<HashSet<String>>(exceptions),
+        ) else {
+            return Vec::new();
+        };
+        self.engine.hidden_class_id_selectors(&classes, &ids, &exceptions)
+    }
+}
