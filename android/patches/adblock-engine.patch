+//! A cxx-based FFI for [adblock-rust](https://github.com/brave/adblock-rust),
+//! from brave-core's components/brave_shields/core/common/adblock/rs.
+
+mod engine;
+mod filter_set;
+mod resource_storage;
+
+use engine::*;
+use filter_set::*;
+use resource_storage::*;
+
+#[allow(unsafe_op_in_unsafe_fn)]
+#[cxx::bridge(namespace = adblock)]
+mod ffi {
+    extern "Rust" {
+        type FilterSet;
+        fn new_filter_set() -> Box<FilterSet>;
+        /// Adds a list; false if it is not UTF-8.
+        fn add_filter_list_with_permissions(
+            &mut self,
+            rules: &CxxVector<u8>,
+            permission_mask: u8,
+        ) -> bool;
+    }
+    extern "Rust" {
+        type BraveCoreResourceStorage;
+        fn new_resource_storage(resources_json: &CxxString) -> Box<BraveCoreResourceStorage>;
+    }
+    extern "Rust" {
+        type Engine;
+        /// Creates a new engine with no rules.
+        fn new_engine() -> Box<Engine>;
+        /// Creates a new engine with rules from a given filter set.
+        fn engine_from_filter_set(filter_set: Box<FilterSet>) -> Box<Engine>;
+
+        /// Configures the adblock domain resolver to call
+        /// `resolve_domain_position` (adblock_domain_resolver.cc).
+        fn set_domain_resolver() -> bool;
+
+        /// Checks if a given request should be blocked.
+        fn matches(
+            &self,
+            url: &CxxString,
+            hostname: &CxxString,
+            initiator_hostname: &CxxString,
+            request_type: &CxxString,
+            third_party_request: bool,
+            method: &CxxString,
+        ) -> BlockerResult;
+        fn serialize(&self) -> Vec<u8>;
+        /// Deserializes and loads a binary-serialized Engine.
+        fn deserialize(&mut self, serialized: &CxxVector<u8>) -> bool;
+        /// Loads resources from a ResourceStorage instance into the engine.
+        fn use_resource_storage(&mut self, storage: &BraveCoreResourceStorage);
+        /// Returns JSON-serialized cosmetic filter resources for a given url.
+        fn url_cosmetic_resources(&self, url: &CxxString) -> String;
+        /// Returns the CSS selectors that need a generic hide rule, from the
+        /// given classes, ids and exceptions (empty if any is not UTF-8).
+        fn hidden_class_id_selectors(
+            &self,
+            classes: &CxxVector<CxxString>,
+            ids: &CxxVector<CxxString>,
+            exceptions: &CxxVector<CxxString>,
+        ) -> Vec<String>;
+    }
+
+    unsafe extern "C++" {
+        include!("third_party/brave_adblock/resolver/adblock_domain_resolver.h");
+
+        /// Wrapper for net::registry_controlled_domains::GetDomainAndRegistry.
+        fn resolve_domain_position(host: &CxxString) -> DomainPosition;
+    }
+
+    struct DomainPosition {
+        start: u32,
+        end: u32,
+    }
+
+    struct BlockerResult {
+        matched: bool,
+        important: bool,
+        has_exception: bool,
+        redirect: OptionalString,
+        rewritten_url: OptionalString,
+    }
+
+    // cxx has no Option<T> in shared structs.
+    #[derive(Default)]
+    struct OptionalString {
+        has_value: bool,
+        value: String,
+    }
+}
