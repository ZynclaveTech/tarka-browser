+#ifndef CHROME_BROWSER_TARK_ADBLOCK_TARK_ADBLOCK_BUNDLE_H_
+#define CHROME_BROWSER_TARK_ADBLOCK_TARK_ADBLOCK_BUNDLE_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace tark_adblock {
+
+// The list bundle Tark's daily job publishes on gettarka.com and every APK
+// carries (android/adblock/bundle.py): a zip with manifest.json, the lists as
+// text (lists/<name>.txt) and adblock-rust resources (resources.json).
+inline constexpr size_t kMaxBundleSize = 16 * 1024 * 1024;
+inline constexpr int kBundleFormat = 1;
+
+struct BundleList {
+  std::string name;
+  uint8_t permission = 0;
+  std::string text;
+};
+
+struct Bundle {
+  Bundle();
+  Bundle(Bundle&&);
+  Bundle& operator=(Bundle&&);
+  ~Bundle();
+
+  // The manifest's "created" (UTC, ISO 8601): later is newer.
+  std::string created;
+  std::vector<BundleList> lists;
+  std::string resources_json;
+  // Lower-case hex sha256 of the zip's bytes.
+  std::string sha256;
+};
+
+// Reads a bundle; nullopt when it is not a complete format-1 bundle.
+std::optional<Bundle> ReadBundle(std::string_view zip);
+
+// Checks a downloaded bundle against its index (latest.json): format, size,
+// sha256, the Ed25519 signature over the zip's bytes by `public_key`, and the
+// index's "created" equal to the manifest's. Empty when good, else why not.
+std::string CheckIndex(std::string_view zip,
+                       std::string_view index_json,
+                       base::span<const uint8_t, 32> public_key);
+
+// The public key of Tark's list-signing key (android/adblock/lists_pubkey.txt).
+base::span<const uint8_t, 32> ListsPublicKey();
+
+}  // namespace tark_adblock
+
+#endif  // CHROME_BROWSER_TARK_ADBLOCK_TARK_ADBLOCK_BUNDLE_H_
