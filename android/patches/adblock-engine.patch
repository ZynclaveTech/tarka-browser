+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_adblock/tark_adblock_bundle.h"
+
+#include <array>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "crypto/sha2.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+#include "third_party/zlib/google/zip_reader.h"
+
+namespace tark_adblock {
+
+namespace {
+
+// android/adblock/lists_pubkey.txt
+constexpr std::array<uint8_t, 32> kListsPublicKey = {
+    0xf4, 0xeb, 0x1f, 0xbf, 0x27, 0xd3, 0x2c, 0x51,
+    0xe1, 0xdf, 0xee, 0x97, 0x62, 0x03, 0xc1, 0x58,
+    0xc8, 0x67, 0xd1, 0x70, 0xbb, 0x07, 0xc8, 0xbf,
+    0x54, 0x63, 0x35, 0xf0, 0x6b, 0x02, 0x62, 0x69};
+
+std::string Sha256Hex(std::string_view data) {
+  return base::HexEncodeLower(crypto::SHA256Hash(base::as_byte_span(data)));
+}
+
+}  // namespace
+
+Bundle::Bundle() = default;
+Bundle::Bundle(Bundle&&) = default;
+Bundle& Bundle::operator=(Bundle&&) = default;
+Bundle::~Bundle() = default;
+
+std::optional<Bundle> ReadBundle(std::string_view zip) {
+  if (zip.size() > kMaxBundleSize) {
+    return std::nullopt;
+  }
+  zip::ZipReader reader;
+  if (!reader.OpenFromString(std::string(zip))) {
+    return std::nullopt;
+  }
+  std::string manifest_json;
+  Bundle bundle;
+  std::vector<std::pair<std::string, std::string>> texts;
+  while (const zip::ZipReader::Entry* entry = reader.Next()) {
+    if (entry->is_directory) {
+      continue;
+    }
+    const std::string path = entry->path.AsUTF8Unsafe();
+    std::string data;
+    if (!reader.ExtractCurrentEntryToString(kMaxBundleSize * 4, &data)) {
+      return std::nullopt;
+    }
+    if (path == "manifest.json") {
+      manifest_json = std::move(data);
+    } else if (path == "resources.json") {
+      bundle.resources_json = std::move(data);
+    } else if (path.starts_with("lists/") && path.ends_with(".txt")) {
+      texts.emplace_back(path.substr(6, path.size() - 10), std::move(data));
+    }
+  }
+  if (!reader.ok()) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> manifest =
+      base::JSONReader::ReadDict(manifest_json, base::JSON_PARSE_RFC);
+  if (!manifest || manifest->FindInt("format") != kBundleFormat) {
+    return std::nullopt;
+  }
+  const std::string* created = manifest->FindString("created");
+  const base::ListValue* lists = manifest->FindList("lists");
+  if (!created || !lists || lists->empty() || bundle.resources_json.empty()) {
+    return std::nullopt;
+  }
+  bundle.created = *created;
+  for (const base::Value& item : *lists) {
+    const base::DictValue* list = item.GetIfDict();
+    const std::string* name = list ? list->FindString("name") : nullptr;
+    if (!name) {
+      return std::nullopt;
+    }
+    auto it = std::ranges::find(texts, *name,
+                                &std::pair<std::string, std::string>::first);
+    if (it == texts.end()) {
+      return std::nullopt;
+    }
+    bundle.lists.push_back(
+        {*name, static_cast<uint8_t>(list->FindInt("permission").value_or(0)),
+         std::move(it->second)});
+  }
+  bundle.sha256 = Sha256Hex(zip);
+  return bundle;
+}
+
+std::string CheckIndex(std::string_view zip,
+                       std::string_view index_json,
+                       base::span<const uint8_t, 32> public_key) {
+  std::optional<base::DictValue> index =
+      base::JSONReader::ReadDict(index_json, base::JSON_PARSE_RFC);
+  if (!index) {
+    return "the index is not JSON";
+  }
+  if (index->FindInt("format") != kBundleFormat) {
+    return "unknown format";
+  }
+  const std::optional<int> size = index->FindInt("size");
+  if (!size || static_cast<size_t>(*size) > kMaxBundleSize ||
+      zip.size() > kMaxBundleSize) {
+    return "over 16 MB";
+  }
+  if (zip.size() != static_cast<size_t>(*size)) {
+    return "size differs from the index";
+  }
+  const std::string* sha256 = index->FindString("sha256");
+  if (!sha256 || *sha256 != Sha256Hex(zip)) {
+    return "sha256 differs from the index";
+  }
+  const std::string* sig = index->FindString("sig");
+  std::optional<std::vector<uint8_t>> signature =
+      sig ? base::Base64Decode(*sig) : std::nullopt;
+  if (!signature || signature->size() != 64 ||
+      ED25519_verify(reinterpret_cast<const uint8_t*>(zip.data()), zip.size(),
+                     signature->data(), public_key.data()) != 1) {
+    return "bad signature";
+  }
+  std::optional<Bundle> bundle = ReadBundle(zip);
+  const std::string* created = index->FindString("created");
+  if (!bundle || !created || bundle->created != *created) {
+    return "manifest differs from the index";
+  }
+  return std::string();
+}
+
+base::span<const uint8_t, 32> ListsPublicKey() {
+  return kListsPublicKey;
+}
+
+}  // namespace tark_adblock
