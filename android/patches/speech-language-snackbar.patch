@@ -0,0 +1,179 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import android.content.Context;
+import android.content.Intent;
+import android.provider.Settings;
+
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.ArgumentCaptor;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.Callback;
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+/** Tests for {@link SpeechLanguageSnackbar}. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class SpeechLanguageSnackbarTest {
+    private static class FakePlatform implements SpeechLanguageSnackbar.Platform {
+        final SnackbarManager mManager = mock(SnackbarManager.class);
+        final List<String> mKnown = new ArrayList<>(Arrays.asList("hi-IN", "en-US"));
+        final List<String> mDownloads = new ArrayList<>();
+        int mSettingsOpened;
+
+        @Override
+        public @Nullable SnackbarManager getSnackbarManager() {
+            return mManager;
+        }
+
+        @Override
+        public void isLanguageKnown(Context context, String bcp47, Callback<Boolean> callback) {
+            callback.onResult(SpeechLanguageSnackbar.listsLanguage(mKnown, bcp47));
+        }
+
+        @Override
+        public void triggerModelDownload(Context context, String bcp47) {
+            mDownloads.add(bcp47);
+        }
+
+        @Override
+        public void openLanguageSettings(Context context) {
+            mSettingsOpened++;
+        }
+    }
+
+    private Context mContext;
+    private FakePlatform mPlatform;
+    private SpeechLanguageSnackbar mSnackbar;
+
+    @Before
+    public void setUp() {
+        mContext = ApplicationProvider.getApplicationContext();
+        mPlatform = new FakePlatform();
+        mSnackbar = new SpeechLanguageSnackbar(mContext, mPlatform);
+    }
+
+    private Snackbar shown() {
+        ArgumentCaptor<Snackbar> captor = ArgumentCaptor.forClass(Snackbar.class);
+        verify(mPlatform.mManager).showSnackbar(captor.capture());
+        return captor.getValue();
+    }
+
+    private static void tap(Snackbar snackbar) {
+        assertNotNull(snackbar.getController());
+        snackbar.getController().onAction(snackbar.getActionData());
+    }
+
+    @Test
+    public void testNamesLanguageOn33() {
+        mSnackbar.onLanguageMissing("hi-IN", true);
+
+        Snackbar snackbar = shown();
+        assertEquals(
+                "Voice search needs Hindi on this phone.",
+                snackbar.getTextForTesting().toString());
+        assertEquals("Download", snackbar.getActionText());
+    }
+
+    @Test
+    public void testGenericOn31() {
+        mSnackbar.onLanguageMissing("hi-IN", false);
+
+        Snackbar snackbar = shown();
+        assertEquals("Voice needs a language downloaded", snackbar.getTextForTesting().toString());
+        assertEquals("Download", snackbar.getActionText());
+        assertEquals(0, mPlatform.mSettingsOpened);
+        tap(snackbar);
+        assertEquals(1, mPlatform.mSettingsOpened);
+        assertTrue(mPlatform.mDownloads.isEmpty());
+
+        Intent intent = SpeechLanguageSnackbar.languageSettingsIntent(mContext);
+        assertEquals(Settings.ACTION_VOICE_INPUT_SETTINGS, intent.getAction());
+    }
+
+    @Test
+    public void testDownloadOnlyOnTap() {
+        mSnackbar.onLanguageMissing("hi-IN", true);
+
+        Snackbar snackbar = shown();
+        assertTrue(mPlatform.mDownloads.isEmpty());
+        tap(snackbar);
+        assertEquals(Arrays.asList("hi-IN"), mPlatform.mDownloads);
+    }
+
+    @Test
+    public void testUnknownLanguageNoDownload() {
+        mSnackbar.onLanguageMissing("xx-YY", true);
+
+        Snackbar snackbar = shown();
+        assertEquals("Voice needs a language downloaded", snackbar.getTextForTesting().toString());
+        assertNull(snackbar.getActionText());
+        assertNull(snackbar.getController());
+        assertTrue(mPlatform.mDownloads.isEmpty());
+    }
+
+    @Test
+    public void testHostileTagNeverShown() {
+        String words = "Tark is updating, tap Download";
+        String longTag = "hi-" + "a".repeat(40);
+        for (String tag :
+                Arrays.asList(words, "en-US Tark is updating", longTag, "hi_IN", "\u202Ehi")) {
+            FakePlatform platform = new FakePlatform();
+            platform.mKnown.add(tag);
+            new SpeechLanguageSnackbar(mContext, platform).onLanguageMissing(tag, true);
+
+            ArgumentCaptor<Snackbar> captor = ArgumentCaptor.forClass(Snackbar.class);
+            verify(platform.mManager).showSnackbar(captor.capture());
+            Snackbar snackbar = captor.getValue();
+            String text = snackbar.getTextForTesting().toString();
+            assertEquals(tag, "Voice needs a language downloaded", text);
+            assertFalse(tag, text.contains("Tark is updating"));
+            assertFalse(tag, text.contains(longTag));
+            assertNull(tag, snackbar.getActionText());
+            assertTrue(tag, platform.mDownloads.isEmpty());
+        }
+    }
+
+    @Test
+    public void testIsWellFormedTag() {
+        assertTrue(SpeechLanguageSnackbar.isWellFormedTag("hi-IN"));
+        assertTrue(SpeechLanguageSnackbar.isWellFormedTag("en"));
+        assertTrue(SpeechLanguageSnackbar.isWellFormedTag("yue-Hant-HK"));
+        assertFalse(SpeechLanguageSnackbar.isWellFormedTag("Tark is updating, tap Download"));
+        assertFalse(SpeechLanguageSnackbar.isWellFormedTag("hi-" + "a".repeat(40)));
+        assertFalse(SpeechLanguageSnackbar.isWellFormedTag("x"));
+        assertFalse(SpeechLanguageSnackbar.isWellFormedTag("hi_IN"));
+        assertFalse(SpeechLanguageSnackbar.isWellFormedTag("12-IN"));
+    }
+
+    @Test
+    public void testListsLanguage() {
+        assertTrue(SpeechLanguageSnackbar.listsLanguage(Arrays.asList("hi-in"), "hi-IN"));
+        assertTrue(SpeechLanguageSnackbar.listsLanguage(Arrays.asList("hi"), "hi-IN"));
+        assertFalse(SpeechLanguageSnackbar.listsLanguage(Arrays.asList("hi-IN"), "ta-IN"));
+        assertFalse(SpeechLanguageSnackbar.listsLanguage(Arrays.asList("en-US"), "en-GB"));
+    }
+}
