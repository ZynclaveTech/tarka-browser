+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.speech;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+import android.provider.Settings;
+import android.speech.RecognitionSupport;
+import android.speech.RecognitionSupportCallback;
+import android.speech.RecognizerIntent;
+import android.speech.SpeechRecognizer;
+import android.text.TextUtils;
+
+import androidx.annotation.RequiresApi;
+import androidx.annotation.VisibleForTesting;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.Callback;
+import org.chromium.base.ResettersForTesting;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+import org.chromium.content_public.browser.SpeechRecognition;
+
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Tark: when on-device speech recognition fails for a language the phone lacks, a snackbar says
+ * so and offers Android's own download. On Android 13+ it names the language, and Download asks
+ * Android's recognizer to download it (only if Android lists it as one it can get); on Android
+ * 12 it says a language is needed, and Download opens Android's voice input settings. Nothing is
+ * downloaded until the person taps Download.
+ */
+@NullMarked
+public class SpeechLanguageSnackbar implements SpeechRecognition.LanguageDelegate {
+    /** Android's pieces; replaced in tests. */
+    @VisibleForTesting
+    interface Platform {
+        /** The snackbar manager of the activity in front, if it has one. */
+        @Nullable SnackbarManager getSnackbarManager();
+
+        /**
+         * Tells whether Android's on-device recognizer has or can download the language (API 33+).
+         */
+        void isLanguageKnown(Context context, String bcp47, Callback<Boolean> callback);
+
+        /** Asks Android's on-device recognizer to download the language (API 33+). */
+        void triggerModelDownload(Context context, String bcp47);
+
+        /** Opens Android's voice input settings, where Android 12 downloads languages. */
+        void openLanguageSettings(Context context);
+    }
+
+    private static @Nullable SpeechLanguageSnackbar sInstance;
+    private static @Nullable Platform sPlatformForTesting;
+
+    private final Context mContext;
+    private final Platform mPlatform;
+
+    @VisibleForTesting
+    SpeechLanguageSnackbar(Context context, Platform platform) {
+        mContext = context;
+        mPlatform = platform;
+    }
+
+    /**
+     * Makes this the speech recognizer's language delegate. Called at each activity's start;
+     * only the first call does anything.
+     */
+    public static void register(Context context) {
+        if (sInstance != null) return;
+        Platform platform =
+                sPlatformForTesting != null ? sPlatformForTesting : new AndroidPlatform();
+        sInstance = new SpeechLanguageSnackbar(context.getApplicationContext(), platform);
+        SpeechRecognition.setLanguageDelegate(sInstance);
+    }
+
+    @VisibleForTesting
+    static void setPlatformForTesting(@Nullable Platform platform) {
+        sPlatformForTesting = platform;
+        ResettersForTesting.register(
+                () -> {
+                    sPlatformForTesting = null;
+                    sInstance = null;
+                    SpeechRecognition.setLanguageDelegate(null);
+                });
+    }
+
+    @Override
+    public void onLanguageMissing(String bcp47, boolean canDownload) {
+        if (!canDownload) {
+            // Android 12: no API to name or download the language; its settings can.
+            show(
+                    mContext.getString(R.string.tark_speech_language_needed),
+                    () -> mPlatform.openLanguageSettings(mContext));
+            return;
+        }
+        // The tag comes from the page: it never reaches the snackbar text itself.
+        boolean wellFormed = TextUtils.isEmpty(bcp47) || isWellFormedTag(bcp47);
+        String name = wellFormed ? displayName(bcp47) : null;
+        String text =
+                name == null
+                        ? mContext.getString(R.string.tark_speech_language_needed)
+                        : mContext.getString(R.string.tark_speech_language_missing, name);
+        if (!wellFormed) {
+            show(text, null);
+            return;
+        }
+        mPlatform.isLanguageKnown(
+                mContext,
+                bcp47,
+                known ->
+                        show(
+                                text,
+                                known
+                                        ? () -> mPlatform.triggerModelDownload(mContext, bcp47)
+                                        : null));
+    }
+
+    static final int MAX_TAG_LENGTH = 35;
+
+    /**
+     * Whether a page-supplied tag is a plain BCP 47 tag: ASCII letters, digits and hyphens, at
+     * most {@link #MAX_TAG_LENGTH} chars, a 2-3 letter language subtag, and unchanged by a
+     * Locale round trip (case aside).
+     */
+    static boolean isWellFormedTag(String bcp47) {
+        if (bcp47.isEmpty() || bcp47.length() > MAX_TAG_LENGTH) return false;
+        for (int i = 0; i < bcp47.length(); i++) {
+            char c = bcp47.charAt(i);
+            boolean ok =
+                    (c >= 'a' && c <= 'z')
+                            || (c >= 'A' && c <= 'Z')
+                            || (c >= '0' && c <= '9')
+                            || c == '-';
+            if (!ok) return false;
+        }
+        Locale locale = Locale.forLanguageTag(bcp47);
+        String language = locale.getLanguage();
+        if (language.length() < 2 || language.length() > 3) return false;
+        for (int i = 0; i < language.length(); i++) {
+            char c = language.charAt(i);
+            if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))) return false;
+        }
+        return locale.toLanguageTag().equalsIgnoreCase(bcp47);
+    }
+
+    /**
+     * The language's name in the UI's language ("Hindi"), or null if Android has no name for it
+     * (it then returns the bare code, which is page-chosen text and never shown).
+     */
+    private @Nullable String displayName(String bcp47) {
+        Locale language =
+                TextUtils.isEmpty(bcp47) ? Locale.getDefault() : Locale.forLanguageTag(bcp47);
+        Locale ui = mContext.getResources().getConfiguration().getLocales().get(0);
+        String name = language.getDisplayLanguage(ui);
+        if (TextUtils.isEmpty(name) || name.equalsIgnoreCase(language.getLanguage())) return null;
+        return name;
+    }
+
+    private void show(String text, @Nullable Runnable download) {
+        SnackbarManager manager = mPlatform.getSnackbarManager();
+        if (manager == null) return;
+        SnackbarManager.SnackbarController controller =
+                new SnackbarManager.SnackbarController() {
+                    @Override
+                    public void onAction(@Nullable Object actionData) {
+                        if (download != null) download.run();
+                    }
+                };
+        Snackbar snackbar =
+                Snackbar.make(
+                        text,
+                        download != null ? controller : null,
+                        download != null ? Snackbar.TYPE_ACTION : Snackbar.TYPE_NOTIFICATION,
+                        Snackbar.UMA_UNKNOWN);
+        if (download != null) {
+            snackbar.setAction(mContext.getString(R.string.tark_speech_language_download), null);
+        }
+        manager.showSnackbar(snackbar);
+    }
+
+    /** Whether a recognizer language list names the language (exactly, or by language alone). */
+    @VisibleForTesting
+    static boolean listsLanguage(List<String> languages, String bcp47) {
+        String wanted = Locale.forLanguageTag(bcp47).getLanguage();
+        for (String tag : languages) {
+            if (tag.equalsIgnoreCase(bcp47)) return true;
+            Locale locale = Locale.forLanguageTag(tag);
+            if (!wanted.isEmpty()
+                    && locale.getLanguage().equals(wanted)
+                    && locale.getCountry().isEmpty()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static class AndroidPlatform implements Platform {
+        // The recognizer that was asked for a download; Android keeps the request while it lives.
+        private @Nullable SpeechRecognizer mDownloadRecognizer;
+
+        @Override
+        public @Nullable SnackbarManager getSnackbarManager() {
+            Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+            if (activity instanceof SnackbarManager.SnackbarManageable manageable) {
+                return manageable.getSnackbarManager();
+            }
+            return null;
+        }
+
+        @Override
+        public void isLanguageKnown(Context context, String bcp47, Callback<Boolean> callback) {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) {
+                callback.onResult(false);
+                return;
+            }
+            checkSupport(context, bcp47, callback);
+        }
+
+        @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+        private static void checkSupport(
+                Context context, String bcp47, Callback<Boolean> callback) {
+            SpeechRecognizer recognizer = SpeechRecognizer.createOnDeviceSpeechRecognizer(context);
+            recognizer.checkRecognitionSupport(
+                    languageIntent(bcp47),
+                    context.getMainExecutor(),
+                    new RecognitionSupportCallback() {
+                        @Override
+                        public void onSupportResult(RecognitionSupport support) {
+                            recognizer.destroy();
+                            callback.onResult(
+                                    listsLanguage(support.getInstalledOnDeviceLanguages(), bcp47)
+                                            || listsLanguage(
+                                                    support.getSupportedOnDeviceLanguages(),
+                                                    bcp47));
+                        }
+
+                        @Override
+                        public void onError(int error) {
+                            recognizer.destroy();
+                            callback.onResult(false);
+                        }
+                    });
+        }
+
+        @Override
+        public void triggerModelDownload(Context context, String bcp47) {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+            if (mDownloadRecognizer != null) mDownloadRecognizer.destroy();
+            mDownloadRecognizer = download(context, bcp47);
+        }
+
+        @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+        private static SpeechRecognizer download(Context context, String bcp47) {
+            SpeechRecognizer recognizer = SpeechRecognizer.createOnDeviceSpeechRecognizer(context);
+            recognizer.triggerModelDownload(languageIntent(bcp47));
+            return recognizer;
+        }
+
+        @Override
+        public void openLanguageSettings(Context context) {
+            Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+            Context starter = activity != null ? activity : context;
+            try {
+                starter.startActivity(languageSettingsIntent(starter));
+            } catch (ActivityNotFoundException e) {
+                // Nothing on this phone opens voice input settings; the snackbar just closes.
+            }
+        }
+    }
+
+    /** The intent that opens Android's voice input settings. */
+    @VisibleForTesting
+    static Intent languageSettingsIntent(Context context) {
+        Intent intent = new Intent(Settings.ACTION_VOICE_INPUT_SETTINGS);
+        if (!(context instanceof Activity)) intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        return intent;
+    }
+
+    private static Intent languageIntent(String bcp47) {
+        Intent intent = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
+        intent.putExtra(
+                RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
+        intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, bcp47);
+        return intent;
+    }
+}
