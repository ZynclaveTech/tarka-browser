+package org.chromium.chrome.browser.tark_captions;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import android.content.Context;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.build.annotations.Nullable;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Page translation: when it is offered, its languages, and the download card on the tap. */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class PageTranslationOfferTest {
+    private static final long INDIC_EN_BYTES = 221_000_000L;
+    private static final long EN_INDIC_BYTES = 265_000_000L;
+
+    /** Captions' downloads: on mobile data a request waits for Wi-Fi unless it is "now". */
+    private static final class FakeDownloads implements TarkPageTranslationCard.Downloads {
+        final Map<String, long[]> mUnits = new HashMap<>();
+        final List<String> mRequests = new ArrayList<>();
+        final List<TarkCaptionsBridge.UnitListener> mListeners = new ArrayList<>();
+        boolean mOnWifi;
+
+        void set(String unit, int state, long bytes, long total) {
+            mUnits.put(unit, new long[] {state, bytes, total, 0});
+        }
+
+        void change(String unit, int state, long bytes) {
+            set(unit, state, bytes, mUnits.get(unit)[2]);
+            for (TarkCaptionsBridge.UnitListener listener : new ArrayList<>(mListeners)) {
+                listener.onUnitChanged(unit);
+            }
+        }
+
+        @Override
+        public long[] getUnitState(String unit) {
+            long[] state = mUnits.get(unit);
+            return state == null ? new long[] {TarkCaptionsBridge.UNIT_MISSING, 0, 0, 0} : state;
+        }
+
+        @Override
+        public void requestUnit(String unit, boolean now) {
+            mRequests.add(unit + (now ? " now" : " wifi"));
+            long total = getUnitState(unit)[2];
+            set(
+                    unit,
+                    now || mOnWifi
+                            ? TarkCaptionsBridge.UNIT_DOWNLOADING
+                            : TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI,
+                    0,
+                    total);
+        }
+
+        @Override
+        public void addListener(TarkCaptionsBridge.UnitListener listener) {
+            mListeners.add(listener);
+        }
+
+        @Override
+        public void removeListener(TarkCaptionsBridge.UnitListener listener) {
+            mListeners.remove(listener);
+        }
+    }
+
+    /** The card as drawn: its text, or nothing. */
+    private static final class FakeSurface implements TarkPageTranslationCard.Surface {
+        boolean mShown;
+        boolean mFailShow;
+        int mShows;
+        int mUpdates;
+        int mDismissals;
+        String mTitle = "";
+        String mLine = "";
+        @Nullable String mAction;
+
+        @Override
+        public boolean show(
+                TarkPageTranslationCard card, String title, String line, @Nullable String action) {
+            if (mFailShow) return false;
+            mShown = true;
+            mShows++;
+            mTitle = title;
+            mLine = line;
+            mAction = action;
+            return true;
+        }
+
+        @Override
+        public void update(String title, String line, @Nullable String action) {
+            assertTrue("updated while not showing", mShown);
+            mUpdates++;
+            mTitle = title;
+            mLine = line;
+            mAction = action;
+        }
+
+        @Override
+        public void dismiss() {
+            if (mShown) mDismissals++;
+            mShown = false;
+        }
+    }
+
+    private Context mContext;
+    private final FakeDownloads mDownloads = new FakeDownloads();
+    private final FakeSurface mSurface = new FakeSurface();
+    private final List<String> mTranslations = new ArrayList<>();
+
+    @Before
+    public void setUp() {
+        mContext = RuntimeEnvironment.getApplication();
+        mDownloads.set("tr_indic_en", TarkCaptionsBridge.UNIT_MISSING, 0, INDIC_EN_BYTES);
+        mDownloads.set("tr_en_indic", TarkCaptionsBridge.UNIT_MISSING, 0, EN_INDIC_BYTES);
+        mDownloads.set("tr_es_en", TarkCaptionsBridge.UNIT_MISSING, 0, 0);
+    }
+
+    private TarkPageTranslationCard card(boolean offTheRecord, String source, String target) {
+        return new TarkPageTranslationCard(
+                mContext,
+                mDownloads,
+                mSurface,
+                (from, to) -> mTranslations.add(from + ">" + to),
+                offTheRecord,
+                source,
+                target);
+    }
+
+    /**
+     * The menu's half (TranslateUtils.canTranslateCurrentTab); the offer's, and the real pref
+     * through translate_manager.cc, are TarkPageTranslateBrowserTest.SwitchOffHidesOfferAndMenu.
+     */
+    @Test
+    public void switchOffHidesOfferAndMenu() {
+        assertTrue(TarkPageTranslationOffer.showMenu(true, true));
+        assertFalse(TarkPageTranslationOffer.showMenu(false, true));
+        assertFalse(TarkPageTranslationOffer.showMenu(true, false));
+        assertEquals("tark.page_translation.enabled", TarkPageTranslationOffer.PREF);
+    }
+
+    @Test
+    public void cardStaysForWholeDownloadAndUpdatesInPlace() {
+        // Ten minutes, in the milliseconds the message wants (not 600 ms or 10 s).
+        assertEquals(600_000L, TarkPageTranslationCard.DISMISSAL_DURATION_MS);
+        mDownloads.mOnWifi = true;
+        TarkPageTranslationCard card = card(false, "hi", "en");
+        assertFalse(card.onTranslateTapped());
+        assertEquals(1, mSurface.mShows);
+
+        for (long bytes = 10_000_000L; bytes < INDIC_EN_BYTES; bytes += 10_000_000L) {
+            mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_DOWNLOADING, bytes);
+        }
+        // Every tick changed the one card; none put up another.
+        assertEquals(1, mSurface.mShows);
+        assertEquals(22, mSurface.mUpdates);
+        assertTrue(mSurface.mLine.endsWith("% · On Wi-Fi · stays on this phone"));
+
+        // Its timer took it down: further ticks don't bring it back...
+        mSurface.mShown = false;
+        card.onDismissed(/* byTimer= */ true);
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_DOWNLOADING, 220_000_000L);
+        assertEquals(1, mSurface.mShows);
+        // ...a tap does (one that can't show isn't taken as shown: the next change shows it),
+        // and the download finishing still translates.
+        mSurface.mFailShow = true;
+        assertFalse(card.onTranslateTapped());
+        assertEquals(1, mSurface.mShows);
+        mSurface.mFailShow = false;
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_DOWNLOADING, 220_500_000L);
+        assertEquals(2, mSurface.mShows);
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_READY, INDIC_EN_BYTES);
+        assertEquals(Collections.singletonList("hi>en"), mTranslations);
+    }
+
+    @Test
+    public void targetsAreSupportedLanguagesOnly() {
+        assertEquals(22, TarkPageTranslationOffer.INDIAN.size());
+        assertEquals(Collections.singletonList("en"), TarkPageTranslationOffer.targetsFor("es"));
+        assertEquals(TarkPageTranslationOffer.INDIAN, TarkPageTranslationOffer.targetsFor("en"));
+
+        List<String> fromHindi = TarkPageTranslationOffer.targetsFor("hi");
+        assertEquals("en", fromHindi.get(0));
+        assertEquals(22, fromHindi.size());
+        assertTrue(fromHindi.contains("ta"));
+        assertTrue(fromHindi.contains("sat"));
+        assertFalse(fromHindi.contains("hi"));
+        assertFalse(fromHindi.contains("es"));
+        assertFalse(fromHindi.contains("fr"));
+
+        assertTrue(TarkPageTranslationOffer.targetsFor("fr").isEmpty());
+        assertTrue(TarkPageTranslationOffer.targetsFor("zh-CN").isEmpty());
+        assertFalse(TarkPageTranslationOffer.canTranslate("es", "hi"));
+
+        assertEquals(
+                Arrays.asList("tr_indic_en", "tr_en_indic"),
+                TarkPageTranslationOffer.unitsFor("hi", "ta"));
+        assertEquals(
+                Collections.singletonList("tr_es_en"), TarkPageTranslationOffer.unitsFor("es", "en"));
+        assertEquals(
+                Collections.singletonList("tr_en_indic"),
+                TarkPageTranslationOffer.unitsFor("en", "bn"));
+
+        // A direction Tark doesn't translate: no card, no download, the page stays.
+        assertFalse(card(false, "es", "hi").onTranslateTapped());
+        assertFalse(card(false, "fr", "en").onTranslateTapped());
+        assertFalse(mSurface.mShown);
+        assertTrue(mDownloads.mRequests.isEmpty());
+        assertTrue(mTranslations.isEmpty());
+    }
+
+    @Test
+    public void noModelShowsDownloadCardNotError() {
+        mDownloads.mOnWifi = true;
+        TarkPageTranslationCard card = card(false, "hi", "en");
+
+        assertFalse(card.onTranslateTapped());
+
+        assertTrue(mSurface.mShown);
+        assertEquals("Getting translation ready · 221 MB", mSurface.mTitle);
+        assertEquals("On Wi-Fi · stays on this phone", mSurface.mLine);
+        assertNull(mSurface.mAction);
+        assertEquals(Collections.singletonList("tr_indic_en wifi"), mDownloads.mRequests);
+        assertTrue(card.isWaiting());
+        // The page stays as it is: nothing translated, nothing else asked of the browser.
+        assertTrue(mTranslations.isEmpty());
+
+        // A second tap while it downloads: the same card, no second request.
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_DOWNLOADING, 110_500_000L);
+        assertFalse(card.onTranslateTapped());
+        assertEquals("50% · On Wi-Fi · stays on this phone", mSurface.mLine);
+        assertEquals(1, mDownloads.mRequests.size());
+        assertEquals(1, mDownloads.mListeners.size());
+
+        // A Private tab: the card, but never a download.
+        FakeSurface privateSurface = new FakeSurface();
+        mDownloads.mRequests.clear();
+        mDownloads.set("tr_en_indic", TarkCaptionsBridge.UNIT_MISSING, 0, EN_INDIC_BYTES);
+        TarkPageTranslationCard incognito =
+                new TarkPageTranslationCard(
+                        mContext,
+                        mDownloads,
+                        privateSurface,
+                        (from, to) -> mTranslations.add(from + ">" + to),
+                        /* offTheRecord= */ true,
+                        "en",
+                        "hi");
+        assertFalse(incognito.onTranslateTapped());
+        assertTrue(privateSurface.mShown);
+        assertEquals("Getting translation ready · 265 MB", privateSurface.mTitle);
+        assertEquals("Download in a regular tab first", privateSurface.mLine);
+        assertNull(privateSurface.mAction);
+        incognito.onAction();
+        assertTrue(mDownloads.mRequests.isEmpty());
+        assertTrue(mTranslations.isEmpty());
+    }
+
+    @Test
+    public void mobileDataWaitsForWifiUnlessDownloadNow() {
+        mDownloads.mOnWifi = false;
+        TarkPageTranslationCard card = card(false, "ta", "hi");
+
+        assertFalse(card.onTranslateTapped());
+        assertEquals(
+                Arrays.asList("tr_indic_en wifi", "tr_en_indic wifi"), mDownloads.mRequests);
+        assertEquals("Getting translation ready · 486 MB", mSurface.mTitle);
+        assertEquals("Waiting for Wi-Fi", mSurface.mLine);
+        assertEquals("Download now", mSurface.mAction);
+
+        // "Download now" agrees to mobile data.
+        mDownloads.mRequests.clear();
+        card.onAction();
+        assertEquals(Arrays.asList("tr_indic_en now", "tr_en_indic now"), mDownloads.mRequests);
+        assertEquals("On Wi-Fi · stays on this phone", mSurface.mLine);
+        assertNull(mSurface.mAction);
+
+        // A failure offers "Try again", which waits for Wi-Fi again.
+        mDownloads.change("tr_en_indic", TarkCaptionsBridge.UNIT_FAILED, 0);
+        assertEquals("Couldn't download", mSurface.mLine);
+        assertEquals("Try again", mSurface.mAction);
+        mDownloads.mRequests.clear();
+        card.onAction();
+        assertEquals(Collections.singletonList("tr_en_indic wifi"), mDownloads.mRequests);
+        assertEquals("Waiting for Wi-Fi", mSurface.mLine);
+        assertTrue(mTranslations.isEmpty());
+    }
+
+    @Test
+    public void translatesAfterDownloadFinishes() {
+        mDownloads.mOnWifi = true;
+        TarkPageTranslationCard card = card(false, "hi", "en");
+        assertFalse(card.onTranslateTapped());
+
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_DOWNLOADING, 200_000_000L);
+        assertTrue(mTranslations.isEmpty());
+        // Another unit (captions' own) changing doesn't matter.
+        mDownloads.change("tr_es_en", TarkCaptionsBridge.UNIT_READY, 0);
+        assertTrue(mTranslations.isEmpty());
+
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_READY, INDIC_EN_BYTES);
+        assertEquals(Collections.singletonList("hi>en"), mTranslations);
+        assertFalse(mSurface.mShown);
+        assertEquals(1, mSurface.mDismissals);
+        assertFalse(card.isWaiting());
+        assertTrue(mDownloads.mListeners.isEmpty());
+
+        // Once, and the next tap translates at once.
+        mDownloads.change("tr_indic_en", TarkCaptionsBridge.UNIT_READY, INDIC_EN_BYTES);
+        assertEquals(1, mTranslations.size());
+        assertTrue(card.onTranslateTapped());
+
+        // Gone by its timer, it still translates when the download finishes; swiped away, not.
+        mTranslations.clear();
+        TarkPageTranslationCard timed = card(false, "en", "ta");
+        assertFalse(timed.onTranslateTapped());
+        timed.onDismissed(/* byTimer= */ true);
+        mDownloads.change("tr_en_indic", TarkCaptionsBridge.UNIT_READY, EN_INDIC_BYTES);
+        assertEquals(Collections.singletonList("en>ta"), mTranslations);
+
+        mTranslations.clear();
+        mDownloads.set("tr_en_indic", TarkCaptionsBridge.UNIT_MISSING, 0, EN_INDIC_BYTES);
+        TarkPageTranslationCard swiped = card(false, "en", "bn");
+        assertFalse(swiped.onTranslateTapped());
+        swiped.onDismissed(/* byTimer= */ false);
+        mDownloads.change("tr_en_indic", TarkCaptionsBridge.UNIT_READY, EN_INDIC_BYTES);
+        assertTrue(mTranslations.isEmpty());
+    }
+
+    @Test
+    @Config(qualifiers = "hi")
+    public void hindiStringsPresent() {
+        assertEquals(
+                "पहले किसी सामान्य टैब में डाउनलोड करें",
+                mContext.getString(R.string.tark_page_translation_private));
+        assertEquals("Wi-Fi का इंतज़ार है", mContext.getString(R.string.tark_captions_waiting_for_wifi));
+        assertEquals("अभी डाउनलोड करें", mContext.getString(R.string.tark_captions_download_now));
+        assertEquals(
+                "अनुवाद तैयार हो रहा है · 221 MB",
+                mContext.getString(R.string.tark_captions_getting_translation_ready, "221 MB"));
+    }
+}
