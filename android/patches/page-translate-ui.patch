+package org.chromium.chrome.browser.tark_captions;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Tark for Android's page translation: when Translate is offered or in the menu, and which
+ * languages it translates between. The translator is Tark's own on the phone (the captions
+ * process): the 22 languages of India and English both ways, Indian ↔ Indian through English,
+ * and Spanish into English. Translate's language list (translate_language_list.cc), its
+ * directions (tark_translate_directions.h: the offer, its target menu, the English fallback) and
+ * the captions process (PageDirectionsFor) agree with this. The offer itself is the browser's
+ * (translate_manager.cc), off with the pref.
+ */
+@NullMarked
+public final class TarkPageTranslationOffer {
+    /** Settings › Languages › Page translation (browser_ui_prefs.cc registers it, on). */
+    public static final String PREF = "tark.page_translation.enabled";
+
+    public static final String ENGLISH = "en";
+    public static final String SPANISH = "es";
+
+    /** The 22 languages of India's Eighth Schedule (IndicTrans2's), as page_translation.cc. */
+    public static final List<String> INDIAN =
+            Collections.unmodifiableList(
+                    Arrays.asList(
+                            "as", "bn", "brx", "doi", "gu", "hi", "kn", "ks", "kok", "mai", "ml",
+                            "mni", "mr", "ne", "or", "pa", "sa", "sat", "sd", "ta", "te", "ur"));
+
+    private TarkPageTranslationOffer() {}
+
+    /** "hi-IN" → "hi". */
+    static String base(String language) {
+        String lower = language.toLowerCase(Locale.ROOT).replace('_', '-');
+        int dash = lower.indexOf('-');
+        return dash < 0 ? lower : lower.substring(0, dash);
+    }
+
+    /** What a page in this language can be translated into, English first. */
+    public static List<String> targetsFor(String source) {
+        String code = base(source);
+        List<String> targets = new ArrayList<>();
+        if (code.equals(SPANISH)) {
+            targets.add(ENGLISH);
+        } else if (code.equals(ENGLISH)) {
+            targets.addAll(INDIAN);
+        } else if (INDIAN.contains(code)) {
+            targets.add(ENGLISH);
+            for (String indian : INDIAN) {
+                if (!indian.equals(code)) targets.add(indian);
+            }
+        }
+        return targets;
+    }
+
+    public static boolean canTranslate(String source, String target) {
+        return targetsFor(source).contains(base(target));
+    }
+
+    /**
+     * Captions' download units a direction needs (as PageUnitsFor in page_translation.cc), none
+     * for a direction Tark doesn't translate.
+     */
+    public static List<String> unitsFor(String source, String target) {
+        List<String> units = new ArrayList<>();
+        if (!canTranslate(source, target)) return units;
+        String from = base(source);
+        String to = base(target);
+        if (INDIAN.contains(from)) units.add("tr_indic_en");
+        if (from.equals(SPANISH)) units.add("tr_es_en");
+        if (INDIAN.contains(to)) units.add("tr_en_indic");
+        return units;
+    }
+
+    /** Whether the menu has Translate: Page translation is on and the tab can be translated. */
+    public static boolean showMenu(boolean enabled, boolean canManuallyTranslate) {
+        return enabled && canManuallyTranslate;
+    }
+}
