+/**
+ * Tark for Android's page translation: the tap on Translate (the message's or the menu's) before
+ * the direction's models are on the phone. Instead of translating, it shows captions' download
+ * card ("Getting translation ready · 221 MB"; on Wi-Fi, or now with "Download now") and leaves the
+ * page as it is, with no error; once the models are there it translates. A Private tab never
+ * starts a download (it would write the downloads' owners): the card says to download in a regular
+ * tab first. The browser asks before each translation (ChromeTranslateClient).
+ */
+@JNINamespace("tark_captions")
+@NullMarked
+public final class TarkPageTranslationCard implements TarkCaptionsBridge.UnitListener {
+    /** Captions' downloads (TarkCaptionsBridge, owner page_translation); a fake in tests. */
+    public interface Downloads {
+        /** {state (TarkCaptionsBridge.UNIT_*), bytes so far, total bytes, ...}. */
+        long[] getUnitState(String unit);
+
+        /** Fetched on Wi-Fi, or now. */
+        void requestUnit(String unit, boolean now);
+
+        void addListener(TarkCaptionsBridge.UnitListener listener);
+
+        void removeListener(TarkCaptionsBridge.UnitListener listener);
+    }
+
+    /** Where the card is drawn (a message); a fake in tests. */
+    public interface Surface {
+        /**
+         * Shows the card (once). The action is null when there is no button. False when it can't
+         * be shown (no window): the next change tries again.
+         */
+        boolean show(
+                TarkPageTranslationCard card, String title, String line, @Nullable String action);
+
+        /** Changes the card while it shows, in place (each download tick). */
+        void update(String title, String line, @Nullable String action);
+
+        void dismiss();
+    }
+
+    /** Translates the page (TranslateManager::TranslatePage, which asks this class again). */
+    public interface Translator {
+        void translate(String source, String target);
+    }
+
+    /**
+     * How long the message stays up (MessageBannerProperties.DISMISSAL_DURATION is in
+     * milliseconds): long enough for a download on Wi-Fi; it goes when the models are there.
+     */
+    static final long DISMISSAL_DURATION_MS = 600_000L;
+
+    private static final Map<WebContents, TarkPageTranslationCard> sCards = new WeakHashMap<>();
+
+    private final Context mContext;
+    private final Downloads mDownloads;
+    private final Surface mSurface;
+    private final Translator mTranslator;
+    private final boolean mOffTheRecord;
+    private final String mSource;
+    private final String mTarget;
+    private final List<String> mUnits;
+    private boolean mWaiting;
+    // The card is up: later changes update it in place. Gone (its timer), it isn't shown again.
+    private boolean mShowing;
+    private boolean mShownOnce;
+
+    @VisibleForTesting
+    public TarkPageTranslationCard(
+            Context context,
+            Downloads downloads,
+            Surface surface,
+            Translator translator,
+            boolean offTheRecord,
+            String source,
+            String target) {
+        mContext = context;
+        mDownloads = downloads;
+        mSurface = surface;
+        mTranslator = translator;
+        mOffTheRecord = offTheRecord;
+        mSource = source;
+        mTarget = target;
+        mUnits = TarkPageTranslationOffer.unitsFor(source, target);
+    }
+
+    /**
+     * The tap on Translate. True: translate now. False: the page stays as it is; the card shows
+     * when the models are missing (nothing when Tark doesn't translate the direction).
+     */
+    public boolean onTranslateTapped() {
+        if (mUnits.isEmpty()) return false;
+        if (allReady()) {
+            stopWaiting();
+            return true;
+        }
+        if (!mOffTheRecord) {
+            // On Wi-Fi (captions' rule); one already asked for keeps its own state.
+            for (String unit : mUnits) {
+                if (state(unit) == TarkCaptionsBridge.UNIT_MISSING) {
+                    mDownloads.requestUnit(unit, /* now= */ false);
+                }
+            }
+        }
+        if (!mWaiting) {
+            mWaiting = true;
+            mDownloads.addListener(this);
+        }
+        // A tap puts the card up again if its timer took it down.
+        if (!mShowing) mShownOnce = false;
+        render();
+        return false;
+    }
+
+    /** Whether the card waits for the models (shown, or gone by its timer). */
+    public boolean isWaiting() {
+        return mWaiting;
+    }
+
+    @Override
+    public void onUnitChanged(String unit) {
+        if (!mWaiting || !mUnits.contains(unit)) return;
+        if (allReady()) {
+            stopWaiting();
+            mShowing = false;
+            mSurface.dismiss();
+            mTranslator.translate(mSource, mTarget);
+            return;
+        }
+        render();
+    }
+
+    /**
+     * "Download now" agrees to mobile data for what waits for Wi-Fi; "Try again" retries what
+     * failed, on Wi-Fi as before.
+     */
+    public void onAction() {
+        if (mOffTheRecord || !mWaiting) return;
+        boolean now = aggregateState() == TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI;
+        int retry = now ? TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI : TarkCaptionsBridge.UNIT_FAILED;
+        for (String unit : mUnits) {
+            if (state(unit) == retry) mDownloads.requestUnit(unit, now);
+        }
+        render();
+    }
+
+    /**
+     * The card went. By its timer the download goes on and the page still translates when it
+     * finishes (the card isn't put up again); swiped away, closed or a new page, it doesn't (the
+     * download itself goes on). A Private tab waits the same way: it starts no download, but if
+     * a regular tab gets the models meanwhile, the Private page translates then.
+     */
+    public void onDismissed(boolean byTimer) {
+        mShowing = false;
+        if (!byTimer) stopWaiting();
+    }
+
+    private void stopWaiting() {
+        if (!mWaiting) return;
+        mWaiting = false;
+        mDownloads.removeListener(this);
+    }
+
+    private int state(String unit) {
+        long[] state = mDownloads.getUnitState(unit);
+        return state.length > 0 ? (int) state[0] : TarkCaptionsBridge.UNIT_MISSING;
+    }
+
+    private boolean allReady() {
+        for (String unit : mUnits) {
+            if (state(unit) != TarkCaptionsBridge.UNIT_READY) return false;
+        }
+        return true;
+    }
+
+    /** The card's state for all the direction's units: a failure first, then Wi-Fi. */
+    private int aggregateState() {
+        boolean waiting = false;
+        boolean downloading = false;
+        for (String unit : mUnits) {
+            int state = state(unit);
+            if (state == TarkCaptionsBridge.UNIT_FAILED) return TarkCaptionsBridge.UNIT_FAILED;
+            if (state == TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI) waiting = true;
+            if (state == TarkCaptionsBridge.UNIT_DOWNLOADING) downloading = true;
+        }
+        if (waiting) return TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI;
+        if (downloading) return TarkCaptionsBridge.UNIT_DOWNLOADING;
+        return allReady() ? TarkCaptionsBridge.UNIT_READY : TarkCaptionsBridge.UNIT_MISSING;
+    }
+
+    private void render() {
+        long bytes = 0;
+        long total = 0;
+        for (String unit : mUnits) {
+            long[] state = mDownloads.getUnitState(unit);
+            if (state.length < 3 || state[0] == TarkCaptionsBridge.UNIT_READY) continue;
+            bytes += state[1];
+            total += state[2];
+        }
+        String title =
+                mContext.getString(
+                        R.string.tark_captions_getting_translation_ready,
+                        Formatter.formatShortFileSize(mContext, total));
+        String line;
+        @Nullable String action = null;
+        if (mOffTheRecord) {
+            line = mContext.getString(R.string.tark_page_translation_private);
+        } else {
+            switch (aggregateState()) {
+                case TarkCaptionsBridge.UNIT_WAITING_FOR_WIFI:
+                    line = mContext.getString(R.string.tark_captions_waiting_for_wifi);
+                    action = mContext.getString(R.string.tark_captions_download_now);
+                    break;
+                case TarkCaptionsBridge.UNIT_FAILED:
+                    line = mContext.getString(R.string.tark_captions_download_failed);
+                    action = mContext.getString(R.string.tark_captions_try_again);
+                    break;
+                default:
+                    line = mContext.getString(R.string.tark_captions_on_this_phone);
+                    if (total > 0 && bytes > 0) {
+                        line =
+                                NumberFormat.getPercentInstance().format((double) bytes / total)
+                                        + " · "
+                                        + line;
+                    }
+                    break;
+            }
+        }
+        if (mShowing) {
+            mSurface.update(title, line, action);
+        } else if (!mShownOnce && mSurface.show(this, title, line, action)) {
+            mShowing = true;
+            mShownOnce = true;
+        }
+    }
+
+    /** Asked by the browser before each translation. True: translate now. */
+    @CalledByNative
+    static boolean readyOrShowCard(
+            WebContents webContents,
+            @JniType("std::string") String source,
+            @JniType("std::string") String target,
+            boolean offTheRecord) {
+        TarkPageTranslationCard card = sCards.get(webContents);
+        if (card == null
+                || !card.mSource.equals(source)
+                || !card.mTarget.equals(target)
+                || card.mOffTheRecord != offTheRecord) {
+            if (card != null) {
+                card.stopWaiting();
+                card.mSurface.dismiss();
+            }
+            card =
+                    new TarkPageTranslationCard(
+                            ContextUtils.getApplicationContext(),
+                            new BridgeDownloads(),
+                            new MessageSurface(webContents),
+                            new TabTranslator(webContents),
+                            offTheRecord,
+                            source,
+                            target);
+            sCards.put(webContents, card);
+        }
+        return card.onTranslateTapped();
+    }
+
+    /** The card holds its tab weakly, so the per-tab map (weak keys) lets go of a closed tab. */
+    private static final class TabTranslator implements Translator {
+        private final WeakReference<WebContents> mWebContents;
+
+        TabTranslator(WebContents webContents) {
+            mWebContents = new WeakReference<>(webContents);
+        }
+
+        @Override
+        public void translate(String source, String target) {
+            WebContents webContents = mWebContents.get();
+            if (webContents == null || webContents.isDestroyed()) return;
+            TarkPageTranslationCardJni.get().translate(webContents, source, target);
+        }
+    }
+
+    private static final class BridgeDownloads implements Downloads {
+        @Override
+        public long[] getUnitState(String unit) {
+            return TarkCaptionsBridge.getUnitState(unit);
+        }
+
+        @Override
+        public void requestUnit(String unit, boolean now) {
+            TarkCaptionsBridge.requestUnit(unit, TarkCaptionsBridge.OWNER_PAGE_TRANSLATION, now);
+        }
+
+        @Override
+        public void addListener(TarkCaptionsBridge.UnitListener listener) {
+            TarkCaptionsBridge.addUnitListener(listener);
+        }
+
+        @Override
+        public void removeListener(TarkCaptionsBridge.UnitListener listener) {
+            TarkCaptionsBridge.removeUnitListener(listener);
+        }
+    }
+
+    /** The card as a message over the tab, like Translate's own. */
+    private static final class MessageSurface implements Surface {
+        private final WeakReference<WebContents> mWebContents;
+        private @Nullable PropertyModel mModel;
+        private @Nullable MessageDispatcher mDispatcher;
+
+        MessageSurface(WebContents webContents) {
+            mWebContents = new WeakReference<>(webContents);
+        }
+
+        @Override
+        public boolean show(
+                TarkPageTranslationCard card, String title, String line, @Nullable String action) {
+            if (mModel == null) {
+                WebContents webContents = mWebContents.get();
+                if (webContents == null
+                        || webContents.isDestroyed()
+                        || webContents.getTopLevelNativeWindow() == null) {
+                    return false;
+                }
+                mDispatcher = MessageDispatcherProvider.from(webContents.getTopLevelNativeWindow());
+                if (mDispatcher == null) return false;
+                mModel =
+                        new PropertyModel.Builder(MessageBannerProperties.ALL_KEYS)
+                                .with(
+                                        MessageBannerProperties.MESSAGE_IDENTIFIER,
+                                        MessageIdentifier.TRANSLATE)
+                                .with(
+                                        MessageBannerProperties.ICON_RESOURCE_ID,
+                                        R.drawable.message_translate_compact)
+                                .with(
+                                        MessageBannerProperties.ICON_TINT_COLOR,
+                                        MessageBannerProperties.TINT_NONE)
+                                .with(
+                                        MessageBannerProperties.DISMISSAL_DURATION,
+                                        DISMISSAL_DURATION_MS)
+                                .with(
+                                        MessageBannerProperties.ON_PRIMARY_ACTION,
+                                        () -> {
+                                            card.onAction();
+                                            return PrimaryActionClickBehavior.DO_NOT_DISMISS;
+                                        })
+                                .with(
+                                        MessageBannerProperties.ON_DISMISSED,
+                                        reason -> {
+                                            mModel = null;
+                                            card.onDismissed(reason == DismissReason.TIMER);
+                                        })
+                                .build();
+                set(title, line, action);
+                // Over Translate's own message, which stays at "Translate page?".
+                mDispatcher.enqueueMessage(
+                        mModel, webContents, MessageScopeType.NAVIGATION, /* highPriority= */ true);
+            }
+            return true;
+        }
+
+        @Override
+        public void update(String title, String line, @Nullable String action) {
+            set(title, line, action);
+        }
+
+        private void set(String title, String line, @Nullable String action) {
+            if (mModel == null) return;
+            mModel.set(MessageBannerProperties.TITLE, title);
+            mModel.set(MessageBannerProperties.DESCRIPTION, line);
+            if (action != null) {
+                mModel.set(MessageBannerProperties.PRIMARY_BUTTON_TEXT, action);
+                mModel.set(
+                        MessageBannerProperties.PRIMARY_WIDGET_APPEARANCE,
+                        PrimaryWidgetAppearance.BUTTON_IF_TEXT_IS_SET);
+            } else {
+                mModel.set(MessageBannerProperties.PRIMARY_BUTTON_TEXT, "");
+            }
+        }
+
+        @Override
+        public void dismiss() {
+            if (mModel == null || mDispatcher == null) return;
+            mDispatcher.dismissMessage(mModel, DismissReason.DISMISSED_BY_FEATURE);
+        }
+    }
+
+    @NativeMethods
+    interface Natives {
+        void translate(
+                WebContents webContents,
+                @JniType("std::string") String source,
+                @JniType("std::string") String target);
+    }
+}
