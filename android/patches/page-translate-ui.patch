+// The card's models are on the phone: translate, if the tab still shows the
+// page it was asked for, untranslated, and is in front.
+static void JNI_TarkPageTranslationCard_Translate(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jweb_contents,
+    const std::string& source_language,
+    const std::string& target_language) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents ||
+      web_contents->GetVisibility() != content::Visibility::VISIBLE) {
+    return;
+  }
+  ChromeTranslateClient* client =
+      ChromeTranslateClient::FromWebContents(web_contents);
+  if (!client || !client->GetTranslateManager()) {
+    return;
+  }
+  const translate::LanguageState& state = client->GetLanguageState();
+  if (state.IsPageTranslated() || state.translation_pending() ||
+      state.source_language() != source_language) {
+    return;
+  }
+  client->GetTranslateManager()->TranslatePage(source_language,
+                                               target_language,
+                                               /*triggered_from_menu=*/false);
+}
