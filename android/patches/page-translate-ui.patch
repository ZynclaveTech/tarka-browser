+#ifndef COMPONENTS_TRANSLATE_CORE_BROWSER_TARK_TRANSLATE_DIRECTIONS_H_
+#define COMPONENTS_TRANSLATE_CORE_BROWSER_TARK_TRANSLATE_DIRECTIONS_H_
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+
+namespace translate {
+
+// Tark for Android: the directions Tark's translator has (the captions
+// process's PageDirectionsFor; TarkPageTranslationOffer.java): the 22
+// languages of India ↔ English, Indian ↔ Indian (through English), and
+// Spanish → English.
+inline bool TarkIsIndianLanguage(std::string_view code) {
+  static constexpr std::string_view kIndian[] = {
+      "as", "bn",  "brx", "doi", "gu", "hi", "kn", "ks", "kok", "mai", "ml",
+      "mni", "mr", "ne",  "or",  "pa", "sa", "sat", "sd", "ta",  "te",  "ur",
+  };
+  return std::ranges::find(kIndian, code) != std::end(kIndian);
+}
+
+inline bool TarkSupportsDirection(std::string_view source,
+                                  std::string_view target) {
+  if (source == target) {
+    return false;
+  }
+  if (TarkIsIndianLanguage(source)) {
+    return target == "en" || TarkIsIndianLanguage(target);
+  }
+  if (source == "en") {
+    return TarkIsIndianLanguage(target);
+  }
+  return source == "es" && target == "en";
+}
+
+// The target for a page in `source`: `target` when Tark translates that way,
+// else English when it translates the source into English (Hindi → Spanish
+// becomes Hindi → English), else `target` unchanged (the offer is then
+// suppressed: TarkSupportsDirection is false).
+inline std::string TarkTargetFor(std::string_view source,
+                                 std::string_view target) {
+  if (!TarkSupportsDirection(source, target) &&
+      TarkSupportsDirection(source, "en")) {
+    return "en";
+  }
+  return std::string(target);
+}
+
+}  // namespace translate
