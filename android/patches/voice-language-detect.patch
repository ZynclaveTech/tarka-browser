@@ -0,0 +1,75 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_voice_android/voice_language_detector.h"
+
+#include <cstdint>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_voice {
+namespace {
+
+constexpr int kRate = AudioRing::kSampleRate;
+
+// `seconds` of audio whose sample i (counted from the session's start,
+// `first` onwards) is i % 30000, so any sample tells where it came from.
+std::vector<int16_t> Audio(int64_t first, int seconds) {
+  std::vector<int16_t> pcm;
+  for (int64_t i = first; i < first + int64_t{seconds} * kRate; ++i) {
+    pcm.push_back(static_cast<int16_t>(i % 30000));
+  }
+  return pcm;
+}
+
+TEST(VoiceLanguageDetectorTest, RingBufferKeeps15s) {
+  VoiceLanguageDetector detector;
+  // 20 s, a second at a time, as the capture appends it.
+  for (int second = 0; second < 20; ++second) {
+    detector.ring().Append(Audio(int64_t{second} * kRate, 1));
+  }
+  const std::vector<int16_t> held = detector.ring().Snapshot();
+  ASSERT_EQ(held.size(), size_t{15} * kRate);
+  EXPECT_EQ(detector.ring().size(), size_t{15} * kRate);
+  EXPECT_EQ(detector.ring().total(), int64_t{20} * kRate);
+  // The last 15 s, oldest first: samples 5 s to 20 s.
+  EXPECT_EQ(held, Audio(int64_t{5} * kRate, 15));
+  // What a detector asks for that is gone is left out.
+  const std::vector<int16_t> range = detector.ring().Range(0, int64_t{6} * kRate);
+  EXPECT_EQ(range, Audio(int64_t{5} * kRate, 1));
+}
+
+TEST(VoiceLanguageDetectorTest, RingBufferHoldsLessWhenShorter) {
+  VoiceLanguageDetector detector;
+  detector.ring().Append(Audio(0, 4));
+  EXPECT_EQ(detector.ring().Snapshot(), Audio(0, 4));
+  EXPECT_EQ(detector.ring().Range(kRate, 2 * kRate), Audio(kRate, 1));
+}
+
+TEST(VoiceLanguageDetectorTest, RingBufferDropsAtSessionEnd) {
+  VoiceLanguageDetector detector;
+  detector.ring().Append(Audio(0, 20));
+  detector.EndSession();
+  EXPECT_TRUE(detector.ring().Snapshot().empty());
+  EXPECT_EQ(detector.ring().size(), 0u);
+  EXPECT_EQ(detector.ring().total(), 0);
+  EXPECT_DOUBLE_EQ(detector.speech_seconds_for_testing(), 0);
+}
+
+TEST(VoiceLanguageDetectorTest, NoModelsDecidesNothing) {
+  VoiceLanguageDetector detector;
+  EXPECT_FALSE(detector.Load(base::FilePath(FILE_PATH_LITERAL("/nonexistent")),
+                             base::FilePath(FILE_PATH_LITERAL("/nonexistent/libonnxruntime.so"))));
+  detector.ring().Append(Audio(0, 10));
+  EXPECT_FALSE(detector.Process());
+  EXPECT_FALSE(detector.Finish());
+  // The audio is still only the ring's, and goes at the session's end.
+  EXPECT_EQ(detector.ring().size(), size_t{10} * kRate);
+  detector.EndSession();
+  EXPECT_EQ(detector.ring().size(), 0u);
+}
+
+}  // namespace
+}  // namespace tark_voice
