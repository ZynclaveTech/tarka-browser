+
+    @Test
+    public void testMissingIsNeedsPack() {
+        assertEquals(
+                Decision.NEEDS_PACK, VoiceDetection.decide("en-IN", "ta", true, 4000, false, true));
+        assertEquals(
+                Decision.NEEDS_PACK, VoiceDetection.decide("en-IN", "ta", false, 4000, false, true));
+
+        VoiceDetection.setLanguagesForTesting(
+                languages(List.of("en-IN", "hi-IN"), List.of("ta-IN", "ta-LK")));
