+/**
+ * Tark: spoken-language detection during a voice search (spec §3, M4–M6).
+ *
+ * <p>With detection on (the {@code language_id} model is on the phone and the person turned it on,
+ * Android 13+, Tark holds RECORD_AUDIO), Tark captures the microphone itself at 16 kHz mono and
+ * hands Android's recognizer that audio through a pipe, as it is captured. The same audio goes
+ * into the detector's 15 s ring (memory only, dropped when the session ends), which captions'
+ * detector reads on a background sequence. The recognizer's results reach the page exactly as
+ * before; detection never holds them back.
+ *
+ * <p>When the detector names a language the session isn't in, {@link #decide} says what the person
+ * sees: nothing; while the session runs (its first 15 s) and the phone has the language, "Sounds
+ * like Hindi · Switch", which carries on in Hindi from the start of what was said; after the
+ * session, "That sounded like Hindi · Use Hindi next time"; or, when the phone lacks it, "That
+ * sounded like Tamil. Voice search needs Tamil on this phone." with Download. Tark changes the
+ * language only on the person's tap. A private tab's session has no origin: nothing is remembered
+ * for it, and "Use … next time" is not offered.
+ *
+ * <p>Threads: the UI thread (the session, its decisions and snackbars), a capture thread (the
+ * microphone, the ring, the pipe), a writer per pipe (writes block while the recognizer catches
+ * up, never faster than {@link #REPLAY_SPEEDUP} times real time), and the detector's sequence.
+ */
+@NullMarked
+public final class VoiceDetection {
+    /** What the person sees when the detector names a language. */
+    public enum Decision {
+        /** Nothing: the same language, unsure, or one Android can't recognize. */
+        QUIET,
+        /** "Sounds like Hindi · Switch", while the session runs. */
+        SWITCH_CHIP,
+        /** "That sounded like Hindi · Use Hindi next time", after the session. */
+        NEXT_TIME,
+        /** "That sounded like Tamil. Voice search needs Tamil on this phone." with Download. */
+        NEEDS_PACK,
+    }
+
+    private static final String TAG = "VoiceDetection";
+
+    /** How far into a session the chip is offered: the ring can't replay further back. */
+    @VisibleForTesting static final long CHIP_WINDOW_MS = 15_000;
+
+    @VisibleForTesting static final int SAMPLE_RATE = 16_000;
+    // 20 ms of audio, the capture's and the pipe's unit.
+    @VisibleForTesting static final int CHUNK_SAMPLES = 320;
+    // The detector reads what is new every 200 ms.
+    @VisibleForTesting static final int PROCESS_EVERY_CHUNKS = 10;
+    // A replay goes into the new pipe at up to twice real time: faster than real time loses
+    // speech on some recognizers, but the new recognizer has to catch up with the live audio.
+    @VisibleForTesting static final int REPLAY_SPEEDUP = 2;
+
+    // VoxLingua107's and Java's old codes, and Android's tags, as one language each.
+    private static final Map<String, String> SAME_LANGUAGE =
+            Map.of("iw", "he", "jw", "jv", "in", "id", "ji", "yi", "no", "nb", "ur", "hi");
+
+    /** Android's speech languages: on the phone, and what it can download. */
+    @VisibleForTesting
+    static final class Languages {
+        final List<String> installed;
+        final List<String> downloadable;
+
+        Languages(List<String> installed, List<String> downloadable) {
+            this.installed = installed;
+            this.downloadable = downloadable;
+        }
+    }
+
+    /** The microphone; replaced in tests. */
+    @VisibleForTesting
+    interface Mic {
+        boolean start();
+
+        /** Fills {@code buffer} with 16 kHz mono PCM16; the count read, or ≤ 0 at the end. */
+        int read(short[] buffer);
+
+        void release();
+    }
+
+    /** A pipe to the recognizer. */
+    @VisibleForTesting
+    static final class Pipe {
+        final ParcelFileDescriptor readEnd;
+        final OutputStream writeEnd;
+
+        Pipe(ParcelFileDescriptor readEnd, OutputStream writeEnd) {
+            this.readEnd = readEnd;
+            this.writeEnd = writeEnd;
+        }
+    }
+
+    /** The session's detector ({@link VoiceLanguageDetector}); replaced in tests. */
+    @VisibleForTesting
+    interface Detector {
+        void append(short[] pcm, int length);
+
+        short[] buffered();
+
+        boolean load(String modelsDir);
+
+        @Nullable String process();
+
+        @Nullable String finish();
+
+        void destroy();
+    }
+
+    /** Android's and Tark's pieces; replaced in tests. */
+    @VisibleForTesting
+    interface Host {
+        boolean hasRecordPermission();
+
+        /** Whether voice wants the language_id unit and it is on the phone. */
+        boolean isDetectionOn();
+
+        String modelsDir();
+
+        /** Holds (or releases) the language_id unit, so a removal waits for the release. */
+        void setUnitInUse(boolean inUse);
+
+        @Nullable Mic openMic();
+
+        @Nullable Pipe createPipe();
+
+        Detector newDetector();
+
+        void startThread(Runnable task, String name);
+
+        Executor newWriterExecutor();
+
+        void sleepMs(long ms);
+
+        void runOnDetectorSequence(Runnable task);
+
+        void runOnUiThread(Runnable task);
+
+        long now();
+
+        /** Android's speech languages, or null if it can't say; on the UI thread. */
+        void languages(Callback<@Nullable Languages> callback);
+
+        boolean switchLanguage(String bcp47);
+
+        @Nullable SnackbarManager snackbarManager();
+
+        void download(String bcp47);
+
+        Context context();
+    }
+
+    private static @Nullable Host sHostForTesting;
+    // Android's latest answer about its speech languages, or null while unknown. Never asked
+    // during a session: only after one ends, or when Voice languages asks.
+    private static @Nullable Languages sLanguages;
+
+    private VoiceDetection() {}
+
+    @VisibleForTesting
+    static void setHostForTesting(@Nullable Host host) {
+        sHostForTesting = host;
+        ResettersForTesting.register(
+                () -> {
+                    sHostForTesting = null;
+                    sLanguages = null;
+                });
+    }
+
+    @VisibleForTesting
+    static void setLanguagesForTesting(@Nullable Languages languages) {
+        sLanguages = languages;
+    }
+
+    /**
+     * The audio for a session that starts, if detection runs for it; else null, and Android's
+     * recognizer uses the microphone as without detection.
+     */
+    public static SpeechRecognition.@Nullable AudioSource audioSourceFor(
+            Context context, String origin, String bcp47) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return null;
+        Host host = sHostForTesting != null ? sHostForTesting : new AndroidHost(context);
+        // Tark's own capture needs Tark's own permission, whatever the site was granted.
+        if (!host.hasRecordPermission()) return null;
+        if (!host.isDetectionOn()) return null;
+        return new Session(host, origin, bcp47);
+    }
+
+    /** Android's latest answer, from Voice languages or the site languages' check. */
+    static void onSupport(@Nullable RecognitionSupport support) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        sLanguages = languagesOf(support);
+    }
+
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static @Nullable Languages languagesOf(@Nullable RecognitionSupport support) {
+        if (support == null) return null;
+        List<String> downloadable = new ArrayList<>(support.getSupportedOnDeviceLanguages());
+        downloadable.addAll(support.getPendingOnDeviceLanguages());
+        return new Languages(
+                new ArrayList<>(support.getInstalledOnDeviceLanguages()), downloadable);
+    }
+
+    /**
+     * What the person sees when the detector heard {@code heardLang} in a session in {@code
+     * sessionTag}.
+     *
+     * @param sessionTag The language the session listens in (BCP 47).
+     * @param heardLang The detector's language (a VoxLingua code: "hi", "en"), or "und".
+     * @param sessionRunning Whether the session still listens.
+     * @param msSinceStart How long ago the session started.
+     * @param heardInstalled Whether the phone has the heard language.
+     * @param heardDownloadable Whether Android can download it.
+     */
+    public static Decision decide(
+            String sessionTag,
+            String heardLang,
+            boolean sessionRunning,
+            long msSinceStart,
+            boolean heardInstalled,
+            boolean heardDownloadable) {
+        if (TextUtils.isEmpty(heardLang) || VoiceLanguageDetector.UNSURE.equals(heardLang)) {
+            return Decision.QUIET;
+        }
+        if (sameLanguage(sessionTag, heardLang)) return Decision.QUIET;
+        if (heardInstalled) {
+            return sessionRunning && msSinceStart <= CHIP_WINDOW_MS
+                    ? Decision.SWITCH_CHIP
+                    : Decision.NEXT_TIME;
+        }
+        return heardDownloadable ? Decision.NEEDS_PACK : Decision.QUIET;
+    }
+
+    /** One language's code, whatever form names it ("iw" and "he"; Urdu as Hindi). */
+    @VisibleForTesting
+    static String languageOf(String code) {
+        String language = code.toLowerCase(Locale.ROOT);
+        String same = SAME_LANGUAGE.get(language);
+        return same != null ? same : language;
+    }
+
+    /** Whether a tag ("en-US") and a code ("en") name the same language, region aside. */
+    @VisibleForTesting
+    static boolean sameLanguage(String tag, String code) {
+        String language = Locale.forLanguageTag(tag).getLanguage();
+        return !language.isEmpty() && languageOf(language).equals(languageOf(code));
+    }
+
+    /**
+     * The tag among {@code tags} (Android's) for the heard language, preferring the session's
+     * region, then the phone's; null if none is for it.
+     */
+    @VisibleForTesting
+    static @Nullable String tagFor(String heard, List<String> tags, String sessionTag) {
+        String language = languageOf(heard);
+        String sessionRegion = Locale.forLanguageTag(sessionTag).getCountry();
+        String phoneRegion = Locale.getDefault().getCountry();
+        String best = null;
+        int bestScore = -1;
+        for (String tag : tags) {
+            if (!SpeechLanguageSnackbar.isWellFormedTag(tag)) continue;
+            Locale locale = Locale.forLanguageTag(tag);
+            if (!languageOf(locale.getLanguage()).equals(language)) continue;
+            String region = locale.getCountry();
+            int score =
+                    !region.isEmpty() && region.equals(sessionRegion)
+                            ? 3
+                            : !region.isEmpty() && region.equals(phoneRegion) ? 2 : 1;
+            if (score > bestScore) {
+                best = tag;
+                bestScore = score;
+            }
+        }
+        return best;
+    }
+
+    /** One voice search session's capture, detection and offer. UI thread unless noted. */
+    @VisibleForTesting
+    static final class Session implements SpeechRecognition.AudioSource {
+        private final Host mHost;
+        private final String mOrigin;
+        private final Detector mDetector;
+        private final long mStartMs;
+        // The language the recognizer listens in (the switched-to one after a switch).
+        private String mTag;
+        private @Nullable Capture mCapture;
+        private boolean mOpened;
+        private boolean mEnded;
+        private boolean mSwitched;
+        private @Nullable String mHeard;
+        private boolean mOffered;
+        private boolean mAsking;
+        // Touched only on the detector's sequence.
+        private boolean mLoaded;
+
+        Session(Host host, String origin, String tag) {
+            mHost = host;
+            mOrigin = origin;
+            mTag = tag;
+            mDetector = host.newDetector();
+            mStartMs = host.now();
+        }
+
+        @Override
+        public @Nullable ParcelFileDescriptor open() {
+            if (mOpened || mEnded) return null;
+            mOpened = true;
+            Pipe pipe = mHost.createPipe();
+            Mic mic = pipe != null ? mHost.openMic() : null;
+            if (pipe == null || mic == null) {
+                if (pipe != null) closeQuietly(pipe);
+                return null;
+            }
+            // Held while the detector may read its files; released when it is gone.
+            mHost.setUnitInUse(true);
+            String modelsDir = mHost.modelsDir();
+            mHost.runOnDetectorSequence(() -> mLoaded = mDetector.load(modelsDir));
+            Capture capture = new Capture(mic, new Writer(pipe.writeEnd));
+            mCapture = capture;
+            mHost.startThread(capture, "TarkVoiceCapture");
+            return pipe.readEnd;
+        }
+
+        @Override
+        public @Nullable ParcelFileDescriptor replay() {
+            Capture capture = mCapture;
+            if (capture == null || mEnded) return null;
+            Pipe pipe = mHost.createPipe();
+            if (pipe == null) return null;
+            capture.replayInto(new Writer(pipe.writeEnd));
+            return pipe.readEnd;
+        }
+
+        @Override
+        public void close() {
+            if (mEnded) return;
+            mEnded = true;
+            Capture capture = mCapture;
+            if (capture != null) {
+                // The capture thread stops, then the detector decides on what it heard and
+                // drops the audio (finishDetector()).
+                capture.stop();
+            } else {
+                mHost.runOnDetectorSequence(mDetector::destroy);
+            }
+            maybeOffer();
+        }
+
+        // Detector's sequence: the audio appended since the last read.
+        private void process() {
+            if (!mLoaded) return;
+            String heard = mDetector.process();
+            if (heard != null) mHost.runOnUiThread(() -> onHeard(heard));
+        }
+
+        // Detector's sequence, once the capture stopped: the last decision, then the audio goes.
+        private void finishDetector() {
+            String heard = mLoaded ? mDetector.finish() : null;
+            mDetector.destroy();
+            mHost.runOnUiThread(
+                    () -> {
+                        mHost.setUnitInUse(false);
+                        if (heard != null) onHeard(heard);
+                    });
+        }
+
+        @VisibleForTesting
+        void onHeard(String heard) {
+            if (mHeard != null) return;
+            mHeard = heard;
+            maybeOffer();
+        }
+
+        /** Decides, once the detector has, and once what Android has is known. */
+        private void maybeOffer() {
+            String heard = mHeard;
+            if (mOffered || heard == null) return;
+            if (decide(mTag, heard, true, 0, true, true) == Decision.QUIET) {
+                mOffered = true;
+                return;
+            }
+            Languages languages = sLanguages;
+            if (languages == null) {
+                // Android is asked only once the session's recognizer is gone.
+                if (!mEnded || mAsking) return;
+                mAsking = true;
+                mHost.languages(
+                        answer -> {
+                            mAsking = false;
+                            if (answer == null) {
+                                mOffered = true;
+                                return;
+                            }
+                            sLanguages = answer;
+                            maybeOffer();
+                        });
+                return;
+            }
+            String installed = tagFor(heard, languages.installed, mTag);
+            String downloadable = tagFor(heard, languages.downloadable, mTag);
+            Decision decision =
+                    decide(
+                            mTag,
+                            heard,
+                            !mEnded,
+                            mHost.now() - mStartMs,
+                            installed != null,
+                            downloadable != null);
+            // "Use … next time" comes after the session.
+            if (decision == Decision.NEXT_TIME && !mEnded) return;
+            mOffered = true;
+            String name = displayName(mHost.context(), heard);
+            if (name == null) return;
+            switch (decision) {
+                case SWITCH_CHIP:
+                    showSwitch(name, assumeNonNull(installed));
+                    break;
+                case NEXT_TIME:
+                    // Nothing to remember for a private tab.
+                    if (TextUtils.isEmpty(mOrigin)) return;
+                    showNextTime(name, assumeNonNull(installed));
+                    break;
+                case NEEDS_PACK:
+                    showNeedsPack(name, assumeNonNull(downloadable));
+                    break;
+                case QUIET:
+                    break;
+            }
+        }
+
+        private void showSwitch(String name, String tag) {
+            Context context = mHost.context();
+            SpeechLanguageSnackbar.showSnackbar(
+                    mHost.snackbarManager(),
+                    context.getString(R.string.tark_voice_heard_switch, name),
+                    context.getString(R.string.tark_voice_heard_switch_action),
+                    () -> {
+                        // The person chose it: this site starts in it from now on too.
+                        if (!mEnded && mHost.switchLanguage(tag)) {
+                            mSwitched = true;
+                            mTag = tag;
+                        }
+                        remember(tag);
+                    });
+        }
+
+        private void showNextTime(String name, String tag) {
+            Context context = mHost.context();
+            SpeechLanguageSnackbar.showSnackbar(
+                    mHost.snackbarManager(),
+                    context.getString(R.string.tark_voice_heard, name),
+                    context.getString(R.string.tark_voice_heard_use_next_time, name),
+                    () -> remember(tag));
+        }
+
+        private void showNeedsPack(String name, String tag) {
+            Context context = mHost.context();
+            SpeechLanguageSnackbar.showSnackbar(
+                    mHost.snackbarManager(),
+                    context.getString(R.string.tark_voice_heard_missing, name),
+                    context.getString(R.string.tark_speech_language_download),
+                    () -> {
+                        mHost.download(tag);
+                        // The next session here starts in it once it is on the phone, as if
+                        // "Use … next time" had been tapped.
+                        remember(tag);
+                    });
+        }
+
+        private void remember(String tag) {
+            // A private tab's session has no origin: nothing is stored for it.
+            if (TextUtils.isEmpty(mOrigin)) return;
+            VoiceSiteLanguages.set(mOrigin, tag);
+        }
+
+        @VisibleForTesting
+        boolean isSwitchedForTesting() {
+            return mSwitched;
+        }
+
+        /**
+         * The capture thread: reads the microphone in 20 ms chunks, appends each to the ring and
+         * writes it to the current pipe; a replay writes the ring into a new pipe first.
+         */
+        private final class Capture implements Runnable {
+            private final Mic mMic;
+            private final AtomicReference<@Nullable Writer> mReplay = new AtomicReference<>();
+            private volatile boolean mStopped;
+            // Capture thread only.
+            private Writer mWriter;
+
+            Capture(Mic mic, Writer writer) {
+                mMic = mic;
+                mWriter = writer;
+            }
+
+            void replayInto(Writer writer) {
+                Writer previous = mReplay.getAndSet(writer);
+                if (previous != null) previous.close();
+                if (mStopped) {
+                    Writer left = mReplay.getAndSet(null);
+                    if (left != null) left.close();
+                }
+            }
+
+            void stop() {
+                mStopped = true;
+            }
+
+            @Override
+            public void run() {
+                try {
+                    if (!mMic.start()) return;
+                    short[] buffer = new short[CHUNK_SAMPLES];
+                    int chunks = 0;
+                    while (!mStopped) {
+                        int read = mMic.read(buffer);
+                        if (read <= 0) break;
+                        Writer replay = mReplay.getAndSet(null);
+                        if (replay != null) {
+                            // Everything held so far, then the live audio from this chunk on.
+                            replay.write(mDetector.buffered());
+                            mWriter.close();
+                            mWriter = replay;
+                        }
+                        mDetector.append(buffer, read);
+                        mWriter.write(Arrays.copyOf(buffer, read));
+                        if (++chunks % PROCESS_EVERY_CHUNKS == 0) {
+                            mHost.runOnDetectorSequence(Session.this::process);
+                        }
+                    }
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Capture ended", e);
+                } finally {
+                    mStopped = true;
+                    mMic.release();
+                    mWriter.close();
+                    Writer replay = mReplay.getAndSet(null);
+                    if (replay != null) replay.close();
+                    mHost.runOnDetectorSequence(Session.this::finishDetector);
+                }
+            }
+        }
+
+        /** Writes PCM16 into one pipe, on its own executor; drops writes once it broke. */
+        private final class Writer {
+            private final OutputStream mOut;
+            private final Executor mExecutor;
+            private final AtomicBoolean mClosed = new AtomicBoolean();
+            // The writer's executor only.
+            private boolean mBroken;
+            private long mFirstWriteMs = -1;
+            private long mWrittenSamples;
+
+            Writer(OutputStream out) {
+                mOut = out;
+                mExecutor = mHost.newWriterExecutor();
+            }
+
+            void write(short[] pcm) {
+                mExecutor.execute(() -> writeNow(pcm));
+            }
+
+            void close() {
+                if (!mClosed.compareAndSet(false, true)) return;
+                mExecutor.execute(
+                        () -> {
+                            mBroken = true;
+                            try {
+                                mOut.close();
+                            } catch (IOException e) {
+                                // Gone either way.
+                            }
+                        });
+                if (mExecutor instanceof ExecutorService service) service.shutdown();
+            }
+
+            private void writeNow(short[] pcm) {
+                if (mBroken) return;
+                if (mFirstWriteMs < 0) mFirstWriteMs = mHost.now();
+                byte[] bytes = new byte[CHUNK_SAMPLES * 2];
+                try {
+                    for (int start = 0; start < pcm.length; start += CHUNK_SAMPLES) {
+                        int count = Math.min(CHUNK_SAMPLES, pcm.length - start);
+                        // Never faster than REPLAY_SPEEDUP times real time.
+                        long due =
+                                mFirstWriteMs
+                                        + mWrittenSamples * 1000 / SAMPLE_RATE / REPLAY_SPEEDUP;
+                        long wait = due - mHost.now();
+                        if (wait > 0) mHost.sleepMs(wait);
+                        for (int i = 0; i < count; i++) {
+                            short sample = pcm[start + i];
+                            bytes[2 * i] = (byte) sample;
+                            bytes[2 * i + 1] = (byte) (sample >> 8);
+                        }
+                        mOut.write(bytes, 0, count * 2);
+                        mWrittenSamples += count;
+                    }
+                } catch (IOException e) {
+                    // The recognizer went away (cancelled, switched, ended).
+                    mBroken = true;
+                }
+            }
+        }
+    }
+
+    private static void closeQuietly(Pipe pipe) {
+        try {
+            pipe.readEnd.close();
+        } catch (IOException e) {
+            // Gone either way.
+        }
+        try {
+            pipe.writeEnd.close();
+        } catch (IOException e) {
+            // Gone either way.
+        }
+    }
+
+    /** The language's name in the UI's language ("Hindi"), or null if Android has none. */
+    private static @Nullable String displayName(Context context, String code) {
+        Locale language = Locale.forLanguageTag(languageOf(code));
+        Locale ui = context.getResources().getConfiguration().getLocales().get(0);
+        String name = language.getDisplayLanguage(ui);
+        if (TextUtils.isEmpty(name) || name.equalsIgnoreCase(language.getLanguage())) return null;
+        return name;
+    }
+
+    /** The real pieces. */
+    private static final class AndroidHost implements Host {
+        private static @Nullable SequencedTaskRunner sDetectorSequence;
+        private final Context mContext;
+
+        AndroidHost(Context context) {
+            mContext = context.getApplicationContext();
+        }
+
+        @Override
+        public boolean hasRecordPermission() {
+            return mContext.checkSelfPermission(Manifest.permission.RECORD_AUDIO)
+                    == PackageManager.PERMISSION_GRANTED;
+        }
+
+        @Override
+        public boolean isDetectionOn() {
+            return VoiceDetector.status().isOn();
+        }
+
+        @Override
+        public String modelsDir() {
+            return TarkCaptionsBridge.getUnitDir(TarkCaptionsBridge.LANGUAGE_ID_UNIT);
+        }
+
+        @Override
+        public void setUnitInUse(boolean inUse) {
+            TarkCaptionsBridge.setUnitInUse(TarkCaptionsBridge.LANGUAGE_ID_UNIT, inUse);
+        }
+
+        @Override
+        public @Nullable Mic openMic() {
+            int minimum =
+                    AudioRecord.getMinBufferSize(
+                            SAMPLE_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT);
+            if (minimum <= 0) return null;
+            AudioRecord record;
+            try {
+                // A second of slack: the capture thread may wait on a replay's first write.
+                record =
+                        new AudioRecord(
+                                MediaRecorder.AudioSource.VOICE_RECOGNITION,
+                                SAMPLE_RATE,
+                                AudioFormat.CHANNEL_IN_MONO,
+                                AudioFormat.ENCODING_PCM_16BIT,
+                                Math.max(minimum, SAMPLE_RATE * 2));
+            } catch (IllegalArgumentException | SecurityException e) {
+                Log.w(TAG, "No microphone", e);
+                return null;
+            }
+            if (record.getState() != AudioRecord.STATE_INITIALIZED) {
+                record.release();
+                return null;
+            }
+            return new Mic() {
+                @Override
+                public boolean start() {
+                    Process.setThreadPriority(Process.THREAD_PRIORITY_URGENT_AUDIO);
+                    try {
+                        record.startRecording();
+                    } catch (IllegalStateException | SecurityException e) {
+                        Log.w(TAG, "Recording refused", e);
+                        return false;
+                    }
+                    return record.getRecordingState() == AudioRecord.RECORDSTATE_RECORDING;
+                }
+
+                @Override
+                public int read(short[] buffer) {
+                    return record.read(buffer, 0, buffer.length);
+                }
+
+                @Override
+                public void release() {
+                    try {
+                        record.stop();
+                    } catch (IllegalStateException e) {
+                        // Never started.
+                    }
+                    record.release();
+                }
+            };
+        }
+
+        @Override
+        public @Nullable Pipe createPipe() {
+            try {
+                ParcelFileDescriptor[] pipe = ParcelFileDescriptor.createPipe();
+                return new Pipe(
+                        pipe[0], new ParcelFileDescriptor.AutoCloseOutputStream(pipe[1]));
+            } catch (IOException e) {
+                Log.w(TAG, "No pipe", e);
+                return null;
+            }
+        }
+
+        @Override
+        public Detector newDetector() {
+            VoiceLanguageDetector detector = new VoiceLanguageDetector();
+            return new Detector() {
+                @Override
+                public void append(short[] pcm, int length) {
+                    detector.append(pcm, length);
+                }
+
+                @Override
+                public short[] buffered() {
+                    return detector.buffered();
+                }
+
+                @Override
+                public boolean load(String modelsDir) {
+                    return detector.load(modelsDir);
+                }
+
+                @Override
+                public @Nullable String process() {
+                    return detector.process();
+                }
+
+                @Override
+                public @Nullable String finish() {
+                    return detector.finish();
+                }
+
+                @Override
+                public void destroy() {
+                    detector.destroy();
+                }
+            };
+        }
+
+        @Override
+        public void startThread(Runnable task, String name) {
+            new Thread(task, name).start();
+        }
+
+        @Override
+        public Executor newWriterExecutor() {
+            return Executors.newSingleThreadExecutor(task -> new Thread(task, "TarkVoicePipe"));
+        }
+
+        @Override
+        public void sleepMs(long ms) {
+            SystemClock.sleep(ms);
+        }
+
+        @Override
+        public void runOnDetectorSequence(Runnable task) {
+            if (sDetectorSequence == null) {
+                sDetectorSequence =
+                        PostTask.createSequencedTaskRunner(TaskTraits.USER_VISIBLE_MAY_BLOCK);
+            }
+            sDetectorSequence.postTask(task);
+        }
+
+        @Override
+        public void runOnUiThread(Runnable task) {
+            PostTask.postTask(TaskTraits.UI_DEFAULT, task);
+        }
+
+        @Override
+        public long now() {
+            return SystemClock.elapsedRealtime();
+        }
+
+        @Override
+        public void languages(Callback<@Nullable Languages> callback) {
+            try {
+                VoicePlatform.get()
+                        .support(
+                                mContext,
+                                null,
+                                support ->
+                                        callback.onResult(
+                                                Build.VERSION.SDK_INT
+                                                                >= Build.VERSION_CODES.TIRAMISU
+                                                        ? languagesOf(support)
+                                                        : null));
+            } catch (RuntimeException e) {
+                // No recognizer to ask (a binding Android refused).
+                callback.onResult(null);
+            }
+        }
+
+        @Override
+        public boolean switchLanguage(String bcp47) {
+            return SpeechRecognition.switchLanguage(bcp47);
+        }
+
+        @Override
+        public @Nullable SnackbarManager snackbarManager() {
+            Activity activity = ApplicationStatus.getLastTrackedFocusedActivity();
+            if (activity instanceof SnackbarManager.SnackbarManageable manageable) {
+                return manageable.getSnackbarManager();
+            }
+            return null;
+        }
+
+        @Override
+        public void download(String bcp47) {
+            VoicePlatform.get().download(mContext, bcp47, null);
+        }
+
+        @Override
+        public Context context() {
+            return mContext;
+        }
+    }
+}
