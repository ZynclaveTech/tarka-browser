+
+        @Override
+        public @Nullable String finish() {
+            return mFinishAnswer;
+        }
+
+        @Override
+        public void destroy() {
+            // The ring goes with the native detector.
+            mRing.clear();
+            mDestroyed = true;
+        }
+    }
+
+    /** Android's and Tark's pieces; threads are queues the test runs. */
+    private final class FakeHost implements VoiceDetection.Host {
+        boolean mLowEnd;
+        int mModelLoads;
+        int mModelUnloads;
+        int mMicReleases;
+        @Nullable Runnable mUnloadWatch;
+        // Delayed UI tasks, in posting order; run by the test.
+        final List<Runnable> mDelayed = new ArrayList<>();
+        final List<Long> mDelays = new ArrayList<>();
+        final List<SnackbarManager.SnackbarController> mDismissed = new ArrayList<>();
+        // Writers' executors queue their writes here instead of running them, when set.
+        @Nullable List<Runnable> mWriterQueue;
+        boolean mPermission = true;
+        boolean mDetectionOn = true;
+        final List<Boolean> mInUse = new ArrayList<>();
+        final List<FakePipeOut> mPipes = new ArrayList<>();
+        final List<ParcelFileDescriptor> mReadEnds = new ArrayList<>();
+        final List<Runnable> mThreads = new ArrayList<>();
+        final List<Runnable> mDetectorTasks = new ArrayList<>();
+        final List<String> mSwitches = new ArrayList<>();
+        final List<String> mDownloads = new ArrayList<>();
+        final FakeDetector mDetector = new FakeDetector();
+        final SnackbarManager mSnackbars = mock(SnackbarManager.class);
+        int mMicsOpened;
+        int mDetectorsMade;
+        int mLanguageChecks;
+        long mNow;
+        // Chunks the microphone gives, then its end; mOnRead runs before read number mOnReadAt.
+        final List<short[]> mChunks = new ArrayList<>();
+        @Nullable Runnable mOnRead;
+        int mOnReadAt = -1;
+        // The live session, which a switch replays into (SpeechRecognitionImpl's part).
+        VoiceDetection.@Nullable Session mSession;
+        @Nullable Callback<VoiceDetection.@Nullable Languages> mLanguagesCallback;
+
+        @Override
+        public boolean hasRecordPermission() {
+            return mPermission;
+        }
+
+        @Override
+        public boolean isDetectionOn() {
+            return mDetectionOn;
+        }
+
+        @Override
+        public String modelsDir() {
+            return "/data/captions/language_id";
+        }
+
+        @Override
+        public void setUnitInUse(boolean inUse) {
+            mInUse.add(inUse);
+        }
+
+        @Override
+        public VoiceDetection.@Nullable Mic openMic() {
+            mMicsOpened++;
+            return new VoiceDetection.Mic() {
+                int mReads;
+
+                @Override
+                public boolean start() {
+                    return true;
+                }
+
+                @Override
+                public int read(short[] buffer) {
+                    if (mReads == mOnReadAt && mOnRead != null) mOnRead.run();
+                    if (mReads >= mChunks.size()) return 0;
+                    short[] chunk = mChunks.get(mReads++);
+                    System.arraycopy(chunk, 0, buffer, 0, chunk.length);
+                    return chunk.length;
+                }
+
+                @Override
+                public void release() {
+                    mMicReleases++;
+                }
+            };
+        }
+
+        @Override
+        public VoiceDetection.@Nullable Pipe createPipe() {
+            try {
+                File file = File.createTempFile("pipe", ".pcm");
+                file.deleteOnExit();
+                ParcelFileDescriptor readEnd =
+                        ParcelFileDescriptor.open(file, ParcelFileDescriptor.MODE_READ_ONLY);
+                FakePipeOut out = new FakePipeOut();
+                mPipes.add(out);
+                mReadEnds.add(readEnd);
+                return new VoiceDetection.Pipe(readEnd, out);
+            } catch (IOException e) {
+                throw new AssertionError(e);
+            }
+        }
+
+        @Override
+        public VoiceDetection.Detector newDetector() {
+            mDetectorsMade++;
+            return mDetector;
+        }
+
+        @Override
+        public void startThread(Runnable task, String name) {
+            mThreads.add(task);
+        }
+
+        @Override
+        public Executor newWriterExecutor() {
+            List<Runnable> queue = mWriterQueue;
+            return queue != null ? queue::add : Runnable::run;
+        }
+
+        @Override
+        public boolean isLowEndDevice() {
+            return mLowEnd;
+        }
+
+        @Override
+        public void postDelayedOnUi(Runnable task, long delayMs) {
+            mDelayed.add(task);
+            mDelays.add(delayMs);
+        }
+
+        @Override
+        public void cancelOnUi(Runnable task) {
+            int index = mDelayed.indexOf(task);
+            if (index < 0) return;
+            mDelayed.remove(index);
+            mDelays.remove(index);
+        }
+
+        @Override
+        public boolean loadModels(String modelsDir) {
+            mModelLoads++;
+            return true;
+        }
+
+        @Override
+        public void unloadModels() {
+            mModelUnloads++;
+        }
+
+        @Override
+        public void watchForUnload(Runnable unload) {
+            mUnloadWatch = unload;
+        }
+
+        @Override
+        public void dismissSnackbar(
+                @Nullable SnackbarManager manager, SnackbarManager.SnackbarController controller) {
+            mDismissed.add(controller);
+        }
+
+        /** Runs the delayed task posted with {@code delayMs}. */
+        void runDelayed(long delayMs) {
+            int index = mDelays.indexOf(delayMs);
+            assertTrue("nothing posted for " + delayMs + " ms", index >= 0);
+            mDelays.remove(index);
+            mDelayed.remove(index).run();
+        }
+
+        @Override
+        public void sleepMs(long ms) {}
+
+        @Override
+        public void runOnDetectorSequence(Runnable task) {
+            mDetectorTasks.add(task);
+        }
+
+        @Override
+        public void runOnUiThread(Runnable task) {
+            task.run();
+        }
+
+        @Override
+        public long now() {
+            return mNow;
+        }
+
+        @Override
+        public void languages(Callback<VoiceDetection.@Nullable Languages> callback) {
+            mLanguageChecks++;
+            mLanguagesCallback = callback;
+        }
+
+        @Override
+        public boolean switchLanguage(String bcp47) {
+            mSwitches.add(bcp47);
+            // As SpeechRecognitionImpl does: a new recognizer, fed the replay.
+            return mSession != null && mSession.replay() != null;
+        }
+
+        @Override
+        public @Nullable SnackbarManager snackbarManager(@Nullable WebContents webContents) {
+            return mSnackbars;
+        }
+
