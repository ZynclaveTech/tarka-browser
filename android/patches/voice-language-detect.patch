+            if (pipe == null || mic == null) {
+                if (pipe != null) closeQuietly(pipe);
+                return null;
+            }
+            String modelsDir = mHost.modelsDir();
+            // The shared models, held (with the language_id unit) while loaded.
+            Models.acquire(mHost, modelsDir);
+            mHost.runOnDetectorSequence(() -> mLoaded = mDetector.attach(modelsDir));
