+    @Test
+    @Config(sdk = 33)
+    public void testLateSwitchExtendsTheCapOnce() {
+        // A switch at 14 s whose replay takes 26 s to catch up: the cap moves to after it.
+        mAudio.mCatchUpMs = 26_000;
+        SpeechRecognitionImpl session = startPiped("en-IN");
+        int word = 0;
+        for (long t = 0; t < 14_000; t += 500) {
+            session.getListenerForTesting().onPartialResults(results("word " + word++));
+            ShadowLooper.idleMainLooper(500, MILLISECONDS);
+        }
+        assertTrue(SpeechRecognition.switchLanguage("hi-IN"));
+        long cap = 26_000 + SpeechRecognitionImpl.PIPE_AFTER_CATCH_UP_MS;
+        for (long t = 0; t < cap - 500; t += 500) {
+            session.getListenerForTesting().onPartialResults(results("shabd " + word++));
+            ShadowLooper.idleMainLooper(500, MILLISECONDS);
+        }
+        verify(mNatives, never()).onRecognitionEnd(anyLong());
+        session.getListenerForTesting().onPartialResults(results("ant"));
+        ShadowLooper.idleMainLooper(500, MILLISECONDS);
+        verify(mNatives).onRecognitionResults(NATIVE_1, new String[] {"ant"}, null, false);
+        verify(mNatives).onRecognitionEnd(NATIVE_1);
+    }
