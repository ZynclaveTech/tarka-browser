+
+#include <jni.h>
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/files/file_path.h"
+#include "chrome/browser/tark_voice_android/voice_language_detector.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/tark_voice_android/android/jni_headers/VoiceLanguageDetector_jni.h"
+
+namespace tark_voice {
+namespace {
+
+// Loaded by name from the app's native libraries, as the captions process
+// does (android/captions/ort.sh).
+constexpr char kOrtLibrary[] = "libonnxruntime.so";
+
+VoiceLanguageDetector* From(int64_t detector) {
+  return reinterpret_cast<VoiceLanguageDetector*>(static_cast<intptr_t>(detector));
+}
+
+}  // namespace
+
+static int64_t JNI_VoiceLanguageDetector_Create(JNIEnv* env) {
+  return static_cast<int64_t>(reinterpret_cast<intptr_t>(new VoiceLanguageDetector()));
+}
+
+static void JNI_VoiceLanguageDetector_Append(JNIEnv* env,
+                                             int64_t detector,
+                                             const jni_zero::JavaRef<jshortArray>& pcm,
+                                             int32_t length) {
+  if (length <= 0) {
+    return;
+  }
+  std::vector<int16_t> samples(static_cast<size_t>(length));
+  env->GetShortArrayRegion(pcm.obj(), 0, length, reinterpret_cast<jshort*>(samples.data()));
+  From(detector)->ring().Append(samples);
+}
+
+static jni_zero::ScopedJavaLocalRef<jshortArray> JNI_VoiceLanguageDetector_Buffered(
+    JNIEnv* env,
+    int64_t detector) {
+  const std::vector<int16_t> held = From(detector)->ring().Snapshot();
+  jshortArray array = env->NewShortArray(static_cast<jsize>(held.size()));
+  env->SetShortArrayRegion(array, 0, static_cast<jsize>(held.size()),
+                           reinterpret_cast<const jshort*>(held.data()));
+  return jni_zero::ScopedJavaLocalRef<jshortArray>::Adopt(env, array);
+}
+
+static bool JNI_VoiceLanguageDetector_LoadShared(JNIEnv* env, const std::string& models_dir) {
+  return VoiceLanguageDetector::LoadShared(base::FilePath(models_dir),
+                                           base::FilePath(kOrtLibrary));
+}
+
+static void JNI_VoiceLanguageDetector_UnloadShared(JNIEnv* env) {
+  VoiceLanguageDetector::UnloadShared();
+}
+
+static bool JNI_VoiceLanguageDetector_Attach(JNIEnv* env,
+                                             int64_t detector,
+                                             const std::string& models_dir) {
+  return From(detector)->Attach(base::FilePath(models_dir));
+}
+
+static std::string JNI_VoiceLanguageDetector_Process(JNIEnv* env, int64_t detector) {
+  return From(detector)->Process().value_or(std::string());
+}
+
+static std::string JNI_VoiceLanguageDetector_Finish(JNIEnv* env, int64_t detector) {
+  return From(detector)->Finish().value_or(std::string());
+}
+
+static void JNI_VoiceLanguageDetector_Destroy(JNIEnv* env, int64_t detector) {
+  // Drops the session's audio (the destructor ends the session).
+  delete From(detector);
+}
+
+}  // namespace tark_voice
+
+DEFINE_JNI(VoiceLanguageDetector)
diff '--color=never' -ruN a/chrome/browser/tark_voice_android/voice_language_detector.cc b/chrome/browser/tark_voice_android/voice_language_detector.cc
--- a/chrome/browser/tark_voice_android/voice_language_detector.cc	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/browser/tark_voice_android/voice_language_detector.cc	2026-10-25 19:17:05.805213539 +0530
@@ -0,0 +1,313 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_voice_android/voice_language_detector.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "components/tark_captions/detection_policy.h"
+#include "components/tark_captions/language_detector.h"
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/vad.h"
+
+namespace tark_voice {
+
+namespace {
+
+// Silero's chunks are speech at this probability (as captions' segmenter).
+constexpr float kSpeechProbability = 0.5f;
+// A session that ends sooner is decided on at least this much speech.
+constexpr double kShortestSpeech = 1.0;
+
+// The process's detector models (LoadShared), used on the detector's
+// sequence only.
+struct SharedModels {
+  std::unique_ptr<tark_captions::OrtRuntime> runtime;
+  std::unique_ptr<tark_captions::LanguageDetector> detector;
+  base::FilePath dir;
+  SharedUse use;
+};
+
+void FreeShared(SharedModels& shared) {
+  // The detector's model before the runtime it runs on.
+  shared.detector.reset();
+  shared.runtime.reset();
+  shared.dir.clear();
+}
+
+SharedModels& Shared() {
+  static base::NoDestructor<SharedModels> shared;
+  return *shared;
+}
+
+}  // namespace
+
+bool SharedUse::Detach() {
+  if (attached_ > 0) {
+    --attached_;
+  }
+  if (attached_ == 0 && unload_pending_) {
+    unload_pending_ = false;
+    return true;
+  }
+  return false;
+}
+
+bool SharedUse::RequestUnload() {
+  if (attached_ > 0) {
+    unload_pending_ = true;
+    return false;
+  }
+  unload_pending_ = false;
+  return true;
+}
+
+AudioRing::AudioRing() = default;
+AudioRing::~AudioRing() = default;
+
+void AudioRing::Append(base::span<const int16_t> pcm) {
+  base::AutoLock lock(lock_);
+  for (int16_t sample : pcm) {
+    if (samples_.size() < kCapacity) {
+      samples_.push_back(sample);
+    } else {
+      samples_[next_] = sample;
+      next_ = (next_ + 1) % kCapacity;
+    }
+  }
+  total_ += static_cast<int64_t>(pcm.size());
+}
+
+std::vector<int16_t> AudioRing::Snapshot() const {
+  base::AutoLock lock(lock_);
+  std::vector<int16_t> out;
+  out.reserve(samples_.size());
+  out.insert(out.end(), samples_.begin() + next_, samples_.end());
+  out.insert(out.end(), samples_.begin(), samples_.begin() + next_);
+  return out;
+}
+
+std::vector<int16_t> AudioRing::Range(int64_t begin, int64_t end) const {
+  base::AutoLock lock(lock_);
+  const int64_t oldest = total_ - static_cast<int64_t>(samples_.size());
+  begin = std::max(begin, oldest);
+  end = std::min(end, total_);
+  std::vector<int16_t> out;
+  if (begin >= end) {
+    return out;
+  }
+  out.reserve(static_cast<size_t>(end - begin));
+  for (int64_t i = begin; i < end; ++i) {
+    // The held sample i is at (next_ + (i - oldest)) % size once full, and
+    // at i - oldest (oldest is 0) before.
+    const size_t index = (next_ + static_cast<size_t>(i - oldest)) % samples_.size();
+    out.push_back(samples_[index]);
+  }
+  return out;
+}
+
+size_t AudioRing::size() const {
+  base::AutoLock lock(lock_);
+  return samples_.size();
+}
+
+int64_t AudioRing::total() const {
+  base::AutoLock lock(lock_);
+  return total_;
+}
+
+void AudioRing::Clear() {
+  base::AutoLock lock(lock_);
+  // swap() frees the memory; clear() would keep it.
+  std::vector<int16_t>().swap(samples_);
+  next_ = 0;
+  total_ = 0;
+}
+
+VoiceLanguageDetector::VoiceLanguageDetector() {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+VoiceLanguageDetector::~VoiceLanguageDetector() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  EndSession();
+  // The VAD runs on the shared runtime: it goes first.
+  vad_.reset();
+  if (detector_) {
+    detector_ = nullptr;
+    SharedModels& shared = Shared();
+    if (shared.use.Detach()) {
+      FreeShared(shared);
+    }
+  }
+}
+
+// static
+bool VoiceLanguageDetector::LoadShared(const base::FilePath& models_dir,
+                                       const base::FilePath& ort_library) {
+  SharedModels& shared = Shared();
+  if (shared.detector && shared.dir == models_dir) {
+    return true;
+  }
+  // Never under an attached session's feet: another folder waits.
+  if (!shared.use.CanReplace()) {
+    return false;
+  }
+  FreeShared(shared);
+  std::unique_ptr<tark_captions::OrtRuntime> runtime =
+      tark_captions::OrtRuntime::Load(ort_library);
+  if (!runtime) {
+    return false;
+  }
+  std::unique_ptr<tark_captions::LanguageDetector> detector =
+      tark_captions::LanguageDetector::Load(runtime.get(), models_dir);
+  if (!detector) {
+    return false;
+  }
+  shared.runtime = std::move(runtime);
+  shared.detector = std::move(detector);
+  shared.dir = models_dir;
+  return true;
+}
+
+// static
+void VoiceLanguageDetector::UnloadShared() {
+  SharedModels& shared = Shared();
+  if (shared.use.RequestUnload()) {
+    FreeShared(shared);
+  }
+}
+
+// static
+int VoiceLanguageDetector::SharedAttachedForTesting() {
+  return Shared().use.attached();
+}
+
+// static
+bool VoiceLanguageDetector::SharedLoadedForTesting() {
+  return Shared().detector != nullptr;
+}
+
+bool VoiceLanguageDetector::Attach(const base::FilePath& models_dir) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  SharedModels& shared = Shared();
+  if (!shared.detector) {
+    return false;
+  }
+  vad_ = tark_captions::Vad::Load(shared.runtime.get(), models_dir);
+  if (!vad_) {
+    return false;
+  }
+  detector_ = shared.detector.get();
+  shared.use.Attach();
+  next_check_ = tark_captions::kFirstDecision;
+  return true;
+}
+
+std::optional<std::string> VoiceLanguageDetector::Process() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (decided_ || !detector_ || !vad_) {
+    return std::nullopt;
+  }
+  constexpr int64_t kChunk = static_cast<int64_t>(tark_captions::Vad::kChunk);
+  const int64_t total = ring_.total();
+  // A detector that fell more than the ring behind goes on from what is held.
+  read_ = std::max(read_, total - static_cast<int64_t>(ring_.size()));
+  while (read_ + kChunk <= total) {
+    const std::vector<int16_t> pcm = ring_.Range(read_, read_ + kChunk);
+    if (pcm.size() != static_cast<size_t>(kChunk)) {
+      break;
+    }
+    std::array<float, tark_captions::Vad::kChunk> chunk;
+    for (size_t i = 0; i < chunk.size(); ++i) {
+      chunk[i] = pcm[i] / 32768.0f;
+    }
+    if (vad_->Process(chunk) >= kSpeechProbability) {
+      if (!speech_.empty() && speech_.back().second == read_) {
+        speech_.back().second += kChunk;
+      } else {
+        speech_.emplace_back(read_, read_ + kChunk);
+      }
+      speech_samples_ += kChunk;
+    }
+    read_ += kChunk;
+    const double seconds = static_cast<double>(speech_samples_) / AudioRing::kSampleRate;
+    if (seconds >= next_check_) {
+      next_check_ += 1.0;
+      if (std::optional<std::string> decision = DecideOn(seconds)) {
+        return decision;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string> VoiceLanguageDetector::Finish() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (decided_ || !detector_) {
+    return std::nullopt;
+  }
+  // The last of the audio first: it may reach a check.
+  if (std::optional<std::string> decision = Process()) {
+    return decision;
+  }
+  if (decided_) {
+    return std::nullopt;
+  }
+  const double seconds = static_cast<double>(speech_samples_) / AudioRing::kSampleRate;
+  if (seconds < kShortestSpeech) {
+    return std::nullopt;
+  }
+  // Below kLastDecision the policy decides only when the detector is sure.
+  std::optional<std::string> decision =
+      DecideOn(std::min(std::max(seconds, tark_captions::kFirstDecision),
+                        tark_captions::kLastDecision - 0.5));
+  return decision && *decision != kUnsure ? decision : std::nullopt;
+}
+
+std::optional<std::string> VoiceLanguageDetector::DecideOn(double speech_seconds) {
+  std::vector<float> speech;
+  for (const auto& [begin, end] : speech_) {
+    const std::vector<int16_t> pcm = ring_.Range(begin, end);
+    for (int16_t sample : pcm) {
+      speech.push_back(sample / 32768.0f);
+    }
+  }
+  const std::vector<float> logits = detector_->Logits(speech);
+  const tark_captions::Detection detection =
+      tark_captions::DecideLanguage(logits, detector_->labels(), speech_seconds);
+  if (detection.kind == tark_captions::Detection::Kind::kUnsure) {
+    if (speech_seconds < tark_captions::kLastDecision) {
+      return std::nullopt;
+    }
+    // No answer at the last check (the model failed, or the speech left the
+    // ring): unsure, and nothing more is tried.
+    decided_ = true;
+    return std::string(kUnsure);
+  }
+  decided_ = true;
+  return detection.code;
+}
+
+void VoiceLanguageDetector::EndSession() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ring_.Clear();
+  if (vad_) {
+    vad_->Reset();
+  }
+  read_ = 0;
+  std::vector<std::pair<int64_t, int64_t>>().swap(speech_);
+  speech_samples_ = 0;
+  next_check_ = tark_captions::kFirstDecision;
+  decided_ = false;
+}
+
+double VoiceLanguageDetector::speech_seconds_for_testing() const {
+  return static_cast<double>(speech_samples_) / AudioRing::kSampleRate;
+}
+
+}  // namespace tark_voice
