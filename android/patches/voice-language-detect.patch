+    @Test
+    @Config(sdk = 33)
+    public void testSwitchWithPauseInReplayKeepsFullText() {
+        mAudio.mCatchUpMs = 6000;
+        SpeechRecognitionImpl session = startPiped("en-IN");
+        session.getListenerForTesting().onPartialResults(results("mosam"));
+        assertTrue(SpeechRecognition.switchLanguage("hi-IN"));
+        RecognitionListener listener = session.getListenerForTesting();
+        listener.onPartialResults(results("मौसम"));
+        // The replay's own pause: an end of speech and the capture's silence, mid-replay.
+        listener.onEndOfSpeech();
+        assertNotNull(mAudio.mOnQuiet);
+        mAudio.mOnQuiet.run();
+        ShadowLooper.idleMainLooper(2000, MILLISECONDS);
+        verify(mNatives, never()).onRecognitionEnd(anyLong());
+        listener.onBeginningOfSpeech();
+        listener.onPartialResults(results("मौसम कैसा है"));
+        ShadowLooper.idleMainLooper(3000, MILLISECONDS);
+        verify(mNatives, never()).onRecognitionEnd(anyLong());
+        // Caught up, then the usual quiet after the text.
+        ShadowLooper.idleMainLooper(
+                1000 + SpeechRecognitionImpl.PIPE_END_AFTER_TEXT_MS, MILLISECONDS);
+        verify(mNatives).onRecognitionResults(NATIVE_1, new String[] {"मौसम कैसा है"}, null, false);
+        verify(mNatives).onRecognitionEnd(NATIVE_1);
+    }
