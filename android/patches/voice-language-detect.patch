+        }
+
+        @Override
+        public Context context() {
+            return ApplicationProvider.getApplicationContext();
+        }
+
+        void runCapture() {
+            List<Runnable> threads = new ArrayList<>(mThreads);
+            mThreads.clear();
+            for (Runnable thread : threads) thread.run();
+        }
+
+        void runDetector() {
+            while (!mDetectorTasks.isEmpty()) mDetectorTasks.remove(0).run();
+        }
+    }
+
+    private FakeHost mHost;
+
+    @Before
+    public void setUp() {
+        mHost = new FakeHost();
+        VoiceDetection.setHostForTesting(mHost);
+        VoiceDetection.setLanguagesForTesting(null);
+        VoiceSiteLanguages.remove(SITE);
+    }
+
+    /** Chunk i of 20 ms, every sample i + 1. */
+    private static short[] chunk(int i) {
+        short[] pcm = new short[VoiceDetection.CHUNK_SAMPLES];
+        Arrays.fill(pcm, (short) (i + 1));
+        return pcm;
+    }
+
+    private static byte[] bytesOf(int from, int to) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (int i = from; i < to; i++) {
+            for (short sample : chunk(i)) {
+                out.write((byte) sample);
+                out.write((byte) (sample >> 8));
+            }
+        }
+        return out.toByteArray();
+    }
+
+    private void giveChunks(int count) {
+        for (int i = 0; i < count; i++) mHost.mChunks.add(chunk(i));
+    }
+
+    private VoiceDetection.Session open(String origin, String tag) {
+        SpeechRecognition.AudioSource source =
+                VoiceDetection.audioSourceFor(
+                        ApplicationProvider.getApplicationContext(), origin, tag, null);
+        assertNotNull(source);
+        VoiceDetection.Session session = (VoiceDetection.Session) source;
+        mHost.mSession = session;
+        assertNotNull(session.open());
+        return session;
+    }
+
+    private static VoiceDetection.Languages languages(List<String> installed, List<String> more) {
+        return new VoiceDetection.Languages(installed, more);
+    }
+
+    private Snackbar shown() {
+        ArgumentCaptor<Snackbar> captor = ArgumentCaptor.forClass(Snackbar.class);
+        verify(mHost.mSnackbars).showSnackbar(captor.capture());
+        return captor.getValue();
+    }
+
+    private static void tap(Snackbar snackbar) {
+        assertNotNull(snackbar.getController());
+        snackbar.getController().onAction(snackbar.getActionData());
+    }
+
+    /** A session in en-IN whose detector hears {@code heard} after the session ended. */
+    private VoiceDetection.Session endedHearing(String origin, String heard) {
+        giveChunks(3);
+        VoiceDetection.Session session = open(origin, "en-IN");
+        mHost.mDetector.mFinishAnswer = heard;
+        mHost.runCapture();
+        session.close();
+        mHost.runDetector();
+        return session;
+    }
