+        sLanguages = languages;
+    }
+
+    @VisibleForTesting
+    static void setLowEndForTesting(@Nullable Boolean lowEnd) {
+        sLowEndForTesting = lowEnd;
+        ResettersForTesting.register(() -> sLowEndForTesting = null);
+    }
+
+    private static Host host(Context context) {
+        if (sHostForTesting != null) return sHostForTesting;
+        if (sHost == null) sHost = new AndroidHost(context);
+        return sHost;
+    }
+
+    /** Whether this phone may run detection: not on a low-end one (Voice languages hides it). */
+    static boolean isOffered() {
+        if (sLowEndForTesting != null) return !sLowEndForTesting;
+        if (sHostForTesting != null) return !sHostForTesting.isLowEndDevice();
+        return !SysUtils.isLowEndDevice();
+    }
+
+    /**
+     * A voice session starts (any, with or without detection): from here, one prompt at most
+     * until the next one.
+     */
+    static void onSessionStarting() {
+        sSessionSerial++;
+    }
+
+    /** Whether this session already prompted the person. */
+    static boolean promptedThisSession() {
+        return sSessionSerial != 0 && sPromptedSerial == sSessionSerial;
+    }
+
+    /** Takes this session's one prompt; false if it was taken already. */
+    static boolean claimPrompt() {
+        if (promptedThisSession()) return false;
+        sPromptedSerial = sSessionSerial;
+        return true;
+    }
+
+    /** Voice turned detection off: the models go now (or when the session in progress ends). */
+    static void onDetectorRemoved() {
+        Host host = sHostForTesting != null ? sHostForTesting : sHost;
+        if (host != null) Models.unload(host);
+    }
+
+    /**
+     * The audio for a session that starts, if detection runs for it; else null, and Android's
+     * recognizer uses the microphone as without detection.
+     *
+     * @param webContents The session's tab: what detection shows goes in its window.
+     */
+    public static SpeechRecognition.@Nullable AudioSource audioSourceFor(
+            Context context, String origin, String bcp47, @Nullable WebContents webContents) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return null;
+        if (!isOffered()) return null;
+        Host host = host(context);
+        // Tark's own capture needs Tark's own permission, whatever the site was granted.
+        if (!host.hasRecordPermission()) return null;
+        if (!host.isDetectionOn()) return null;
+        return new Session(host, origin, bcp47, webContents);
+    }
+
+    /**
+     * How long a replay of {@code heldMs} of audio takes to catch up with the live audio: its first
+     * {@link #REPLAY_BURST_MS} at once, then {@link #REPLAY_SPEEDUP} times real time while the
+     * live audio keeps coming.
+     */
+    @VisibleForTesting
+    static long catchUpMs(long heldMs) {
+        long paced = Math.max(0, heldMs - REPLAY_BURST_MS);
+        return (long) Math.ceil(paced / (REPLAY_SPEEDUP - 1));
+    }
+
+    /**
+     * The shared models' lifetime (UI thread): loaded for the first session, kept between
+     * sessions, freed after {@link #MODELS_IDLE_MS} without one, under memory pressure, in the
+     * background, or when voice turns detection off (once no session runs). The language_id unit
+     * is held (so a Remove waits) exactly while they are loaded.
+     */
+    @VisibleForTesting
+    static final class Models {
+        private static int sSessions;
+        private static boolean sHeld;
+        private static boolean sWatching;
+        private static boolean sUnloadWhenIdle;
+        private static @Nullable Runnable sIdleUnload;
+        // The detector's sequence only.
+        private static boolean sLoaded;
+
+        private Models() {}
+
+        /** A session starts: the models are loaded (or kept) for it. */
+        static void acquire(Host host, String modelsDir) {
+            if (!sWatching) {
+                sWatching = true;
+                host.watchForUnload(() -> unload(host));
+            }
+            if (sIdleUnload != null) {
+                host.cancelOnUi(sIdleUnload);
+                sIdleUnload = null;
+            }
+            sSessions++;
+            if (!sHeld) {
+                sHeld = true;
+                host.setUnitInUse(true);
+            }
+            host.runOnDetectorSequence(
+                    () -> {
+                        if (!sLoaded) sLoaded = host.loadModels(modelsDir);
+                    });
+        }
+
+        /** A session's detector is gone. */
+        static void release(Host host) {
+            if (sSessions > 0) sSessions--;
+            if (sSessions > 0) return;
+            if (sUnloadWhenIdle) {
+                unload(host);
+                return;
+            }
+            Runnable idle = () -> {
+                sIdleUnload = null;
+                unload(host);
+            };
+            sIdleUnload = idle;
+            host.postDelayedOnUi(idle, MODELS_IDLE_MS);
+        }
+
+        /** Frees the models now, or when the session in progress ends. */
+        static void unload(Host host) {
+            if (sSessions > 0) {
+                sUnloadWhenIdle = true;
+                return;
+            }
+            sUnloadWhenIdle = false;
+            if (sIdleUnload != null) {
+                host.cancelOnUi(sIdleUnload);
+                sIdleUnload = null;
+            }
+            if (!sHeld) return;
+            sHeld = false;
+            host.runOnDetectorSequence(
+                    () -> {
+                        if (sLoaded) host.unloadModels();
+                        sLoaded = false;
+                        // Released only once the files are no longer read.
+                        // Pairs the setUnitInUse(true) of this loaded period exactly
+                        // (CaptionDownloads counts holds).
+                        host.runOnUiThread(() -> host.setUnitInUse(false));
+                    });
+        }
+
+        static void resetForTesting() {
+            sSessions = 0;
+            sHeld = false;
+            sWatching = false;
+            sUnloadWhenIdle = false;
+            sIdleUnload = null;
+            sLoaded = false;
+        }
+    }
+
+    /** Android's latest answer, from Voice languages or the site languages' check. */
+    static void onSupport(@Nullable RecognitionSupport support) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) return;
+        sLanguages = languagesOf(support);
+    }
+
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static @Nullable Languages languagesOf(@Nullable RecognitionSupport support) {
+        if (support == null) return null;
+        List<String> downloadable = new ArrayList<>(support.getSupportedOnDeviceLanguages());
+        downloadable.addAll(support.getPendingOnDeviceLanguages());
+        return new Languages(
+                new ArrayList<>(support.getInstalledOnDeviceLanguages()), downloadable);
+    }
+
+    /**
+     * What the person sees when the detector heard {@code heardLang} in a session in {@code
+     * sessionTag}.
+     *
+     * @param sessionTag The language the session listens in (BCP 47).
+     * @param heardLang The detector's language (a VoxLingua code: "hi", "en"), or "und".
+     * @param sessionRunning Whether the session still listens.
+     * @param msSinceStart How long ago the session started.
+     * @param heardInstalled Whether the phone has the heard language.
+     * @param heardDownloadable Whether Android can download it.
+     */
+    public static Decision decide(
+            String sessionTag,
+            String heardLang,
+            boolean sessionRunning,
+            long msSinceStart,
+            boolean heardInstalled,
+            boolean heardDownloadable) {
+        if (TextUtils.isEmpty(heardLang) || VoiceLanguageDetector.UNSURE.equals(heardLang)) {
+            return Decision.QUIET;
+        }
+        if (sameLanguage(sessionTag, heardLang)) return Decision.QUIET;
+        if (heardInstalled) {
+            return sessionRunning && msSinceStart <= CHIP_WINDOW_MS
+                    ? Decision.SWITCH_CHIP
+                    : Decision.NEXT_TIME;
+        }
+        return heardDownloadable ? Decision.NEEDS_PACK : Decision.QUIET;
+    }
+
+    /** One language's code, whatever form names it ("iw" and "he"; Urdu as Hindi). */
+    @VisibleForTesting
+    static String languageOf(String code) {
+        String language = code.toLowerCase(Locale.ROOT);
+        String same = SAME_LANGUAGE.get(language);
+        return same != null ? same : language;
+    }
+
+    /** Whether a tag ("en-US") and a code ("en") name the same language, region aside. */
+    @VisibleForTesting
+    static boolean sameLanguage(String tag, String code) {
+        String language = Locale.forLanguageTag(tag).getLanguage();
+        if (language.isEmpty()) return false;
+        // VoxLingua has no Cantonese: in a Cantonese session it hears Chinese.
+        if (languageOf(language).equals("yue")) return languageOf(code).equals("cmn");
+        return languageOf(language).equals(languageOf(code));
