+    @Test
+    @Config(sdk = 33)
+    public void testSwitchRestartsInLanguageWithReplay() {
+        SpeechRecognitionImpl session = startPiped("en-IN");
+        RecognitionListener first = session.getListenerForTesting();
+        first.onReadyForSpeech(new Bundle());
+        first.onBeginningOfSpeech();
+        first.onPartialResults(results("mosam kesa"));
+        verify(mNatives).onRecognitionResults(NATIVE_1, new String[] {"mosam kesa"}, null, true);
+
+        assertTrue(SpeechRecognition.switchLanguage("hi-IN"));
+
+        assertEquals(2, mFactory.mCreated.size());
+        verify(mFactory.mCreated.get(0)).cancel();
+        assertEquals(1, mAudio.mReplays);
+        Intent second = intent(1);
+        assertEquals("hi-IN", second.getStringExtra(RecognizerIntent.EXTRA_LANGUAGE));
+        assertEquals(
+                mAudio.mOpened.get(1),
+                second.getParcelableExtra(SpeechRecognitionImpl.EXTRA_AUDIO_SOURCE, ParcelFileDescriptor.class));
+        RecognitionListener listener = session.getListenerForTesting();
+        // The cancelled recognizer's stray error, and its late events, change nothing.
+        listener.onError(SpeechRecognizer.ERROR_CLIENT);
+        first.onPartialResults(results("stale"));
+        listener.onReadyForSpeech(new Bundle());
+        listener.onPartialResults(results("मौसम कैसा है"));
+        listener.onEndOfSpeech();
+        ShadowLooper.idleMainLooper(SpeechRecognitionImpl.PIPE_END_AFTER_SPEECH_MS, MILLISECONDS);
+
+        // The page's audio started once; what it already had was never taken back.
+        verify(mNatives, times(1)).onAudioStart(NATIVE_1);
+        verify(mNatives, times(1)).onRecognitionResults(NATIVE_1, new String[] {"mosam kesa"}, null, true);
+        verify(mNatives).onRecognitionResults(NATIVE_1, new String[] {"मौसम कैसा है"}, null, false);
+        verify(mNatives, never()).onRecognitionError(anyLong(), anyInt());
+        verify(mNatives).onRecognitionEnd(NATIVE_1);
+        verify(mLanguageDelegate).onSessionEnded(SITE, "hi-IN");
+    }
