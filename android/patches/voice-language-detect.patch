diff '--color=never' -ruN a/chrome/browser/tark_voice_android/BUILD.gn b/chrome/browser/tark_voice_android/BUILD.gn
--- a/chrome/browser/tark_voice_android/BUILD.gn	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/browser/tark_voice_android/BUILD.gn	2026-10-25 19:17:05.730801822 +0530
@@ -0,0 +1,50 @@
+# Copyright 2026 The Tark Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Voice search's spoken-language detection (Tark for Android): captions'
+# language detector and Silero VAD over a session's audio, which a 15 s ring
+# holds in memory. Java (chrome/browser/speech/VoiceDetection.java) reaches
+# it through VoiceLanguageDetector.java. The ring's tests also build for the
+# build machine, in tark_captions_android_unittests (android/build.sh runs
+# them).
+
+static_library("detector") {
+  sources = [
+    "voice_language_detector.cc",
+    "voice_language_detector.h",
+  ]
+  deps = [ "//base" ]
+  if (is_android) {
+    deps += [ "//components/tark_captions" ]
+  } else {
+    # The build machine's tests: only what the detector compiles against,
+    # as components/tark_captions:tark_captions_engine_unittests does.
+    sources += [
+      "//components/tark_captions/detection_policy.cc",
+      "//components/tark_captions/detection_policy.h",
+      "//components/tark_captions/language_detector.cc",
+      "//components/tark_captions/language_detector.h",
+      "//components/tark_captions/model_source.cc",
+      "//components/tark_captions/model_source.h",
+      "//components/tark_captions/ort_runtime.cc",
+      "//components/tark_captions/ort_runtime.h",
+      "//components/tark_captions/vad.cc",
+      "//components/tark_captions/vad.h",
+    ]
+    include_dirs = [ "//third_party/tark_onnxruntime/include" ]
+  }
+}
+
+if (is_android) {
+  # The JNI side of VoiceLanguageDetector.java, linked into the browser
+  # through //chrome/browser/tark_captions_android:rules.
+  source_set("android") {
+    sources = [ "android/voice_language_detector_android.cc" ]
+    deps = [
+      ":detector",
+      "//base",
+      "//chrome/browser/tark_voice_android/android:jni_headers",
+    ]
+  }
+}
