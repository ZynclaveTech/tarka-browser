+    /** Chunk i of 20 ms, every sample i + 1. */
+    private static short[] chunk(int i) {
+        short[] pcm = new short[VoiceDetection.CHUNK_SAMPLES];
+        Arrays.fill(pcm, (short) (i + 1));
+        return pcm;
+    }
+
+    private static byte[] bytesOf(int from, int to) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        for (int i = from; i < to; i++) {
+            for (short sample : chunk(i)) {
+                out.write((byte) sample);
+                out.write((byte) (sample >> 8));
+            }
+        }
+        return out.toByteArray();
