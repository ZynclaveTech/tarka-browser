+    @Test
+    public void testNoPackAnywhereIsQuiet() {
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-IN", "sw", true, 4000, false, false));
+        assertEquals(
+                Decision.QUIET, VoiceDetection.decide("en-IN", "sw", false, 4000, false, false));
