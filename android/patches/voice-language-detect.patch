+
+    @Test
+    public void testEndedInstalledIsNextTime() {
+        assertEquals(
+                Decision.NEXT_TIME, VoiceDetection.decide("en-IN", "hi", false, 4000, true, false));
+
+        VoiceDetection.setLanguagesForTesting(
+                languages(List.of("en-IN", "hi-IN"), List.of("ta-IN")));
+        endedHearing(SITE, "hi");
+
+        Snackbar snackbar = shown();
+        assertEquals("That sounded like Hindi", snackbar.getTextForTesting().toString());
+        assertEquals("Use Hindi next time", snackbar.getActionText());
+        assertNull(VoiceSiteLanguages.get(SITE));
+        tap(snackbar);
+        assertEquals("hi-IN", VoiceSiteLanguages.get(SITE));
+    }
+
+    @Test
+    public void testMissingIsNeedsPack() {
+        assertEquals(
+                Decision.NEEDS_PACK, VoiceDetection.decide("en-IN", "ta", true, 4000, false, true));
+        assertEquals(
+                Decision.NEEDS_PACK, VoiceDetection.decide("en-IN", "ta", false, 4000, false, true));
+
+        VoiceDetection.setLanguagesForTesting(
+                languages(List.of("en-IN", "hi-IN"), List.of("ta-IN", "ta-LK")));
+        endedHearing(SITE, "ta");
+
+        Snackbar snackbar = shown();
+        assertEquals(
+                "That sounded like Tamil. Voice search needs Tamil on this phone.",
+                snackbar.getTextForTesting().toString());
+        assertEquals("Download", snackbar.getActionText());
+        tap(snackbar);
+        // The session's region first.
+        assertEquals(List.of("ta-IN"), mHost.mDownloads);
+        assertEquals("ta-IN", VoiceSiteLanguages.get(SITE));
+    }
+
+    @Test
+    public void testNoPackAnywhereIsQuiet() {
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-IN", "sw", true, 4000, false, false));
+        assertEquals(
+                Decision.QUIET, VoiceDetection.decide("en-IN", "sw", false, 4000, false, false));
+
+        VoiceDetection.setLanguagesForTesting(languages(List.of("en-IN"), List.of("hi-IN")));
+        endedHearing(SITE, "sw");
+
+        verify(mHost.mSnackbars, never()).showSnackbar(any());
+    }
+
+    // The chip: a switch replays the session's audio.
+
+    /**
+     * A session in en-IN with 14 chunks of audio. After the 10th, the detector hears Hindi (4 s
+     * in): the chip is shown and tapped before the 11th chunk is read.
+     */
+    private VoiceDetection.Session switchedSession(String origin) {
+        VoiceDetection.setLanguagesForTesting(
+                languages(List.of("en-IN", "hi-IN"), List.of("ta-IN")));
+        giveChunks(14);
+        VoiceDetection.Session session = open(origin, "en-IN");
+        mHost.mDetector.mProcessAnswer = "hi";
+        mHost.mNow = 4000;
+        mHost.mOnReadAt = 10;
+        mHost.mOnRead =
+                () -> {
+                    // The detector's sequence runs meanwhile: it hears Hindi.
+                    mHost.runDetector();
+                    Snackbar snackbar = shown();
+                    assertEquals("Sounds like Hindi", snackbar.getTextForTesting().toString());
+                    assertEquals("Switch", snackbar.getActionText());
+                    tap(snackbar);
+                };
+        mHost.runCapture();
+        return session;
+    }
+
+    @Test
+    public void testSwitchReplaysBuffer() {
+        VoiceDetection.Session session = switchedSession(SITE);
+
+        assertEquals(List.of("hi-IN"), mHost.mSwitches);
+        assertTrue(session.isSwitchedForTesting());
+        assertEquals(2, mHost.mPipes.size());
+        // The first recognizer's pipe had the first 10 chunks, then ended.
+        assertArrayEquals(bytesOf(0, 10), mHost.mPipes.get(0).toByteArray());
+        assertTrue(mHost.mPipes.get(0).mClosed);
+        // The new one: the 10 buffered chunks first, then the live ones.
+        assertArrayEquals(bytesOf(0, 14), mHost.mPipes.get(1).toByteArray());
+        assertTrue("the pipe ends with the capture", mHost.mPipes.get(1).mClosed);
+    }
+
+    @Test
+    public void testSwitchRemembersSite() {
+        switchedSession(SITE);
+        assertEquals("hi-IN", VoiceSiteLanguages.get(SITE));
+    }
+
+    @Test
+    public void testPrivateTabNeverRemembers() {
+        // A private tab's session has no origin: it may switch, but nothing is stored.
+        switchedSession("");
+        assertEquals(List.of("hi-IN"), mHost.mSwitches);
+        assertTrue(VoiceSiteLanguages.all().isEmpty());
+    }
+
+    @Test
+    public void testPrivateTabNoNextTimeOffer() {
+        VoiceDetection.setLanguagesForTesting(languages(List.of("en-IN", "hi-IN"), List.of()));
+        endedHearing("", "hi");
+        verify(mHost.mSnackbars, never()).showSnackbar(any());
+        assertTrue(VoiceSiteLanguages.all().isEmpty());
+    }
+
+    // When detection runs, and what it holds.
+
+    @Test
+    public void testNoRecordPermissionSkipsDetection() {
+        mHost.mPermission = false;
+        assertNull(
+                VoiceDetection.audioSourceFor(
+                        ApplicationProvider.getApplicationContext(), SITE, "en-IN"));
+        assertEquals(0, mHost.mMicsOpened);
+        assertEquals(0, mHost.mDetectorsMade);
+    }
+
+    @Test
+    public void testDetectionOffNoAudioSource() {
+        mHost.mDetectionOn = false;
+        assertNull(
+                VoiceDetection.audioSourceFor(
+                        ApplicationProvider.getApplicationContext(), SITE, "en-IN"));
+        assertEquals(0, mHost.mMicsOpened);
+        assertEquals(0, mHost.mDetectorsMade);
+    }
+
+    @Test
+    @Config(sdk = 32)
+    public void testBelow33NoAudioSource() {
+        assertNull(
+                VoiceDetection.audioSourceFor(
+                        ApplicationProvider.getApplicationContext(), SITE, "en-IN"));
+        assertEquals(0, mHost.mDetectorsMade);
+    }
+
+    @Test
+    public void testUnitHeldWhileRunningAudioDroppedAtEnd() {
+        giveChunks(5);
+        VoiceDetection.Session session = open(SITE, "en-IN");
+        assertEquals(List.of(true), mHost.mInUse);
+        mHost.runCapture();
+        mHost.runDetector();
+        assertTrue(mHost.mDetector.mLoaded);
+        session.close();
+
+        assertTrue(mHost.mDetector.mDestroyed);
+        assertTrue(mHost.mDetector.mRing.isEmpty());
+        assertEquals(List.of(true, false), mHost.mInUse);
+        assertNull("no replay once ended", session.replay());
+    }
+
+    @Test
+    public void testAndroidAskedOnlyAfterTheSession() {
+        // Unknown languages: no chip while the session runs, no question to Android beside it.
+        giveChunks(12);
+        VoiceDetection.Session session = open(SITE, "en-IN");
+        mHost.mDetector.mProcessAnswer = "hi";
+        mHost.mNow = 4000;
+        mHost.runCapture();
+        mHost.runDetector();
+        assertEquals(0, mHost.mLanguageChecks);
+        verify(mHost.mSnackbars, never()).showSnackbar(any());
+
+        session.close();
+        assertEquals(1, mHost.mLanguageChecks);
+        assertNotNull(mHost.mLanguagesCallback);
+        mHost.mLanguagesCallback.onResult(languages(List.of("en-IN", "hi-IN"), List.of()));
+        assertEquals("That sounded like Hindi", shown().getTextForTesting().toString());
+    }
+
+    @Test
+    public void testSameLanguageHeardShowsNothing() {
+        VoiceDetection.setLanguagesForTesting(languages(List.of("en-IN", "en-US"), List.of()));
+        endedHearing(SITE, "en");
+        verify(mHost.mSnackbars, never()).showSnackbar(any());
+        assertEquals(0, mHost.mLanguageChecks);
+    }
+
+    // The detector's labels as Android's tags.
+
+    @Test
+    public void testLabelToTag() {
+        List<String> android = List.of("en-US", "en-IN", "hi-IN", "he-IL", "jv-ID", "nb-NO");
+        assertEquals("hi-IN", VoiceDetection.tagFor("hi", android, "en-IN"));
+        assertEquals("en-IN", VoiceDetection.tagFor("en", android, "hi-IN"));
+        assertEquals("he-IL", VoiceDetection.tagFor("iw", android, "en-US"));
+        assertEquals("jv-ID", VoiceDetection.tagFor("jw", android, "en-US"));
+        assertEquals("nb-NO", VoiceDetection.tagFor("no", android, "en-US"));
+        // Urdu is heard as Hindi.
+        assertEquals("hi-IN", VoiceDetection.tagFor("ur", android, "en-US"));
+        assertNull(VoiceDetection.tagFor("ta", android, "en-IN"));
+        assertFalse(VoiceDetection.sameLanguage("en-IN", "hi"));
+    }
+}
