+    @Test
+    public void testSameLanguageDifferentRegionIsQuiet() {
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-US", "en", true, 4000, true, true));
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-IN", "en", false, 4000, true, true));
+        // Old and new codes of one language, and Urdu heard in an Urdu session.
+        assertEquals(Decision.QUIET, VoiceDetection.decide("he-IL", "iw", true, 4000, true, true));
+        assertEquals(Decision.QUIET, VoiceDetection.decide("ur-PK", "hi", true, 4000, true, true));
+    }
+
+    @Test
+    public void testUnsureIsQuiet() {
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-US", "und", true, 4000, true, true));
+        assertEquals(Decision.QUIET, VoiceDetection.decide("en-US", "", true, 4000, true, true));
+    }
