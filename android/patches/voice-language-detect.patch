+    private static @Nullable Host sHostForTesting;
+    private static @Nullable Host sHost;
+    // Android's latest answer about its speech languages, or null while unknown. Never asked
+    // during a session: only after one ends, or when Voice languages asks.
+    private static @Nullable Languages sLanguages;
+    // One prompt per session: the session that last started, and the last one that prompted
+    // (this snackbar, or the one-time offer of voice languages).
+    private static int sSessionSerial;
+    private static int sPromptedSerial;
+    private static @Nullable Boolean sLowEndForTesting;
+
+    private VoiceDetection() {}
+
+    @VisibleForTesting
+    static void setHostForTesting(@Nullable Host host) {
+        sHostForTesting = host;
+        ResettersForTesting.register(
+                () -> {
+                    sHostForTesting = null;
+                    sLanguages = null;
+                    sSessionSerial = 0;
+                    sPromptedSerial = 0;
+                    Models.resetForTesting();
+                });
+    }
+
+    @VisibleForTesting
