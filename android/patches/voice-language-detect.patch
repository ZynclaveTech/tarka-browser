+        RecognitionListener listener = session.getListenerForTesting();
+        listener.onReadyForSpeech(new Bundle());
+        listener.onBeginningOfSpeech();
+        listener.onPartialResults(results("Hello"));
+        listener.onPartialResults(results("Hello world"));
+        listener.onEndOfSpeech();
+        // A short pause: the recognizer starts a new segment, and the session goes on.
+        ShadowLooper.idleMainLooper(SpeechRecognitionImpl.PIPE_END_AFTER_SPEECH_MS / 2, MILLISECONDS);
+        listener.onBeginningOfSpeech();
+        listener.onPartialResults(results("this is a test", "this is a tent"));
+        verify(mNatives)
+                .onRecognitionResults(NATIVE_1, new String[] {"Hello world this is a test"}, null, true);
+        verify(mNatives, never()).onRecognitionEnd(anyLong());
+
+        listener.onEndOfSpeech();
+        ShadowLooper.idleMainLooper(SpeechRecognitionImpl.PIPE_END_AFTER_SPEECH_MS, MILLISECONDS);
+
+        verify(mNatives)
+                .onRecognitionResults(NATIVE_1, new String[] {"Hello world this is a test"}, null, false);
+        verify(mNatives).onSoundEnd(NATIVE_1);
+        verify(mNatives).onAudioEnd(NATIVE_1);
+        verify(mNatives, never()).onRecognitionError(anyLong(), anyInt());
+        verify(mNatives).onRecognitionEnd(NATIVE_1);
+        assertEquals(1, mAudio.mCloses);
+        // The empty final bundle, once the pipe closed, changes nothing.
+        listener.onResults(new Bundle());
+        verify(mNatives, times(1)).onRecognitionEnd(NATIVE_1);
+    }
