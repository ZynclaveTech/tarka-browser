+++ b/chrome/browser/tark_voice_android/voice_language_detector.h	2026-10-25 19:17:05.822292149 +0530
@@ -0,0 +1,159 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_VOICE_ANDROID_VOICE_LANGUAGE_DETECTOR_H_
+#define CHROME_BROWSER_TARK_VOICE_ANDROID_VOICE_LANGUAGE_DETECTOR_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/sequence_checker.h"
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+
+namespace tark_captions {
+class LanguageDetector;
+class OrtRuntime;
+class Vad;
+}  // namespace tark_captions
+
+namespace tark_voice {
+
+// The audio a voice search session holds: at most the last 15 s of 16 kHz
+// mono PCM16, in memory only, so that a switch to another language can play
+// it to a new recognizer. Thread-safe: the capture thread appends and reads
+// it, the detector's sequence reads it.
+class AudioRing {
+ public:
+  static constexpr int kSampleRate = 16000;
+  static constexpr size_t kCapacity = 15 * kSampleRate;
+
+  AudioRing();
+  AudioRing(const AudioRing&) = delete;
+  AudioRing& operator=(const AudioRing&) = delete;
+  ~AudioRing();
+
+  void Append(base::span<const int16_t> pcm);
+  // What is held, oldest first.
+  std::vector<int16_t> Snapshot() const;
+  // The samples [begin, end) of the session's audio (counted from its start)
+  // that are still held; earlier ones are gone.
+  std::vector<int16_t> Range(int64_t begin, int64_t end) const;
+  // How many samples are held, and how many were ever appended.
+  size_t size() const;
+  int64_t total() const;
+  // Drops everything (the session ended); the memory goes too.
+  void Clear();
+
+ private:
+  mutable base::Lock lock_;
+  std::vector<int16_t> samples_ GUARDED_BY(lock_);  // kCapacity once full
+  size_t next_ GUARDED_BY(lock_) = 0;  // where the next sample goes, once full
+  int64_t total_ GUARDED_BY(lock_) = 0;
+};
+
+// Who uses the shared models: they are never freed or replaced while a
+// session's detector is attached. An unload asked for meanwhile happens when
+// the last one detaches; a load from another folder is refused until then.
+class SharedUse {
+ public:
+  void Attach() { ++attached_; }
+  // True when a deferred unload is due now.
+  bool Detach();
+  // True when the models may be freed now; else freed at the last Detach().
+  bool RequestUnload();
+  // Whether the models may be replaced (loaded from another folder).
+  bool CanReplace() const { return attached_ == 0; }
+  int attached() const { return attached_; }
+
+ private:
+  int attached_ = 0;
+  bool unload_pending_ = false;
+};
+
+// Voice search's spoken-language detection (spec §3): Silero VAD finds the
+// speech in a session's audio, and captions' detector (VoxLingua107 ECAPA,
+// the language_id unit) names its language with captions' policy
+// (detection_policy.h): once sure after 3 s of speech, else whatever it
+// thinks after 5 s. A session that ends earlier is decided on what speech
+// it had, and only if the detector is sure. The audio stays in the ring
+// (at most 15 s) and is dropped when the session ends.
+//
+// The models (ONNX Runtime and the detector, 86 MB) are loaded once per
+// process (LoadShared) and kept between sessions until UnloadShared, which
+// Java calls when idle, under memory pressure, in the background or on a
+// Remove; each session loads only its own small VAD (Attach).
+//
+// The ring may be used from any thread. Everything else, the shared models
+// included, runs on one sequence (the detector's), which also destroys this.
+class VoiceLanguageDetector {
+ public:
+  // What Decide() and Finish() report when the detector heard speech but
+  // could not tell its language.
+  static constexpr char kUnsure[] = "und";
+
+  VoiceLanguageDetector();
+  VoiceLanguageDetector(const VoiceLanguageDetector&) = delete;
+  VoiceLanguageDetector& operator=(const VoiceLanguageDetector&) = delete;
+  ~VoiceLanguageDetector();
+
+  AudioRing& ring() { return ring_; }
+
+  // Loads ONNX Runtime (`ort_library`) and the detector from `models_dir`
+  // for the whole process, unless they are loaded already. False if either
+  // is missing.
+  static bool LoadShared(const base::FilePath& models_dir, const base::FilePath& ort_library);
+  // Frees them. No session may be attached.
+  static void UnloadShared();
+  static bool SharedLoadedForTesting();
+  static int SharedAttachedForTesting();
+
+  // Uses the shared models, and loads this session's VAD from `models_dir`.
+  // False if they aren't loaded; nothing is detected then.
+  bool Attach(const base::FilePath& models_dir);
+
+  // Reads the audio appended since the last call. Returns the language (a
+  // VoxLingua code: "hi", "en", ..., Urdu as "hi") or kUnsure once decided,
+  // and nothing before; after a decision, nothing more.
+  std::optional<std::string> Process();
+  // The session's audio ended: the decision on the speech heard, if none was
+  // made and there was at least 1 s of it; the detector must be sure then.
+  std::optional<std::string> Finish();
+  // Drops the session's audio and state.
+  void EndSession();
+
+  double speech_seconds_for_testing() const;
+
+ private:
+  // Runs the detector on the speech still held, as if `speech_seconds` of it
+  // had been heard.
+  std::optional<std::string> DecideOn(double speech_seconds);
+
+  AudioRing ring_;
+
