+            for (int i = 0; i < length; i++) mRing.add(pcm[i]);
+        }
+
+        @Override
+        public short[] buffered() {
+            short[] held = new short[mRing.size()];
+            for (int i = 0; i < held.length; i++) held[i] = mRing.get(i);
+            return held;
+        }
+
+        @Override
+        public boolean attach(String modelsDir) {
