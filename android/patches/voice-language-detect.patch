+
+    // The chip: a switch replays the session's audio.
+
+    /**
+     * A session in en-IN with 14 chunks of audio. After the 10th, the detector hears Hindi (4 s
+     * in): the chip is shown and tapped before the 11th chunk is read.
+     */
+    private VoiceDetection.Session switchedSession(String origin) {
+        VoiceDetection.setLanguagesForTesting(
+                languages(List.of("en-IN", "hi-IN"), List.of("ta-IN")));
+        giveChunks(14);
+        VoiceDetection.Session session = open(origin, "en-IN");
+        mHost.mDetector.mProcessAnswer = "hi";
+        mHost.mNow = 4000;
+        mHost.mOnReadAt = 10;
+        mHost.mOnRead =
+                () -> {
+                    // The detector's sequence runs meanwhile: it hears Hindi.
+                    mHost.runDetector();
+                    Snackbar snackbar = shown();
+                    assertEquals("Sounds like Hindi", snackbar.getTextForTesting().toString());
+                    assertEquals("Switch", snackbar.getActionText());
+                    tap(snackbar);
+                };
+        mHost.runCapture();
+        return session;
+    }
+
+    @Test
+    public void testSwitchReplaysBuffer() {
+        VoiceDetection.Session session = switchedSession(SITE);
+
+        assertEquals(List.of("hi-IN"), mHost.mSwitches);
+        assertTrue(session.isSwitchedForTesting());
+        assertEquals(2, mHost.mPipes.size());
+        // The first recognizer's pipe had the first 10 chunks, then ended.
+        assertArrayEquals(bytesOf(0, 10), mHost.mPipes.get(0).toByteArray());
+        assertTrue(mHost.mPipes.get(0).mClosed);
+        // The new one: the 10 buffered chunks first, then the live ones.
+        assertArrayEquals(bytesOf(0, 14), mHost.mPipes.get(1).toByteArray());
+        assertTrue("the pipe ends with the capture", mHost.mPipes.get(1).mClosed);
+    }
+
+    @Test
+    public void testSwitchRemembersSite() {
+        switchedSession(SITE);
+        assertEquals("hi-IN", VoiceSiteLanguages.get(SITE));
+    }
