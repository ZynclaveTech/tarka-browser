--- a/chrome/browser/tark_voice_android/android/java/src/org/chromium/chrome/browser/tark_voice/VoiceLanguageDetector.java	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/browser/tark_voice_android/android/java/src/org/chromium/chrome/browser/tark_voice/VoiceLanguageDetector.java	2026-10-25 17:34:18.530411888 +0530
@@ -0,0 +1,93 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark_voice;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * Tark: voice search's spoken-language detector for one session
+ * (chrome/browser/tark_voice_android/voice_language_detector.h): captions' language detector and
+ * Silero VAD over the session's audio, which a ring holds in memory (at most 15 s) and drops when
+ * the session ends.
+ *
+ * <p>{@link #append} and {@link #buffered} may be called from the capture thread; every other
+ * call, {@link #destroy} last, from one sequence (the detector's), once the capture has stopped.
+ */
+@JNINamespace("tark_voice")
+@NullMarked
+public final class VoiceLanguageDetector {
+    /** What {@link #process} and {@link #finish} report for speech in an unknown language. */
+    public static final String UNSURE = "und";
+
+    private final long mDetector;
+    private boolean mDestroyed;
+
+    public VoiceLanguageDetector() {
+        mDetector = VoiceLanguageDetectorJni.get().create();
+    }
+
+    /** Appends 16 kHz mono PCM16 to the session's audio. */
+    public void append(short[] pcm, int length) {
+        VoiceLanguageDetectorJni.get().append(mDetector, pcm, length);
+    }
+
+    /** The audio held, oldest first (at most 15 s). */
+    public short[] buffered() {
+        return VoiceLanguageDetectorJni.get().buffered(mDetector);
+    }
+
+    /** Loads the language_id unit's models from {@code modelsDir}; false if they can't be. */
+    public boolean load(String modelsDir) {
+        return VoiceLanguageDetectorJni.get().load(mDetector, modelsDir);
+    }
+
+    /**
+     * Reads the audio appended since the last call: the language heard (a VoxLingua code, Urdu as
+     * "hi") or {@link #UNSURE} once decided, else null.
+     */
+    public @Nullable String process() {
+        return orNull(VoiceLanguageDetectorJni.get().process(mDetector));
+    }
+
+    /** The session's audio ended: a decision on the speech heard, if the detector is sure. */
+    public @Nullable String finish() {
+        return orNull(VoiceLanguageDetectorJni.get().finish(mDetector));
+    }
+
+    /** Drops the session's audio and frees the detector. */
+    public void destroy() {
+        if (mDestroyed) return;
+        mDestroyed = true;
+        VoiceLanguageDetectorJni.get().destroy(mDetector);
+    }
+
+    private static @Nullable String orNull(String code) {
+        return code.isEmpty() ? null : code;
+    }
+
+    @NativeMethods
+    interface Natives {
+        long create();
+
+        void append(long detector, short[] pcm, int length);
+
+        short[] buffered(long detector);
+
+        boolean load(long detector, @JniType("std::string") String modelsDir);
+
+        @JniType("std::string")
+        String process(long detector);
+
+        @JniType("std::string")
+        String finish(long detector);
+
+        void destroy(long detector);
+    }
+}
diff '--color=never' -ruN a/chrome/browser/tark_voice_android/android/voice_language_detector_android.cc b/chrome/browser/tark_voice_android/android/voice_language_detector_android.cc
--- a/chrome/browser/tark_voice_android/android/voice_language_detector_android.cc	1970-01-01 05:30:00.000000000 +0530
+++ b/chrome/browser/tark_voice_android/android/voice_language_detector_android.cc	2026-10-25 17:34:18.545992730 +0530
@@ -0,0 +1,79 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <jni.h>
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/android/jni_android.h"
+#include "base/files/file_path.h"
+#include "chrome/browser/tark_voice_android/voice_language_detector.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/tark_voice_android/android/jni_headers/VoiceLanguageDetector_jni.h"
+
+namespace tark_voice {
+namespace {
+
+// Loaded by name from the app's native libraries, as the captions process
+// does (android/captions/ort.sh).
+constexpr char kOrtLibrary[] = "libonnxruntime.so";
+
+VoiceLanguageDetector* From(int64_t detector) {
+  return reinterpret_cast<VoiceLanguageDetector*>(static_cast<intptr_t>(detector));
+}
+
+}  // namespace
+
+static int64_t JNI_VoiceLanguageDetector_Create(JNIEnv* env) {
+  return static_cast<int64_t>(reinterpret_cast<intptr_t>(new VoiceLanguageDetector()));
+}
+
+static void JNI_VoiceLanguageDetector_Append(JNIEnv* env,
+                                             int64_t detector,
+                                             const base::android::JavaParamRef<jshortArray>& pcm,
+                                             int32_t length) {
+  if (length <= 0) {
+    return;
+  }
+  std::vector<int16_t> samples(static_cast<size_t>(length));
+  env->GetShortArrayRegion(pcm.obj(), 0, length, reinterpret_cast<jshort*>(samples.data()));
+  From(detector)->ring().Append(samples);
+}
+
+static base::android::ScopedJavaLocalRef<jshortArray> JNI_VoiceLanguageDetector_Buffered(
+    JNIEnv* env,
+    int64_t detector) {
+  const std::vector<int16_t> held = From(detector)->ring().Snapshot();
+  jshortArray array = env->NewShortArray(static_cast<jsize>(held.size()));
+  env->SetShortArrayRegion(array, 0, static_cast<jsize>(held.size()),
+                           reinterpret_cast<const jshort*>(held.data()));
+  return base::android::ScopedJavaLocalRef<jshortArray>(env, array);
+}
+
+static bool JNI_VoiceLanguageDetector_Load(JNIEnv* env,
+                                           int64_t detector,
+                                           const std::string& models_dir) {
+  return From(detector)->Load(base::FilePath(models_dir), base::FilePath(kOrtLibrary));
+}
+
+static std::string JNI_VoiceLanguageDetector_Process(JNIEnv* env, int64_t detector) {
+  return From(detector)->Process().value_or(std::string());
+}
+
+static std::string JNI_VoiceLanguageDetector_Finish(JNIEnv* env, int64_t detector) {
+  return From(detector)->Finish().value_or(std::string());
+}
+
+static void JNI_VoiceLanguageDetector_Destroy(JNIEnv* env, int64_t detector) {
+  // Drops the session's audio (the destructor ends the session).
+  delete From(detector);
+}
+
+}  // namespace tark_voice
+
+DEFINE_JNI(VoiceLanguageDetector)
