+        /**
+         * The capture thread: reads the microphone in 20 ms chunks, appends each to the ring and
+         * writes it to the current pipe; a replay writes the ring into a new pipe first. It also
+         * tells the session when silence follows speech.
+         */
+        private final class Capture implements Runnable {
+            private final Mic mMic;
+            private final AtomicReference<@Nullable Writer> mReplay = new AtomicReference<>();
+            private volatile boolean mStopped;
+            private volatile boolean mResetQuiet;
+            // Capture thread only.
+            private Writer mWriter;
+            private boolean mHeardSound;
+            private long mQuietSamples;
+
+            Capture(Mic mic, Writer writer) {
+                mMic = mic;
+                mWriter = writer;
+            }
+
+            void replayInto(Writer writer) {
+                // Silence heard so far was before the switch.
+                mResetQuiet = true;
+                Writer previous = mReplay.getAndSet(writer);
+                if (previous != null) previous.close();
+                if (mStopped) {
+                    Writer left = mReplay.getAndSet(null);
+                    if (left != null) left.close();
+                }
+            }
+
+            void stop() {
+                mStopped = true;
+            }
+
+            @Override
+            public void run() {
+                try {
+                    if (!mMic.start()) return;
+                    short[] buffer = new short[CHUNK_SAMPLES];
+                    int chunks = 0;
+                    while (!mStopped) {
+                        int read = mMic.read(buffer);
+                        if (read <= 0) break;
+                        Writer replay = mReplay.getAndSet(null);
+                        if (replay != null) {
+                            // Everything held so far, then the live audio from this chunk on.
+                            replay.writeReplay(mDetector.buffered());
+                            mWriter.close();
+                            mWriter = replay;
+                        }
+                        mDetector.append(buffer, read);
+                        mWriter.write(Arrays.copyOf(buffer, read));
+                        listenForQuiet(buffer, read);
+                        if (++chunks % PROCESS_EVERY_CHUNKS == 0) {
+                            mHost.runOnDetectorSequence(Session.this::process);
+                        }
+                    }
+                } catch (RuntimeException e) {
+                    Log.w(TAG, "Capture ended", e);
+                } finally {
+                    mStopped = true;
+                    mMic.release();
+                    mWriter.close();
+                    Writer replay = mReplay.getAndSet(null);
+                    if (replay != null) replay.close();
+                    mHost.runOnDetectorSequence(Session.this::finishDetector);
+                }
+            }
+
+            private void listenForQuiet(short[] pcm, int count) {
+                if (mResetQuiet) {
+                    mResetQuiet = false;
+                    mHeardSound = false;
+                    mQuietSamples = 0;
+                }
+                double sum = 0;
+                for (int i = 0; i < count; i++) sum += (double) pcm[i] * pcm[i];
+                boolean quiet = count == 0 || Math.sqrt(sum / count) < QUIET_RMS;
+                if (!quiet) {
+                    mHeardSound = true;
+                    mQuietSamples = 0;
+                    return;
+                }
+                if (!mHeardSound) return;
+                mQuietSamples += count;
+                if (mQuietSamples * 1000 / SAMPLE_RATE >= QUIET_MS) {
+                    // Once per stretch of speech.
+                    mHeardSound = false;
+                    onCaptureQuiet();
+                }
+            }
+        }
+
+        /**
+         * Writes PCM16 into one pipe, on its own executor. Its queue is bounded: once more than
+         * {@link #MAX_BACKLOG_CHUNKS} of live audio wait (the recognizer stopped reading), it
+         * gives up on the pipe. Closing closes the pipe at once, which also ends a blocked write.
+         */
+        private final class Writer {
+            private final OutputStream mOut;
+            private final Executor mExecutor;
+            private final AtomicBoolean mClosed = new AtomicBoolean();
+            private final AtomicInteger mQueued = new AtomicInteger();
+            // Chunks allowed in the queue: the backlog, plus a replay's chunks.
+            private final AtomicInteger mLimit = new AtomicInteger(MAX_BACKLOG_CHUNKS);
+            private volatile boolean mBroken;
+            // The writer's executor only.
+            private long mFirstWriteMs = -1;
+            private long mWrittenSamples;
+
+            Writer(OutputStream out) {
+                mOut = out;
+                mExecutor = mHost.newWriterExecutor();
+            }
+
+            /** The ring's audio, first into this pipe. */
+            void writeReplay(short[] pcm) {
+                int chunks = (pcm.length + CHUNK_SAMPLES - 1) / CHUNK_SAMPLES;
+                mLimit.addAndGet(chunks);
+                for (int start = 0; start < pcm.length; start += CHUNK_SAMPLES) {
+                    write(Arrays.copyOfRange(pcm, start, Math.min(pcm.length, start + CHUNK_SAMPLES)));
+                }
+            }
+
+            void write(short[] pcm) {
+                if (mClosed.get() || mBroken) return;
+                if (mQueued.incrementAndGet() > mLimit.get()) {
+                    // The recognizer isn't reading: holding more would only grow memory.
+                    mBroken = true;
+                    close();
+                    return;
+                }
+                mExecutor.execute(
+                        () -> {
+                            mQueued.decrementAndGet();
+                            writeNow(pcm);
+                        });
+            }
+
+            void close() {
+                if (!mClosed.compareAndSet(false, true)) return;
+                try {
+                    mOut.close();
+                } catch (IOException e) {
+                    // Gone either way.
+                }
+                if (mExecutor instanceof ExecutorService service) service.shutdownNow();
+            }
+
+            private void writeNow(short[] pcm) {
+                if (mBroken || mClosed.get()) return;
+                if (mFirstWriteMs < 0) mFirstWriteMs = mHost.now();
+                // The first REPLAY_BURST_MS at once, then never faster than REPLAY_SPEEDUP
+                // times real time.
+                long burst = REPLAY_BURST_MS * SAMPLE_RATE / 1000;
+                long due =
+                        mFirstWriteMs
+                                + (long)
+                                        (Math.max(0, mWrittenSamples - burst)
+                                                * 1000.0
+                                                / SAMPLE_RATE
+                                                / REPLAY_SPEEDUP);
+                long wait = due - mHost.now();
+                if (wait > 0) mHost.sleepMs(wait);
+                byte[] bytes = new byte[pcm.length * 2];
+                for (int i = 0; i < pcm.length; i++) {
+                    bytes[2 * i] = (byte) pcm[i];
+                    bytes[2 * i + 1] = (byte) (pcm[i] >> 8);
+                }
+                try {
+                    mOut.write(bytes);
+                    mWrittenSamples += pcm.length;
+                } catch (IOException e) {
+                    // The recognizer went away (cancelled, switched, ended), or closed.
+                    mBroken = true;
+                }
+            }
+        }
+    }
+
+    private static void closeQuietly(Pipe pipe) {
+        try {
+            pipe.readEnd.close();
+        } catch (IOException e) {
+            // Gone either way.
+        }
+        try {
+            pipe.writeEnd.close();
+        } catch (IOException e) {
+            // Gone either way.
+        }
+    }
