+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowLooper;
+import org.robolectric.shadows.ShadowToast;
+
+import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccount.State;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccountTest.CountingStore;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccountTest.FakeBackend;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+import org.chromium.ui.base.TestActivity;
+
+import java.io.File;
+
+/**
+ * Tests for {@link ZynclaveAccountPreference} (the Settings row) and the sign-out dialog of {@link
+ * ZynclaveAccountSettings}, on a fake backend: the row's clicks reach {@link ZynclaveAccount}, and
+ * its text follows the account's state.
+ */
+@RunWith(BaseRobolectricTestRunner.class)
+@Config(qualifiers = "en-rUS")
+public class ZynclaveAccountRowTest {
+    private static final String SIGN_IN_FAILED = "Couldn't sign in. Try again.";
+
+    /** An activity with a Settings-style snackbar manager, as SettingsActivity has. */
+    public static class ManageableActivity extends AppCompatActivity
+            implements SnackbarManager.SnackbarManageable {
+        final SnackbarManager mManager = Mockito.mock(SnackbarManager.class);
+
+        @Override
+        protected void onCreate(Bundle savedInstanceState) {
+            setTheme(R.style.Theme_BrowserUI_DayNight);
+            super.onCreate(savedInstanceState);
+        }
+
+        @Override
+        public SnackbarManager getSnackbarManager() {
+            return mManager;
+        }
+    }
+
+    @Rule public TemporaryFolder mTemp = new TemporaryFolder();
+
+    private FakeBackend mBackend;
+    private CountingStore mStore;
+    private ZynclaveAccount mAccount;
+    private TestActivity mActivity;
+
+    @Before
+    public void setUp() {
+        mBackend = new FakeBackend();
+        mStore = new CountingStore(new File(mTemp.getRoot(), "zynclave"));
+        mBackend.mStore = mStore;
+        mAccount = ZynclaveAccount.forTesting(mBackend, mStore, ZynclaveAccountTest.DIRECT);
+        mActivity = Robolectric.buildActivity(TestActivity.class).setup().get();
+        mActivity.setTheme(R.style.Theme_BrowserUI_DayNight);
+    }
+
+    @After
+    public void tearDown() {
+        AlertDialog dialog = ZynclaveAccountSettings.getDialogForTesting();
+        if (dialog != null) dialog.dismiss();
+    }
+
+    private void signIn() {
+        mAccount.signIn(mActivity, false);
+        ShadowLooper.idleMainLooper();
+        AuthorizationRequest request = mBackend.lastRequest();
+        mAccount.onAuthorizationResult(mActivity, mBackend.successFor(request), null);
+        ShadowLooper.idleMainLooper();
+        assertEquals(State.SIGNED_IN, mAccount.state());
+    }
+
+    private ZynclaveAccountPreference row() {
+        return new ZynclaveAccountPreference(mActivity, null);
+    }
+
+    private static String text(CharSequence text) {
+        assertNotNull(text);
+        return text.toString();
+    }
+
+    @Test
+    public void testSignedOutRow() {
+        ZynclaveAccountPreference row = row();
+
+        assertEquals("Sign in with Zynclave", text(row.getTitle()));
+        assertEquals("Optional. Browsing never needs an account.", text(row.getSummary()));
+        assertNull(row.getFragment());
+
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+
+        // signIn(activity, false): a full sign-in page, not prompt=none.
+        assertEquals(1, mBackend.mAuthorizeRequests.size());
+        assertNull(mBackend.lastRequest().prompt);
+        assertEquals(State.SIGNING_IN, mAccount.state());
+    }
+
+    @Test
+    public void testSignedInRowShowsNameAndEmail() {
+        signIn();
+        ZynclaveAccountPreference row = row();
+
+        assertEquals("Asha Rao", text(row.getTitle()));
+        assertEquals("asha@example.com", text(row.getSummary()));
+        // A tap opens the account page, as a Settings row with a fragment does; no sign-in.
+        assertEquals(ZynclaveAccountSettings.class.getName(), row.getFragment());
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+        assertEquals(1, mBackend.mAuthorizeRequests.size());
+        assertEquals(State.SIGNED_IN, mAccount.state());
+    }
+
+    @Test
+    public void testNoNameNoEmail() {
+        mBackend.mName = null;
+        mBackend.mEmail = null;
+        signIn();
+        ZynclaveAccountPreference row = row();
+
+        assertEquals("Zynclave Account", text(row.getTitle()));
+        assertNull(row.getSummary());
+    }
+
+    @Test
+    public void testEmailWhenNoName() {
+        mBackend.mName = null;
+        signIn();
+        ZynclaveAccountPreference row = row();
+
+        assertEquals("asha@example.com", text(row.getTitle()));
+        assertNull(row.getSummary());
+    }
+
+    @Test
+    public void testNeedsSignInAgain() {
+        signIn();
+        mBackend.mRefreshResults.add(AuthorizationException.TokenRequestErrors.INVALID_GRANT);
+        mAccount.freshTokens(token -> {});
+        ShadowLooper.idleMainLooper();
+        assertEquals(State.NEEDS_SIGN_IN_AGAIN, mAccount.state());
+        ZynclaveAccountPreference row = row();
+
+        assertEquals("Sign in again", text(row.getTitle()));
+        assertEquals("Asha Rao", text(row.getSummary()));
+        assertNull(row.getFragment());
+
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+        assertEquals(2, mBackend.mAuthorizeRequests.size());
+        assertEquals(State.SIGNING_IN, mAccount.state());
+    }
+
+    @Test
+    public void testStagingLabelOnlyInStaging() {
+        String label = "Zynclave staging";
+        assertEquals(
+                "Optional. Browsing never needs an account.",
+                text(
+                        ZynclaveAccountPreference.content(
+                                        mActivity, State.SIGNED_OUT, null, null, false)
+                                .summary()));
+        assertEquals(
+                "Optional. Browsing never needs an account. · " + label,
+                text(
+                        ZynclaveAccountPreference.content(
+                                        mActivity, State.SIGNED_OUT, null, null, true)
+                                .summary()));
+        assertEquals(
+                "asha@example.com",
+                text(
+                        ZynclaveAccountPreference.content(
+                                        mActivity,
+                                        State.SIGNED_IN,
+                                        "Asha Rao",
+                                        "asha@example.com",
+                                        false)
+                                .summary()));
+        assertEquals(
+                "asha@example.com · " + label,
+                text(
+                        ZynclaveAccountPreference.content(
+                                        mActivity,
+                                        State.SIGNED_IN,
+                                        "Asha Rao",
+                                        "asha@example.com",
+                                        true)
+                                .summary()));
+        // Nothing else to say: the label alone.
+        assertEquals(
+                label,
+                text(
+                        ZynclaveAccountPreference.content(
+                                        mActivity, State.SIGNED_IN, null, null, true)
+                                .summary()));
+        // A unit-test build is not a staging build: no label.
+        signIn();
+        assertFalse(text(row().getSummary()).contains(label));
+    }
+
+    @Test
+    public void testSignOutDialogAsksAndCancelSignsNothingOut() {
+        signIn();
+        AlertDialog dialog = ZynclaveAccountSettings.showSignOutDialog(mActivity);
+
+        assertTrue(dialog.isShowing());
+        assertEquals(
+                "Sign out of Tark only",
+                text(dialog.getButton(AlertDialog.BUTTON_NEGATIVE).getText()));
+        assertEquals(
+                "Sign out everywhere",
+                text(dialog.getButton(AlertDialog.BUTTON_POSITIVE).getText()));
+        assertEquals(
+                "Also sign out of Zynclave websites in Tark?",
+                text(mActivity.getString(R.string.tark_zynclave_sign_out_title)));
+
+        dialog.cancel();
+        ShadowLooper.idleMainLooper();
+
+        assertEquals(State.SIGNED_IN, mAccount.state());
+        assertTrue(mBackend.mRevoked.isEmpty());
+        assertNull(ZynclaveAccountSettings.getDialogForTesting());
+    }
+
+    @Test
+    public void testSignOutTarkOnly() {
+        signIn();
+        AlertDialog dialog = ZynclaveAccountSettings.showSignOutDialog(mActivity);
+        dialog.getButton(AlertDialog.BUTTON_NEGATIVE).performClick();
+        ShadowLooper.idleMainLooper();
+
+        assertEquals(State.SIGNED_OUT, mAccount.state());
+        assertEquals(1, mBackend.mRevoked.size());
+        assertTrue("no end-session page", mBackend.mOpened.isEmpty());
+        assertNull(mStore.read());
+        assertFalse(dialog.isShowing());
+    }
+
+    @Test
+    public void testSignOutEverywhere() {
+        signIn();
+        AlertDialog dialog = ZynclaveAccountSettings.showSignOutDialog(mActivity);
+        dialog.getButton(AlertDialog.BUTTON_POSITIVE).performClick();
+        ShadowLooper.idleMainLooper();
+
+        assertEquals(State.SIGNED_OUT, mAccount.state());
+        assertEquals(1, mBackend.mRevoked.size());
+        assertEquals(1, mBackend.mOpened.size());
+        assertEquals("IDT-1", mBackend.mOpened.get(0).getQueryParameter("id_token_hint"));
+        assertNull(mStore.read());
+        assertFalse(dialog.isShowing());
+    }
+
+    @Test
+    public void testRowUpdatesOnObserver() {
+        ZynclaveAccountPreference row = row();
+        row.startObserving();
+        assertEquals("Sign in with Zynclave", text(row.getTitle()));
+
+        signIn();
+        assertEquals("Asha Rao", text(row.getTitle()));
+        assertEquals("asha@example.com", text(row.getSummary()));
+        assertEquals(ZynclaveAccountSettings.class.getName(), row.getFragment());
+
+        mAccount.signOut(false, null);
+        ShadowLooper.idleMainLooper();
+        assertEquals("Sign in with Zynclave", text(row.getTitle()));
+        assertNull(row.getFragment());
+
+        // Detached from Settings: it no longer follows the account.
+        row.onDetached();
+        signIn();
+        assertEquals("Sign in with Zynclave", text(row.getTitle()));
+    }
+
+    @Test
+    public void testAttachedRowObserves() {
+        ZynclaveAccountPreference row = row();
+        row.onAttached();
+        signIn();
+        assertEquals("Asha Rao", text(row.getTitle()));
+        row.onDetached();
+    }
+
+    @Test
+    public void testRowDisabledWhileSigningIn() {
+        ZynclaveAccountPreference row = row();
+        row.startObserving();
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+
+        assertEquals(State.SIGNING_IN, mAccount.state());
+        assertFalse(row.isEnabled());
+
+        mAccount.onAuthorizationResult(
+                mActivity, null, AuthorizationException.GeneralErrors.USER_CANCELED_AUTH_FLOW);
+        ShadowLooper.idleMainLooper();
+        assertTrue(row.isEnabled());
+        assertEquals("Sign in with Zynclave", text(row.getTitle()));
+    }
+
+    @Test
+    public void testSignInFailureShowsSnackbarInSettings() {
+        ManageableActivity activity =
+                Robolectric.buildActivity(ManageableActivity.class).setup().get();
+        ZynclaveAccountPreference row = new ZynclaveAccountPreference(activity, null);
+        row.startObserving();
+        mBackend.mAuthorizeSucceeds = false;
+
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+
+        ArgumentCaptor<Snackbar> captor = ArgumentCaptor.forClass(Snackbar.class);
+        verify(activity.mManager).showSnackbar(captor.capture());
+        assertEquals(SIGN_IN_FAILED, captor.getValue().getTextForTesting().toString());
+        assertNull("no toast beside the snackbar", ShadowToast.getLatestToast());
+        assertEquals(State.SIGNED_OUT, mAccount.state());
+    }
+
+    @Test
+    public void testSignInFailureToastWhenNoSnackbarManager() {
+        ZynclaveAccountPreference row = row();
+        row.startObserving();
+        mBackend.mAuthorizeSucceeds = false;
+
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+
+        assertEquals(SIGN_IN_FAILED, ShadowToast.getTextOfLatestToast());
+    }
+
+    @Test
+    public void testCancelShowsNoFailure() {
+        ManageableActivity activity =
+                Robolectric.buildActivity(ManageableActivity.class).setup().get();
+        ZynclaveAccountPreference row = new ZynclaveAccountPreference(activity, null);
+        row.startObserving();
+        row.performClick();
+        ShadowLooper.idleMainLooper();
+        mAccount.onAuthorizationResult(
+                activity, null, AuthorizationException.GeneralErrors.USER_CANCELED_AUTH_FLOW);
+        ShadowLooper.idleMainLooper();
+
+        verify(activity.mManager, never()).showSnackbar(any());
+        assertNull(ShadowToast.getLatestToast());
+    }
+
+    @Test
+    public void testDetachedRowShowsNoFailure() {
+        ZynclaveAccountPreference row = row();
+        row.startObserving();
+        row.stopObserving();
+        mBackend.mAuthorizeSucceeds = false;
+        mAccount.signIn(mActivity, false);
+        ShadowLooper.idleMainLooper();
+
+        assertNull(ShadowToast.getLatestToast());
+    }
+
+    /** The account page on top of a Settings list, as SettingsActivity stacks pages. */
+    private ZynclaveAccountSettings openAccountPage() {
+        FragmentManager manager = mActivity.getSupportFragmentManager();
+        manager.beginTransaction().replace(android.R.id.content, new Fragment()).commitNow();
+        ZynclaveAccountSettings page = new ZynclaveAccountSettings();
+        manager.beginTransaction()
+                .replace(android.R.id.content, page)
+                .addToBackStack(null)
+                .commit();
+        manager.executePendingTransactions();
+        ShadowLooper.idleMainLooper();
+        return page;
+    }
+
+    @Test
+    public void testSignOutPopsThePageNotTheActivity() {
+        signIn();
+        ZynclaveAccountSettings page = openAccountPage();
+        FragmentManager manager = mActivity.getSupportFragmentManager();
+        assertTrue(page.isAdded());
+        assertEquals(1, manager.getBackStackEntryCount());
+
+        mAccount.signOut(false, null);
+        ShadowLooper.idleMainLooper();
+        manager.executePendingTransactions();
+
+        assertFalse("the page is gone", page.isAdded());
+        assertEquals(0, manager.getBackStackEntryCount());
+        assertFalse("Settings stays open", mActivity.isFinishing());
+    }
+
+    @Test
+    public void testSignOutEverywhereOpensTabFromALiveActivity() {
+        signIn();
+        ZynclaveAccountSettings page = openAccountPage();
+
+        mAccount.signOut(true, mActivity);
+        ShadowLooper.idleMainLooper();
+        mActivity.getSupportFragmentManager().executePendingTransactions();
+
+        assertEquals(1, mBackend.mOpened.size());
+        assertFalse(page.isAdded());
+        assertFalse(mActivity.isFinishing());
+    }
+
+    @Test
+    public void testStalePageForSignedOutAccountPopsItself() {
+        // The process died while signed in; the account is gone when the page comes back.
+        ZynclaveAccountSettings page = openAccountPage();
+        mActivity.getSupportFragmentManager().executePendingTransactions();
+
+        assertFalse(page.isAdded());
+        assertEquals(0, mActivity.getSupportFragmentManager().getBackStackEntryCount());
+        assertFalse(mActivity.isFinishing());
+    }
+}
