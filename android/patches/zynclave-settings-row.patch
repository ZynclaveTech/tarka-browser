+++ b/chrome/android/java/src/org/chromium/chrome/browser/tark/zynclave/ZynclaveAccountSettings.java	2026-10-26 11:24:30.171291490 +0530
@@ -0,0 +1,165 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.activity.ComponentActivity;
+import androidx.annotation.VisibleForTesting;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.Preference;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccount.State;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/**
+ * Tark: Settings › Zynclave Account (spec §5.5), opened from {@link ZynclaveAccountPreference}
+ * while signed in. It names the account and offers Sign out, which asks whether to sign out of
+ * Zynclave's websites in Tark too. When the account is no longer signed in, the page closes.
+ */
+@NullMarked
+public class ZynclaveAccountSettings extends ChromeBaseSettingsFragment {
+    static final String SUMMARY_KEY = "zynclave_account_summary";
+    static final String SIGN_OUT_KEY = "zynclave_account_sign_out";
+
+    private static @Nullable AlertDialog sDialog;
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private final Runnable mObserver = this::onAccountChanged;
+    private boolean mLeaving;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.tark_zynclave_account_fallback));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.zynclave_account_preferences);
+        Preference signOut = findPreference(SIGN_OUT_KEY);
+        if (signOut != null) {
+            signOut.setOnPreferenceClickListener(
+                    p -> {
+                        showSignOutDialog(requireActivity());
+                        return true;
+                    });
+        }
+        ZynclaveAccount.get().addObserver(mObserver);
+        // A page restored after the process died may find the account gone. The account is
+        // SIGNED_OUT until its file is read, so no check here: reading it (showAccount asks for
+        // the name) ends in one observer call, and onAccountChanged leaves if it isn't signed in.
+        showAccount();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public void onDestroy() {
+        ZynclaveAccount.get().removeObserver(mObserver);
+        dismissDialog();
+        super.onDestroy();
+    }
+
+    private void showAccount() {
+        Preference summary = findPreference(SUMMARY_KEY);
+        if (summary == null) return;
+        ZynclaveAccount account = ZynclaveAccount.get();
+        ZynclaveAccountPreference.Content content =
+                ZynclaveAccountPreference.content(
+                        requireContext(),
+                        State.SIGNED_IN,
+                        account.name(),
+                        account.email(),
+                        ZynclaveConfig.get().isStaging());
+        CharSequence summaryText = content.summary();
+        summary.setSummary(
+                summaryText == null ? content.title() : content.title() + "\n" + summaryText);
+    }
+
+    private void onAccountChanged() {
+        if (ZynclaveAccount.get().state() == State.SIGNED_IN) {
+            showAccount();
+            return;
+        }
+        // Signed out here, or the account needs signing in again: nothing is left to show.
+        leave();
+    }
+
+    /**
+     * Goes back one page, as Back does: the Settings list stays, and the activity stays alive
+     * (the end-session Custom Tab may still be opened from it). Posted, as this can run while
+     * the page is still being created.
+     */
+    private void leave() {
+        if (mLeaving) return;
+        mLeaving = true;
+        new Handler(Looper.getMainLooper())
+                .post(
+                        () -> {
+                            Activity activity = getActivity();
+                            if (activity instanceof ComponentActivity component && isAdded()) {
+                                component.getOnBackPressedDispatcher().onBackPressed();
+                            }
+                        });
+    }
+
+    /**
+     * Asks whether to sign out of Zynclave's websites in Tark too. Either way the account is
+     * signed out at once and the token revoked; "everywhere" then also opens the Zynclave
+     * Account's own sign-out page in Tark's Custom Tab.
+     */
+    @VisibleForTesting
+    static AlertDialog showSignOutDialog(Activity activity) {
+        dismissDialog();
+        AlertDialog dialog =
+                new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.tark_zynclave_sign_out_title)
+                        .setNegativeButton(
+                                R.string.tark_zynclave_sign_out_tark_only,
+                                (d, which) -> ZynclaveAccount.get().signOut(false, null))
+                        .setPositiveButton(
+                                R.string.tark_zynclave_sign_out_everywhere,
+                                (d, which) -> ZynclaveAccount.get().signOut(true, activity))
+                        .create();
+        dialog.setOnDismissListener(
+                d -> {
+                    if (sDialog == d) sDialog = null;
+                });
+        sDialog = dialog;
+        dialog.show();
+        return dialog;
+    }
+
+    private static void dismissDialog() {
+        AlertDialog dialog = sDialog;
+        sDialog = null;
+        if (dialog == null) return;
+        try {
+            dialog.dismiss();
+        } catch (RuntimeException e) {
+            // Its window is already gone.
+        }
+    }
+
+    @VisibleForTesting
+    static @Nullable AlertDialog getDialogForTesting() {
+        return sDialog;
+    }
+}
