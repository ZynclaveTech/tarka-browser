@@ -0,0 +1,258 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.tark.zynclave;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.text.TextUtils;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.VisibleForTesting;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import com.google.android.material.color.MaterialColors;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tark.zynclave.ZynclaveAccount.State;
+import org.chromium.chrome.browser.ui.messages.snackbar.Snackbar;
+import org.chromium.chrome.browser.ui.messages.snackbar.SnackbarManager;
+
+/**
+ * Tark: the Settings account row (spec §5.5), the first row under the header look-settings.patch
+ * adds. Signed out it says "Sign in with Zynclave" and a tap starts sign-in; signed in it shows
+ * the name and email and a tap opens {@link ZynclaveAccountSettings}. It follows {@link
+ * ZynclaveAccount} while it is attached to a Settings page.
+ *
+ * <p>{@link ZynclaveAccount} shows no message of its own: when a sign-in fails, this row says so,
+ * in the Settings snackbar (SettingsActivity is a SnackbarManageable) or, where an activity has
+ * none, in a toast.
+ */
+@NullMarked
+public class ZynclaveAccountPreference extends Preference {
+    /** What the row shows. */
+    @VisibleForTesting
+    static final class Content {
+        private final CharSequence mTitle;
+        private final @Nullable CharSequence mSummary;
+
+        Content(CharSequence title, @Nullable CharSequence summary) {
+            mTitle = title;
+            mSummary = summary;
+        }
+
+        CharSequence title() {
+            return mTitle;
+        }
+
+        @Nullable CharSequence summary() {
+            return mSummary;
+        }
+    }
+
+    private final Runnable mStateObserver = this::refresh;
+    private final Runnable mFailureObserver = this::onSignInFailed;
+    private boolean mObserving;
+
+    public ZynclaveAccountPreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setPersistent(false);
+        setOnPreferenceClickListener(p -> onRowClicked());
+        refresh();
+    }
+
+    @Override
+    public void onAttached() {
+        super.onAttached();
+        startObserving();
+    }
+
+    @Override
+    public void onDetached() {
+        stopObserving();
+        super.onDetached();
+    }
+
+    @VisibleForTesting
+    void startObserving() {
+        if (mObserving) return;
+        mObserving = true;
+        ZynclaveAccount account = ZynclaveAccount.get();
+        account.addObserver(mStateObserver);
+        account.addSignInFailureObserver(mFailureObserver);
+        refresh();
+    }
+
+    @VisibleForTesting
+    void stopObserving() {
+        if (!mObserving) return;
+        mObserving = false;
+        ZynclaveAccount account = ZynclaveAccount.get();
+        account.removeObserver(mStateObserver);
+        account.removeSignInFailureObserver(mFailureObserver);
+    }
+
+    /**
+     * What the row shows for an account in {@code state}. The environment's label goes on the end
+     * of the summary in a test APK (staging); never in a published one.
+     */
+    @VisibleForTesting
+    static Content content(
+            Context context,
+            State state,
+            @Nullable String name,
+            @Nullable String email,
+            boolean staging) {
+        CharSequence title;
+        @Nullable String summary;
+        if (state == State.SIGNED_IN) {
+            if (name != null && !name.isEmpty()) {
+                title = name;
+                summary = email;
+            } else if (email != null && !email.isEmpty()) {
+                title = email;
+                summary = null;
+            } else {
+                title = context.getString(R.string.tark_zynclave_account_fallback);
+                summary = null;
+            }
+        } else if (state == State.NEEDS_SIGN_IN_AGAIN) {
+            title = context.getString(R.string.tark_zynclave_sign_in_again);
+            summary = name != null && !name.isEmpty() ? name : email;
+        } else {
+            // Signed out, or the sign-in page is open.
+            title = context.getString(R.string.tark_zynclave_sign_in);
+            summary = context.getString(R.string.tark_zynclave_sign_in_summary);
+        }
+        if (staging) {
+            String label = context.getString(R.string.tark_zynclave_staging);
+            summary = summary == null || summary.isEmpty() ? label : summary + " · " + label;
+        }
+        return new Content(title, summary == null || summary.isEmpty() ? null : summary);
+    }
+
+    private void refresh() {
+        ZynclaveAccount account = ZynclaveAccount.get();
+        State state = account.state();
+        Content content =
+                content(
+                        getContext(),
+                        state,
+                        account.name(),
+                        account.email(),
+                        ZynclaveConfig.get().isStaging());
+        setTitle(content.title());
+        setSummary(content.summary());
+        // Signed in, a tap opens the account page, as a Settings row with a fragment does.
+        setFragment(state == State.SIGNED_IN ? ZynclaveAccountSettings.class.getName() : null);
+        // The sign-in page is already open (or opening): a second tap has nothing to do.
+        setEnabled(state != State.SIGNING_IN);
+    }
+
+    /** Returns true when the tap was the row's own (a sign-in); false lets the fragment open. */
+    private boolean onRowClicked() {
+        State state = ZynclaveAccount.get().state();
+        if (state == State.SIGNED_IN || state == State.SIGNING_IN) return false;
+        Activity activity = activityOf(getContext());
+        if (activity == null) return true;
+        ZynclaveAccount.get().signIn(activity, false);
+        return true;
+    }
+
+    private void onSignInFailed() {
+        showSignInFailed(getContext());
+    }
+
+    /** Says that sign-in failed: in the activity's snackbar if it has one, else a toast. */
+    @VisibleForTesting
+    static void showSignInFailed(Context context) {
+        CharSequence text = context.getString(R.string.tark_zynclave_sign_in_failed);
+        Activity activity = activityOf(context);
+        if (activity instanceof SnackbarManager.SnackbarManageable manageable) {
+            SnackbarManager manager = manageable.getSnackbarManager();
+            if (manager != null) {
+                manager.showSnackbar(
+                        Snackbar.make(
+                                text, null, Snackbar.TYPE_NOTIFICATION, Snackbar.UMA_UNKNOWN));
+                return;
+            }
+        }
+        Toast.makeText(context.getApplicationContext(), text, Toast.LENGTH_LONG).show();
+    }
+
+    private static @Nullable Activity activityOf(Context context) {
+        while (context instanceof ContextWrapper wrapper) {
+            if (context instanceof Activity activity) return activity;
+            context = wrapper.getBaseContext();
+        }
+        return null;
+    }
+
+    // Tark's tile (as the Settings header's): a rounded surface, bold title, small summary.
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        if (!(holder.itemView instanceof ViewGroup root)) return;
+        Context context = root.getContext();
+        root.removeAllViews();
+        root.setPaddingRelative(dp(context, 12), dp(context, 4), dp(context, 12), dp(context, 4));
+
+        LinearLayout tile = new LinearLayout(context);
+        tile.setOrientation(LinearLayout.VERTICAL);
+        tile.setPadding(dp(context, 12), dp(context, 10), dp(context, 12), dp(context, 10));
+        tile.setMinimumHeight(dp(context, 64));
+        tile.setGravity(Gravity.CENTER_VERTICAL);
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(dp(context, 14));
+        background.setColor(MaterialColors.getColor(context, R.attr.colorSurfaceContainerHigh, 0));
+        background.setStroke(
+                dp(context, 1), MaterialColors.getColor(context, R.attr.colorOutlineVariant, 0));
+        tile.setBackground(background);
+
+        CharSequence title = getTitle();
+        TextView titleView = new TextView(context);
+        titleView.setText(title);
+        titleView.setTextColor(MaterialColors.getColor(context, R.attr.colorOnSurface, 0));
+        titleView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        titleView.setTypeface(Typeface.DEFAULT_BOLD);
+        titleView.setMaxLines(1);
+        titleView.setEllipsize(TextUtils.TruncateAt.END);
+        tile.addView(titleView);
+        CharSequence summary = getSummary();
+        if (!TextUtils.isEmpty(summary)) {
+            TextView summaryView = new TextView(context);
+            summaryView.setText(summary);
+            summaryView.setTextColor(
+                    MaterialColors.getColor(context, R.attr.colorOnSurfaceVariant, 0));
+            summaryView.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12);
+            summaryView.setMaxLines(2);
+            summaryView.setEllipsize(TextUtils.TruncateAt.END);
+            tile.addView(summaryView);
+        }
+        // The tile has no click of its own: the row's item view handles it.
+        tile.setContentDescription(
+                TextUtils.isEmpty(summary) ? title : title + ". " + summary);
+        root.addView(
+                tile,
+                new ViewGroup.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+
+    private static int dp(Context context, int dp) {
+        return Math.round(dp * context.getResources().getDisplayMetrics().density);
+    }
+}
