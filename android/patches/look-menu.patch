+    // Tark: the menu's tiles. Each tile is an existing item's own model, so a tap
+    // goes through the menu's click handler exactly as that item's row did.
+    private static View buildTarkTilesView(ViewGroup parent) {
+        LinearLayout grid = new LinearLayout(parent.getContext());
+        grid.setOrientation(LinearLayout.VERTICAL);
+        int pad = tarkDp(parent.getContext(), 8);
+        grid.setPadding(pad, pad / 2, pad, pad / 2);
+        grid.setLayoutParams(
+                new ViewGroup.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        return grid;
+    }
+
+    private static void bindTarkTiles(PropertyModel model, View view, PropertyKey key) {
+        if (key != AppMenuItemProperties.ADDITIONAL_ICONS) return;
+        LinearLayout grid = (LinearLayout) view;
+        grid.removeAllViews();
+        Context context = view.getContext();
+        ModelList tiles = model.get(AppMenuItemProperties.ADDITIONAL_ICONS);
+        AppMenuClickHandler handler = model.get(AppMenuItemProperties.CLICK_HANDLER);
+        LinearLayout row = null;
+        for (int i = 0; i < tiles.size(); i++) {
+            if (i % 2 == 0) {
+                row = new LinearLayout(context);
+                row.setOrientation(LinearLayout.HORIZONTAL);
+                grid.addView(row);
+            }
+            LinearLayout.LayoutParams params =
+                    new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f);
+            int margin = tarkDp(context, 4);
+            params.setMargins(margin, margin, margin, margin);
+            assumeNonNull(row).addView(buildTarkTile(context, tiles.get(i).model, handler), params);
+        }
+    }
+
+    private static View buildTarkTile(
+            Context context, PropertyModel item, @Nullable AppMenuClickHandler handler) {
+        LinearLayout tile = new LinearLayout(context);
+        tile.setOrientation(LinearLayout.VERTICAL);
+        int pad = tarkDp(context, 12);
+        tile.setPadding(pad, pad, pad, pad);
+        GradientDrawable background = new GradientDrawable();
+        background.setCornerRadius(tarkDp(context, 14));
+        background.setColor(MaterialColors.getColor(context, R.attr.colorSurface, 0));
+        background.setStroke(
+                tarkDp(context, 1), MaterialColors.getColor(context, R.attr.colorOutlineVariant, 0));
+        tile.setBackground(background);
+
+        ImageView icon = new ImageView(context);
+        icon.setImageResource(tarkTileIcon(item.get(AppMenuItemProperties.MENU_ITEM_ID)));
+        icon.setImageTintList(
+                ColorStateList.valueOf(MaterialColors.getColor(context, R.attr.colorPrimary, 0)));
+        int iconSize = tarkDp(context, 24);
+        tile.addView(icon, new LinearLayout.LayoutParams(iconSize, iconSize));
+
+        TextView title = new TextView(context);
+        title.setText(item.get(AppMenuItemProperties.TITLE));
+        title.setTextColor(MaterialColors.getColor(context, R.attr.colorOnSurface, 0));
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        title.setPadding(0, tarkDp(context, 8), 0, 0);
+        tile.addView(title);
+
+        boolean enabled = item.get(AppMenuItemProperties.ENABLED);
+        tile.setEnabled(enabled);
+        tile.setAlpha(enabled ? 1f : 0.38f);
+        tile.setContentDescription(item.get(AppMenuItemProperties.TITLE));
+        if (handler != null && enabled) {
+            tile.setOnClickListener(v -> handler.onItemClick(item));
+        }
+        return tile;
+    }
+
+    private static int tarkTileIcon(int menuItemId) {
+        if (menuItemId == R.id.new_incognito_tab_menu_id) return R.drawable.ic_incognito;
+        if (menuItemId == R.id.downloads_menu_id) return R.drawable.ic_download_done_24dp;
+        if (menuItemId == R.id.open_history_menu_id) return R.drawable.ic_history_24dp;
+        return R.drawable.ic_add_box_rounded_corner;
+    }
+
+    private static int tarkDp(Context context, int dp) {
+        return Math.round(dp * context.getResources().getDisplayMetrics().density);
     }
 
