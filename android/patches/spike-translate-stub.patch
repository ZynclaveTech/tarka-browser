new file mode 100644
index 0000000..87a449b
--- /dev/null
+++ b/components/translate/core/browser/resources/tark_stub_element.js
@@ -0,0 +1,29 @@
+// Tark spike (throwaway): a stand-in for element.js served from the APK.
+// It "translates" by upper-casing every text node, and restores them.
+var google = google || {};
+google.translate = google.translate || {};
+google.translate.TranslateService = function(opts) {
+  const originals = new Map();
+  return {
+    isAvailable: function() { return true; },
+    getDetectedLanguage: function() { return 'hi'; },
+    translatePage: function(src, tgt, onProgress) {
+      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+      let node;
+      while ((node = walker.nextNode())) {
+        if (!originals.has(node)) {
+          originals.set(node, node.nodeValue);
+        }
+        node.nodeValue = node.nodeValue.toUpperCase();
+      }
+      onProgress(100, true, 0);
+    },
+    restore: function() {
+      for (const [node, value] of originals) {
+        node.nodeValue = value;
+      }
+      originals.clear();
+    },
+  };
+};
+cr.googleTranslate.onTranslateElementLoad();
