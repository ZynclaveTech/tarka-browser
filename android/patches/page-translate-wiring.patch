+#ifndef CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TARK_PAGE_TRANSLATE_HOST_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TARK_PAGE_TRANSLATE_HOST_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "components/translate/content/common/tark_page_translate.mojom.h"
+#include "content/public/browser/document_service.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+
+namespace content {
+class RenderFrameHost;
+}  // namespace content
+
+namespace tark_captions {
+
+// The browser end of page translation's bridge: a main document's
+// TranslateAgent sends the batches of Tark's translate script here, and they
+// go to the tab's TarkPageTranslation. One per document (DocumentService): a
+// new document gets a new one and the old one's answers are dropped.
+class TarkPageTranslateHost
+    : public content::DocumentService<tark::mojom::PageTranslateHost> {
+ public:
+  // The renderer's limits are the script's (16 texts, 1,000 characters, one
+  // longer text alone); these only bound what a bad renderer can send.
+  static constexpr size_t kMaxTexts = 64;
+  static constexpr size_t kMaxChars = 64 * 1024;
+  static constexpr size_t kMaxLanguageLength = 16;
+
+  using Translator = base::RepeatingCallback<void(
+      std::vector<std::string> texts,
+      std::string source,
+      std::string target,
+      base::OnceCallback<void(std::vector<std::optional<std::string>>)>)>;
+
+  // chrome_browser_interface_binders.cc. Only a primary main frame's.
+  static void Bind(
+      content::RenderFrameHost* render_frame_host,
+      mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver);
+
+  // Browser tests: answer every batch with `translator` instead of the tab's
+  // TarkPageTranslation (the fake PageTranslator). Null restores.
+  static void SetTranslatorForTesting(Translator translator);
+
+  TarkPageTranslateHost(const TarkPageTranslateHost&) = delete;
+  TarkPageTranslateHost& operator=(const TarkPageTranslateHost&) = delete;
+
+  // tark::mojom::PageTranslateHost:
+  void Translate(const std::vector<std::string>& texts,
+                 const std::string& source,
+                 const std::string& target,
+                 TranslateCallback callback) override;
+
+ private:
+  TarkPageTranslateHost(
+      content::RenderFrameHost& render_frame_host,
+      mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver);
+  ~TarkPageTranslateHost() override;
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_ANDROID_TARK_PAGE_TRANSLATE_HOST_H_
