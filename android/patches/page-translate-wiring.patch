+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/url_loader_interceptor.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "net/test/embedded_test_server/http_response.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr char kHindiPage[] =
+    "<!doctype html><html lang=\"hi\"><head><meta charset=\"utf-8\">"
+    "<title>पन्ना</title></head><body>"
+    "<p id=\"a\">भारत एक विशाल देश है। यहाँ अनेक भाषाएँ बोली जाती हैं।</p>"
+    "<p id=\"b\">हिंदी भारत की सबसे अधिक बोली जाने वाली भाषा है।</p>"
+    "</body></html>";
+
+// The fake PageTranslator: "EN:" before each text.
+std::string Fake(const std::string& text) {
+  return "EN:" + text;
+}
+
+std::unique_ptr<net::test_server::HttpResponse> ServeHindiPage(
+    const net::test_server::HttpRequest& request) {
+  if (request.relative_url != "/hi.html") {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/html; charset=utf-8");
+  response->set_content(kHindiPage);
+  return response;
+}
+
+class TarkPageTranslateBrowserTest : public PlatformBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    PlatformBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServeHindiPage));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    TarkPageTranslateHost::SetTranslatorForTesting(base::BindRepeating(
+        &TarkPageTranslateBrowserTest::FakeTranslate, base::Unretained(this)));
+  }
+
+  void TearDownOnMainThread() override {
+    TarkPageTranslateHost::SetTranslatorForTesting({});
+    PlatformBrowserTest::TearDownOnMainThread();
+  }
+
+  void FakeTranslate(
+      std::vector<std::string> texts,
+      std::string source,
+      std::string target,
+      base::OnceCallback<void(std::vector<std::optional<std::string>>)> done) {
+    ++batches_;
+    last_source_ = source;
+    last_target_ = target;
+    std::vector<std::optional<std::string>> results;
+    for (const std::string& text : texts) {
+      results.push_back(Fake(text));
+    }
+    std::move(done).Run(std::move(results));
+  }
+
+  content::WebContents* web_contents() {
+    return chrome_test_utils::GetActiveWebContents(this);
+  }
+
+  translate::TranslateManager* manager() {
+    return ChromeTranslateClient::FromWebContents(web_contents())
+        ->GetTranslateManager();
+  }
+
+  // Loads the Hindi page and waits until translate has its language.
+  void LoadHindiPage() {
+    ASSERT_TRUE(content::NavigateToURL(
+        web_contents(), embedded_test_server()->GetURL("/hi.html")));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return manager()->GetLanguageState()->source_language() == "hi";
+    }));
+  }
+
+  std::string Text(const std::string& id) {
+    return content::EvalJs(web_contents(), "document.getElementById('" + id +
+                                               "').textContent")
+        .ExtractString();
+  }
+
+  // Waits (in the page) until the element's text is `expected`.
+  bool WaitForText(const std::string& id, const std::string& expected) {
+    return content::EvalJs(
+               web_contents(),
+               content::JsReplace(
+                   "new Promise(resolve => {"
+                   "  const check = () => {"
+                   "    if (document.getElementById($1).textContent === $2) {"
+                   "      resolve(true);"
+                   "    } else {"
+                   "      setTimeout(check, 50);"
+                   "    }"
+                   "  };"
+                   "  check();"
+                   "})",
+                   id, expected))
+        .ExtractBool();
+  }
+
+  void TranslateHindiToEnglish() {
+    manager()->TranslatePage("hi", "en", /*triggered_from_menu=*/true);
+  }
+
+  // Whether Tark's script is in the translate world.
+  bool ScriptInjected() {
+    return content::EvalJs(web_contents(),
+                           "typeof cr !== 'undefined' && "
+                           "typeof tarkTranslate !== 'undefined'",
+                           content::EXECUTE_SCRIPT_DEFAULT_OPTIONS,
+                           ISOLATED_WORLD_ID_TRANSLATE)
+        .ExtractBool();
+  }
+
+  int batches_ = 0;
+  std::string last_source_;
+  std::string last_target_;
+};
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       TranslatesLocalHindiPageInPlace) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  const std::string b = Text("b");
+  TranslateHindiToEnglish();
+  EXPECT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_TRUE(WaitForText("b", Fake(b)));
+  EXPECT_EQ("hi", last_source_);
+  EXPECT_EQ("en", last_target_);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ("en", manager()->GetLanguageState()->current_language());
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       ShowOriginalRestoresWithoutReload) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  // A mark in the page's own world that a reload would wipe.
+  ASSERT_TRUE(content::ExecJs(web_contents(), "window.tarkMark = 7;"));
+  content::NavigationController& controller = web_contents()->GetController();
+  const int entries = controller.GetEntryCount();
+  const int entry_id = controller.GetLastCommittedEntry()->GetUniqueID();
+
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+
+  manager()->RevertTranslation();
+  EXPECT_TRUE(WaitForText("a", a));
+  EXPECT_EQ(7, content::EvalJs(web_contents(), "window.tarkMark"));
+  EXPECT_EQ(entries, controller.GetEntryCount());
+  EXPECT_EQ(entry_id, controller.GetLastCommittedEntry()->GetUniqueID());
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, LoadMoreTextTranslated) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  // The translation has reported finished; the page then loads more text.
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  const std::string more = "और भी पाठ यहाँ जोड़ा गया है।";
+  ASSERT_TRUE(content::ExecJs(
+      web_contents(),
+      content::JsReplace("const p = document.createElement('p');"
+                         "p.id = 'more';"
+                         "p.textContent = $1;"
+                         "document.body.appendChild(p);",
+                         more)));
+  EXPECT_TRUE(WaitForText("more", Fake(more)));
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, NoScriptRequestOnNetwork) {
+  std::atomic<int> translate_requests{0};
+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* params) {
+        const GURL& url = params->url_request.url;
+        if (base::Contains(url.host(), "translate") ||
+            base::Contains(url.host(), "googleapis") ||
+            base::EndsWith(url.path(), ".js")) {
+          ++translate_requests;
+        }
+        return false;  // Let it through; only count.
+      }));
+  LoadHindiPage();
+  const std::string a = Text("a");
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ(0, translate_requests.load());
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, NotInjectedBeforeTap) {
+  LoadHindiPage();
+  // The offer may show; nothing runs in the page until Translate is tapped.
+  EXPECT_FALSE(ScriptInjected());
+  EXPECT_EQ(0, batches_);
+  const std::string a = Text("a");
+  EXPECT_EQ(a, Text("a"));
+
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_TRUE(ScriptInjected());
+  EXPECT_GT(batches_, 0);
+}
+
