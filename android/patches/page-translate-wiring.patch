+// found in the LICENSE file.
+
+// Tark for Android's page translation end to end in the browser: the bundled
+// translate script (no element.js), TranslateAgent's pump and the bridge
+// (tark.mojom.PageTranslateHost). The captions process is replaced by a fake
+// translator at the bridge (SetTranslatorForTesting); its own tests are
+// PageTranslatorTest and TarkPageTranslationTest.
+
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/containers/contains.h"
