+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions_android/tark_page_translate_host.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/tark_captions_android/tark_page_translation.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tark_captions {
+
+namespace {
+
+TarkPageTranslateHost::Translator& TranslatorForTesting() {
+  static base::NoDestructor<TarkPageTranslateHost::Translator> translator;
+  return *translator;
+}
+
+// Language codes as translate sends them: "hi", "en", "zh-CN", "mni-Mtei".
+bool IsLanguageCode(const std::string& code) {
+  if (code.empty() || code.size() > TarkPageTranslateHost::kMaxLanguageLength) {
+    return false;
+  }
+  for (char c : code) {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<std::optional<std::string>> AllOriginals(size_t count) {
+  return std::vector<std::optional<std::string>>(count);
+}
+
+// TarkPageTranslation's callback takes the results by value, mojo's by
+// reference.
+base::OnceCallback<void(std::vector<std::optional<std::string>>)> Adapt(
+    tark::mojom::PageTranslateHost::TranslateCallback callback) {
+  return base::BindOnce(
+      [](tark::mojom::PageTranslateHost::TranslateCallback callback,
+         std::vector<std::optional<std::string>> results) {
+        std::move(callback).Run(results);
+      },
+      std::move(callback));
+}
+
+}  // namespace
+
+// static
+void TarkPageTranslateHost::Bind(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver) {
+  // Only the tab's page translates (TranslateAgent is the main frame's); a
+  // prerendered or fenced document gets nothing.
+  if (!render_frame_host || !render_frame_host->IsInPrimaryMainFrame()) {
+    return;
+  }
+  // Owned by the document (DocumentService).
+  new TarkPageTranslateHost(*render_frame_host, std::move(receiver));
+}
+
+// static
+void TarkPageTranslateHost::SetTranslatorForTesting(Translator translator) {
+  TranslatorForTesting() = std::move(translator);
+}
+
+TarkPageTranslateHost::TarkPageTranslateHost(
+    content::RenderFrameHost& render_frame_host,
+    mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver)
+    : DocumentService(render_frame_host, std::move(receiver)) {}
+
+TarkPageTranslateHost::~TarkPageTranslateHost() = default;
+
+void TarkPageTranslateHost::Translate(const std::vector<std::string>& texts,
+                                      const std::string& source,
+                                      const std::string& target,
+                                      TranslateCallback callback) {
+  size_t chars = 0;
+  for (const std::string& text : texts) {
+    chars += text.size();
+  }
+  if (texts.size() > kMaxTexts || chars > kMaxChars) {
+    ReportBadMessageAndDeleteThis("Tark page translation: batch too large");
+    return;
+  }
+  // An unknown pair (the script's "und", a code with a script subtag Tark
+  // doesn't name) keeps the originals; TarkPageTranslation answers a pair
+  // without models the same way.
+  if (!IsLanguageCode(source) || !IsLanguageCode(target)) {
+    std::move(callback).Run(AllOriginals(texts.size()));
+    return;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(&render_frame_host());
+  // Never in the background, never for a document that is no longer the
+  // tab's page (back/forward cache, a page being replaced).
+  if (!render_frame_host().IsInPrimaryMainFrame() || !web_contents ||
+      web_contents->GetVisibility() == content::Visibility::HIDDEN) {
+    std::move(callback).Run(AllOriginals(texts.size()));
+    return;
+  }
+  if (TranslatorForTesting()) {
+    TranslatorForTesting().Run(texts, source, target,
+                               Adapt(std::move(callback)));
+    return;
+  }
+  TarkPageTranslation::CreateForWebContents(web_contents);
+  TarkPageTranslation::FromWebContents(web_contents)
+      ->Translate(texts, source, target, Adapt(std::move(callback)));
+}
+
+}  // namespace tark_captions
