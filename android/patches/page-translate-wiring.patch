+  using Translator = base::RepeatingCallback<void(
+      std::vector<std::string> texts,
+      std::string source,
+      std::string target,
+      base::OnceCallback<void(std::vector<std::optional<std::string>>)>)>;
+
+  // chrome_browser_interface_binders.cc. Only a primary main frame's.
+  static void Bind(
+      content::RenderFrameHost* render_frame_host,
+      mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver);
+
+  // Browser tests: answer every batch with `translator` instead of the tab's
+  // TarkPageTranslation (the fake PageTranslator). Null restores.
+  static void SetTranslatorForTesting(Translator translator);
+
+  TarkPageTranslateHost(const TarkPageTranslateHost&) = delete;
+  TarkPageTranslateHost& operator=(const TarkPageTranslateHost&) = delete;
+
+  // tark::mojom::PageTranslateHost:
+  void Translate(const std::vector<std::string>& texts,
+                 const std::string& source,
+                 const std::string& target,
+                 TranslateCallback callback) override;
+
+ private:
+  TarkPageTranslateHost(
+      content::RenderFrameHost& render_frame_host,
+      mojo::PendingReceiver<tark::mojom::PageTranslateHost> receiver);
+  ~TarkPageTranslateHost() override;
+};
