+void TranslateAgent::TarkStartPump() {
+  TarkStopPump();
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  tark_target_ = target_lang_;
+  tark_source_ = source_lang_;
+  if (tark_source_ == kAutoDetectionLanguage) {
+    // The script's guess (the page's lang), as translate.js reports it.
+    tark_source_ = GetPageSourceLanguage();
+    if (!weak_this) {
+      return;
+    }
+  }
+  tark_pumping_ = true;
+  tark_timer_.SetTaskRunner(translate_task_runner_);
+  TarkPump();
+}
+
+void TranslateAgent::TarkStopPump() {
+  tark_pumping_ = false;
+  // Answers still to come belong to the stopped pump.
+  ++tark_generation_;
+  tark_in_flight_ = 0;
+  tark_outstanding_.clear();
+  tark_idle_polls_ = 0;
+  tark_timer_.Stop();
+}
+
+void TranslateAgent::TarkPump() {
+  if (!tark_pumping_ || tark_hidden_) {
+    return;
+  }
+  // Executing script may spin a nested run loop that detaches the frame and
+  // deletes |this|.
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  while (tark_in_flight_ < kTarkMaxInFlight) {
+    std::string json = ExecuteScriptAndGetStringResult(kTarkTakeBatchScript);
+    if (!weak_this || !tark_pumping_) {
+      return;
+    }
+    if (json.empty() || json == "null") {
+      break;  // Nothing queued.
+    }
+    std::optional<base::Value> batch = base::JSONReader::Read(
+        json, base::JSON_PARSE_RFC | base::JSON_REPLACE_INVALID_CHARACTERS);
+    std::optional<double> id;
+    const base::ListValue* list = nullptr;
+    if (batch && batch->is_dict()) {
+      id = batch->GetDict().FindDouble("id");
+      list = batch->GetDict().FindList("texts");
+    }
+    if (!id || !list) {
+      // The script already counts the batch as sent: answer it (all
+      // originals) so the translation can still finish.
+      std::optional<int64_t> taken = id ? std::optional<int64_t>(*id)
+                                        : TarkBatchIdFromJson(json);
+      if (!taken) {
+        break;
+      }
+      TarkAnswerOriginals(*taken);
+      if (!weak_this || !tark_pumping_) {
+        return;
+      }
+      continue;
+    }
+    std::vector<std::string> texts;
+    texts.reserve(list->size());
+    for (const base::Value& text : *list) {
+      // The script only queues strings; anything else goes as empty text.
+      texts.push_back(text.is_string() ? text.GetString() : std::string());
+    }
+    if (!tark_host_.is_bound() || !tark_host_.is_connected()) {
+      tark_host_.reset();
+      render_frame()->GetBrowserInterfaceBroker().GetInterface(
+          tark_host_.BindNewPipeAndPassReceiver());
+      // A closed pipe drops its callbacks: their slots are free again (the
+      // script keeps those nodes' originals).
+      tark_host_.set_disconnect_handler(base::BindOnce(
+          &TranslateAgent::TarkOnHostGone, base::Unretained(this)));
+    }
+    ++tark_in_flight_;
+    tark_outstanding_.insert(static_cast<int64_t>(*id));
+    const size_t count = texts.size();
+    tark_host_->Translate(
+        std::move(texts), tark_source_, tark_target_,
+        base::BindOnce(&TranslateAgent::TarkOnResults,
+                       weak_pointer_factory_.GetWeakPtr(), tark_generation_,
+                       static_cast<int64_t>(*id), count));
+  }
+  // Looks again while batches are out or the queue was not empty; idle, the
+  // poll backs off to kTarkIdlePumpDelayMs.
+  tark_idle_polls_ = tark_in_flight_ ? 0 : tark_idle_polls_ + 1;
+  tark_timer_.Start(
+      FROM_HERE,
+      AdjustDelay(tark_idle_polls_ > kTarkIdlePollsBeforeBackoff
+                      ? kTarkIdlePumpDelayMs
+                      : kTarkPumpDelayMs),
+      base::BindOnce(&TranslateAgent::TarkPump, base::Unretained(this)));
+}
+
+void TranslateAgent::TarkAnswerOriginals(int64_t id) {
+  // An empty answer is padded to all-null by the script: originals.
+  TarkExecuteUtf8Script("tarkTranslate.onResult(" + base::NumberToString(id) +
+                        ",[])");
+}
+
+void TranslateAgent::TarkOnHostGone() {
+  tark_host_.reset();
+  // The pipe dropped the callbacks: answer those batches with originals.
+  std::set<int64_t> outstanding = std::move(tark_outstanding_);
+  tark_outstanding_.clear();
+  tark_in_flight_ = 0;
+  if (!tark_pumping_) {
+    return;
+  }
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  for (int64_t id : outstanding) {
+    TarkAnswerOriginals(id);
+    if (!weak_this) {
+      return;
+    }
+  }
+}
+
+// static
+std::optional<int64_t> TranslateAgent::TarkBatchIdFromJson(
+    const std::string& json) {
+  // JSON.stringify({id, texts}) starts with {"id":N.
+  static constexpr char kPrefix[] = "{\"id\":";
+  if (!base::StartsWith(json, kPrefix)) {
+    return std::nullopt;
+  }
+  size_t end = sizeof(kPrefix) - 1;
+  while (end < json.size() && base::IsAsciiDigit(json[end])) {
+    ++end;
+  }
+  int64_t id = 0;
+  if (!base::StringToInt64(
+          std::string_view(json).substr(sizeof(kPrefix) - 1,
+                                        end - (sizeof(kPrefix) - 1)),
+          &id)) {
+    return std::nullopt;
+  }
+  return id;
+}
+
+void TranslateAgent::WasHidden() {
+  // Never translate in the background: the queue waits for the page.
+  tark_hidden_ = true;
+  tark_timer_.Stop();
+}
+
+void TranslateAgent::WasShown() {
+  tark_hidden_ = false;
+  if (tark_pumping_) {
+    tark_idle_polls_ = 0;
+    TarkPump();
+  }
+}
+
+void TranslateAgent::TarkOnResults(
+    uint64_t generation,
+    int64_t id,
+    size_t count,
+    const std::vector<std::optional<std::string>>& results) {
+  if (generation != tark_generation_ || !tark_pumping_) {
+    return;
+  }
+  --tark_in_flight_;
+  tark_outstanding_.erase(id);
+  base::ListValue list;
+  for (size_t i = 0; i < count; ++i) {
+    // A missing or null result keeps the original.
+    if (i < results.size() && results[i]) {
+      list.Append(*results[i]);
+    } else {
+      list.Append(base::Value());
+    }
+  }
+  std::optional<std::string> json = base::WriteJson(list);
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  TarkExecuteUtf8Script(
+      "tarkTranslate.onResult(" + base::NumberToString(id) + "," +
+      json.value_or(std::string("[]")) + ")");
+  if (!weak_this) {
+    return;
+  }
+  // The answer freed a slot: send what is queued now.
+  TarkPump();
+}
+
+void TranslateAgent::TarkExecuteUtf8Script(const std::string& script) {
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+  WebScriptSource source = WebScriptSource(WebString::FromUTF8(script));
+  main_frame->ExecuteScriptInIsolatedWorld(
+      world_id_, source, blink::BackForwardCacheAware::kAllow);
+}
