+// found in the LICENSE file.
+
+// Tark for Android's page translation end to end in the browser: the bundled
+// translate script (no element.js), TranslateAgent's pump and the bridge
+// (tark.mojom.PageTranslateHost). The captions process is replaced by a fake
+// translator at the bridge (SetTranslatorForTesting); its own tests are
+// PageTranslatorTest and TarkPageTranslationTest.
+
+#include <algorithm>
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/test/bind.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "chrome/browser/tark_captions_android/tark_page_translate_host.h"
+#include "chrome/browser/translate/chrome_translate_client.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "chrome/test/base/chrome_test_utils.h"
+#include "chrome/test/base/platform_browser_test.h"
+#include "components/translate/core/browser/translate_download_manager.h"
+#include "components/translate/core/browser/translate_script.h"
+#include "components/translate/core/common/translate_switches.h"
+#include "components/translate/core/browser/language_state.h"
+#include "components/translate/core/browser/translate_manager.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/url_loader_interceptor.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "net/test/embedded_test_server/http_response.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr char kHindiPage[] =
+    "<!doctype html><html lang=\"hi\"><head><meta charset=\"utf-8\">"
+    "<title>पन्ना</title></head><body>"
+    "<p id=\"a\">भारत एक विशाल देश है। यहाँ अनेक भाषाएँ बोली जाती हैं।</p>"
+    "<p id=\"b\">हिंदी भारत की सबसे अधिक बोली जाने वाली भाषा है।</p>"
+    "</body></html>";
+
+// The fake PageTranslator: "EN:" before each text.
+std::string Fake(const std::string& text) {
+  return "EN:" + text;
+}
+
+std::unique_ptr<net::test_server::HttpResponse> ServeHindiPage(
+    const net::test_server::HttpRequest& request) {
+  if (request.relative_url != "/hi.html") {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/html; charset=utf-8");
+  response->set_content(kHindiPage);
+  return response;
+}
+
+class TarkPageTranslateBrowserTest : public PlatformBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    // Counts, from as early as a test can, every request to a translate or
+    // Google API host and every script; lets them through.
+    interceptor_ = std::make_unique<content::URLLoaderInterceptor>(
+        base::BindLambdaForTesting(
+            [this](content::URLLoaderInterceptor::RequestParams* params) {
+              const GURL& url = params->url_request.url;
+              if (url.host().contains("translate") ||
+                  url.host().contains("googleapis") ||
+                  url.host().contains("example.invalid") ||
+                  base::EndsWith(url.path(), ".js")) {
+                ++translate_requests_;
+              }
+              return false;
+            }));
+    PlatformBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServeHindiPage));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    TarkPageTranslateHost::SetTranslatorForTesting(base::BindRepeating(
+        &TarkPageTranslateBrowserTest::FakeTranslate, base::Unretained(this)));
+  }
+
+  void TearDownOnMainThread() override {
+    TarkPageTranslateHost::SetTranslatorForTesting({});
+    interceptor_.reset();
+    PlatformBrowserTest::TearDownOnMainThread();
+  }
+
+  void FakeTranslate(
+      std::vector<std::string> texts,
+      std::string source,
+      std::string target,
+      base::OnceCallback<void(std::vector<std::optional<std::string>>)> done) {
+    ++batches_;
+    if (hold_next_) {
+      hold_next_ = false;
+      held_texts_ = texts;
+      held_ = std::move(done);
+      return;
+    }
+    last_source_ = source;
+    last_target_ = target;
+    std::vector<std::optional<std::string>> results;
+    for (const std::string& text : texts) {
+      results.push_back(Fake(text));
+    }
+    std::move(done).Run(std::move(results));
+  }
+
+  content::WebContents* web_contents() {
+    return chrome_test_utils::GetActiveWebContents(this);
+  }
+
+  translate::TranslateManager* manager() {
+    return ChromeTranslateClient::FromWebContents(web_contents())
+        ->GetTranslateManager();
+  }
+
+  // Loads the Hindi page and waits until translate has its language.
+  void LoadHindiPage() {
+    ASSERT_TRUE(content::NavigateToURL(
+        web_contents(), embedded_test_server()->GetURL("/hi.html")));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return manager()->GetLanguageState()->source_language() == "hi";
+    }));
+  }
+
+  std::string Text(const std::string& id) {
+    return content::EvalJs(web_contents(), "document.getElementById('" + id +
+                                               "').textContent")
+        .ExtractString();
+  }
+
+  // Waits (in the page) until the element's text is `expected`.
+  bool WaitForText(const std::string& id, const std::string& expected) {
+    return content::EvalJs(
+               web_contents(),
+               content::JsReplace(
+                   "new Promise(resolve => {"
+                   "  const check = () => {"
+                   "    if (document.getElementById($1).textContent === $2) {"
+                   "      resolve(true);"
+                   "    } else {"
+                   "      setTimeout(check, 50);"
+                   "    }"
+                   "  };"
+                   "  check();"
+                   "})",
+                   id, expected))
+        .ExtractBool();
+  }
+
+  void TranslateHindiToEnglish() {
+    manager()->TranslatePage("hi", "en", /*triggered_from_menu=*/true);
+  }
+
+  // Answers the held batch.
+  void ReleaseHeld() {
+    std::vector<std::optional<std::string>> results;
+    for (const std::string& text : held_texts_) {
+      results.push_back(Fake(text));
+    }
+    std::move(held_).Run(std::move(results));
+  }
+
+  void WaitSeconds(int seconds) {
+    base::RunLoop loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, loop.QuitClosure(), base::Seconds(seconds));
+    loop.Run();
+  }
+
+  // Whether Tark's script is in the translate world. Only after the tap:
+  // evaluating there earlier would create the world before translate sets it
+  // up.
+  bool ScriptInjected() {
+    return content::EvalJs(web_contents(),
+                           "typeof cr !== 'undefined' && "
+                           "typeof tarkTranslate !== 'undefined'",
+                           content::EXECUTE_SCRIPT_DEFAULT_OPTIONS,
+                           ISOLATED_WORLD_ID_TRANSLATE)
+        .ExtractBool();
+  }
+
+  std::unique_ptr<content::URLLoaderInterceptor> interceptor_;
+  std::atomic<int> translate_requests_{0};
+  bool hold_next_ = false;
+  std::vector<std::string> held_texts_;
+  base::OnceCallback<void(std::vector<std::optional<std::string>>)> held_;
+  int batches_ = 0;
+  std::string last_source_;
+  std::string last_target_;
+};
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       TranslatesLocalHindiPageInPlace) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  const std::string b = Text("b");
+  TranslateHindiToEnglish();
+  EXPECT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_TRUE(WaitForText("b", Fake(b)));
+  EXPECT_EQ("hi", last_source_);
+  EXPECT_EQ("en", last_target_);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ("en", manager()->GetLanguageState()->current_language());
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       ShowOriginalRestoresWithoutReload) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  // A mark in the page's own world that a reload would wipe.
+  ASSERT_TRUE(content::ExecJs(web_contents(), "window.tarkMark = 7;"));
+  content::NavigationController& controller = web_contents()->GetController();
+  const int entries = controller.GetEntryCount();
+  const int entry_id = controller.GetLastCommittedEntry()->GetUniqueID();
+
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+
+  manager()->RevertTranslation();
+  EXPECT_TRUE(WaitForText("a", a));
+  EXPECT_EQ(7, content::EvalJs(web_contents(), "window.tarkMark"));
+  EXPECT_EQ(entries, controller.GetEntryCount());
+  EXPECT_EQ(entry_id, controller.GetLastCommittedEntry()->GetUniqueID());
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, LoadMoreTextTranslated) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  // The translation has reported finished; the page then loads more text.
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  const std::string more = "और भी पाठ यहाँ जोड़ा गया है।";
+  ASSERT_TRUE(content::ExecJs(
+      web_contents(),
+      content::JsReplace("const p = document.createElement('p');"
+                         "p.id = 'more';"
+                         "p.textContent = $1;"
+                         "document.body.appendChild(p);",
+                         more)));
+  EXPECT_TRUE(WaitForText("more", Fake(more)));
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, NoScriptRequestOnNetwork) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ(0, translate_requests_.load());
+}
+
+// The same with ungoogled's switch given: still nothing (no language list, no
+// script, no origin for translate.js to load from).
+class TarkPageTranslateWithScriptUrlBrowserTest
+    : public TarkPageTranslateBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    TarkPageTranslateBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(translate::switches::kTranslateScriptURL,
+                                    "https://example.invalid/element.js");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateWithScriptUrlBrowserTest,
+                       NoScriptRequestOnNetwork) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ(0, translate_requests_.load());
+  EXPECT_EQ(false, content::EvalJs(web_contents(),
+                                   "securityOrigin !== ''",
+                                   content::EXECUTE_SCRIPT_DEFAULT_OPTIONS,
+                                   ISOLATED_WORLD_ID_TRANSLATE));
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       HiddenTabDefersThenResumes) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  web_contents()->WasHidden();
+  ASSERT_EQ("hidden",
+            content::EvalJs(web_contents(), "document.visibilityState"));
+  TranslateHindiToEnglish();
+  WaitSeconds(2);
+  // Nothing sent while hidden, and nothing given up as original.
+  EXPECT_EQ(0, batches_);
+  EXPECT_EQ(a, Text("a"));
+  web_contents()->WasShown();
+  EXPECT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_GT(batches_, 0);
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       UnparseableBatchStillFinishes) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  hold_next_ = true;
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(base::test::RunUntil([&] { return !held_.is_null(); }));
+  // The next batch the agent reads has no readable texts.
+  ASSERT_TRUE(content::ExecJs(
+      web_contents(),
+      "const take = tarkTranslate.takeBatch;"
+      "tarkTranslate.takeBatch = () => {"
+      "  const b = take();"
+      "  if (b) b.texts = 'unreadable';"
+      "  return b;"
+      "};",
+      content::EXECUTE_SCRIPT_DEFAULT_OPTIONS, ISOLATED_WORLD_ID_TRANSLATE));
+  const std::string more = "यह अनुच्छेद बाद में आया।";
+  ASSERT_TRUE(content::ExecJs(
+      web_contents(),
+      content::JsReplace("const p = document.createElement('p');"
+                         "p.id = 'more';"
+                         "p.textContent = $1;"
+                         "document.body.appendChild(p);",
+                         more)));
+  WaitSeconds(2);
+  ReleaseHeld();
+  // Finished is reported only once every batch was answered, the unreadable
+  // one included (with originals).
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_EQ(more, Text("more"));
+  EXPECT_EQ(1, batches_);
+}
+
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, NotInjectedBeforeTap) {
+  LoadHindiPage();
+  // The offer may show; nothing runs in the page until Translate is tapped:
+  // no script loaded in the browser, nothing in the page, no batch.
+  EXPECT_TRUE(translate::TranslateDownloadManager::GetInstance()
+                  ->script()
+                  ->data()
+                  .empty());
+  EXPECT_EQ(true, content::EvalJs(web_contents(),
+                                  "typeof tarkTranslate === 'undefined' && "
+                                  "typeof cr === 'undefined'"));
+  EXPECT_EQ(0, batches_);
+  const std::string a = Text("a");
+  EXPECT_EQ(a, Text("a"));
+
+  TranslateHindiToEnglish();
+  ASSERT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_TRUE(ScriptInjected());
+  EXPECT_GT(batches_, 0);
+}
