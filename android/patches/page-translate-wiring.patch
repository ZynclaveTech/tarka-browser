+module tark.mojom;
+
+// Tark for Android's page translation: the main frame's TranslateAgent sends
+// the batches Tark's translate script (IDR_TARK_TRANSLATE_JS) queues in the
+// translate world to the browser, which translates them on the tab's captions
+// process (TarkPageTranslation). Bound per document; the browser answers only
+// the primary main frame's.
+interface PageTranslateHost {
+  // `results` has one entry per text, in order; null keeps the original.
+  Translate(array<string> texts, string source, string target)
+      => (array<string?> results);
+};
