# Tark for Android (A1), appended to ungoogled-chromium's flags.gn by
# android/build.sh. Spec: Tark for Android design §7.
target_os = "android"
target_cpu = "arm64"
is_official_build = true
is_component_build = false
is_debug = false
chrome_pgo_phase = 0
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_rust = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
android_channel = "stable"
chrome_public_manifest_package = "com.gettarka.tarka"
# Host tools build against the build machine's own headers (installed by
# Chromium's install-build-deps), as the Mac build does; the Android target
# always uses the NDK's sysroot.
use_sysroot = false
# Without Clang header modules: building the unified system module from the
# NDK's headers fails (unknown type name '__BEGIN_DECLS'). Building without
# modules is supported; it costs only some compile time.
use_clang_modules = false
