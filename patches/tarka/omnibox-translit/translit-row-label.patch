+/* Tark: an Indian-language row shows its language name (the description) at
+ * the row's right edge, in the dimmed description colour set below (the
+ * element empties the separator text). The text container takes the row's
+ * free space (the empty actions container no longer shares it) and the
+ * description sits 16px, the row's end padding, from the edge. */
+:host([description-on-right]) .actions.container {
+  flex-grow: 0;
+}
+
+:host([description-on-right]) #text-container {
+  flex-grow: 1;
+  min-width: 0;
+  padding-inline-end: 0;
+}
+
+:host([description-on-right]) #text-container #suggestion {
+  display: flex;
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+:host([description-on-right]) #description {
+  flex-shrink: 0;
+  margin-inline-start: auto;
+  padding-inline-start: 16px;
+}
+
