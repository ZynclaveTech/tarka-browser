+#include "third_party/omnibox_proto/types.pb.h"
+
+namespace {
+
+using template_url_starter_pack_data::StarterPackId;
+
+// Just under the verbatim row (1300), so the rows sit right below what was
+// typed; in keyword mode, just under the keyword's verbatim row.
+constexpr int kRelevance = 1299;
+constexpr int kKeywordModeRelevance = 1499;
+
+// How long the model and a worker's cache are kept after the last request.
+constexpr base::TimeDelta kIdleRelease = base::Minutes(5);
+
+// The language tag of a row ("hi"), for the row's UI.
+constexpr char kLanguageInfoKey[] = "tark_xlit_lang";
+
+// The one sequence every provider's worker runs on, so that the shared model
+// is loaded, referenced and released on a single sequence.
+scoped_refptr<base::SequencedTaskRunner> WorkerTaskRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN}));
+  return *runner;
+}
+
+// The model and word lists, shared by every worker (every omnibox, private
+// profiles included); each worker builds its own Transliterator, and so its
+// own cache, over them. Lives on WorkerTaskRunner() only. Holds them for
+// kIdleRelease after the last Acquire(); workers that still hold a
+// Transliterator keep them alive until their own idle release.
+class SharedResources {
+ public:
+  // Only on WorkerTaskRunner().
+  static SharedResources& Get() {
+    static base::NoDestructor<SharedResources> instance;
+    return *instance;
+  }
+
+  SharedResources(const SharedResources&) = delete;
+  SharedResources& operator=(const SharedResources&) = delete;
+
+  // The resources, loaded on first use (blocking file IO), or null when the
+  // files are missing or invalid. Postpones the idle release.
+  scoped_refptr<const tark_xlit::Resources> Acquire() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    idle_timer_.Start(FROM_HERE, kIdleRelease, this,
+                      &SharedResources::Release);
+    if (!resources_ && !load_failed_) {
+      resources_ = tark_xlit::LoadResourcesFromBundle();
+      // Do not retry on every keystroke: the files ship inside the app, so a
+      // failed load will not succeed later.
+      load_failed_ = !resources_;
+      LOG_IF(ERROR, load_failed_)
+          << "The transliteration model or word lists are missing or invalid";
+    }
+    return resources_;
+  }
+
+ private:
+  friend class base::NoDestructor<SharedResources>;
+
+  SharedResources() = default;
+  ~SharedResources() = default;
+
+  void Release() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    resources_ = nullptr;
+  }
+
+  scoped_refptr<tark_xlit::Resources> resources_;
+  bool load_failed_ = false;
+  base::OneShotTimer idle_timer_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+// Whether `text` has a Latin letter: the first keystroke of a phrase that will
+// soon be transliterable.
+bool HasAsciiLetter(std::u16string_view text) {
+  return std::ranges::any_of(text, [](char16_t c) {
+    return base::IsAsciiAlpha(c);
+  });
+}
+
+}  // namespace
+
+// What a request needs on the UI sequence, from Start() to the reply.
+struct TarkTransliterationProvider::Request {
+  explicit Request(const AutocompleteInput& input) : input(input) {}
+
+  // The input the rows are for; in keyword mode, with the keyword stripped.
+  AutocompleteInput input;
+  // `input`'s text with whitespace collapsed: the text transliterated.
+  std::u16string text;
+  bool keyword_mode = false;
+  // The keyword of the engine the rows search with: the keyword-mode engine,
+  // else the default engine. The engine is looked up again for the reply, so
+  // no TemplateURL pointer outlives the task.
+  std::u16string engine_keyword;
+  // The row languages, best first. They point into a static table.
+  std::vector<const tark_xlit::Language*> languages;
+  // Everything the rows depend on, as one string.
+  std::u16string key;
+};
+
+// One provider's Transliterator (and so its cache), on WorkerTaskRunner().
+// Transliterator::Phrase() fills a cache and so must stay on one sequence.
+class TarkTransliterationProvider::Worker {
+ public:
+  explicit Worker(scoped_refptr<LatestRequestId> latest_request_id)
+      : latest_request_id_(std::move(latest_request_id)) {}
+  Worker(const Worker&) = delete;
+  Worker& operator=(const Worker&) = delete;
+  ~Worker() = default;
+
+  // Loads what the first real request needs, ahead of it.
+  void Warm() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    EnsureTransliterator();
+  }
+
+  // `text` written in each of `tags`, in order; nullopt where nothing changed.
+  // Empty when the model could not be loaded or the request was superseded.
+  std::vector<std::optional<std::u16string>> Phrases(
+      uint64_t request_id,
+      const std::u16string& text,
+      const std::vector<std::string>& tags) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::vector<std::optional<std::u16string>> phrases;
+    if (IsSuperseded(request_id) || !EnsureTransliterator()) {
+      return phrases;
+    }
+    phrases.reserve(tags.size());
+    for (const std::string& tag : tags) {
+      // A cold phrase costs ~15 ms a word; stop as soon as a newer keystroke
+      // makes the work useless.
+      if (IsSuperseded(request_id)) {
+        return {};
+      }
+      phrases.push_back(transliterator_->Phrase(text, tag));
+    }
+    return phrases;
+  }
+
+ private:
+  bool IsSuperseded(uint64_t request_id) const {
+    return latest_request_id_->data.load(std::memory_order_relaxed) !=
+           request_id;
+  }
+
+  // Whether there is a Transliterator. Postpones both idle releases, this
+  // worker's and the shared resources', so that the shared copy outlives
+  // every worker's and is never loaded twice.
+  bool EnsureTransliterator() {
+    idle_timer_.Start(FROM_HERE, kIdleRelease, this, &Worker::Release);
+    scoped_refptr<const tark_xlit::Resources> resources =
+        SharedResources::Get().Acquire();
+    if (!transliterator_ && resources) {
+      transliterator_ =
+          std::make_unique<tark_xlit::Transliterator>(std::move(resources));
+    }
+    return !!transliterator_;
+  }
+
+  // Frees this worker's cache and its reference to the shared resources.
+  void Release() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    transliterator_.reset();
+  }
+
+  const scoped_refptr<LatestRequestId> latest_request_id_;
+  std::unique_ptr<tark_xlit::Transliterator> transliterator_;
+  base::OneShotTimer idle_timer_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+TarkTransliterationProvider::TarkTransliterationProvider(
+    AutocompleteProviderClient* client,
+    AutocompleteProviderListener* listener)
+    : AutocompleteProvider(AutocompleteProvider::TYPE_QUERY_TILE),
+      client_(client),
+      latest_request_id_(base::MakeRefCounted<LatestRequestId>()) {
+  AddListener(listener);
+}
+
+TarkTransliterationProvider::~TarkTransliterationProvider() = default;
+
+// static
+bool TarkTransliterationProvider::RunsInStarterPackScope(StarterPackId id) {
+  // No default: a new starter-pack id must decide here.
+  switch (id) {
+    case StarterPackId::kTarkWiki:
+    case StarterPackId::kTarkMaps:
+    case StarterPackId::kTarkGov:
+    case StarterPackId::kTarkIrctc:
+    case StarterPackId::kTarkKanoon:
+    case StarterPackId::kTarkYouTube:
+    case StarterPackId::kTarkDict:
+    case StarterPackId::kTarkArchive:
+    case StarterPackId::kTarkFlipkart:
+    case StarterPackId::kTarkAmazon:
+      return true;
+    case StarterPackId::kNone:
+    case StarterPackId::kBookmarks:
+    case StarterPackId::kHistory:
+    case StarterPackId::kTabs:
+    case StarterPackId::kGemini:
+    case StarterPackId::kPage:
+    case StarterPackId::kAiMode:
+    case StarterPackId::kMaxStarterPackId:
+      return false;
+  }
+  // An id read from disk that this build does not know.
+  return false;
+}
+
+void TarkTransliterationProvider::Start(const AutocompleteInput& input,
+                                        bool minimal_changes) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // `minimal_changes` is not used: it ignores keyword mode, which changes the
+  // engine and the text the rows are for. `matches_key_` covers both.
+  std::optional<Request> request = MakeRequest(input);
+  if (request && !matches_key_.empty() && request->key == matches_key_) {
+    // Nothing the rows depend on changed: keep them, cancel anything in
+    // flight.
+    Stop(AutocompleteStopReason::kInteraction);
+    return;
+  }
+
+  // Clears the previous rows: a row for "namas" must never stand next to
+  // "namaste".
+  Stop(AutocompleteStopReason::kClobbered);
+  if (!request) {
+    // The first letter of what may become a phrase ("n"): load the model now,
+    // so the first row does not wait for it.
+    if (!input.omit_asynchronous_matches() && !input.IsZeroSuggest() &&
+        input.type() != metrics::OmniboxInputType::URL &&
+        HasAsciiLetter(input.text())) {
+      EnsureWorker();
+      worker_.AsyncCall(&Worker::Warm);
+    }
+    return;
+  }
+
+  EnsureWorker();
+
+  std::vector<std::string> tags;
+  tags.reserve(request->languages.size());
+  for (const tark_xlit::Language* language : request->languages) {
+    tags.emplace_back(language->tag);
+  }
+  std::u16string text = request->text;
+
+  // Stop() above has already moved `request_id_` on to this request's id.
+  done_ = false;
+  worker_.AsyncCall(&Worker::Phrases)
+      .WithArgs(request_id_, std::move(text), std::move(tags))
+      .Then(base::BindOnce(&TarkTransliterationProvider::OnPhrases,
+                           weak_ptr_factory_.GetWeakPtr(), request_id_,
+                           std::move(*request)));
+}
+
+void TarkTransliterationProvider::EnsureWorker() {
+  if (worker_.is_null()) {
+    worker_.emplace(WorkerTaskRunner(), latest_request_id_);
+  }
+}
+
+void TarkTransliterationProvider::Stop(AutocompleteStopReason stop_reason) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  AutocompleteProvider::Stop(stop_reason);
+  if (stop_reason == AutocompleteStopReason::kClobbered) {
+    // The base class cleared `matches_`.
+    matches_key_.clear();
+  }
+  // Supersede the request in flight: the worker skips what is left of it and
+  // its reply is dropped.
+  ++request_id_;
+  latest_request_id_->data.store(request_id_, std::memory_order_relaxed);
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+std::optional<TarkTransliterationProvider::Request>
+TarkTransliterationProvider::MakeRequest(const AutocompleteInput& input) const {
+  // The classifier asks for synchronous matches only; zero-suggest has no
+  // text; a URL is not a query.
+  if (input.omit_asynchronous_matches() || input.IsZeroSuggest() ||
+      input.type() == metrics::OmniboxInputType::URL) {
+    return std::nullopt;
+  }
+  const TemplateURLService* template_url_service =
+      client_->GetTemplateURLService();
+  if (!template_url_service) {
+    return std::nullopt;
+  }
+
+  Request request(input);
+  const TemplateURL* engine = nullptr;
+  if (input.in_keyword_mode()) {
+    // Strips the keyword from `request.input`.
+    engine = AutocompleteInput::GetSubstitutingTemplateURLForInput(
+        template_url_service, &request.input);
+    if (!engine) {
+      return std::nullopt;
+    }
+    // AutocompleteController::ShouldRunProvider() already keeps the provider
+    // out of the other starter-pack scopes; this keeps the rule in one place
+    // for anyone calling Start() directly.
+    const StarterPackId starter_pack_id = engine->starter_pack_id();
+    if (starter_pack_id != StarterPackId::kNone &&
+        !RunsInStarterPackScope(starter_pack_id)) {
+      return std::nullopt;
+    }
+    // An extension's keyword hands the text to the extension, not to a
+    // search URL.
+    if (engine->type() == TemplateURL::OMNIBOX_API_EXTENSION) {
+      return std::nullopt;
+    }
+    request.keyword_mode = true;
+  } else {
+    // "@wi..." is on its way to a keyword, not a query.
+    if (input.GetFeaturedKeywordMode() !=
+        AutocompleteInput::FeaturedKeywordMode::kFalse) {
+      return std::nullopt;
+    }
+    engine = template_url_service->GetDefaultSearchProvider();
+  }
+  // BaseSearchProvider::CreateSearchSuggestion() requires replacement.
+  if (!engine ||
+      !engine->SupportsReplacement(template_url_service->search_terms_data())) {
+    return std::nullopt;
+  }
+
+  request.text = base::CollapseWhitespace(
+      request.input.text(), /*trim_sequences_with_line_breaks=*/false);
+  // Stripping the keyword does not reclassify the input: "@wiki flipkart.com"
+  // is a QUERY as a whole, but what is left is a URL.
+  if (request.keyword_mode &&
+      AutocompleteInput::Parse(request.text, std::string(),
+                               client_->GetSchemeClassifier(),
+                               /*parts=*/nullptr, /*scheme=*/nullptr,
+                               /*canonicalized_url=*/nullptr) ==
+          metrics::OmniboxInputType::URL) {
+    return std::nullopt;
+  }
+  if (!tark_xlit::LooksTransliterable(request.text)) {
+    return std::nullopt;
+  }
+  request.engine_keyword = engine->keyword();
+  request.languages = tark_xlit::RowLanguages(client_->GetAcceptLanguages());
+  if (request.languages.empty()) {
+    return std::nullopt;
+  }
+
+  request.key = base::StrCat(
+      {request.text, u"\x1f", request.keyword_mode ? u"k" : u"d",
+       request.engine_keyword, u"\x1f", base::UTF8ToUTF16(engine->url())});
+  for (const tark_xlit::Language* language : request.languages) {
+    base::StrAppend(&request.key,
+                    {u"\x1f", base::ASCIIToUTF16(language->tag)});
+  }
+  return request;
+}
+
+void TarkTransliterationProvider::OnPhrases(
+    uint64_t request_id,
+    Request request,
+    std::vector<std::optional<std::u16string>> phrases) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Stop() invalidates the weak pointer too; the id check is the backstop.
+  if (request_id != request_id_) {
+    return;
+  }
+
+  matches_.clear();
+  const TemplateURLService* template_url_service =
+      client_->GetTemplateURLService();
+  const TemplateURL* engine = nullptr;
+  if (template_url_service) {
+    engine = request.keyword_mode
+                 ? template_url_service->GetTemplateURLForKeyword(
+                       request.engine_keyword)
+                 : template_url_service->GetDefaultSearchProvider();
+  }
+  // The engines can change while the worker runs; never search with a
+  // different one than the request was made for.
+  if (engine && engine->keyword() == request.engine_keyword &&
+      engine->SupportsReplacement(template_url_service->search_terms_data())) {
+    int relevance = request.keyword_mode ? kKeywordModeRelevance : kRelevance;
+    std::vector<std::u16string_view> texts;
+    const size_t count = std::min(phrases.size(), request.languages.size());
+    for (size_t i = 0; i < count; ++i) {
+      const std::optional<std::u16string>& phrase = phrases[i];
+      // Languages that write the phrase the same way share one row, labelled
+      // with the first of them.
+      if (!phrase || phrase->empty() ||
+          std::ranges::contains(texts, std::u16string_view(*phrase))) {
+        continue;
+      }
+      texts.push_back(*phrase);
+      const tark_xlit::Language& language = *request.languages[i];
+
+      SearchSuggestionParser::SuggestResult suggestion(
+          /*suggestion=*/*phrase, AutocompleteMatchType::SEARCH_SUGGEST,
+          /*suggest_type=*/omnibox::TYPE_NATIVE_CHROME, /*subtypes=*/{},
+          /*match_contents=*/*phrase,
+          /*match_contents_prefix=*/std::u16string(),
+          /*annotation=*/std::u16string(language.native_name),
+          /*deletion_url=*/std::string(),
+          /*from_keyword=*/request.keyword_mode,
+          /*navigational_intent=*/omnibox::NAV_INTENT_NONE, relevance--,
+          /*relevance_from_server=*/false, /*should_prefetch=*/false,
+          /*should_prerender=*/false, /*input_text=*/request.text);
+      // The annotation becomes the description, dimmed
+      // (SuggestResult::ClassifyAnnotation()).
+      AutocompleteMatch match = BaseSearchProvider::CreateSearchSuggestion(
+          this, request.input, /*in_keyword_mode=*/request.keyword_mode,
+          suggestion, engine, template_url_service->search_terms_data(),
+          TemplateURLRef::NO_SUGGESTION_CHOSEN,
+          /*append_extra_query_params_from_command_line=*/
+          !request.keyword_mode);
+      // Enter searches what was typed; a row is chosen only by arrowing to it.
+      match.allowed_to_be_default_match = false;
+      match.inline_autocompletion.clear();
+      match.RecordAdditionalInfo(kLanguageInfoKey, std::string(language.tag));
+      matches_.push_back(std::move(match));
+    }
+  }
+
+  matches_key_ = std::move(request.key);
+  done_ = true;
+  NotifyListeners(/*updated_matches=*/true);
+}
