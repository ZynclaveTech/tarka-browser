+#include "components/omnibox/browser/autocomplete_provider.h"
+#include "components/search_engines/template_url_starter_pack_data.h"
+
+class AutocompleteInput;
+class AutocompleteProviderClient;
+class AutocompleteProviderListener;
+
+// Offers up to three rows that write a Latin-letter query in Indian scripts,
+// e.g. "namaste" -> "नमस्ते", one row per language in the user's
+// accept-languages (components/tark_xlit chooses them; Hindi when there are
+// none). The rows are worked out on the device: nothing is fetched.
+//
+// The provider reuses AutocompleteProvider::TYPE_QUERY_TILE (unused on
+// desktop) and AutocompleteMatchType::SEARCH_SUGGEST, so that no enum, proto
+// or histogram gains a value. Its rows are never the default match: Enter
+// still searches what was typed.
+//
+// Threading: Start() works out the languages and the search engine on the UI
+// sequence and posts the text to this provider's worker. All workers run on
+// one process-wide sequence that also owns the model and word lists, loaded
+// once on first use (or on the first letter typed) and shared read-only; each
+// worker keeps its own Transliterator and so its own cache (private profiles
+// included), released after five idle minutes, the shared model likewise.
+// Every Start() and Stop() supersedes the request in flight; a superseded
+// request stops before its next language and its reply is dropped.
+class TarkTransliterationProvider : public AutocompleteProvider {
+ public:
+  TarkTransliterationProvider(AutocompleteProviderClient* client,
+                              AutocompleteProviderListener* listener);
+  TarkTransliterationProvider(const TarkTransliterationProvider&) = delete;
+  TarkTransliterationProvider& operator=(const TarkTransliterationProvider&) =
+      delete;
+
+  // Whether rows are offered under the starter-pack keyword `id`: only the
+  // web sources (@wiki ... @amazon), never @bookmarks, @history or @tabs.
+  static bool RunsInStarterPackScope(
+      template_url_starter_pack_data::StarterPackId id);
+
+  // AutocompleteProvider:
+  void Start(const AutocompleteInput& input, bool minimal_changes) override;
+  void Stop(AutocompleteStopReason stop_reason) override;
+
+ private:
+  class Worker;
+  struct Request;
+
+  // The id of the newest request, read by the worker to skip superseded work.
+  using LatestRequestId = base::RefCountedData<std::atomic<uint64_t>>;
+
+  ~TarkTransliterationProvider() override;
+
+  // The request for `input`, or nullopt when it gets no rows.
+  std::optional<Request> MakeRequest(const AutocompleteInput& input) const;
+
+  // Creates `worker_` on the shared worker sequence if there is none yet.
+  void EnsureWorker();
+
+  // The worker's reply: one entry per language of `request`, nullopt where
+  // nothing changed.
+  void OnPhrases(uint64_t request_id,
+                 Request request,
+                 std::vector<std::optional<std::u16string>> phrases);
+
+  raw_ptr<AutocompleteProviderClient> client_;
+
+  // Created on the first request (or warm-up), so a controller that never runs
+  // the provider (the classifier's) costs nothing.
+  base::SequenceBound<Worker> worker_;
+
+  scoped_refptr<LatestRequestId> latest_request_id_;
+  uint64_t request_id_ = 0;
+
+  // Everything `matches_` depends on (text, engine, keyword mode, languages)
+  // for the last request that completed; empty after `matches_` is cleared.
+  // Lets Start() keep the rows when nothing they depend on changed (a modifier
+  // key, the end of an IME composition).
+  std::u16string matches_key_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  base::WeakPtrFactory<TarkTransliterationProvider> weak_ptr_factory_{this};
+};
+
+#endif  // COMPONENTS_OMNIBOX_BROWSER_TARK_TRANSLITERATION_PROVIDER_H_
