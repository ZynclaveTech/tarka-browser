+#include "components/tark_xlit/languages.h"
+#include "components/tark_xlit/model.h"
+#include "components/tark_xlit/word_list.h"
+
+namespace tark_xlit {
+
+namespace {
+
+// The cache is emptied when it would otherwise grow past this many words.
+constexpr size_t kMaxCacheEntries = 5000;
+
+// Model::Transliterate takes words of at most this many letters.
+constexpr size_t kMaxWordLetters = 32;
+
+constexpr char16_t kZeroWidthNonJoiner = u'\u200c';
+
+constexpr std::string_view kMarathiTag = "mr";
+constexpr std::string_view kModelFileName = "xlit-model.bin";
+constexpr std::string_view kWordsFileName = "xlit-words.bin";
+constexpr std::string_view kBundleDirectoryName = "indicxlit";
+
+// The model's vocabulary has these tokens, and a candidate that spells one out
+// is not a word.
+constexpr std::array<std::u16string_view, 4> kSpecialSymbols = {
+    u"<unk>", u"<s>", u"</s>", u"<pad>"};
+
+// Marathi's अॅ (a, candra e) as the model writes it, and the single letter ॲ
+// (candra a) that the word lists, built from a corpus, use for it.
+constexpr std::u16string_view kMarathiAndCandraE = u"अॅ";
+constexpr std::u16string_view kMarathiCandraA = u"ॲ";
+
+bool IsAsciiLetter(char16_t c) {
+  return (c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z');
+}
+
+char ToLowerAscii(char16_t c) {
+  return static_cast<char>(c >= u'A' && c <= u'Z' ? c - u'A' + u'a' : c);
+}
+
+bool IsSpecialSymbol(std::u16string_view text) {
+  return std::ranges::any_of(kSpecialSymbols, [text](std::u16string_view s) {
+    return text.find(s) != std::u16string_view::npos;
+  });
+}
+
+void NormaliseMarathi(std::u16string& text) {
+  for (size_t pos = text.find(kMarathiAndCandraE);
+       pos != std::u16string::npos;
+       pos = text.find(kMarathiAndCandraE, pos + kMarathiCandraA.size())) {
+    text.replace(pos, kMarathiAndCandraE.size(), kMarathiCandraA);
+  }
+}
+
+}  // namespace
+
+Resources::Resources(std::unique_ptr<const Model> model,
+                     std::unique_ptr<const WordList> words)
+    : model(std::move(model)), words(std::move(words)) {
+  CHECK(this->model);
+}
+
+Resources::~Resources() = default;
+
+Transliterator::Transliterator(scoped_refptr<const Resources> resources)
+    : resources_(std::move(resources)) {
+  CHECK(resources_);
+  words_ = resources_->words.get();
+  // `resources_` keeps the model alive for as long as this instance.
+  word_function_ = base::BindRepeating(
+      &Model::Transliterate, base::Unretained(resources_->model.get()));
+}
+
+Transliterator::Transliterator(std::unique_ptr<Model> model,
+                               std::unique_ptr<WordList> words)
+    : Transliterator(base::MakeRefCounted<Resources>(std::move(model),
+                                                     std::move(words))) {}
+
+Transliterator::Transliterator(WordFunction word_function,
+                               std::unique_ptr<WordList> words)
+    : own_words_(std::move(words)),
+      words_(own_words_.get()),
+      word_function_(std::move(word_function)) {
+  CHECK(word_function_);
+}
+
+Transliterator::~Transliterator() = default;
+
+std::optional<std::u16string> Transliterator::Phrase(std::u16string_view input,
+                                                     std::string_view tag) {
+  if (!LooksTransliterable(input)) {
+    return std::nullopt;
+  }
+
+  std::u16string out;
+  out.reserve(input.size());
+  size_t pos = 0;
+  while (pos < input.size()) {
+    if (!IsAsciiLetter(input[pos])) {
+      out.push_back(input[pos]);
+      ++pos;
+      continue;
+    }
+
+    // A run of Latin letters: one word.
+    std::string word;
+    size_t end = pos;
+    while (end < input.size() && IsAsciiLetter(input[end])) {
+      word.push_back(ToLowerAscii(input[end]));
+      ++end;
+    }
+    const std::u16string_view typed = input.substr(pos, end - pos);
+    pos = end;
+
+    // Too long for the model: leave it, and keep it out of the cache.
+    if (typed.size() > kMaxWordLetters) {
+      out += typed;
+      continue;
+    }
+    if (words_ && words_->IsCommonEnglish(word)) {
+      out += typed;
+      continue;
+    }
+    const std::u16string text = Word(word, tag);
+    if (text.empty()) {
+      out += typed;
+    } else {
+      out += text;
+    }
+  }
+
+  if (out == input) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+std::u16string Transliterator::Word(std::string_view word,
+                                    std::string_view tag) {
+  std::string key;
+  key.reserve(tag.size() + 1 + word.size());
+  key.append(tag);
+  key.push_back(' ');
+  key.append(word);
+
+  const auto it = cache_.find(key);
+  if (it != cache_.end()) {
+    return it->second;
+  }
+  std::u16string text = ComputeWord(word, tag);
+  if (cache_.size() >= kMaxCacheEntries) {
+    cache_.clear();
+  }
+  cache_.emplace(std::move(key), text);
+  return text;
+}
+
+std::u16string Transliterator::ComputeWord(std::string_view word,
+                                           std::string_view tag) const {
+  std::vector<Candidate> candidates = word_function_.Run(word, tag);
+  // The model's output has no ZWNJ (a word-final virama + ZWNJ, say, must
+  // never reach the row), so strip any that appears; a candidate left empty is
+  // dropped with the special symbols.
+  for (Candidate& candidate : candidates) {
+    std::erase(candidate.text, kZeroWidthNonJoiner);
+  }
+  std::erase_if(candidates, [](const Candidate& candidate) {
+    return candidate.text.empty() || IsSpecialSymbol(candidate.text);
+  });
+  if (tag == kMarathiTag) {
+    // Before rescoring, so that the list lookups see the corpus's spelling.
+    for (Candidate& candidate : candidates) {
+      NormaliseMarathi(candidate.text);
+    }
+  }
+  candidates = Rescore(std::move(candidates), words_.get(), tag);
+  if (candidates.empty()) {
+    return std::u16string();
+  }
+  return std::move(candidates.front().text);
+}
+
+scoped_refptr<Resources> LoadResourcesFromDirectory(
+    const base::FilePath& directory) {
+  // The model is converted into memory by Load(), so its file is not needed
+  // afterwards.
+  std::unique_ptr<Model> model;
+  {
+    base::MemoryMappedFile model_file;
+    if (!model_file.Initialize(directory.AppendASCII(kModelFileName))) {
+      return nullptr;
+    }
+    model = Model::Load(model_file.bytes());
+  }
+  if (!model) {
+    return nullptr;
+  }
+
+  // The word lists are read in place, and stay mapped.
+  auto words_file = std::make_unique<base::MemoryMappedFile>();
+  if (!words_file->Initialize(directory.AppendASCII(kWordsFileName))) {
+    return nullptr;
+  }
+  std::unique_ptr<WordList> words = WordList::Load(std::move(words_file));
+  if (!words) {
+    return nullptr;
+  }
+  return base::MakeRefCounted<Resources>(std::move(model), std::move(words));
+}
+
+scoped_refptr<Resources> LoadResourcesFromBundle() {
+  base::FilePath assets;
+  if (!base::PathService::Get(base::DIR_ASSETS, &assets)) {
+    return nullptr;
+  }
+  return LoadResourcesFromDirectory(assets.AppendASCII(kBundleDirectoryName));
+}
+
+std::unique_ptr<Transliterator> LoadFromDirectory(
+    const base::FilePath& directory) {
+  scoped_refptr<Resources> resources = LoadResourcesFromDirectory(directory);
+  if (!resources) {
+    return nullptr;
+  }
+  return std::make_unique<Transliterator>(std::move(resources));
+}
+
+std::unique_ptr<Transliterator> LoadFromBundle() {
+  scoped_refptr<Resources> resources = LoadResourcesFromBundle();
+  if (!resources) {
+    return nullptr;
+  }
+  return std::make_unique<Transliterator>(std::move(resources));
+}
+
+}  // namespace tark_xlit
