+std::vector<std::string> Tags(const std::vector<const Language*>& languages) {
+  std::vector<std::string> tags;
+  for (const Language* language : languages) {
+    tags.emplace_back(language->tag);
+  }
+  return tags;
+}
+
+}  // namespace
+
+TEST(TarkXlitLanguagesTest, TableHasTwentyDistinctLanguages) {
+  base::span<const Language> all = AllLanguages();
+  ASSERT_EQ(20u, all.size());
+  for (size_t i = 0; i < all.size(); ++i) {
+    EXPECT_FALSE(all[i].accept_code.empty());
+    EXPECT_FALSE(all[i].tag.empty());
+    EXPECT_FALSE(all[i].native_name.empty());
+    EXPECT_NE(Script::kLatin, all[i].script);
+    EXPECT_NE(Script::kOther, all[i].script);
+    for (size_t j = i + 1; j < all.size(); ++j) {
+      EXPECT_NE(all[i].accept_code, all[j].accept_code);
+      EXPECT_NE(all[i].tag, all[j].tag);
+    }
+  }
+}
+
+TEST(TarkXlitLanguagesTest, NativeNamesAreInTheirOwnScript) {
+  for (const Language& language : AllLanguages()) {
+    // The own-language name of every language is written in that language's
+    // script (Meitei in Meetei Mayek, Urdu, Sindhi and Kashmiri in Arabic).
+    EXPECT_EQ(language.script, DominantScript(language.native_name))
+        << language.tag;
+  }
+}
+
+TEST(TarkXlitLanguagesTest, DominantScript) {
+  EXPECT_EQ(Script::kLatin, DominantScript(u"namaste"));
+  EXPECT_EQ(Script::kDevanagari, DominantScript(u"नमस्ते"));
+  EXPECT_EQ(Script::kBengali, DominantScript(u"বাংলা"));
+  EXPECT_EQ(Script::kGurmukhi, DominantScript(u"ਪੰਜਾਬੀ"));
+  EXPECT_EQ(Script::kGujarati, DominantScript(u"ગુજરાતી"));
+  EXPECT_EQ(Script::kOdia, DominantScript(u"ଓଡ଼ିଆ"));
+  EXPECT_EQ(Script::kTamil, DominantScript(u"தமிழ்"));
+  EXPECT_EQ(Script::kTelugu, DominantScript(u"తెలుగు"));
+  EXPECT_EQ(Script::kKannada, DominantScript(u"ಕನ್ನಡ"));
+  EXPECT_EQ(Script::kMalayalam, DominantScript(u"മലയാളം"));
+  EXPECT_EQ(Script::kArabic, DominantScript(u"اردو"));
+  EXPECT_EQ(Script::kMeeteiMayek, DominantScript(u"ꯃꯤꯇꯩꯂꯣꯟ"));
+}
+
+TEST(TarkXlitLanguagesTest, DominantScriptWithoutLetters) {
+  EXPECT_EQ(Script::kOther, DominantScript(u""));
+  EXPECT_EQ(Script::kOther, DominantScript(u"   "));
+  EXPECT_EQ(Script::kOther, DominantScript(u"2024-10-18 !?"));
+  // Devanagari digits and the danda are not letters.
+  EXPECT_EQ(Script::kOther, DominantScript(u"१२३ ।"));
+}
+
+TEST(TarkXlitLanguagesTest, DominantScriptCountsMostLetters) {
+  EXPECT_EQ(Script::kDevanagari, DominantScript(u"a ताज महल"));
+  EXPECT_EQ(Script::kLatin, DominantScript(u"taj mahal ताज"));
+  // Digits and punctuation do not vote.
+  EXPECT_EQ(Script::kTamil, DominantScript(u"2024 தாஜ் - a"));
+}
