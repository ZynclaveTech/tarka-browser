+
+TEST(TarkXlitTransliteratorTest, CacheKeysOnTagAndLowerCaseWord) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), nullptr);
+  EXPECT_EQ(Convert(&transliterator, u"namaste", "hi"), "বnamaste");
+  EXPECT_EQ(Convert(&transliterator, u"Namaste", "hi"), "বnamaste");
+  EXPECT_EQ(Convert(&transliterator, u"namaste ji namaste", "hi"),
+            "বnamaste বji বnamaste");
+  EXPECT_EQ(fake.calls,
+            (std::vector<std::string>{"hi namaste", "hi ji"}));
+
+  // Another language is another entry.
+  EXPECT_EQ(Convert(&transliterator, u"namaste", "ta"), "বnamaste");
+  EXPECT_EQ(fake.calls.size(), 3u);
+  EXPECT_EQ(fake.calls.back(), "ta namaste");
+}
+
+TEST(TarkXlitTransliteratorTest, CacheRemembersWordsTheModelCannotDo) {
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view, std::string_view) {
+        return std::vector<Candidate>();
+      });
+  Transliterator transliterator(fake.Callback(), nullptr);
+  EXPECT_EQ(Convert(&transliterator, u"zzkx", "hi"), kNothing);
+  EXPECT_EQ(Convert(&transliterator, u"zzkx", "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), 1u);
+}
+
+TEST(TarkXlitTransliteratorTest, CacheIsEmptiedWhenItHolds5000Words) {
+  constexpr size_t kLimit = 5000;
+  // Distinct three-letter words: aaa, aab, ..., in base 26.
+  const auto word = [](size_t i) {
+    std::u16string out(3, u'a');
+    out[0] = static_cast<char16_t>(u'a' + (i / 676) % 26);
+    out[1] = static_cast<char16_t>(u'a' + (i / 26) % 26);
+    out[2] = static_cast<char16_t>(u'a' + i % 26);
+    return out;
+  };
+
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), nullptr);
+  for (size_t i = 0; i < kLimit; ++i) {
+    ASSERT_NE(Convert(&transliterator, word(i), "hi"), kNothing);
+  }
+  ASSERT_EQ(fake.calls.size(), kLimit);
+
+  // The 5,000 words so far are all remembered.
+  EXPECT_NE(Convert(&transliterator, word(0), "hi"), kNothing);
+  EXPECT_NE(Convert(&transliterator, word(kLimit - 1), "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), kLimit);
+
+  // One more fills the cache past its limit: it is emptied and holds only the
+  // new word.
+  EXPECT_NE(Convert(&transliterator, word(kLimit), "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), kLimit + 1);
+  EXPECT_NE(Convert(&transliterator, word(kLimit), "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), kLimit + 1);
+  EXPECT_NE(Convert(&transliterator, word(0), "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), kLimit + 2);
+}
