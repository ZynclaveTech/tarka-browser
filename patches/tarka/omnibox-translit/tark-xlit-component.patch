+TEST(TarkXlitTransliteratorTest, LoadFromDirectoryNeedsBothFiles) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath model = TestDataDir().AppendASCII("xlit-model.bin");
+  const base::FilePath words = TestDataDir().AppendASCII("xlit-words.bin");
+  const base::FilePath garbage = temp.GetPath().AppendASCII("garbage.bin");
+  ASSERT_TRUE(base::WriteFile(garbage, std::string("not a blob at all")));
+
+  // No directory, an empty one.
+  EXPECT_FALSE(LoadFromDirectory(temp.GetPath().AppendASCII("missing")));
+  EXPECT_FALSE(LoadFromDirectory(temp.GetPath()));
+
+  // Only one of the two files.
+  EXPECT_FALSE(LoadFromDirectory(MakeDirectory(temp, "only-model", model, {})));
+  EXPECT_FALSE(LoadFromDirectory(MakeDirectory(temp, "only-words", {}, words)));
+
+  // Both, but one of them is not what it should be.
+  EXPECT_FALSE(
+      LoadFromDirectory(MakeDirectory(temp, "bad-model", garbage, words)));
+  EXPECT_FALSE(
+      LoadFromDirectory(MakeDirectory(temp, "bad-words", model, garbage)));
+  EXPECT_TRUE(LoadFromDirectory(MakeDirectory(temp, "good", model, words)));
+}
