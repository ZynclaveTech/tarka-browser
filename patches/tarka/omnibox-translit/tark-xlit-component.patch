+TEST(TarkXlitTransliteratorTest, NoZeroWidthNonJoinerInAnyLanguage) {
+  Transliterator* transliterator = RealTransliterator();
+  ASSERT_TRUE(transliterator);
+  for (const Language& language : AllLanguages()) {
+    for (std::u16string_view word :
+         {u"namaste", u"kitab", u"krishna", u"school"}) {
+      const std::string result = Convert(transliterator, word, language.tag);
+      EXPECT_EQ(base::UTF8ToUTF16(result).find(u'\u200c'),
