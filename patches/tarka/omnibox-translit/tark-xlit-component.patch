+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// How long Transliterator::Phrase() takes for one uncached word, which is the
+// cost of the first keystrokes of a new word in the address bar. For each of
+// three languages it times 200 different words and prints the median and the
+// 95th percentile; the address bar's budget is 50 ms at the 95th percentile.
+//
+//   tark_xlit_bench [directory-with-xlit-model.bin-and-xlit-words.bin]
+//
+// The directory defaults to components/tark_xlit/test/data in the source tree.
+// The exit code is 1 when a 95th percentile is over the budget, 2 when the
+// data cannot be loaded.
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/base_paths.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "components/tark_xlit/transliterator.h"
+
+namespace {
+
+constexpr double kBudgetMs = 50;
+constexpr size_t kWordsPerLanguage = 200;
+constexpr std::array<std::string_view, 3> kTags = {"hi", "ta", "bn"};
+
+// Names and words typed in Latin letters for Indian languages. None is an
+// English word, which Phrase() would pass over without asking the model.
+constexpr std::array<std::string_view, 48> kBaseWords = {
+    "namaste", "vanakkam", "namaskar", "pranam", "shukriya", "dhanyavad",
+    "swagat", "salaam", "nandri", "ramesh", "sooraj", "priya", "mohan",
+    "krishna", "lakshmi", "arjun", "gopal", "rahul", "deepika", "suresh",
+    "kavita", "dilli", "mumbai", "nagpur", "kolkata", "bengaluru",
+    "hyderabad", "jaipur", "varanasi", "kerala", "punjab", "bharat",
+    "himalaya", "ganga", "kitab", "pani", "ghar", "doston", "samay", "pyar",
+    "zindagi", "mausam", "darwaza", "khana", "mandir", "shanti", "vidyalaya",
+    "lakshan"};
+
+// Endings that make more words out of the base words.
+constexpr std::array<std::string_view, 6> kEndings = {"",     "a",   "ji",
+                                                      "wala", "pur", "ke"};
+
+// The first 200 different words made of a base word and an ending, taking the
+// endings in order: every base word as it is, then with "a", and so on.
+std::vector<std::string> Words() {
+  std::vector<std::string> words;
+  std::set<std::string> seen;
+  for (std::string_view ending : kEndings) {
+    for (std::string_view base : kBaseWords) {
+      std::string word = std::string(base) + std::string(ending);
+      if (words.size() < kWordsPerLanguage && seen.insert(word).second) {
+        words.push_back(std::move(word));
+      }
+    }
+  }
+  return words;
+}
+
+// The value below which `fraction` of the sorted `times` lie.
+double Percentile(const std::vector<double>& sorted, double fraction) {
+  const size_t rank = static_cast<size_t>(
+      std::ceil(fraction * static_cast<double>(sorted.size())));
+  return sorted[std::clamp<size_t>(rank, 1, sorted.size()) - 1];
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::CommandLine::Init(argc, argv);
+  const base::CommandLine::StringVector args =
+      base::CommandLine::ForCurrentProcess()->GetArgs();
+
+  base::FilePath directory;
+  if (!args.empty()) {
+    directory = base::FilePath(args[0]);
+  } else if (base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT,
+                                    &directory)) {
+    directory = directory.AppendASCII("components/tark_xlit/test/data");
+  } else {
+    std::printf("usage: tark_xlit_bench <directory with the xlit files>\n");
+    return 2;
+  }
+
+  const base::TimeTicks load_start = base::TimeTicks::Now();
+  std::unique_ptr<tark_xlit::Transliterator> transliterator =
+      tark_xlit::LoadFromDirectory(directory);
+  if (!transliterator) {
+    std::printf("cannot load xlit-model.bin and xlit-words.bin from %s\n",
+                directory.value().c_str());
+    return 2;
+  }
+  std::printf("load: %.0f ms\n",
+              (base::TimeTicks::Now() - load_start).InMillisecondsF());
+
+  // The first word goes through cold code and caches; it is not timed.
+  transliterator->Phrase(u"warmup", "hi");
+
+  const std::vector<std::string> words = Words();
+  int exit_code = 0;
+  for (std::string_view tag : kTags) {
+    // The cache is keyed on the language as well as the word, so no word here
+    // has been asked for before.
+    std::vector<double> times;
+    size_t unchanged = 0;
+    for (const std::string& word : words) {
+      const std::u16string input = base::UTF8ToUTF16(word);
+      const base::TimeTicks start = base::TimeTicks::Now();
+      const std::optional<std::u16string> result =
+          transliterator->Phrase(input, tag);
+      times.push_back((base::TimeTicks::Now() - start).InMillisecondsF());
+      if (!result) {
+        ++unchanged;
+      }
+    }
+    std::ranges::sort(times);
+    const double p95 = Percentile(times, 0.95);
+    std::printf("%s: n=%zu p50=%.2f ms p95=%.2f ms max=%.2f ms%s\n",
+                std::string(tag).c_str(), times.size(), Percentile(times, 0.5),
+                p95, times.back(), p95 > kBudgetMs ? "  OVER BUDGET" : "");
+    if (unchanged > 0) {
+      // The timings above include words the model never saw.
+      std::printf("%s: %zu words came back unchanged\n",
+                  std::string(tag).c_str(), unchanged);
+      exit_code = std::max(exit_code, 2);
+    }
+    if (p95 > kBudgetMs) {
+      exit_code = std::max(exit_code, 1);
+    }
+  }
+  std::printf("budget: p95 <= %.0f ms\n", kBudgetMs);
+  return exit_code;
+}
