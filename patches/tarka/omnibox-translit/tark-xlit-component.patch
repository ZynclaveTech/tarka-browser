+namespace tark_xlit {
+
+namespace internal {
+struct ModelData;
+}  // namespace internal
+
+// One spelling of a Latin word in an Indian script.
+struct Candidate {
+  std::u16string text;
+  // The model's confidence, exp(the mean log-probability of the output tokens
+  // counting the closing </s>), in (0, 1]. This is the T of IndicXlit's
+  // dictionary rescoring.
+  double score = 0;
+};
+
+// AI4Bharat's IndicXlit (a fairseq transformer, 6+6 layers, d=256) running on
+// the CPU, with fairseq's beam search. The weights come from a TXLM v1 blob
+// (utils/xlit_convert.py) and are held as float32. utils/xlit_reference.py is
+// the specification this class follows; components/tark_xlit/test/data/
+// golden.tsv is that reference's output, which the tests check.
+class Model {
+ public:
+  // Reads a TXLM v1 blob. nullptr on a wrong magic or version, a malformed
+  // header, an architecture this class does not implement, a missing tensor or
+  // one of the wrong shape, a tensor that runs past the end, or an infinite
+  // or NaN weight. Does not keep a reference to `txlm`.
+  static std::unique_ptr<Model> Load(base::span<const uint8_t> txlm);
+
+  Model(const Model&) = delete;
+  Model& operator=(const Model&) = delete;
+  ~Model();
+
+  // Up to four spellings of `word` in the language `tag` (an IndicXlit tag
+  // such as "hi" or "gom"), best first, in the model's order (before any
+  // dictionary rescoring). `word` must be 1 to 32 letters a-z; anything else,
+  // or a tag the model does not write, gives an empty result. Thread-safe:
+  // the model is not modified.
+  std::vector<Candidate> Transliterate(std::string_view word,
+                                       std::string_view tag) const;
+
+ private:
+  explicit Model(std::unique_ptr<const internal::ModelData> data);
+
+  std::unique_ptr<const internal::ModelData> data_;
+};
+
+}  // namespace tark_xlit
+
+#endif  // COMPONENTS_TARK_XLIT_MODEL_H_
