+#ifndef COMPONENTS_TARK_XLIT_WORD_LIST_H_
+#define COMPONENTS_TARK_XLIT_WORD_LIST_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/heap_array.h"
+#include "base/containers/span.h"
+#include "base/memory/raw_span.h"
+#include "components/tark_xlit/model.h"
+
+namespace base {
+class MemoryMappedFile;
+}  // namespace base
+
+namespace tark_xlit {
+
+// Word-frequency lists, one per language, and the list of common English words
+// that stay in Latin letters; the TXLW v1 file that utils/xlit_wordlist.py
+// packs. Lookups binary-search the file's sorted records.
+//
+// Loading checks the header and that each language's record-offset table lies
+// in the file, but not the records themselves (walking them would read all of
+// a 36 MB mapping). A malformed record makes a lookup that meets it report
+// "not found"; it never crashes.
+class WordList {
+ public:
+  // Reads a TXLW v1 blob, copying it (for tests and small lists). nullptr on
+  // a wrong magic or version, a malformed header, or a record-offset table
+  // that runs past the end.
+  static std::unique_ptr<WordList> Load(base::span<const uint8_t> txlw);
+
+  // As above, but reads the blob in place from `file`, which the list keeps
+  // mapped for its lifetime. nullptr also when `file` is null or not valid.
+  static std::unique_ptr<WordList> Load(
+      std::unique_ptr<base::MemoryMappedFile> file);
+
+  WordList(const WordList&) = delete;
+  WordList& operator=(const WordList&) = delete;
+  ~WordList();
+
+  // How often `word` occurs in the corpus of the language `tag`; nullopt when
+  // the word is not in that language's list or there is no list for `tag`.
+  std::optional<uint32_t> Count(std::string_view tag,
+                                std::u16string_view word) const;
+
+  // Whether there is a list for the language `tag`.
+  bool HasLanguage(std::string_view tag) const;
+
+  // Whether `word` (lower-case a-z) is on the common-English list.
+  bool IsCommonEnglish(std::string_view word) const;
+
+ private:
+  struct Block {
+    // Absolute file offset of the record-offset table.
+    size_t offset = 0;
+    size_t count = 0;
+  };
+  struct Record {
+    uint32_t count = 0;
+    std::string_view word;
+  };
+
+  using Blocks = std::map<std::string, Block, std::less<>>;
+
+  // Exactly one of `copy` and `file` holds the blob.
+  WordList(base::HeapArray<uint8_t> copy,
+           std::unique_ptr<base::MemoryMappedFile> file,
+           Blocks blocks);
+
+  // The header's blocks, each checked to start after the header and to have
+  // its record-offset table inside `txlw`; nullopt when the blob is not a
+  // usable TXLW v1 file.
+  static std::optional<Blocks> ParseBlocks(base::span<const uint8_t> txlw);
+
+  // The `index`th record of `block` (index < block.count), or nullopt when
+  // that record does not lie inside the blob.
+  std::optional<Record> RecordAt(const Block& block, size_t index) const;
+  std::optional<uint32_t> Find(std::string_view tag,
+                               std::string_view utf8) const;
+
+  base::HeapArray<uint8_t> copy_;
+  std::unique_ptr<base::MemoryMappedFile> file_;
+  Blocks blocks_;
+  // The blob, in `copy_` or `file_`. Declared last so that it is destroyed
+  // before what it points into.
+  base::raw_span<const uint8_t> data_;
+};
+
+// IndicXlit's dictionary rescoring with alpha = 0.9. For each candidate that
+// is in the list for `tag`, F = 0.9 * T / sum(T) + 0.1 * P / sum(P), where T
+// is the model score and P the list count, the sums taken over the candidates
+// (sum(P) over those in the list); F = 0 for the others. Returns the
+// candidates sorted by F, highest first, the sort stable so ties keep the
+// model's order. The scores stay the model's. `candidates` comes back
+// unchanged when `list` is null or has no list for `tag`.
+std::vector<Candidate> Rescore(std::vector<Candidate> candidates,
+                               const WordList* list,
+                               std::string_view tag);
+
+}  // namespace tark_xlit
+
+#endif  // COMPONENTS_TARK_XLIT_WORD_LIST_H_
