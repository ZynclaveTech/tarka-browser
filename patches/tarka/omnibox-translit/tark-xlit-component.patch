+namespace tark_xlit {
+
+namespace internal {
+
+// Where a tensor lives in ModelData::weights, in floats.
+struct Tensor {
+  size_t offset = 0;
+  size_t size = 0;
+};
+
+struct Norm {
+  Tensor weight;
+  Tensor bias;
+};
+
+// y = x W^T + b, W being `out` x `in` (torch's nn.Linear layout).
+struct Linear {
+  Tensor weight;
+  Tensor bias;
+  size_t out = 0;
+  size_t in = 0;
+};
+
+struct EncoderLayer {
+  Norm self_attention_norm;
+  Linear query, key, value, attention_out;
+  Norm ffn_norm;
+  Linear fc1, fc2;
+};
+
+struct DecoderLayer {
+  Norm self_attention_norm;
+  Linear query, key, value, attention_out;
+  Norm cross_attention_norm;
+  Linear cross_query, cross_key, cross_value, cross_attention_out;
+  Norm ffn_norm;
+  Linear fc1, fc2;
+};
+
+struct ModelData {
+  size_t dim = 0;
+  size_t heads = 0;
+  size_t head_dim = 0;
+  float embed_scale = 0;  // sqrt(dim)
+  float query_scale = 0;  // 1 / sqrt(head_dim)
+
+  size_t pad = 1;
+  size_t eos = 2;
+  size_t unk = 3;
+  // Source token of each letter a-z.
+  std::array<size_t, 26> letter_ids;
+  // Source token of each language tag: "hi" for "__hi__".
+  std::map<std::string, size_t, std::less<>> tag_ids;
+  std::vector<std::u16string> target_vocab;
+
+  Tensor encoder_embed;
+  Norm encoder_embed_norm;
+  std::vector<EncoderLayer> encoder_layers;
+  Norm encoder_final_norm;
+  Tensor decoder_embed;
+  Norm decoder_embed_norm;
+  std::vector<DecoderLayer> decoder_layers;
+  Norm decoder_final_norm;
+  Tensor output_projection;
+
+  // Every tensor, float32.
+  base::HeapArray<float> weights;
+  // fairseq's sinusoidal position table, kMaxPositions x dim.
+  base::HeapArray<float> positions;
+
+  base::span<const float> Get(const Tensor& tensor) const {
+    return weights.subspan(tensor.offset, tensor.size);
+  }
+  base::span<const float> Position(size_t index) const {
+    return positions.subspan(index * dim, dim);
+  }
+};
+
+}  // namespace internal
+
+namespace {
+
+using internal::DecoderLayer;
+using internal::EncoderLayer;
+using internal::Linear;
+using internal::ModelData;
+using internal::Norm;
+using internal::Tensor;
+
+constexpr std::array<uint8_t, 8> kMagic = {'T', 'X', 'L', 'M', 1, 0, 0, 0};
+
+// fairseq SequenceGenerator as ai4bharat-transliteration 1.1.3 runs it (see
+// utils/xlit_reference.py): beam 4, four results, max_len_a 0, max_len_b 200,
+// min_len 1, length penalty 1, unknown-word penalty 0, normalised scores.
+constexpr size_t kBeam = 4;
+constexpr size_t kMaxLength = 200;
+constexpr size_t kMinLength = 1;
+
+constexpr size_t kMaxWordLetters = 32;
+// The first token is at position 2 (the padding index plus one).
+constexpr size_t kFirstPosition = 2;
+constexpr size_t kMaxPositions = 256;
+// The tag, the letters and </s> on the encoder side; </s> plus up to
+// kMaxLength tokens on the decoder side.
+static_assert(kFirstPosition + kMaxWordLetters + 2 <= kMaxPositions);
+static_assert(kFirstPosition + kMaxLength < kMaxPositions);
+
+constexpr float kLayerNormEpsilon = 1e-5f;
+constexpr float kNegativeInfinity = -std::numeric_limits<float>::infinity();
+
+// Bounds on the header's sizes, so that no product of them overflows.
+constexpr size_t kMaxDim = 4096;
+constexpr size_t kMaxLayers = 64;
+constexpr size_t kMaxVocab = 1 << 16;
+
+// IEEE half to single precision, exactly (every half is a float). Infinities
+// and NaNs (exponent 0x1F) are not weights: nullopt.
+std::optional<float> HalfToFloat(uint16_t half) {
+  const uint32_t sign = static_cast<uint32_t>(half & 0x8000u) << 16;
+  uint32_t exponent = (half >> 10) & 0x1Fu;
+  uint32_t mantissa = half & 0x3FFu;
+  uint32_t bits;
+  if (exponent == 0) {
+    if (mantissa == 0) {
+      bits = sign;
+    } else {
+      // A subnormal half is a normal float: shift the mantissa up to its
+      // implicit leading one.
+      exponent = 127 - 15 + 1;
+      while ((mantissa & 0x400u) == 0) {
+        mantissa <<= 1;
+        --exponent;
+      }
+      mantissa &= 0x3FFu;
+      bits = sign | (exponent << 23) | (mantissa << 13);
+    }
+  } else if (exponent == 0x1F) {
+    return std::nullopt;
+  } else {
+    bits = sign | ((exponent + 127 - 15) << 23) | (mantissa << 13);
+  }
+  return std::bit_cast<float>(bits);
+}
+
+std::optional<size_t> ReadSize(const base::DictValue& dict,
+                               std::string_view key) {
+  const std::optional<int> value = dict.FindInt(key);
+  if (!value || *value < 0) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(*value);
+}
+
+// Whether the optional flag `key` is absent or has the value this class
+// implements.
+bool FlagIs(const base::DictValue& config, std::string_view key, bool value) {
+  return config.FindBool(key).value_or(value) == value;
+}
+
+std::optional<std::vector<std::string>> ReadStrings(const base::ListValue* list,
+                                                    size_t max_size) {
+  if (!list || list->empty() || list->size() > max_size) {
+    return std::nullopt;
+  }
+  std::vector<std::string> out;
+  for (const base::Value& value : *list) {
+    const std::string* text = value.GetIfString();
+    if (!text) {
+      return std::nullopt;
+    }
+    out.push_back(*text);
+  }
+  return out;
+}
+
+// Collects the tensors the model needs from the header's "tensors" table,
+// checking each one's shape and extent, then converts them all to float32.
+class TensorReader {
+  STACK_ALLOCATED();
+
+ public:
+  TensorReader(const base::DictValue& tensors, base::span<const uint8_t> data)
+      : tensors_(tensors), data_(data) {}
+
+  // The tensor `name`, which must have exactly `shape`. On a failure, returns
+  // an empty tensor and ok() turns false.
+  Tensor Take(std::string_view name, std::initializer_list<size_t> shape) {
+    const base::DictValue* info = tensors_.FindDict(name);
+    const base::ListValue* dims = info ? info->FindList("shape") : nullptr;
+    const std::optional<size_t> offset =
+        info ? ReadSize(*info, "offset") : std::nullopt;
+    if (!dims || !offset || dims->size() != shape.size()) {
+      ok_ = false;
+      return Tensor();
+    }
+    size_t size = 1;
+    size_t index = 0;
+    for (size_t want : shape) {
+      const std::optional<int> dim = (*dims)[index++].GetIfInt();
+      if (!dim || *dim < 0 || static_cast<size_t>(*dim) != want) {
+        ok_ = false;
+        return Tensor();
+      }
+      size *= want;
+    }
+    // Two bytes per value.
+    if (size == 0 || *offset > data_.size() ||
+        size > (data_.size() - *offset) / 2) {
+      ok_ = false;
+      return Tensor();
+    }
+    pending_.push_back({*offset, size, total_});
+    const Tensor tensor{total_, size};
+    total_ += size;
+    return tensor;
+  }
+
+  Norm TakeNorm(const std::string& prefix, size_t dim) {
+    return Norm{Take(prefix + ".weight", {dim}), Take(prefix + ".bias", {dim})};
+  }
+
+  Linear TakeLinear(const std::string& prefix, size_t out, size_t in) {
+    return Linear{Take(prefix + ".weight", {out, in}),
+                  Take(prefix + ".bias", {out}), out, in};
+  }
+
+  bool ok() const { return ok_; }
+
+  // nullopt when a weight is infinite or NaN.
+  std::optional<base::HeapArray<float>> Convert() const {
+    CHECK(ok_);
+    auto weights = base::HeapArray<float>::Uninit(total_);
+    for (const Pending& tensor : pending_) {
+      base::span<const uint8_t> source =
+          data_.subspan(tensor.source, 2 * tensor.size);
+      for (float& value : weights.subspan(tensor.destination, tensor.size)) {
+        const std::optional<float> weight =
+            HalfToFloat(base::U16FromLittleEndian(source.take_first<2>()));
+        if (!weight) {
+          return std::nullopt;
+        }
+        value = *weight;
+      }
+    }
+    return weights;
+  }
+
+ private:
+  struct Pending {
+    size_t source;       // byte offset in `data_`
+    size_t size;         // values
+    size_t destination;  // float offset in the weights
+  };
+
+  const base::DictValue& tensors_;
+  base::span<const uint8_t> data_;
+  std::vector<Pending> pending_;
+  size_t total_ = 0;
+  bool ok_ = true;
+};
+
+// fairseq's SinusoidalPositionalEmbedding table, computed in float32 as the
+// reference does; the padding row is zero.
+base::HeapArray<float> Sinusoids(size_t dim, size_t pad) {
+  auto table = base::HeapArray<float>::WithSize(kMaxPositions * dim);
+  const size_t half = dim / 2;
+  const float scale =
+      static_cast<float>(-std::log(10000.0) / static_cast<double>(half - 1));
+  for (size_t position = 0; position < kMaxPositions; ++position) {
+    if (position == pad) {
+      continue;
+    }
+    base::span<float> row = table.subspan(position * dim, dim);
+    for (size_t i = 0; i < half; ++i) {
+      const float frequency = std::exp(static_cast<float>(i) * scale);
+      const float angle = static_cast<float>(position) * frequency;
+      row[i] = std::sin(angle);
+      row[half + i] = std::cos(angle);
+    }
+  }
+  return table;
+}
+
+std::unique_ptr<ModelData> ParseModel(const base::DictValue& header,
+                                      base::span<const uint8_t> data) {
+  const base::DictValue* config = header.FindDict("config");
+  const base::DictValue* tensors = header.FindDict("tensors");
+  if (!config || !tensors) {
+    return nullptr;
+  }
+
+  // The architecture this file implements (see the header comment of
+  // utils/xlit_reference.py): a pre-norm transformer with layer norm on the
+  // embeddings, scaled embeddings, sinusoidal positions, GELU, and separate
+  // input and output embeddings.
+  const std::string* activation = config->FindString("activation_fn");
+  if ((activation && *activation != "gelu") ||
+      !FlagIs(*config, "encoder_normalize_before", true) ||
+      !FlagIs(*config, "decoder_normalize_before", true) ||
+      !FlagIs(*config, "layernorm_embedding", true) ||
+      !FlagIs(*config, "no_scale_embedding", false) ||
+      !FlagIs(*config, "encoder_learned_pos", false) ||
+      !FlagIs(*config, "decoder_learned_pos", false) ||
+      !FlagIs(*config, "no_token_positional_embeddings", false) ||
+      !FlagIs(*config, "share_decoder_input_output_embed", false) ||
+      !FlagIs(*config, "share_all_embeddings", false)) {
+    return nullptr;
+  }
+  const std::optional<size_t> dim = ReadSize(*config, "encoder_embed_dim");
+  const std::optional<size_t> heads =
+      ReadSize(*config, "encoder_attention_heads");
+  const std::optional<size_t> encoder_ffn =
+      ReadSize(*config, "encoder_ffn_embed_dim");
+  const std::optional<size_t> decoder_ffn =
+      ReadSize(*config, "decoder_ffn_embed_dim");
+  const std::optional<size_t> encoder_layers =
+      ReadSize(*config, "encoder_layers");
+  const std::optional<size_t> decoder_layers =
+      ReadSize(*config, "decoder_layers");
+  if (!dim || !heads || !encoder_ffn || !decoder_ffn || !encoder_layers ||
+      !decoder_layers || ReadSize(*config, "decoder_embed_dim") != dim ||
+      ReadSize(*config, "decoder_attention_heads") != heads) {
+    return nullptr;
+  }
+  if (*dim < 4 || *dim > kMaxDim || *dim % 2 != 0 || *heads == 0 ||
+      *dim % *heads != 0 || *encoder_ffn == 0 || *encoder_ffn > 4 * kMaxDim ||
+      *decoder_ffn == 0 || *decoder_ffn > 4 * kMaxDim || *encoder_layers == 0 ||
+      *encoder_layers > kMaxLayers || *decoder_layers == 0 ||
+      *decoder_layers > kMaxLayers) {
+    return nullptr;
+  }
+
+  auto m = std::make_unique<ModelData>();
+  m->dim = *dim;
+  m->heads = *heads;
+  m->head_dim = *dim / *heads;
+  m->embed_scale = static_cast<float>(std::sqrt(static_cast<double>(*dim)));
+  m->query_scale =
+      static_cast<float>(1.0 / std::sqrt(static_cast<double>(m->head_dim)));
+
+  if (const base::DictValue* special = config->FindDict("special_ids")) {
+    m->pad = ReadSize(*special, "pad").value_or(m->pad);
+    m->eos = ReadSize(*special, "eos").value_or(m->eos);
+    m->unk = ReadSize(*special, "unk").value_or(m->unk);
+  }
+
+  const std::optional<std::vector<std::string>> source =
+      ReadStrings(header.FindList("src_vocab"), kMaxVocab);
+  const std::optional<std::vector<std::string>> target =
+      ReadStrings(header.FindList("tgt_vocab"), kMaxVocab);
+  if (!source || !target) {
+    return nullptr;
+  }
+  for (size_t id : {m->pad, m->eos, m->unk}) {
+    if (id >= source->size() || id >= target->size()) {
+      return nullptr;
+    }
+  }
+  m->letter_ids.fill(m->unk);
+  for (size_t id = 0; id < source->size(); ++id) {
+    const std::string& symbol = (*source)[id];
+    if (symbol.size() == 1 && symbol[0] >= 'a' && symbol[0] <= 'z') {
+      m->letter_ids[static_cast<size_t>(symbol[0] - 'a')] = id;
+    } else if (symbol.size() > 4 && symbol.starts_with("__") &&
+               symbol.ends_with("__")) {
+      m->tag_ids.emplace(symbol.substr(2, symbol.size() - 4), id);
+    }
+  }
+  for (const std::string& symbol : *target) {
+    m->target_vocab.push_back(base::UTF8ToUTF16(symbol));
+  }
+
+  TensorReader reader(*tensors, data);
+  const size_t d = m->dim;
+  m->encoder_embed =
+      reader.Take("encoder.embed_tokens.weight", {source->size(), d});
+  m->encoder_embed_norm = reader.TakeNorm("encoder.layernorm_embedding", d);
+  for (size_t i = 0; i < *encoder_layers; ++i) {
+    const std::string p = "encoder.layers." + base::NumberToString(i);
+    EncoderLayer layer;
+    layer.self_attention_norm = reader.TakeNorm(p + ".self_attn_layer_norm", d);
+    layer.query = reader.TakeLinear(p + ".self_attn.q_proj", d, d);
+    layer.key = reader.TakeLinear(p + ".self_attn.k_proj", d, d);
+    layer.value = reader.TakeLinear(p + ".self_attn.v_proj", d, d);
+    layer.attention_out = reader.TakeLinear(p + ".self_attn.out_proj", d, d);
+    layer.ffn_norm = reader.TakeNorm(p + ".final_layer_norm", d);
+    layer.fc1 = reader.TakeLinear(p + ".fc1", *encoder_ffn, d);
+    layer.fc2 = reader.TakeLinear(p + ".fc2", d, *encoder_ffn);
+    m->encoder_layers.push_back(layer);
+  }
+  m->encoder_final_norm = reader.TakeNorm("encoder.layer_norm", d);
+
+  m->decoder_embed =
+      reader.Take("decoder.embed_tokens.weight", {target->size(), d});
+  m->decoder_embed_norm = reader.TakeNorm("decoder.layernorm_embedding", d);
+  for (size_t i = 0; i < *decoder_layers; ++i) {
+    const std::string p = "decoder.layers." + base::NumberToString(i);
+    DecoderLayer layer;
+    layer.self_attention_norm = reader.TakeNorm(p + ".self_attn_layer_norm", d);
+    layer.query = reader.TakeLinear(p + ".self_attn.q_proj", d, d);
+    layer.key = reader.TakeLinear(p + ".self_attn.k_proj", d, d);
+    layer.value = reader.TakeLinear(p + ".self_attn.v_proj", d, d);
+    layer.attention_out = reader.TakeLinear(p + ".self_attn.out_proj", d, d);
+    layer.cross_attention_norm =
+        reader.TakeNorm(p + ".encoder_attn_layer_norm", d);
+    layer.cross_query = reader.TakeLinear(p + ".encoder_attn.q_proj", d, d);
+    layer.cross_key = reader.TakeLinear(p + ".encoder_attn.k_proj", d, d);
+    layer.cross_value = reader.TakeLinear(p + ".encoder_attn.v_proj", d, d);
+    layer.cross_attention_out =
+        reader.TakeLinear(p + ".encoder_attn.out_proj", d, d);
+    layer.ffn_norm = reader.TakeNorm(p + ".final_layer_norm", d);
+    layer.fc1 = reader.TakeLinear(p + ".fc1", *decoder_ffn, d);
+    layer.fc2 = reader.TakeLinear(p + ".fc2", d, *decoder_ffn);
+    m->decoder_layers.push_back(layer);
+  }
+  m->decoder_final_norm = reader.TakeNorm("decoder.layer_norm", d);
+  m->output_projection =
+      reader.Take("decoder.output_projection.weight", {target->size(), d});
+  if (!reader.ok()) {
+    return nullptr;
+  }
+
+  std::optional<base::HeapArray<float>> weights = reader.Convert();
+  if (!weights) {
+    return nullptr;
+  }
+  m->weights = std::move(*weights);
+  m->positions = Sinusoids(d, m->pad);
+  return m;
+}
+
+// The forward pass. Activations are row-major `rows` x width float32 buffers.
+
+int Int(size_t value) {
+  return base::checked_cast<int>(value);
+}
+
+void AddTo(base::span<float> x, base::span<const float> y) {
+  CHECK_EQ(x.size(), y.size());
+  for (size_t i = 0; i < x.size(); ++i) {
+    x[i] += y[i];
+  }
+}
+
+void Scale(base::span<float> x, float factor) {
+  for (float& value : x) {
+    value *= factor;
+  }
+}
+
+// out = x W^T + b.
+void ApplyLinear(const ModelData& m,
+                 const Linear& linear,
+                 base::span<const float> x,
+                 size_t rows,
+                 base::span<float> out) {
+  CHECK_EQ(x.size(), rows * linear.in);
+  CHECK_EQ(out.size(), rows * linear.out);
+  const base::span<const float> bias = m.Get(linear.bias);
+  for (size_t r = 0; r < rows; ++r) {
+    out.subspan(r * linear.out, linear.out).copy_from(bias);
+  }
+  const base::span<const float> weight = m.Get(linear.weight);
+  blas::GemmNT(Int(rows), Int(linear.out), Int(linear.in), x.data(),
+               Int(linear.in), weight.data(), Int(linear.in), /*beta=*/1.0f,
+               out.data(), Int(linear.out));
+}
+
+void LayerNorm(const ModelData& m,
+               const Norm& norm,
+               base::span<const float> x,
+               size_t rows,
+               base::span<float> out) {
+  const size_t dim = m.dim;
+  CHECK_EQ(x.size(), rows * dim);
+  CHECK_EQ(out.size(), rows * dim);
+  const base::span<const float> weight = m.Get(norm.weight);
+  const base::span<const float> bias = m.Get(norm.bias);
+  const float n = static_cast<float>(dim);
+  for (size_t r = 0; r < rows; ++r) {
+    const base::span<const float> in = x.subspan(r * dim, dim);
+    const base::span<float> row = out.subspan(r * dim, dim);
+    float sum = 0;
+    for (float value : in) {
+      sum += value;
+    }
+    const float mean = sum / n;
+    float squares = 0;
+    for (float value : in) {
+      squares += (value - mean) * (value - mean);
+    }
+    const float denominator = std::sqrt(squares / n + kLayerNormEpsilon);
+    for (size_t i = 0; i < dim; ++i) {
+      row[i] = (in[i] - mean) / denominator * weight[i] + bias[i];
+    }
+  }
+}
+
+// The exact (erf, not tanh) GELU, in float32 as the reference computes it.
+// The reference evaluates erf in double and rounds; float erf differs from
+// that by at most an ulp and is several times faster (erf was a fifth of the
+// decoder's time).
+void Gelu(base::span<float> x) {
+  constexpr float kSqrtHalf = 0.70710678118654752f;
+  for (float& value : x) {
+    value = 0.5f * value * (1.0f + std::erf(value * kSqrtHalf));
+  }
+}
+
+void LogSoftmax(base::span<float> row) {
+  float max = kNegativeInfinity;
+  for (float value : row) {
+    max = std::max(max, value);
+  }
+  float sum = 0;
+  for (float& value : row) {
+    value -= max;
+    sum += std::exp(value);
+  }
+  const float log_sum = std::log(sum);
+  for (float& value : row) {
+    value -= log_sum;
+  }
+}
+
+// Multi-head attention of one (already scaled) query row over `count`
+// positions. The key of position j, all heads, starts at keys[j * stride]; the
+// same for values. Writes `dim` values to `out`.
+void Attend(const ModelData& m,
+            base::span<const float> query,
+            base::span<const float> keys,
+            base::span<const float> values,
+            size_t count,
+            size_t stride,
+            base::span<float> out,
+            std::vector<float>& weights) {
+  CHECK_GT(count, 0u);
+  CHECK_GE(stride, m.dim);
+  const size_t head_dim = m.head_dim;
+  const size_t extent = (count - 1) * stride + head_dim;
+  weights.resize(count);
+  for (size_t h = 0; h < m.heads; ++h) {
+    const size_t offset = h * head_dim;
+    const base::span<const float> head_keys = keys.subspan(offset, extent);
+    const base::span<const float> head_values = values.subspan(offset, extent);
+    const base::span<const float> head_query = query.subspan(offset, head_dim);
+    const base::span<float> head_out = out.subspan(offset, head_dim);
+    // weights = K q
+    blas::Gemv(Int(count), Int(head_dim), head_keys.data(), Int(stride),
+               head_query.data(), weights.data());
+    float max = kNegativeInfinity;
+    for (float weight : weights) {
+      max = std::max(max, weight);
+    }
+    float sum = 0;
+    for (float& weight : weights) {
+      weight = std::exp(weight - max);
+      sum += weight;
+    }
+    for (float& weight : weights) {
+      weight /= sum;
+    }
+    // out = V^T weights
+    blas::GemvT(Int(count), Int(head_dim), head_values.data(), Int(stride),
+                weights.data(), head_out.data());
+  }
+}
+
+// The encoder's output, projected once into each decoder layer's
+// cross-attention keys and values (length x dim each).
+struct Encoded {
+  size_t length = 0;
+  std::vector<std::vector<float>> keys;
+  std::vector<std::vector<float>> values;
+};
+
+Encoded Encode(const ModelData& m, base::span<const size_t> ids) {
+  const size_t n = ids.size();
+  const size_t dim = m.dim;
+  std::vector<float> x(n * dim);
+  std::vector<float> h(n * dim);
+  std::vector<float> q(n * dim);
+  std::vector<float> k(n * dim);
+  std::vector<float> v(n * dim);
+  std::vector<float> attention(n * dim);
+  std::vector<float> weights;
+
+  const base::span<const float> embed = m.Get(m.encoder_embed);
+  for (size_t i = 0; i < n; ++i) {
+    const base::span<const float> token = embed.subspan(ids[i] * dim, dim);
+    const base::span<const float> position = m.Position(kFirstPosition + i);
+    const base::span<float> row = base::span(x).subspan(i * dim, dim);
+    for (size_t j = 0; j < dim; ++j) {
+      row[j] = m.embed_scale * token[j] + position[j];
+    }
+  }
+  LayerNorm(m, m.encoder_embed_norm, x, n, h);
+  std::swap(x, h);
+
+  for (const EncoderLayer& layer : m.encoder_layers) {
+    LayerNorm(m, layer.self_attention_norm, x, n, h);
+    ApplyLinear(m, layer.query, h, n, q);
+    Scale(q, m.query_scale);
+    ApplyLinear(m, layer.key, h, n, k);
+    ApplyLinear(m, layer.value, h, n, v);
+    for (size_t i = 0; i < n; ++i) {
+      Attend(m, base::span(q).subspan(i * dim, dim), k, v, n, dim,
+             base::span(attention).subspan(i * dim, dim), weights);
+    }
+    ApplyLinear(m, layer.attention_out, attention, n, h);
+    AddTo(x, h);
+
+    LayerNorm(m, layer.ffn_norm, x, n, h);
+    std::vector<float> ffn(n * layer.fc1.out);
+    ApplyLinear(m, layer.fc1, h, n, ffn);
+    Gelu(ffn);
+    ApplyLinear(m, layer.fc2, ffn, n, h);
+    AddTo(x, h);
+  }
+  LayerNorm(m, m.encoder_final_norm, x, n, h);
+
+  Encoded encoded;
+  encoded.length = n;
+  for (const DecoderLayer& layer : m.decoder_layers) {
+    encoded.keys.emplace_back(n * dim);
+    encoded.values.emplace_back(n * dim);
+    ApplyLinear(m, layer.cross_key, h, n, encoded.keys.back());
+    ApplyLinear(m, layer.cross_value, h, n, encoded.values.back());
+  }
+  return encoded;
+}
+
+// The incremental decoder: one row per live hypothesis, with a cache of every
+// layer's self-attention keys and values laid out [position][row][dim].
+class Decoder {
+ public:
+  explicit Decoder(size_t layers) : keys_(layers), values_(layers) {}
+
+  // Feeds `last` (one token per row) at decoder position `step` and writes
+  // the log-probabilities of the next token, rows x target vocabulary, to
+  // `log_probs`.
+  void Step(const ModelData& m,
+            const Encoded& encoded,
+            base::span<const size_t> last,
+            size_t step,
+            std::vector<float>& log_probs) {
+    const size_t rows = last.size();
+    CHECK_EQ(rows, rows_);
+    const size_t dim = m.dim;
+    std::vector<float> x(rows * dim);
+    std::vector<float> h(rows * dim);
+    std::vector<float> q(rows * dim);
+    std::vector<float> projected(rows * dim);
+    std::vector<float> attention(rows * dim);
+    std::vector<float> weights;
+
+    const base::span<const float> embed = m.Get(m.decoder_embed);
+    const base::span<const float> position = m.Position(kFirstPosition + step);
+    for (size_t r = 0; r < rows; ++r) {
+      const base::span<const float> token = embed.subspan(last[r] * dim, dim);
+      const base::span<float> row = base::span(x).subspan(r * dim, dim);
+      for (size_t j = 0; j < dim; ++j) {
+        row[j] = m.embed_scale * token[j] + position[j];
+      }
+    }
+    LayerNorm(m, m.decoder_embed_norm, x, rows, h);
+    std::swap(x, h);
+
+    const size_t length = length_ + 1;
+    for (size_t i = 0; i < m.decoder_layers.size(); ++i) {
+      const DecoderLayer& layer = m.decoder_layers[i];
+      std::vector<float>& keys = keys_[i];
+      std::vector<float>& values = values_[i];
+
+      LayerNorm(m, layer.self_attention_norm, x, rows, h);
+      ApplyLinear(m, layer.query, h, rows, q);
+      Scale(q, m.query_scale);
+      ApplyLinear(m, layer.key, h, rows, projected);
+      keys.insert(keys.end(), projected.begin(), projected.end());
+      ApplyLinear(m, layer.value, h, rows, projected);
+      values.insert(values.end(), projected.begin(), projected.end());
+      for (size_t r = 0; r < rows; ++r) {
+        Attend(m, base::span(q).subspan(r * dim, dim),
+               base::span(keys).subspan(r * dim),
+               base::span(values).subspan(r * dim), length, rows * dim,
+               base::span(attention).subspan(r * dim, dim), weights);
+      }
+      ApplyLinear(m, layer.attention_out, attention, rows, h);
+      AddTo(x, h);
+
+      LayerNorm(m, layer.cross_attention_norm, x, rows, h);
+      ApplyLinear(m, layer.cross_query, h, rows, q);
+      Scale(q, m.query_scale);
+      for (size_t r = 0; r < rows; ++r) {
+        Attend(m, base::span(q).subspan(r * dim, dim), encoded.keys[i],
+               encoded.values[i], encoded.length, dim,
+               base::span(attention).subspan(r * dim, dim), weights);
+      }
+      ApplyLinear(m, layer.cross_attention_out, attention, rows, h);
+      AddTo(x, h);
+
+      LayerNorm(m, layer.ffn_norm, x, rows, h);
+      std::vector<float> ffn(rows * layer.fc1.out);
+      ApplyLinear(m, layer.fc1, h, rows, ffn);
+      Gelu(ffn);
+      ApplyLinear(m, layer.fc2, ffn, rows, h);
+      AddTo(x, h);
+    }
+    length_ = length;
+
+    LayerNorm(m, m.decoder_final_norm, x, rows, h);
+    const size_t vocab = m.target_vocab.size();
+    log_probs.assign(rows * vocab, 0.0f);
+    blas::GemmNT(Int(rows), Int(vocab), Int(dim), h.data(), Int(dim),
+                 m.Get(m.output_projection).data(), Int(dim), /*beta=*/0.0f,
+                 log_probs.data(), Int(vocab));
+    for (size_t r = 0; r < rows; ++r) {
+      LogSoftmax(base::span(log_probs).subspan(r * vocab, vocab));
+    }
+  }
+
+  // Keeps the cache rows of the hypotheses that go on: new row r continues
+  // old row source[r].
+  void Reorder(const ModelData& m, base::span<const size_t> source) {
+    const size_t dim = m.dim;
+    const size_t rows = source.size();
+    for (std::vector<std::vector<float>>* cache : {&keys_, &values_}) {
+      for (std::vector<float>& layer : *cache) {
+        std::vector<float> next(length_ * rows * dim);
+        for (size_t t = 0; t < length_; ++t) {
+          for (size_t r = 0; r < rows; ++r) {
+            CHECK_LT(source[r], rows_);
+            base::span(next)
+                .subspan((t * rows + r) * dim, dim)
+                .copy_from(base::span(layer).subspan(
+                    (t * rows_ + source[r]) * dim, dim));
+          }
+        }
+        layer = std::move(next);
+      }
+    }
+    rows_ = rows;
+  }
+
+ private:
+  size_t length_ = 0;
+  size_t rows_ = 1;
+  std::vector<std::vector<float>> keys_;
+  std::vector<std::vector<float>> values_;
+};
+
+struct Hypothesis {
+  std::vector<size_t> tokens;  // without the leading and closing </s>
+  float score = 0;             // mean log-probability, counting </s>
+};
+
+// fairseq v0.12.2 SequenceGenerator._generate for one sentence, exactly as
+// utils/xlit_reference.py's beam_search() spells it out.
+std::vector<Hypothesis> BeamSearch(const ModelData& m, const Encoded& encoded) {
+  const size_t vocab = m.target_vocab.size();
+  Decoder decoder(m.decoder_layers.size());
+  std::vector<std::vector<size_t>> tokens(1);
+  std::vector<size_t> last = {m.eos};  // the decoder starts from </s>
+  std::vector<float> scores = {0.0f};
+  std::vector<Hypothesis> finished;
+  std::vector<float> totals;
+  std::vector<size_t> order;
+
+  for (size_t step = 0; step <= kMaxLength; ++step) {
+    decoder.Step(m, encoded, last, step, totals);
+    for (size_t r = 0; r < last.size(); ++r) {
+      const base::span<float> row =
+          base::span(totals).subspan(r * vocab, vocab);
+      row[m.pad] = kNegativeInfinity;
+      // The unknown-word penalty is 0, so <unk> is left as it is.
+      if (step >= kMaxLength) {
+        // Forced end: only </s> remains.
+        const float end = row[m.eos];
+        std::ranges::fill(row, kNegativeInfinity);
+        row[m.eos] = end;
+      } else if (step < kMinLength) {
+        row[m.eos] = kNegativeInfinity;
+      }
+      for (float& value : row) {
+        value += scores[r];
+      }
+    }
+
+    // The 2 * beam best (hypothesis, token) pairs by cumulative score, ties
+    // broken by the lower flat index.
+    const size_t k = std::min(2 * kBeam, totals.size() - 1);
+    order.resize(totals.size());
+    std::iota(order.begin(), order.end(), size_t{0});
+    std::partial_sort(order.begin(),
+                      std::next(order.begin(), static_cast<std::ptrdiff_t>(k)),
+                      order.end(), [&totals](size_t a, size_t b) {
+                        if (totals[a] != totals[b]) {
+                          return totals[a] > totals[b];
+                        }
+                        return a < b;
+                      });
+    const base::span<const size_t> best = base::span(order).first(k);
+
+    // Only a </s> among the first `beam` of them ends a hypothesis; one
+    // ranked lower is dropped.
+    for (size_t candidate : best.first(std::min(k, kBeam))) {
+      const size_t row = candidate / vocab;
+      if (candidate % vocab == m.eos &&
+          totals[candidate] != kNegativeInfinity && finished.size() < kBeam) {
+        finished.push_back(Hypothesis{
+            tokens[row], totals[candidate] / static_cast<float>(step + 1)});
+      }
+    }
+
+    // The beam goes on with the first `beam` candidates that are not </s>.
+    std::vector<size_t> source;
+    std::vector<std::vector<size_t>> next_tokens;
+    std::vector<size_t> next_last;
+    std::vector<float> next_scores;
+    for (size_t candidate : best) {
+      if (source.size() == kBeam) {
+        break;
+      }
+      const size_t row = candidate / vocab;
+      const size_t token = candidate % vocab;
+      if (token == m.eos) {
+        continue;
+      }
+      source.push_back(row);
+      next_tokens.push_back(tokens[row]);
+      next_tokens.back().push_back(token);
+      next_last.push_back(token);
+      next_scores.push_back(totals[candidate]);
+    }
+    if (finished.size() >= kBeam || step >= kMaxLength || source.empty()) {
+      break;
+    }
+    tokens = std::move(next_tokens);
+    last = std::move(next_last);
+    scores = std::move(next_scores);
+    decoder.Reorder(m, source);
+  }
+
+  std::ranges::stable_sort(finished, std::ranges::greater(),
+                           &Hypothesis::score);
+  return finished;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<Model> Model::Load(base::span<const uint8_t> txlm) {
+  base::SpanReader<const uint8_t> reader(txlm);
+  const std::optional<base::span<const uint8_t, 8>> magic = reader.Read<8>();
+  uint32_t header_length = 0;
+  if (!magic || !std::ranges::equal(*magic, kMagic) ||
+      !reader.ReadU32LittleEndian(header_length)) {
+    return nullptr;
+  }
+  const std::optional<base::span<const uint8_t>> header_bytes =
+      reader.Read(header_length);
+  if (!header_bytes) {
+    return nullptr;
+  }
+  const std::optional<base::DictValue> header = base::JSONReader::ReadDict(
+      base::as_string_view(*header_bytes), base::JSON_PARSE_RFC);
+  if (!header) {
+    return nullptr;
+  }
+  std::unique_ptr<ModelData> data =
+      ParseModel(*header, reader.remaining_span());
+  if (!data) {
+    return nullptr;
+  }
+  return base::WrapUnique(new Model(std::move(data)));
+}
+
+Model::Model(std::unique_ptr<const internal::ModelData> data)
+    : data_(std::move(data)) {}
+
+Model::~Model() = default;
+
+std::vector<Candidate> Model::Transliterate(std::string_view word,
+                                            std::string_view tag) const {
+  const ModelData& m = *data_;
+  // English is a source-side tag; the model does not write it.
+  if (word.empty() || word.size() > kMaxWordLetters || tag == "en") {
+    return {};
+  }
+  const auto tag_id = m.tag_ids.find(tag);
+  if (tag_id == m.tag_ids.end()) {
+    return {};
+  }
+  // __tag__ letters </s>, the tag on the encoder side.
+  std::vector<size_t> ids = {tag_id->second};
+  for (char c : word) {
+    if (c < 'a' || c > 'z') {
+      return {};
+    }
+    ids.push_back(m.letter_ids[static_cast<size_t>(c - 'a')]);
+  }
+  ids.push_back(m.eos);
+
+  const Encoded encoded = Encode(m, ids);
+  std::vector<Candidate> candidates;
+  for (const Hypothesis& hypothesis : BeamSearch(m, encoded)) {
+    Candidate candidate;
+    for (size_t token : hypothesis.tokens) {
+      candidate.text += m.target_vocab[token];
+    }
+    candidate.score = std::exp(static_cast<double>(hypothesis.score));
+    candidates.push_back(std::move(candidate));
+  }
+  return candidates;
+}
+
