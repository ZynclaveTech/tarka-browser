+namespace tark_xlit {
+
+namespace {
+
+// What Convert() reports for a Phrase() that gave nothing.
+constexpr std::string_view kNothing = "<nullopt>";
+
+base::FilePath TestDataDir() {
+  return base::PathService::CheckedGet(base::DIR_SRC_TEST_DATA_ROOT)
+      .AppendASCII("components/tark_xlit/test/data");
+}
+
+std::unique_ptr<WordList> LoadTestWords() {
+  auto file = std::make_unique<base::MemoryMappedFile>();
+  if (!file->Initialize(TestDataDir().AppendASCII("xlit-words.bin"))) {
+    return nullptr;
+  }
+  return WordList::Load(std::move(file));
+}
+
+// The real model and word lists, loaded once per test process. Phrase() fills
+// the instance's cache, which only makes later tests faster.
+Transliterator* RealTransliterator() {
+  static base::NoDestructor<std::unique_ptr<Transliterator>> transliterator(
+      LoadFromDirectory(TestDataDir()));
+  return transliterator->get();
+}
+
+// UTF-8 of what `transliterator` makes of `input`, or kNothing.
+std::string Convert(Transliterator* transliterator,
+                    std::u16string_view input,
+                    std::string_view tag) {
+  const std::optional<std::u16string> result =
+      transliterator->Phrase(input, tag);
+  return result ? base::UTF16ToUTF8(*result) : std::string(kNothing);
+}
+
+std::string Convert(std::u16string_view input, std::string_view tag) {
+  Transliterator* transliterator = RealTransliterator();
+  if (!transliterator) {
+    return "<no transliterator>";
+  }
+  return Convert(transliterator, input, tag);
+}
+
+bool HasAsciiLetter(std::u16string_view text) {
+  for (char16_t c : text) {
+    if ((c >= u'a' && c <= u'z') || (c >= u'A' && c <= u'Z')) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// A new directory `name` in `temp` with symbolic links xlit-model.bin to
+// `model` and xlit-words.bin to `words`, each left out when its path is empty.
+base::FilePath MakeDirectory(const base::ScopedTempDir& temp,
+                             std::string_view name,
+                             const base::FilePath& model,
+                             const base::FilePath& words) {
+  const base::FilePath directory = temp.GetPath().AppendASCII(name);
+  EXPECT_TRUE(base::CreateDirectory(directory));
+  if (!model.value().empty()) {
+    EXPECT_TRUE(base::CreateSymbolicLink(
+        model, directory.AppendASCII("xlit-model.bin")));
+  }
+  if (!words.value().empty()) {
+    EXPECT_TRUE(base::CreateSymbolicLink(
+        words, directory.AppendASCII("xlit-words.bin")));
+  }
+  return directory;
+}
+
+// A stand-in for Model::Transliterate: records each call as "<tag> <word>" and
+// answers `answer`, by default one candidate, the word behind a Bengali ba.
+struct FakeModel {
+  std::vector<std::string> calls;
+  Transliterator::WordFunction answer;
+
+  Transliterator::WordFunction Callback() {
+    return base::BindLambdaForTesting(
+        [this](std::string_view word, std::string_view tag) {
+          calls.push_back(std::string(tag) + " " + std::string(word));
+          if (answer) {
+            return answer.Run(word, tag);
+          }
+          return std::vector<Candidate>{
+              Candidate{u"ব" + base::UTF8ToUTF16(word), 0.5}};
+        });
+  }
+};
+
+}  // namespace
+
+TEST(TarkXlitTransliteratorTest, HeartAttackKeLakshan) {
+  EXPECT_EQ(Convert(u"heart attack ke lakshan", "hi"),
+            "heart attack के लक्षण");
+}
+
+TEST(TarkXlitTransliteratorTest, Namaste) {
+  EXPECT_EQ(Convert(u"namaste", "hi"), "नमस्ते");
+}
+
+TEST(TarkXlitTransliteratorTest, UpperCaseLettersAreLowerCased) {
+  EXPECT_EQ(Convert(u"Namaste", "hi"), "नमस्ते");
+  EXPECT_EQ(Convert(u"NAMASTE", "hi"), "नमस्ते");
+}
+
+TEST(TarkXlitTransliteratorTest, Covid19KeepsEnglishAndDigits) {
+  EXPECT_EQ(Convert(u"covid-19 ke lakshan", "hi"), "covid-19 के लक्षण");
+}
+
+TEST(TarkXlitTransliteratorTest, DigitsStayAndLettersChange) {
+  const std::string result = Convert(u"pnr 4512345678", "hi");
+  ASSERT_NE(result, std::string(kNothing));
+  const std::u16string text = base::UTF8ToUTF16(result);
+  ASSERT_GT(text.size(), 11u);
+  EXPECT_EQ(text.substr(text.size() - 11), u" 4512345678");
+  EXPECT_FALSE(HasAsciiLetter(text));
+}
+
+TEST(TarkXlitTransliteratorTest, PunctuationInsideAWordStays) {
+  const std::string result = Convert(u"c++ seekho", "hi");
+  ASSERT_NE(result, std::string(kNothing));
+  const std::u16string text = base::UTF8ToUTF16(result);
+  EXPECT_EQ(text.substr(0, 4), u"c++ ");
+  EXPECT_FALSE(HasAsciiLetter(text.substr(4)));
+  EXPECT_GT(text.size(), 4u);
+}
+
+TEST(TarkXlitTransliteratorTest, AllEnglishChangesNothing) {
+  EXPECT_EQ(Convert(u"the weather today", "hi"), kNothing);
+  // Upper-case English stays as typed, and so still changes nothing.
+  EXPECT_EQ(Convert(u"The Weather TODAY", "hi"), kNothing);
+}
+
+TEST(TarkXlitTransliteratorTest, NotLatinTextIsNothing) {
+  EXPECT_EQ(Convert(u"नमस्ते", "hi"), kNothing);
+  EXPECT_EQ(Convert(u"", "hi"), kNothing);
+  EXPECT_EQ(Convert(u"a", "hi"), kNothing);
+  EXPECT_EQ(Convert(u"1234 5678", "hi"), kNothing);
+  EXPECT_EQ(Convert(u"namaste दुनिया", "hi"), kNothing);
+}
+
+TEST(TarkXlitTransliteratorTest, UnknownTagIsNothing) {
+  EXPECT_EQ(Convert(u"namaste", "xx"), kNothing);
+  EXPECT_EQ(Convert(u"namaste", ""), kNothing);
+}
+
+TEST(TarkXlitTransliteratorTest, ManyWordsNeverReachTheModel) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), LoadTestWords());
+
+  std::u16string forty;
+  for (size_t i = 0; i < 40; ++i) {
+    forty += (i == 0 ? u"" : u" ");
+    forty += u"namaste";
+  }
+  EXPECT_EQ(Convert(&transliterator, forty, "hi"), kNothing);
+  EXPECT_TRUE(fake.calls.empty());
+
+  // 13 words are one too many; 12 are fine, and the repeated word is asked of
+  // the model once.
+  std::u16string twelve;
+  for (size_t i = 0; i < 12; ++i) {
+    twelve += (i == 0 ? u"" : u" ");
+    twelve += u"namaste";
+  }
+  EXPECT_EQ(Convert(&transliterator, twelve + u" namaste", "hi"), kNothing);
+  EXPECT_TRUE(fake.calls.empty());
+  EXPECT_NE(Convert(&transliterator, twelve, "hi"), kNothing);
+  EXPECT_EQ(fake.calls, std::vector<std::string>{"hi namaste"});
+}
+
+TEST(TarkXlitTransliteratorTest, KeepsEverythingButLetterRuns) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), nullptr);
+  // Spaces (several, and a tab), punctuation, digits and a non-ASCII dash stay
+  // where they are; each run of Latin letters, lower-cased, is one word.
+  EXPECT_EQ(Convert(&transliterator, u"ab-cd  12x_y\tEf—gh", "bn"),
+            "বab-বcd  12বx_বy\tবef—বgh");
+  EXPECT_EQ(fake.calls,
+            (std::vector<std::string>{"bn ab", "bn cd", "bn x", "bn y",
+                                      "bn ef", "bn gh"}));
+}
+
+TEST(TarkXlitTransliteratorTest, EnglishWordsStayAsTyped) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), LoadTestWords());
+  EXPECT_EQ(Convert(&transliterator, u"Heart zzkx covid-19", "hi"),
+            "Heart বzzkx covid-19");
+  EXPECT_EQ(fake.calls, std::vector<std::string>{"hi zzkx"});
+}
+
+TEST(TarkXlitTransliteratorTest, WithoutAWordListNothingIsEnglish) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), nullptr);
+  EXPECT_EQ(Convert(&transliterator, u"the weather", "hi"), "বthe বweather");
+}
+
+TEST(TarkXlitTransliteratorTest, AWordTheModelCannotDoStaysAsTyped) {
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view, std::string_view) {
+        return std::vector<Candidate>();
+      });
+  Transliterator transliterator(fake.Callback(), nullptr);
+  EXPECT_EQ(Convert(&transliterator, u"Zzkx Qqrt", "hi"), kNothing);
+
+  // Another word still changes.
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view word, std::string_view) {
+        if (word == "zzkx") {
+          return std::vector<Candidate>();
+        }
+        return std::vector<Candidate>{Candidate{u"क", 0.5}};
+      });
+  EXPECT_EQ(Convert(&transliterator, u"Zzkx Qqrtw", "hi"), "Zzkx क");
+}
+
+TEST(TarkXlitTransliteratorTest, SpecialSymbolCandidatesAreDropped) {
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view word, std::string_view) {
+        std::vector<Candidate> candidates = {
+            Candidate{u"<unk>", 0.9}, Candidate{u"क<s>ख", 0.8},
+            Candidate{u"</s>", 0.7},  Candidate{u"<pad>", 0.6}};
+        if (word == "ok") {
+          candidates.push_back(Candidate{u"ठीक", 0.1});
+        }
+        return candidates;
+      });
+  Transliterator transliterator(fake.Callback(), nullptr);
+  // Every candidate is a symbol: the word stays.
+  EXPECT_EQ(Convert(&transliterator, u"zzkx", "hi"), kNothing);
+  // The one real candidate wins whatever the model scored the symbols.
+  EXPECT_EQ(Convert(&transliterator, u"ok", "hi"), "ठीक");
+}
+
+TEST(TarkXlitTransliteratorTest, EmptyCandidatesAreDropped) {
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view, std::string_view) {
+        return std::vector<Candidate>{Candidate{u"", 0.9},
+                                      Candidate{u"क", 0.1}};
+      });
+  Transliterator transliterator(fake.Callback(), nullptr);
+  EXPECT_EQ(Convert(&transliterator, u"ka", "hi"), "क");
+}
+
+TEST(TarkXlitTransliteratorTest, ZeroWidthNonJoinersAreStripped) {
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view word, std::string_view) {
+        if (word == "zzkx") {
+          // Only a ZWNJ: nothing is left, so the word stays.
+          return std::vector<Candidate>{Candidate{u"\u200c", 0.9}};
+        }
+        // A word-final virama followed by a ZWNJ.
+        return std::vector<Candidate>{
+            Candidate{u"\u0930\u093e\u092e\u094d\u200c", 0.9}};
+      });
+  Transliterator transliterator(fake.Callback(), nullptr);
+  const std::u16string result =
+      base::UTF8ToUTF16(Convert(&transliterator, u"ram", "hi"));
+  EXPECT_EQ(result, u"\u0930\u093e\u092e\u094d");
+  EXPECT_EQ(result.find(u'\u200c'), std::u16string::npos);
+  EXPECT_EQ(Convert(&transliterator, u"zzkx", "hi"), kNothing);
+}
+
+TEST(TarkXlitTransliteratorTest, LongRunsOfLettersStayAndAreNotAsked) {
+  FakeModel fake;
+  Transliterator transliterator(fake.Callback(), nullptr);
+  const std::u16string long_run(33, u'a');
+  const std::u16string longest(32, u'a');
+  EXPECT_EQ(Convert(&transliterator, u"ab " + long_run, "hi"),
+            "বab " + base::UTF16ToUTF8(long_run));
+  EXPECT_EQ(fake.calls, std::vector<std::string>{"hi ab"});
+  // 32 letters are still asked of the model.
+  EXPECT_NE(Convert(&transliterator, longest, "hi"), kNothing);
+  EXPECT_EQ(fake.calls.size(), 2u);
+}
