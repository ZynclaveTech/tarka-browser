+#include "components/tark_xlit/word_list.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <numeric>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/containers/heap_array.h"
+#include "base/containers/span.h"
+#include "base/containers/span_reader.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/json/json_reader.h"
+#include "base/memory/ptr_util.h"
+#include "base/numerics/byte_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+
+namespace tark_xlit {
+
+namespace {
+
+constexpr std::array<uint8_t, 8> kMagic = {'T', 'X', 'L', 'W', 1, 0, 0, 0};
+constexpr std::string_view kEnglishTag = "en";
+
+// IndicXlit's rescoring weight of the model score against the word count.
+constexpr double kAlpha = 0.9;
+
+std::optional<size_t> ReadSize(const base::DictValue& dict,
+                               std::string_view key) {
+  const std::optional<int> value = dict.FindInt(key);
+  if (!value || *value < 0) {
+    return std::nullopt;
+  }
+  return static_cast<size_t>(*value);
+}
+
+}  // namespace
+
+// static
+std::optional<WordList::Blocks> WordList::ParseBlocks(
+    base::span<const uint8_t> txlw) {
+  base::SpanReader<const uint8_t> reader(txlw);
+  const std::optional<base::span<const uint8_t, 8>> magic = reader.Read<8>();
+  uint32_t header_length = 0;
+  if (!magic || !std::ranges::equal(*magic, kMagic) ||
+      !reader.ReadU32LittleEndian(header_length)) {
+    return std::nullopt;
+  }
+  const std::optional<base::span<const uint8_t>> header_bytes =
+      reader.Read(header_length);
+  if (!header_bytes) {
+    return std::nullopt;
+  }
+  const std::optional<base::DictValue> header = base::JSONReader::ReadDict(
+      base::as_string_view(*header_bytes), base::JSON_PARSE_RFC);
+  if (!header) {
+    return std::nullopt;
+  }
+
+  // Block offsets are absolute file offsets; no block may overlap the magic
+  // and the header. Only the record-offset tables are checked here: the
+  // records are checked as lookups reach them.
+  const size_t data_start = reader.num_read();
+  Blocks blocks;
+  for (const auto [tag, value] : *header) {
+    const base::DictValue* entry = value.GetIfDict();
+    if (!entry) {
+      return std::nullopt;
+    }
+    const std::optional<size_t> offset = ReadSize(*entry, "offset");
+    const std::optional<size_t> count = ReadSize(*entry, "count");
+    if (!offset || !count || *offset < data_start || *offset > txlw.size() ||
+        *count > (txlw.size() - *offset) / 4) {
+      return std::nullopt;
+    }
+    blocks.emplace(tag, Block{*offset, *count});
+  }
+  return blocks;
+}
+
+// static
+std::unique_ptr<WordList> WordList::Load(base::span<const uint8_t> txlw) {
+  std::optional<Blocks> blocks = ParseBlocks(txlw);
+  if (!blocks) {
+    return nullptr;
+  }
+  return base::WrapUnique(new WordList(
+      base::HeapArray<uint8_t>::CopiedFrom(txlw), nullptr, std::move(*blocks)));
+}
+
+// static
+std::unique_ptr<WordList> WordList::Load(
+    std::unique_ptr<base::MemoryMappedFile> file) {
+  if (!file || !file->IsValid()) {
+    return nullptr;
+  }
+  std::optional<Blocks> blocks = ParseBlocks(file->bytes());
+  if (!blocks) {
+    return nullptr;
+  }
+  return base::WrapUnique(new WordList(base::HeapArray<uint8_t>(),
+                                       std::move(file), std::move(*blocks)));
+}
+
+WordList::WordList(base::HeapArray<uint8_t> copy,
+                   std::unique_ptr<base::MemoryMappedFile> file,
+                   Blocks blocks)
+    : copy_(std::move(copy)),
+      file_(std::move(file)),
+      blocks_(std::move(blocks)),
+      data_(file_ ? file_->bytes()
+                  : base::span<const uint8_t>(copy_.as_span())) {}
+
+WordList::~WordList() = default;
+
+std::optional<uint32_t> WordList::Count(std::string_view tag,
+                                        std::u16string_view word) const {
+  return Find(tag, base::UTF16ToUTF8(word));
+}
+
+bool WordList::HasLanguage(std::string_view tag) const {
+  return blocks_.find(tag) != blocks_.end();
+}
+
+bool WordList::IsCommonEnglish(std::string_view word) const {
+  return Find(kEnglishTag, word).has_value();
+}
+
+std::optional<WordList::Record> WordList::RecordAt(const Block& block,
+                                                   size_t index) const {
+  // ParseBlocks() checked that the block's record-offset table is inside the
+  // blob; the record it points to may not be.
+  const base::span<const uint8_t> data(data_);
+  const base::span<const uint8_t> block_bytes = data.subspan(block.offset);
+  const size_t relative =
+      base::U32FromLittleEndian(block_bytes.subspan(4 * index).first<4>());
+  if (relative > block_bytes.size()) {
+    return std::nullopt;
+  }
+  // A record is a u32 count, a u16 byte length and the UTF-8 bytes.
+  base::SpanReader<const uint8_t> reader(block_bytes.subspan(relative));
+  Record record;
+  uint16_t length = 0;
+  if (!reader.ReadU32LittleEndian(record.count) ||
+      !reader.ReadU16LittleEndian(length)) {
+    return std::nullopt;
+  }
+  const std::optional<base::span<const uint8_t>> bytes = reader.Read(length);
+  if (!bytes) {
+    return std::nullopt;
+  }
+  record.word = base::as_string_view(*bytes);
+  return record;
+}
+
+std::optional<uint32_t> WordList::Find(std::string_view tag,
+                                       std::string_view utf8) const {
+  const auto block = blocks_.find(tag);
+  if (block == blocks_.end() || utf8.empty()) {
+    return std::nullopt;
+  }
+  // The records are sorted by their bytes, which is std::string_view's order.
+  size_t low = 0;
+  size_t high = block->second.count;
+  while (low < high) {
+    const size_t middle = low + (high - low) / 2;
+    const std::optional<Record> record = RecordAt(block->second, middle);
+    if (!record) {
+      return std::nullopt;
+    }
+    if (record->word == utf8) {
+      return record->count;
+    }
+    if (record->word < utf8) {
+      low = middle + 1;
+    } else {
+      high = middle;
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<Candidate> Rescore(std::vector<Candidate> candidates,
+                               const WordList* list,
+                               std::string_view tag) {
+  if (!list || !list->HasLanguage(tag) || candidates.empty()) {
+    return candidates;
+  }
+  const size_t n = candidates.size();
+  std::vector<std::optional<uint32_t>> counts;
+  double score_sum = 0;
+  double count_sum = 0;
+  for (const Candidate& candidate : candidates) {
+    counts.push_back(list->Count(tag, candidate.text));
+    score_sum += candidate.score;
+    count_sum += counts.back().value_or(0);
+  }
+  std::vector<double> final_scores(n, 0.0);
+  for (size_t i = 0; i < n; ++i) {
+    if (!counts[i]) {
+      continue;
+    }
+    const double model = score_sum > 0 ? candidates[i].score / score_sum : 0;
+    const double frequency = count_sum > 0 ? *counts[i] / count_sum : 0;
+    final_scores[i] = kAlpha * model + (1 - kAlpha) * frequency;
+  }
+
+  std::vector<size_t> order(n);
+  std::iota(order.begin(), order.end(), size_t{0});
+  std::ranges::stable_sort(order, [&final_scores](size_t a, size_t b) {
+    return final_scores[a] > final_scores[b];
+  });
+  std::vector<Candidate> out;
+  out.reserve(n);
+  for (size_t i : order) {
+    out.push_back(std::move(candidates[i]));
+  }
+  return out;
+}
+
+}  // namespace tark_xlit
