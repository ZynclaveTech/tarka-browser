+#ifndef COMPONENTS_TARK_XLIT_LANGUAGES_H_
+#define COMPONENTS_TARK_XLIT_LANGUAGES_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace tark_xlit {
+
+// The scripts Tark tells apart. kOther means "no letters we know" (an empty
+// query, digits only, or a script outside this list).
+enum class Script {
+  kLatin,
+  kDevanagari,
+  kBengali,
+  kGurmukhi,
+  kGujarati,
+  kOdia,
+  kTamil,
+  kTelugu,
+  kKannada,
+  kMalayalam,
+  kArabic,
+  kMeeteiMayek,
+  kOther,
+};
+
+// One language IndicXlit can write.
+struct Language {
+  // The language subtag as it appears in Chromium's accept-languages list
+  // ("kok" for Konkani).
+  std::string_view accept_code;
+  // The tag IndicXlit and Wikipedia use ("gom" for Konkani). Equal to
+  // `accept_code` for every other language.
+  std::string_view tag;
+  // The script IndicXlit writes this language in.
+  Script script;
+  // The language's name in itself, from CLDR.
+  std::u16string_view native_name;
+};
+
+// The script that most of `text`'s letters belong to, or kOther when there are
+// no letters. Digits, punctuation, danda marks and joiners do not vote. On a
+// tie a non-Latin script wins: someone who typed native letters meant them.
+Script DominantScript(std::u16string_view text);
+
+// All 20 supported languages, in a fixed order.
+base::span<const Language> AllLanguages();
+
+// The languages to offer rows for: the first (at most) three Indian languages
+// in `accept_languages` (a comma list such as "en-US,ta;q=0.9,hi"), in order,
+// each once. Hindi alone when the list has none. The pointers refer to the
+// static table and stay valid for the life of the process.
+std::vector<const Language*> RowLanguages(std::string_view accept_languages);
+
+// Whether `text` might be an Indian-language word or phrase typed in Latin
+// letters: every letter is ASCII Latin, at least two letters, at most 12
+// whitespace-separated words.
+bool LooksTransliterable(std::u16string_view text);
+
+// The Wikipedia language code for a query: "en" for Latin text or text with no
+// letters. Otherwise the first language in `accept_languages` whose script
+// matches the query's dominant script, else that script's default.
+std::string WikipediaLanguage(std::u16string_view query,
+                              std::string_view accept_languages);
+
+}  // namespace tark_xlit
+
+#endif  // COMPONENTS_TARK_XLIT_LANGUAGES_H_
