+// The goldens are utils/xlit_reference.py's output for every word of
+// golden-inputs.txt in each of the model's 21 languages, before rescoring.
+constexpr size_t kGoldenLines = 60 * 21;
+// Two reference scores closer than this are a tie: float rounding may order
+// the pair either way.
+constexpr double kTie = 1e-4;
+constexpr double kScoreTolerance = 1e-3;
+
+base::FilePath TestDataPath(std::string_view name) {
+  return base::PathService::CheckedGet(base::DIR_SRC_TEST_DATA_ROOT)
+      .AppendASCII("components/tark_xlit/test/data")
+      .AppendASCII(name);
+}
+
+std::vector<uint8_t> ReadTestData(std::string_view name) {
+  return base::ReadFileToBytes(TestDataPath(name))
+      .value_or(std::vector<uint8_t>());
+}
+
+// The real model, loaded once per test process and shared (it is const and
+// thread-safe).
+const Model* TestModel() {
+  static const base::NoDestructor<std::unique_ptr<Model>> model(
+      Model::Load(ReadTestData("xlit-model.bin")));
+  return model->get();
+}
+
+std::unique_ptr<base::MemoryMappedFile> MapFile(const base::FilePath& path) {
+  auto file = std::make_unique<base::MemoryMappedFile>();
+  if (!file->Initialize(path)) {
+    return nullptr;
+  }
+  return file;
+}
+
+// The real word lists, mapped from the file as the browser maps them, once
+// per test process.
+const WordList* TestWordList() {
+  static const base::NoDestructor<std::unique_ptr<WordList>> list(
+      WordList::Load(MapFile(TestDataPath("xlit-words.bin"))));
+  return list->get();
+}
+
+// `bytes` written to a new file in `dir` and loaded through a mapping of it.
+// Each call writes a file of its own, so no live mapping is overwritten.
+std::unique_ptr<WordList> LoadMapped(const base::ScopedTempDir& dir,
+                                     const std::vector<uint8_t>& bytes) {
+  static size_t files = 0;
+  const base::FilePath path = dir.GetPath().AppendASCII(
+      "words" + base::NumberToString(files++) + ".bin");
+  if (!base::WriteFile(path, bytes)) {
+    return nullptr;
+  }
+  return WordList::Load(MapFile(path));
+}
+
+void AppendU32(std::vector<uint8_t>& out, uint32_t value) {
+  for (uint8_t byte : base::U32ToLittleEndian(value)) {
+    out.push_back(byte);
+  }
+}
+
+void AppendU16(std::vector<uint8_t>& out, uint16_t value) {
+  for (uint8_t byte : base::U16ToLittleEndian(value)) {
+    out.push_back(byte);
+  }
+}
+
+// A TXLW v1 blob laid out as utils/xlit_wordlist.py packs it: per language,
+// the words (sorted by their UTF-8 bytes, as std::map sorts std::string) and
+// their counts.
+using Lists = std::map<std::string, std::map<std::string, uint32_t>>;
+std::vector<uint8_t> PackWordList(const Lists& lists) {
+  constexpr size_t kHeaderSize = 500;  // 12 + 500 is a multiple of 4.
+  std::vector<std::vector<uint8_t>> blocks;
+  std::string header = "{";
+  size_t offset = 12 + kHeaderSize;
+  for (const auto& [tag, words] : lists) {
+    std::vector<uint8_t> table;
+    std::vector<uint8_t> records;
+    for (const auto& [word, count] : words) {
+      AppendU32(table,
+                static_cast<uint32_t>(4 * words.size() + records.size()));
+      AppendU32(records, count);
+      AppendU16(records, static_cast<uint16_t>(word.size()));
+      for (char c : word) {
+        records.push_back(static_cast<uint8_t>(c));
+      }
+    }
+    std::vector<uint8_t> block = table;
+    block.insert(block.end(), records.begin(), records.end());
+    while (block.size() % 4 != 0) {
+      block.push_back(0);
+    }
+    if (header.size() > 1) {
+      header += ",";
+    }
+    header += "\"" + tag + "\":{\"offset\":" + base::NumberToString(offset) +
+              ",\"count\":" + base::NumberToString(words.size()) + "}";
+    offset += block.size();
+    blocks.push_back(std::move(block));
+  }
+  header += "}";
+  EXPECT_LE(header.size(), kHeaderSize);
+  header.resize(kHeaderSize, ' ');
+
+  std::vector<uint8_t> out = {'T', 'X', 'L', 'W', 1, 0, 0, 0};
+  AppendU32(out, static_cast<uint32_t>(kHeaderSize));
+  for (char c : header) {
+    out.push_back(static_cast<uint8_t>(c));
+  }
+  for (const std::vector<uint8_t>& block : blocks) {
+    out.insert(out.end(), block.begin(), block.end());
+  }
+  return out;
+}
+
+struct GoldenCandidate {
+  std::string text;
+  double score = 0;
+};
+
+std::string Describe(const std::vector<GoldenCandidate>& want,
+                     const std::vector<Candidate>& got) {
+  std::string out = "\n    want:";
+  for (const GoldenCandidate& candidate : want) {
+    out += " " + candidate.text + "|" + base::NumberToString(candidate.score);
+  }
+  out += "\n    got: ";
+  for (const Candidate& candidate : got) {
+    out += " " + base::UTF16ToUTF8(candidate.text) + "|" +
+           base::NumberToString(candidate.score);
+  }
+  return out;
+}
+
+// Empty when `got` matches the reference `want`, else why not. Texts must come
+// in the reference's order, except that two candidates whose reference scores
+// tie (closer than kTie) may come in either order; each score must be within
+// kScoreTolerance (relative) of the reference's score for that text.
+std::string Compare(const std::vector<GoldenCandidate>& want,
+                    const std::vector<Candidate>& got) {
+  if (want.size() != got.size()) {
+    return "expected " + base::NumberToString(want.size()) +
+           " candidates, got " + base::NumberToString(got.size()) +
+           Describe(want, got);
+  }
+  for (size_t i = 0; i < got.size(); ++i) {
+    const std::string text = base::UTF16ToUTF8(got[i].text);
+    std::optional<size_t> found;
+    for (size_t j = 0; j < want.size(); ++j) {
+      if (want[j].text == text) {
+        found = j;
+      }
+    }
+    if (!found) {
+      return "candidate " + base::NumberToString(i) + " is not a reference " +
+             "candidate" + Describe(want, got);
+    }
+    if (*found != i && std::abs(want[*found].score - want[i].score) >= kTie) {
+      return "candidate " + base::NumberToString(i) + " is out of order" +
+             Describe(want, got);
+    }
+    const double expected = want[*found].score;
+    if (std::abs(got[i].score - expected) > kScoreTolerance * expected) {
+      return "candidate " + base::NumberToString(i) + " score differs" +
+             Describe(want, got);
+    }
+  }
+  return std::string();
+}
+
+std::vector<Candidate> Candidates(
+    std::vector<std::pair<std::u16string, double>> list) {
+  std::vector<Candidate> out;
+  for (auto& [text, score] : list) {
+    out.push_back(Candidate{std::move(text), score});
+  }
+  return out;
+}
+
+std::vector<std::u16string> Texts(const std::vector<Candidate>& candidates) {
+  std::vector<std::u16string> out;
+  for (const Candidate& candidate : candidates) {
+    out.push_back(candidate.text);
+  }
+  return out;
+}
