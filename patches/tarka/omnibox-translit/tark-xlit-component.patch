+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_xlit/languages.h"
+
+#include <array>
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace tark_xlit {
+
+namespace {
+
+// IndicXlit's 21 languages minus Sinhala, which is not an Indian language.
+//
+// `native_name` is the language's name in itself, taken from the CLDR
+// localeDisplayNames/languages data (unicode-org/cldr-json, package
+// cldr-localenames-full, file main/<locale>/languages.json, key = the
+// locale's own code), checked on 2026-10-19:
+//   as   অসমীয়া          main/as
+//   bn   বাংলা            main/bn
+//   brx  बर’             main/brx (the apostrophe is U+2019, as in CLDR)
+//   kok  कोंकणी          main/kok
+//   gu   ગુજરાતી         main/gu
+//   hi   हिन्दी           main/hi
+//   kn   ಕನ್ನಡ           main/kn
+//   ks   کٲشُر           main/ks (Arabic script, as the model writes it)
+//   mai  मैथिली          main/mai
+//   ml   മലയാളം         main/ml
+//   mni  ꯃꯤꯇꯩꯂꯣꯟ         main/mni-Mtei; CLDR's plain main/mni is Bengali
+//                         script, but the model writes Meetei Mayek
+//   mr   मराठी           main/mr
+//   ne   नेपाली           main/ne
+//   or   ଓଡ଼ିଆ           main/or
+//   pa   ਪੰਜਾਬੀ          main/pa (Gurmukhi)
+//   sa   संस्कृत भाषा      main/sa (CLDR's own-language name is the long form)
+//   sd   سنڌي            main/sd (Arabic script, as the model writes it)
+//   ta   தமிழ்            main/ta
+//   te   తెలుగు           main/te
+//   ur   اردو            main/ur
+//
+// Konkani is `kok` in Chromium's accept-languages and `gom` for IndicXlit and
+// Wikipedia.
+constexpr Language kLanguages[] = {
+    {"as", "as", Script::kBengali, u"অসমীয়া"},
+    {"bn", "bn", Script::kBengali, u"বাংলা"},
+    {"brx", "brx", Script::kDevanagari, u"बर’"},
+    {"kok", "gom", Script::kDevanagari, u"कोंकणी"},
+    {"gu", "gu", Script::kGujarati, u"ગુજરાતી"},
+    {"hi", "hi", Script::kDevanagari, u"हिन्दी"},
+    {"kn", "kn", Script::kKannada, u"ಕನ್ನಡ"},
+    {"ks", "ks", Script::kArabic, u"کٲشُر"},
+    {"mai", "mai", Script::kDevanagari, u"मैथिली"},
+    {"ml", "ml", Script::kMalayalam, u"മലയാളം"},
+    {"mni", "mni", Script::kMeeteiMayek, u"ꯃꯤꯇꯩꯂꯣꯟ"},
+    {"mr", "mr", Script::kDevanagari, u"मराठी"},
+    {"ne", "ne", Script::kDevanagari, u"नेपाली"},
+    {"or", "or", Script::kOdia, u"ଓଡ଼ିଆ"},
+    {"pa", "pa", Script::kGurmukhi, u"ਪੰਜਾਬੀ"},
+    {"sa", "sa", Script::kDevanagari, u"संस्कृत भाषा"},
+    {"sd", "sd", Script::kArabic, u"سنڌي"},
+    {"ta", "ta", Script::kTamil, u"தமிழ்"},
+    {"te", "te", Script::kTelugu, u"తెలుగు"},
+    {"ur", "ur", Script::kArabic, u"اردو"},
+};
+
+constexpr size_t kMaxRows = 3;
+constexpr size_t kMaxWords = 12;
+constexpr size_t kMinLetters = 2;
+
+// The Indic scripts each have a 0x80-wide block in this order, with the same
+// layout: offsets 0x64-0x6F hold the danda marks and the digits.
+struct IndicBlock {
+  char16_t first;
+  Script script;
+};
+constexpr IndicBlock kIndicBlocks[] = {
+    {0x0900, Script::kDevanagari}, {0x0980, Script::kBengali},
+    {0x0A00, Script::kGurmukhi},   {0x0A80, Script::kGujarati},
+    {0x0B00, Script::kOdia},       {0x0B80, Script::kTamil},
+    {0x0C00, Script::kTelugu},     {0x0C80, Script::kKannada},
+    {0x0D00, Script::kMalayalam},
+};
+constexpr char16_t kIndicBlockSize = 0x80;
+constexpr char16_t kIndicNonLetterFirst = 0x64;
+constexpr char16_t kIndicNonLetterLast = 0x6F;
+
+constexpr bool InRange(char16_t c, char16_t first, char16_t last) {
+  return c >= first && c <= last;
+}
+
+// The script `c` is a letter (or a combining mark of a letter) of, or kOther
+// for everything else: digits, punctuation, joiners and scripts Tark does not
+// tell apart.
+Script LetterScript(char16_t c) {
+  if (c < 0x80) {
+    const bool is_letter = InRange(c, u'a', u'z') || InRange(c, u'A', u'Z');
+    return is_letter ? Script::kLatin : Script::kOther;
+  }
+  // Latin-1 Supplement and Latin Extended-A/B, minus the multiplication and
+  // division signs; Latin Extended Additional.
+  if (InRange(c, 0x00C0, 0x024F)) {
+    return (c == 0x00D7 || c == 0x00F7) ? Script::kOther : Script::kLatin;
+  }
+  if (InRange(c, 0x1E00, 0x1EFF)) {
+    return Script::kLatin;
+  }
+  for (const IndicBlock& block : kIndicBlocks) {
+    if (c >= block.first && c < block.first + kIndicBlockSize) {
+      const char16_t offset = static_cast<char16_t>(c - block.first);
+      if (InRange(offset, kIndicNonLetterFirst, kIndicNonLetterLast)) {
+        return Script::kOther;
+      }
+      return block.script;
+    }
+  }
+  // Devanagari Extended.
+  if (InRange(c, 0xA8E0, 0xA8FF)) {
+    return Script::kDevanagari;
+  }
+  // Arabic letters and diacritics: not the Arabic-Indic digits (0660-0669,
+  // 06F0-06F9), Arabic punctuation, or U+FEFF (the byte order mark).
+  if (InRange(c, 0x0620, 0x065F) || InRange(c, 0x066E, 0x06D3) || c == 0x06D5 ||
+      InRange(c, 0x06FA, 0x06FF) || InRange(c, 0x0750, 0x077F) ||
+      InRange(c, 0x08A0, 0x08FF) || InRange(c, 0xFB50, 0xFDFF) ||
+      InRange(c, 0xFE70, 0xFEFE)) {
+    return Script::kArabic;
+  }
+  // Meetei Mayek and Meetei Mayek Extensions, minus the digits (ABF0-ABF9)
+  // and the cheikhei punctuation (ABEB).
+  if ((InRange(c, 0xABC0, 0xABED) && c != 0xABEB) ||
+      InRange(c, 0xAAE0, 0xAAF6)) {
+    return Script::kMeeteiMayek;
+  }
+  return Script::kOther;
+}
+
+bool IsAsciiLetter(char16_t c) {
+  return InRange(c, u'a', u'z') || InRange(c, u'A', u'Z');
+}
+
+bool IsSeparator(char16_t c) {
+  return c == u' ' || InRange(c, 0x0009, 0x000D) || c == 0x0085 ||
+         c == 0x00A0 || c == 0x1680 || InRange(c, 0x2000, 0x200A) ||
+         c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F ||
+         c == 0x3000;
+}
+
+// Non-ASCII characters that are neither letters nor separators and so do not
+// stop a phrase from being transliterable: Latin-1 punctuation and symbols,
+// zero-width characters and general punctuation (quotes, dashes, ellipsis).
+bool IsHarmlessNonAscii(char16_t c) {
+  if (InRange(c, 0x00A1, 0x00BF)) {
+    // Not the letters ª (00AA), µ (00B5) and º (00BA).
+    return c != 0x00AA && c != 0x00B5 && c != 0x00BA;
+  }
+  return InRange(c, 0x200B, 0x200F) || InRange(c, 0x2010, 0x2027) ||
+         InRange(c, 0x2030, 0x205E);
+}
+
+char ToLowerAscii(char c) {
+  return (c >= 'A' && c <= 'Z') ? static_cast<char>(c - 'A' + 'a') : c;
+}
+
+// The lowercase primary language subtag of one accept-languages entry:
+// "HI-IN;q=0.9" -> "hi".
+std::string PrimarySubtag(std::string_view entry) {
+  const size_t semicolon = entry.find(';');
+  if (semicolon != std::string_view::npos) {
+    entry = entry.substr(0, semicolon);
+  }
+  while (!entry.empty() && (entry.front() == ' ' || entry.front() == '\t')) {
+    entry.remove_prefix(1);
+  }
+  while (!entry.empty() && (entry.back() == ' ' || entry.back() == '\t')) {
+    entry.remove_suffix(1);
+  }
+  const size_t dash = entry.find_first_of("-_");
+  if (dash != std::string_view::npos) {
+    entry = entry.substr(0, dash);
+  }
+  std::string subtag;
+  for (char c : entry) {
+    subtag.push_back(ToLowerAscii(c));
+  }
+  return subtag;
+}
+
+// The table entry for an accept-languages code or an IndicXlit tag, or null.
+const Language* FindLanguage(std::string_view code) {
+  for (const Language& language : kLanguages) {
+    if (language.accept_code == code || language.tag == code) {
+      return &language;
+    }
+  }
+  return nullptr;
+}
+
+// Every supported language in `accept_languages`, in order, each once.
+std::vector<const Language*> AcceptedLanguages(
+    std::string_view accept_languages) {
+  std::vector<const Language*> found;
+  std::string_view rest = accept_languages;
+  while (true) {
+    const size_t comma = rest.find(',');
+    const std::string code = PrimarySubtag(rest.substr(0, comma));
+    const Language* language = FindLanguage(code);
+    if (language) {
+      bool seen = false;
+      for (const Language* earlier : found) {
+        seen = seen || earlier == language;
+      }
+      if (!seen) {
+        found.push_back(language);
+      }
+    }
+    if (comma == std::string_view::npos) {
+      break;
+    }
+    rest.remove_prefix(comma + 1);
+  }
+  return found;
+}
+
+// Deliberate exclusion: Bodo (brx) has no live Wikipedia as of 2026-10, so
+// WikipediaLanguage skips it and a Bodo speaker is sent to the next accepted
+// language of the same script, or the script's default, instead of a host
+// that does not exist. To lift the exclusion, make this return true for brx
+// once brx.wikipedia.org is live.
+bool HasWikipedia(const Language& language) {
+  return language.tag != "brx";
+}
+
+std::string_view DefaultWikipediaLanguage(Script script) {
+  switch (script) {
+    case Script::kDevanagari:
+      return "hi";
+    case Script::kBengali:
+      return "bn";
+    case Script::kArabic:
+      return "ur";
+    case Script::kGurmukhi:
+      return "pa";
+    case Script::kGujarati:
+      return "gu";
+    case Script::kOdia:
+      return "or";
+    case Script::kTamil:
+      return "ta";
+    case Script::kTelugu:
+      return "te";
+    case Script::kKannada:
+      return "kn";
+    case Script::kMalayalam:
+      return "ml";
+    case Script::kMeeteiMayek:
+      return "mni";
+    case Script::kLatin:
+    case Script::kOther:
+      return "en";
+  }
+  return "en";
+}
+
+}  // namespace
+
+Script DominantScript(std::u16string_view text) {
+  std::array<size_t, static_cast<size_t>(Script::kOther)> counts = {};
+  for (char16_t c : text) {
+    const Script script = LetterScript(c);
+    if (script != Script::kOther) {
+      ++counts[static_cast<size_t>(script)];
+    }
+  }
+  // Non-Latin scripts first, with a strict comparison, so that on a tie the
+  // earliest non-Latin script beats Latin.
+  Script best = Script::kOther;
+  size_t best_count = 0;
+  for (size_t i = static_cast<size_t>(Script::kDevanagari);
+       i <= static_cast<size_t>(Script::kMeeteiMayek); ++i) {
+    if (counts[i] > best_count) {
+      best_count = counts[i];
+      best = static_cast<Script>(i);
+    }
+  }
+  if (counts[static_cast<size_t>(Script::kLatin)] > best_count) {
+    best = Script::kLatin;
+  }
+  return best;
+}
+
+base::span<const Language> AllLanguages() {
+  return base::span<const Language>(kLanguages);
+}
+
+std::vector<const Language*> RowLanguages(std::string_view accept_languages) {
+  std::vector<const Language*> rows = AcceptedLanguages(accept_languages);
+  if (rows.empty()) {
+    rows.push_back(FindLanguage("hi"));
+  }
+  if (rows.size() > kMaxRows) {
+    rows.resize(kMaxRows);
+  }
+  return rows;
+}
+
+bool LooksTransliterable(std::u16string_view text) {
+  size_t letters = 0;
+  size_t words = 0;
+  bool in_word = false;
+  for (char16_t c : text) {
+    if (IsSeparator(c)) {
+      in_word = false;
+      continue;
+    }
+    if (c < 0x80) {
+      if (IsAsciiLetter(c)) {
+        ++letters;
+      }
+    } else if (!IsHarmlessNonAscii(c)) {
+      return false;
+    }
+    if (!in_word) {
+      in_word = true;
+      ++words;
+    }
+  }
+  return letters >= kMinLetters && words <= kMaxWords;
+}
+
+std::string WikipediaLanguage(std::u16string_view query,
+                              std::string_view accept_languages) {
+  const Script script = DominantScript(query);
+  if (script == Script::kLatin || script == Script::kOther) {
+    return "en";
+  }
+  for (const Language* language : AcceptedLanguages(accept_languages)) {
+    if (language->script == script && HasWikipedia(*language)) {
+      return std::string(language->tag);
+    }
+  }
+  return std::string(DefaultWikipediaLanguage(script));
+}
+
+}  // namespace tark_xlit
