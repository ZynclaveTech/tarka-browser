+TEST(TarkXlitLanguagesTest, RowLanguagesIgnoresRegionsQualityAndCase) {
+  EXPECT_EQ((std::vector<std::string>{"hi", "bn"}),
+            Tags(RowLanguages("en-US, HI-IN;q=0.9, bn_BD ;q=0.8")));
+}
+
+TEST(TarkXlitLanguagesTest, RowLanguagesDeduplicates) {
+  EXPECT_EQ((std::vector<std::string>{"hi", "ta"}),
+            Tags(RowLanguages("hi,hi-IN,ta,hi")));
+  // kok and gom are the same language.
+  EXPECT_EQ((std::vector<std::string>{"gom", "hi"}),
+            Tags(RowLanguages("kok,gom,hi")));
+}
