+}  // namespace
+
+TEST(TarkXlitModelTest, LoadsTestModel) {
+  EXPECT_TRUE(TestModel());
+}
+
+TEST(TarkXlitModelTest, LoadRejectsBadMagic) {
+  const std::vector<uint8_t> good = ReadTestData("xlit-model.bin");
+  ASSERT_FALSE(good.empty());
+
+  std::vector<uint8_t> bytes = good;
+  bytes[0] = 'X';
+  EXPECT_FALSE(Model::Load(bytes));
+
+  // Version 2 of the format.
+  bytes = good;
+  bytes[4] = 2;
+  EXPECT_FALSE(Model::Load(bytes));
+
+  // A word list is not a model.
+  EXPECT_FALSE(Model::Load(PackWordList({{"hi", {{"a", 1}}}})));
+  EXPECT_FALSE(Model::Load(base::span<const uint8_t>()));
+}
+
+TEST(TarkXlitModelTest, LoadRejectsTruncated) {
+  const std::vector<uint8_t> good = ReadTestData("xlit-model.bin");
+  ASSERT_GT(good.size(), 4096u);
+
+  // The last tensor ends exactly at the end of the file.
+  for (size_t size : {good.size() - 1, good.size() / 2, size_t{4096},
+                      size_t{100}, size_t{12}, size_t{8}}) {
+    EXPECT_FALSE(Model::Load(base::span(good).first(size))) << size;
+  }
+
+  // A header length that runs past the end.
+  std::vector<uint8_t> bytes = good;
+  bytes[11] = 0x7F;
+  EXPECT_FALSE(Model::Load(bytes));
+}
+
+TEST(TarkXlitModelTest, LoadRejectsNonFiniteWeights) {
+  const std::vector<uint8_t> good = ReadTestData("xlit-model.bin");
+  ASSERT_GT(good.size(), 4096u);
+  // The first weight of the first tensor is the first fp16 after the header.
+  const size_t data_start =
+      12 + base::U32FromLittleEndian(base::span(good).subspan(8u).first<4>());
+  ASSERT_LT(data_start + 2, good.size());
+
+  for (uint16_t half : {uint16_t{0x7C00}, uint16_t{0xFC00}, uint16_t{0x7E00}}) {
+    std::vector<uint8_t> bytes = good;
+    base::span(bytes)
+        .subspan(data_start)
+        .first<2>()
+        .copy_from(base::U16ToLittleEndian(half));
+    EXPECT_FALSE(Model::Load(bytes)) << half;
+  }
+  // The largest finite half is a weight like any other.
+  std::vector<uint8_t> bytes = good;
+  base::span(bytes)
+      .subspan(data_start)
+      .first<2>()
+      .copy_from(base::U16ToLittleEndian(0x7BFF));
+  EXPECT_TRUE(Model::Load(bytes));
+}
+
+TEST(TarkXlitModelTest, RejectsWordsItCannotTake) {
+  const Model* model = TestModel();
+  ASSERT_TRUE(model);
+  EXPECT_TRUE(model->Transliterate("", "hi").empty());
+  EXPECT_TRUE(model->Transliterate("Namaste", "hi").empty());
+  EXPECT_TRUE(model->Transliterate("nama ste", "hi").empty());
+  EXPECT_TRUE(model->Transliterate("covid19", "hi").empty());
+  // 33 letters.
+  EXPECT_TRUE(
+      model->Transliterate("abcdefghijklmnopqrstuvwxyzabcdefg", "hi").empty());
+  // Not a language of the model; English is a source tag, not a target.
+  EXPECT_TRUE(model->Transliterate("namaste", "xx").empty());
+  EXPECT_TRUE(model->Transliterate("namaste", "en").empty());
+  EXPECT_TRUE(model->Transliterate("namaste", "").empty());
+
+  // 32 letters is still taken.
+  EXPECT_FALSE(
+      model->Transliterate("abcdefghijklmnopqrstuvwxyzabcdef", "hi").empty());
+}
+
+TEST(TarkXlitModelTest, MatchesGoldens) {
+  const Model* model = TestModel();
+  ASSERT_TRUE(model);
+  std::string golden;
+  ASSERT_TRUE(base::ReadFileToString(TestDataPath("golden.tsv"), &golden));
+
+  size_t lines = 0;
+  std::vector<std::string> mismatches;
+  for (std::string_view line : base::SplitStringPiece(
+           golden, "\n", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    const std::vector<std::string_view> fields = base::SplitStringPiece(
+        line, "\t", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    ASSERT_GE(fields.size(), 3u) << line;
+    ++lines;
+    std::vector<GoldenCandidate> want;
+    for (size_t i = 2; i < fields.size(); ++i) {
+      const size_t bar = fields[i].rfind('|');
+      ASSERT_NE(std::string_view::npos, bar) << line;
+      GoldenCandidate candidate;
+      candidate.text = std::string(fields[i].substr(0, bar));
+      ASSERT_TRUE(
+          base::StringToDouble(fields[i].substr(bar + 1), &candidate.score))
+          << line;
+      want.push_back(std::move(candidate));
+    }
+    const std::string problem =
+        Compare(want, model->Transliterate(fields[1], fields[0]));
+    if (!problem.empty()) {
+      mismatches.push_back(std::string(fields[0]) + " " +
+                           std::string(fields[1]) + ": " + problem);
+    }
+  }
+
+  EXPECT_EQ(kGoldenLines, lines);
+  std::string report;
+  for (const std::string& mismatch : mismatches) {
+    report += "\n  " + mismatch;
+  }
+  EXPECT_TRUE(mismatches.empty()) << mismatches.size() << " of " << lines
+                                  << " golden lines do not match:" << report;
+}
+
+TEST(TarkXlitModelTest, WordListCounts) {
+  const std::vector<uint8_t> bytes =
+      PackWordList({{"hi", {{"नमस्ते", 301}, {"सीता", 1612}, {"कृष्ण", 0}}},
+                    {"en", {{"school", 0}, {"the", 0}}}});
+  std::unique_ptr<WordList> list = WordList::Load(bytes);
+  ASSERT_TRUE(list);
+
+  EXPECT_EQ(301u, list->Count("hi", u"नमस्ते"));
+  EXPECT_EQ(1612u, list->Count("hi", u"सीता"));
+  EXPECT_EQ(0u, list->Count("hi", u"कृष्ण"));
+  EXPECT_FALSE(list->Count("hi", u"सिता").has_value());
+  EXPECT_FALSE(list->Count("hi", u"").has_value());
+  EXPECT_FALSE(list->Count("ta", u"नमस्ते").has_value());
+  EXPECT_TRUE(list->HasLanguage("hi"));
+  EXPECT_FALSE(list->HasLanguage("ta"));
+
+  EXPECT_TRUE(list->IsCommonEnglish("school"));
+  EXPECT_TRUE(list->IsCommonEnglish("the"));
+  EXPECT_FALSE(list->IsCommonEnglish("namaste"));
+  EXPECT_FALSE(list->IsCommonEnglish(""));
+}
+
+TEST(TarkXlitModelTest, WordListLoadRejectsBadInput) {
+  const std::vector<uint8_t> good = PackWordList({{"hi", {{"नमस्ते", 301}}}});
+  ASSERT_TRUE(WordList::Load(good));
+
+  std::vector<uint8_t> bytes = good;
+  bytes[3] = 'M';
+  EXPECT_FALSE(WordList::Load(bytes));
+  bytes = good;
+  bytes[4] = 2;
+  EXPECT_FALSE(WordList::Load(bytes));
+  EXPECT_FALSE(WordList::Load(base::span<const uint8_t>()));
+  // The record-offset table runs past the end (the file is 512 bytes of
+  // header, a 4-byte record-offset table and a 24-byte record).
+  ASSERT_EQ(540u, good.size());
+  EXPECT_FALSE(WordList::Load(base::span(good).first(514u)));
+  // A model is not a word list.
+  EXPECT_FALSE(WordList::Load(ReadTestData("xlit-model.bin")));
+}
+
+TEST(TarkXlitModelTest, WordListFromMappedFile) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::unique_ptr<WordList> list =
+      LoadMapped(dir, PackWordList({{"hi", {{"नमस्ते", 301}, {"सीता", 1612}}},
+                                    {"en", {{"the", 0}}}}));
+  ASSERT_TRUE(list);
+  EXPECT_EQ(301u, list->Count("hi", u"नमस्ते"));
+  EXPECT_EQ(1612u, list->Count("hi", u"सीता"));
+  EXPECT_FALSE(list->Count("hi", u"सिता").has_value());
+  EXPECT_FALSE(list->Count("ta", u"नमस्ते").has_value());
+  EXPECT_TRUE(list->IsCommonEnglish("the"));
+  EXPECT_FALSE(list->IsCommonEnglish("namaste"));
+
+  EXPECT_FALSE(WordList::Load(std::unique_ptr<base::MemoryMappedFile>()));
+  EXPECT_FALSE(WordList::Load(std::make_unique<base::MemoryMappedFile>()));
+  EXPECT_FALSE(LoadMapped(dir, ReadTestData("xlit-model.bin")));
+}
+
+TEST(TarkXlitModelTest, WordListCorruptRecordIsNotFound) {
+  // Records are only checked when a lookup reaches them; a bad one reads as
+  // "not found", never as a crash. The file is 512 bytes of header, then the
+  // "hi" block: three record offsets (12 bytes) and three 9-byte records.
+  const std::vector<uint8_t> good =
+      PackWordList({{"hi", {{"क", 1}, {"ख", 2}, {"ग", 3}}}});
+  ASSERT_EQ(512u + 12u + 3u * 9u + 1u, good.size());
+  constexpr size_t kTable = 512;
+  constexpr size_t kLastRecord = kTable + 12 + 2 * 9;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+
+  // The middle record's offset (the first one a search reads) points far
+  // past the end.
+  std::vector<uint8_t> bytes = good;
+  base::span(bytes)
+      .subspan(kTable + 4)
+      .first<4>()
+      .copy_from(base::U32ToLittleEndian(0xFFFFFF00u));
+  std::unique_ptr<WordList> list = LoadMapped(dir, bytes);
+  ASSERT_TRUE(list);
+  EXPECT_FALSE(list->Count("hi", u"क").has_value());
+  EXPECT_FALSE(list->Count("hi", u"ख").has_value());
+  EXPECT_FALSE(list->Count("hi", u"ग").has_value());
+
+  // The last record's length runs past the end; the others are still found.
+  bytes = good;
+  base::span(bytes)
+      .subspan(kLastRecord + 4)
+      .first<2>()
+      .copy_from(base::U16ToLittleEndian(0xFFFF));
+  list = LoadMapped(dir, bytes);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(2u, list->Count("hi", u"ख"));
+  EXPECT_FALSE(list->Count("hi", u"ग").has_value());
+
+  // The same through the copying loader, and a record cut off by the end of
+  // the blob.
+  list = WordList::Load(bytes);
+  ASSERT_TRUE(list);
+  EXPECT_FALSE(list->Count("hi", u"ग").has_value());
+  list = WordList::Load(base::span(good).first(good.size() - 2));
+  ASSERT_TRUE(list);
+  EXPECT_EQ(1u, list->Count("hi", u"क"));
+  EXPECT_FALSE(list->Count("hi", u"ग").has_value());
+}
+
+TEST(TarkXlitModelTest, RealWordListLoads) {
+  const WordList* list = TestWordList();
+  ASSERT_TRUE(list);
+  EXPECT_EQ(301u, list->Count("hi", u"नमस्ते"));
+  EXPECT_TRUE(list->IsCommonEnglish("the"));
+  EXPECT_FALSE(list->IsCommonEnglish("namaste"));
+}
+
+TEST(TarkXlitModelTest, RescorePrefersListedWord) {
+  const std::vector<uint8_t> bytes = PackWordList({{"hi", {{"सीता", 10}}}});
+  std::unique_ptr<WordList> list = WordList::Load(bytes);
+  ASSERT_TRUE(list);
+
+  const std::vector<Candidate> rescored =
+      Rescore(Candidates({{u"सिता", 0.6}, {u"सीता", 0.4}}), list.get(), "hi");
+  EXPECT_EQ((std::vector<std::u16string>{u"सीता", u"सिता"}), Texts(rescored));
+  // The scores stay the model's.
+  ASSERT_EQ(2u, rescored.size());
+  EXPECT_DOUBLE_EQ(0.4, rescored[0].score);
+  EXPECT_DOUBLE_EQ(0.6, rescored[1].score);
+}
+
+TEST(TarkXlitModelTest, RescoreWeighsModelAndCounts) {
+  // F = 0.9 * score / 1.0 + 0.1 * count / 100: 0.9*0.5 + 0.1*0.1 = 0.46 for
+  // the first, 0.9*0.3 + 0.1*0.9 = 0.36 for the second; the third is not in
+  // the list (0).
+  const std::vector<uint8_t> bytes =
+      PackWordList({{"hi", {{"क", 10}, {"ख", 90}}}});
+  std::unique_ptr<WordList> list = WordList::Load(bytes);
+  ASSERT_TRUE(list);
+  EXPECT_EQ((std::vector<std::u16string>{u"क", u"ख", u"ग"}),
+            Texts(Rescore(Candidates({{u"ग", 0.2}, {u"ख", 0.3}, {u"क", 0.5}}),
+                          list.get(), "hi")));
+  // A count heavy enough outweighs the model: 0.9*0.45 + 0.1*0.01 = 0.406
+  // against 0.9*0.35 + 0.1*0.99 = 0.414.
+  const std::vector<uint8_t> heavy =
+      PackWordList({{"hi", {{"क", 1}, {"ख", 99}}}});
+  list = WordList::Load(heavy);
+  ASSERT_TRUE(list);
+  EXPECT_EQ((std::vector<std::u16string>{u"ख", u"क", u"ग"}),
+            Texts(Rescore(Candidates({{u"क", 0.45}, {u"ख", 0.35}, {u"ग", 0.2}}),
+                          list.get(), "hi")));
+}
+
+TEST(TarkXlitModelTest, RescoreNoListKeepsOrder) {
+  const std::vector<Candidate> candidates =
+      Candidates({{u"सिता", 0.6}, {u"सीता", 0.4}, {u"सिटा", 0.3}});
+  const std::vector<std::u16string> model_order = Texts(candidates);
+
+  EXPECT_EQ(model_order, Texts(Rescore(candidates, nullptr, "hi")));
+
+  // A list without the language.
+  const std::vector<uint8_t> bytes = PackWordList({{"ta", {{"சீதா", 10}}}});
+  std::unique_ptr<WordList> list = WordList::Load(bytes);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(model_order, Texts(Rescore(candidates, list.get(), "hi")));
+
+  // A list with the language but none of the candidates: all score 0, and the
+  // sort is stable.
+  const std::vector<uint8_t> other = PackWordList({{"hi", {{"राम", 10}}}});
+  list = WordList::Load(other);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(model_order, Texts(Rescore(candidates, list.get(), "hi")));
+
+  EXPECT_TRUE(Rescore({}, list.get(), "hi").empty());
+}
+
+TEST(TarkXlitModelTest, NamasteIsNamaste) {
+  const Model* model = TestModel();
+  ASSERT_TRUE(model);
+  const WordList* list = TestWordList();
+  ASSERT_TRUE(list);
+
+  std::vector<Candidate> rescored =
+      Rescore(model->Transliterate("namaste", "hi"), list, "hi");
+  ASSERT_FALSE(rescored.empty());
+  EXPECT_EQ(u"नमस्ते", rescored[0].text);
+
+  // The list fixes spellings the model ranks second (both are in the
+  // goldens): सिता → सीता, धान्यवाद → धन्यवाद.
+  std::vector<Candidate> sita = model->Transliterate("sita", "hi");
+  ASSERT_FALSE(sita.empty());
+  EXPECT_EQ(u"सिता", sita[0].text);
+  rescored = Rescore(std::move(sita), list, "hi");
+  EXPECT_EQ(u"सीता", rescored[0].text);
+
+  rescored = Rescore(model->Transliterate("dhanyavad", "mr"), list, "mr");
+  ASSERT_FALSE(rescored.empty());
+  EXPECT_EQ(u"धन्यवाद", rescored[0].text);
+}
