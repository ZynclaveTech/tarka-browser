+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <Accelerate/Accelerate.h>
+
+#include "components/tark_xlit/blas.h"
+
+namespace tark_xlit::blas {
+
+void GemmNT(int m,
+            int n,
+            int k,
+            const float* a,
+            int lda,
+            const float* b,
+            int ldb,
+            float beta,
+            float* c,
+            int ldc) {
+  cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasTrans, m, n, k, 1.0f, a, lda,
+              b, ldb, beta, c, ldc);
+}
+
+void Gemv(int m, int n, const float* a, int lda, const float* x, float* y) {
+  cblas_sgemv(CblasRowMajor, CblasNoTrans, m, n, 1.0f, a, lda, x, 1, 0.0f, y,
+              1);
+}
+
+void GemvT(int m, int n, const float* a, int lda, const float* x, float* y) {
+  cblas_sgemv(CblasRowMajor, CblasTrans, m, n, 1.0f, a, lda, x, 1, 0.0f, y, 1);
+}
+
+}  // namespace tark_xlit::blas
