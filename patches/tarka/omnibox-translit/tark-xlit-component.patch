+TEST(TarkXlitTransliteratorTest, MarathiCandraAIsNormalisedBeforeRescoring) {
+  // "ॲक्टीव" is in the Marathi list; its अॅ spelling is not. The model's
+  // first candidate is in neither form of anything. Without the
+  // normalisation both would score zero and the first would win.
+  FakeModel fake;
+  fake.answer = base::BindLambdaForTesting(
+      [](std::string_view, std::string_view) {
+        return std::vector<Candidate>{Candidate{u"ठठठ", 0.9},
+                                      Candidate{u"अॅक्टीव", 0.1}};
+      });
+  Transliterator transliterator(fake.Callback(), LoadTestWords());
+  EXPECT_EQ(Convert(&transliterator, u"aktiv", "mr"), "ॲक्टीव");
+  // Only Marathi's spelling is normalised.
+  EXPECT_EQ(Convert(&transliterator, u"aktiv", "hi"), "ठठठ");
+}
