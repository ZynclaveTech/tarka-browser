+#include "base/memory/ref_counted.h"
+#include "components/tark_xlit/model.h"
+#include "components/tark_xlit/word_list.h"
+
+namespace base {
+class FilePath;
+}  // namespace base
+
+namespace tark_xlit {
+
+// The model and the word lists, loaded once and shared read-only by any number
+// of Transliterators, each of which keeps its own cache. Model::Transliterate()
+// and the WordList lookups are const and keep no mutable state, so one
+// Resources may be used from several sequences at once.
+struct Resources : public base::RefCountedThreadSafe<Resources> {
+  // `model` must not be null. `words` may be null (no English words, no
+  // rescoring).
+  Resources(std::unique_ptr<const Model> model,
+            std::unique_ptr<const WordList> words);
+  Resources(const Resources&) = delete;
+  Resources& operator=(const Resources&) = delete;
+
+  const std::unique_ptr<const Model> model;
+  const std::unique_ptr<const WordList> words;
+
+ private:
+  friend class base::RefCountedThreadSafe<Resources>;
+  ~Resources();
+};
+
+// Turns a typed phrase such as "heart attack ke lakshan" into the phrase in an
+// Indian script ("heart attack के लक्षण"): English words stay as typed, the
+// rest are transliterated word by word with the model, and the model's
+// candidates are rescored with the word lists.
+//
+// Not thread-safe: Phrase() fills a cache. Use one instance on one sequence.
+class Transliterator {
+ public:
+  // The per-word transliteration: up to four candidates for `word` (lower-case
+  // letters a-z) in the language `tag`, best first, as Model::Transliterate
+  // gives them.
+  using WordFunction = base::RepeatingCallback<
+      std::vector<Candidate>(std::string_view word, std::string_view tag)>;
+
+  // Uses the shared `resources`, which must not be null, and keeps them alive.
+  explicit Transliterator(scoped_refptr<const Resources> resources);
+
+  // `model` must not be null. `words` may be null, in which case no word is
+  // treated as English and the candidates are not rescored.
+  Transliterator(std::unique_ptr<Model> model,
+                 std::unique_ptr<WordList> words);
+
+  // For tests: `word_function` stands in for the model.
+  Transliterator(WordFunction word_function, std::unique_ptr<WordList> words);
+
+  Transliterator(const Transliterator&) = delete;
+  Transliterator& operator=(const Transliterator&) = delete;
+  ~Transliterator();
+
+  // `input` written in the script of the language `tag` (an IndicXlit tag
+  // such as "hi"). Each run of Latin letters is a word, lower-cased for the
+  // model; every other character (spaces, digits, punctuation) stays where it
+  // is. A word on the common-English list stays as typed. Any other word
+  // becomes the best of the model's candidates after rescoring, with candidates
+  // that spell out a special symbol ("<unk>") left out and, for Marathi, अॅ
+  // written as the corpus writes it, ॲ. A word with no candidate stays as
+  // typed.
+  //
+  // nullopt when `input` does not look like transliterable Latin text
+  // (LooksTransliterable) or when nothing in it changed.
+  std::optional<std::u16string> Phrase(std::u16string_view input,
+                                       std::string_view tag);
+
+  size_t cache_size_for_testing() const { return cache_.size(); }
+
+ private:
+  // The script text for `word` (lower-case a-z), or empty when the model has
+  // none. Cached per (tag, word).
+  std::u16string Word(std::string_view word, std::string_view tag);
+  std::u16string ComputeWord(std::string_view word, std::string_view tag) const;
+
+  // The model and words, unless this instance was made with a WordFunction;
+  // then `own_words_` holds the words. `word_function_` calls the model.
+  scoped_refptr<const Resources> resources_;
+  std::unique_ptr<const WordList> own_words_;
+  // The word lists in use, from `resources_` or `own_words_`; may be null.
+  // Declared after both so that it is destroyed first.
+  raw_ptr<const WordList> words_;
+  WordFunction word_function_;
+  // "<tag> <word>" -> text, empty for a word the model could not do. Emptied
+  // when it reaches kMaxCacheEntries.
+  std::unordered_map<std::string, std::u16string> cache_;
+};
+
+// The model and word lists in `directory` (xlit-model.bin and
+// xlit-words.bin), or nullptr if either is missing or not valid. The word
+// lists are memory-mapped; the model is read and converted, and its file is
+// closed again. This blocks on file IO and converts the whole model (tens of
+// milliseconds with a warm disk cache on a development Mac, more on a cold
+// start): call it where blocking is allowed (a thread pool task with
+// MayBlock), never on the UI thread.
+scoped_refptr<Resources> LoadResourcesFromDirectory(
+    const base::FilePath& directory);
+
+// LoadResourcesFromDirectory() on indicxlit/ in the app's assets directory
+// (base::DIR_ASSETS, which in a bundled macOS app is the Resources directory of
+// the framework bundle, FrameworkBundlePath()/Resources, not the app's
+// Contents/Resources). Same threading rules.
+scoped_refptr<Resources> LoadResourcesFromBundle();
+
+// A Transliterator over LoadResourcesFromDirectory(`directory`), or nullptr.
+// Same threading rules.
+std::unique_ptr<Transliterator> LoadFromDirectory(
+    const base::FilePath& directory);
+
+// A Transliterator over LoadResourcesFromBundle(), or nullptr. Same threading
+// rules.
+std::unique_ptr<Transliterator> LoadFromBundle();
+
+}  // namespace tark_xlit
+
+#endif  // COMPONENTS_TARK_XLIT_TRANSLITERATOR_H_
