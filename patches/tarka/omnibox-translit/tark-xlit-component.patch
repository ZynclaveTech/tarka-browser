+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_xlit/blas.h"
+
+#include "third_party/eigen3/src/Eigen/Core"
+
+namespace tark_xlit::blas {
+
+namespace {
+
+using RowMajor =
+    Eigen::Matrix<float, Eigen::Dynamic, Eigen::Dynamic, Eigen::RowMajor>;
+using ConstMatrix = Eigen::Map<const RowMajor, 0, Eigen::OuterStride<>>;
+using Matrix = Eigen::Map<RowMajor, 0, Eigen::OuterStride<>>;
+
+}  // namespace
+
+void GemmNT(int m,
+            int n,
+            int k,
+            const float* a,
+            int lda,
+            const float* b,
+            int ldb,
+            float beta,
+            float* c,
+            int ldc) {
+  const ConstMatrix am(a, m, k, Eigen::OuterStride<>(lda));
+  const ConstMatrix bm(b, n, k, Eigen::OuterStride<>(ldb));
+  Matrix cm(c, m, n, Eigen::OuterStride<>(ldc));
+  if (beta == 0.0f) {
+    cm.noalias() = am * bm.transpose();
+  } else {
+    cm.noalias() += am * bm.transpose();
+  }
+}
+
+void Gemv(int m, int n, const float* a, int lda, const float* x, float* y) {
+  const ConstMatrix am(a, m, n, Eigen::OuterStride<>(lda));
+  Eigen::Map<Eigen::VectorXf>(y, m).noalias() =
+      am * Eigen::Map<const Eigen::VectorXf>(x, n);
+}
+
+void GemvT(int m, int n, const float* a, int lda, const float* x, float* y) {
+  const ConstMatrix am(a, m, n, Eigen::OuterStride<>(lda));
+  Eigen::Map<Eigen::VectorXf>(y, n).noalias() =
+      am.transpose() * Eigen::Map<const Eigen::VectorXf>(x, m);
+}
+
+}  // namespace tark_xlit::blas
