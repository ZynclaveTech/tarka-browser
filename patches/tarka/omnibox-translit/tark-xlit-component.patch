+#ifndef COMPONENTS_TARK_XLIT_BLAS_H_
+#define COMPONENTS_TARK_XLIT_BLAS_H_
+
+// The three matrix products the model needs, row-major, single precision.
+// blas_accelerate.cc implements them with Apple's Accelerate (macOS),
+// blas_eigen.cc with Eigen (every other platform).
+namespace tark_xlit::blas {
+
+// c[m x n] = a[m x k] * b[n x k]^T + beta * c (beta is 0 or 1).
+void GemmNT(int m,
+            int n,
+            int k,
+            const float* a,
+            int lda,
+            const float* b,
+            int ldb,
+            float beta,
+            float* c,
+            int ldc);
+
+// y[m] = a[m x n] * x[n].
+void Gemv(int m, int n, const float* a, int lda, const float* x, float* y);
+
+// y[n] = a[m x n]^T * x[m].
+void GemvT(int m, int n, const float* a, int lda, const float* x, float* y);
+
+}  // namespace tark_xlit::blas
+
+#endif  // COMPONENTS_TARK_XLIT_BLAS_H_
