+TEST(TarkXlitTransliteratorTest, SharedResourcesSeparateCaches) {
+  scoped_refptr<const Resources> resources =
+      LoadResourcesFromDirectory(TestDataDir());
+  ASSERT_TRUE(resources);
+
+  Transliterator first(resources);
+  auto second = std::make_unique<Transliterator>(resources);
+  EXPECT_FALSE(resources->HasOneRef());
+
+  // A phrase fills only the cache of the instance that worked it out.
+  EXPECT_EQ(Convert(&first, u"namaste", "hi"), "नमस्ते");
+  EXPECT_EQ(first.cache_size_for_testing(), 1u);
+  EXPECT_EQ(second->cache_size_for_testing(), 0u);
+  EXPECT_EQ(Convert(second.get(), u"ke lakshan", "hi"), "के लक्षण");
+  EXPECT_EQ(second->cache_size_for_testing(), 2u);
+  EXPECT_EQ(first.cache_size_for_testing(), 1u);
+
+  // Each instance keeps the resources alive on its own: a word `first` has not
+  // cached still reaches the model.
+  second.reset();
+  resources = nullptr;
+  EXPECT_EQ(Convert(&first, u"lakshan", "hi"), "लक्षण");
+  EXPECT_EQ(first.cache_size_for_testing(), 2u);
+}
