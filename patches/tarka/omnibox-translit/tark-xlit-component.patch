+TEST(TarkXlitLanguagesTest, LooksTransliterable) {
+  EXPECT_TRUE(LooksTransliterable(u"namaste"));
+  EXPECT_TRUE(LooksTransliterable(u"Namaste"));
+  EXPECT_TRUE(LooksTransliterable(u"heart attack ke lakshan"));
+  EXPECT_TRUE(LooksTransliterable(u"covid-19 ke lakshan"));
+  EXPECT_TRUE(LooksTransliterable(u"  namaste  "));
+}
+
+TEST(TarkXlitLanguagesTest, LooksTransliterableRejects) {
+  EXPECT_FALSE(LooksTransliterable(u""));
+  EXPECT_FALSE(LooksTransliterable(u"n"));
+  EXPECT_FALSE(LooksTransliterable(u"2024 7"));
+  EXPECT_FALSE(LooksTransliterable(u"नमस्ते"));
+  EXPECT_FALSE(LooksTransliterable(u"namaste नमस्ते"));
+  EXPECT_FALSE(LooksTransliterable(u"café"));
+}
+
+TEST(TarkXlitLanguagesTest, LooksTransliterableWordLimit) {
+  EXPECT_TRUE(LooksTransliterable(u"a b c d e f g h i j k l"));
+  EXPECT_TRUE(LooksTransliterable(u"aa bb cc dd ee ff gg hh ii jj kk ll"));
+  EXPECT_FALSE(LooksTransliterable(u"aa bb cc dd ee ff gg hh ii jj kk ll mm"));
+  // Runs of whitespace do not make extra words.
+  EXPECT_TRUE(LooksTransliterable(
+      u"aa  bb   cc dd ee ff gg hh ii jj kk\tll"));
+}
+
+TEST(TarkXlitLanguagesTest, WikipediaLanguage) {
+  EXPECT_EQ("mr", WikipediaLanguage(u"ताज महल", "en,mr"));
+  EXPECT_EQ("hi", WikipediaLanguage(u"ताज महल", "en"));
+  EXPECT_EQ("ta", WikipediaLanguage(u"தாஜ் மஹால்", "en"));
+  EXPECT_EQ("en", WikipediaLanguage(u"taj mahal", "hi"));
+}
+
+TEST(TarkXlitLanguagesTest, WikipediaLanguageNoLettersIsEnglish) {
+  EXPECT_EQ("en", WikipediaLanguage(u"", "hi"));
+  EXPECT_EQ("en", WikipediaLanguage(u"2024", "hi,ta"));
+}
+
+TEST(TarkXlitLanguagesTest, WikipediaLanguageScriptDefaults) {
+  EXPECT_EQ("hi", WikipediaLanguage(u"नमस्ते", ""));
+  EXPECT_EQ("bn", WikipediaLanguage(u"বাংলা", "en"));
+  EXPECT_EQ("ur", WikipediaLanguage(u"اردو", "en"));
+  EXPECT_EQ("pa", WikipediaLanguage(u"ਪੰਜਾਬੀ", "en"));
+  EXPECT_EQ("gu", WikipediaLanguage(u"ગુજરાતી", "en"));
+  EXPECT_EQ("or", WikipediaLanguage(u"ଓଡ଼ିଆ", "en"));
+  EXPECT_EQ("te", WikipediaLanguage(u"తెలుగు", "en"));
+  EXPECT_EQ("kn", WikipediaLanguage(u"ಕನ್ನಡ", "en"));
+  EXPECT_EQ("ml", WikipediaLanguage(u"മലയാളം", "en"));
+  EXPECT_EQ("mni", WikipediaLanguage(u"ꯃꯤꯇꯩꯂꯣꯟ", "en"));
+}
+
+TEST(TarkXlitLanguagesTest, WikipediaLanguageSkipsBodoWhichHasNoWikipedia) {
+  // Deliberate: no live Bodo Wikipedia as of 2026-10.
+  EXPECT_EQ("hi", WikipediaLanguage(u"बर", "brx"));
+  EXPECT_EQ("mr", WikipediaLanguage(u"ताज महल", "brx,mr"));
+}
+
+TEST(TarkXlitLanguagesTest, WikipediaLanguagePrefersAcceptOrderWithinScript) {
+  // Marathi comes before Hindi in the list, both are Devanagari.
+  EXPECT_EQ("mr", WikipediaLanguage(u"ताज महल", "en,mr,hi"));
+  EXPECT_EQ("hi", WikipediaLanguage(u"ताज महल", "hi-IN,mr"));
