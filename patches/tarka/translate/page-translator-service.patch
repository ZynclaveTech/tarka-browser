+module media.mojom;
+
+// Tark: translates a web page's sentences on the computer, in the speech
+// recognition utility process (the captions' engine). Bound by the browser
+// through SpeechRecognitionService.BindTarkPageTranslator.
+interface TarkPageTranslator {
+  // `sentences` in `source` ("hi", "ta", "bn", "en", "es") into `target`
+  // ("en", "hi", "ta", "bn"); Indian and Spanish pairs go through English.
+  // `translations` has one entry per sentence, in order. `ok` is false when
+  // the pair has no model or a model fails; `missing` then names the model
+  // folders not on the computer ("it2_indic_en", "it2_en_indic",
+  // "opus_es_en").
+  Translate(array<string> sentences, string source, string target)
+      => (bool ok, array<string> translations, array<string> missing);
+};
