+constexpr const char* kTargets[] = {"en", "hi", "ta", "bn"};
+
+std::u16string NameInEnglishUi(const std::string& code) {
+  return l10n_util::GetDisplayNameForLocale(code, g_browser_process->GetApplicationLocale(),
+                                            /*is_for_ui=*/true);
+}
+
+std::u16string NameInItself(const std::string& code) {
+  return l10n_util::GetDisplayNameForLocale(code, code, /*is_for_ui=*/true);
+}
+
+tark_captions::PageStep StepOf(translate::TranslateStep step, translate::TranslateErrors error) {
+  if (error != translate::TranslateErrors::NONE ||
+      step == translate::TRANSLATE_STEP_TRANSLATE_ERROR) {
+    return tark_captions::PageStep::kError;
+  }
+  switch (step) {
+    case translate::TRANSLATE_STEP_TRANSLATING:
+      return tark_captions::PageStep::kTranslating;
+    case translate::TRANSLATE_STEP_AFTER_TRANSLATE:
+      return tark_captions::PageStep::kAfter;
+    default:
+      return tark_captions::PageStep::kBefore;
+  }
+}
+
+// The bar's state and actions; outlives no tab (the infobar owns it).
+class BarDelegate : public infobars::InfoBarDelegate {
+ public:
+  BarDelegate(content::WebContents* web_contents,
+              const std::string& source,
+              const std::string& target)
+      : web_contents_(web_contents), source_(source), target_(target) {
+    ResetUiDelegate();
+  }
+
+  // infobars::InfoBarDelegate:
+  InfoBarIdentifier GetIdentifier() const override {
+    // Chromium's (Android) translate infobar id: one translate bar per tab.
+    return TRANSLATE_INFOBAR_DELEGATE_NON_AURA;
+  }
+  void InfoBarDismissed() override {
+    if (ui_delegate_) {
+      ui_delegate_->OnUIClosedByUser();
+    }
+  }
+
+  const std::string& source() const { return source_; }
+  const std::string& target() const { return target_; }
+  tark_captions::PageStep step() const { return step_; }
+
+  void SetState(const std::string& source,
+                const std::string& target,
+                tark_captions::PageStep step) {
+    const bool languages_changed = source != source_ || target != target_;
+    source_ = source;
+    target_ = target;
+    step_ = step;
+    if (languages_changed) {
+      ResetUiDelegate();
+    }
+  }
+
+  std::vector<tark_captions::ModelUnit> Missing() const {
+    auto* helper = tark_captions::PageTranslateTabHelper::FromWebContents(web_contents_);
+    if (helper && !helper->missing().empty()) {
+      return helper->missing();
+    }
+    std::vector<tark_captions::ModelUnit> missing;
+    const std::optional<tark_captions::Target> t = tark_captions::TargetFromCode(target_);
+    std::vector<tark_captions::ModelUnit> units;
+    if (source_ != "en") {
+      units.push_back(tark_captions::ModelUnit::kToEnglish);
+    }
+    if (t && *t != tark_captions::Target::kEnglish && *t != tark_captions::Target::kNone) {
+      units.push_back(tark_captions::ModelUnit::kFromEnglish);
+    }
+    for (tark_captions::ModelUnit unit : units) {
+      if (!tark_captions::TarkCaptionModels().ready(unit)) {
+        missing.push_back(unit);
+      }
+    }
+    return missing;
+  }
+
+  void Translate() {
+    if (ui_delegate_) {
+      ui_delegate_->Translate();
+    }
+  }
+  void ShowOriginal() {
+    if (ui_delegate_) {
+      ui_delegate_->RevertTranslation();
+    }
+  }
+  void SetTarget(const std::string& target) {
+    target_ = target;
+    ResetUiDelegate();
+    Translate();
+  }
+  translate::TranslateUIDelegate* prefs() { return ui_delegate_.get(); }
+
+ private:
+  void ResetUiDelegate() {
+    ChromeTranslateClient* client = ChromeTranslateClient::FromWebContents(web_contents_);
+    ui_delegate_ = client ? std::make_unique<translate::TranslateUIDelegate>(
+                                client->GetTranslateManager()->GetWeakPtr(), source_, target_)
+                          : nullptr;
+  }
+
+  raw_ptr<content::WebContents> web_contents_;
+  std::string source_;
+  std::string target_;
+  tark_captions::PageStep step_ = tark_captions::PageStep::kBefore;
+  std::unique_ptr<translate::TranslateUIDelegate> ui_delegate_;
+};
+
+enum Command {
+  kAlways = 1,
+  kNever,
+  kNeverSite,
+  kTargetBase = 100,
+};
+
+class BarView : public InfoBarView,
+                public ui::SimpleMenuModel::Delegate,
+                public tark_captions::CaptionModelStore::Observer {
+ public:
+  explicit BarView(std::unique_ptr<BarDelegate> delegate) : InfoBarView(std::move(delegate)) {
+    from_ = AddContentChildView(CreateLabel(std::u16string()));
+    target_button_ = AddContentChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&BarView::ShowTargets, base::Unretained(this))));
+    original_ = AddContentChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&BarView::OnOriginal, base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_TARK_TRANSLATE_BAR_ORIGINAL)));
+    translated_ = AddContentChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&BarView::OnTranslated, base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_TARK_TRANSLATE_BAR_TRANSLATED)));
+    status_ = AddContentChildView(CreateLabel(std::u16string()));
+    download_ = AddContentChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&BarView::OnDownload, base::Unretained(this))));
+    download_->SetStyle(ui::ButtonStyle::kProminent);
+    auto options = std::make_unique<views::MdTextButton>(
+        base::BindRepeating(&BarView::ShowOptions, base::Unretained(this)),
+        l10n_util::GetStringUTF16(IDS_TARK_TRANSLATE_BAR_OPTIONS));
+    options_ = options.get();
+    AddViewBeforeCloseButton(std::move(options));
+    models_observation_ = true;
+    tark_captions::TarkCaptionModels().AddObserver(this);
+    Refresh();
+  }
+  ~BarView() override {
+    if (models_observation_) {
+      tark_captions::TarkCaptionModels().RemoveObserver(this);
+    }
+  }
+
+  void Refresh() {
+    BarDelegate* d = bar();
+    from_->SetText(l10n_util::GetStringFUTF16(IDS_TARK_TRANSLATE_BAR_FROM,
+                                              NameInItself(d->source())));
+    target_button_->SetText(NameInEnglishUi(d->target()) + u" ▾");
+    const std::vector<tark_captions::ModelUnit> missing = d->Missing();
+    bool downloading = false;
+    int64_t done = 0;
+    int64_t total = 0;
+    for (tark_captions::ModelUnit unit : missing) {
+      const tark_captions::CaptionModelStore::Status s =
+          tark_captions::TarkCaptionModels().status(unit);
+      downloading |= s.state == tark_captions::CaptionModelStore::State::kDownloading;
+      done += s.done;
+      total += tark_captions::UnitSize(unit);
+    }
+    const tark_captions::BarMode mode =
+        tark_captions::BarModeFor(d->step(), !missing.empty(), downloading);
+    const bool translated = mode == tark_captions::BarMode::kTranslated ||
+                            mode == tark_captions::BarMode::kTranslating;
+    original_->SetStyle(translated ? ui::ButtonStyle::kDefault : ui::ButtonStyle::kTonal);
+    translated_->SetStyle(translated ? ui::ButtonStyle::kTonal : ui::ButtonStyle::kDefault);
+    const bool ready = mode != tark_captions::BarMode::kNeedsDownload &&
+                       mode != tark_captions::BarMode::kDownloading;
+    original_->SetVisible(ready);
+    translated_->SetVisible(ready);
+    download_->SetVisible(mode == tark_captions::BarMode::kNeedsDownload);
+    download_->SetText(l10n_util::GetStringFUTF16(
+        IDS_TARK_TRANSLATE_BAR_DOWNLOAD,
+        base::NumberToString16(tark_captions::Megabytes(total))));
+    if (mode == tark_captions::BarMode::kDownloading) {
+      status_->SetText(l10n_util::GetStringFUTF16(
+          IDS_TARK_TRANSLATE_BAR_DOWNLOADING,
+          base::NumberToString16(total > 0 ? done * 100 / total : 0)));
+    } else if (mode == tark_captions::BarMode::kError) {
+      status_->SetText(l10n_util::GetStringUTF16(IDS_TARK_TRANSLATE_BAR_ERROR));
+    } else {
+      status_->SetText(std::u16string());
+    }
+    status_->SetVisible(!status_->GetText().empty());
+    InvalidateLayout();
+  }
+
+  // tark_captions::CaptionModelStore::Observer:
+  void OnModelStatusChanged(tark_captions::ModelUnit unit) override {
+    const bool was_missing = !bar()->Missing().empty();
+    Refresh();
+    // Downloaded while the bar waited: translate now.
+    if (was_missing && bar()->Missing().empty() &&
+        tark_captions::TarkCaptionModels().ready(unit)) {
+      bar()->Translate();
+    }
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override {
+    translate::TranslateUIDelegate* prefs = const_cast<BarView*>(this)->bar()->prefs();
+    if (!prefs) {
+      return false;
+    }
+    switch (command_id) {
+      case kAlways:
+        return prefs->ShouldAlwaysTranslate();
+      case kNever:
+        return prefs->IsLanguageBlocked();
+      case kNeverSite:
+        return prefs->IsSiteOnNeverPromptList();
+      default:
+        return false;
+    }
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id >= kTargetBase) {
+      bar()->SetTarget(kTargets[command_id - kTargetBase]);
+      Refresh();
+      return;
+    }
+    translate::TranslateUIDelegate* prefs = bar()->prefs();
+    if (!prefs) {
+      return;
+    }
+    switch (command_id) {
+      case kAlways: {
+        const bool on = !prefs->ShouldAlwaysTranslate();
+        prefs->SetAlwaysTranslate(on);
+        if (on) {
+          bar()->Translate();
+        }
+        break;
+      }
+      case kNever:
+        prefs->SetLanguageBlocked(!prefs->IsLanguageBlocked());
+        if (prefs->IsLanguageBlocked()) {
+          bar()->ShowOriginal();
+          RemoveSelf();
+        }
+        break;
+      case kNeverSite:
+        prefs->SetNeverPromptSite(!prefs->IsSiteOnNeverPromptList());
+        if (prefs->IsSiteOnNeverPromptList()) {
+          bar()->ShowOriginal();
+          RemoveSelf();
+        }
+        break;
+    }
+  }
+
+ private:
+  BarDelegate* bar() { return static_cast<BarDelegate*>(delegate()); }
+
+  void OnOriginal() {
+    bar()->ShowOriginal();
+    bar()->SetState(bar()->source(), bar()->target(), tark_captions::PageStep::kBefore);
+    Refresh();
+  }
+  void OnTranslated() {
+    bar()->Translate();
+    bar()->SetState(bar()->source(), bar()->target(), tark_captions::PageStep::kTranslating);
+    Refresh();
+  }
+  void OnDownload() {
+    for (tark_captions::ModelUnit unit : bar()->Missing()) {
+      tark_captions::TarkCaptionModels().Download(unit);
+    }
+    Refresh();
+  }
+
+  void ShowTargets() {
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    for (size_t i = 0; i < std::size(kTargets); ++i) {
+      if (tark_captions::Supported(bar()->source(), kTargets[i])) {
+        menu_model_->AddItem(kTargetBase + static_cast<int>(i),
+                             NameInEnglishUi(kTargets[i]));
+      }
+    }
+    RunMenu(target_button_);
+  }
+  void ShowOptions() {
+    const std::u16string language = NameInEnglishUi(bar()->source());
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_model_->AddCheckItem(kAlways, l10n_util::GetStringFUTF16(
+                                           IDS_TARK_TRANSLATE_BAR_ALWAYS, language));
+    menu_model_->AddCheckItem(kNever, l10n_util::GetStringFUTF16(
+                                          IDS_TARK_TRANSLATE_BAR_NEVER, language));
+    menu_model_->AddCheckItem(kNeverSite,
+                              l10n_util::GetStringUTF16(IDS_TARK_TRANSLATE_BAR_NEVER_SITE));
+    RunMenu(options_);
+  }
+  void RunMenu(views::View* anchor) {
+    menu_runner_ = std::make_unique<views::MenuRunner>(menu_model_.get(),
+                                                       views::MenuRunner::HAS_MNEMONICS);
+    menu_runner_->RunMenuAt(anchor->GetWidget(), nullptr, anchor->GetAnchorBoundsInScreen(),
+                            views::MenuAnchorPosition::kTopLeft, ui::mojom::MenuSourceType::kNone);
+  }
+
+  raw_ptr<views::Label> from_ = nullptr;
+  raw_ptr<views::MdTextButton> target_button_ = nullptr;
+  raw_ptr<views::MdTextButton> original_ = nullptr;
+  raw_ptr<views::MdTextButton> translated_ = nullptr;
+  raw_ptr<views::Label> status_ = nullptr;
+  raw_ptr<views::MdTextButton> download_ = nullptr;
+  raw_ptr<views::MdTextButton> options_ = nullptr;
+  bool models_observation_ = false;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
+
+}  // namespace
+
+void ShowTranslateBar(content::WebContents* web_contents,
+                      translate::TranslateStep step,
+                      const std::string& source_language,
+                      const std::string& target_language,
+                      translate::TranslateErrors error_type) {
+  infobars::ContentInfoBarManager* manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents);
+  if (!manager) {
+    return;
+  }
+  const tark_captions::PageStep page_step = StepOf(step, error_type);
+  for (infobars::InfoBar* infobar : manager->infobars()) {
+    if (infobar->delegate()->GetIdentifier() ==
+        infobars::InfoBarDelegate::TRANSLATE_INFOBAR_DELEGATE_NON_AURA) {
+      static_cast<BarDelegate*>(infobar->delegate())
+          ->SetState(source_language, target_language, page_step);
+      static_cast<BarView*>(infobar)->Refresh();
+      return;
+    }
+  }
+  if (!tark_captions::Supported(source_language, target_language)) {
+    return;
+  }
+  tark_captions::PageTranslateTabHelper::CreateForWebContents(web_contents);
+  auto delegate = std::make_unique<BarDelegate>(web_contents, source_language, target_language);
+  delegate->SetState(source_language, target_language, page_step);
+  manager->AddInfoBar(std::make_unique<BarView>(std::move(delegate)));
+}
+
