+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_PAGE_TRANSLATE_RULES_H_
+#define COMPONENTS_TARK_CAPTIONS_PAGE_TRANSLATE_RULES_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/function_ref.h"
+#include "components/tark_captions/model_manifest.h"
+
+namespace tark_captions {
+
+// Tark's page translation: which language a page is translated into, and
+// whether the translate bar offers it.
+
+// The first of `accept_languages` ("ta-IN", "en", …) that pages can be
+// translated into ("en", "hi", "ta", "bn"), as its base code; "en" when
+// none is.
+std::string TargetFor(const std::vector<std::string>& accept_languages);
+
+// Whether a page in `source` can be translated into `target` (base codes):
+// "hi", "ta", "bn" ↔ "en", and Indian ↔ Indian through English. (The
+// desktop's models have no Spanish yet.)
+bool Supported(std::string_view source, std::string_view target);
+
+enum class Offer {
+  kNone,   // No bar.
+  kOffer,  // The bar offers translation and waits.
+  kAuto,   // The page opens translated.
+};
+
+// "Never translate this site" wins over "Always translate [language]",
+// which wins over "Never translate [language]" for the same language (the
+// prefs keep them exclusive).
+Offer OfferFor(std::string_view source,
+               std::string_view target,
+               bool always_language,
+               bool never_language,
+               bool never_site);
+
+// What the translate bar shows. `step` is where Chromium's translation is;
+// a failed translation whose models aren't downloaded offers the download.
+enum class PageStep { kBefore, kTranslating, kAfter, kError };
+enum class BarMode {
+  kOffer,          // Original selected; Translated starts it.
+  kTranslating,    // Translated selected while the first text arrives.
+  kTranslated,     // Translated selected.
+  kNeedsDownload,  // "Download (N MB)".
+  kDownloading,    // "Getting translation ready… N%".
+  kError,          // "Couldn't translate this page".
+};
+BarMode BarModeFor(PageStep step, bool models_missing, bool downloading);
+
+// The models a page still needs: those its last request found missing
+// (`reported`) that aren't `ready` now. A download that has finished drops
+// out before any new request says so.
+std::vector<ModelUnit> StillMissing(const std::vector<ModelUnit>& reported,
+                                    base::FunctionRef<bool(ModelUnit)> ready);
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_PAGE_TRANSLATE_RULES_H_
--- a/components/tark_captions/page_translate_rules.cc
+++ b/components/tark_captions/page_translate_rules.cc
@@ -0,0 +1,90 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/page_translate_rules.h"
+
+#include <algorithm>
+#include <iterator>
+
+#include "base/strings/string_util.h"
+#include "components/tark_captions/translation_engine.h"
+
+namespace tark_captions {
+
+namespace {
+
+constexpr std::string_view kTargets[] = {"en", "hi", "ta", "bn"};
+
+std::string Base(std::string_view code) {
+  return base::ToLowerASCII(code.substr(0, code.find_first_of("-_")));
+}
+
+}  // namespace
+
+std::string TargetFor(const std::vector<std::string>& accept_languages) {
+  for (const std::string& language : accept_languages) {
+    const std::string code = Base(language);
+    if (std::ranges::find(kTargets, code) != std::end(kTargets)) {
+      return code;
+    }
+  }
+  return "en";
+}
+
+bool Supported(std::string_view source, std::string_view target) {
+  if (std::ranges::find(kTargets, source) == std::end(kTargets)) {
+    return false;
+  }
+  const std::optional<Target> t = TargetFromCode(target);
+  if (!t || *t == Target::kNone) {
+    return false;
+  }
+  return !DirectionsFor(source, *t).empty();
+}
+
+Offer OfferFor(std::string_view source,
+               std::string_view target,
+               bool always_language,
+               bool never_language,
+               bool never_site) {
+  if (source == target || !Supported(source, target) || never_site) {
+    return Offer::kNone;
+  }
+  if (always_language) {
+    return Offer::kAuto;
+  }
+  return never_language ? Offer::kNone : Offer::kOffer;
+}
+
+BarMode BarModeFor(PageStep step, bool models_missing, bool downloading) {
+  if (downloading) {
+    return BarMode::kDownloading;
+  }
+  if (models_missing) {
+    return BarMode::kNeedsDownload;
+  }
+  switch (step) {
+    case PageStep::kBefore:
+      return BarMode::kOffer;
+    case PageStep::kTranslating:
+      return BarMode::kTranslating;
+    case PageStep::kAfter:
+      return BarMode::kTranslated;
+    case PageStep::kError:
+      return BarMode::kError;
+  }
+}
+
+std::vector<ModelUnit> StillMissing(const std::vector<ModelUnit>& reported,
+                                    base::FunctionRef<bool(ModelUnit)> ready) {
+  std::vector<ModelUnit> missing;
+  for (ModelUnit unit : reported) {
+    if (!ready(unit)) {
+      missing.push_back(unit);
+    }
+  }
+  return missing;
+}
+
+}  // namespace tark_captions
--- a/components/tark_captions/page_translate_rules_unittest.cc
+++ b/components/tark_captions/page_translate_rules_unittest.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/page_translate_rules.h"
+
+#include "components/tark_captions/model_manifest.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(PageTranslateRulesTest, TargetIsTheFirstSupportedLanguage) {
+  EXPECT_EQ(TargetFor({"fr", "ta", "en"}), "ta");
+  EXPECT_EQ(TargetFor({"hi-IN", "en-US"}), "hi");
+  EXPECT_EQ(TargetFor({"en-GB"}), "en");
+}
+
+TEST(PageTranslateRulesTest, TargetFallsBackToEnglish) {
+  EXPECT_EQ(TargetFor({"fr"}), "en");
+  EXPECT_EQ(TargetFor({}), "en");
+}
+
+TEST(PageTranslateRulesTest, SupportedPairs) {
+  EXPECT_TRUE(Supported("hi", "en"));
+  EXPECT_TRUE(Supported("en", "ta"));
+  EXPECT_TRUE(Supported("hi", "ta"));  // Through English.
+  EXPECT_FALSE(Supported("es", "en"));  // No Spanish model on desktop.
+  EXPECT_FALSE(Supported("en", "es"));
+  EXPECT_FALSE(Supported("fr", "en"));
+  EXPECT_FALSE(Supported("hi", ""));
+}
+
+TEST(PageTranslateRulesTest, SameLanguageHasNoBar) {
+  EXPECT_EQ(OfferFor("en", "en", false, false, false), Offer::kNone);
+  EXPECT_EQ(OfferFor("hi", "hi", true, false, false), Offer::kNone);
+}
+
+TEST(PageTranslateRulesTest, NeverSiteWinsOverAlwaysLanguage) {
+  EXPECT_EQ(OfferFor("hi", "en", true, false, true), Offer::kNone);
+}
+
+TEST(PageTranslateRulesTest, AlwaysLanguageOpensTranslated) {
+  EXPECT_EQ(OfferFor("hi", "en", true, false, false), Offer::kAuto);
+}
+
+TEST(PageTranslateRulesTest, NeverLanguageHidesTheBar) {
+  EXPECT_EQ(OfferFor("hi", "en", false, true, false), Offer::kNone);
+}
+
+TEST(PageTranslateRulesTest, NoPreferenceOffersSupportedPairsOnly) {
+  EXPECT_EQ(OfferFor("hi", "en", false, false, false), Offer::kOffer);
+  EXPECT_EQ(OfferFor("fr", "en", false, false, false), Offer::kNone);
+}
+
+TEST(PageTranslateRulesTest, BarFollowsTheTranslation) {
+  EXPECT_EQ(BarModeFor(PageStep::kBefore, false, false), BarMode::kOffer);
+  EXPECT_EQ(BarModeFor(PageStep::kTranslating, false, false), BarMode::kTranslating);
+  EXPECT_EQ(BarModeFor(PageStep::kAfter, false, false), BarMode::kTranslated);
+  EXPECT_EQ(BarModeFor(PageStep::kError, false, false), BarMode::kError);
+}
+
+TEST(PageTranslateRulesTest, MissingModelsOfferTheDownload) {
+  EXPECT_EQ(BarModeFor(PageStep::kError, true, false), BarMode::kNeedsDownload);
+  EXPECT_EQ(BarModeFor(PageStep::kBefore, true, false), BarMode::kNeedsDownload);
+  EXPECT_EQ(BarModeFor(PageStep::kError, true, true), BarMode::kDownloading);
+}
+
+TEST(PageTranslateRulesTest, DownloadedModelsAreNoLongerMissing) {
+  // The last request found both missing; the English one has downloaded
+  // since, with no new request to say so.
+  const std::vector<ModelUnit> reported = {ModelUnit::kToEnglish, ModelUnit::kFromEnglish};
+  EXPECT_EQ(StillMissing(reported, [](ModelUnit u) { return u == ModelUnit::kToEnglish; }),
+            std::vector<ModelUnit>{ModelUnit::kFromEnglish});
+  EXPECT_TRUE(StillMissing(reported, [](ModelUnit) { return true; }).empty());
+  EXPECT_TRUE(StillMissing({}, [](ModelUnit) { return false; }).empty());
+}
+
+}  // namespace
+}  // namespace tark_captions
