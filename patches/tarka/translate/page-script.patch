+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark's page translation library. It stands in for the translate
+// element's google.translate.TranslateService, so Chromium's translate.js
+// (cr.googleTranslate) drives it unchanged. Runs in the translate isolated
+// world. The text goes to the computer's own translator: TranslateAgent
+// pulls sentences with __tarkTranslatePull() and returns translations with
+// __tarkTranslatePush(); nothing is sent over the network.
+//
+// Only text nodes change. A block's text is translated in segments: the
+// runs of text between links (and buttons, labels), and each link's own
+// words, so links keep words to click. A segment's translation goes into
+// its first text node and its other text nodes are emptied; every node's
+// original is kept so restore() is exact. Text
+// the page adds or changes later (JS pages) is translated as it appears.
+(function() {
+  'use strict';
+
+  const SKIP = new Set([
+    'SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE', 'TEXTAREA', 'INPUT', 'SELECT',
+    'OPTION', 'CODE', 'PRE', 'KBD', 'SAMP', 'SVG', 'MATH', 'CANVAS', 'IFRAME',
+  ]);
+  const INLINE = new Set([
+    'A', 'ABBR', 'B', 'BDI', 'BDO', 'CITE', 'DATA', 'DFN', 'EM', 'FONT', 'I',
+    'LABEL', 'MARK', 'Q', 'S', 'SMALL', 'SPAN', 'STRONG', 'SUB', 'SUP', 'TIME',
+    'U', 'WBR', 'BR',
+  ]);
+  const BATCH = 24;          // Sentences per pull.
+  const SLICE_MS = 8;        // Main-thread work per slice.
+  const DEBOUNCE_MS = 150;   // After the page's mutations.
+
+  // A block: the nearest non-inline ancestor of its text nodes.
+  // unit = {block, nodes: [Text], text, segments: [{nodes, sentences}], done}
+  const units = new Map();           // block -> unit
+  const originals = new WeakMap();   // Text -> the page's own text
+  const written = new WeakMap();     // Text -> what Tark wrote
+  const cache = new Map();           // sentence -> translation
+  let queue = [];                    // sentences waiting to be pulled
+  const queued = new Set();
+  const waiting = new Map();         // id -> sentence, pulled, not back
+  let nextId = 1;
+  let active = false;                // Showing translations.
+  let writing = false;
+  let source = '';
+  let target = '';
+  let onProgress = null;
+  let failed = false;
+  const observers = [];
+  let dirty = new Set();
+  let dirtyTimer = 0;
+
+  function skipped(element) {
+    for (let e = element; e; e = e.parentElement) {
+      if (SKIP.has(e.tagName) || e.isContentEditable) return true;
+      if (e.getAttribute('translate') === 'no') return true;
+      if (e.classList && e.classList.contains('notranslate')) return true;
+    }
+    return false;
+  }
+
+  function blockOf(node) {
+    let e = node.parentElement;
+    while (e && INLINE.has(e.tagName) && e.parentElement) e = e.parentElement;
+    return e;
+  }
+
+  const OWN_WORDS = new Set(['A', 'BUTTON', 'LABEL']);
+
+  // The link (or button, label) in `block` that `node` is in, if any.
+  function ownerOf(node, block) {
+    for (let e = node.parentElement; e && e !== block; e = e.parentElement) {
+      if (OWN_WORDS.has(e.tagName)) return e;
+    }
+    return null;
+  }
+
+  function splitSentences(text) {
+    const parts = text.split(/(?<=[.!?।॥])\s+/u);
+    return parts.map(s => s.trim()).filter(s => s.length > 0);
+  }
+
+  function hasLetters(text) {
+    return /\p{L}/u.test(text);
+  }
+
+  // Text nodes of `root` (and same-origin iframes), grouped into units.
+  function collect(root, out) {
+    const doc = root.ownerDocument || root;
+    const walker = doc.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT, {
+      acceptNode(n) {
+        if (n.nodeType === Node.ELEMENT_NODE) {
+          if (n.tagName === 'IFRAME') {
+            try {
+              if (n.contentDocument && n.contentDocument.body) {
+                watch(n.contentDocument);
+                collect(n.contentDocument.body, out);
+              }
+            } catch (e) { /* Cross-origin: not reachable. */ }
+            return NodeFilter.FILTER_REJECT;
+          }
+          if (n.shadowRoot) collect(n.shadowRoot, out);
+          return SKIP.has(n.tagName) || n.isContentEditable ||
+                  n.getAttribute('translate') === 'no' ||
+                  n.classList.contains('notranslate')
+              ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_SKIP;
+        }
+        return NodeFilter.FILTER_ACCEPT;
+      },
+    });
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      const block = blockOf(n);
+      if (!block) continue;
+      out.add(block);
+    }
+  }
+
+  // Rebuilds `block`'s unit from its current text nodes.
+  function refresh(block) {
+    if (!block.isConnected || skipped(block)) {
+      units.delete(block);
+      return;
+    }
+    const nodes = [];
+    const walker = block.ownerDocument.createTreeWalker(block, NodeFilter.SHOW_TEXT);
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (blockOf(n) !== block || skipped(n.parentElement)) continue;
+      // The page's own text: a node Tark hasn't written, or one the page
+      // has rewritten since.
+      if (!originals.has(n) || n.data !== written.get(n)) {
+        originals.set(n, n.data);
+        written.delete(n);
+      }
+      nodes.push(n);
+    }
+    const text = nodes.map(n => originals.get(n)).join('').replace(/\s+/g, ' ').trim();
+    if (!hasLetters(text)) {
+      units.delete(block);
+      return;
+    }
+    const old = units.get(block);
+    if (old && old.text === text && old.nodes.length === nodes.length &&
+        old.nodes.every((n, i) => n === nodes[i])) {
+      return;
+    }
+    const segments = [];
+    let owner;
+    for (const n of nodes) {
+      const o = ownerOf(n, block);
+      if (!segments.length || o !== owner) segments.push({nodes: []});
+      owner = o;
+      segments[segments.length - 1].nodes.push(n);
+    }
+    for (const seg of segments) {
+      seg.sentences = splitSentences(
+          seg.nodes.map(n => originals.get(n)).join('').replace(/\s+/g, ' ').trim());
+    }
+    const unit = {block, nodes, text, segments, done: false};
+    units.set(block, unit);
+    for (const seg of segments) {
+      for (const s of seg.sentences) {
+        if (!cache.has(s) && !queued.has(s)) {
+          queued.add(s);
+          queue.push({s, block});
+        }
+      }
+    }
+  }
+
+  function visible(block) {
+    if (!block.getBoundingClientRect) return false;
+    const r = block.getBoundingClientRect();
+    const view = block.ownerDocument.defaultView;
+    return r.bottom > 0 && r.top < (view ? view.innerHeight : 0) && r.width > 0;
+  }
+
+  // What's on screen goes first.
+  function prioritize() {
+    const seen = [];
+    const rest = [];
+    for (const item of queue) (visible(item.block) ? seen : rest).push(item);
+    queue = seen.concat(rest);
+  }
+
+  function write(unit) {
+    if (!unit.segments.every(seg => seg.sentences.every(s => cache.has(s)))) return;
+    writing = true;
+    for (const seg of unit.segments) {
+      const translation = seg.sentences.map(s => cache.get(s)).join(' ');
+      const first = originals.get(seg.nodes[0]);
+      const last = originals.get(seg.nodes[seg.nodes.length - 1]);
+      seg.nodes.forEach((n, i) => {
+        // A segment of only spaces keeps them (the gap before a link).
+        const value = !seg.sentences.length ? originals.get(n)
+            : i === 0 ? (/^\s/.test(first) ? ' ' : '') + translation + (/\s$/.test(last) ? ' ' : '')
+            : '';
+        if (n.data !== value) n.data = value;
+        written.set(n, value);
+      });
+    }
+    writing = false;
+    unit.done = true;
+  }
+
+  function writeAll() {
+    for (const unit of units.values()) {
+      if (!unit.done) write(unit);
+    }
+    report();
+  }
+
+  function restoreAll() {
+    writing = true;
+    for (const unit of units.values()) {
+      for (const n of unit.nodes) {
+        const original = originals.get(n);
+        // A node the page rewrote while translated keeps the page's text.
+        if (written.has(n) && n.data !== written.get(n)) continue;
+        if (original !== undefined && n.data !== original) n.data = original;
+        written.delete(n);
+      }
+      unit.done = false;
+    }
+    writing = false;
+  }
+
+  function report() {
+    if (!onProgress) return;
+    const total = units.size || 1;
+    let done = 0;
+    for (const unit of units.values()) if (unit.done) done++;
+    // Incremental, like the translate element with IntersectionObserver:
+    // always finished, so Chromium reports the page translated while text
+    // keeps arriving.
+    onProgress(Math.round(100 * done / total), true, 0);
+  }
+
+  // Collects in slices so the page stays responsive.
+  function scan(blocks) {
+    const list = Array.from(blocks);
+    let i = 0;
+    (function slice() {
+      const start = performance.now();
+      while (i < list.length && performance.now() - start < SLICE_MS) refresh(list[i++]);
+      if (i < list.length) {
+        setTimeout(slice, 0);
+      } else {
+        prioritize();
+        if (active) writeAll();
+      }
+    })();
+  }
+
+  function onMutations(records) {
+    if (writing || !active) return;
+    for (const r of records) {
+      if (r.type === 'characterData') {
+        const block = blockOf(r.target);
+        if (block) dirty.add(block);
+      } else {
+        const block = r.target.nodeType === Node.TEXT_NODE ? blockOf(r.target) : r.target;
+        if (block) dirty.add(block);
+        for (const n of r.addedNodes) {
+          if (n.nodeType === Node.TEXT_NODE) {
+            const b = blockOf(n);
+            if (b) dirty.add(b);
+          } else if (n.nodeType === Node.ELEMENT_NODE) {
+            const found = new Set();
+            collect(n, found);
+            for (const b of found) dirty.add(b);
+          }
+        }
+      }
+    }
+    clearTimeout(dirtyTimer);
+    dirtyTimer = setTimeout(() => {
+      const blocks = dirty;
+      dirty = new Set();
+      scan(blocks);
+    }, DEBOUNCE_MS);
+  }
+
+  function watch(doc) {
+    if (observers.some(o => o.doc === doc)) return;
+    const observer = new MutationObserver(onMutations);
+    observer.observe(doc, {childList: true, characterData: true, subtree: true});
+    observers.push({doc, observer});
+  }
+
+  // Called by TranslateAgent: up to BATCH sentences as [[id, text], ...].
+  window.__tarkTranslatePull = function() {
+    if (!active || failed) return [];
+    const out = [];
+    while (queue.length && out.length < BATCH) {
+      const {s} = queue.shift();
+      queued.delete(s);
+      if (cache.has(s)) continue;
+      const id = nextId++;
+      waiting.set(id, s);
+      out.push([id, s]);
+    }
+    return out;
+  };
+
+  // Called by TranslateAgent with the translations of `ids`, or ok=false.
+  window.__tarkTranslatePush = function(ids, translations, ok) {
+    if (!ok) {
+      ids.forEach(id => waiting.delete(id));
+      failed = true;
+      // The page goes back to its original rather than staying half
+      // translated (the bar offers the models, or says it failed), and
+      // stays there: the observer must not write the cache back.
+      active = false;
+      restoreAll();
+      if (onProgress) onProgress(0, true, 1);
+      return;
+    }
+    ids.forEach((id, i) => {
+      const s = waiting.get(id);
+      waiting.delete(id);
+      if (s !== undefined && translations[i]) cache.set(s, translations[i]);
+    });
+    if (active) writeAll();
+  };
+
+  const service = {
+    isAvailable() {
+      return true;
+    },
+    getDetectedLanguage() {
+      return source;
+    },
+    translatePage(sourceLang, targetLang, progress) {
+      if (sourceLang !== source || targetLang !== target) {
+        // A batch still out is for the old pair: its reply finds no ids.
+        cache.clear();
+        waiting.clear();
+        units.clear();
+        queue = [];
+        queued.clear();
+      } else if (failed) {
+        // A failed batch's sentences were dropped: rescanning every block
+        // queues them again (the rest come from the cache).
+        units.clear();
+      }
+      source = sourceLang;
+      target = targetLang;
+      onProgress = progress;
+      failed = false;
+      active = true;
+      watch(document);
+      const blocks = new Set();
+      if (document.body) collect(document.body, blocks);
+      for (const unit of units.values()) blocks.add(unit.block);
+      scan(blocks);
+    },
+    restore() {
+      active = false;
+      restoreAll();
+    },
+  };
+
+  window.google = window.google || {};
+  google.translate = google.translate || {};
+  google.translate.TranslateService = function() {
+    return service;
+  };
+  cr.googleTranslate.onTranslateElementLoad();
+})();
