+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><p id=a>आज मौसम अच्छा है।</p><p id=b>बाज़ार खुला है।</p>
+<script>
+tarkTest(async t => {
+  // A batch for Hindi → English is out when the reader switches to Tamil:
+  // its late reply must not be kept as the Tamil translation.
+  window.tarkHold = true;
+  t.service.translatePage('hi', 'en', () => {});
+  const old = __tarkTranslatePull();
+  t.service.translatePage('hi', 'ta', () => {});
+  __tarkTranslatePush(old.map(b => b[0]), old.map(b => 'EN:' + b[1]), true);
+  window.tarkHold = false;
+  await t.sleep(800);
+  for (const id of ['a', 'b']) {
+    t.check(!t.text('#' + id).includes('EN:'), '#' + id + ' shows the old language: ' + t.text('#' + id));
+    t.check(t.text('#' + id).startsWith('⟦'), '#' + id + ' not translated: ' + t.text('#' + id));
+  }
+});</script>
