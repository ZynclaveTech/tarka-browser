+<!doctype html><meta charset="utf-8"><title>runner</title><body><pre id=out></pre>
+<script>
+const cases = ['static','skips','split_link','adds_by_timer','rewrites','pushstate','iframe_same','long','model_gone','retry_after_failure','language_change'];
+(async () => {
+  const out = document.querySelector('#out'); let all = true;
+  for (const c of cases) {
+    const f = document.createElement('iframe'); f.style.width = '800px'; f.style.height = '400px';
+    f.src = c + '.html?' + Date.now(); document.body.appendChild(f);
+    let title = '';
+    for (let i = 0; i < 100 && !/^(PASS|FAIL)/.test(title); i++) { await new Promise(r => setTimeout(r, 100)); title = f.contentDocument.title; }
+    out.textContent += c + ': ' + (title || 'TIMEOUT') + '\n'; all = all && title === 'PASS';
+    f.remove();
+  }
+  document.title = all ? 'ALL PASS' : 'SOME FAIL';
+})();
+</script>
