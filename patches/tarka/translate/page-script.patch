+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><div id=all></div>
+<script>const all = document.querySelector('#all');
+for (let i = 0; i < 5000; i++) { const p = document.createElement('p'); p.textContent = 'पंक्ति ' + i + ' यहाँ है।'; all.appendChild(p); }
+tarkTest(async t => {
+  let worst = 0;
+  new PerformanceObserver(l => { for (const e of l.getEntries()) worst = Math.max(worst, e.duration); }).observe({type: 'longtask'});
+  t.translate(); await t.sleep(2000);
+  t.check(worst <= 50, 'long task ' + worst + ' ms');
+  t.check(all.firstChild.textContent === t.tr('पंक्ति 0 यहाँ है।'), 'first visible: ' + all.firstChild.textContent);
+});</script>
