+// Tark page translation test harness: Chromium's translate.js stand-in,
+// a fake translator (upper case, 100 ms polling like TranslateAgent) and
+// assertions. Each page calls tarkTest(async (t) => {...}).
+window.cr = {googleTranslate: {onTranslateElementLoad() {}}};
+window.tarkPushes = 0;
+function tarkPump() {
+  if (window.tarkHold) return;
+  let batch = window.__tarkTranslatePull ? __tarkTranslatePull() : [];
+  if (batch.length) {
+    tarkPushes++;
+    const ok = !(window.tarkFail && window.tarkFail());
+    __tarkTranslatePush(batch.map(b => b[0]), ok ? batch.map(b => '⟦' + b[1] + '⟧') : [], ok);
+  }
+}
+setInterval(tarkPump, 100);
+const sleep = ms => new Promise(r => setTimeout(r, ms));
+function tarkTest(body) {
+  const lib = document.createElement('script');
+  lib.src = '/components/translate/core/browser/resources/tark_page_translate.js?' + Date.now();
+  lib.onload = async () => {
+    const service = google.translate.TranslateService();
+    const t = {
+      service, fails: [],
+      translate() { service.translatePage('hi', 'en', () => {}); },
+      check(cond, msg) { if (!cond) t.fails.push(msg); },
+      tree() { return Array.from(document.body.querySelectorAll('*')).map(e => e.tagName).join(','); },
+      text(sel) { return document.querySelector(sel).textContent; },
+      sleep,
+      tr(text) { return text.split(/(?<=[.!?।॥])\s+/u).map(s => '⟦' + s.trim() + '⟧').join(' '); },
+    };
+    try { await body(t); } catch (e) { t.fails.push('threw: ' + e); }
+    document.title = t.fails.length ? 'FAIL: ' + t.fails.join(' | ') : 'PASS';
+  };
+  document.head.appendChild(lib);
+}
