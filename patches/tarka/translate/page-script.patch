+void TranslateAgent::StartTarkPump() {
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          translate::switches::kTranslateScriptURL)) {
+    return;  // The user's own translate server: Chromium's path.
+  }
+  // Every 100 ms; text a page adds is translated well within a second.
+  tark_pump_.Start(FROM_HERE, base::Milliseconds(100),
+                   base::BindRepeating(&TranslateAgent::PumpTark,
+                                       base::Unretained(this)));
+}
+
+void TranslateAgent::StopTarkPump() {
+  tark_pump_.Stop();
+  // A reply still on its way is harmless (the page caches it); a new
+  // translation must not wait for it.
+  tark_in_flight_ = false;
+}
+
+void TranslateAgent::OnTarkHostGone() {
+  tark_host_.reset();
+  if (tark_in_flight_) {
+    OnTarkTranslated(std::move(tark_pending_ids_), false, {});
+  }
+}
+
+void TranslateAgent::PumpTark() {
+  if (tark_in_flight_) {
+    return;
+  }
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  const std::string pulled = ExecuteScriptAndGetStringResult(
+      "window.__tarkTranslatePull ? JSON.stringify(__tarkTranslatePull()) : '[]'");
+  if (!weak_this) {
+    return;
+  }
+  std::optional<base::Value> batch =
+      base::JSONReader::Read(pulled, base::JSON_PARSE_RFC);
+  if (!batch || !batch->is_list() || batch->GetList().empty()) {
+    return;
+  }
+  std::vector<int> ids;
+  std::vector<std::string> sentences;
+  for (const base::Value& item : batch->GetList()) {
+    if (!item.is_list() || item.GetList().size() != 2 ||
+        !item.GetList()[0].is_int() || !item.GetList()[1].is_string()) {
+      continue;
+    }
+    ids.push_back(item.GetList()[0].GetInt());
+    sentences.push_back(item.GetList()[1].GetString());
+  }
+  if (ids.empty()) {
+    return;
+  }
+  if (!tark_host_.is_bound()) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        tark_host_.BindNewPipeAndPassReceiver());
+    tark_host_.set_disconnect_handler(base::BindOnce(
+        &TranslateAgent::OnTarkHostGone, weak_pointer_factory_.GetWeakPtr()));
+  }
+  tark_in_flight_ = true;
+  tark_pending_ids_ = ids;
+  tark_host_->Translate(
+      sentences, source_lang_, target_lang_, base::BindOnce(&TranslateAgent::OnTarkTranslated,
+                                weak_pointer_factory_.GetWeakPtr(), ids));
+}
+
+void TranslateAgent::OnTarkTranslated(
+    std::vector<int> ids,
+    bool ok,
+    const std::vector<std::string>& translations) {
+  tark_in_flight_ = false;
+  tark_pending_ids_.clear();
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+  base::ListValue id_list;
+  for (int id : ids) {
+    id_list.Append(id);
+  }
+  base::ListValue text_list;
+  if (ok && translations.size() == ids.size()) {
+    for (const std::string& text : translations) {
+      text_list.Append(text);
+    }
+  } else {
+    ok = false;
+  }
+  const std::string script =
+      "window.__tarkTranslatePush && __tarkTranslatePush(" +
+      base::WriteJson(id_list).value_or("[]") + "," +
+      base::WriteJson(text_list).value_or("[]") + "," + (ok ? "true" : "false") +
+      ")";
+  main_frame->ExecuteScriptInIsolatedWorld(
+      world_id_, WebScriptSource(WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+  if (!ok) {
+    StopTarkPump();
+  }
+}
