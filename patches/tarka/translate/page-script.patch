+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><p id=p>पढ़ो <a href="#x">रिपोर्ट</a> आज</p>
+<script>tarkTest(async t => {
+  t.translate(); await t.sleep(800);
+  const p = document.querySelector('#p');
+  t.check(p.querySelector('a') !== null, 'link element gone');
+  // The link keeps words of its own, so it can still be clicked.
+  t.check(p.querySelector('a').textContent === t.tr('रिपोर्ट'), 'link text: ' + p.querySelector('a').textContent);
+  t.check(p.textContent.includes(t.tr('पढ़ो')) && p.textContent.includes(t.tr('आज')), 'p ' + p.textContent);
+  t.service.restore();
+  t.check(p.innerHTML === 'पढ़ो <a href="#x">रिपोर्ट</a> आज', 'restore ' + p.innerHTML);
+});</script>
