+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><p id=ok>अनुवाद करो</p><input id=i value="इनपुट"><textarea id=ta>लिखो</textarea>
+<div id=ce contenteditable>संपादन</div><code id=c>कोड</code><pre id=pre>पूर्व</pre>
+<p id=no translate="no">नहीं</p><p id=nt class="notranslate">नहीं भी</p>
+<script>tarkTest(async t => {
+  t.translate(); await t.sleep(800);
+  t.check(t.text('#ok') === t.tr('अनुवाद करो'), 'ok not translated');
+  t.check(document.querySelector('#i').value === 'इनपुट', 'input');
+  t.check(t.text('#ta') === 'लिखो', 'textarea');
+  t.check(t.text('#ce') === 'संपादन', 'contenteditable');
+  t.check(t.text('#c') === 'कोड', 'code');
+  t.check(t.text('#pre') === 'पूर्व', 'pre');
+  t.check(t.text('#no') === 'नहीं', 'translate=no');
+  t.check(t.text('#nt') === 'नहीं भी', 'notranslate');
+});</script>
