+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><div id=all></div>
+<script>const all = document.querySelector('#all');
+for (let i = 0; i < 40; i++) { const p = document.createElement('p'); p.textContent = 'पंक्ति ' + i; all.appendChild(p); }
+tarkTest(async t => {
+  // The first batch fails (models missing); once they are back, translating
+  // again translates every paragraph, the failed batch's ones included.
+  let batches = 0;
+  window.tarkFail = () => ++batches === 1;
+  t.translate(); await t.sleep(500);
+  t.translate(); await t.sleep(1000);
+  const left = Array.from(all.children).filter(p => !p.textContent.startsWith('⟦')).length;
+  t.check(left === 0, left + ' of 40 paragraphs left untranslated after the retry');
+});</script>
