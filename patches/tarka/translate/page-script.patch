+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><h1>नमस्ते दुनिया</h1><p>पहला वाक्य। दूसरा वाक्य।</p><ul><li>एक</li><li>दो</li></ul>
+<script>tarkTest(async t => {
+  const before = t.tree();
+  t.translate(); await t.sleep(800);
+  t.check(t.text('h1') === t.tr('नमस्ते दुनिया'), 'h1 ' + t.text('h1'));
+  t.check(t.text('p') === t.tr('पहला वाक्य। दूसरा वाक्य।'), 'p ' + t.text('p'));
+  t.check(t.tree() === before, 'tree changed');
+  t.service.restore();
+  t.check(t.text('p') === 'पहला वाक्य। दूसरा वाक्य।', 'restore ' + t.text('p'));
+});</script>
