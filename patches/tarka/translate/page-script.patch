+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><p id=c>गिनती 0</p>
+<script>let n = 0; setInterval(() => { document.querySelector('#c').textContent = 'गिनती ' + (++n); }, 1000);
+tarkTest(async t => {
+  t.translate(); await t.sleep(300);
+  const start = tarkPushes; let seen = 0;
+  for (let i = 0; i < 60; i++) { await t.sleep(50); if (t.text('#c') === t.tr('गिनती ' + n)) seen++; }
+  t.check(tarkPushes - start <= 16, 'pushes in 3s: ' + (tarkPushes - start));
+  t.check(seen > 20, 'translated latest text only ' + seen + '/60 samples');
+  t.service.restore();
+  t.check(t.text('#c') === 'गिनती ' + n, 'restore shows latest: ' + t.text('#c') + ' vs ' + n);
+});</script>
