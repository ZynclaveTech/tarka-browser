+<!doctype html><meta charset="utf-8"><script src="harness.js"></script>
+<body><div id=all></div>
+<script>const all = document.querySelector('#all');
+for (let i = 0; i < 40; i++) { const p = document.createElement('p'); p.textContent = 'पंक्ति ' + i; all.appendChild(p); }
+tarkTest(async t => {
+  // The models go away after the first batch (24 sentences): the page goes
+  // back to its original rather than staying half translated.
+  let batches = 0;
+  window.tarkFail = () => ++batches > 1;
+  t.translate(); await t.sleep(1000);
+  const translated = Array.from(all.children).filter(p => p.textContent.startsWith('⟦')).length;
+  t.check(translated === 0, translated + ' of 40 paragraphs left translated');
+});</script>
