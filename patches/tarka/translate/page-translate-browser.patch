+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATOR_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATOR_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/functional/callback_forward.h"
+#include "base/memory/weak_ptr.h"
+#include "components/tark_captions/model_manifest.h"
+#include "media/mojo/mojom/tark_page_translator.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace tark_captions {
+
+// Tark: one tab's page translation in the browser. Sentences already
+// translated are kept in memory (never on disk) and go when the tab does;
+// the rest go to the speech process's TarkPageTranslator.
+class PageTranslator {
+ public:
+  using Binder = base::RepeatingCallback<void(
+      mojo::PendingReceiver<media::mojom::TarkPageTranslator>)>;
+  using Callback = base::OnceCallback<void(bool ok, std::vector<std::string> translations)>;
+
+  // Sentences kept per tab; the oldest half goes when it is reached.
+  static constexpr size_t kMaxCached = 20000;
+
+  explicit PageTranslator(Binder binder);
+  PageTranslator(const PageTranslator&) = delete;
+  PageTranslator& operator=(const PageTranslator&) = delete;
+  ~PageTranslator();
+
+  void Translate(const std::vector<std::string>& sentences,
+                 const std::string& source,
+                 const std::string& target,
+                 Callback callback);
+
+  // The model units the last failed request needed (empty after a success).
+  const std::vector<ModelUnit>& missing() const { return missing_; }
+  // Runs when missing() changes.
+  void SetOnMissingChanged(base::RepeatingClosure closure);
+
+  size_t cached() const { return cache_.size(); }
+
+ private:
+  void OnTranslated(std::vector<std::string> sentences,
+                    std::vector<size_t> positions,
+                    std::vector<std::string> result,
+                    std::string prefix,
+                    Callback callback,
+                    bool ok,
+                    const std::vector<std::string>& translations,
+                    const std::vector<std::string>& missing);
+  void SetMissing(std::vector<ModelUnit> missing);
+  media::mojom::TarkPageTranslator* translator();
+
+  Binder binder_;
+  mojo::Remote<media::mojom::TarkPageTranslator> translator_;
+  std::map<std::string, std::string> cache_;  // prefix + sentence -> translation
+  std::vector<std::string> order_;            // insertion order, for trimming
+  std::vector<ModelUnit> missing_;
+  base::RepeatingClosure on_missing_changed_;
+  base::WeakPtrFactory<PageTranslator> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATOR_H_
--- a/chrome/browser/tark_captions/page_translator.cc
+++ b/chrome/browser/tark_captions/page_translator.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/page_translator.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+
+namespace tark_captions {
+
+namespace {
+
+std::optional<ModelUnit> UnitOf(const std::string& folder) {
+  if (folder == "it2_indic_en") {
+    return ModelUnit::kToEnglish;
+  }
+  if (folder == "it2_en_indic") {
+    return ModelUnit::kFromEnglish;
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+PageTranslator::PageTranslator(Binder binder) : binder_(std::move(binder)) {}
+
+PageTranslator::~PageTranslator() = default;
+
+void PageTranslator::SetOnMissingChanged(base::RepeatingClosure closure) {
+  on_missing_changed_ = std::move(closure);
+}
+
+media::mojom::TarkPageTranslator* PageTranslator::translator() {
+  if (!translator_.is_bound()) {
+    binder_.Run(translator_.BindNewPipeAndPassReceiver());
+    // The speech process went away (idle, crash): bind afresh next time.
+    translator_.reset_on_disconnect();
+  }
+  return translator_.get();
+}
+
+void PageTranslator::Translate(const std::vector<std::string>& sentences,
+                               const std::string& source,
+                               const std::string& target,
+                               Callback callback) {
+  const std::string prefix = source + '\n' + target + '\n';
+  std::vector<std::string> result(sentences.size());
+  std::vector<std::string> todo;
+  std::vector<size_t> positions;
+  for (size_t i = 0; i < sentences.size(); ++i) {
+    auto it = cache_.find(prefix + sentences[i]);
+    if (it != cache_.end()) {
+      result[i] = it->second;
+    } else {
+      todo.push_back(sentences[i]);
+      positions.push_back(i);
+    }
+  }
+  if (todo.empty()) {
+    std::move(callback).Run(true, std::move(result));
+    return;
+  }
+  translator()->Translate(
+      todo, source, target,
+      base::BindOnce(&PageTranslator::OnTranslated, weak_factory_.GetWeakPtr(), todo,
+                     std::move(positions), std::move(result), prefix, std::move(callback)));
+}
+
+void PageTranslator::OnTranslated(std::vector<std::string> sentences,
+                                  std::vector<size_t> positions,
+                                  std::vector<std::string> result,
+                                  std::string prefix,
+                                  Callback callback,
+                                  bool ok,
+                                  const std::vector<std::string>& translations,
+                                  const std::vector<std::string>& missing) {
+  if (!ok || translations.size() != sentences.size()) {
+    std::vector<ModelUnit> units;
+    for (const std::string& folder : missing) {
+      if (std::optional<ModelUnit> unit = UnitOf(folder)) {
+        units.push_back(*unit);
+      }
+    }
+    SetMissing(std::move(units));
+    std::move(callback).Run(false, {});
+    return;
+  }
+  SetMissing({});
+  for (size_t i = 0; i < sentences.size(); ++i) {
+    result[positions[i]] = translations[i];
+    if (cache_.emplace(prefix + sentences[i], translations[i]).second) {
+      order_.push_back(prefix + sentences[i]);
+    }
+  }
+  if (cache_.size() >= kMaxCached) {
+    const size_t drop = order_.size() / 2;
+    for (size_t i = 0; i < drop; ++i) {
+      cache_.erase(order_[i]);
+    }
+    order_.erase(order_.begin(), order_.begin() + drop);
+  }
+  std::move(callback).Run(true, std::move(result));
+}
+
+void PageTranslator::SetMissing(std::vector<ModelUnit> missing) {
+  if (missing == missing_) {
+    return;
+  }
+  missing_ = std::move(missing);
+  if (on_missing_changed_) {
+    on_missing_changed_.Run();
+  }
+}
+
+}  // namespace tark_captions
