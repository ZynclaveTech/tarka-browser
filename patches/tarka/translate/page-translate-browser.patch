+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/page_translate_tab_helper.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/speech/speech_recognition_service.h"
+#include "chrome/browser/speech/speech_recognition_service_factory.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tark_captions {
+
+namespace {
+
+void BindTranslator(content::WebContents* web_contents,
+                    mojo::PendingReceiver<media::mojom::TarkPageTranslator> receiver) {
+  Profile* profile = Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  speech::SpeechRecognitionService* service =
+      SpeechRecognitionServiceFactory::GetForProfile(profile);
+  if (service) {
+    service->BindTarkPageTranslator(std::move(receiver));
+  }
+}
+
+}  // namespace
+
+// static
+void PageTranslateTabHelper::BindHost(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<translate::mojom::TarkPageTranslateHost> receiver) {
+  // The translate agent runs in main frames only.
+  if (render_frame_host->GetParentOrOuterDocument()) {
+    return;
+  }
+  content::WebContents* web_contents =
+      content::WebContents::FromRenderFrameHost(render_frame_host);
+  if (!web_contents) {
+    return;
+  }
+  PageTranslateTabHelper::CreateForWebContents(web_contents);
+  PageTranslateTabHelper* helper = PageTranslateTabHelper::FromWebContents(web_contents);
+  helper->receivers_.Add(helper, std::move(receiver));
+}
+
+PageTranslateTabHelper::PageTranslateTabHelper(content::WebContents* web_contents)
+    : content::WebContentsUserData<PageTranslateTabHelper>(*web_contents),
+      translator_(base::BindRepeating(&BindTranslator, web_contents)) {
+  translator_.SetOnMissingChanged(base::BindRepeating(
+      &base::RepeatingClosureList::Notify, base::Unretained(&missing_changed_)));
+}
+
+PageTranslateTabHelper::~PageTranslateTabHelper() = default;
+
+base::CallbackListSubscription PageTranslateTabHelper::AddMissingChangedCallback(
+    base::RepeatingClosure closure) {
+  return missing_changed_.Add(std::move(closure));
+}
+
+void PageTranslateTabHelper::Translate(const std::vector<std::string>& sentences,
+                                       const std::string& source,
+                                       const std::string& target,
+                                       TranslateCallback callback) {
+  translator_.Translate(
+      sentences, source, target,
+      base::BindOnce(
+          [](TranslateCallback callback, bool ok, std::vector<std::string> translations) {
+            std::move(callback).Run(ok, std::move(translations));
+          },
+          std::move(callback)));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PageTranslateTabHelper);
+
+}  // namespace tark_captions
