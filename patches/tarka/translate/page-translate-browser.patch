+++ b/chrome/browser/tark_captions/page_translator_unittest.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/page_translator.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "mojo/public/cpp/bindings/receiver_set.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+using ::testing::ElementsAre;
+using ::testing::IsEmpty;
+
+// Brackets each sentence, or reports `missing`.
+class FakeTranslator : public media::mojom::TarkPageTranslator {
+ public:
+  void Translate(const std::vector<std::string>& sentences,
+                 const std::string& source,
+                 const std::string& target,
+                 TranslateCallback callback) override {
+    ++calls;
+    asked.insert(asked.end(), sentences.begin(), sentences.end());
+    if (!missing.empty()) {
+      std::move(callback).Run(false, {}, missing);
+      return;
+    }
+    std::vector<std::string> out;
+    for (const std::string& s : sentences) {
+      out.push_back("[" + s + "]");
+    }
+    std::move(callback).Run(true, out, {});
+  }
+  int calls = 0;
+  std::vector<std::string> asked;
+  std::vector<std::string> missing;
+  mojo::ReceiverSet<media::mojom::TarkPageTranslator> receivers;
+};
+
+class PageTranslatorTest : public testing::Test {
+ protected:
+  PageTranslatorTest()
+      : translator_(base::BindRepeating(
+            [](FakeTranslator* fake,
+               mojo::PendingReceiver<media::mojom::TarkPageTranslator> receiver) {
+              fake->receivers.Add(fake, std::move(receiver));
+            },
+            &fake_)) {}
+
+  std::pair<bool, std::vector<std::string>> Translate(std::vector<std::string> sentences) {
+    base::test::TestFuture<bool, std::vector<std::string>> done;
+    translator_.Translate(sentences, "hi", "en", done.GetCallback());
+    return {done.Get<0>(), done.Get<1>()};
+  }
+
+  base::test::TaskEnvironment env_;
+  FakeTranslator fake_;
+  PageTranslator translator_;
+};
+
+TEST_F(PageTranslatorTest, TranslatesInOrder) {
+  auto [ok, out] = Translate({"a", "b"});
+  EXPECT_TRUE(ok);
+  EXPECT_THAT(out, ElementsAre("[a]", "[b]"));
+}
+
+TEST_F(PageTranslatorTest, CachedSentencesNeedNoCall) {
+  Translate({"a", "b"});
+  ASSERT_EQ(fake_.calls, 1);
+  auto [ok, out] = Translate({"b", "a"});
+  EXPECT_TRUE(ok);
+  EXPECT_THAT(out, ElementsAre("[b]", "[a]"));
+  EXPECT_EQ(fake_.calls, 1);
+}
+
+TEST_F(PageTranslatorTest, OnlyNewSentencesAreAsked) {
+  Translate({"a"});
+  auto [ok, out] = Translate({"a", "c"});
+  EXPECT_THAT(out, ElementsAre("[a]", "[c]"));
+  EXPECT_THAT(fake_.asked, ElementsAre("a", "c"));
+}
+
+TEST_F(PageTranslatorTest, MissingModelsAreReported) {
+  fake_.missing = {"it2_indic_en", "it2_en_indic"};
+  int changed = 0;
+  translator_.SetOnMissingChanged(base::BindRepeating([](int* n) { ++*n; }, &changed));
+  auto [ok, out] = Translate({"a"});
+  EXPECT_FALSE(ok);
+  EXPECT_THAT(out, IsEmpty());
+  EXPECT_THAT(translator_.missing(), ElementsAre(ModelUnit::kToEnglish, ModelUnit::kFromEnglish));
+  EXPECT_EQ(changed, 1);
+  EXPECT_EQ(translator_.cached(), 0u);
+
+  // Downloaded: the next request works and clears missing().
+  fake_.missing.clear();
+  auto [ok2, out2] = Translate({"a"});
+  EXPECT_TRUE(ok2);
+  EXPECT_THAT(translator_.missing(), IsEmpty());
+  EXPECT_EQ(changed, 2);
+}
+
+TEST_F(PageTranslatorTest, CacheIsBounded) {
+  std::vector<std::string> many;
+  for (size_t i = 0; i < PageTranslator::kMaxCached; ++i) {
+    many.push_back("s" + base::NumberToString(i));
+  }
+  Translate(many);
+  EXPECT_LT(translator_.cached(), PageTranslator::kMaxCached);
+}
+
+}  // namespace
+}  // namespace tark_captions
