+// Blocking: makes the download folder. On Windows it also lets the speech
+// process read the models: its sandbox token reads only what BUILTIN\Users
+// may, so the folder grants that group read access, inherited by every file
+// in it, as Chromium does for SODA's
+// (SodaComponentInstallerPolicy::SetComponentDirectoryPermission).
+void PrepareModelsDir(const base::FilePath& models_dir) {
+  base::CreateDirectory(models_dir.AppendASCII(kDownloadDir));
+#if BUILDFLAG(IS_WIN)
+  const std::optional<base::win::Sid> users_sid =
+      base::win::Sid::FromKnownSid(base::win::WellKnownSid::kBuiltinUsers);
+  if (!users_sid) {
+    return;
+  }
+  EXPLICIT_ACCESS explicit_access[1] = {};
+  explicit_access[0].grfAccessPermissions = GENERIC_READ | GENERIC_EXECUTE;
+  explicit_access[0].grfAccessMode = GRANT_ACCESS;
+  explicit_access[0].grfInheritance = SUB_CONTAINERS_AND_OBJECTS_INHERIT;
+  explicit_access[0].Trustee.TrusteeForm = TRUSTEE_IS_SID;
+  explicit_access[0].Trustee.TrusteeType = TRUSTEE_IS_WELL_KNOWN_GROUP;
+  explicit_access[0].Trustee.ptstrName = reinterpret_cast<LPTSTR>(users_sid->GetPSID());
+  PACL acl_ptr = nullptr;
+  if (::SetEntriesInAcl(std::size(explicit_access), explicit_access, nullptr, &acl_ptr) !=
+      ERROR_SUCCESS) {
+    LOG(ERROR) << "Tark captions: the models folder's access list was not made";
+    return;
+  }
+  base::win::ScopedLocalAllocTyped<ACL> acl = base::win::TakeLocalAlloc(acl_ptr);
+  if (::SetNamedSecurityInfo(const_cast<LPWSTR>(models_dir.value().c_str()), SE_FILE_OBJECT,
+                             DACL_SECURITY_INFORMATION, nullptr, nullptr, acl.get(),
+                             nullptr) != ERROR_SUCCESS) {
+    LOG(ERROR) << "Tark captions: the models folder is not readable by the speech process";
+  }
+#endif
+}
