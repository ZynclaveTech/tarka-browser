+++ b/chrome/browser/tark_updater/tark_updater_win.h
@@ -0,0 +1,30 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_UPDATER_TARK_UPDATER_WIN_H_
+#define CHROME_BROWSER_TARK_UPDATER_TARK_UPDATER_WIN_H_
+
+// Tark's Windows updater (W2): WinSparkle, built without OpenSSL
+// (windows/ci/build_winsparkle.ps1) and loaded from WinSparkle.dll next to
+// chrome.dll. It checks gettarka.com/appcast-windows.xml once a day and runs
+// only installers signed with Tark's EdDSA key, the Mac's Sparkle key.
+namespace tark_updater {
+
+// Loads and starts WinSparkle; called on the UI thread once the browser has
+// started. Without WinSparkle.dll, or if WinSparkle rejects the key, Tark runs
+// without updates.
+void Start();
+
+// Stops WinSparkle's threads; called on the UI thread before shutdown.
+void Stop();
+
+// Whether Start() set WinSparkle up, so "Check for Updates…" can work.
+bool IsRunning();
+
+// "Check for Updates…": checks now and shows WinSparkle's window.
+void CheckForUpdatesWithUi();
+
+}  // namespace tark_updater
+
+#endif  // CHROME_BROWSER_TARK_UPDATER_TARK_UPDATER_WIN_H_
