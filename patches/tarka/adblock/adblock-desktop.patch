+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_adblock/tark_adblock_switch.h"
+
+#include "base/json/json_reader.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_adblock {
+namespace {
+
+base::DictValue Settings(std::string_view json) {
+  return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC).value();
+}
+
+// "Block ads and trackers" used to switch uBlock Origin (a component
+// extension) on and off; whoever had it off keeps blocking off.
+TEST(TarkAdblockSwitchTest, UblockOffIsCarriedOver) {
+  EXPECT_TRUE(UblockWasOff(Settings(
+      R"({"onfgfofhhcjllijjogonbaokaiokfgna": {"disable_reasons": [1]}})")));
+  // Older profiles store the reasons as a bit mask.
+  EXPECT_TRUE(UblockWasOff(Settings(
+      R"({"onfgfofhhcjllijjogonbaokaiokfgna": {"disable_reasons": 1}})")));
+}
+
+TEST(TarkAdblockSwitchTest, UblockOnOrAbsentLeavesBlockingOn) {
+  EXPECT_FALSE(UblockWasOff(Settings(R"({})")));
+  EXPECT_FALSE(UblockWasOff(Settings(
+      R"({"onfgfofhhcjllijjogonbaokaiokfgna": {"state": 1}})")));
+  EXPECT_FALSE(UblockWasOff(Settings(
+      R"({"onfgfofhhcjllijjogonbaokaiokfgna": {"disable_reasons": []}})")));
+  EXPECT_FALSE(UblockWasOff(Settings(
+      R"({"onfgfofhhcjllijjogonbaokaiokfgna": {"disable_reasons": 0}})")));
+  // Another extension switched off says nothing about uBlock.
+  EXPECT_FALSE(UblockWasOff(Settings(
+      R"({"aaaabbbbccccddddeeeeffffgggghhhh": {"disable_reasons": [1]}})")));
+}
+
+}  // namespace
