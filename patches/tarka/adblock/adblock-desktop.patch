+// found in the LICENSE file.
+
+#include "chrome/browser/tark_adblock/tark_adblock_switch.h"
+
+namespace tark_adblock {
+
+bool UblockWasOff(const base::DictValue& extension_settings) {
+  const base::DictValue* ublock = extension_settings.FindDict(kUblockExtensionId);
+  if (!ublock) {
+    return false;
+  }
+  const base::Value* reasons = ublock->Find("disable_reasons");
+  if (!reasons) {
+    return false;
+  }
+  if (reasons->is_list()) {
+    return !reasons->GetList().empty();
+  }
+  return reasons->is_int() && reasons->GetInt() != 0;
+}
