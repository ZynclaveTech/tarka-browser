+
+namespace tark_adblock {
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kMigratedFromUblockPref, false);
+}
+
+void MaybeMigrateFromUblock(Profile* profile) {
+  PrefService* prefs = profile->GetPrefs();
+  if (profile->IsOffTheRecord() || prefs->GetBoolean(kMigratedFromUblockPref)) {
+    return;
+  }
+  prefs->SetBoolean(kMigratedFromUblockPref, true);
+  if (UblockWasOff(prefs->GetDict("extensions.settings"))) {
+    HostContentSettingsMapFactory::GetForProfile(profile)
+        ->SetDefaultContentSetting(ContentSettingsType::ADS,
+                                   CONTENT_SETTING_ALLOW);
+  }
+}
+
+bool DownloadsWanted() {
+#if BUILDFLAG(IS_ANDROID)
+  return true;
+#else
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return false;
+  }
+  for (Profile* profile : manager->GetLoadedProfiles()) {
+    if (profile->IsOffTheRecord()) {
+      continue;
+    }
+    if (HostContentSettingsMapFactory::GetForProfile(profile)
+            ->GetDefaultContentSetting(ContentSettingsType::ADS) !=
+        CONTENT_SETTING_ALLOW) {
+      return true;
+    }
+  }
+  return false;
+#endif
+}
+
