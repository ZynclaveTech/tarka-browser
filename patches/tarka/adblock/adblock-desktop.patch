+TEST(TarkAdblockBundleTest, DesktopConnectionsAreUnmetered) {
+  EXPECT_EQ(ClassifyConnection(/*connected=*/true, /*cellular=*/true),
+            Network::kUnmetered);
+  EXPECT_EQ(ClassifyConnection(/*connected=*/true, /*cellular=*/false),
+            Network::kUnmetered);
+  EXPECT_EQ(ClassifyConnection(/*connected=*/false, /*cellular=*/false),
+            Network::kNone);
+}
+
+TEST(TarkAdblockBundleTest, DesktopUpdateDueAfter24h) {
+  const base::Time now = base::Time::Now();
+  const Network network = ClassifyConnection(/*connected=*/true,
+                                             /*cellular=*/true);
+  EXPECT_TRUE(UpdateDue(now - base::Hours(25), now, network));
+  EXPECT_FALSE(UpdateDue(now - base::Hours(23), now, network));
+}
+
+// The bundle built into a desktop app sits in its assets folder.
+TEST(TarkAdblockBundleTest, BuiltInBundleIsVerified) {
+  base::ScopedTempDir assets;
+  ASSERT_TRUE(assets.CreateUniqueTempDir());
+  ASSERT_TRUE(base::CreateDirectory(assets.GetPath().AppendASCII("tark_adblock")));
+  const base::FilePath zip =
+      assets.GetPath().AppendASCII("tark_adblock").AppendASCII("lists.zip");
+  ASSERT_TRUE(base::WriteFile(zip, Zip()));
+  std::optional<Bundle> bundle =
+      ReadBundle(ReadBuiltInBundleFile(assets.GetPath()));
+  ASSERT_TRUE(bundle);
+  EXPECT_EQ(bundle->lists.size(), 2u);
+
+  // A truncated file is no bundle: the service stays fail-open.
+  ASSERT_TRUE(base::WriteFile(zip, Zip().substr(0, Zip().size() / 2)));
+  EXPECT_FALSE(ReadBundle(ReadBuiltInBundleFile(assets.GetPath())));
+}
+
+TEST(TarkAdblockBundleTest, NoBuiltInBundleIsEmpty) {
+  base::ScopedTempDir assets;
+  ASSERT_TRUE(assets.CreateUniqueTempDir());
+  EXPECT_EQ(ReadBuiltInBundleFile(assets.GetPath()), "");
+}
