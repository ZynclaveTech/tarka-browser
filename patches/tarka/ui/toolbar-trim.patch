Tark: the toolbar trimmed to spec 5.1's seven controls — back, forward,
reload, address bar, extensions, downloads, menu. The profile button shows
only in private and guest windows (ungoogled-chromium's --show-avatar-button
still overrides); tab search is no longer pinned to the tab strip by default
(Shift+Cmd+A, or re-pin it from the tab strip's menu). Chrome Labs already
hides itself (no experiments); there is no default side-panel button.

--- a/chrome/browser/ui/tabs/tab_strip_prefs.cc
+++ b/chrome/browser/ui/tabs/tab_strip_prefs.cc
@@ -20,7 +20,9 @@
 namespace tabs {
 
 void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
-  registry->RegisterBooleanPref(prefs::kTabSearchPinnedToTabstrip, true);
+  // Tark: tab search is not pinned to the tab strip by default (spec 5.1);
+  // Shift+Cmd+A opens it, and the tab strip's menu can pin it back.
+  registry->RegisterBooleanPref(prefs::kTabSearchPinnedToTabstrip, false);
   registry->RegisterBooleanPref(prefs::kOrganizerPanelPinnedToTabstrip, true);
   registry->RegisterBooleanPref(prefs::kEverythingMenuPinnedToTabstrip, true);
   registry->RegisterBooleanPref(prefs::kTabScrollButtonsPinnedToTabstrip, true);
--- a/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ b/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -601,7 +601,14 @@
 
     const std::string sab_value = base::CommandLine::ForCurrentProcess()->
                                   GetSwitchValueASCII("show-avatar-button");
-    if (sab_value == "always")
+    // Tark: the toolbar is back, forward, reload, address bar, extensions,
+    // downloads and menu (spec 5.1); the profile button shows only where it
+    // says something — "Private" in a private window, and in a guest
+    // window. --show-avatar-button=always brings it back.
+    if (sab_value.empty())
+      show_avatar_toolbar_button = browser_->GetProfile()->IsIncognitoProfile() ||
+                                   browser_->GetProfile()->IsGuestSession();
+    else if (sab_value == "always")
       show_avatar_toolbar_button = true;
     else if (sab_value == "incognito-and-guest")
       show_avatar_toolbar_button = browser_->GetProfile()->IsIncognitoProfile() ||
