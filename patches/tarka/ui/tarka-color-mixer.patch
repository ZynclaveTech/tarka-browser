+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_TARKA_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_TARKA_COLOR_MIXER_H_
+
+#include "ui/color/color_provider_key.h"
+
+namespace ui {
+class ColorProvider;
+}
+
+// Tark's palette (spec §6, from shodhya.com's paper.css), in the dark or the
+// light column as the device appearance says. Added after Chromium's own
+// mixers so it wins, and before a user's custom theme so a theme still can.
+// Skipped in increased-contrast and forced-colours modes.
+void AddTarkaColorMixer(ui::ColorProvider* provider,
+                        const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_TARKA_COLOR_MIXER_H_
