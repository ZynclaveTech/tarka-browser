--- a/chrome/browser/ui/color/tarka_color_mixer.cc
+++ b/chrome/browser/ui/color/tarka_color_mixer.cc
@@ -118,6 +118,56 @@
   mixer[kColorOmniboxResultsUrl] = {ui::ColorTransform(t.indigo)};
   mixer[kColorOmniboxResultsUrlSelected] = {ui::ColorTransform(t.indigo)};
 
+  // Tab groups (spec 6.1): Chromium's nine group colours mapped onto Tark's
+  // palette, the same colour on every surface a group appears (chip, menus,
+  // dialog, saved-group outline); the bookmark-bar pill is a tint of it with
+  // ink text. Light values are darkened to 3:1 on light paper
+  // (utils/tokens.py GROUP_LIGHT, tested).
+  struct GroupColour {
+    ui::ColorId active, inactive, context_menu, dialog, saved_fg,
+        saved_outline, bookmark_bar;
+    SkColor dark, light;
+  };
+  static constexpr GroupColour kGroups[] = {
+#define TARK_GROUP(C, dark, light)                                      \
+  {kColorTabGroupTabStripFrameActive##C,                                \
+   kColorTabGroupTabStripFrameInactive##C, kColorTabGroupContextMenu##C, \
+   kColorTabGroupDialog##C,              kColorSavedTabGroupForeground##C, \
+   kColorSavedTabGroupOutline##C,        kColorTabGroupBookmarkBar##C,     \
+   dark,                                  light}
+      TARK_GROUP(Blue, SkColorSetRGB(0x8f, 0x88, 0xff),
+                 SkColorSetRGB(0x43, 0x38, 0xca)),
+      TARK_GROUP(Red, SkColorSetRGB(0xff, 0x6b, 0x85),
+                 SkColorSetRGB(0xe6, 0x3e, 0x5c)),
+      TARK_GROUP(Yellow, SkColorSetRGB(0xff, 0xc5, 0x3d),
+                 SkColorSetRGB(0xb7, 0x81, 0x00)),
+      TARK_GROUP(Green, SkColorSetRGB(0x6f, 0xd3, 0xc1),
+                 SkColorSetRGB(0x2f, 0x99, 0x86)),
+      TARK_GROUP(Cyan, SkColorSetRGB(0x7f, 0xb7, 0xff),
+                 SkColorSetRGB(0x2d, 0x89, 0xff)),
+      TARK_GROUP(Purple, SkColorSetRGB(0xd9, 0x9c, 0xff),
+                 SkColorSetRGB(0xc0, 0x5a, 0xff)),
+      TARK_GROUP(Pink, SkColorSetRGB(0xff, 0x9f, 0x6b),
+                 SkColorSetRGB(0xf5, 0x56, 0x00)),
+      TARK_GROUP(Grey, SkColorSetRGB(0xbd, 0xb6, 0xa8),
+                 SkColorSetRGB(0x95, 0x8a, 0x74)),
+      TARK_GROUP(Orange, SkColorSetRGB(0xff, 0xb0, 0x74),
+                 SkColorSetRGB(0xc2, 0x5a, 0x00)),
+#undef TARK_GROUP
+  };
+  const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  for (const GroupColour& g : kGroups) {
+    const SkColor colour = dark ? g.dark : g.light;
+    mixer[g.active] = {ui::ColorTransform(colour)};
+    mixer[g.inactive] = {ui::ColorTransform(colour)};
+    mixer[g.context_menu] = {ui::ColorTransform(colour)};
+    mixer[g.dialog] = {ui::ColorTransform(colour)};
+    mixer[g.saved_outline] = {ui::ColorTransform(colour)};
+    mixer[g.bookmark_bar] = {
+        ui::ColorTransform(color_utils::AlphaBlend(colour, t.paper, SkAlpha{0x40}))};
+    mixer[g.saved_fg] = {ui::ColorTransform(t.ink)};
+  }
+
   // Menus.
   mixer[ui::kColorMenuBackground] = {ui::ColorTransform(t.raised)};
   mixer[ui::kColorMenuItemBackgroundSelected] = {ui::ColorTransform(wash)};
