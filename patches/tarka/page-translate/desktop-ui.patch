+// A language Tark can't translate on the Mac (Spanish: no Mac model) is not
+// offered anywhere, and asking anyway does nothing.
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       NoOfferForUnsupportedSource) {
+  Load(web_contents(), "/es.html", "es");
+  const std::string a = Text("a");
+  TarkPageTranslation* page = Page();
+  ASSERT_TRUE(page);
+  EXPECT_FALSE(page->CanOffer("es", "en"));
+  EXPECT_FALSE(manager()->GetLanguageState()->translate_enabled());
+  EXPECT_FALSE(manager()->CanManuallyTranslate(/*menu_logging=*/false));
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_SHOW_TRANSLATE));
