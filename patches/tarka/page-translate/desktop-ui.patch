+  ASSERT_TRUE(page->waiting());
+  EXPECT_EQ("hi", page->waiting()->source);
+  EXPECT_EQ("en", page->waiting()->target);
+  EXPECT_EQ(UnitSize(ModelUnit::kToEnglish), page->waiting_bytes());
+  ASSERT_TRUE(base::test::RunUntil([&] { return HeldDownloads() > 0; }));
+  EXPECT_EQ(a, Text("a"));
