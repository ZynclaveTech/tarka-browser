+#if !BUILDFLAG(IS_ANDROID)
+bool ChromeTranslateClient::TarkCanOffer(const std::string& source_language,
+                                         const std::string& target_language) {
+  if (!web_contents()) {
+    return false;
+  }
+  tark_captions::TarkPageTranslation::CreateForWebContents(web_contents());
+  return tark_captions::TarkPageTranslation::FromWebContents(web_contents())
+      ->CanOffer(source_language, target_language);
+}
+
+bool ChromeTranslateClient::TarkReadyToTranslate(
+    const std::string& source_language,
+    const std::string& target_language,
+    bool may_download) {
+  if (!web_contents()) {
+    return false;
+  }
+  tark_captions::TarkPageTranslation::CreateForWebContents(web_contents());
+  using Readiness = tark_captions::TarkPageTranslation::Readiness;
+  switch (tark_captions::TarkPageTranslation::FromWebContents(web_contents())
+              ->PrepareTranslation(source_language, target_language,
+                                   may_download)) {
+    case Readiness::kReady:
+      return true;
+    case Readiness::kDownloading:
+      // The bubble shows the download card while the models come; the page
+      // is translated once they are here.
+      ShowTranslateUI(translate::TRANSLATE_STEP_TRANSLATING, source_language,
+                      target_language, translate::TranslateErrors::NONE,
+                      /*triggered_from_menu=*/true);
+      return false;
+    case Readiness::kUnavailable:
+      return false;
+  }
+  return false;
+}
