+
+// static
+std::u16string TranslateBubbleView::TarkGettingReadyLine(int64_t bytes) {
+  return l10n_util::GetStringFUTF16(
+      IDS_TARK_PAGE_TRANSLATE_BUBBLE_GETTING_READY,
+      base::NumberToString16(tark_captions::Megabytes(bytes)));
+}
+
+std::unique_ptr<views::View> TranslateBubbleView::CreateTarkFootnote(
+    TranslateBubbleModel::ViewState view_state) {
+  tark_footnote_text_.clear();
+  tark_captions::TarkPageTranslation* page =
+      web_contents()
+          ? tark_captions::TarkPageTranslation::FromWebContents(web_contents())
+          : nullptr;
+  // The download card: the person's Translate waits for the models.
+  if (page && page->waiting()) {
+    tark_footnote_text_ = TarkGettingReadyLine(page->waiting_bytes());
+    auto card = std::make_unique<views::Label>(
+        tark_footnote_text_, views::style::CONTEXT_BUBBLE_FOOTER);
+    card->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    card->SetMultiLine(true);
+    return card;
+  }
+  if (view_state != TranslateBubbleModel::VIEW_STATE_AFTER_TRANSLATE) {
+    return nullptr;
+  }
+  // "Hindi → English · Show original"; Show original restores the page
+  // with no reload.
+  std::vector<size_t> offsets;
+  tark_footnote_text_ = TarkTranslatedLine(
+      model_->GetSourceLanguageNameAt(model_->GetSourceLanguageIndex()),
+      model_->GetTargetLanguageNameAt(model_->GetTargetLanguageIndex()),
+      &offsets);
+  const size_t link_length = tark_footnote_text_.size() - offsets[2];
+  auto line = std::make_unique<views::StyledLabel>();
+  line->SetText(tark_footnote_text_);
+  line->SetTextContext(views::style::CONTEXT_BUBBLE_FOOTER);
+  line->SetDefaultTextStyle(views::style::STYLE_SECONDARY);
+  // Posted: Show original replaces this line, which mustn't go while its
+  // own link runs.
+  line->AddStyleRange(
+      gfx::Range(offsets[2], offsets[2] + link_length),
+      views::StyledLabel::RangeStyleInfo::CreateForLink(base::BindRepeating(
+          [](base::WeakPtr<TranslateBubbleView> bubble) {
+            base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, base::BindOnce(&TranslateBubbleView::ShowOriginal,
+                                          bubble));
+          },
+          tark_weak_factory_.GetWeakPtr())));
+  return line;
+}
