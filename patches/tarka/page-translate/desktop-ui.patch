+// A Private window translates with models already on the Mac and keeps
+// nothing; without them it offers nothing and never downloads.
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       PrivateWindowKeepsNothing) {
+  const std::string accept_languages =
+      prefs()->GetString(language::prefs::kAcceptLanguages);
+  BrowserWindowInterface* incognito = CreateIncognitoBrowser();
+  content::WebContents* contents =
+      incognito->GetTabStripModel()->GetActiveWebContents();
+
+  // Without the models: no offer, no download.
+  TarkPageTranslation::SetModelsForTesting(false);
+  Load(contents, "/hi.html", "hi");
+  const std::string a = Text(contents, "a");
+  EXPECT_FALSE(manager(contents)->GetLanguageState()->translate_enabled());
+  EXPECT_FALSE(manager(contents)->CanManuallyTranslate(/*menu_logging=*/false));
+  TarkPageTranslation* page = Page(contents);
+  ASSERT_TRUE(page);
+  EXPECT_FALSE(page->Start("en"));
+  manager(contents)->TranslatePage("hi", "en", /*triggered_from_menu=*/true);
+  content::RunAllTasksUntilIdle();
+  EXPECT_FALSE(page->waiting());
+  EXPECT_EQ(0u, HeldDownloads());
+  EXPECT_EQ(a, Text(contents, "a"));
+
+  // With them: translated as in a regular window.
+  TarkPageTranslation::SetModelsForTesting(true);
+  Load(contents, "/hi.html", "hi");
+  EXPECT_TRUE(manager(contents)->CanManuallyTranslate(/*menu_logging=*/false));
+  ASSERT_TRUE(Page(contents)->Start("en"));
+  EXPECT_TRUE(WaitForText(contents, "a", Fake(a)));
+
+  CloseBrowserSynchronously(incognito);
+  // Nothing of it reached the regular profile.
+  EXPECT_EQ(accept_languages,
+            prefs()->GetString(language::prefs::kAcceptLanguages));
+  EXPECT_EQ(0u, HeldDownloads());
+}
