+constexpr char kHindiPage[] =
+    "<!doctype html><html lang=\"hi\"><head><meta charset=\"utf-8\">"
+    "<title>पन्ना</title></head><body>"
+    "<p id=\"a\">भारत एक विशाल देश है। यहाँ अनेक भाषाएँ बोली जाती हैं।</p>"
+    "<p id=\"b\">हिंदी भारत की सबसे अधिक बोली जाने वाली भाषा है।</p>"
+    "</body></html>";
+
+// Spanish: Tark has no Spanish model on the Mac, so nothing is offered.
+constexpr char kSpanishPage[] =
+    "<!doctype html><html lang=\"es\"><head><meta charset=\"utf-8\">"
+    "<title>Página</title></head><body>"
+    "<p id=\"a\">España es un país grande donde se hablan muchas lenguas "
+    "todos los días en ciudades y pueblos de todo el territorio.</p>"
+    "</body></html>";
+
+// The fake translator: "EN:" before each text.
+std::string Fake(const std::string& text) {
+  return "EN:" + text;
+}
+
+std::unique_ptr<net::test_server::HttpResponse> ServePages(
+    const net::test_server::HttpRequest& request) {
+  const char* content = nullptr;
+  if (request.relative_url == "/hi.html") {
+    content = kHindiPage;
+  } else if (request.relative_url == "/es.html") {
+    content = kSpanishPage;
+  } else {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/html; charset=utf-8");
+  response->set_content(content);
+  return response;
+}
+
+class TarkPageTranslateBrowserTest : public InProcessBrowserTest {
+ protected:
+  ~TarkPageTranslateBrowserTest() override {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    EXPECT_TRUE(models_dir_.Delete());
+  }
+
+  // Captions' model store (TarkCaptionModels, made on first use, after this)
+  // uses an empty folder of the test's, never the person's own.
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(models_dir_.CreateUniqueTempDir());
+    command_line->AppendSwitchPath("tark-captions-models-dir-for-testing",
+                                   models_dir_.GetPath());
+  }
+
+  void SetUpOnMainThread() override {
+    // Every http(s) request from as early as a test can: the test server's
+    // are fine; gettarka.com/models (the models' download) is held, never
+    // answered; anything else fails the test (TearDownOnMainThread).
+    interceptor_ = std::make_unique<content::URLLoaderInterceptor>(
+        base::BindLambdaForTesting(
+            [this](content::URLLoaderInterceptor::RequestParams* params) {
+              const GURL& url = params->url_request.url;
+              if (!url.SchemeIsHTTPOrHTTPS() || url.host() == "127.0.0.1" ||
+                  url.host() == "localhost") {
+                return false;
+              }
+              base::AutoLock lock(lock_);
+              if (url.host() == "gettarka.com" &&
+                  url.path().starts_with("/models/")) {
+                // Kept open, never answered: the download stays pending.
+                // (Pending ends, so they may be let go on any thread.)
+                held_loaders_.push_back(std::move(params->receiver));
+                held_.push_back(params->client.Unbind());
+                return true;
+              }
+              unexpected_.push_back(url.spec());
+              return true;  // never reaches the network
+            }));
+    InProcessBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServePages));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    TarkPageTranslateHost::SetTranslatorForTesting(base::BindRepeating(
+        &TarkPageTranslateBrowserTest::FakeTranslate, base::Unretained(this)));
+    TarkPageTranslation::SetModelsForTesting(true);
+  }
+
+  void TearDownOnMainThread() override {
+    TarkPageTranslateHost::SetTranslatorForTesting({});
+    TarkPageTranslation::SetModelsForTesting(std::nullopt);
+    {
+      base::AutoLock lock(lock_);
+      EXPECT_TRUE(unexpected_.empty())
+          << "requested: " << (unexpected_.empty() ? "" : unexpected_[0]);
+      held_.clear();
+      held_loaders_.clear();
+    }
+    interceptor_.reset();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  void FakeTranslate(
+      std::vector<std::string> texts,
+      std::string source,
+      std::string target,
+      base::OnceCallback<void(std::vector<std::optional<std::string>>)> done) {
+    ++batches_;
+    std::vector<std::optional<std::string>> results;
+    for (const std::string& text : texts) {
+      results.push_back(Fake(text));
+    }
+    std::move(done).Run(std::move(results));
+  }
+
+  content::WebContents* web_contents() {
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+
+  translate::TranslateManager* manager(content::WebContents* contents) {
+    return ChromeTranslateClient::FromWebContents(contents)
+        ->GetTranslateManager();
+  }
+  translate::TranslateManager* manager() { return manager(web_contents()); }
+
+  PrefService* prefs() { return browser()->profile()->GetPrefs(); }
+
+  // The tab's page translation (ChromeTranslateClient makes it as soon as
+  // translate asks whether to offer; made here in case it hasn't yet).
+  TarkPageTranslation* Page(content::WebContents* contents) {
+    TarkPageTranslation::CreateForWebContents(contents);
+    return TarkPageTranslation::FromWebContents(contents);
+  }
+  TarkPageTranslation* Page() { return Page(web_contents()); }
+
+  // Loads a page in `contents` and waits until translate has its language.
+  void Load(content::WebContents* contents,
+            const std::string& path,
+            const std::string& language) {
+    ASSERT_TRUE(content::NavigateToURL(
+        contents, embedded_test_server()->GetURL(path)));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return manager(contents)->GetLanguageState()->source_language() ==
+             language;
+    }));
+  }
+  void LoadHindiPage() { Load(web_contents(), "/hi.html", "hi"); }
+
+  std::string Text(content::WebContents* contents, const std::string& id) {
+    return content::EvalJs(contents, "document.getElementById('" + id +
+                                         "').textContent")
+        .ExtractString();
+  }
+  std::string Text(const std::string& id) { return Text(web_contents(), id); }
+
+  // Waits (in the page) until the element's text is `expected`.
+  bool WaitForText(content::WebContents* contents,
+                   const std::string& id,
+                   const std::string& expected) {
+    return content::EvalJs(
+               contents,
+               content::JsReplace(
+                   "new Promise(resolve => {"
+                   "  const check = () => {"
+                   "    if (document.getElementById($1).textContent === $2) {"
+                   "      resolve(true);"
+                   "    } else {"
+                   "      setTimeout(check, 50);"
+                   "    }"
+                   "  };"
+                   "  check();"
+                   "})",
+                   id, expected))
+        .ExtractBool();
+  }
+  bool WaitForText(const std::string& id, const std::string& expected) {
+    return WaitForText(web_contents(), id, expected);
+  }
+
+  size_t HeldDownloads() {
+    base::AutoLock lock(lock_);
+    return held_.size();
+  }
+
+  // The models' download answers with an error (the connection drops).
+  void FailHeldDownloads() {
+    base::AutoLock lock(lock_);
+    held_.clear();
+    held_loaders_.clear();
+  }
+
+  // The bubble, when it shows: only in the last active window, which
+  // browser_tests don't promise (interactive_ui_tests do).
+  TranslateBubbleView* Bubble() {
+    TranslateBubbleController* controller =
+        TranslateBubbleController::From(browser());
+    return controller ? controller->GetTranslateBubble() : nullptr;
+  }
+
+  bool AppMenuHasTranslate() {
+    AppMenuModel model(nullptr, browser());
+    model.Init();
+    return model.GetIndexOfCommandId(IDC_SHOW_TRANSLATE).has_value();
+  }
+
+  base::ScopedTempDir models_dir_;
+  base::Lock lock_;
+  std::unique_ptr<content::URLLoaderInterceptor> interceptor_;
+  std::vector<mojo::PendingRemote<network::mojom::URLLoaderClient>> held_
+      GUARDED_BY(lock_);
+  std::vector<mojo::PendingReceiver<network::mojom::URLLoader>> held_loaders_
+      GUARDED_BY(lock_);
+  std::vector<std::string> unexpected_ GUARDED_BY(lock_);
+  int batches_ = 0;
+};
+
+// The person's Translate changes the page in place, Show original puts it
+// back, with no reload either way; the bubble says "Hindi → English · Show
+// original".
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest,
+                       TranslatesAndRevertsWithoutReload) {
+  LoadHindiPage();
+  const std::string a = Text("a");
+  const std::string b = Text("b");
+  // A mark in the page's own world that a reload would wipe.
+  ASSERT_TRUE(content::ExecJs(web_contents(), "window.tarkMark = 7;"));
+  content::NavigationController& controller = web_contents()->GetController();
+  const int entries = controller.GetEntryCount();
+  const int entry_id = controller.GetLastCommittedEntry()->GetUniqueID();
+
+  // Offered: the icon (translate_enabled) and the menus.
+  EXPECT_TRUE(manager()->GetLanguageState()->translate_enabled());
+  EXPECT_TRUE(manager()->CanManuallyTranslate(/*menu_logging=*/false));
+
+  TarkPageTranslation* page = Page();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(page->Start("en"));
+  EXPECT_TRUE(WaitForText("a", Fake(a)));
+  EXPECT_TRUE(WaitForText("b", Fake(b)));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return manager()->GetLanguageState()->IsPageTranslated(); }));
+  EXPECT_EQ("en", manager()->GetLanguageState()->current_language());
+  EXPECT_EQ(0u, HeldDownloads());
+
+  if (TranslateBubbleView* bubble = Bubble()) {
+    EXPECT_EQ(u"Hindi → English · Show original",
+              bubble->tark_footnote_text_for_testing());
+  } else {
+    LOG(WARNING) << "No bubble (window not active); its line is unchecked.";
+  }
+
+  page->Revert();
+  EXPECT_TRUE(WaitForText("a", a));
+  EXPECT_TRUE(WaitForText("b", b));
+  EXPECT_FALSE(manager()->GetLanguageState()->IsPageTranslated());
+  EXPECT_EQ(7, content::EvalJs(web_contents(), "window.tarkMark"));
+  EXPECT_EQ(entries, controller.GetEntryCount());
+  EXPECT_EQ(entry_id, controller.GetLastCommittedEntry()->GetUniqueID());
+}
+
+// The bubble's lines, exactly (the same functions draw them; no window
+// needed): the translated line with its link, and the download card with
+// the Mac manifest's size.
+IN_PROC_BROWSER_TEST_F(TarkPageTranslateBrowserTest, BubbleLinesExact) {
+  std::vector<size_t> offsets;
+  const std::u16string line =
+      TranslateBubbleView::TarkTranslatedLine(u"Hindi", u"English", &offsets);
+  EXPECT_EQ(u"Hindi → English · Show original", line);
+  ASSERT_EQ(3u, offsets.size());
+  EXPECT_EQ(u"Show original", line.substr(offsets[2]));
+  EXPECT_EQ(u"Getting translation ready · 238 MB",
+            TranslateBubbleView::TarkGettingReadyLine(
+                UnitSize(ModelUnit::kToEnglish)));
+  EXPECT_EQ(u"Getting translation ready · 282 MB",
+            TranslateBubbleView::TarkGettingReadyLine(
+                UnitSize(ModelUnit::kFromEnglish)));
+}
