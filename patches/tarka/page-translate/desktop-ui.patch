+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("/hi.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* contents = web_contents();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return manager(contents)->GetLanguageState()->source_language() == "hi";
+  }));
+  TarkPageTranslation* page = Page(contents);
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(page->Start("en"));
+  ASSERT_TRUE(page->waiting());
+  ASSERT_TRUE(base::test::RunUntil([&] { return HeldDownloads() > 0; }));
+
+  content::WebContentsDestroyedWatcher destroyed(contents);
+  TabStripModel* tabs = browser()->tab_strip_model();
+  tabs->CloseWebContentsAt(tabs->GetIndexOfWebContents(contents),
+                           TabCloseTypes::CLOSE_NONE);
+  destroyed.Wait();
+
+  // The download ends (failed) with the tab gone; the store tells its
+  // observers, none of which is the closed tab's any more.
