+// Destroying the logic mid-translation lets the units go and the translator
+// go once, and nothing it calls asks it anything back (the tab's
+// TarkPageTranslation stops observing the store before this runs).
+TEST_F(TarkPageTranslationTest, DestroyWhileWaitingDoesNotReenter) {
+  int sends_after_destroy = 0;
+  {
+    PageTranslation page(&backend_, false);
+    Translate(page, {"एक"});
+    ASSERT_EQ(backend_.holds[ModelUnit::kToEnglish], 1);
+    backend_.sent.clear();
+  }
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results(1));  // answered null, not deferred
+  EXPECT_TRUE(backend_.holds.empty());
+  EXPECT_EQ(backend_.releases, 1);
+  EXPECT_EQ(backend_.disconnects, 1);
+  EXPECT_EQ(backend_.connects, 1);  // nothing connected again
+  sends_after_destroy = static_cast<int>(backend_.sent.size());
+  EXPECT_EQ(sends_after_destroy, 0);
+  task_environment_.FastForwardBy(PageTranslation::kBatchDeadline);  // no timer left
+  EXPECT_EQ(answers_, 1);
+}
