+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/page_translation.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/services/speech/tark_page_batch.h"
+#include "components/tark_captions/translation_engine.h"
+
+namespace tark_captions {
+
+std::vector<ModelUnit> PageUnitsFor(std::string_view source, std::string_view target) {
+  std::vector<ModelUnit> units;
+  for (TranslationDirection direction : PageDirectionsFor(source, target)) {
+    switch (direction) {
+      case TranslationDirection::kIndicToEnglish:
+        units.push_back(ModelUnit::kToEnglish);
+        break;
+      case TranslationDirection::kEnglishToIndic:
+        units.push_back(ModelUnit::kFromEnglish);
+        break;
+      case TranslationDirection::kSpanishToEnglish:
+        return {};  // no Mac download for it
+    }
+  }
+  return units;
+}
+
+PageTranslation::Pending::Pending() = default;
+PageTranslation::Pending::Pending(Pending&&) = default;
+PageTranslation::Pending& PageTranslation::Pending::operator=(Pending&&) = default;
+PageTranslation::Pending::~Pending() = default;
+
+PageTranslation::PageTranslation(Backend* backend, bool off_the_record)
+    : backend_(backend), off_the_record_(off_the_record) {}
+
+PageTranslation::~PageTranslation() {
+  Cancel();
+  Unload();
+}
+
+void PageTranslation::Translate(std::vector<std::string> texts,
+                                std::string source,
+                                std::string target,
+                                ResultsCallback callback) {
+  if (texts.empty() || !ModelsReady(source, target)) {
+    std::move(callback).Run(Results(texts.size()));
+    return;
+  }
+  idle_.Stop();
+  if (!connected_) {
+    connected_ = true;
+    DVLOG(1) << "tark-page: browser connecting to the speech process";
+    backend_->Connect();
+  }
+  for (ModelUnit unit : PageUnitsFor(source, target)) {
+    if (!std::ranges::contains(held_, unit)) {
+      backend_->HoldUnit(unit, true);
+      held_.push_back(unit);
+    }
+  }
+  const uint64_t id = next_id_++;
+  Pending& batch = pending_[id];
+  batch.results = Results(texts.size());
+  batch.texts = std::move(texts);
+  batch.source = std::move(source);
+  batch.target = std::move(target);
+  batch.callback = std::move(callback);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&PageTranslation::OnDeadline, weak_factory_.GetWeakPtr(), id),
+      kBatchDeadline);
+  SendNext(id);
+}
+
+bool PageTranslation::WarmOnDetection(std::string_view source,
+                                      std::string_view target,
+                                      bool enabled,
+                                      bool visible) {
+  const std::string pair = std::string(source) + ">" + std::string(target);
+  if (!enabled || !visible || pair == warmed_ || connected_ || !pending_.empty() ||
+      !ModelsReady(source, target)) {
+    return false;  // ModelsReady: no pair without models, and never a download
+  }
+  warmed_ = pair;
+  DVLOG(1) << "tark-page: warming " << pair;
+  connected_ = true;
+  backend_->Connect();
+  for (ModelUnit unit : PageUnitsFor(source, target)) {
+    if (!std::ranges::contains(held_, unit)) {
+      backend_->HoldUnit(unit, true);
+      held_.push_back(unit);
+    }
+  }
+  // An empty batch: the service loads the model and answers; the answer
+  // (even kBusyOtherModel) is ignored.
+  backend_->SendBatch(std::string(source), std::string(target), {},
+                      base::BindOnce([](BatchStatus, Results) {}));
+  MaybeStartIdleTimer();
+  return true;
+}
+
+bool PageTranslation::ModelsReady(std::string_view source, std::string_view target) const {
+  const std::vector<ModelUnit> units = PageUnitsFor(source, target);
+  return !units.empty() &&
+         std::ranges::all_of(units, [&](ModelUnit unit) { return backend_->UnitReady(unit); });
+}
+
+int64_t PageTranslation::MissingBytes(std::string_view source, std::string_view target) const {
+  int64_t bytes = 0;
+  for (ModelUnit unit : PageUnitsFor(source, target)) {
+    if (!backend_->UnitReady(unit)) {
+      bytes += backend_->UnitBytes(unit);
+    }
+  }
+  return bytes;
+}
+
+bool PageTranslation::RequestModels(std::string_view source, std::string_view target) {
+  const std::vector<ModelUnit> units = PageUnitsFor(source, target);
+  if (off_the_record_ || units.empty()) {
+    return false;
+  }
+  for (ModelUnit unit : units) {
+    if (!backend_->UnitReady(unit)) {
+      backend_->DownloadUnit(unit);
+    }
+  }
+  return true;
+}
+
+void PageTranslation::Cancel() {
+  if (!pending_.empty() && connected_) {
+    backend_->DropSent();
+  }
+  AnswerAllNull();
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::OnTabHidden() {
+  // Let go first, then answer: a batch a callback starts connects again.
+  Unload();
+  AnswerAllDeferred();
+}
+
+void PageTranslation::OnBackendGone() {
+  connected_ = false;  // nothing to let go
+  Unload();
+  AnswerAllNull();
+}
+
+void PageTranslation::SendNext(uint64_t id) {
+  auto it = pending_.find(id);
+  if (it == pending_.end() || !connected_) {
+    return;  // answered meanwhile (Cancel, hidden, deadline)
+  }
+  const Pending& batch = it->second;
+  const std::vector<std::string> items(batch.texts.begin() + batch.next, batch.texts.end());
+  backend_->SendBatch(batch.source, batch.target, items,
+                      base::BindOnce(&PageTranslation::OnBatch, weak_factory_.GetWeakPtr(), id));
+}
+
+void PageTranslation::OnBatch(uint64_t id, BatchStatus status, Results results) {
+  auto it = pending_.find(id);
+  if (it == pending_.end()) {
+    return;  // cancelled: the page it was for is gone
+  }
+  Pending& batch = it->second;
+  switch (status) {
+    case BatchStatus::kOk: {
+      const std::vector<std::string> items(batch.texts.begin() + batch.next, batch.texts.end());
+      // Which of `results` are answers (translated, or null for a failed or
+      // too-long text: kept original, never sent again) and which are the
+      // tail the call didn't take: the service's bound, shared.
+      const size_t end = speech::TarkPageBatchEnd(items);
+      if (results.size() != items.size() || end == 0) {
+        DVLOG(1) << "tark-page: browser batch answer malformed results=" << results.size()
+                 << " items=" << items.size();
+        Finish(id);  // a malformed answer: the rest keep their originals
+        return;
+      }
+      for (size_t i = 0; i < end; ++i) {
+        batch.results[batch.next + i] = std::move(results[i]);
+      }
+      batch.next += end;
+      if (batch.next < batch.texts.size()) {
+        SendNext(id);
+      } else {
+        Finish(id);
+      }
+      return;
+    }
+    case BatchStatus::kModelMissing:
+      Finish(id);
+      return;
+    case BatchStatus::kBusyOtherModel:
+      if (batch.busy_retries >= kMaxBusyRetries) {
+        DVLOG(1) << "tark-page: browser batch failed, captions hold another model";
+        Finish(id);
+        return;
+      }
+      ++batch.busy_retries;
+      base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, base::BindOnce(&PageTranslation::SendNext, weak_factory_.GetWeakPtr(), id),
+          kBusyRetry);
+      return;
+  }
+}
+
+void PageTranslation::Finish(uint64_t id) {
+  auto it = pending_.find(id);
+  if (it == pending_.end()) {
+    return;
+  }
+  Pending batch = std::move(it->second);
+  pending_.erase(it);
+  std::move(batch.callback).Run(std::move(batch.results));
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::OnDeadline(uint64_t id) {
+  if (!pending_.contains(id)) {
+    return;
+  }
+  DVLOG(1) << "tark-page: browser batch deadline pending=" << pending_.size();
+  // Everything outstanding was on that translator, so it all answers
+  // deferred and the script sends it again; the next batch gets a new one.
+  if (connected_) {
+    backend_->DropSent();
+  }
+  AnswerAllDeferred();
+  MaybeStartIdleTimer();
+}
+
+void PageTranslation::AnswerAllNull() {
+  // Snapshot first: a callback may translate again.
+  std::map<uint64_t, Pending> pending = std::move(pending_);
+  pending_.clear();
+  for (auto& [id, batch] : pending) {
+    std::move(batch.callback).Run(Results(batch.texts.size()));
+  }
+}
+
+void PageTranslation::AnswerAllDeferred() {
+  // Snapshot first: a callback may translate again.
+  std::map<uint64_t, Pending> pending = std::move(pending_);
+  pending_.clear();
+  for (auto& [id, batch] : pending) {
+    std::move(batch.callback).Run(Results());
+  }
+}
+
+void PageTranslation::MaybeStartIdleTimer() {
+  if (connected_ && pending_.empty()) {
+    idle_.Start(FROM_HERE, kIdleUnload,
+                base::BindOnce(&PageTranslation::Unload, base::Unretained(this)));
+  }
+}
+
+void PageTranslation::Unload() {
+  idle_.Stop();
+  if (connected_) {
+    connected_ = false;
+    backend_->ReleaseModel();
+    backend_->Disconnect();
+  }
+  ReleaseUnits();
+}
+
+void PageTranslation::ReleaseUnits() {
+  for (ModelUnit unit : held_) {
+    backend_->HoldUnit(unit, false);
+  }
+  held_.clear();
+}
+
+}  // namespace tark_captions
