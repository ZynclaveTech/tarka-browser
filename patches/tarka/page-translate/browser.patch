+
+#ifndef CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATION_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATION_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/tark_captions/model_manifest.h"
+
+namespace tark_captions {
+
+// The Mac's download units a page in `source` needs to reach `target`, in
+// order (the engine's PageDirectionsFor): to_english for an Indian source,
+// from_english for an Indian target, both for Indian ↔ Indian. Empty when the
+// Mac has no model for the pair (Spanish: captions' opus-mt is Android's
+// download, not the Mac's), or the two are the same.
+std::vector<ModelUnit> PageUnitsFor(std::string_view source, std::string_view target);
+
+// Keep in sync with android/patches/page-translate-browser.patch
+// (chrome/browser/tark_captions_android/page_translation.*), which this is
+// copied from; the differences are the Mac's units, statuses and tail.
+//
+// One tab's page translation on the Mac, without content or mojo
+// (TarkPageTranslation is the tab's side; this is what it decides, tested on
+// the build machine). Ported from Android's PageTranslation. Batches go to
+// the profile's speech process (TarkCaptionTranslator.TranslatePageBatch)
+// through the Backend; the translator is bound on the first batch and let go
+// after three idle minutes, when the tab is hidden, or when the process goes.
+// One TranslatePageBatch call takes at most speech::TarkPageBatchEnd's items;
+// the rest are sent again here until the batch is done. A batch whose page is
+// gone (Cancel) answers all-null at once and its late results are dropped.
+// Off the record nothing is downloaded.
+class PageTranslation {
+ public:
+  // One per text; null keeps that text's original. An empty Results for a
+  // non-empty batch means "deferred": nothing was wrong with the texts, the
+  // batch was let go (tab hidden, the deadline passed), and the page's script
+  // sends them again (at most twice: the script's MAX_DEFERRALS).
+  using Results = std::vector<std::optional<std::string>>;
+  using ResultsCallback = base::OnceCallback<void(Results)>;
+
+  // media::mojom::PageBatchStatus, without the mojom.
+  enum class BatchStatus { kOk, kModelMissing, kBusyOtherModel };
+  using BatchCallback = base::OnceCallback<void(BatchStatus, Results)>;
+
+  static constexpr base::TimeDelta kIdleUnload = base::Minutes(3);
+  // A batch not answered by then answers deferred; the script sends it again.
+  static constexpr base::TimeDelta kBatchDeadline = base::Seconds(30);
+  // Captions hold another model (kBusyOtherModel; captions win): the batch
+  // is sent again after kBusyRetry, at most kMaxBusyRetries times, then fails
+  // (its texts keep their originals).
+  // The deadline still runs meanwhile: a batch whose busy retries pass
+  // kBatchDeadline answers deferred instead.
+  static constexpr base::TimeDelta kBusyRetry = base::Seconds(10);
+  static constexpr int kMaxBusyRetries = 2;
+
+  class Backend {
+   public:
+    virtual ~Backend() = default;
+    // Binds a translator on the profile's speech process, starting it
+    // without speech when captions aren't running.
+    virtual void Connect() = 0;
+    // Lets the translator go.
+    virtual void Disconnect() = 0;
+    // TarkCaptionTranslator.ReleasePageModel: the page's model unloads now
+    // (captions' models stay).
+    virtual void ReleaseModel() = 0;
+    // Drops what was sent and not answered (the page went, the deadline): a
+    // new translator for the next batch; replies on the old one never come.
+    virtual void DropSent() = 0;
+    // One TranslatePageBatch on the connected translator.
+    virtual void SendBatch(const std::string& source,
+                           const std::string& target,
+                           const std::vector<std::string>& items,
+                           BatchCallback done) = 0;
+    virtual bool UnitReady(ModelUnit unit) const = 0;
+    // Held from deletion while a batch may use it (CaptionModelStore::
+    // HoldForPage).
+    virtual void HoldUnit(ModelUnit unit, bool hold) = 0;
+    // Downloads `unit` (captions' downloads; never off the record).
+    virtual void DownloadUnit(ModelUnit unit) = 0;
+    virtual int64_t UnitBytes(ModelUnit unit) const = 0;
+  };
+
+  PageTranslation(Backend* backend, bool off_the_record);
+  PageTranslation(const PageTranslation&) = delete;
+  PageTranslation& operator=(const PageTranslation&) = delete;
+  ~PageTranslation();
+
+  // Results in `texts`' order; a sentence that failed is null (the page keeps
+  // its original). All null at once when the models are not on the Mac.
+  void Translate(std::vector<std::string> texts,
+                 std::string source,
+                 std::string target,
+                 ResultsCallback callback);
+  bool ModelsReady(std::string_view source, std::string_view target) const;
+  // The bytes still to download for the pair (0 when ready).
+  int64_t MissingBytes(std::string_view source, std::string_view target) const;
+  // The user's Translate: downloads the pair's missing models. False (nothing
+  // asked) off the record or for a pair without models.
+  bool RequestModels(std::string_view source, std::string_view target);
+  // Translate found the page's language (`source`, offered into `target`):
+  // starts loading the pair's model in the speech process ahead of the
+  // person's Translate, with an empty batch. Only when `enabled` (the Page
+  // translation switch), the tab is `visible`, the pair has models and they
+  // are all on the Mac already (it never downloads, Private or not), nothing
+  // is connected yet, and not for the same pair twice in a row in this tab.
+  // Nothing else changes; the result is ignored and the idle unload bounds
+  // what it holds. True when it warmed. The pair counts as warmed when the
+  // batch is sent, before any answer: one answered kModelMissing or
+  // kBusyOtherModel is not warmed again for that pair. While the previous
+  // pair's connection is still live (`connected_`, until its idle unload), a
+  // new pair is not warmed either.
+  bool WarmOnDetection(std::string_view source,
+                       std::string_view target,
+                       bool enabled,
+                       bool visible);
+
+  // The page went (a navigation, Show original): outstanding batches answer
+  // all-null now.
+  void Cancel();
+  // The tab was hidden: no translating there, the model goes; outstanding
+  // batches answer deferred. The next batch (the tab shown again) connects
+  // again.
+  void OnTabHidden();
+  // The speech process went away (crash, idle).
+  void OnBackendGone();
+
+  bool connected() const { return connected_; }
+  size_t outstanding() const { return pending_.size(); }
+
+ private:
+  struct Pending {
+    Pending();
+    Pending(Pending&&);
+    Pending& operator=(Pending&&);
+    ~Pending();
+
+    std::vector<std::string> texts;
+    std::string source;
+    std::string target;
+    // Filled as the calls answer; returned when `next` reaches the end.
+    Results results;
+    // The first text not answered yet: the tail sent again.
+    size_t next = 0;
+    int busy_retries = 0;
+    ResultsCallback callback;
+  };
+
+  // Sends `id`'s texts from `next` on.
+  void SendNext(uint64_t id);
+  void OnBatch(uint64_t id, BatchStatus status, Results results);
+  void Finish(uint64_t id);
+  void OnDeadline(uint64_t id);
+  // Answers every outstanding batch all-null.
+  void AnswerAllNull();
+  // Answers every outstanding batch deferred (an empty Results).
+  void AnswerAllDeferred();
+  void Unload();
+  void ReleaseUnits();
+  void MaybeStartIdleTimer();
+
+  const raw_ptr<Backend> backend_;
+  const bool off_the_record_;
+  bool connected_ = false;
+  uint64_t next_id_ = 1;
+  std::map<uint64_t, Pending> pending_;
+  std::vector<ModelUnit> held_;
+  // The pair WarmOnDetection last warmed ("source>target"), set when its
+  // empty batch is sent, whatever the answer.
+  std::string warmed_;
+  base::OneShotTimer idle_;
+  base::WeakPtrFactory<PageTranslation> weak_factory_{this};
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_PAGE_TRANSLATION_H_
