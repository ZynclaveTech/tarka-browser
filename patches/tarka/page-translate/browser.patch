+// After a busy wait the batch goes through once captions let the slot go.
+TEST_F(TarkPageTranslationTest, BusyThenTranslated) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक"});
+  backend_.Answer(BatchStatus::kBusyOtherModel, Results(1));
