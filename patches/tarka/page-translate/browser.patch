+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// TarkPageTranslation's decisions (PageTranslation), on the build machine.
+// Ported from Android's tark_page_translation_unittest.cc.
+
+#include "chrome/browser/tark_captions/page_translation.h"
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/test/task_environment.h"
+#include "chrome/services/speech/tark_page_batch.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+using Results = PageTranslation::Results;
+using BatchStatus = PageTranslation::BatchStatus;
+
+class FakeBackend : public PageTranslation::Backend {
+ public:
+  struct Sent {
+    std::vector<std::string> items;
+    PageTranslation::BatchCallback done;
+  };
+
+  void Connect() override {
+    ++connects;
+    connected = true;
+  }
+  void Disconnect() override {
+    ++disconnects;
+    connected = false;
+  }
+  void ReleaseModel() override { ++releases; }
+  void DropSent() override {
+    ++drops;
+    for (Sent& batch : sent) {
+      dropped.push_back(std::move(batch.done));
+    }
+    sent.clear();
+  }
+  void SendBatch(const std::string& source,
+                 const std::string& target,
+                 const std::vector<std::string>& items,
+                 PageTranslation::BatchCallback done) override {
+    ASSERT_TRUE(connected);
+    sent.push_back({items, std::move(done)});
+  }
+  bool UnitReady(ModelUnit unit) const override { return ready.contains(unit); }
+  void HoldUnit(ModelUnit unit, bool hold) override {
+    holds[unit] += hold ? 1 : -1;
+    if (!holds[unit]) {
+      holds.erase(unit);
+    }
+  }
+  void DownloadUnit(ModelUnit unit) override { downloads.push_back(unit); }
+  int64_t UnitBytes(ModelUnit unit) const override {
+    return unit == ModelUnit::kToEnglish ? 221'000'000 : 225'000'000;
+  }
+
+  // The speech process answers the oldest call.
+  void Answer(BatchStatus status, Results results) {
+    PageTranslation::BatchCallback done = std::move(sent.front().done);
+    sent.erase(sent.begin());
+    std::move(done).Run(status, std::move(results));
+  }
+  // Translates the oldest call as the service would: the items it takes get
+  // "<text>!", the tail comes back null.
+  void AnswerTranslated() {
+    const std::vector<std::string>& items = sent.front().items;
+    const size_t end = speech::TarkPageBatchEnd(items);
+    Results results(items.size());
+    for (size_t i = 0; i < end; ++i) {
+      if (!speech::TarkPageItemTooLong(items[i])) {
+        results[i] = items[i] + "!";
+      }
+    }
+    Answer(BatchStatus::kOk, std::move(results));
+  }
+
+  int connects = 0;
+  int disconnects = 0;
+  int releases = 0;
+  int drops = 0;
+  bool connected = false;
+  std::vector<PageTranslation::BatchCallback> dropped;
+  std::set<ModelUnit> ready = {ModelUnit::kToEnglish, ModelUnit::kFromEnglish};
+  std::map<ModelUnit, int> holds;
+  std::vector<ModelUnit> downloads;
+  std::vector<Sent> sent;
+};
