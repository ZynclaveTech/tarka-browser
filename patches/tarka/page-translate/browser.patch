+// One call takes at most the service's bound; the null tail is sent again,
+// and only the tail.
+TEST_F(TarkPageTranslationTest, ResendsOnlyTheTail) {
+  PageTranslation page(&backend_, false);
+  std::vector<std::string> texts;
+  for (size_t i = 0; i < speech::kTarkPageMaxBatchItems + 4; ++i) {
+    texts.push_back("t" + std::to_string(i));
+  }
+  Translate(page, texts);
+  ASSERT_EQ(backend_.sent.size(), 1u);
+  EXPECT_EQ(backend_.sent.front().items.size(), texts.size());
+  backend_.AnswerTranslated();
+  ASSERT_EQ(backend_.sent.size(), 1u);
+  EXPECT_EQ(backend_.sent.front().items,
+            std::vector<std::string>(texts.begin() + speech::kTarkPageMaxBatchItems, texts.end()));
+  EXPECT_EQ(answers_, 0);
+  backend_.AnswerTranslated();
+  EXPECT_TRUE(backend_.sent.empty());
+  ASSERT_EQ(answers_, 1);
+  ASSERT_EQ(out_.size(), texts.size());
+  for (size_t i = 0; i < texts.size(); ++i) {
+    EXPECT_EQ(out_[i], texts[i] + "!");
+  }
+}
