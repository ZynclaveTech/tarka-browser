+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/tark_page_translation.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/speech/speech_recognition_service.h"
+#include "chrome/browser/speech/speech_recognition_service_factory.h"
+#include "chrome/browser/tark_captions/caption_models.h"
+#include "chrome/browser/tark_captions/page_translation_prefs.h"
+#include "chrome/browser/translate/chrome_translate_client.h"
+#include "components/prefs/pref_service.h"
+#include "components/tark_captions/model_manifest.h"
+#include "components/translate/core/browser/language_state.h"
+#include "components/translate/core/browser/translate_manager.h"
+#include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+
+namespace tark_captions {
+namespace {
+
+PageTranslation::BatchStatus FromMojom(media::mojom::PageBatchStatus status) {
+  switch (status) {
+    case media::mojom::PageBatchStatus::kOk:
+      return PageTranslation::BatchStatus::kOk;
+    case media::mojom::PageBatchStatus::kModelMissing:
+      return PageTranslation::BatchStatus::kModelMissing;
+    case media::mojom::PageBatchStatus::kBusyOtherModel:
+      return PageTranslation::BatchStatus::kBusyOtherModel;
+  }
+  return PageTranslation::BatchStatus::kModelMissing;
+}
+
+}  // namespace
+
+TarkPageTranslation::TarkPageTranslation(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<TarkPageTranslation>(*web_contents),
+      prefs_(user_prefs::UserPrefs::Get(web_contents->GetBrowserContext())),
+      off_the_record_(web_contents->GetBrowserContext()->IsOffTheRecord()),
+      logic_(this, off_the_record_) {}
+
+TarkPageTranslation::~TarkPageTranslation() {
+  // Nothing calls back in while the members go: logic_'s destructor lets the
+  // units go, which notifies the store's observers.
+  StopWaiting();
+}
+
+bool TarkPageTranslation::Enabled() const {
+  return prefs_ && prefs_->GetBoolean(kPageTranslationEnabledPref);
+}
+
+bool TarkPageTranslation::CanOffer(const std::string& source, const std::string& target) const {
+  if (!Enabled() || PageUnitsFor(source, target).empty()) {
+    return false;
+  }
+  // A Private window never downloads: only what is on the Mac already.
+  return !off_the_record_ || logic_.ModelsReady(source, target);
+}
+
+bool TarkPageTranslation::Start(const std::string& target) {
+  translate::TranslateManager* manager =
+      ChromeTranslateClient::GetManagerFromWebContents(&GetWebContents());
+  if (!manager) {
+    return false;
+  }
+  Direction direction{manager->GetLanguageState()->source_language(), target};
+  if (!CanOffer(direction.source, direction.target)) {
+    return false;
+  }
+  StopWaiting();
+  if (logic_.ModelsReady(direction.source, direction.target)) {
+    TranslateNow(direction);
+    return true;
+  }
+  // Only the user's Translate downloads (never off the record: CanOffer).
+  const int64_t bytes = logic_.MissingBytes(direction.source, direction.target);
+  if (!logic_.RequestModels(direction.source, direction.target)) {
+    return false;
+  }
+  waiting_ = direction;
+  models_observation_.Observe(&TarkCaptionModels());
+  observers_.Notify(&Observer::OnDownloadNeeded, this, direction, bytes);
+  return true;
+}
+
+void TarkPageTranslation::Revert() {
+  StopWaiting();
+  logic_.Cancel();
+  translate::TranslateManager* manager =
+      ChromeTranslateClient::GetManagerFromWebContents(&GetWebContents());
+  if (manager) {
+    manager->RevertTranslation();
+  }
+}
+
+void TarkPageTranslation::Translate(std::vector<std::string> texts,
+                                    std::string source,
+                                    std::string target,
+                                    PageTranslation::ResultsCallback callback) {
+  if (!Enabled()) {
+    std::move(callback).Run(PageTranslation::Results(texts.size()));
+    return;
+  }
+  logic_.Translate(std::move(texts), std::move(source), std::move(target), std::move(callback));
+}
+
+void TarkPageTranslation::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void TarkPageTranslation::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void TarkPageTranslation::PrimaryPageChanged(content::Page& page) {
+  // A new main document: the old page's batches answer null and are dropped,
+  // and a download Start waited for no longer translates this page.
+  StopWaiting();
+  logic_.Cancel();
+}
+
+void TarkPageTranslation::OnVisibilityChanged(content::Visibility visibility) {
+  if (visibility == content::Visibility::HIDDEN) {
+    logic_.OnTabHidden();
+  }
+}
+
+void TarkPageTranslation::OnModelStatusChanged(ModelUnit unit) {
+  if (!waiting_) {
+    return;
+  }
+  const std::vector<ModelUnit> units = PageUnitsFor(waiting_->source, waiting_->target);
+  if (!std::ranges::contains(units, unit)) {
+    return;
+  }
+  const Direction direction = *waiting_;
+  if (TarkCaptionModels().status(unit).state == CaptionModelStore::State::kFailed) {
+    StopWaiting();
+    observers_.Notify(&Observer::OnDownloadFailed, this, direction);
+    return;
+  }
+  if (!logic_.ModelsReady(direction.source, direction.target)) {
+    return;
+  }
+  StopWaiting();
+  observers_.Notify(&Observer::OnDownloadDone, this, direction);
+  TranslateNow(direction);
+}
+
+void TarkPageTranslation::TranslateNow(const Direction& direction) {
+  translate::TranslateManager* manager =
+      ChromeTranslateClient::GetManagerFromWebContents(&GetWebContents());
+  if (manager) {
+    manager->TranslatePage(direction.source, direction.target, /*triggered_from_menu=*/true);
+  }
+}
+
+void TarkPageTranslation::StopWaiting() {
+  waiting_.reset();
+  models_observation_.Reset();
+}
+
+void TarkPageTranslation::Connect() {
+  BindTranslator();
+}
+
+void TarkPageTranslation::BindTranslator() {
+  // The profile's speech process: captions' when they run (the same model
+  // slot), else started now without speech. An off-the-record profile has
+  // its own service; the models are the same files.
+  if (!web_contents()) {
+    return;  // the tab is closing
+  }
+  Profile* profile = Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  speech::SpeechRecognitionService* service =
+      profile ? SpeechRecognitionServiceFactory::GetForProfile(profile) : nullptr;
+  if (!service) {
+    return;  // batches answer kModelMissing (SendBatch)
+  }
+  service->BindTarkCaptionTranslator(translator_.BindNewPipeAndPassReceiver());
+  translator_.set_disconnect_handler(
+      base::BindOnce(&TarkPageTranslation::OnGone, weak_factory_.GetWeakPtr()));
+}
+
+void TarkPageTranslation::Disconnect() {
+  translator_.reset();
+}
+
+void TarkPageTranslation::ReleaseModel() {
+  // Sent before Disconnect closes the pipe, so it arrives. After DropSent
+  // there may be no pipe: a new one carries it (the slot is the process's,
+  // not the pipe's). Not from the destructor, where web_contents() is null.
+  if (!translator_.is_bound() && web_contents()) {
+    BindTranslator();
+  }
+  if (translator_.is_bound()) {
+    translator_->ReleasePageModel();
+  }
+}
+
+void TarkPageTranslation::DropSent() {
+  // Replies on the old pipe never come; the next batch binds a new one (the
+  // model stays loaded in the process until its idle unload).
+  translator_.reset();
+}
+
+void TarkPageTranslation::SendBatch(const std::string& source,
+                                    const std::string& target,
+                                    const std::vector<std::string>& items,
+                                    PageTranslation::BatchCallback done) {
+  if (!translator_.is_bound()) {
+    BindTranslator();  // after DropSent
+  }
+  if (!translator_.is_bound()) {
+    std::move(done).Run(PageTranslation::BatchStatus::kModelMissing,
+                        PageTranslation::Results(items.size()));
+    return;
+  }
+  // A batch lost with the process never answers; OnGone answers it null.
+  translator_->TranslatePageBatch(
+      source, target, items,
+      base::BindOnce(
+          [](PageTranslation::BatchCallback done, media::mojom::PageBatchStatus status,
+             const std::vector<std::optional<std::string>>& results) {
+            std::move(done).Run(FromMojom(status), results);
+          },
+          std::move(done)));
+}
+
+bool TarkPageTranslation::UnitReady(ModelUnit unit) const {
+  return TarkCaptionModels().ready(unit);
+}
+
+void TarkPageTranslation::HoldUnit(ModelUnit unit, bool hold) {
+  TarkCaptionModels().HoldForPage(unit, hold);
+}
+
+void TarkPageTranslation::DownloadUnit(ModelUnit unit) {
+  TarkCaptionModels().Download(unit);
+}
+
+int64_t TarkPageTranslation::UnitBytes(ModelUnit unit) const {
+  return UnitSize(unit);
+}
+
+void TarkPageTranslation::OnGone() {
+  translator_.reset();
+  logic_.OnBackendGone();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TarkPageTranslation);
+
+}  // namespace tark_captions
