+TEST(TarkPageBatchEndTest, MatchesTheServiceBound) {
+  using speech::TarkPageBatchEnd;
+  EXPECT_EQ(TarkPageBatchEnd({}), 0u);
+  EXPECT_EQ(TarkPageBatchEnd(std::vector<std::string>(20, "a")), speech::kTarkPageMaxBatchItems);
+  // The first text always fits, however long (up to the item bound).
+  const std::string big(speech::kTarkPageMaxBatchChars + 10, 'a');
+  EXPECT_EQ(TarkPageBatchEnd({big, "b"}), 1u);
+  // Too-long texts are skipped, not counted.
+  const std::string too_long(speech::kTarkPageMaxItemChars + 1, 'a');
+  EXPECT_EQ(TarkPageBatchEnd({too_long, too_long}), 2u);
+  // Characters are code points: 1,000 Devanagari letters are 1,000.
+  std::string hindi;
+  for (int i = 0; i < 1000; ++i) {
+    hindi += "क";
+  }
+  EXPECT_EQ(TarkPageBatchEnd({hindi, hindi, "a"}), 2u);
+}
