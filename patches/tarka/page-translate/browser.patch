+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/tark_captions/page_translation.h"
+#include "components/tark_captions/caption_model_store.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "media/mojo/mojom/tark_caption_translator.mojom.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+class PrefService;
+
+namespace tark_captions {
+
+// Tark for Mac's page translation in one tab, tied to its main document
+// (ported from Android's). The page's text comes in batches from Tark's
+// translate script (TarkPageTranslateHost) and goes to the profile's speech
+// process, the one captions use (TarkCaptionTranslator.TranslatePageBatch):
+// started on demand without speech when captions aren't running; one model
+// slot in that process, so a page and captions never load two models
+// (captions win). The translator is let go after three idle minutes or when
+// the tab is hidden (the page's model with it); a new main document cancels
+// what is outstanding. Models are captions' downloads, fetched only on the
+// user's Translate (Start), never in a Private window. The decisions are
+// PageTranslation's.
+class TarkPageTranslation : public content::WebContentsObserver,
+                            public content::WebContentsUserData<TarkPageTranslation>,
+                            public CaptionModelStore::Observer,
+                            public PageTranslation::Backend {
+ public:
+  // A page direction, as translate's codes ("hi", "en").
+  struct Direction {
+    std::string source;
+    std::string target;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // Start needs `bytes` downloaded first (captions' download card); the
+    // download has started.
+    virtual void OnDownloadNeeded(TarkPageTranslation* page,
+                                  const Direction& direction,
+                                  int64_t bytes) {}
+    // The models Start waited for are here; the page is being translated.
+    virtual void OnDownloadDone(TarkPageTranslation* page, const Direction& direction) {}
+    // A model Start waited for failed to download; nothing was translated.
+    virtual void OnDownloadFailed(TarkPageTranslation* page, const Direction& direction) {}
+  };
+
+  ~TarkPageTranslation() override;
+
+  // Tark's page translation is on (tark.page_translation.enabled) for the
+  // tab's profile.
+  bool Enabled() const;
+  // Whether Translate may be offered for the pair: on, a direction the Mac
+  // has models for, and in a Private window only when they are downloaded
+  // already (it never downloads).
+  bool CanOffer(const std::string& source, const std::string& target) const;
+  // The user's Translate into `target`, from the page's language (translate's
+  // LanguageState). Translates now when the models are here; otherwise
+  // downloads them (OnDownloadNeeded) and translates once they are. False
+  // when nothing happens (CanOffer is false).
+  bool Start(const std::string& target);
+  // Show original: no reload; a download Start waited for no longer
+  // translates when it ends.
+  void Revert();
+
+  // TarkPageTranslateHost: one batch from the page's script. Null results
+  // keep the original; an empty Results is deferred (the script sends them
+  // again).
+  void Translate(std::vector<std::string> texts,
+                 std::string source,
+                 std::string target,
+                 PageTranslation::ResultsCallback callback);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  explicit TarkPageTranslation(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<TarkPageTranslation>;
+
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+
+  // CaptionModelStore::Observer:
+  void OnModelStatusChanged(ModelUnit unit) override;
+
+  // PageTranslation::Backend:
+  void Connect() override;
+  void Disconnect() override;
+  void ReleaseModel() override;
+  void DropSent() override;
+  void SendBatch(const std::string& source,
+                 const std::string& target,
+                 const std::vector<std::string>& items,
+                 PageTranslation::BatchCallback done) override;
+  bool UnitReady(ModelUnit unit) const override;
+  void HoldUnit(ModelUnit unit, bool hold) override;
+  void DownloadUnit(ModelUnit unit) override;
+  int64_t UnitBytes(ModelUnit unit) const override;
+
+  // A translator on the profile's speech process; unbound when there is
+  // none (SendBatch then answers kModelMissing).
+  void BindTranslator();
+  void OnGone();
+  // Asks translate to translate the page (Tark's script, through
+  // TranslateManager).
+  void TranslateNow(const Direction& direction);
+  // Start's download is no longer waited for.
+  void StopWaiting();
+
+  // The profile's; it outlives the tab.
+  const raw_ptr<PrefService> prefs_;
+  const bool off_the_record_;
+  mojo::Remote<media::mojom::TarkCaptionTranslator> translator_;
+  // Start's direction while its models download.
+  std::optional<Direction> waiting_;
+  base::ObserverList<Observer> observers_;
+  // After the remote: its destructor lets it go.
+  PageTranslation logic_;
+  // After logic_, so it is gone before logic_'s destructor lets the units go
+  // (HoldForPage notifies the store's observers); ~TarkPageTranslation also
+  // resets it first.
+  base::ScopedObservation<CaptionModelStore, CaptionModelStore::Observer> models_observation_{
+      this};
+  base::WeakPtrFactory<TarkPageTranslation> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_TARK_PAGE_TRANSLATION_H_
