+// Captions hold another model: the batch waits and is sent again twice, then
+// fails with its originals (never a third resend).
+TEST_F(TarkPageTranslationTest, DefersAtMostTwiceThenFails) {
+  PageTranslation page(&backend_, false);
+  Translate(page, {"एक", "दो"});
+  backend_.Answer(BatchStatus::kBusyOtherModel, Results(2));
+  EXPECT_TRUE(backend_.sent.empty());
+  EXPECT_EQ(answers_, 0);
+  task_environment_.FastForwardBy(PageTranslation::kBusyRetry);
+  ASSERT_EQ(backend_.sent.size(), 1u);  // re-queued once
+  backend_.Answer(BatchStatus::kBusyOtherModel, Results(2));
+  task_environment_.FastForwardBy(PageTranslation::kBusyRetry);
+  ASSERT_EQ(backend_.sent.size(), 1u);  // twice
+  backend_.Answer(BatchStatus::kBusyOtherModel, Results(2));
+  EXPECT_EQ(answers_, 1);
+  EXPECT_EQ(out_, Results(2));  // failed: originals kept
+  task_environment_.FastForwardBy(PageTranslation::kBusyRetry);
+  EXPECT_TRUE(backend_.sent.empty());  // no third
+}
