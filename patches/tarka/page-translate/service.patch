+#ifndef CHROME_SERVICES_SPEECH_TARK_PAGE_TRANSLATOR_H_
+#define CHROME_SERVICES_SPEECH_TARK_PAGE_TRANSLATOR_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/tark_captions/translation_engine.h"
+
+namespace speech {
+
+using TarkDirections = std::set<tark_captions::TranslationDirection>;
+
+// The translation model in the speech process's one slot: a
+// tark_captions::TranslationEngine, or a fake in tests.
+class TarkTranslationModel {
+ public:
+  virtual ~TarkTranslationModel() = default;
+  // A page's sentence (TranslationEngine::TranslatePage).
+  virtual std::optional<std::string> TranslatePage(std::string_view text,
+                                                   std::string_view source,
+                                                   std::string_view target) = 0;
+  // The engine, for captions' Render; null in tests.
+  virtual tark_captions::TranslationEngine* engine() = 0;
+};
+
+// One model hop of a page batch: `direction` translating `source` into
+// `target` (ISO codes).
+struct TarkPageLeg {
+  tark_captions::TranslationDirection direction;
+  std::string source;
+  std::string target;
+};
+
+// The hops from `source` into `target`, in order (PageDirectionsFor): Indian
+// and Spanish sources go through English, so Indian ↔ Indian is two legs, one
+// model each. Empty when there is no model for the pair (or they are equal).
+std::vector<TarkPageLeg> TarkPageLegsFor(std::string_view source, std::string_view target);
+
+// A page item longer than this (characters) stays original, not decoded.
+inline constexpr size_t kTarkPageMaxItemChars = 4000;
+// The page's model unloads after this long without a batch.
+inline constexpr base::TimeDelta kTarkPageIdleUnload = base::Minutes(3);
+
+// The speech process's one translation model slot, shared by captions'
+// Render (any number of TarkCaptionTranslators, the "holders") and page
+// batches (Tark's page translation, ported from Android's PageTranslator).
+// Never two IndicTrans2 models for a page:
+// - captions hold every model the batch needs: the batch uses captions'
+//   engine (no second load);
+// - captions hold another model: kBusyOtherModel, and nothing loads
+//   (captions win; the browser asks again later);
+// - captions hold none: the batch loads one model at a time, leg by leg,
+//   unloading the previous one first.
+// A page's model unloads after kTarkPageIdleUnload without a batch, on
+// ReleasePageModel(), or as soon as captions need the slot. Captions' own
+// models stay while captions hold them. Each sentence of an item is
+// translated whole; an item with a failed or empty sentence, or longer than
+// kTarkPageMaxItemChars, comes back null (the page keeps the original).
+// Use on one sequence; it blocks while a model loads or decodes.
+class TarkPageTranslator {
+ public:
+  using ModelFactory = base::RepeatingCallback<std::unique_ptr<TarkTranslationModel>()>;
+  // Whether `direction`'s model is downloaded.
+  using ModelPresent = base::RepeatingCallback<bool(tark_captions::TranslationDirection)>;
+
+  enum class Status { kOk, kModelMissing, kBusyOtherModel };
+  struct PageBatch {
+    PageBatch();
+    PageBatch(PageBatch&&);
+    PageBatch& operator=(PageBatch&&);
+    ~PageBatch();
+
+    Status status = Status::kOk;
+    // Aligned with the items; null keeps the original.
+    std::vector<std::optional<std::string>> results;
+  };
+
+  // `make` returns null when ONNX Runtime is missing.
+  TarkPageTranslator(ModelFactory make, ModelPresent present);
+  TarkPageTranslator(const TarkPageTranslator&) = delete;
+  TarkPageTranslator& operator=(const TarkPageTranslator&) = delete;
+  ~TarkPageTranslator();
+
+  // The engine on `models_dir` (it2_indic_en/, it2_en_indic/, opus_es_en/).
+  static ModelFactory EngineFactory(const base::FilePath& ort_dylib,
+                                    const base::FilePath& models_dir);
+  static ModelPresent EnginePresent(const base::FilePath& models_dir);
+
+  // Captions' `holder` needs `directions` now (empty: none; it no longer
+  // holds the slot). Any model only a page used goes first (captions win).
+  // The model to translate with; null when none is needed or it can't be
+  // made.
+  TarkTranslationModel* ForCaptions(uint64_t holder, const TarkDirections& directions);
+  // `holder` is gone.
+  void DropHolder(uint64_t holder);
+
+  PageBatch TranslatePageBatch(const std::string& source,
+                               const std::string& target,
+                               const std::vector<std::string>& items);
+  // The page lets its model go (tab hidden): unloaded unless captions hold
+  // it.
+  void ReleasePageModel();
+
+  // The directions the slot's model has been used for, while it is loaded.
+  const TarkDirections& LoadedForTesting() const { return loaded_; }
+  bool HasModelForTesting() const { return !!model_; }
+
+ private:
+  TarkDirections CaptionsHold() const;
+  // The model, holding `directions` (loaded on first use) and, when
+  // `keep_captions`, what captions hold; anything else is unloaded first.
+  TarkTranslationModel* Hold(const TarkDirections& directions, bool keep_captions);
+  void Unload();
+  // Unloads the model unless captions hold everything it has loaded.
+  void UnloadPageModel();
+  void ArmIdleTimer();
+
+  const ModelFactory make_;
+  const ModelPresent present_;
+  std::unique_ptr<TarkTranslationModel> model_;
+  TarkDirections loaded_;
+  std::map<uint64_t, TarkDirections> captions_;
+  base::OneShotTimer idle_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace speech
+
