+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/speech/tark_page_translator.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+
+namespace speech {
+
+namespace {
+
+using tark_captions::TranslationDirection;
+
+// TranslationEngine's folders under the models folder
+// (TranslationEngine::Create).
+const char* FolderOf(TranslationDirection direction) {
+  switch (direction) {
+    case TranslationDirection::kIndicToEnglish:
+      return "it2_indic_en";
+    case TranslationDirection::kEnglishToIndic:
+      return "it2_en_indic";
+    case TranslationDirection::kSpanishToEnglish:
+      return "opus_es_en";
+  }
+  return "";
+}
+
+class EngineModel : public TarkTranslationModel {
+ public:
+  explicit EngineModel(std::unique_ptr<tark_captions::TranslationEngine> engine)
+      : engine_(std::move(engine)) {}
+
+  std::optional<std::string> TranslatePage(std::string_view text,
+                                           std::string_view source,
+                                           std::string_view target) override {
+    return engine_->TranslatePage(text, source, target);
+  }
+  tark_captions::TranslationEngine* engine() override { return engine_.get(); }
+
+ private:
+  std::unique_ptr<tark_captions::TranslationEngine> engine_;
+};
+
+std::unique_ptr<TarkTranslationModel> MakeEngineModel(const base::FilePath& ort_dylib,
+                                                      const base::FilePath& models_dir) {
+  std::unique_ptr<tark_captions::TranslationEngine> engine =
+      tark_captions::TranslationEngine::Create(models_dir, ort_dylib);
+  if (!engine) {
+    return nullptr;
+  }
+  return std::make_unique<EngineModel>(std::move(engine));
+}
+
+bool EngineModelPresent(const base::FilePath& models_dir, TranslationDirection direction) {
+  return !models_dir.empty() && base::DirectoryExists(models_dir.AppendASCII(FolderOf(direction)));
+}
+
+// The leg's translation: null when the model fails or gives nothing.
+std::optional<std::string> Checked(std::optional<std::string> text) {
+  if (!text || text->empty()) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+// Code points, not bytes.
+size_t Chars(std::string_view text) {
+  return static_cast<size_t>(std::ranges::count_if(
+      text, [](char c) { return (static_cast<unsigned char>(c) & 0xC0) != 0x80; }));
+}
+
+// A page text's sentences (Android's PageTranslator): each ends after ".",
+// "?" or "!" followed by white space or the end, after a danda or double
+// danda (। ॥), an Urdu full stop or question mark (۔ ؟), an Ol Chiki full
+// stop (᱾), or at a line break. "3.5" and "e.g.x" stay whole. A sentence
+// running past kLongSentence characters with none of those ends at its next
+// space or comma, so a run-on line isn't cut off by the models' 255-token
+// input. `line_break`: a "\n" ended it.
+struct Sentence {
+  std::string_view text;
+  bool line_break = false;
+};
+
+constexpr size_t kLongSentence = 200;
+
+std::vector<Sentence> Sentences(std::string_view text) {
+  std::vector<Sentence> sentences;
+  size_t start = 0;
+  size_t chars = 0;  // code points since `start`
+  for (size_t i = 0; i < text.size(); ++i) {
+    size_t end = 0;  // one past the sentence's end
+    bool line_break = false;
+    const char c = text[i];
+    const std::string_view rest = text.substr(i);
+    if ((static_cast<unsigned char>(c) & 0xC0) != 0x80) {
+      ++chars;
+    }
+    if (c == '\n') {
+      end = i + 1;
+      line_break = true;
+    } else if (c == '.' || c == '?' || c == '!') {
+      if (i + 1 == text.size() || text[i + 1] == ' ' || text[i + 1] == '\n' ||
+          text[i + 1] == '\t') {
+        end = i + 1;
+      }
+    } else if (rest.starts_with("\xE0\xA5\xA4") || rest.starts_with("\xE0\xA5\xA5") ||
+               rest.starts_with("\xE1\xB1\xBE")) {
+      end = i + 3;  // । ॥ ᱾
+    } else if (rest.starts_with("\xDB\x94") || rest.starts_with("\xD8\x9F")) {
+      end = i + 2;  // ۔ ؟
+    } else if (chars > kLongSentence && (c == ' ' || c == ',' || rest.starts_with("\xD8\x8C"))) {
+      end = c == ' ' || c == ',' ? i + 1 : i + 2;  // a space, a comma or ،
+    }
+    if (end) {
+      sentences.push_back({text.substr(start, end - start), line_break});
+      start = end;
+      chars = 0;
+      i = end - 1;
+    }
+  }
+  if (start < text.size()) {
+    sentences.push_back({text.substr(start), false});
+  }
+  return sentences;
+}
+
+// A page text goes to the model a sentence at a time, as captions do: the
+// models read at most 255 source tokens and write at most 128, and each
+// decoder step costs more the longer the output. Any sentence that fails
+// keeps the whole text original.
+std::optional<std::string> TranslateText(TarkTranslationModel* model,
+                                         std::string_view text,
+                                         std::string_view source,
+                                         std::string_view target) {
+  std::string joined;
+  bool after_line_break = false;
+  for (const Sentence& sentence : Sentences(text)) {
+    const std::string_view trimmed = base::TrimWhitespaceASCII(sentence.text, base::TRIM_ALL);
+    if (trimmed.empty()) {
+      after_line_break |= sentence.line_break;
+      continue;
+    }
+    std::optional<std::string> done = Checked(model->TranslatePage(trimmed, source, target));
+    if (!done) {
+      return std::nullopt;
+    }
+    if (!joined.empty()) {
+      joined += after_line_break ? '\n' : ' ';  // the page's line breaks stay
+    }
+    joined += *done;
+    after_line_break = sentence.line_break;
+  }
+  return Checked(std::move(joined));
+}
+
+// The item as it goes to the first leg; null when it is too long.
+std::optional<std::string> Admitted(const std::string& item) {
+  if (Chars(item) > kTarkPageMaxItemChars) {
+    return std::nullopt;
+  }
+  return item;
+}
+
+}  // namespace
+
+std::vector<TarkPageLeg> TarkPageLegsFor(std::string_view source, std::string_view target) {
+  const std::vector<TranslationDirection> directions =
+      tark_captions::PageDirectionsFor(source, target);
+  std::vector<TarkPageLeg> legs;
+  if (directions.size() == 1) {
+    legs.push_back({directions[0], std::string(source), std::string(target)});
+  } else if (directions.size() == 2) {
+    legs.push_back({directions[0], std::string(source), "en"});
+    legs.push_back({directions[1], "en", std::string(target)});
+  }
+  return legs;
+}
