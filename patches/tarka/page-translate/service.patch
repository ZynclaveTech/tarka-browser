+using tark_captions::TranslationDirection;
+using Results = std::vector<std::optional<std::string>>;
+using Status = TarkPageTranslator::Status;
+
+// What every fake model saw. A model counts from its making until it is
+// deleted (TranslationEngine loads each direction on first use).
+struct Models {
+  int alive = 0;
+  int most_alive = 0;
+  int made = 0;
+  std::vector<std::string> events;  // "make", "use:<source>-><target>", "unload"
+  std::vector<std::string> received;
+  std::string fail;   // this text comes back nullopt
+  std::string blank;  // this text comes back ""
+  bool factory_fails = false;
+  std::set<TranslationDirection> missing;  // not downloaded
+};
+
+class FakeModel : public TarkTranslationModel {
+ public:
+  explicit FakeModel(Models* models) : models_(models) {
+    ++models_->made;
+    ++models_->alive;
+    models_->most_alive = std::max(models_->most_alive, models_->alive);
+    EXPECT_LE(models_->alive, 1) << "two models at once";
+    models_->events.push_back("make");
+  }
+  ~FakeModel() override {
+    --models_->alive;
+    models_->events.push_back("unload");
+  }
+
+  std::optional<std::string> TranslatePage(std::string_view text,
+                                           std::string_view source,
+                                           std::string_view target) override {
+    const std::string use = "use:" + std::string(source) + "->" + std::string(target);
+    if (!std::ranges::contains(uses_, use)) {
+      uses_.push_back(use);
+      models_->events.push_back(use);
+    }
+    models_->received.emplace_back(text);
+    if (text == models_->fail) {
+      return std::nullopt;
+    }
+    if (text == models_->blank) {
+      return "";
+    }
+    return std::string(target) + ":" + std::string(text);
+  }
+  tark_captions::TranslationEngine* engine() override { return nullptr; }
+
+ private:
+  raw_ptr<Models> models_;
+  std::vector<std::string> uses_;
+};
