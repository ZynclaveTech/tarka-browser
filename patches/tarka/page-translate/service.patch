+    ASSERT_TRUE(base::CreateDirectory(models_.GetPath().AppendASCII("it2_indic_en")));
+    ASSERT_TRUE(base::CreateDirectory(models_.GetPath().AppendASCII("it2_en_indic")));
+  }
+  void Bind(mojo::Remote<media::mojom::TarkCaptionTranslator>& remote) {
+    TarkCaptionTranslator::Create(
+        remote.BindNewPipeAndPassReceiver(),
+        base::FilePath(FILE_PATH_LITERAL("/nonexistent/libonnxruntime.dylib")),
+        models_.GetPath());
+  }
+  std::pair<media::mojom::PageBatchStatus, Results> Batch(
+      mojo::Remote<media::mojom::TarkCaptionTranslator>& remote,
+      const std::string& source,
+      const std::string& target,
+      const std::vector<std::string>& items) {
+    base::test::TestFuture<media::mojom::PageBatchStatus, const Results&> done;
+    remote->TranslatePageBatch(source, target, items, done.GetCallback());
+    return {done.Get<0>(), done.Get<1>()};
+  }
+
+  base::test::TaskEnvironment env_;
+  base::ScopedTempDir models_;
+};
