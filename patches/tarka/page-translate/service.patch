+TarkPageTranslator::PageBatch::PageBatch() = default;
+TarkPageTranslator::PageBatch::PageBatch(PageBatch&&) = default;
+TarkPageTranslator::PageBatch& TarkPageTranslator::PageBatch::operator=(PageBatch&&) = default;
+TarkPageTranslator::PageBatch::~PageBatch() = default;
+
+TarkPageTranslator::TarkPageTranslator(ModelFactory make, ModelPresent present)
+    : make_(std::move(make)), present_(std::move(present)) {}
+
+TarkPageTranslator::~TarkPageTranslator() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
