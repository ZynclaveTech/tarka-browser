+TEST_F(TarkPageTranslatorMojoTest, TranslatorsShareTheSlot) {
+  mojo::Remote<media::mojom::TarkCaptionTranslator> captions, page;
+  Bind(captions);
+  Bind(page);
+  base::test::TestFuture<bool, const std::string&, const std::string&> rendered;
+  captions->Render("नमस्ते", "hi", "", "en", rendered.GetCallback());
+  EXPECT_FALSE(rendered.Get<0>());  // no runtime, but captions hold the slot
+
+  auto busy = Batch(page, "en", "hi", {"hello", "world"});
+  EXPECT_EQ(busy.first, media::mojom::PageBatchStatus::kBusyOtherModel);
+  EXPECT_EQ(busy.second, (Results{std::nullopt, std::nullopt}));
+
+  captions.reset();
+  env_.RunUntilIdle();
+  auto missing = Batch(page, "en", "hi", {"hello"});
+  EXPECT_EQ(missing.first, media::mojom::PageBatchStatus::kModelMissing);
+  EXPECT_EQ(missing.second, (Results{std::nullopt}));
+}
+
+TEST_F(TarkPageTranslatorMojoTest, MissingFolderAndUnsupportedPair) {
+  mojo::Remote<media::mojom::TarkCaptionTranslator> page;
+  Bind(page);
+  EXPECT_EQ(Batch(page, "es", "en", {"hola"}).first,
+            media::mojom::PageBatchStatus::kModelMissing);  // no opus_es_en/
+  auto unsupported = Batch(page, "fr", "en", {"bonjour"});
+  EXPECT_EQ(unsupported.first, media::mojom::PageBatchStatus::kOk);
+  EXPECT_EQ(unsupported.second, (Results{std::nullopt}));
+  page->ReleasePageModel();
+  env_.RunUntilIdle();
+}
