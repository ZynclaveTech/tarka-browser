+// static
+TarkPageTranslator::ModelFactory TarkPageTranslator::EngineFactory(
+    const base::FilePath& ort_dylib,
+    const base::FilePath& models_dir) {
+  return base::BindRepeating(&MakeEngineModel, ort_dylib, models_dir);
+}
+
+// static
+TarkPageTranslator::ModelPresent TarkPageTranslator::EnginePresent(
+    const base::FilePath& models_dir) {
+  return base::BindRepeating(&EngineModelPresent, models_dir);
+}
+
+TarkTranslationModel* TarkPageTranslator::ForCaptions(uint64_t holder,
+                                                      const TarkDirections& directions) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ArmIdleTimer();
+  if (directions.empty()) {
+    captions_.erase(holder);
+    return nullptr;
+  }
+  captions_[holder] = directions;
+  return Hold(directions, /*keep_captions=*/true);
+}
+
+void TarkPageTranslator::DropHolder(uint64_t holder) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  captions_.erase(holder);
+  ArmIdleTimer();
+}
+
+TarkPageTranslator::PageBatch TarkPageTranslator::TranslatePageBatch(
+    const std::string& source,
+    const std::string& target,
+    const std::vector<std::string>& items) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ArmIdleTimer();
+  const base::TimeTicks start = base::TimeTicks::Now();
+  PageBatch batch;
+  batch.results.resize(items.size());
+  const std::vector<TarkPageLeg> legs = TarkPageLegsFor(source, target);
+  if (legs.empty()) {
+    return batch;  // no model for the pair: originals stay
+  }
+  TarkDirections needed;
+  for (const TarkPageLeg& leg : legs) {
+    if (!present_.Run(leg.direction)) {
+      batch.status = Status::kModelMissing;
+      return batch;
+    }
+    needed.insert(leg.direction);
+  }
+
+  const TarkDirections held = CaptionsHold();
+  if (!held.empty()) {
+    if (!std::ranges::includes(held, needed)) {
+      // Captions hold another model: they win, nothing loads.
+      batch.status = Status::kBusyOtherModel;
+      return batch;
+    }
+    // Captions' engine holds every model the batch needs.
+    TarkTranslationModel* model = Hold(needed, /*keep_captions=*/true);
+    if (!model) {
+      batch.status = Status::kModelMissing;
+      return batch;
+    }
+    for (size_t i = 0; i < items.size(); ++i) {
+      if (const std::optional<std::string> item = Admitted(items[i])) {
+        batch.results[i] = TranslateText(model, *item, source, target);
+      }
+    }
+    DVLOG(1) << "tark-page: shared batch items=" << items.size()
+             << " ms=" << (base::TimeTicks::Now() - start).InMilliseconds();
+    return batch;
+  }
+
+  // The page's own model, one leg (one model) at a time.
+  std::vector<std::optional<std::string>> texts;
+  texts.reserve(items.size());
+  for (const std::string& item : items) {
+    texts.push_back(Admitted(item));
+  }
+  for (const TarkPageLeg& leg : legs) {
+    TarkTranslationModel* model = Hold({leg.direction}, /*keep_captions=*/false);
+    if (!model) {
+      batch.status = Status::kModelMissing;
+      return batch;
+    }
+    for (std::optional<std::string>& text : texts) {
+      if (text) {
+        text = TranslateText(model, *text, leg.source, leg.target);
+      }
+    }
+  }
+  batch.results = std::move(texts);
+  // Codes and sizes only: page content stays out of logs.
+  DVLOG(1) << "tark-page: own batch " << source << " -> " << target << " items=" << items.size()
+           << " ms=" << (base::TimeTicks::Now() - start).InMilliseconds();
+  return batch;
+}
+
+void TarkPageTranslator::ReleasePageModel() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  UnloadPageModel();
+}
+
+TarkDirections TarkPageTranslator::CaptionsHold() const {
+  TarkDirections held;
+  for (const auto& [holder, directions] : captions_) {
+    held.insert(directions.begin(), directions.end());
+  }
+  return held;
+}
+
+TarkTranslationModel* TarkPageTranslator::Hold(const TarkDirections& directions,
+                                               bool keep_captions) {
+  TarkDirections wanted = directions;
+  if (keep_captions) {
+    const TarkDirections held = CaptionsHold();
+    wanted.insert(held.begin(), held.end());
+  }
+  if (!std::ranges::includes(wanted, loaded_)) {
+    Unload();  // never a model nobody needs next to the one that loads
+  }
+  if (!model_) {
+    model_ = make_.Run();
+    if (!model_) {
+      return nullptr;
+    }
+  }
+  loaded_.insert(directions.begin(), directions.end());
+  return model_.get();
+}
+
+void TarkPageTranslator::Unload() {
+  model_.reset();
+  loaded_.clear();
+}
+
+void TarkPageTranslator::UnloadPageModel() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const TarkDirections held = CaptionsHold();
+  if (held.empty() || !std::ranges::includes(held, loaded_)) {
+    Unload();
+  }
+}
+
+void TarkPageTranslator::ArmIdleTimer() {
+  idle_.Start(FROM_HERE, kTarkPageIdleUnload, this, &TarkPageTranslator::UnloadPageModel);
+}
