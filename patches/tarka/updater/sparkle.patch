+// Tark (M5): the part of Sparkle 2's SPUStandardUpdaterController that Tark
+// calls. Sparkle.framework is loaded at run time from the app's Frameworks
+// folder (the signing script puts it there), so nothing links against it and
+// a build without it simply has no updater.
+@protocol TarkSparkleUpdaterController <NSObject>
+- (instancetype)initWithStartingUpdater:(BOOL)startUpdater
+                        updaterDelegate:(id)updaterDelegate
+                     userDriverDelegate:(id)userDriverDelegate;
+- (void)checkForUpdates:(id)sender;
+@end
+
 @implementation AppController {
+  // Tark (M5): Sparkle's updater controller, or nil without Sparkle.
+  id<TarkSparkleUpdaterController> _tarkUpdater;
+
