+// Tark (M5): starts Sparkle, which checks gettarka.com/appcast.xml on the
+// schedule in Info.plist (SUFeedURL, SUScheduledCheckInterval) and verifies
+// every update with SUPublicEDKey and the app's own code signature.
+- (void)tarkStartUpdater {
+  if (_tarkUpdater) {
+    return;
+  }
+  NSString* path = [NSBundle.mainBundle.privateFrameworksPath
+      stringByAppendingPathComponent:@"Sparkle.framework"];
+  NSBundle* sparkle = [NSBundle bundleWithPath:path];
+  NSError* error = nil;
+  if (!sparkle || ![sparkle loadAndReturnError:&error]) {
+    if (error) {
+      LOG(ERROR) << "Sparkle did not load: "
+                 << base::SysNSStringToUTF8(error.localizedDescription);
+    }
+    return;
+  }
+  Class controller = NSClassFromString(@"SPUStandardUpdaterController");
+  if (!controller) {
+    return;
+  }
+  _tarkUpdater = [(id<TarkSparkleUpdaterController>)[controller alloc]
+      initWithStartingUpdater:YES
+              updaterDelegate:nil
+           userDriverDelegate:nil];
+}
+
+- (IBAction)tarkCheckForUpdates:(id)sender {
+  [_tarkUpdater checkForUpdates:sender];
+}
