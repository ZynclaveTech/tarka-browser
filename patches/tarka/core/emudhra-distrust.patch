+// Tark: the six eMudhra TLS intermediate keys disclosed as compromised in
+// October 2026 (generated with too little randomness: EM DV/OV/EV TLS CA -
+// G3B and G3C, and their Sectigo cross-signs). Chrome blocked them by CRLSet;
+// Tark gets no CRLSet updates, so they are in the built-in blocklist.
+TEST(CRLSetTest, BuiltinBlocksEmudhraCompromisedTlsKeys) {
+  scoped_refptr<CRLSet> set = CRLSet::BuiltinCRLSet();
+  ASSERT_TRUE(set);
+  static constexpr auto kSpkiSha256Hex = std::to_array<std::string_view>({
+      "43bffa19d6ef651451f6841e019931e96f6f2eaeff28ab4b6f1ce4576de2717b",
+      "49dd353dc2b919a3770645117d0e60c16115e7d1bc259eefe734b00ea434fe5f",
+      "5c0660a2b164910d8ff589c18e14552e9e0ec237dcefe2cb736d41a4811f81a0",
+      "63ecefee431d49523bc1136c4e72d0206a477086caf606cd5cf025686c109cf8",
+      "e0254c7fcdc265e2f0f8a428dabb75ab4ae039b4872d62f5ee57f0877d5a8a41",
+      "ebed6475c2c2d80fcb199f3fe8dd6e6b3ce60b77eb15d4e42c3dec0c6f5b5105",
+  });
+  for (std::string_view hex : kSpkiSha256Hex) {
+    std::string hash;
+    ASSERT_TRUE(base::HexStringToString(hex, &hash));
+    EXPECT_EQ(CRLSet::REVOKED, set->CheckSPKI(hash)) << hex;
+  }
+
+  // Every blocked certificate on file is caught by its key, whichever root
+  // (emSign or Sectigo) it was issued under.
+  base::FilePath dir = GetTestNetDataDirectory().AppendASCII("ssl/blocklist");
