Tark: uBlock Origin is not pinned to the toolbar by default (spec 5.1:
"Nothing else by default"). Helium's ublock-reconfigure-defaults.patch
pins it; this undoes only that default, so the borrowed patch stays as
upstream ships it.

--- a/extensions/browser/extension_prefs.cc
+++ b/extensions/browser/extension_prefs.cc
@@ -2253,8 +2253,10 @@
 void ExtensionPrefs::RegisterProfilePrefs(
     user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterDictionaryPref(pref_names::kExtensions);
+  // Tark: nothing is pinned to the toolbar by default (spec 5.1); Helium
+  // pins uBlock Origin here. Pinning stays one click away in the extensions
+  // menu.
   registry->RegisterListPref(pref_names::kPinnedExtensions,
-                             base::ListValue().Append(tark::kUBlockOriginComponentId),
                              user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
   registry->RegisterListPref(pref_names::kDeletedComponentExtensions);
   registry->RegisterDictionaryPref(kExtensionsBlocklistUpdate);
