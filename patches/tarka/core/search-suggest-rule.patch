+#ifndef CHROME_BROWSER_SEARCH_ENGINES_TARK_SUGGEST_RULE_H_
+#define CHROME_BROWSER_SEARCH_ENGINES_TARK_SUGGEST_RULE_H_
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_service_observer.h"
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace tark {
+
+// True while search suggestions are off because the rule turned them off,
+// not because the user did.
+inline constexpr char kSuggestOffByRule[] = "tark.suggest_off_by_rule";
+
+// Search suggestions are on while Shodhya is the default engine and off for
+// any other engine, so keystrokes never reach an engine the user merely
+// switched to. The rule acts only while the user has not set suggestions
+// themselves, and only ever undoes its own write.
+class SuggestRule : public KeyedService, public TemplateURLServiceObserver {
+ public:
+  SuggestRule(PrefService* prefs, TemplateURLService* template_url_service);
+  SuggestRule(const SuggestRule&) = delete;
+  SuggestRule& operator=(const SuggestRule&) = delete;
+  ~SuggestRule() override;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // TemplateURLServiceObserver:
+  void OnTemplateURLServiceChanged() override;
+  void OnTemplateURLServiceShuttingDown() override;
+
+ private:
+  void Apply();
+  void OnSuggestPrefChanged();
+
+  raw_ptr<PrefService> prefs_;
+  raw_ptr<TemplateURLService> template_url_service_;
+  PrefChangeRegistrar registrar_;
+  base::ScopedObservation<TemplateURLService, TemplateURLServiceObserver>
+      observation_{this};
+  base::CallbackListSubscription on_loaded_;
+  // Set around the rule's own pref writes, so OnSuggestPrefChanged can tell
+  // them from the user's.
+  bool applying_ = false;
+};
+
+}  // namespace tark
+
+#endif  // CHROME_BROWSER_SEARCH_ENGINES_TARK_SUGGEST_RULE_H_
