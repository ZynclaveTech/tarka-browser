+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/search_engines/tark_suggest_rule_factory.h"
+
+#include <memory>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/browser/search_engines/tark_suggest_rule.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+
+namespace tark {
+
+// static
+SuggestRuleFactory* SuggestRuleFactory::GetInstance() {
+  static base::NoDestructor<SuggestRuleFactory> instance;
+  return instance.get();
+}
+
+SuggestRuleFactory::SuggestRuleFactory()
+    : ProfileKeyedServiceFactory(
+          "TarkSuggestRule",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kOriginalOnly)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {
+  DependsOn(TemplateURLServiceFactory::GetInstance());
+}
+
+SuggestRuleFactory::~SuggestRuleFactory() = default;
+
+std::unique_ptr<KeyedService>
+SuggestRuleFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  TemplateURLService* template_url_service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (!template_url_service) {
+    return nullptr;
+  }
+  return std::make_unique<SuggestRule>(profile->GetPrefs(),
+                                       template_url_service);
+}
+
+void SuggestRuleFactory::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  SuggestRule::RegisterProfilePrefs(registry);
+}
+
+bool SuggestRuleFactory::ServiceIsCreatedWithBrowserContext() const {
+  return true;
+}
+
+bool SuggestRuleFactory::ServiceIsNULLWhileTesting() const {
+  return true;
+}
+
+}  // namespace tark
