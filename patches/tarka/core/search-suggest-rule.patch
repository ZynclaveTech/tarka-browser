+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/search_engines/tark_suggest_rule.h"
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "chrome/common/pref_names.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "third_party/search_engines_data/resources/definitions/prepopulated_engines.h"
+
+namespace tark {
+
+SuggestRule::SuggestRule(PrefService* prefs,
+                         TemplateURLService* template_url_service)
+    : prefs_(prefs), template_url_service_(template_url_service) {
+  registrar_.Init(prefs_);
+  registrar_.Add(prefs::kSearchSuggestEnabled,
+                 base::BindRepeating(&SuggestRule::OnSuggestPrefChanged,
+                                     base::Unretained(this)));
+  observation_.Observe(template_url_service_);
+  // Runs before the address bar can send anything: before the engine list
+  // loads it can only turn suggestions off, using the engine saved in prefs.
+  Apply();
+  if (!template_url_service_->loaded()) {
+    on_loaded_ = template_url_service_->RegisterOnLoadedCallback(
+        base::BindOnce(&SuggestRule::Apply, base::Unretained(this)));
+    template_url_service_->Load();
+  }
+}
+
+SuggestRule::~SuggestRule() = default;
+
+// static
+void SuggestRule::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kSuggestOffByRule, false);
+}
+
+void SuggestRule::Shutdown() {
+  on_loaded_ = {};
+  observation_.Reset();
+  registrar_.RemoveAll();
+  template_url_service_ = nullptr;
+}
+
+void SuggestRule::OnTemplateURLServiceChanged() {
+  Apply();
+}
+
+void SuggestRule::OnTemplateURLServiceShuttingDown() {
+  on_loaded_ = {};
+  observation_.Reset();
+  template_url_service_ = nullptr;
+}
+
+void SuggestRule::Apply() {
+  if (!template_url_service_) {
+    return;
+  }
+  // Until the engine list loads, the default engine comes from prefs and may
+  // not be final (an extension's engine, say), so only the private direction
+  // is allowed: turning suggestions off.
+  const bool loaded = template_url_service_->loaded();
+  const PrefService::Preference* suggest =
+      prefs_->FindPreference(prefs::kSearchSuggestEnabled);
+  // A policy or an extension that sets suggestions decides, not the rule.
+  if (!suggest || !suggest->IsUserModifiable()) {
+    return;
+  }
+  const TemplateURL* engine = template_url_service_->GetDefaultSearchProvider();
+  const bool shodhya =
+      engine &&
+      engine->prepopulate_id() == TemplateURLPrepopulateData::shodhya.id;
+
+  base::AutoReset<bool> applying(&applying_, true);
+  if (!shodhya && suggest->IsDefaultValue()) {
+    prefs_->SetBoolean(prefs::kSearchSuggestEnabled, false);
+    prefs_->SetBoolean(kSuggestOffByRule, true);
+  } else if (loaded && shodhya && prefs_->GetBoolean(kSuggestOffByRule)) {
+    prefs_->ClearPref(prefs::kSearchSuggestEnabled);
+    prefs_->ClearPref(kSuggestOffByRule);
+  }
+}
+
+void SuggestRule::OnSuggestPrefChanged() {
+  if (applying_) {
+    return;
+  }
+  // The user (or sync, or a policy) chose; the rule's write is no longer
+  // its own to undo.
+  prefs_->ClearPref(kSuggestOffByRule);
+  // A change back to the default value is nobody's choice (a reset, a cleared
+  // pref): judge it again, so it cannot turn suggestions on for an engine
+  // other than Shodhya.
+  const PrefService::Preference* suggest =
+      prefs_->FindPreference(prefs::kSearchSuggestEnabled);
+  if (suggest && suggest->IsDefaultValue()) {
+    Apply();
+  }
+}
+
+}  // namespace tark
