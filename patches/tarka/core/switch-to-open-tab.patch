+++ b/chrome/browser/ui/navigator/tark/switch_to_open_tab_rules.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/navigator/tark/switch_to_open_tab_rules.h"
+
+#include <map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "url/gurl.h"
+
+namespace tark {
+namespace {
+
+struct Pending {
+  uint64_t id = 0;
+  base::OnceClosure open;
+};
+
+std::map<const void*, Pending>& PendingOpens() {
+  static base::NoDestructor<std::map<const void*, Pending>> pending;
+  return *pending;
+}
+
+GURL WithoutRef(const GURL& url) {
+  GURL::Replacements no_ref;
+  no_ref.ClearRef();
+  return url.ReplaceComponents(no_ref);
+}
+
+}  // namespace
+
+bool IsSwitchableLinkClick(WindowOpenDisposition disposition,
+                           ui::PageTransition transition,
+                           bool has_post_data,
+                           bool has_opener) {
+  return (disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB ||
+          disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB) &&
+         ui::PageTransitionCoreTypeIs(transition, ui::PAGE_TRANSITION_LINK) && !has_post_data &&
+         !has_opener;
+}
+
+bool IsSameLinkTarget(const GURL& open, const GURL& wanted) {
+  if (!open.is_valid() || !wanted.is_valid() || !open.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  return WithoutRef(open) == WithoutRef(wanted);
+}
+
+uint64_t SetOpenAnyway(const void* window, base::OnceClosure open) {
+  static uint64_t next_id = 1;
+  Pending& pending = PendingOpens()[window];
+  pending.id = next_id++;
+  pending.open = std::move(open);
+  return pending.id;
+}
+
+void RunOpenAnyway(const void* window) {
+  auto it = PendingOpens().find(window);
+  if (it == PendingOpens().end()) {
+    return;
+  }
+  base::OnceClosure open = std::move(it->second.open);
+  PendingOpens().erase(it);
+  if (open) {
+    std::move(open).Run();
+  }
+}
+
+void ClearOpenAnyway(const void* window, uint64_t id) {
+  auto it = PendingOpens().find(window);
+  if (it != PendingOpens().end() && it->second.id == id) {
+    PendingOpens().erase(it);
+  }
+}
+
+}  // namespace tark
