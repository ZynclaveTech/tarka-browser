+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/navigator/tark/switch_to_open_tab_rules.h"
+
+#include "base/functional/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace tark {
+namespace {
+
+// The user (2026-10-22): links that would open a new tab go to the tab
+// already showing the page: target=_blank, ⌘-click, middle-click and "Open
+// Link in New Tab".
+TEST(SwitchToOpenTabTest, NewTabLinkClicksSwitch) {
+  for (auto disposition : {WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                           WindowOpenDisposition::NEW_BACKGROUND_TAB}) {
+    EXPECT_TRUE(IsSwitchableLinkClick(disposition, ui::PAGE_TRANSITION_LINK,
+                                      /*has_post_data=*/false, /*has_opener=*/false));
+  }
+}
+
+TEST(SwitchToOpenTabTest, OtherOpensDoNot) {
+  // A normal click in the same tab, a pop-up window, a new window.
+  for (auto disposition : {WindowOpenDisposition::CURRENT_TAB, WindowOpenDisposition::NEW_POPUP,
+                           WindowOpenDisposition::NEW_WINDOW, WindowOpenDisposition::OFF_THE_RECORD}) {
+    EXPECT_FALSE(IsSwitchableLinkClick(disposition, ui::PAGE_TRANSITION_LINK, false, false));
+  }
+  // Typed in the address bar or from a bookmark: not a link click.
+  EXPECT_FALSE(IsSwitchableLinkClick(WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                     ui::PAGE_TRANSITION_TYPED, false, false));
+  EXPECT_FALSE(IsSwitchableLinkClick(WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                     ui::PAGE_TRANSITION_AUTO_BOOKMARK, false, false));
+  // A form submission (POST), and a page script that keeps a handle on the
+  // window it opens (sign-in pop-ups opened as tabs).
+  EXPECT_FALSE(IsSwitchableLinkClick(WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                     ui::PAGE_TRANSITION_LINK, /*has_post_data=*/true, false));
+  EXPECT_FALSE(IsSwitchableLinkClick(WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                                     ui::PAGE_TRANSITION_LINK, false, /*has_opener=*/true));
+}
+
+// "Same page": the same address, ignoring only the part after #.
+TEST(SwitchToOpenTabTest, SameLinkIgnoresOnlyTheFragment) {
+  const GURL page("https://news.example.in/budget-2026");
+  EXPECT_TRUE(IsSameLinkTarget(page, page));
+  EXPECT_TRUE(IsSameLinkTarget(GURL("https://news.example.in/budget-2026#taxes"), page));
+  EXPECT_TRUE(IsSameLinkTarget(page, GURL("https://news.example.in/budget-2026#top")));
+  EXPECT_FALSE(IsSameLinkTarget(GURL("https://news.example.in/budget-2026?page=2"), page));
+  EXPECT_FALSE(IsSameLinkTarget(GURL("https://news.example.in/budget-2025"), page));
+  EXPECT_FALSE(IsSameLinkTarget(GURL("http://news.example.in/budget-2026"), page));
+  // Nothing to compare: a blank or broken address never matches.
+  EXPECT_FALSE(IsSameLinkTarget(GURL(), GURL()));
+  EXPECT_FALSE(IsSameLinkTarget(GURL("about:blank"), GURL("about:blank")));
+}
+
+// "Open anyway" on the notice opens the link the click was for, once, in
+// the window it was clicked in.
+TEST(SwitchToOpenTabTest, OpenAnywayRunsOnceForItsWindow) {
+  int window_a = 0, window_b = 0;
+  int opened_a = 0, opened_b = 0;
+  SetOpenAnyway(&window_a, base::BindOnce([](int* n) { ++*n; }, &opened_a));
+  const uint64_t b = SetOpenAnyway(&window_b, base::BindOnce([](int* n) { ++*n; }, &opened_b));
+  RunOpenAnyway(&window_a);
+  RunOpenAnyway(&window_a);
+  EXPECT_EQ(opened_a, 1);
+  EXPECT_EQ(opened_b, 0);
+  ClearOpenAnyway(&window_b, b);
+  RunOpenAnyway(&window_b);
+  EXPECT_EQ(opened_b, 0);
+}
+
+// A newer switch in the same window replaces the older one's link.
+TEST(SwitchToOpenTabTest, OpenAnywayKeepsTheLatestLink) {
+  int window = 0;
+  int first = 0, second = 0;
+  const uint64_t old_id = SetOpenAnyway(&window, base::BindOnce([](int* n) { ++*n; }, &first));
+  SetOpenAnyway(&window, base::BindOnce([](int* n) { ++*n; }, &second));
+  // The older notice closes as the newer one replaces it: the newer link stays.
+  ClearOpenAnyway(&window, old_id);
+  RunOpenAnyway(&window);
+  EXPECT_EQ(first, 0);
+  EXPECT_EQ(second, 1);
+}
+
+}  // namespace
+}  // namespace tark
