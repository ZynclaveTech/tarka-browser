+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_NAVIGATOR_TARK_SWITCH_TO_OPEN_TAB_RULES_H_
+#define CHROME_BROWSER_UI_NAVIGATOR_TARK_SWITCH_TO_OPEN_TAB_RULES_H_
+
+#include <cstdint>
+
+#include "base/functional/callback.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+class GURL;
+
+namespace tark {
+
+// A link click that would open a new tab (the page's own target=_blank,
+// ⌘-click, middle-click, "Open Link in New Tab"): the kind that goes to the
+// tab already showing the page. Not a form submission, and not a page script
+// keeping a handle on the window it opens.
+bool IsSwitchableLinkClick(WindowOpenDisposition disposition,
+                           ui::PageTransition transition,
+                           bool has_post_data,
+                           bool has_opener);
+
+// Whether an open tab at `open` already shows the link to `wanted`: the
+// same web address, ignoring only the part after #.
+bool IsSameLinkTarget(const GURL& open, const GURL& wanted);
+
+// The link a switch skipped, kept per window (`window` is only a key) until
+// its notice closes: "Open anyway" opens it once. A newer switch in the same
+// window replaces it; SetOpenAnyway() returns an id so that closing the
+// older notice clears only its own link.
+uint64_t SetOpenAnyway(const void* window, base::OnceClosure open);
+void RunOpenAnyway(const void* window);
+void ClearOpenAnyway(const void* window, uint64_t id);
+
+}  // namespace tark
+
+#endif  // CHROME_BROWSER_UI_NAVIGATOR_TARK_SWITCH_TO_OPEN_TAB_RULES_H_
