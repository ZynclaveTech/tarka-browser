+#ifndef CHROME_BROWSER_UI_NAVIGATOR_TARK_SWITCH_TO_OPEN_TAB_H_
+#define CHROME_BROWSER_UI_NAVIGATOR_TARK_SWITCH_TO_OPEN_TAB_H_
+
+struct NavigateParams;
+
+namespace tark {
+
+// Tark: a link that would open a new tab goes to the tab in the same window
+// already showing that page (ignoring the part after #), with a short notice
+// offering "Open anyway". Returns true when it switched, and the navigation
+// must not go on.
+bool MaybeSwitchToOpenTab(const NavigateParams& params);
+
+}  // namespace tark
