+// Opens a link from another app in a new tab, as that launch would have.
+void OpenLaunchAnyway(base::WeakPtr<BrowserWindowInterface> browser,
+                      GURL url,
+                      bool untrusted_launch) {
+  if (!browser) {
+    return;
+  }
+  NavigateParams params(browser.get(), url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  if (untrusted_launch) {
+    params.initiator_origin = url::Origin();
+  }
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+// The tab in `tabs` already showing `url`, other than `except`; kNoTab if
+// none.
+int IndexOfOpenTab(TabStripModel* tabs, const GURL& url, const content::WebContents* except) {
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* contents = tabs->GetWebContentsAt(i);
+    if (contents != except && IsSameLinkTarget(contents->GetVisibleURL(), url)) {
+      return i;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+// Switches to tab `index` and shows the notice, whose "Open anyway" runs
+// `open_anyway`.
+void SwitchAndNotify(BrowserWindowInterface* browser, int index, base::OnceClosure open_anyway) {
+  browser->GetTabStripModel()->ActivateTabAt(
+      index, TabStripUserGestureDetails(TabStripUserGestureDetails::GestureType::kOther));
+  const void* window = browser;
+  const uint64_t id = SetOpenAnyway(window, std::move(open_anyway));
+  if (ToastService* toasts = ToastService::From(browser)) {
+    ToastParams toast(ToastId::kTarkSwitchedToOpenTab);
+    toast.toast_close_callback =
+        base::ScopedClosureRunner(base::BindOnce(&ClearOpenAnyway, window, id));
+    toasts->toast_controller()->MaybeShowToast(std::move(toast));
+  } else {
+    ClearOpenAnyway(window, id);
+  }
+}
+
 }  // namespace
 
+bool MaybeSwitchToOpenTabForLaunch(BrowserWindowInterface* browser,
+                                   const GURL& url,
+                                   bool untrusted_launch) {
+  if (!browser || browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  TabStripModel* tabs = browser->GetTabStripModel();
+  if (!tabs) {
+    return false;
+  }
+  const int open_index = IndexOfOpenTab(tabs, url, /*except=*/nullptr);
+  if (open_index == TabStripModel::kNoTab) {
+    return false;
+  }
+  SwitchAndNotify(browser, open_index,
+                  base::BindOnce(&OpenLaunchAnyway, browser->GetWeakPtr(), url, untrusted_launch));
+  return true;
+}
