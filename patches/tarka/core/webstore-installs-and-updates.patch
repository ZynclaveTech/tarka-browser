Tark: restore Chrome Web Store installs and extension update checks.
ungoogled-chromium's disable-webstore-urls.patch and inox 0005 remove the
store download (DownloadCrx), the install (StartCrxInstaller), the default
store update URL and the update-check loop; this puts the four back. Spec
§5.3: store traffic only on install and update; cws_info_service and
content verification stay off. The store's hosts are kept unsubstituted by
utils/domain_substitution_skip.txt. Store extensions are routed to
ExtensionDownloader (clients2.google.com) instead of UpdateService
(update.googleapis.com), which stays substituted so the component updater
cannot reach Google.

--- a/extensions/browser/updater/extension_downloader.cc
+++ b/extensions/browser/updater/extension_downloader.cc
@@ -158,7 +158,7 @@
                                       const GURL& update_url) {
   if (update_url.is_empty()) {
     // Fill in default update URL.
-    return std::nullopt;
+    return extension_urls::GetWebstoreUpdateUrl();
   }
 
   // Skip extensions with non-empty invalid update URLs.
@@ -176,6 +176,11 @@
     return std::nullopt;
   }
 
+  // Make sure we use SSL for store-hosted extensions.
+  if (extension_urls::IsWebstoreUpdateUrl(update_url) &&
+      !update_url.SchemeIsCryptographic()) {
+    return extension_urls::GetWebstoreUpdateUrl();
+  }
 
   return update_url;
 }
@@ -347,6 +352,10 @@
     AddToFetches(fetches_preparing, std::move(task));
   pending_tasks_.clear();
 
+  for (auto& fetch_list : fetches_preparing) {
+    for (auto& fetch : fetch_list.second)
+      StartUpdateCheck(std::move(fetch));
+  }
 }
 
