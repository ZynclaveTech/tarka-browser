   Profile* profile = Profile::FromBrowserContext(browser_context);
 
+  // Tark: offline, a new tab shows Tark's own page (the mark, a search pill,
+  // one line) instead of a network error for shodhya.com (spec 6.1).
+  if (!profile->IsOffTheRecord() && net::NetworkChangeNotifier::IsOffline()) {
+    *url = GURL(chrome::kChromeUINewTabPageThirdPartyURL);
+    return true;
+  }
+
