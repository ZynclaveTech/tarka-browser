+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_NET_TARK_BUNDLED_CRL_SET_H_
+#define CHROME_BROWSER_NET_TARK_BUNDLED_CRL_SET_H_
+
+#include "base/containers/span.h"
+
+namespace tark {
+
+// The CRLSet built into this release: Chrome's, taken from its CRLSet
+// component when the release was made (utils/trust_data.py).
+base::span<const uint8_t> BundledCRLSet();
+
+// Hands BundledCRLSet() to the certificate verifier. Tark's component updater
+// fetches no CRLSets, so without this Tark would have none. The verifier keeps
+// whichever CRLSet has the higher sequence number, so a newer one delivered
+// later replaces this one, and this one never replaces a newer one.
+void LoadBundledCRLSet();
+
+}  // namespace tark
+
+#endif  // CHROME_BROWSER_NET_TARK_BUNDLED_CRL_SET_H_
