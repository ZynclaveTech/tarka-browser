+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/lifetime/termination_notification.h"
+#include "components/component_updater/component_updater_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "third_party/widevine/cdm/buildflags.h"
+
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+#include "chrome/browser/component_updater/widevine_cdm_component_installer.h"
+#endif
+
+namespace component_updater {
+
+void TarkCheckWidevineNow(ComponentUpdateService* cus, Callback callback) {
+  cus->GetOnDemandUpdater().OnDemandUpdate(tark::kWidevineCdmComponentId,
+                                           OnDemandUpdater::Priority::FOREGROUND,
+                                           std::move(callback));
+}
+
+}  // namespace component_updater
+
+namespace tark {
+
+namespace {
+
+class WidevineOptIn {
+ public:
+  WidevineOptIn() = default;
+  WidevineOptIn(const WidevineOptIn&) = delete;
+  WidevineOptIn& operator=(const WidevineOptIn&) = delete;
+
+  void Start(component_updater::ComponentUpdateService* cus,
+             PrefService* local_state) {
+    cus_ = cus;
+    local_state_ = local_state;
+    registrar_.Init(local_state_);
+    registrar_.Add(kWidevineEnabled,
+                   base::BindRepeating(&WidevineOptIn::OnPrefChanged,
+                                       base::Unretained(this)));
+    // Local State checks at destruction that no pref observers remain.
+    on_terminating_ = browser_shutdown::AddAppTerminatingCallback(
+        base::BindOnce(&WidevineOptIn::Stop, base::Unretained(this)));
+    if (local_state_->GetBoolean(kWidevineEnabled)) {
+      Register(/*check_now=*/false);
+    }
+  }
+
+ private:
+  void Stop() { registrar_.RemoveAll(); }
+
+  void OnPrefChanged() {
+    if (local_state_->GetBoolean(kWidevineEnabled)) {
+      Register(/*check_now=*/true);
+    } else {
+      // Unregistering uninstalls: the downloaded module is deleted, and no
+      // further update checks are made for it.
+      cus_->UnregisterComponent(kWidevineCdmComponentId);
+    }
+  }
+
+  void Register(bool check_now) {
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+    base::OnceClosure registered;
+    if (check_now) {
+      registered = base::BindOnce(
+          [](component_updater::ComponentUpdateService* cus) {
+            component_updater::TarkCheckWidevineNow(
+                cus, base::BindOnce([](update_client::Error error) {
+                  VLOG(1) << "Widevine update check finished: "
+                          << static_cast<int>(error);
+                }));
+          },
+          base::Unretained(cus_));
+    }
+    component_updater::RegisterWidevineCdmComponent(cus_,
+                                                    std::move(registered));
+#endif
+  }
+
+  raw_ptr<component_updater::ComponentUpdateService> cus_ = nullptr;
+  raw_ptr<PrefService> local_state_ = nullptr;
+  PrefChangeRegistrar registrar_;
+  base::CallbackListSubscription on_terminating_;
+};
+
+WidevineOptIn& GetWidevineOptIn() {
+  static base::NoDestructor<WidevineOptIn> instance;
+  return *instance;
+}
+
+}  // namespace
+
+void RegisterWidevineLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kWidevineEnabled, false);
+}
+
+void StartWidevineOptIn(component_updater::ComponentUpdateService* cus,
+                        PrefService* local_state) {
+  GetWidevineOptIn().Start(cus, local_state);
+}
+
+}  // namespace tark
