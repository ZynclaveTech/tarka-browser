+namespace tark {
+
+// Local State pref: whether the user turned on protected content (Widevine)
+// in Settings. Off by default.
+inline constexpr char kWidevineEnabled[] = "tark.widevine_enabled";
+
+// The Widevine CDM's component id; the only component Tark's component
+// updater accepts.
+inline constexpr char kWidevineCdmComponentId[] =
+    "oimompecagnajdejgnnjijobebaeigek";
+
+void RegisterWidevineLocalStatePrefs(PrefRegistrySimple* registry);
+
+// Registers the Widevine CDM component when the pref is on, and follows the
+// pref from then on: turning it on registers the component and checks for
+// it at once; turning it off unregisters it, which deletes the downloaded
+// module. Called once at startup in place of Chromium's component list.
+void StartWidevineOptIn(component_updater::ComponentUpdateService* cus,
+                        PrefService* local_state);
+
+}  // namespace tark
+
+#endif  // CHROME_BROWSER_COMPONENT_UPDATER_TARK_WIDEVINE_OPT_IN_H_
