+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-tark-home-page' is Tark's settings home
+ * (chrome://settings/, spec 6.1): one line saying how Tark is set up and
+ * eight tiles, each showing its section's state and opening it.
+ */
+
+import 'chrome://resources/cr_elements/cr_icon/cr_icon.js';
+import '../icons.html.js';
+
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {Router} from '../router.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {getTarkStatus, onTarkStatusChanged} from './tark_status.js';
+import type {TarkStatus} from './tark_status.js';
+
+import {getCss} from './home_page.css.js';
+import {getHtml} from './home_page.html.js';
+
+export interface TarkTile {
+  name: string;
+  icon: string;
+  href: string;
+  state: string;
+  external: boolean;
+}
+
+const TarkHomePageElementBase = I18nMixinLit(CrLitElement);
+
+export class TarkHomePageElement extends TarkHomePageElementBase implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-tark-home-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      status_: {type: Object},
+    };
+  }
+
+  protected accessor status_: TarkStatus|null = null;
+  private stopListening_: (() => void)|null = null;
+  private refreshes_: number = 0;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh_();
+    this.stopListening_ = onTarkStatusChanged(() => this.refresh_());
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    this.stopListening_?.();
+    this.stopListening_ = null;
+  }
+
+  private async refresh_() {
+    // Only the latest of overlapping refreshes lands.
+    const refresh = ++this.refreshes_;
+    const status = await getTarkStatus();
+    if (refresh === this.refreshes_) {
+      this.status_ = status;
+    }
+  }
+
+  protected adsText_(): string {
+    return this.i18n(
+        this.status_?.adsBlocked ? 'tarkStatusAdsBlocked' :
+                                   'tarkStatusAdsNotBlocked');
+  }
+
+  protected tiles_(): TarkTile[] {
+    const s = this.status_;
+    const look = s?.look === 'light' ? 'tarkStatusLookLight' :
+        s?.look === 'dark'           ? 'tarkStatusLookDark' :
+                                       'tarkStatusLookSystem';
+    const extensions = !s || s.extensions === 0 ?
+        this.i18n('tarkStatusNoExtensions') :
+        s.extensions === 1 ?
+        this.i18n('tarkStatusOneExtension') :
+        this.i18n('tarkStatusExtensions', String(s.extensions));
+    return [
+      {name: this.i18n('tarkSearch'), icon: 'settings:search',
+       href: '/search', state: s?.search || '', external: false},
+      {name: this.i18n('tarkPrivacy'), icon: 'settings:security',
+       href: '/privacy', state: s ? this.adsText_() : '', external: false},
+      {name: this.i18n('tarkLook'), icon: 'settings:palette',
+       href: '/appearance', state: this.i18n(look), external: false},
+      {name: this.i18n('tarkExtensions'), icon: 'settings:chrome-extension',
+       href: 'chrome://extensions', state: extensions, external: true},
+      {name: this.i18n('tarkPasswords'), icon: 'settings:password-manager',
+       href: '/autofill', state: this.i18n('tarkStatusPasswords'),
+       external: false},
+      {name: this.i18n('tarkDownloads'), icon: 'settings:download',
+       href: '/downloads', state: s?.downloads || '', external: false},
+      {name: this.i18n('tarkLanguages'), icon: 'settings:translate',
+       href: '/languages', state: s?.languages || '', external: false},
+      {name: this.i18n('tarkAdvanced'), icon: 'settings:build',
+       href: '/advancedSettings', state: this.i18n('tarkStatusAdvanced'),
+       external: false},
+    ];
+  }
+
+  // Opens a section in place, as the side menu does, instead of reloading.
+  // Extensions and modified clicks (new tab, new window) keep the link.
+  protected onTileClick_(e: MouseEvent) {
+    const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href')!;
+    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
+      return;
+    }
+    const route = Router.getInstance().getRouteForPath(href);
+    if (!route) {
+      return;
+    }
+    e.preventDefault();
+    Router.getInstance().navigateTo(
+        route, /* dynamicParams */ undefined, /* removeSearch */ true);
+  }
+
+  // SettingsPlugin: the home page itself is never a search result; the
+  // sections it opens are searched as usual.
+  searchContents(query: string) {
+    return Promise.resolve({
+      canceled: false,
+      matchCount: 0,
+      wasClearSearch: query === '',
+    });
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-tark-home-page': TarkHomePageElement;
+  }
+}
+
+customElements.define(TarkHomePageElement.is, TarkHomePageElement);
