+/* Copyright 2026 The Tark Authors
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file. */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #import=//resources/cr_elements/cr_shared_vars.css.js
+ * #css_wrapper_metadata_end */
+
+:host {
+  /* Amber as the tab-group yellow uses it: #ffb703 is too light on paper
+   * for an icon (1.7:1), #b78100 keeps 3:1. */
+  --tark-amber: #b78100;
+  display: block;
+  padding: 8px 0 24px;
+}
+
+@media (prefers-color-scheme: dark) {
+  :host {
+    --tark-amber: #ffc53d;
+  }
+}
+
+#summary {
+  align-items: center;
+  border: 1px solid var(--color-sys-primary, var(--cr-link-color));
+  border-radius: 14px;
+  color: var(--cr-secondary-text-color);
+  display: flex;
+  font-size: 13px;
+  gap: 10px;
+  margin-bottom: 16px;
+  padding: 10px 12px;
+}
+
+#summary b {
+  color: var(--cr-primary-text-color);
+  font-weight: 600;
+}
+
+#summaryIcon {
+  --iron-icon-fill-color: var(--color-sys-primary, var(--cr-link-color));
+  flex: none;
+}
+
+#tiles {
+  display: grid;
+  gap: 12px;
+  grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
+}
+
+.tile {
+  background: var(--color-sys-base-container-elevated,
+      var(--cr-card-background-color));
+  border: 1px solid var(--cr-separator-color);
+  border-radius: 14px;
+  color: var(--cr-primary-text-color);
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  outline: none;
+  padding: 14px;
+  text-decoration: none;
+}
+
+.tile:hover,
+.tile:focus-visible {
+  border-color: var(--color-sys-primary, var(--cr-link-color));
+}
+
+.tile:focus-visible {
+  box-shadow: 0 0 0 1px var(--color-sys-primary, var(--cr-link-color));
+}
+
+.tile cr-icon {
+  --iron-icon-fill-color: var(--color-sys-primary, var(--cr-link-color));
+  margin-bottom: 4px;
+}
+
+/* Indigo, coral, amber in turn, as in the mockup. */
+.tile:nth-child(3n+2) cr-icon {
+  --iron-icon-fill-color: var(--tark-coral);
+}
+
+.tile:nth-child(3n) cr-icon {
+  --iron-icon-fill-color: var(--tark-amber);
+}
+
+.name {
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.state {
+  color: var(--cr-secondary-text-color);
+  font-size: 12px;
+  min-height: 1.3em;
+}
