+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview How Tark is set up, for the settings home page and the
+ * section headers (spec 6.1). Read from the settings front end only: the
+ * search-engine list, chrome.management for uBlock Origin and extensions,
+ * the colour-scheme mode, and prefs through chrome.settingsPrivate.
+ */
+
+import {browserProxyFactory, ColorSchemeMode} from 'chrome://resources/cr_components/customize_color_scheme_mode/customize_color_scheme_mode.mojom-webui.js';
+import {addWebUiListener} from 'chrome://resources/js/cr.js';
+
+import {SearchEnginesBrowserProxyImpl} from '../search_page/search_engines_browser_proxy.js';
+
+/** The built-in uBlock Origin (components/tark_ublock/extension_ids.h). */
+export const UBLOCK_ORIGIN_ID = 'onfgfofhhcjllijjogonbaokaiokfgna';
+
+export type TarkLook = 'system'|'light'|'dark';
+
+export interface TarkStatus {
+  search: string;
+  adsBlocked: boolean;
+  look: TarkLook;
+  extensions: number;
+  downloads: string;
+  languages: string;
+}
+
+let look: TarkLook = 'system';
+let lookKnown: Promise<void>|null = null;
+const listeners: Array<() => void> = [];
+let listening = false;
+
+function notify() {
+  listeners.forEach(cb => cb());
+}
+
+function listen() {
+  if (listening) {
+    return;
+  }
+  listening = true;
+  addWebUiListener('search-engines-changed', notify);
+  chrome.settingsPrivate.onPrefsChanged.addListener(notify);
+  chrome.management.onInstalled.addListener(notify);
+  chrome.management.onUninstalled.addListener(notify);
+  chrome.management.onEnabled.addListener(notify);
+  chrome.management.onDisabled.addListener(notify);
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState === 'visible') {
+      notify();
+    }
+  });
+}
+
+function knowLook(): Promise<void> {
+  if (!lookKnown) {
+    lookKnown = new Promise(resolve => {
+      // Never hold the page back: without an answer, "Follows your Mac".
+      setTimeout(resolve, 1000);
+      const proxy = browserProxyFactory.getInstance();
+      proxy.callbackRouter.setColorSchemeMode.addListener(
+          (mode: ColorSchemeMode) => {
+            look = mode === ColorSchemeMode.kLight ? 'light' :
+                mode === ColorSchemeMode.kDark     ? 'dark' :
+                                                     'system';
+            resolve();
+            notify();
+          });
+      proxy.handler.initializeColorSchemeMode();
+    });
+  }
+  return lookKnown;
+}
+
+/** The last part of a folder path, "Downloads" for /Users/me/Downloads. */
+export function folderName(path: string): string {
+  const parts = path.split(/[\\/]/).filter(p => p);
+  return parts.length ? parts[parts.length - 1] : path;
+}
+
+/**
+ * Preferred languages, each in its own language, base languages once:
+ * "en-US,en,hi" becomes "English, हिन्दी".
+ */
+export function languageNames(acceptLanguages: string): string {
+  const seen = new Set<string>();
+  const names: string[] = [];
+  for (const code of acceptLanguages.split(',')) {
+    const base = code.trim().split('-')[0];
+    if (!base || seen.has(base)) {
+      continue;
+    }
+    seen.add(base);
+    let name = base;
+    try {
+      name = new Intl.DisplayNames([base], {type: 'language'}).of(base) || base;
+    } catch (e) {
+      // An unknown code shows as itself.
+    }
+    names.push(name.charAt(0).toLocaleUpperCase(base) + name.slice(1));
+  }
+  return names.join(', ');
+}
+
+async function prefValue(name: string): Promise<unknown> {
+  try {
+    return (await chrome.settingsPrivate.getPref(name)).value;
+  } catch (e) {
+    return undefined;
+  }
+}
+
+export async function getTarkStatus(): Promise<TarkStatus> {
+  listen();
+  const [engines, ublock, all, downloads, languages] = await Promise.all([
+    SearchEnginesBrowserProxyImpl.getInstance().getSearchEnginesList(),
+    chrome.management.get(UBLOCK_ORIGIN_ID).catch(() => null),
+    chrome.management.getAll().catch(() => []),
+    prefValue('download.default_directory'),
+    prefValue('intl.accept_languages'),
+    knowLook(),
+  ]);
+  const engine = engines.defaults.find(e => e.default) ||
+      engines.actives.find(e => e.default);
+  return {
+    search: engine ? engine.name : '',
+    adsBlocked: !!ublock && ublock.enabled,
+    look,
+    extensions: all.filter(e => e.type === 'extension').length,
+    downloads: folderName(typeof downloads === 'string' ? downloads : ''),
+    languages: languageNames(typeof languages === 'string' ? languages : ''),
+  };
+}
+
+/**
+ * Calls `cb` when anything the status shows may have changed. Returns the
+ * function that stops it.
+ */
+export function onTarkStatusChanged(cb: () => void): () => void {
+  listen();
+  listeners.push(cb);
+  return () => {
+    const i = listeners.indexOf(cb);
+    if (i !== -1) {
+      listeners.splice(i, 1);
+    }
+  };
+}
