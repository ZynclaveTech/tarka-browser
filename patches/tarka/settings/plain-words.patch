+  private tarkUblockChanged_ = (info: chrome.management.ExtensionInfo) => {
+    if (info.id === UBLOCK_ORIGIN_ID) {
+      this.setTarkUblockEnabled_(info.enabled);
+    }
+  };
+
+  override connectedCallback() {
+    super.connectedCallback();
+    chrome.management.onEnabled.addListener(this.tarkUblockChanged_);
+    chrome.management.onDisabled.addListener(this.tarkUblockChanged_);
+    this.refreshTarkUblock_();
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    chrome.management.onEnabled.removeListener(this.tarkUblockChanged_);
+    chrome.management.onDisabled.removeListener(this.tarkUblockChanged_);
+  }
+
+  private async refreshTarkUblock_() {
+    try {
+      const info = await chrome.management.get(UBLOCK_ORIGIN_ID);
+      this.setTarkUblockEnabled_(info.enabled);
+    } catch (e) {
+      // Not installed: nothing is blocking.
+      this.setTarkUblockEnabled_(false);
+    }
+  }
+
+  private setTarkUblockEnabled_(enabled: boolean) {
+    this.tarkUblockPref_ = {...this.tarkUblockPref_, value: enabled};
+  }
+
+  private async onTarkUblockChange_(e: CustomEvent<boolean>) {
+    const enabled = (e.target as SettingsToggleButtonElement).checked;
+    try {
+      await chrome.management.setEnabled(UBLOCK_ORIGIN_ID, enabled);
+    } finally {
+      // Show what is true now, whether or not the change went through.
+      this.refreshTarkUblock_();
+    }
+  }
 
