+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-tark-section-header' opens each of Tark's settings
+ * sections (spec 6.1): the section's name as a small label and one plain
+ * sentence saying what it is set to.
+ */
+
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './section_header.css.js';
+import {getHtml} from './section_header.html.js';
+import {getTarkStatus, onTarkStatusChanged} from './tark_status.js';
+import type {TarkStatus} from './tark_status.js';
+
+/** The sections with a header; '' for none. */
+export type TarkSection = ''|'search'|'privacy'|'look'|'passwords'|
+    'downloads'|'languages'|'advanced';
+
+const LABELS: Record<Exclude<TarkSection, ''>, string> = {
+  search: 'tarkSearch',
+  privacy: 'tarkPrivacy',
+  look: 'tarkLook',
+  passwords: 'tarkPasswords',
+  downloads: 'tarkDownloads',
+  languages: 'tarkLanguages',
+  advanced: 'tarkAdvanced',
+};
+
+const TarkSectionHeaderElementBase = I18nMixinLit(CrLitElement);
+
+export class TarkSectionHeaderElement extends TarkSectionHeaderElementBase {
+  static get is() {
+    return 'settings-tark-section-header';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      section: {type: String},
+      status_: {type: Object},
+    };
+  }
+
+  accessor section: TarkSection = '';
+  protected accessor status_: TarkStatus|null = null;
+  private stopListening_: (() => void)|null = null;
+  private refreshes_: number = 0;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.refresh_();
+    this.stopListening_ = onTarkStatusChanged(() => this.refresh_());
+  }
+
+  override disconnectedCallback() {
+    super.disconnectedCallback();
+    this.stopListening_?.();
+    this.stopListening_ = null;
+  }
+
+  private async refresh_() {
+    // Only the latest of overlapping refreshes lands.
+    const refresh = ++this.refreshes_;
+    const status = await getTarkStatus();
+    if (refresh === this.refreshes_) {
+      this.status_ = status;
+    }
+  }
+
+  protected label_(): string {
+    return this.section ? this.i18n(LABELS[this.section]) : '';
+  }
+
+  protected sentence_(): string {
+    const s = this.status_;
+    switch (this.section) {
+      case 'search':
+        return s && s.search ? this.i18n('tarkHeaderSearch', s.search) : '';
+      case 'privacy':
+        return this.i18n('tarkHeaderPrivacy');
+      case 'look':
+        return this.i18n(
+            s?.look === 'light' ? 'tarkHeaderLookLight' :
+                s?.look === 'dark' ? 'tarkHeaderLookDark' :
+                                     'tarkHeaderLookSystem');
+      case 'passwords':
+        return this.i18n('tarkHeaderPasswords');
+      case 'downloads':
+        return s && s.downloads ?
+            this.i18n('tarkHeaderDownloads', s.downloads) : '';
+      case 'languages':
+        return s ? s.languages : '';
+      case 'advanced':
+        return this.i18n('tarkHeaderAdvanced');
+      default:
+        return '';
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-tark-section-header': TarkSectionHeaderElement;
+  }
+}
+
+customElements.define(TarkSectionHeaderElement.is, TarkSectionHeaderElement);
