+  /**
+   * Tark: the section whose header shows above the views, or '' on home,
+   * in search, on About and on subpages.
+   */
+  private tarkHeaderSection_(): string {
+    const route = this.lastRoute_;
+    if (this.inSearchMode_ || !route || route === routes.BASIC ||
+        route.isSubpage()) {
+      return '';
+    }
+    if (isInAdvancedGroup(route)) {
+      return 'advanced';
+    }
+    const sections: Array<[Route|undefined, string]> = [
+      [routes.SEARCH, 'search'],
+      [routes.PRIVACY, 'privacy'],
+      [routes.APPEARANCE, 'look'],
+      [routes.AUTOFILL, 'passwords'],
+      [routes.DOWNLOADS, 'downloads'],
+      [routes.LANGUAGES, 'languages'],
+    ];
+    const match = sections.find(([section]) => section?.contains(route));
+    return match ? match[1] : '';
+  }
+
   private renderHome_(): boolean {
