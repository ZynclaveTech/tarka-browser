+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/tark_contacted_hosts.h"
+
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace tark {
+
+void AddContactedHostsStrings(content::WebUIDataSource* html_source) {
+  struct Row {
+    const char* name;
+    int message_id;
+    const char16_t* hosts;
+  };
+  static constexpr Row kRows[] = {
+      {"tarkConnectsShodhya", IDS_SETTINGS_TARK_CONNECTS_SHODHYA,
+       u"shodhya.com, api.shodhya.com"},
+      {"tarkConnectsStore", IDS_SETTINGS_TARK_CONNECTS_STORE,
+       u"chromewebstore.google.com, clients2.google.com, "
+       u"clients2.googleusercontent.com"},
+      {"tarkConnectsUblock", IDS_SETTINGS_TARK_CONNECTS_UBLOCK,
+       u"ublockorigin.github.io, ublockorigin.pages.dev, cdn.jsdelivr.net, "
+       u"raw.githubusercontent.com, malware-filter.gitlab.io, "
+       u"malware-filter.pages.dev, curbengh.github.io, publicsuffix.org, "
+       u"pgl.yoyo.org"},
+      {"tarkConnectsWidevine", IDS_SETTINGS_TARK_CONNECTS_WIDEVINE,
+       u"update.googleapis.com, edgedl.me.gvt1.com"},
+  };
+  for (const Row& row : kRows) {
+    html_source->AddString(
+        row.name, l10n_util::GetStringFUTF16(row.message_id, row.hosts));
+  }
+  html_source->AddLocalizedString("tarkConnectsTitle",
+                                  IDS_SETTINGS_TARK_CONNECTS_TITLE);
+  html_source->AddLocalizedString("tarkConnectsIntro",
+                                  IDS_SETTINGS_TARK_CONNECTS_INTRO);
+}
+
+}  // namespace tark
