+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_CONTACTED_HOSTS_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_CONTACTED_HOSTS_H_
+
+namespace content {
+class WebUIDataSource;
+}
+
+namespace tark {
+
+// Adds the strings for Settings > Privacy > "What Tark connects to" (spec
+// 5.3). The hosts live in this file because domain substitution rewrites
+// every Google host in Chromium's string files and in the files it lists;
+// this file is Tark's own, so they reach the page as written. Keep them in
+// step with utils/allowed_hosts.txt, which the network check uses.
+void AddContactedHostsStrings(content::WebUIDataSource* html_source);
+
+}  // namespace tark
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_CONTACTED_HOSTS_H_
