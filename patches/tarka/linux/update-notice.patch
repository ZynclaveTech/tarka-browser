+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_UPDATER_LINUX_UPDATE_NOTICE_H_
+#define CHROME_BROWSER_TARK_UPDATER_LINUX_UPDATE_NOTICE_H_
+
+#include <optional>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "base/version.h"
+#include "url/gurl.h"
+
+// Tark for Linux's update notice (L4), the part with no browser in it. The
+// tarball's Tark reads gettarka.com/linux/latest.json once a day and, when a
+// newer Tark is out, offers "Update Tark…" in its menu; it never replaces its
+// own files. The .deb's Tark (in /opt/tark) is updated by apt instead.
+namespace tark_updater {
+
+// gettarka.com/linux/latest.json:
+//   {"version": "156.0.8078.47", "revision": 2, "url": "https://gettarka.com/linux/"}
+struct LinuxRelease {
+  base::Version version;  // Chromium's.
+  int revision = 0;       // Tark's on that Chromium (revision.txt).
+  GURL url;               // The download page, on gettarka.com over HTTPS.
+};
+
+// The feed, or nothing if it is malformed or points anywhere but
+// https://gettarka.com.
+std::optional<LinuxRelease> ParseLatest(std::string_view json);
+
+// Whether `latest` is newer than the running Tark: a newer Chromium, or a
+// newer revision of the same one.
+bool IsNewer(const LinuxRelease& latest,
+             const base::Version& version,
+             int revision);
+
+// Whether Tark running from `exe_dir` should check: not the .deb's.
+bool ShouldCheck(const base::FilePath& exe_dir);
+
+}  // namespace tark_updater
+
+#endif  // CHROME_BROWSER_TARK_UPDATER_LINUX_UPDATE_NOTICE_H_
