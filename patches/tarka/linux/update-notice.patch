+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_updater/linux_update_notice.h"
+
+#include "base/json/json_reader.h"
+#include "base/values.h"
+
+namespace tark_updater {
+
+std::optional<LinuxRelease> ParseLatest(std::string_view json) {
+  std::optional<base::Value> value = base::JSONReader::Read(json);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = value->GetDict();
+  const std::string* version = dict.FindString("version");
+  std::optional<int> revision = dict.FindInt("revision");
+  const std::string* url = dict.FindString("url");
+  if (!version || !revision || !url || *revision < 1) {
+    return std::nullopt;
+  }
+  LinuxRelease release{base::Version(*version), *revision, GURL(*url)};
+  if (!release.version.IsValid() || !release.url.is_valid() ||
+      !release.url.SchemeIs("https") || release.url.host() != "gettarka.com") {
+    return std::nullopt;
+  }
+  return release;
+}
+
+bool IsNewer(const LinuxRelease& latest,
+             const base::Version& version,
+             int revision) {
+  const int order = latest.version.CompareTo(version);
+  return order > 0 || (order == 0 && latest.revision > revision);
+}
+
+bool ShouldCheck(const base::FilePath& exe_dir) {
+  return exe_dir != base::FilePath("/opt/tark");
+}
+
+}  // namespace tark_updater
