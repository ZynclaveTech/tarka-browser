+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_updater/tark_updater_linux.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/base_paths.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/timer/timer.h"
+#include "base/version.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/net/system_network_context_manager.h"
+#include "chrome/browser/tark_updater/linux_update_notice.h"
+#include "chrome/browser/tark_updater/tark_revision.h"
+#include "components/version_info/version_info.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+
+namespace tark_updater {
+
+namespace {
+
+constexpr char kLatestUrl[] = "https://gettarka.com/linux/latest.json";
+constexpr size_t kMaxLatestSize = 4 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_linux_update_notice", R"(
+      semantics {
+        sender: "Tark for Linux update notice"
+        description:
+          "Reads which Tark for Linux is the newest from gettarka.com, so the "
+          "tarball's Tark can offer Update Tark in its menu. Tark installed "
+          "from the .deb is updated by apt and does not ask."
+        trigger: "A minute after start, then once a day while Tark runs."
+        data: "None: no cookies, no identifiers, no query string."
+        destination: OTHER
+        destination_other: "gettarka.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "None."
+        policy_exception_justification: "Tark has no enterprise policies."
+      })");
+
+class Checker {
+ public:
+  void Start() {
+    first_.Start(FROM_HERE, base::Minutes(1),
+                 base::BindOnce(&Checker::Check, base::Unretained(this)));
+    daily_.Start(FROM_HERE, base::Days(1),
+                 base::BindRepeating(&Checker::Check, base::Unretained(this)));
+  }
+
+  const GURL& url() const { return url_; }
+
+ private:
+  void Check() {
+    if (loader_) {
+      return;
+    }
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL(kLatestUrl);
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                               kTrafficAnnotation);
+    loader_->DownloadToString(
+        g_browser_process->system_network_context_manager()
+            ->GetSharedURLLoaderFactory()
+            .get(),
+        base::BindOnce(&Checker::OnLatest, base::Unretained(this)),
+        kMaxLatestSize);
+  }
+
+  void OnLatest(std::optional<std::string> body) {
+    loader_.reset();
+    if (!body) {
+      return;  // Offline or gettarka.com down: the next check tries again.
+    }
+    std::optional<LinuxRelease> latest = ParseLatest(*body);
+    int revision = 0;
+    if (!latest || !base::StringToInt(TARK_REVISION, &revision)) {
+      return;
+    }
+    url_ = IsNewer(*latest, base::Version(version_info::GetVersionNumber()),
+                   revision)
+               ? latest->url
+               : GURL();
+  }
+
+  base::OneShotTimer first_;
+  base::RepeatingTimer daily_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  GURL url_;
+};
+
+Checker& GetChecker() {
+  static base::NoDestructor<Checker> checker;
+  return *checker;
+}
+
+}  // namespace
+
+void StartLinuxUpdateNotice() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir) ||
+      !ShouldCheck(exe_dir)) {
+    return;
+  }
+  GetChecker().Start();
+}
+
+const GURL& LinuxUpdateUrl() {
+  return GetChecker().url();
+}
+
+}  // namespace tark_updater
