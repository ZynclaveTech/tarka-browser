+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_updater/linux_update_notice.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_updater {
+namespace {
+
+constexpr char kLatest[] =
+    R"({"version": "156.0.8078.47", "revision": 2,
+        "url": "https://gettarka.com/linux/"})";
+
+TEST(TarkLinuxUpdateNotice, ParsesTheFeed) {
+  std::optional<LinuxRelease> latest = ParseLatest(kLatest);
+  ASSERT_TRUE(latest);
+  EXPECT_EQ(latest->version, base::Version("156.0.8078.47"));
+  EXPECT_EQ(latest->revision, 2);
+  EXPECT_EQ(latest->url, GURL("https://gettarka.com/linux/"));
+}
+
+TEST(TarkLinuxUpdateNotice, NewerRevisionOfTheSameChromium) {
+  LinuxRelease latest = *ParseLatest(kLatest);
+  EXPECT_TRUE(IsNewer(latest, base::Version("156.0.8078.47"), 1));
+  EXPECT_FALSE(IsNewer(latest, base::Version("156.0.8078.47"), 2));
+  EXPECT_FALSE(IsNewer(latest, base::Version("156.0.8078.47"), 3));
+}
+
+TEST(TarkLinuxUpdateNotice, NewerChromiumWinsOverRevision) {
+  LinuxRelease latest = *ParseLatest(kLatest);
+  EXPECT_TRUE(IsNewer(latest, base::Version("155.0.8059.39"), 9));
+  EXPECT_FALSE(IsNewer(latest, base::Version("157.0.1.1"), 1));
+}
+
+TEST(TarkLinuxUpdateNotice, RefusesMalformedFeeds) {
+  EXPECT_FALSE(ParseLatest(""));
+  EXPECT_FALSE(ParseLatest("not json"));
+  EXPECT_FALSE(ParseLatest(R"({"version": "156.0.8078.47"})"));
+  EXPECT_FALSE(ParseLatest(
+      R"({"version": "x", "revision": 2, "url": "https://gettarka.com/linux/"})"));
+  EXPECT_FALSE(ParseLatest(
+      R"({"version": "156.0.8078.47", "revision": 0, "url": "https://gettarka.com/linux/"})"));
+}
+
+TEST(TarkLinuxUpdateNotice, OnlyGettarkaPagesOverHttps) {
+  EXPECT_FALSE(ParseLatest(
+      R"({"version": "156.0.8078.47", "revision": 2, "url": "http://gettarka.com/linux/"})"));
+  EXPECT_FALSE(ParseLatest(
+      R"({"version": "156.0.8078.47", "revision": 2, "url": "https://evil.example/"})"));
+  EXPECT_FALSE(ParseLatest(
+      R"({"version": "156.0.8078.47", "revision": 2, "url": "https://gettarka.com.evil.example/"})"));
+}
+
+TEST(TarkLinuxUpdateNotice, OnlyTheTarballChecks) {
+  EXPECT_FALSE(ShouldCheck(base::FilePath("/opt/tark")));
+  EXPECT_TRUE(ShouldCheck(base::FilePath("/home/a/Tark-156.0.8078.47-1-x64-linux")));
+  EXPECT_TRUE(ShouldCheck(base::FilePath("/opt/tark-old")));
+}
+
+}  // namespace
+}  // namespace tark_updater
