+// Tark (L2): Tark's captions engine runs in this process instead of SODA.
+// The browser names ONNX Runtime and the captions models folder in these
+// switches (chrome/browser/speech/chrome_speech_recognition_service.cc).
+constexpr char kTarkCaptionsOrt[] = "tark-captions-ort";
+constexpr char kTarkCaptionsModels[] = "tark-captions-models";
+
+// Loads ONNX Runtime before the sandbox: the engine's later load by the same
+// path finds it loaded. Returns what the sandbox must still let it read: the
+// models folder, and the CPU details ONNX Runtime sizes its threads from.
+std::vector<BrokerFilePermission> TarkCaptionsPreSandbox() {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  std::vector<BrokerFilePermission> permissions;
+  const base::FilePath ort = command_line.GetSwitchValuePath(kTarkCaptionsOrt);
+  if (!ort.empty() &&
+      !dlopen(ort.value().c_str(), RTLD_NOW | RTLD_GLOBAL | RTLD_NODELETE)) {
+    LOG(ERROR) << "Tark captions: ONNX Runtime not loaded from " << ort;
+  }
+  const base::FilePath models =
+      command_line.GetSwitchValuePath(kTarkCaptionsModels);
+  if (!models.empty() && models.IsAbsolute()) {
+    permissions.push_back(BrokerFilePermission::ReadOnlyRecursive(
+        models.AsEndingWithSeparator().value()));
+  }
+  permissions.push_back(BrokerFilePermission::ReadOnly("/proc/cpuinfo"));
+  permissions.push_back(
+      BrokerFilePermission::ReadOnlyRecursive("/sys/devices/system/cpu/"));
+  return permissions;
+}
