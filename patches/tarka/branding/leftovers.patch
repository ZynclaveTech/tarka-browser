 namespace {
 
+// Tark: an internal page's address reads tark://x on error pages, as in the
+// address bar (spec 6.3).
+void TarkShowInternalAddress(std::u16string* text) {
+  static constexpr std::u16string_view kChromePrefix = u"chrome://";
+  if (base::StartsWith(*text, kChromePrefix)) {
+    text->replace(0, kChromePrefix.size(), u"tark://");
+  }
+}
