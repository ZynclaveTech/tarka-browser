 // Static; handles rewriting Web UI URLs.
+// static
+bool ChromeContentBrowserClient::HandleTarkScheme(
+    GURL* url,
+    content::BrowserContext* browser_context) {
+  if (!url->SchemeIs(chrome::kTarkScheme) &&
+      !url->SchemeIs(chrome::kTarkaScheme)) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(content::kChromeUIScheme);
+  GURL chrome_url = url->ReplaceComponents(replacements);
+  // Renderer debug URLs (chrome://crash, kill, hang) must not be rewritten
+  // here: navigation CHECKs that none reaches it. Their tark:// form only
+  // works where the URL fixer maps it first (typed, command line).
+  if (!chrome_url.is_valid() || blink::IsRendererDebugURL(chrome_url)) {
+    return false;
+  }
+  *url = chrome_url;
+  // Let the remaining handlers (NTP, about, WebUI gates) see chrome://.
+  content::BrowserURLHandler::GetInstance()->RewriteURLIfNecessary(
+      url, browser_context);
+  return true;
+}
+
+// static
+bool ChromeContentBrowserClient::HandleTarkSchemeReverse(
+    GURL* url,
+    content::BrowserContext* browser_context) {
+  // The committed chrome:// URL becomes the virtual URL, so the "Tark" chip,
+  // page info and NTP checks see chrome://; display shows tark://.
+  return true;
+}
