  private:
+  // Closing squeezed tabs with the mouse freezes their widths (tab closing
+  // mode) so the next close button lands under the pointer, while the tab
+  // strip's preferred width shrinks by a tab with every close. A well that
+  // followed it would slide the buttons and the address pill under the
+  // pointer, then reflow the whole row as the tabs widen back once the
+  // pointer leaves. So from the first close until the tabs have finished
+  // widening, the well keeps asking for what the tabs asked for at rest:
+  // FlexLayout's offer to the well depends on what the well asks for, so
+  // holding the well's width instead would still let the row shrink it.
+  // Tabs at full width leave closing mode at once; the well follows those
+  // as before. Returns whether the held preferred width changed.
+  bool UpdateHeldWidth() {
+    const std::optional<int> before = held_preferred_;
+    const views::View* region = GetHorizontalTabStrip();
+    if (!region || !tab_strip_) {
+      held_preferred_.reset();
+    } else if (!tab_strip_->InTabClosingMode() &&
+               !tab_strip_->IsAnimatingInTabStrip()) {
+      held_preferred_.reset();
+      resting_preferred_ = region->GetPreferredSize().width();
+    } else if (tab_strip_->InTabClosingMode() && !held_preferred_ &&
+               resting_preferred_ > width()) {
+      held_preferred_ = resting_preferred_;
+    }
+    return held_preferred_ != before;
+  }
