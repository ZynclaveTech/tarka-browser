+// Tark (M3c, spec 6.4): the empty place in the toolbar row where the
+// horizontal tab strip is laid out. It reserves the tab strip's width and
+// counts as caption area (the tab strip, a BrowserView child, sits over it).
+class TarkTabWell : public views::View, public views::ViewObserver {
+  METADATA_HEADER(TarkTabWell, views::View)
+
+ public:
+  explicit TarkTabWell(BrowserView* browser_view)
+      : browser_view_(browser_view) {}
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const views::View* tab_strip = GetHorizontalTabStrip();
+    return gfx::Size(tab_strip ? tab_strip->GetPreferredSize().width() : 0, 0);
+  }
+  gfx::Size GetMinimumSize() const override {
+    const views::View* tab_strip = GetHorizontalTabStrip();
+    return gfx::Size(tab_strip ? tab_strip->GetMinimumSize().width() : 0, 0);
+  }
+  // The well's flex rule, in turn: the tabs get up to kTabsFloor, then the
+  // address pill gets kAddressReserve above its own minimum, then the tabs
+  // take the rest up to the tab strip's preferred width. Never below the tab
+  // strip's minimum.
+  static gfx::Size FlexRule(const views::View* view,
+                            const views::SizeBounds& bounds) {
+    constexpr int kTabsFloor = 200;
+    constexpr int kAddressReserve = 220;
+    const int preferred = view->GetPreferredSize().width();
+    const int minimum = view->GetMinimumSize().width();
+    int width = preferred;
+    if (bounds.width().is_bounded()) {
+      width = std::max(
+          std::min(preferred, bounds.width().value() - kAddressReserve),
+          std::min({preferred, kTabsFloor, bounds.width().value()}));
+    }
+    return gfx::Size(std::max(width, minimum), 0);
+  }
+
+  void AddedToWidget() override {
+    if (views::View* tab_strip = browser_view_->tab_strip_view();
+        tab_strip && !observation_.IsObserving()) {
+      observation_.Observe(tab_strip);
+    }
+  }
+
+  // views::ViewObserver:
+  void OnViewPreferredSizeChanged(views::View* observed_view) override {
+    PreferredSizeChanged();
+  }
+  void OnViewIsDeleting(views::View* observed_view) override {
+    observation_.Reset();
+  }
+
+ private:
+  const views::View* GetHorizontalTabStrip() const {
+    if (!browser_view_->ShouldDrawTabStrip() ||
+        browser_view_->ShouldDrawVerticalTabStrip()) {
+      return nullptr;
+    }
+    return browser_view_->tab_strip_view();
+  }
+
+  raw_ptr<BrowserView> browser_view_;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{this};
+};
