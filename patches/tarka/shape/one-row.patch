+void BrowserViewTabbedLayoutImpl::PlaceTarkTabStripInWell(
+    ProposedLayout* tab_strip_layout,
+    const ProposedLayout& top_container_layout) const {
+  if (!tab_strip_layout) {
+    return;
+  }
+  const auto* const toolbar =
+      views::AsViewClass<ToolbarView>(views().toolbar.get());
+  const auto it = top_container_layout.children.find(views().toolbar);
+  if (!toolbar || it == top_container_layout.children.end() ||
+      it->second.bounds.IsEmpty()) {
+    return;
+  }
+  const gfx::Rect& toolbar_bounds = it->second.bounds;
+  gfx::Rect well = toolbar->GetTarkTabWellBounds(toolbar_bounds.size());
+  // The well has no height of its own (the toolbar centres it), so only its
+  // width says whether there is room for tabs.
+  if (well.width() <= 0) {
+    tab_strip_layout->bounds = gfx::Rect();
+    return;
+  }
+  // Toolbar coordinates → top container → browser view.
+  well.Offset(toolbar_bounds.OffsetFromOrigin());
+  well.Offset(top_container_layout.bounds.OffsetFromOrigin());
+  const int height = std::min(
+      views().horizontal_tab_strip_region_view->GetPreferredSize().height(),
+      toolbar_bounds.height());
+  tab_strip_layout->bounds =
+      gfx::Rect(well.x(), toolbar_bounds.y() +
+                              top_container_layout.bounds.y() +
+                              (toolbar_bounds.height() - height) / 2,
+                well.width(), height);
+}
