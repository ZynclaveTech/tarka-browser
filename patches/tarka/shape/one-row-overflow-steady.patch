--- a/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ b/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -1546,8 +1546,18 @@
   // The space the well (order 1) has with every other item at its minimum
   // (non-flex ones at their preferred size). Safe inside a layout pass: it
   // reads no cached layout and never runs the well's own flex rule.
-  const int offered = layout_manager_->CalculateMainAxisSpaceAvailableToView(
+  int offered = layout_manager_->CalculateMainAxisSpaceAvailableToView(
       tab_well_, 1, views::SizeBounds(width, {}));
+  // The overflow button's room is always kept, shown or not. Otherwise the
+  // row never settles when it is short: without the button the tabs widen,
+  // the address pill narrows and a toolbar button no longer fits, so the
+  // button shows (ToolbarController::ShouldShowOverflowButton()); with it
+  // the tabs narrow and the toolbar button fits again, so it hides, and the
+  // row flips between the two on every layout.
+  if (overflow_button_ && !overflow_button_->GetVisible()) {
+    offered -= GetLayoutConstant(LayoutConstant::kToolbarIconDefaultMargin) +
+               overflow_button_->GetMinimumSize().width();
+  }
   return TarkTabWell::Room(tab_well_, offered);
 }
 
