+// Reversible and visibly not the plain text; can be told to fail.
+class FakeCipher : public TokenCipher {
+ public:
+  std::optional<std::string> Encrypt(std::string_view plain) override {
+    std::string out = "enc:";
+    for (char c : plain) {
+      out.push_back(static_cast<char>(c ^ 0x5a));
+    }
+    return out;
+  }
+  std::optional<std::string> Decrypt(std::string_view cipher) override {
+    if (broken || !cipher.starts_with("enc:")) {
+      return std::nullopt;
+    }
+    std::string out;
+    for (char c : cipher.substr(4)) {
+      out.push_back(static_cast<char>(c ^ 0x5a));
+    }
+    return out;
+  }
+  bool broken = false;
+};
+
+std::string Query(const GURL& url, std::string_view key) {
+  std::string value;
+  return net::GetValueForKeyInQuery(url, key, &value) ? value : "<absent>";
+}
+
+class TarkZynclaveAuth : public testing::Test {
+ protected:
+  TarkZynclaveAuth()
+      : config_{GURL("https://auth.example.test/"), "client-1",
+                "accounts.example.test", false},
+        factory_(base::MakeRefCounted<
+                 network::WeakWrapperSharedURLLoaderFactory>(&loaders_)) {
+    RegisterZynclavePrefs(prefs_.registry());
+    loaders_.AddResponse(issuer_.Url(".well-known/openid-configuration"),
+                         issuer_.DiscoveryJson());
+    loaders_.AddResponse(issuer_.Url(".well-known/jwks.json"),
+                         issuer_.JwksJson());
+    loaders_.AddResponse(
+        issuer_.Url("userinfo"),
+        R"({"sub":"pairwise-sub","name":"Asha Rao","email":"asha@example.test",)"
+        R"("picture":"https://lh3.googleusercontent.com/a/x"})");
+  }
+
+  std::unique_ptr<ZynclaveAuth> MakeAuth(bool cipher_ready = true) {
+    auto auth = std::make_unique<ZynclaveAuth>(
+        config_, &prefs_, factory_,
+        base::BindRepeating(&TarkZynclaveAuth::Opened, base::Unretained(this)));
+    if (cipher_ready) {
+      auth->SetCipher(std::make_unique<FakeCipher>());
+    }
+    return auth;
+  }
+
+  void Opened(const GURL& url) { opened_.push_back(url); }
+
+  // Starts a sign-in and returns the state and nonce it put in the tab.
+  std::pair<std::string, std::string> Start(ZynclaveAuth& auth,
+                                            bool prompt_none = false) {
+    size_t before = opened_.size();
+    auth.StartSignIn(prompt_none);
+    task_env_.RunUntilIdle();
+    EXPECT_EQ(opened_.size(), before + 1);
+    const GURL& url = opened_.back();
+    return {Query(url, "state"), Query(url, "nonce")};
+  }
+
+  GURL Redirect(std::string_view query) {
+    return GURL(base::StrCat({kRedirectUri, "?", query}));
+  }
+
+  void SignIn(ZynclaveAuth& auth,
+              std::string_view access = "access-1",
+              std::string_view refresh = "refresh-1",
+              int expires_in = 3600) {
+    auto [state, nonce] = Start(auth);
+    ASSERT_TRUE(auth.HandleRedirect(
+        Redirect(base::StrCat({"code=c0de&state=", state}))));
+    task_env_.RunUntilIdle();
+    ASSERT_TRUE(loaders_.SimulateResponseForPendingRequest(
+        issuer_.Url("oauth2/token"),
+        test::FakeIssuer::TokenJson(
+            access, refresh,
+            issuer_.IdToken("client-1", nonce, base::Time::Now()),
+            expires_in)));
+    task_env_.RunUntilIdle();
+    ASSERT_EQ(auth.state(), ZynclaveState::kSignedIn);
+  }
+
+  int TokenRequests() {
+    int count = 0;
+    for (const auto& request : *loaders_.pending_requests()) {
+      if (request.request.url == GURL(issuer_.Url("oauth2/token"))) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  base::test::TaskEnvironment task_env_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  ZynclaveConfig config_;
+  test::FakeIssuer issuer_;
+  TestingPrefServiceSimple prefs_;
+  network::TestURLLoaderFactory loaders_;
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  std::vector<GURL> opened_;
+};
