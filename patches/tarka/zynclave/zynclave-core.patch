+TEST_F(TarkZynclaveAuth, AStateIsUsedOnce) {
+  auto auth = MakeAuth();
+  SignIn(*auth);
+  // The same redirect again (a reload, a replay) is not ours any more.
+  EXPECT_FALSE(auth->HandleRedirect(Redirect("code=c0de&state=x")));
+}
