+TEST_F(TarkZynclaveAuth, SignInExchangesCodeAndStoresEncrypted) {
+  auto auth = MakeAuth();
+  EXPECT_EQ(auth->state(), ZynclaveState::kSignedOut);
+  SignIn(*auth);
+  ASSERT_TRUE(auth->account());
+  EXPECT_EQ(auth->account()->sub, "pairwise-sub");
+  EXPECT_EQ(auth->account()->name, "Asha Rao");
+  const std::string stored = prefs_.GetString(kTokensPref);
+  EXPECT_FALSE(stored.empty());
+  EXPECT_EQ(stored.find("refresh-1"), std::string::npos);
+  EXPECT_EQ(stored.find("access-1"), std::string::npos);
+
+  // A new start (relaunch) reads the account back.
+  auto again = MakeAuth();
+  EXPECT_EQ(again->state(), ZynclaveState::kSignedIn);
+  base::test::TestFuture<std::optional<std::string>> token;
+  again->GetAccessToken(token.GetCallback());
+  EXPECT_EQ(token.Get(), "access-1");
+}
+
+TEST_F(TarkZynclaveAuth, TheTokenRequestHasPkceAndNoSecret) {
+  auto auth = MakeAuth();
+  auto [state, nonce] = Start(*auth);
+  ASSERT_TRUE(auth->HandleRedirect(Redirect("code=c0de&state=" + state)));
+  task_env_.RunUntilIdle();
+  ASSERT_EQ(TokenRequests(), 1);
+  const network::ResourceRequest& request =
+      loaders_.pending_requests()->back().request;
+  EXPECT_EQ(request.method, "POST");
+  EXPECT_EQ(request.credentials_mode, network::mojom::CredentialsMode::kOmit);
+  std::string body(request.request_body->elements()
+                       ->at(0)
+                       .As<network::DataElementBytes>()
+                       .AsStringPiece());
+  EXPECT_NE(body.find("grant_type=authorization_code"), std::string::npos);
+  EXPECT_NE(body.find("code_verifier="), std::string::npos);
+  EXPECT_NE(body.find("client_id=client-1"), std::string::npos);
+  EXPECT_EQ(body.find("client_secret"), std::string::npos);
+}
+
+TEST_F(TarkZynclaveAuth, UnknownStateIsIgnored) {
+  auto auth = MakeAuth();
+  Start(*auth);
+  EXPECT_FALSE(auth->HandleRedirect(Redirect("code=x&state=not-ours")));
+  EXPECT_FALSE(auth->HandleRedirect(Redirect("code=x")));
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(TokenRequests(), 0);
+  EXPECT_NE(auth->state(), ZynclaveState::kSignedIn);
+}
