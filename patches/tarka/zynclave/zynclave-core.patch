+namespace tark_zynclave {
+
+// Catches com.gettarka.tarka:/oauth2redirect in any tab, as a link or as a
+// redirect from Zynclave. It is always cancelled, so it never reaches the
+// operating system's handler or the history. In a normal profile's main
+// frame it is handed to that profile's sign-in, which takes it only if its
+// state is one it is waiting for; then the tab closes.
+class ZynclaveRedirectThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit ZynclaveRedirectThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~ZynclaveRedirectThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Check();
+};
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_REDIRECT_THROTTLE_H_
