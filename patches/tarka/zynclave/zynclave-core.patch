+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_OIDC_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_OIDC_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+namespace tark_zynclave {
+
+struct ZynclaveConfig;
+
+// The issuer's endpoints, from <issuer>.well-known/openid-configuration.
+struct Discovery {
+  std::string issuer;
+  GURL authorization;
+  GURL token;
+  GURL userinfo;
+  GURL revocation;
+  GURL end_session;
+  GURL jwks;
+};
+
+// Every endpoint must be https on the issuer's own host, and the document's
+// issuer must be `issuer`.
+std::optional<Discovery> ParseDiscovery(std::string_view json,
+                                        const GURL& issuer);
+
+// One sign-in attempt, kept in memory only.
+struct PendingRequest {
+  std::string state;     // 32 random bytes, base64url
+  std::string nonce;     // 32 random bytes, base64url
+  std::string verifier;  // PKCE code verifier, 32 random bytes, base64url
+  base::Time created;
+  bool prompt_none = false;
+};
+
+PendingRequest NewRequest(bool prompt_none);
+
+// PKCE S256: base64url(SHA-256(verifier)), no padding.
+std::string S256Challenge(std::string_view verifier);
+
+GURL AuthorizationUrl(const Discovery& discovery,
+                      const ZynclaveConfig& config,
+                      const PendingRequest& request);
+
+// application/x-www-form-urlencoded bodies for the token endpoint.
+std::string TokenRequestBody(const ZynclaveConfig& config,
+                             std::string_view code,
+                             std::string_view verifier);
+std::string RefreshRequestBody(const ZynclaveConfig& config,
+                               std::string_view refresh_token);
+std::string RevokeRequestBody(const ZynclaveConfig& config,
+                              std::string_view refresh_token);
+
+// The token endpoint's answer. `error` is the OAuth error code
+// ("invalid_grant", ...), or "malformed" for a body that is not a token
+// response; empty on success.
+struct TokenResponse {
+  std::string access;
+  std::string refresh;
+  std::string id_token;
+  base::TimeDelta expires_in;
+  std::string error;
+};
+
+TokenResponse ParseTokenResponse(std::string_view json);
+
+struct IdClaims {
+  std::string sub;
+  std::string email;
+};
+
+// Checks an ID token: RS256 only, signed by the JWKS key its header names,
+// iss is the issuer, aud is (or contains) the client ID, exp and iat hold
+// (60 s leeway), and nonce matches. nullopt on any failure.
+std::optional<IdClaims> VerifyIdToken(std::string_view jwt,
+                                      std::string_view jwks_json,
+                                      const ZynclaveConfig& config,
+                                      std::string_view nonce,
+                                      base::Time now);
+
+// The account as userinfo describes it. Name and email are cleaned (no
+// bidirectional or control characters) and capped at 40 and 64 characters.
+struct Userinfo {
+  std::string sub;
+  std::string name;
+  std::string email;
+  GURL picture;
+};
+
+std::optional<Userinfo> ParseUserinfo(std::string_view json);
+
+// Only the Zynclave avatar CDN (*.zynclave.com) and Google's lh3-lh6.
+bool AllowedAvatarUrl(const GURL& url);
+
+// com.gettarka.tarka:/oauth2redirect, with any query.
+bool IsRedirectUrl(const GURL& url);
+
+// Display text with bidirectional and control characters removed and
+// whitespace collapsed, at most `max_chars` characters.
+std::string CleanDisplayText(std::string_view text, size_t max_chars);
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_OIDC_H_
