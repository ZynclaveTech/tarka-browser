+void CloseTab(base::WeakPtr<content::WebContents> contents) {
+  if (contents) {
+    contents->ClosePage();
+  }
+}
+
+}  // namespace
+
+// static
+void ZynclaveRedirectThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  registry.AddThrottle(std::make_unique<ZynclaveRedirectThrottle>(registry));
+}
+
+ZynclaveRedirectThrottle::ZynclaveRedirectThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+ZynclaveRedirectThrottle::~ZynclaveRedirectThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+ZynclaveRedirectThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+ZynclaveRedirectThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+const char* ZynclaveRedirectThrottle::GetNameForLogging() {
+  return "ZynclaveRedirectThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+ZynclaveRedirectThrottle::Check() {
+  content::NavigationHandle* handle = navigation_handle();
+  if (!IsRedirectUrl(handle->GetURL())) {
+    return PROCEED;
+  }
+  content::WebContents* contents = handle->GetWebContents();
+  Profile* profile =
+      contents ? Profile::FromBrowserContext(contents->GetBrowserContext())
+               : nullptr;
+  // Incognito and Guest have no service; other frames are never ours.
+  ZynclaveSignInService* service =
+      profile && handle->IsInPrimaryMainFrame()
+          ? ZynclaveSignInServiceFactory::GetForProfile(profile)
+          : nullptr;
+  if (service && service->allowed() &&
+      service->auth().HandleRedirect(handle->GetURL())) {
+    // The sign-in tab has done its job.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&CloseTab, contents->GetWeakPtr()));
+  }
+  return CANCEL_AND_IGNORE;
+}
+
+}  // namespace tark_zynclave
