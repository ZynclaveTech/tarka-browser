+# Copyright 2026 The Tark Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Sign in with Zynclave on the desktop. The OIDC checks, the configuration
+# and the whoami parser have no browser dependencies, so their unit tests
+# build and run on their own (utils/zynclave_tests.sh).
+
+import("//build/buildflag_header.gni")
+import("//testing/test.gni")
+
+declare_args() {
+  # Use Zynclave's staging issuer and clients (dev.sh sets it; published
+  # builds never do).
+  tark_zynclave_staging = false
+}
+
+buildflag_header("buildflags") {
+  header = "buildflags.h"
+  flags = [ "TARK_ZYNCLAVE_STAGING=$tark_zynclave_staging" ]
+}
+
+static_library("oidc") {
+  sources = [
+    "oidc.cc",
+    "oidc.h",
+    "whoami_response.cc",
+    "whoami_response.h",
+    "zynclave_config.cc",
+    "zynclave_config.h",
+  ]
+  public_deps = [
+    ":buildflags",
+    "//base",
+    "//url",
+  ]
+  deps = [
+    "//crypto",
+    "//net",
+  ]
+}
+
+# The sign-in itself: discovery, the code exchange, token storage and
+# refresh, sign-out. The browser side (ZynclaveSignInService) gives it the
+# network, the encryption and the tab to open.
+static_library("auth") {
+  sources = [
+    "token_cipher.h",
+    "zynclave_auth.cc",
+    "zynclave_auth.h",
+    "zynclave_prefs.cc",
+    "zynclave_prefs.h",
+  ]
+  public_deps = [
+    ":oidc",
+    "//base",
+    "//components/prefs",
+    "//services/network/public/cpp",
+  ]
+  deps = [ "//net" ]
+}
+
+source_set("test_util") {
+  testonly = true
+  sources = [
+    "oidc_test_util.cc",
+    "oidc_test_util.h",
+  ]
+  deps = [
+    "//base",
+    "//crypto",
+  ]
+}
+
+test("tark_zynclave_unittests") {
+  sources = [
+    "oidc_unittest.cc",
+    "whoami_response_unittest.cc",
+    "zynclave_auth_unittest.cc",
+  ]
+  deps = [
+    ":auth",
+    ":oidc",
+    ":test_util",
+    "//base",
+    "//base/test:test_support",
+    "//components/prefs:test_support",
+    "//mojo/core/test:run_all_unittests",
+    "//services/network:test_support",
+    "//crypto",
+    "//net",
+    "//testing/gtest",
+    "//url",
+  ]
+}
