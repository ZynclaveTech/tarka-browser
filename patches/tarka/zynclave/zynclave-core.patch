+
+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_RESPONSE_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_RESPONSE_H_
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+
+namespace tark_zynclave {
+
+// The largest whoami body read; a bigger one is not a session.
+inline constexpr size_t kMaxWhoamiBytes = 64 * 1024;
+
+// What "Sign in to Tark as X?" needs from the Zynclave Account's web session:
+// the identity id (only ever hashed, for "No thanks") and the name and email
+// (only shown on the sheet). Nothing here is stored or logged.
+struct WhoamiResult {
+  bool signed_in = false;
+  std::string id;
+  std::string name;
+  std::string email;
+};
+
+// Reads a 200 response of GET /sessions/whoami (Ory Kratos): an active session
+// with identity.id, and identity.traits.name (a string, or first and last) and
+// identity.traits.email when present. Anything else is not signed in.
+WhoamiResult ParseWhoami(std::string_view body);
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_RESPONSE_H_
