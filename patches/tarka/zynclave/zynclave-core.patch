+  EXPECT_NE(a.state, b.state);
+  EXPECT_NE(a.nonce, b.nonce);
+  EXPECT_NE(a.verifier, b.verifier);
+  // 32 random bytes, base64url without padding.
+  EXPECT_EQ(a.state.size(), 43u);
+  EXPECT_EQ(a.verifier.size(), 43u);
+}
