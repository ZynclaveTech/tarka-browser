+namespace tark_zynclave {
+
+namespace {
+
+std::string NameFrom(const base::DictValue& traits) {
+  if (const std::string* name = traits.FindString("name")) {
+    return *name;
+  }
+  const base::DictValue* parts = traits.FindDict("name");
+  if (!parts) {
+    return std::string();
+  }
+  const std::string* first = parts->FindString("first");
+  const std::string* last = parts->FindString("last");
+  std::string name = first ? *first : std::string();
+  if (last && !last->empty()) {
+    if (!name.empty()) {
+      name += " ";
+    }
+    name += *last;
+  }
+  return name;
+}
+
+}  // namespace
+
+WhoamiResult ParseWhoami(std::string_view body) {
+  WhoamiResult result;
+  if (body.size() > kMaxWhoamiBytes) {
+    return result;
+  }
+  std::optional<base::DictValue> session =
+      base::JSONReader::ReadDict(body, base::JSON_PARSE_RFC);
+  if (!session) {
+    return result;
+  }
+  // Kratos answers 401 for no session; an inactive one is not a session
+  // either.
+  const std::optional<bool> active = session->FindBool("active");
+  if (active.has_value() && !*active) {
+    return result;
+  }
+  const base::DictValue* identity = session->FindDict("identity");
+  const std::string* id = identity ? identity->FindString("id") : nullptr;
+  if (!id || id->empty()) {
+    return result;
+  }
+  result.signed_in = true;
+  result.id = *id;
+  if (const base::DictValue* traits = identity->FindDict("traits")) {
+    result.name = std::string(base::TrimWhitespaceASCII(NameFrom(*traits),
+                                                        base::TRIM_ALL));
+    if (const std::string* email = traits->FindString("email")) {
+      result.email = *email;
+    }
+  }
+  return result;
+}
+
+}  // namespace tark_zynclave
