+// ID tokens signed with keys made here.
+class TarkZynclaveIdToken : public testing::Test {
+ protected:
+  TarkZynclaveIdToken()
+      : key_a_(crypto::keypair::PrivateKey::GenerateRsa2048()),
+        key_b_(crypto::keypair::PrivateKey::GenerateRsa2048()),
+        now_(base::Time::FromSecondsSinceUnixEpoch(1'800'000'000)) {}
+
+  static base::DictValue Jwk(const crypto::keypair::PrivateKey& key,
+                             std::string_view kid) {
+    crypto::keypair::PublicKey pub =
+        crypto::keypair::PublicKey::FromPrivateKey(key);
+    base::DictValue jwk;
+    jwk.Set("kty", "RSA");
+    jwk.Set("alg", "RS256");
+    jwk.Set("use", "sig");
+    jwk.Set("kid", kid);
+    jwk.Set("n", B64(pub.GetRsaModulus()));
+    jwk.Set("e", B64(pub.GetRsaExponent()));
+    return jwk;
+  }
+
+  std::string Jwks() const {
+    base::ListValue keys;
+    keys.Append(Jwk(key_a_, "a"));
+    keys.Append(Jwk(key_b_, "b"));
+    base::DictValue jwks;
+    jwks.Set("keys", std::move(keys));
+    return Json(jwks);
+  }
+
+  base::DictValue Claims() const {
+    base::DictValue c;
+    c.Set("iss", "https://auth.example.test/");
+    c.Set("aud", "client-1");
+    c.Set("sub", "pairwise-sub");
+    c.Set("email", "asha@example.test");
+    c.Set("nonce", "n0nce");
+    c.Set("iat", static_cast<double>(now_.InSecondsFSinceUnixEpoch() - 5));
+    c.Set("exp", static_cast<double>(now_.InSecondsFSinceUnixEpoch() + 600));
+    return c;
+  }
+
+  std::string Sign(const base::DictValue& claims,
+                   std::string_view kid = "a",
+                   std::string_view alg = "RS256") const {
+    base::DictValue header;
+    header.Set("alg", alg);
+    header.Set("kid", kid);
+    header.Set("typ", "JWT");
+    std::string input = base::StrCat({B64(Json(header)), ".", B64(Json(claims))});
+    const crypto::keypair::PrivateKey& key = kid == "b" ? key_b_ : key_a_;
+    std::vector<uint8_t> sig = crypto::sign::Sign(
+        crypto::sign::RSA_PKCS1_SHA256, key, base::as_byte_span(input));
+    return base::StrCat({input, ".", B64(sig)});
+  }
+
+  std::optional<IdClaims> Verify(std::string_view jwt) const {
+    return VerifyIdToken(jwt, Jwks(), TestConfig(), "n0nce", now_);
+  }
+
+  crypto::keypair::PrivateKey key_a_;
+  crypto::keypair::PrivateKey key_b_;
+  base::Time now_;
+};
+
+TEST_F(TarkZynclaveIdToken, AcceptsValid) {
+  std::optional<IdClaims> claims = Verify(Sign(Claims()));
+  ASSERT_TRUE(claims);
+  EXPECT_EQ(claims->sub, "pairwise-sub");
+  EXPECT_EQ(claims->email, "asha@example.test");
+}
+
+TEST_F(TarkZynclaveIdToken, AcceptsAudienceList) {
+  base::DictValue c = Claims();
+  base::ListValue aud;
+  aud.Append("other");
+  aud.Append("client-1");
+  c.Set("aud", std::move(aud));
+  EXPECT_TRUE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsWrongAud) {
+  base::DictValue c = Claims();
+  c.Set("aud", "client-2");
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsWrongIss) {
+  base::DictValue c = Claims();
+  c.Set("iss", "https://auth.other.test/");
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsWrongNonce) {
+  base::DictValue c = Claims();
+  c.Set("nonce", "other");
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsExpired) {
+  base::DictValue c = Claims();
+  c.Set("exp", static_cast<double>(now_.InSecondsFSinceUnixEpoch() - 61));
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsIssuedInTheFuture) {
+  base::DictValue c = Claims();
+  c.Set("iat", static_cast<double>(now_.InSecondsFSinceUnixEpoch() + 120));
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsUnknownKid) {
+  EXPECT_FALSE(Verify(Sign(Claims(), "c")));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsWrongKeyForKid) {
+  // Signed with key a, but the header names key b.
+  std::string jwt = Sign(Claims(), "a");
+  std::string header_b = B64(R"({"alg":"RS256","kid":"b","typ":"JWT"})");
+  std::string swapped = header_b + jwt.substr(jwt.find('.'));
+  EXPECT_FALSE(Verify(swapped));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsAlgNone) {
+  std::string jwt = Sign(Claims());
+  std::string header = B64(R"({"alg":"none","kid":"a"})");
+  std::string body = jwt.substr(jwt.find('.'), jwt.rfind('.') - jwt.find('.'));
+  EXPECT_FALSE(Verify(header + body + "."));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsHs256) {
+  EXPECT_FALSE(Verify(Sign(Claims(), "a", "HS256")));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsTamperedClaims) {
+  std::string jwt = Sign(Claims());
+  base::DictValue c = Claims();
+  c.Set("sub", "someone-else");
+  size_t first = jwt.find('.');
+  size_t last = jwt.rfind('.');
+  std::string tampered =
+      jwt.substr(0, first + 1) + B64(Json(c)) + jwt.substr(last);
+  EXPECT_FALSE(Verify(tampered));
+}
+
+TEST_F(TarkZynclaveIdToken, PicksKeyByKidDuringRotation) {
+  EXPECT_TRUE(Verify(Sign(Claims(), "b")));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsGarbage) {
+  EXPECT_FALSE(Verify(""));
+  EXPECT_FALSE(Verify("a.b"));
+  EXPECT_FALSE(Verify("a.b.c.d"));
+  EXPECT_FALSE(VerifyIdToken(Sign(Claims()), "{}", TestConfig(), "n0nce", now_));
+}
+
+TEST(TarkZynclaveOidc, UserinfoReadsAccount) {
