+std::string B64(base::span<const uint8_t> bytes) {
+  std::string out;
+  base::Base64UrlEncode(bytes, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &out);
+  return out;
+}
+
+std::string B64(std::string_view text) {
+  return B64(base::as_byte_span(text));
+}
+
+std::string Json(const base::DictValue& dict) {
+  return base::WriteJson(dict).value();
+}
+
+ZynclaveConfig TestConfig() {
+  return ZynclaveConfig{GURL("https://auth.example.test/"), "client-1",
+                        "accounts.example.test", false};
+}
+
+Discovery TestDiscovery() {
+  Discovery d;
+  d.issuer = "https://auth.example.test/";
+  d.authorization = GURL("https://auth.example.test/oauth2/auth");
+  d.token = GURL("https://auth.example.test/oauth2/token");
+  d.userinfo = GURL("https://auth.example.test/userinfo");
+  d.revocation = GURL("https://auth.example.test/oauth2/revoke");
+  d.end_session = GURL("https://auth.example.test/oauth2/sessions/logout");
+  d.jwks = GURL("https://auth.example.test/.well-known/jwks.json");
+  return d;
+}
+
+std::string Query(const GURL& url, std::string_view key) {
+  std::string value;
+  return net::GetValueForKeyInQuery(url, key, &value) ? value : "<absent>";
+}
+
+TEST(TarkZynclaveOidc, AuthorizationUrlHasEveryParameter) {
+  PendingRequest request = NewRequest(/*prompt_none=*/false);
+  GURL url = AuthorizationUrl(TestDiscovery(), TestConfig(), request);
+  EXPECT_EQ(url.GetWithEmptyPath(), GURL("https://auth.example.test/"));
+  EXPECT_EQ(url.path(), "/oauth2/auth");
+  EXPECT_EQ(Query(url, "response_type"), "code");
+  EXPECT_EQ(Query(url, "client_id"), "client-1");
+  EXPECT_EQ(Query(url, "redirect_uri"), "com.gettarka.tarka:/oauth2redirect");
+  EXPECT_EQ(Query(url, "scope"), "openid profile email offline_access");
+  EXPECT_EQ(Query(url, "state"), request.state);
+  EXPECT_EQ(Query(url, "nonce"), request.nonce);
+  EXPECT_EQ(Query(url, "code_challenge"), S256Challenge(request.verifier));
+  EXPECT_EQ(Query(url, "code_challenge_method"), "S256");
+  EXPECT_EQ(Query(url, "prompt"), "<absent>");
+
+  GURL silent =
+      AuthorizationUrl(TestDiscovery(), TestConfig(), NewRequest(true));
+  EXPECT_EQ(Query(silent, "prompt"), "none");
+}
