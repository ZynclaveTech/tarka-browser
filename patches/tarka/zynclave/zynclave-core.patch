+
+namespace tark_zynclave {
+namespace {
+
+std::string B64(base::span<const uint8_t> bytes) {
+  std::string out;
+  base::Base64UrlEncode(bytes, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &out);
+  return out;
+}
+
+std::string B64(std::string_view text) {
+  return B64(base::as_byte_span(text));
+}
+
+std::string Json(const base::DictValue& dict) {
+  return base::WriteJson(dict).value();
+}
+
+ZynclaveConfig TestConfig() {
+  return ZynclaveConfig{GURL("https://auth.example.test/"), "client-1",
+                        "accounts.example.test", false};
+}
+
+Discovery TestDiscovery() {
+  Discovery d;
+  d.issuer = "https://auth.example.test/";
+  d.authorization = GURL("https://auth.example.test/oauth2/auth");
+  d.token = GURL("https://auth.example.test/oauth2/token");
+  d.userinfo = GURL("https://auth.example.test/userinfo");
+  d.revocation = GURL("https://auth.example.test/oauth2/revoke");
+  d.end_session = GURL("https://auth.example.test/oauth2/sessions/logout");
+  d.jwks = GURL("https://auth.example.test/.well-known/jwks.json");
+  return d;
+}
