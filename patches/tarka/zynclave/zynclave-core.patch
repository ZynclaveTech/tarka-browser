+TEST_F(TarkZynclaveAuth, ExpiredPendingStateIsIgnored) {
+  auto auth = MakeAuth();
+  auto [state, nonce] = Start(*auth);
+  task_env_.FastForwardBy(base::Minutes(10) + base::Seconds(1));
+  EXPECT_FALSE(auth->HandleRedirect(Redirect("code=x&state=" + state)));
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(TokenRequests(), 0);
+  EXPECT_EQ(auth->state(), ZynclaveState::kSignedOut);
+}
