+
+namespace tark_zynclave {
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_zynclave", R"(
+      semantics {
+        sender: "Sign in with Zynclave"
+        description:
+          "Signs the person in to Tark with their Zynclave Account: reads "
+          "Zynclave's OpenID configuration and signing keys, exchanges the "
+          "sign-in code for tokens, refreshes them, reads the account's name, "
+          "email and photo address, and revokes the tokens on sign-out."
+        trigger:
+          "Only after the person chooses to sign in, while they are signed "
+          "in and something needs the account, and when they sign out."
+        data:
+          "The OAuth client ID, the sign-in code and PKCE verifier, and the "
+          "refresh or access token. No cookies."
+        destination: OTHER
+        destination_other: "auth.zynclave.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > Profile > Sign out."
+        chrome_policy {
+          ZynclaveSignInAllowed {
+            ZynclaveSignInAllowed: false
+          }
+        }
+      })");
+
+constexpr base::TimeDelta kTimeout = base::Seconds(10);
+constexpr size_t kMaxBody = 64 * 1024;
+constexpr size_t kMaxJwks = 1024 * 1024;
+
+// Logged as the error type only, never with a token, code or account.
+void LogError(std::string_view what) {
+  VLOG(1) << "tark_zynclave: " << what;
+}
+
+}  // namespace
+
+struct ZynclaveAuth::InFlight {
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  BodyCallback callback;
+};
+
+ZynclaveAuth::ZynclaveAuth(
+    const ZynclaveConfig& config,
+    PrefService* prefs,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loaders,
+    OpenUrlCallback open_url)
+    : config_(config),
+      prefs_(prefs),
+      url_loaders_(std::move(url_loaders)),
+      open_url_(std::move(open_url)) {
+  LoadAccount();
+}
+
+ZynclaveAuth::~ZynclaveAuth() = default;
+
+void ZynclaveAuth::SetCipher(std::unique_ptr<TokenCipher> cipher) {
+  cipher_ = std::move(cipher);
+  if (tokens_) {
+    // Signed in before the cipher was ready: store now.
+    SaveTokens();
+  } else {
+    LoadTokens();
+  }
+  ServeTokenRequests();
+}
+
+base::CallbackListSubscription ZynclaveAuth::AddObserver(
+    base::RepeatingClosure observer) {
+  return observers_.Add(std::move(observer));
+}
+
+// Network.
+
+void ZynclaveAuth::Fetch(const GURL& url,
+                         std::optional<std::string> post_body,
+                         size_t max_bytes,
+                         BodyCallback callback) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = post_body ? "POST" : "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
+                             "application/json");
+  if (url == (discovery_ ? discovery_->userinfo : GURL()) && tokens_) {
+    request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
+                               base::StrCat({"Bearer ", tokens_->access}));
+  }
+  auto in_flight = std::make_unique<InFlight>();
+  in_flight->loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  if (post_body) {
+    in_flight->loader->AttachStringForUpload(
+        *post_body, "application/x-www-form-urlencoded");
+  }
+  in_flight->loader->SetTimeoutDuration(kTimeout);
+  in_flight->loader->SetAllowHttpErrorResults(true);
+  in_flight->callback = std::move(callback);
+  network::SimpleURLLoader* loader = in_flight->loader.get();
+  fetches_.push_front(std::move(in_flight));
+  loader->DownloadToString(
+      url_loaders_.get(),
+      base::BindOnce(&ZynclaveAuth::OnFetched, weak_factory_.GetWeakPtr(),
+                     fetches_.begin()),
+      max_bytes);
+}
+
+void ZynclaveAuth::OnFetched(std::list<std::unique_ptr<InFlight>>::iterator it,
+                             std::optional<std::string> body) {
+  std::unique_ptr<InFlight> done = std::move(*it);
+  fetches_.erase(it);
+  int status = 0;
+  if (done->loader->ResponseInfo() && done->loader->ResponseInfo()->headers) {
+    status = done->loader->ResponseInfo()->headers->response_code();
+  }
+  std::move(done->callback).Run(std::move(body), status);
+}
+
+void ZynclaveAuth::WithDiscovery(base::OnceCallback<void(bool ok)> callback) {
+  if (discovery_) {
+    std::move(callback).Run(true);
+    return;
+  }
+  discovery_waiters_.push_back(std::move(callback));
+  if (discovery_waiters_.size() > 1) {
+    return;
+  }
+  Fetch(config_.issuer.Resolve(".well-known/openid-configuration"),
+        std::nullopt, kMaxBody,
+        base::BindOnce(&ZynclaveAuth::OnDiscovery, weak_factory_.GetWeakPtr()));
+}
+
+void ZynclaveAuth::OnDiscovery(std::optional<std::string> body, int status) {
+  if (body && status == 200) {
+    discovery_ = ParseDiscovery(*body, config_.issuer);
+  }
+  if (!discovery_) {
+    LogError("discovery failed");
+  }
+  std::vector<base::OnceCallback<void(bool)>> waiters;
+  waiters.swap(discovery_waiters_);
+  for (auto& waiter : waiters) {
+    std::move(waiter).Run(discovery_.has_value());
+  }
+}
+
+// Sign-in.
+
+void ZynclaveAuth::StartSignIn(bool prompt_none, std::string expected_email) {
+  const base::Time now = base::Time::Now();
+  std::erase_if(pending_, [now](const auto& entry) {
+    return now - entry.second.first.created > kRequestLifetime;
+  });
+  WithDiscovery(base::BindOnce(&ZynclaveAuth::OpenSignInPage,
+                               weak_factory_.GetWeakPtr(), prompt_none,
+                               std::move(expected_email)));
+}
+
+void ZynclaveAuth::OpenSignInPage(bool prompt_none,
+                                  std::string expected_email,
+                                  bool ok) {
+  if (!ok) {
+    return;
+  }
+  PendingRequest request = NewRequest(prompt_none);
+  GURL url = AuthorizationUrl(*discovery_, config_, request);
+  std::string state = request.state;
+  pending_[state] = {std::move(request), std::move(expected_email)};
+  open_url_.Run(url);
+}
+
+bool ZynclaveAuth::HandleRedirect(const GURL& url) {
+  if (!IsRedirectUrl(url)) {
+    return false;
+  }
+  std::string state;
+  if (!net::GetValueForKeyInQuery(url, "state", &state)) {
+    return false;
+  }
+  auto it = pending_.find(state);
+  if (it == pending_.end()) {
+    return false;
+  }
+  auto [request, expected_email] = std::move(it->second);
+  pending_.erase(it);
+  if (base::Time::Now() - request.created > kRequestLifetime) {
+    return false;
+  }
+
+  std::string error;
+  if (net::GetValueForKeyInQuery(url, "error", &error)) {
+    if (request.prompt_none &&
+        (error == "login_required" || error == "interaction_required" ||
+         error == "consent_required" ||
+         error == "account_selection_required")) {
+      // Zynclave needs a screen after all: once more, with one.
+      StartSignIn(/*prompt_none=*/false, std::move(expected_email));
+    } else if (error != "access_denied") {
+      LogError("authorization error");
+    }
+    return true;
+  }
+  std::string code;
+  if (!net::GetValueForKeyInQuery(url, "code", &code) || code.empty()) {
+    return true;
+  }
+  OnCode(std::move(request), std::move(expected_email), std::move(code));
+  return true;
+}
+
+void ZynclaveAuth::OnCode(PendingRequest request,
+                          std::string expected_email,
+                          std::string code) {
+  state_before_exchange_ =
+      state_ == ZynclaveState::kSigningIn ? state_before_exchange_ : state_;
+  SetState(ZynclaveState::kSigningIn);
+  const std::string body = TokenRequestBody(config_, code, request.verifier);
+  Fetch(discovery_->token, body, kMaxBody,
+        base::BindOnce(&ZynclaveAuth::OnTokens, weak_factory_.GetWeakPtr(),
+                       std::move(request), std::move(expected_email)));
+}
+
+void ZynclaveAuth::OnTokens(PendingRequest request,
+                            std::string expected_email,
+                            std::optional<std::string> body,
+                            int status) {
+  TokenResponse tokens =
+      body ? ParseTokenResponse(*body) : TokenResponse{.error = "network"};
+  if (!tokens.error.empty() || tokens.refresh.empty() ||
+      tokens.id_token.empty()) {
+    LogError("code exchange failed");
+    SignInFailed();
+    return;
+  }
+  Fetch(discovery_->jwks, std::nullopt, kMaxJwks,
+        base::BindOnce(&ZynclaveAuth::OnJwks, weak_factory_.GetWeakPtr(),
+                       std::move(request), std::move(expected_email),
+                       std::move(tokens)));
+}
+
+void ZynclaveAuth::OnJwks(PendingRequest request,
+                          std::string expected_email,
+                          TokenResponse tokens,
+                          std::optional<std::string> body,
+                          int status) {
+  const base::Time now = base::Time::Now();
+  std::optional<IdClaims> claims;
+  if (body && status == 200) {
+    claims =
+        VerifyIdToken(tokens.id_token, *body, config_, request.nonce, now);
+  }
+  if (!claims) {
+    LogError("ID token refused");
+    Revoke(tokens.refresh);
+    SignInFailed();
+    return;
+  }
+  Tokens kept{tokens.access, tokens.refresh, now + tokens.expires_in};
+  // userinfo needs the new access token; hold it until the account is read.
+  std::optional<Tokens> previous = std::move(tokens_);
+  tokens_ = kept;
+  Fetch(discovery_->userinfo, std::nullopt, kMaxBody,
+        base::BindOnce(&ZynclaveAuth::OnUserinfo, weak_factory_.GetWeakPtr(),
+                       std::move(expected_email), std::move(*claims),
+                       std::move(kept)));
+  tokens_ = std::move(previous);
+}
+
+void ZynclaveAuth::OnUserinfo(std::string expected_email,
+                              IdClaims claims,
+                              Tokens tokens,
+                              std::optional<std::string> body,
+                              int status) {
+  std::optional<Userinfo> info;
+  if (body && status == 200) {
+    info = ParseUserinfo(*body);
+  }
+  if (!info || info->sub != claims.sub) {
+    LogError("userinfo failed");
+    Revoke(tokens.refresh);
+    SignInFailed();
+    return;
+  }
+  if (!expected_email.empty() &&
+      !base::EqualsCaseInsensitiveASCII(info->email, expected_email)) {
+    // Not the account the person said yes to on "Sign in to Tark as X?".
+    LogError("account changed during sign-in");
+    Revoke(tokens.refresh);
+    SignInFailed();
+    return;
+  }
+  account_ = std::move(*info);
+  tokens_ = std::move(tokens);
+  SaveAccount();
+  SaveTokens();
+  SetState(ZynclaveState::kSignedIn);
+  ServeTokenRequests();
+}
+
+void ZynclaveAuth::SignInFailed() {
+  SetState(state_before_exchange_);
+}
+
+// Tokens.
+
+void ZynclaveAuth::GetAccessToken(TokenCallback callback) {
+  if (state_ != ZynclaveState::kSignedIn) {
+    std::move(callback).Run(std::nullopt);
+    return;
+  }
+  token_waiters_.push_back(std::move(callback));
+  ServeTokenRequests();
+}
+
+void ZynclaveAuth::ServeTokenRequests() {
+  if (token_waiters_.empty() || refreshing_) {
+    return;
+  }
+  if (state_ != ZynclaveState::kSignedIn) {
+    FinishTokenRequests(std::nullopt);
+    return;
+  }
+  if (!tokens_) {
+    // Still waiting for the cipher to read them.
+    return;
+  }
+  if (tokens_->expiry - base::Time::Now() > kRefreshMargin) {
+    FinishTokenRequests(tokens_->access);
+    return;
+  }
+  Refresh();
+}
+
+void ZynclaveAuth::Refresh() {
+  refreshing_ = true;
+  WithDiscovery(base::BindOnce(
+      [](base::WeakPtr<ZynclaveAuth> self, bool ok) {
+        if (!self) {
+          return;
+        }
+        if (!ok || !self->tokens_) {
+          self->refreshing_ = false;
+          self->FinishTokenRequests(std::nullopt);
+          return;
+        }
+        self->Fetch(self->discovery_->token,
+                    RefreshRequestBody(self->config_, self->tokens_->refresh),
+                    kMaxBody,
+                    base::BindOnce(&ZynclaveAuth::OnRefreshed, self));
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+void ZynclaveAuth::OnRefreshed(std::optional<std::string> body, int status) {
+  refreshing_ = false;
+  TokenResponse response =
+      body ? ParseTokenResponse(*body) : TokenResponse{.error = "network"};
+  if (response.error == "invalid_grant") {
+    LogError("refresh token no longer valid");
+    Forget(/*keep_account_for_sign_in_again=*/true);
+    return;
+  }
+  if (!response.error.empty() || !tokens_) {
+    LogError("refresh failed");
+    FinishTokenRequests(std::nullopt);
+    return;
+  }
+  tokens_->access = response.access;
+  if (!response.refresh.empty()) {
+    tokens_->refresh = response.refresh;
+  }
+  tokens_->expiry = base::Time::Now() + response.expires_in;
+  SaveTokens();
+  FinishTokenRequests(tokens_->access);
+}
+
+void ZynclaveAuth::FinishTokenRequests(std::optional<std::string> access) {
+  std::vector<TokenCallback> waiters;
+  waiters.swap(token_waiters_);
+  for (auto& waiter : waiters) {
+    std::move(waiter).Run(access);
+  }
+}
+
+// Sign-out.
+
+void ZynclaveAuth::SignOut(bool everywhere) {
+  if (tokens_) {
+    Revoke(tokens_->refresh);
+  }
+  if (everywhere) {
+    WithDiscovery(base::BindOnce(
+        [](base::WeakPtr<ZynclaveAuth> self, bool ok) {
+          if (!self || !ok) {
+            return;
+          }
+          // RP-initiated logout by client_id: no token in the URL.
+          self->open_url_.Run(net::AppendQueryParameter(
+              self->discovery_->end_session, "client_id",
+              self->config_.client_id));
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+  Forget(/*keep_account_for_sign_in_again=*/false);
+}
+
+void ZynclaveAuth::SignOutLocally() {
+  pending_.clear();
+  Forget(/*keep_account_for_sign_in_again=*/false);
+}
+
+void ZynclaveAuth::Revoke(std::string refresh_token) {
+  if (refresh_token.empty()) {
+    return;
+  }
+  WithDiscovery(base::BindOnce(
+      [](base::WeakPtr<ZynclaveAuth> self, std::string refresh_token,
+         bool ok) {
+        if (!self || !ok) {
+          return;
+        }
+        // Best effort: signed out here whatever Zynclave answers.
+        self->Fetch(self->discovery_->revocation,
+                    RevokeRequestBody(self->config_, refresh_token), kMaxBody,
+                    base::DoNothing());
+      },
+      weak_factory_.GetWeakPtr(), std::move(refresh_token)));
+}
+
+// Storage.
+
+void ZynclaveAuth::LoadAccount() {
+  const base::DictValue& saved = prefs_->GetDict(kAccountPref);
+  const std::string* sub = saved.FindString("sub");
+  if (!sub || sub->empty()) {
+    return;
+  }
+  const bool needs_sign_in_again =
+      saved.FindBool("needs_sign_in_again").value_or(false);
+  if (!needs_sign_in_again && prefs_->GetString(kTokensPref).empty()) {
+    prefs_->ClearPref(kAccountPref);
+    return;
+  }
+  Userinfo info;
+  info.sub = *sub;
+  if (const std::string* name = saved.FindString("name")) {
+    info.name = *name;
+  }
+  if (const std::string* email = saved.FindString("email")) {
+    info.email = *email;
+  }
+  if (const std::string* picture = saved.FindString("picture")) {
+    info.picture = GURL(*picture);
+  }
+  account_ = std::move(info);
+  state_ = needs_sign_in_again ? ZynclaveState::kNeedsSignInAgain
+                               : ZynclaveState::kSignedIn;
+}
+
+void ZynclaveAuth::LoadTokens() {
+  if (!cipher_ || state_ != ZynclaveState::kSignedIn || tokens_) {
+    return;
+  }
+  const std::string& stored = prefs_->GetString(kTokensPref);
+  std::string encrypted;
+  std::optional<std::string> plain;
+  if (base::Base64Decode(stored, &encrypted)) {
+    plain = cipher_->Decrypt(encrypted);
+  }
+  std::optional<base::DictValue> dict;
+  if (plain) {
+    dict = base::JSONReader::ReadDict(*plain, base::JSON_PARSE_RFC);
+  }
+  const std::string* access = dict ? dict->FindString("access") : nullptr;
+  const std::string* refresh = dict ? dict->FindString("refresh") : nullptr;
+  std::optional<double> expiry = dict ? dict->FindDouble("expiry") : std::nullopt;
+  if (!access || !refresh || refresh->empty() || !expiry) {
+    // The Keychain key changed or the data is damaged: signed out.
+    LogError("stored tokens unreadable");
+    Forget(/*keep_account_for_sign_in_again=*/false);
+    return;
+  }
+  tokens_ = Tokens{*access, *refresh,
+                   base::Time::FromSecondsSinceUnixEpoch(*expiry)};
+}
+
+void ZynclaveAuth::SaveTokens() {
+  if (!tokens_ || !cipher_) {
+    return;
+  }
+  base::DictValue dict;
+  dict.Set("access", tokens_->access);
+  dict.Set("refresh", tokens_->refresh);
+  dict.Set("expiry", tokens_->expiry.InSecondsFSinceUnixEpoch());
+  std::optional<std::string> encrypted =
+      cipher_->Encrypt(base::WriteJson(dict).value_or(""));
+  if (!encrypted) {
+    LogError("could not encrypt tokens");
+    return;
+  }
+  prefs_->SetString(kTokensPref, base::Base64Encode(*encrypted));
+}
+
+void ZynclaveAuth::SaveAccount() {
+  if (!account_) {
+    prefs_->ClearPref(kAccountPref);
+    return;
+  }
+  base::DictValue dict;
+  dict.Set("sub", account_->sub);
+  dict.Set("name", account_->name);
+  dict.Set("email", account_->email);
+  dict.Set("picture", account_->picture.possibly_invalid_spec());
+  if (state_ == ZynclaveState::kNeedsSignInAgain) {
+    dict.Set("needs_sign_in_again", true);
+  }
+  prefs_->SetDict(kAccountPref, std::move(dict));
+}
+
+void ZynclaveAuth::Forget(bool keep_account_for_sign_in_again) {
+  tokens_.reset();
+  prefs_->ClearPref(kTokensPref);
+  if (keep_account_for_sign_in_again && account_) {
+    state_ = ZynclaveState::kNeedsSignInAgain;
+    SaveAccount();
+  } else {
+    account_.reset();
+    prefs_->ClearPref(kAccountPref);
+    state_ = ZynclaveState::kSignedOut;
+  }
+  state_before_exchange_ = state_;
+  FinishTokenRequests(std::nullopt);
+  observers_.Notify();
+}
+
+void ZynclaveAuth::SetState(ZynclaveState state) {
+  if (state_ == state) {
+    return;
+  }
+  state_ = state;
+  observers_.Notify();
+}
+
+}  // namespace tark_zynclave
