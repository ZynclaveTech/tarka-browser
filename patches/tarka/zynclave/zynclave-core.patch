+  std::string jwt = Sign(Claims());
+  base::DictValue c = Claims();
+  c.Set("sub", "someone-else");
+  size_t first = jwt.find('.');
+  size_t last = jwt.rfind('.');
+  std::string tampered =
+      jwt.substr(0, first + 1) + B64(Json(c)) + jwt.substr(last);
+  EXPECT_FALSE(Verify(tampered));
+}
