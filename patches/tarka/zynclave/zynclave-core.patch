+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AUTH_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AUTH_H_
+
+#include <list>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/tark_zynclave/oidc.h"
+#include "chrome/browser/tark_zynclave/zynclave_config.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace tark_zynclave {
+
+class TokenCipher;
+
+enum class ZynclaveState {
+  kSignedOut,
+  kSigningIn,
+  kSignedIn,
+  kNeedsSignInAgain,
+};
+
+// One profile's Zynclave sign-in: the OAuth round trip (the page opens in a
+// normal tab; the redirect comes back through HandleRedirect), the encrypted
+// tokens in the profile's prefs, refresh, and sign-out. All on the UI thread.
+// Tokens are never logged and never put in a URL.
+class ZynclaveAuth {
+ public:
+  using OpenUrlCallback = base::RepeatingCallback<void(const GURL&)>;
+  using TokenCallback =
+      base::OnceCallback<void(std::optional<std::string> access_token)>;
+
+  // A pending request older than this is forgotten.
+  static constexpr base::TimeDelta kRequestLifetime = base::Minutes(10);
+  // Refresh when the access token has less than this left.
+  static constexpr base::TimeDelta kRefreshMargin = base::Seconds(60);
+
+  ZynclaveAuth(const ZynclaveConfig& config,
+               PrefService* prefs,
+               scoped_refptr<network::SharedURLLoaderFactory> url_loaders,
+               OpenUrlCallback open_url);
+  ZynclaveAuth(const ZynclaveAuth&) = delete;
+  ZynclaveAuth& operator=(const ZynclaveAuth&) = delete;
+  ~ZynclaveAuth();
+
+  // The token store's encryption, once OSCrypt is ready. Token requests
+  // made before wait for it; stored tokens it cannot decrypt sign out.
+  void SetCipher(std::unique_ptr<TokenCipher> cipher);
+
+  ZynclaveState state() const { return state_; }
+  // The signed-in account (also kept while it needs signing in again).
+  const Userinfo* account() const {
+    return account_ ? &*account_ : nullptr;
+  }
+
+  // Opens Zynclave's sign-in page. `prompt_none` asks Zynclave to use its
+  // web session without a screen ("Sign in to Tark as X?"); if it needs one,
+  // the page opens once more without. `expected_email`, when set, is the
+  // account the person agreed to: a different one is signed out again.
+  void StartSignIn(bool prompt_none, std::string expected_email = {});
+
+  // The redirect from a tab. True if it answered a request pending here.
+  bool HandleRedirect(const GURL& url);
+
+  // A fresh access token, refreshing if it has under a minute left. One
+  // refresh at a time: callers asking meanwhile get its result.
+  void GetAccessToken(TokenCallback callback);
+
+  // Revokes the refresh token (best effort) and forgets the account here.
+  // `everywhere` also opens Zynclave's end-session page in a tab.
+  void SignOut(bool everywhere);
+
+  // Forgets the account without telling Zynclave (the policy turned off).
+  void SignOutLocally();
+
+  base::CallbackListSubscription AddObserver(base::RepeatingClosure observer);
+
+ private:
+  struct Tokens {
+    std::string access;
+    std::string refresh;
+    base::Time expiry;
+  };
+  struct InFlight;
+  using BodyCallback =
+      base::OnceCallback<void(std::optional<std::string> body, int status)>;
+
+  void Fetch(const GURL& url,
+             std::optional<std::string> post_body,
+             size_t max_bytes,
+             BodyCallback callback);
+  void OnFetched(std::list<std::unique_ptr<InFlight>>::iterator it,
+                 std::optional<std::string> body);
+
+  // Discovery, then the JWKS, cached in memory; a failure clears them.
+  void WithDiscovery(base::OnceCallback<void(bool ok)> callback);
+  void OnDiscovery(std::optional<std::string> body, int status);
+
+  void OpenSignInPage(bool prompt_none, std::string expected_email, bool ok);
+  void OnCode(PendingRequest request,
+              std::string expected_email,
+              std::string code);
+  void OnTokens(PendingRequest request,
+                std::string expected_email,
+                std::optional<std::string> body,
+                int status);
+  void OnJwks(PendingRequest request,
+              std::string expected_email,
+              TokenResponse tokens,
+              std::optional<std::string> body,
+              int status);
+  void OnUserinfo(std::string expected_email,
+                  IdClaims claims,
+                  Tokens tokens,
+                  std::optional<std::string> body,
+                  int status);
+  void SignInFailed();
+  void Revoke(std::string refresh_token);
+  void ServeTokenRequests();
+
+  void Refresh();
+  void OnRefreshed(std::optional<std::string> body, int status);
+  void FinishTokenRequests(std::optional<std::string> access);
+
+  void LoadAccount();
+  void LoadTokens();
+  void SaveTokens();
+  void SaveAccount();
+  void Forget(bool keep_account_for_sign_in_again);
+  void SetState(ZynclaveState state);
+
+  const ZynclaveConfig config_;
+  const raw_ptr<PrefService> prefs_;
+  scoped_refptr<network::SharedURLLoaderFactory> url_loaders_;
+  OpenUrlCallback open_url_;
+  std::unique_ptr<TokenCipher> cipher_;
+
+  ZynclaveState state_ = ZynclaveState::kSignedOut;
+  std::optional<Userinfo> account_;
+  std::optional<Tokens> tokens_;
+
+  std::optional<Discovery> discovery_;
+  std::vector<base::OnceCallback<void(bool)>> discovery_waiters_;
+
+  // Pending requests by state, with the email the person agreed to.
+  std::map<std::string, std::pair<PendingRequest, std::string>> pending_;
+
+  // What the state was before a code exchange, to go back to on failure.
+  ZynclaveState state_before_exchange_ = ZynclaveState::kSignedOut;
+
+  std::vector<TokenCallback> token_waiters_;
+  bool refreshing_ = false;
+
+  std::list<std::unique_ptr<InFlight>> fetches_;
+  base::RepeatingClosureList observers_;
+  base::WeakPtrFactory<ZynclaveAuth> weak_factory_{this};
+};
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AUTH_H_
