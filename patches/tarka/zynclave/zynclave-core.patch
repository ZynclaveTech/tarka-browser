+TEST(TarkZynclaveWhoami, ActiveSession) {
+  WhoamiResult r = ParseWhoami(
+      R"({"active":true,"identity":{"id":"k-1","traits":)"
+      R"({"name":"Asha Rao","email":"asha@example.test"}}})");
+  EXPECT_TRUE(r.signed_in);
+  EXPECT_EQ(r.id, "k-1");
+  EXPECT_EQ(r.name, "Asha Rao");
+  EXPECT_EQ(r.email, "asha@example.test");
+}
+
+TEST(TarkZynclaveWhoami, NameInParts) {
+  WhoamiResult r = ParseWhoami(
+      R"({"identity":{"id":"k","traits":{"name":{"first":"Asha","last":"Rao"}}}})");
+  EXPECT_EQ(r.name, "Asha Rao");
+}
+
+TEST(TarkZynclaveWhoami, PhoneOnlyAccount) {
+  WhoamiResult r =
+      ParseWhoami(R"({"identity":{"id":"k","traits":{"phone":"+91"}}})");
+  EXPECT_TRUE(r.signed_in);
+  EXPECT_TRUE(r.name.empty());
+  EXPECT_TRUE(r.email.empty());
+}
+
+TEST(TarkZynclaveWhoami, InactiveOrMissingIdIsSignedOut) {
+  EXPECT_FALSE(
+      ParseWhoami(R"({"active":false,"identity":{"id":"k"}})").signed_in);
+  EXPECT_FALSE(ParseWhoami(R"({"identity":{"id":""}})").signed_in);
+  EXPECT_FALSE(ParseWhoami(R"({"error":{"code":401}})").signed_in);
+  EXPECT_FALSE(ParseWhoami("not json").signed_in);
+}
+
+TEST(TarkZynclaveWhoami, OversizedBodyIsIgnored) {
+  std::string body = R"({"identity":{"id":"k"},"pad":")" +
+                     std::string(kMaxWhoamiBytes, 'x') + "\"}";
+  EXPECT_FALSE(ParseWhoami(body).signed_in);
+}
