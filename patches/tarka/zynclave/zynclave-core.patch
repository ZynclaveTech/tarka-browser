+ZynclaveSignInService::ZynclaveSignInService(Profile* profile)
+    : profile_(profile) {
+  auth_ = std::make_unique<ZynclaveAuth>(
+      GetZynclaveConfig(), profile->GetPrefs(),
+      // The system network context: no cookies, nothing of the profile.
+      g_browser_process->system_network_context_manager()
+          ->GetSharedURLLoaderFactory(),
+      base::BindRepeating(&ZynclaveSignInService::OpenUrl,
+                          base::Unretained(this)));
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      &ZynclaveSignInService::OnEncryptor, weak_factory_.GetWeakPtr()));
+  pref_changes_.Init(profile->GetPrefs());
+  pref_changes_.Add(kAllowedPref,
+                    base::BindRepeating(&ZynclaveSignInService::OnAllowedChanged,
+                                        base::Unretained(this)));
+  OnAllowedChanged();
+}
+
+ZynclaveSignInService::~ZynclaveSignInService() = default;
+
+bool ZynclaveSignInService::allowed() const {
+  return profile_->GetPrefs()->GetBoolean(kAllowedPref);
+}
+
+void ZynclaveSignInService::Shutdown() {
+  pref_changes_.RemoveAll();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+void ZynclaveSignInService::OnEncryptor(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  auth_->SetCipher(std::make_unique<OsCryptCipher>(std::move(encryptor)));
+}
+
+void ZynclaveSignInService::OnAllowedChanged() {
+  if (!allowed() && auth_->state() != ZynclaveState::kSignedOut) {
+    auth_->SignOutLocally();
+  }
+}
+
+void ZynclaveSignInService::OpenUrl(const GURL& url) {
+  // A new foreground tab of this profile: the Zynclave session cookie lands
+  // here, never in Incognito, a popup or a web view.
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
