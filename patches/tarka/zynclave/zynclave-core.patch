+#include "crypto/sign.h"
+
+namespace tark_zynclave::test {
+
+namespace {
+
+std::string B64(base::span<const uint8_t> bytes) {
+  std::string out;
+  base::Base64UrlEncode(bytes, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &out);
+  return out;
+}
+
+std::string Json(const base::DictValue& dict) {
+  return base::WriteJson(dict).value();
+}
+
+}  // namespace
+
+FakeIssuer::FakeIssuer(std::string issuer)
+    : issuer_(std::move(issuer)),
+      key_(crypto::keypair::PrivateKey::GenerateRsa2048()) {}
+
+FakeIssuer::~FakeIssuer() = default;
+
+std::string FakeIssuer::Url(std::string_view path) const {
+  return base::StrCat({issuer_, path});
+}
+
+std::string FakeIssuer::DiscoveryJson() const {
+  base::DictValue d;
+  d.Set("issuer", issuer_);
+  d.Set("authorization_endpoint", Url("oauth2/auth"));
+  d.Set("token_endpoint", Url("oauth2/token"));
+  d.Set("userinfo_endpoint", Url("userinfo"));
+  d.Set("revocation_endpoint", Url("oauth2/revoke"));
+  d.Set("end_session_endpoint", Url("oauth2/sessions/logout"));
+  d.Set("jwks_uri", Url(".well-known/jwks.json"));
+  return Json(d);
+}
+
+std::string FakeIssuer::JwksJson() const {
+  crypto::keypair::PublicKey pub =
+      crypto::keypair::PublicKey::FromPrivateKey(key_);
+  base::DictValue jwk;
+  jwk.Set("kty", "RSA");
+  jwk.Set("alg", "RS256");
+  jwk.Set("use", "sig");
+  jwk.Set("kid", "k1");
+  jwk.Set("n", B64(pub.GetRsaModulus()));
+  jwk.Set("e", B64(pub.GetRsaExponent()));
+  base::ListValue keys;
+  keys.Append(std::move(jwk));
+  base::DictValue jwks;
+  jwks.Set("keys", std::move(keys));
+  return Json(jwks);
+}
+
+std::string FakeIssuer::IdToken(std::string_view client_id,
+                                std::string_view nonce,
+                                base::Time now,
+                                std::string_view sub,
+                                std::string_view email) const {
+  base::DictValue header;
+  header.Set("alg", "RS256");
+  header.Set("kid", "k1");
+  base::DictValue claims;
+  claims.Set("iss", issuer_);
+  claims.Set("aud", client_id);
+  claims.Set("sub", sub);
+  claims.Set("email", email);
+  claims.Set("nonce", nonce);
+  claims.Set("iat", now.InSecondsFSinceUnixEpoch());
+  claims.Set("exp", now.InSecondsFSinceUnixEpoch() + 600);
+  std::string input = base::StrCat({B64(base::as_byte_span(Json(header))),
+                                    ".",
+                                    B64(base::as_byte_span(Json(claims)))});
+  std::vector<uint8_t> sig = crypto::sign::Sign(
+      crypto::sign::RSA_PKCS1_SHA256, key_, base::as_byte_span(input));
+  return base::StrCat({input, ".", B64(sig)});
+}
+
+// static
+std::string FakeIssuer::TokenJson(std::string_view access,
+                                  std::string_view refresh,
+                                  std::string_view id_token,
+                                  int expires_in) {
+  base::DictValue d;
+  d.Set("access_token", access);
+  if (!refresh.empty()) {
+    d.Set("refresh_token", refresh);
+  }
+  if (!id_token.empty()) {
+    d.Set("id_token", id_token);
+  }
+  d.Set("expires_in", expires_in);
+  d.Set("token_type", "bearer");
+  return Json(d);
+}
+
+}  // namespace tark_zynclave::test
