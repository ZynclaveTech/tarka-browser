+// OSCrypt: the Keychain-held key on the Mac, DPAPI on Windows.
+class OsCryptCipher : public TokenCipher {
+ public:
+  explicit OsCryptCipher(scoped_refptr<os_crypt_async::Encryptor> encryptor)
+      : encryptor_(std::move(encryptor)) {}
+
+  std::optional<std::string> Encrypt(std::string_view plain) override {
+    std::string out;
+    if (!encryptor_->EncryptString(std::string(plain), &out)) {
+      return std::nullopt;
+    }
+    return out;
+  }
+
+  std::optional<std::string> Decrypt(std::string_view cipher) override {
+    std::string out;
+    if (!encryptor_->DecryptString(std::string(cipher), &out)) {
+      return std::nullopt;
+    }
+    return out;
+  }
+
+ private:
+  scoped_refptr<os_crypt_async::Encryptor> encryptor_;
+};
+
+}  // namespace
