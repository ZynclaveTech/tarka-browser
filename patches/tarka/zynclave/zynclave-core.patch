+
+TEST_F(TarkZynclaveIdToken, RejectsExpired) {
+  base::DictValue c = Claims();
+  c.Set("exp", static_cast<double>(now_.InSecondsFSinceUnixEpoch() - 61));
+  EXPECT_FALSE(Verify(Sign(c)));
+}
+
+TEST_F(TarkZynclaveIdToken, RejectsIssuedInTheFuture) {
+  base::DictValue c = Claims();
+  c.Set("iat", static_cast<double>(now_.InSecondsFSinceUnixEpoch() + 120));
