+
+// A normal profile's Zynclave account. There is none for Incognito or
+// Guest (ZynclaveSignInServiceFactory), so nothing Zynclave ever runs there.
+// Nothing happens at startup beyond reading prefs: no request until the
+// person signs in or something needs the account.
+class ZynclaveSignInService : public KeyedService {
+ public:
+  explicit ZynclaveSignInService(Profile* profile);
+  ZynclaveSignInService(const ZynclaveSignInService&) = delete;
+  ZynclaveSignInService& operator=(const ZynclaveSignInService&) = delete;
+  ~ZynclaveSignInService() override;
+
+  ZynclaveAuth& auth() { return *auth_; }
+  // False when the ZynclaveSignInAllowed policy turns sign-in off.
+  bool allowed() const;
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void OpenUrl(const GURL& url);
+  void OnEncryptor(scoped_refptr<os_crypt_async::Encryptor> encryptor);
+  void OnAllowedChanged();
+
+  const raw_ptr<Profile> profile_;
+  std::unique_ptr<ZynclaveAuth> auth_;
+  PrefChangeRegistrar pref_changes_;
+  base::WeakPtrFactory<ZynclaveSignInService> weak_factory_{this};
+};
+
