+TEST_F(TarkZynclaveAuth, RotatedRefreshTokenIsSaved) {
+  auto auth = MakeAuth();
+  SignIn(*auth);
+  const std::string before = prefs_.GetString(kTokensPref);
+  task_env_.FastForwardBy(base::Hours(2));
+  base::test::TestFuture<std::optional<std::string>> token;
+  auth->GetAccessToken(token.GetCallback());
+  task_env_.RunUntilIdle();
+  loaders_.SimulateResponseForPendingRequest(
+      issuer_.Url("oauth2/token"),
+      test::FakeIssuer::TokenJson("access-2", "refresh-2", ""));
+  ASSERT_EQ(token.Get(), "access-2");
+  EXPECT_NE(prefs_.GetString(kTokensPref), before);
+  // The next refresh sends the rotated token.
+  task_env_.FastForwardBy(base::Hours(2));
+  base::test::TestFuture<std::optional<std::string>> next;
+  auth->GetAccessToken(next.GetCallback());
+  task_env_.RunUntilIdle();
+  ASSERT_EQ(TokenRequests(), 1);
+  const auto& request = loaders_.pending_requests()->back().request;
+  std::string body(request.request_body->elements()
+                       ->at(0)
+                       .As<network::DataElementBytes>()
+                       .AsStringPiece());
