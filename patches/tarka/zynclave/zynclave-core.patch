+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/oidc.h"
+
+#include <array>
+#include <vector>
+
+#include "base/base64url.h"
+#include "base/json/json_reader.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/tark_zynclave/zynclave_config.h"
+#include "crypto/hash.h"
+#include "crypto/keypair.h"
+#include "crypto/random.h"
+#include "crypto/sign.h"
+#include "net/base/url_util.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+constexpr base::TimeDelta kLeeway = base::Seconds(60);
+
+std::string RandomToken() {
+  std::array<uint8_t, 32> bytes = crypto::RandBytesAsArray<32>();
+  std::string out;
+  base::Base64UrlEncode(bytes, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &out);
+  return out;
+}
+
+std::optional<std::string> Unbase64(std::string_view text) {
+  std::string out;
+  if (!base::Base64UrlDecode(text, base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                             &out)) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+std::string Form(std::string_view key, std::string_view value) {
+  return base::StrCat(
+      {key, "=", base::EscapeQueryParamValue(value, /*use_plus=*/false)});
+}
+
+// An https URL on the issuer's host.
+GURL Endpoint(const base::DictValue& doc,
+              std::string_view key,
+              const GURL& issuer) {
+  const std::string* value = doc.FindString(key);
+  if (!value) {
+    return GURL();
+  }
+  GURL url(*value);
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      url.host() != issuer.host() || url.has_username() ||
+      url.has_password()) {
+    return GURL();
+  }
+  return url;
+}
+
+std::optional<crypto::keypair::PublicKey> KeyFor(std::string_view jwks_json,
+                                                 std::string_view kid) {
+  std::optional<base::DictValue> jwks =
+      base::JSONReader::ReadDict(jwks_json, base::JSON_PARSE_RFC);
+  const base::ListValue* keys = jwks ? jwks->FindList("keys") : nullptr;
+  if (!keys) {
+    return std::nullopt;
+  }
+  for (const base::Value& entry : *keys) {
+    const base::DictValue* key = entry.GetIfDict();
+    if (!key) {
+      continue;
+    }
+    const std::string* key_kid = key->FindString("kid");
+    const std::string* kty = key->FindString("kty");
+    if (!key_kid || *key_kid != kid || !kty || *kty != "RSA") {
+      continue;
+    }
+    const std::string* use = key->FindString("use");
+    if (use && *use != "sig") {
+      continue;
+    }
+    const std::string* n = key->FindString("n");
+    const std::string* e = key->FindString("e");
+    std::optional<std::string> n_bytes = n ? Unbase64(*n) : std::nullopt;
+    std::optional<std::string> e_bytes = e ? Unbase64(*e) : std::nullopt;
+    if (!n_bytes || !e_bytes) {
+      return std::nullopt;
+    }
+    return crypto::keypair::PublicKey::FromRsaPublicKeyComponents(
+        base::as_byte_span(*n_bytes), base::as_byte_span(*e_bytes));
+  }
+  return std::nullopt;
+}
+
+bool AudienceHas(const base::DictValue& claims, std::string_view client_id) {
+  if (const std::string* aud = claims.FindString("aud")) {
+    return *aud == client_id;
+  }
+  if (const base::ListValue* auds = claims.FindList("aud")) {
+    for (const base::Value& aud : *auds) {
+      if (aud.is_string() && aud.GetString() == client_id) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+std::optional<base::Time> TimeClaim(const base::DictValue& claims,
+                                    std::string_view key) {
+  std::optional<double> seconds = claims.FindDouble(key);
+  if (!seconds) {
+    return std::nullopt;
+  }
+  return base::Time::FromSecondsSinceUnixEpoch(*seconds);
+}
+
+bool IsHiddenChar(char16_t c) {
+  return c < 0x20 || (c >= 0x7f && c <= 0x9f) || c == 0x061c ||
+         c == 0x200e || c == 0x200f || (c >= 0x202a && c <= 0x202e) ||
+         (c >= 0x2066 && c <= 0x2069) || c == 0xfeff;
+}
+
+}  // namespace
+
+std::optional<Discovery> ParseDiscovery(std::string_view json,
+                                        const GURL& issuer) {
+  std::optional<base::DictValue> doc =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!doc) {
+    return std::nullopt;
+  }
+  const std::string* doc_issuer = doc->FindString("issuer");
+  if (!doc_issuer || GURL(*doc_issuer) != issuer) {
+    return std::nullopt;
+  }
+  Discovery d;
+  d.issuer = *doc_issuer;
+  d.authorization = Endpoint(*doc, "authorization_endpoint", issuer);
+  d.token = Endpoint(*doc, "token_endpoint", issuer);
+  d.userinfo = Endpoint(*doc, "userinfo_endpoint", issuer);
+  d.revocation = Endpoint(*doc, "revocation_endpoint", issuer);
+  d.end_session = Endpoint(*doc, "end_session_endpoint", issuer);
+  d.jwks = Endpoint(*doc, "jwks_uri", issuer);
+  for (const GURL* url : {&d.authorization, &d.token, &d.userinfo,
+                          &d.revocation, &d.end_session, &d.jwks}) {
+    if (!url->is_valid()) {
+      return std::nullopt;
+    }
+  }
+  return d;
+}
+
+PendingRequest NewRequest(bool prompt_none) {
+  PendingRequest request;
+  request.state = RandomToken();
+  request.nonce = RandomToken();
+  request.verifier = RandomToken();
+  request.created = base::Time::Now();
+  request.prompt_none = prompt_none;
+  return request;
+}
+
+std::string S256Challenge(std::string_view verifier) {
+  std::array<uint8_t, crypto::hash::kSha256Size> digest =
+      crypto::hash::Sha256(verifier);
+  std::string out;
+  base::Base64UrlEncode(digest, base::Base64UrlEncodePolicy::OMIT_PADDING,
+                        &out);
+  return out;
+}
+
+GURL AuthorizationUrl(const Discovery& discovery,
+                      const ZynclaveConfig& config,
+                      const PendingRequest& request) {
+  GURL url = discovery.authorization;
+  url = net::AppendQueryParameter(url, "response_type", "code");
+  url = net::AppendQueryParameter(url, "client_id", config.client_id);
+  url = net::AppendQueryParameter(url, "redirect_uri", kRedirectUri);
+  url = net::AppendQueryParameter(url, "scope", kScopes);
+  url = net::AppendQueryParameter(url, "state", request.state);
+  url = net::AppendQueryParameter(url, "nonce", request.nonce);
+  url = net::AppendQueryParameter(url, "code_challenge",
+                                  S256Challenge(request.verifier));
+  url = net::AppendQueryParameter(url, "code_challenge_method", "S256");
+  if (request.prompt_none) {
+    url = net::AppendQueryParameter(url, "prompt", "none");
+  }
+  return url;
+}
+
+std::string TokenRequestBody(const ZynclaveConfig& config,
+                             std::string_view code,
+                             std::string_view verifier) {
+  return base::JoinString(
+      {Form("grant_type", "authorization_code"), Form("code", code),
+       Form("redirect_uri", kRedirectUri), Form("client_id", config.client_id),
+       Form("code_verifier", verifier)},
+      "&");
+}
+
+std::string RefreshRequestBody(const ZynclaveConfig& config,
+                               std::string_view refresh_token) {
+  return base::JoinString({Form("grant_type", "refresh_token"),
+                           Form("refresh_token", refresh_token),
+                           Form("client_id", config.client_id)},
+                          "&");
+}
+
+std::string RevokeRequestBody(const ZynclaveConfig& config,
+                              std::string_view refresh_token) {
+  return base::JoinString(
+      {Form("token", refresh_token), Form("token_type_hint", "refresh_token"),
+       Form("client_id", config.client_id)},
+      "&");
+}
+
+TokenResponse ParseTokenResponse(std::string_view json) {
+  TokenResponse response;
+  std::optional<base::DictValue> doc =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!doc) {
+    response.error = "malformed";
+    return response;
+  }
+  if (const std::string* error = doc->FindString("error")) {
+    response.error = error->empty() ? "malformed" : *error;
+    return response;
+  }
+  const std::string* access = doc->FindString("access_token");
+  if (!access || access->empty()) {
+    response.error = "malformed";
+    return response;
+  }
+  response.access = *access;
+  if (const std::string* refresh = doc->FindString("refresh_token")) {
+    response.refresh = *refresh;
+  }
+  if (const std::string* id_token = doc->FindString("id_token")) {
+    response.id_token = *id_token;
+  }
+  response.expires_in =
+      base::Seconds(doc->FindDouble("expires_in").value_or(0));
+  return response;
+}
+
+std::optional<IdClaims> VerifyIdToken(std::string_view jwt,
+                                      std::string_view jwks_json,
+                                      const ZynclaveConfig& config,
+                                      std::string_view nonce,
+                                      base::Time now) {
+  std::vector<std::string_view> parts = base::SplitStringPiece(
+      jwt, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 3 || parts[0].empty() || parts[1].empty() ||
+      parts[2].empty()) {
+    return std::nullopt;
+  }
+  std::optional<std::string> header_json = Unbase64(parts[0]);
+  std::optional<std::string> claims_json = Unbase64(parts[1]);
+  std::optional<std::string> signature = Unbase64(parts[2]);
+  if (!header_json || !claims_json || !signature) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> header =
+      base::JSONReader::ReadDict(*header_json, base::JSON_PARSE_RFC);
+  if (!header) {
+    return std::nullopt;
+  }
+  const std::string* alg = header->FindString("alg");
+  const std::string* kid = header->FindString("kid");
+  if (!alg || *alg != "RS256" || !kid) {
+    return std::nullopt;
+  }
+  std::optional<crypto::keypair::PublicKey> key = KeyFor(jwks_json, *kid);
+  if (!key || !key->IsRsa()) {
+    return std::nullopt;
+  }
+  std::string_view signed_part =
+      jwt.substr(0, parts[0].size() + 1 + parts[1].size());
+  if (!crypto::sign::Verify(crypto::sign::RSA_PKCS1_SHA256, *key,
+                            base::as_byte_span(signed_part),
+                            base::as_byte_span(*signature))) {
+    return std::nullopt;
+  }
+
+  std::optional<base::DictValue> claims =
+      base::JSONReader::ReadDict(*claims_json, base::JSON_PARSE_RFC);
+  if (!claims) {
+    return std::nullopt;
+  }
+  const std::string* iss = claims->FindString("iss");
+  if (!iss || GURL(*iss) != config.issuer) {
+    return std::nullopt;
+  }
+  if (!AudienceHas(*claims, config.client_id)) {
+    return std::nullopt;
+  }
+  std::optional<base::Time> exp = TimeClaim(*claims, "exp");
+  std::optional<base::Time> iat = TimeClaim(*claims, "iat");
+  if (!exp || !iat || *exp <= now - kLeeway || *iat > now + kLeeway) {
+    return std::nullopt;
+  }
+  const std::string* claim_nonce = claims->FindString("nonce");
+  if (!claim_nonce || *claim_nonce != nonce) {
+    return std::nullopt;
+  }
+  const std::string* sub = claims->FindString("sub");
+  if (!sub || sub->empty()) {
+    return std::nullopt;
+  }
+  IdClaims result;
+  result.sub = *sub;
+  if (const std::string* email = claims->FindString("email")) {
+    result.email = *email;
+  }
+  return result;
+}
+
+std::optional<Userinfo> ParseUserinfo(std::string_view json) {
+  std::optional<base::DictValue> doc =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!doc) {
+    return std::nullopt;
+  }
+  const std::string* sub = doc->FindString("sub");
+  if (!sub || sub->empty()) {
+    return std::nullopt;
+  }
+  Userinfo info;
+  info.sub = *sub;
+  if (const std::string* name = doc->FindString("name")) {
+    info.name = CleanDisplayText(*name, 40);
+  }
+  if (const std::string* email = doc->FindString("email")) {
+    info.email = CleanDisplayText(*email, 64);
+  }
+  if (const std::string* picture = doc->FindString("picture")) {
+    info.picture = GURL(*picture);
+  }
+  return info;
+}
+
+bool AllowedAvatarUrl(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      url.has_username() || url.has_password() || url.has_port()) {
+    return false;
+  }
+  const std::string_view host = url.host();
+  for (std::string_view google :
+       {"lh3.googleusercontent.com", "lh4.googleusercontent.com",
+        "lh5.googleusercontent.com", "lh6.googleusercontent.com"}) {
+    if (host == google) {
+      return true;
+    }
+  }
+  return base::EndsWith(host, ".zynclave.com");
+}
+
+bool IsRedirectUrl(const GURL& url) {
+  return url.SchemeIs(kRedirectScheme) && url.path() == kRedirectPath;
+}
+
+std::string CleanDisplayText(std::string_view text, size_t max_chars) {
+  std::u16string wide = base::UTF8ToUTF16(text);
+  std::u16string kept;
+  kept.reserve(wide.size());
+  for (char16_t c : wide) {
+    if (IsHiddenChar(c)) {
+      continue;
+    }
+    kept.push_back(c);
+  }
+  kept = base::CollapseWhitespace(kept, /*trim_sequences_with_line_breaks=*/
+                                  false);
+  if (kept.size() > max_chars) {
+    size_t cut = max_chars;
+    // Never split a surrogate pair.
+    if (cut > 0 && (kept[cut - 1] & 0xfc00) == 0xd800) {
+      --cut;
+    }
+    kept.resize(cut);
+  }
+  return base::UTF16ToUTF8(kept);
+}
+
+}  // namespace tark_zynclave
