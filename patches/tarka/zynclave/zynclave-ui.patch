+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/zynclave_avatar.h"
+
+#include <utility>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/tark_zynclave/oidc.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/data_decoder/public/cpp/decode_image.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_zynclave_avatar", R"(
+      semantics {
+        sender: "Sign in with Zynclave"
+        description:
+          "Downloads the signed-in Zynclave account's photo, shown on the "
+          "profile button and in Settings."
+        trigger: "After signing in, when the account's photo changes."
+        data: "None: no cookies, no token; the photo's address only."
+        destination: OTHER
+        destination_other:
+          "Zynclave's avatar host or lh3-lh6.googleusercontent.com"
+      }
+      policy {
+        cookies_allowed: NO
+        setting: "Settings > Profile > Sign out."
+        chrome_policy {
+          ZynclaveSignInAllowed {
+            ZynclaveSignInAllowed: false
+          }
+        }
+      })");
+
+constexpr size_t kMaxBytes = 512 * 1024;
+
+base::FilePath Folder(const base::FilePath& profile_dir) {
+  return profile_dir.AppendASCII("Tark Zynclave");
+}
+
+std::optional<std::string> ReadFile(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, kMaxBytes * 4)) {
+    return std::nullopt;
+  }
+  return text;
+}
+
+// In the data decoder's process: the bytes come from the web.
+void DecodeIsolated(std::string bytes,
+                    base::OnceCallback<void(const SkBitmap&)> callback) {
+  data_decoder::DecodeImageIsolated(
+      base::as_byte_span(bytes), data_decoder::mojom::ImageCodec::kDefault,
+      /*shrink_to_fit=*/true, kMaxBytes * 4, gfx::Size(), std::move(callback));
+}
+
+}  // namespace
+
+ZynclaveAvatar::ZynclaveAvatar(
+    scoped_refptr<network::SharedURLLoaderFactory> url_loaders,
+    const base::FilePath& profile_dir,
+    ChangedCallback on_changed,
+    Decoder decoder)
+    : url_loaders_(std::move(url_loaders)),
+      dir_(Folder(profile_dir)),
+      on_changed_(std::move(on_changed)),
+      decoder_(decoder ? std::move(decoder) : base::BindRepeating(&DecodeIsolated)),
+      files_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {}
+
+ZynclaveAvatar::~ZynclaveAvatar() = default;
+
+std::string ZynclaveAvatar::DataUrl() const {
+  if (png_.empty()) {
+    return std::string();
+  }
+  return base::StrCat({"data:image/png;base64,", base::Base64Encode(png_)});
+}
+
+void ZynclaveAvatar::Update(const Userinfo* account) {
+  if (!account || !AllowedAvatarUrl(account->picture)) {
+    Clear();
+    return;
+  }
+  if (account->picture == url_) {
+    return;  // shown, or on its way
+  }
+  url_ = account->picture;
+  loader_.reset();
+  weak_factory_.InvalidateWeakPtrs();
+  // The photo kept from last time, if it is this one.
+  files_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath dir) -> std::optional<Stored> {
+            std::optional<std::string> url = ReadFile(dir.AppendASCII("url"));
+            std::optional<std::string> png =
+                ReadFile(dir.AppendASCII("avatar.png"));
+            if (!url || !png) {
+              return std::nullopt;
+            }
+            return Stored{std::move(*url), std::move(*png)};
+          },
+          dir_),
+      base::BindOnce(&ZynclaveAvatar::OnStored, weak_factory_.GetWeakPtr(),
+                     url_));
+}
+
+void ZynclaveAvatar::OnStored(GURL url, std::optional<Stored> stored) {
+  if (stored && stored->url == url.spec()) {
+    decoder_.Run(std::move(stored->png),
+                 base::BindOnce(&ZynclaveAvatar::OnDecoded,
+                                weak_factory_.GetWeakPtr(), url,
+                                /*from_disk=*/true));
+    return;
+  }
+  Fetch(std::move(url));
+}
+
+void ZynclaveAvatar::Fetch(GURL url) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader_->SetTimeoutDuration(base::Seconds(20));
+  loader_->DownloadToString(
+      url_loaders_.get(),
+      base::BindOnce(&ZynclaveAvatar::OnFetched, weak_factory_.GetWeakPtr(),
+                     url),
+      kMaxBytes);
+}
+
+void ZynclaveAvatar::OnFetched(GURL url, std::optional<std::string> body) {
+  loader_.reset();
+  if (!body || body->empty()) {
+    Forget(url);
+    return;
+  }
+  decoder_.Run(std::move(*body),
+               base::BindOnce(&ZynclaveAvatar::OnDecoded,
+                              weak_factory_.GetWeakPtr(), url,
+                              /*from_disk=*/false));
+}
+
+void ZynclaveAvatar::OnDecoded(GURL url,
+                               bool from_disk,
+                               const SkBitmap& bitmap) {
+  if (url != url_) {
+    return;
+  }
+  if (bitmap.drawsNothing()) {
+    Forget(url);
+    return;
+  }
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                        /*discard_transparency=*/false);
+  if (!png) {
+    Forget(url);
+    return;
+  }
+  png_.assign(png->begin(), png->end());
+  if (!from_disk) {
+    files_->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::FilePath dir, std::string url, std::string png) {
+              if (!base::CreateDirectory(dir)) {
+                return;
+              }
+              base::ImportantFileWriter::WriteFileAtomically(
+                  dir.AppendASCII("avatar.png"), png);
+              base::ImportantFileWriter::WriteFileAtomically(
+                  dir.AppendASCII("url"), url);
+            },
+            dir_, url.spec(), png_));
+  }
+  on_changed_.Run(gfx::Image::CreateFrom1xBitmap(bitmap));
+}
+
+void ZynclaveAvatar::Forget(const GURL& url) {
+  // The next Update() with the same picture tries again.
+  if (url == url_) {
+    url_ = GURL();
+  }
+}
+
+void ZynclaveAvatar::Clear() {
+  loader_.reset();
+  weak_factory_.InvalidateWeakPtrs();
+  const bool had_photo = !png_.empty();
+  url_ = GURL();
+  png_.clear();
+  files_->PostTask(FROM_HERE,
+                   base::BindOnce(
+                       [](base::FilePath dir) {
+                         base::DeletePathRecursively(dir);
+                       },
+                       dir_));
+  if (had_photo) {
+    on_changed_.Run(gfx::Image());
+  }
+}
+
+}  // namespace tark_zynclave
