+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/zynclave_avatar.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/functional/callback_helpers.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/task_environment.h"
+#include "net/http/http_status_code.h"
+#include "chrome/browser/tark_zynclave/oidc.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/image/image.h"
+
+namespace tark_zynclave {
+namespace {
+
+std::string Png() {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(8, 8);
+  bitmap.eraseColor(SK_ColorRED);
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  return std::string(png->begin(), png->end());
+}
+
+// In-process PNG only; production decodes out of process.
+void DecodePng(std::string bytes,
+               base::OnceCallback<void(const SkBitmap&)> callback) {
+  std::move(callback).Run(gfx::PNGCodec::Decode(base::as_byte_span(bytes)));
+}
+
+class TarkZynclaveAvatar : public testing::Test {
+ protected:
+  TarkZynclaveAvatar() {
+    EXPECT_TRUE(dir_.CreateUniqueTempDir());
+    avatar_ = std::make_unique<ZynclaveAvatar>(
+        base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+            &loaders_),
+        dir_.GetPath(),
+        base::BindRepeating([](int* n, const gfx::Image&) { ++*n; },
+                            &changes_),
+        base::BindRepeating(&DecodePng));
+  }
+
+  Userinfo Account(std::string_view picture) {
+    Userinfo info;
+    info.sub = "s";
+    info.picture = GURL(picture);
+    return info;
+  }
+
+  base::FilePath File() const {
+    return dir_.GetPath().AppendASCII("Tark Zynclave").AppendASCII(
+        "avatar.png");
+  }
+
+  base::test::TaskEnvironment task_env_;
+  base::ScopedTempDir dir_;
+  network::TestURLLoaderFactory loaders_;
+  int changes_ = 0;
+  std::unique_ptr<ZynclaveAvatar> avatar_;
+};
+
+TEST_F(TarkZynclaveAvatar, AvatarUrlRefusedIsNotFetched) {
+  Userinfo account = Account("https://evil.example.test/a.png");
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(loaders_.NumPending(), 0);
+  EXPECT_EQ(loaders_.total_requests(), 0u);
+  EXPECT_TRUE(avatar_->DataUrl().empty());
+}
+
+TEST_F(TarkZynclaveAvatar, FetchesDecodesAndKeepsThePhoto) {
+  const char kUrl[] = "https://lh3.googleusercontent.com/a/x";
+  loaders_.AddResponse(kUrl, Png());
+  Userinfo account = Account(kUrl);
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  ASSERT_EQ(loaders_.total_requests(), 1u);
+  EXPECT_EQ(loaders_.GetPendingRequest(0) ? 1 : 0, 0);
+  EXPECT_EQ(changes_, 1);
+  EXPECT_TRUE(avatar_->DataUrl().starts_with("data:image/png;base64,"));
+  EXPECT_TRUE(base::PathExists(File()));
+
+  // A relaunch reads it back without a request.
+  ZynclaveAvatar again(
+      base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+          &loaders_),
+      dir_.GetPath(), base::DoNothing(), base::BindRepeating(&DecodePng));
+  again.Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(loaders_.total_requests(), 1u);
+  EXPECT_FALSE(again.DataUrl().empty());
+}
+
+TEST_F(TarkZynclaveAvatar, TheRequestHasNoCookies) {
+  Userinfo account = Account("https://cdn.zynclave.com/u/1.png");
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  ASSERT_EQ(loaders_.NumPending(), 1);
+  EXPECT_EQ(loaders_.pending_requests()->back().request.credentials_mode,
+            network::mojom::CredentialsMode::kOmit);
+}
+
+TEST_F(TarkZynclaveAvatar, ABrokenImageIsIgnored) {
+  const char kUrl[] = "https://lh4.googleusercontent.com/a/x";
+  loaders_.AddResponse(kUrl, "not an image");
+  Userinfo account = Account(kUrl);
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_TRUE(avatar_->DataUrl().empty());
+  EXPECT_FALSE(base::PathExists(File()));
+  EXPECT_EQ(changes_, 0);
+}
+
+TEST_F(TarkZynclaveAvatar, AFailedFetchIsTriedAgain) {
+  const char kUrl[] = "https://lh6.googleusercontent.com/a/x";
+  loaders_.AddResponse(kUrl, "", net::HTTP_INTERNAL_SERVER_ERROR);
+  Userinfo account = Account(kUrl);
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(changes_, 0);
+
+  loaders_.AddResponse(kUrl, Png());
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(loaders_.total_requests(), 2u);
+  EXPECT_EQ(changes_, 1);
+}
+
+TEST_F(TarkZynclaveAvatar, ABrokenImageIsTriedAgain) {
+  const char kUrl[] = "https://lh6.googleusercontent.com/a/y";
+  loaders_.AddResponse(kUrl, "not an image");
+  Userinfo account = Account(kUrl);
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+
+  loaders_.AddResponse(kUrl, Png());
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(loaders_.total_requests(), 2u);
+  EXPECT_EQ(changes_, 1);
+}
+
+TEST_F(TarkZynclaveAvatar, SignOutDeletesAvatar) {
+  const char kUrl[] = "https://lh5.googleusercontent.com/a/x";
+  loaders_.AddResponse(kUrl, Png());
+  Userinfo account = Account(kUrl);
+  avatar_->Update(&account);
+  task_env_.RunUntilIdle();
+  ASSERT_TRUE(base::PathExists(File()));
+  avatar_->Update(nullptr);
+  task_env_.RunUntilIdle();
+  EXPECT_FALSE(base::PathExists(File()));
+  EXPECT_TRUE(avatar_->DataUrl().empty());
+  EXPECT_EQ(changes_, 2);
+}
+
+}  // namespace
+}  // namespace tark_zynclave
