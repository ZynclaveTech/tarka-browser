+
+void ZynclaveSignInService::OnPhotoChanged(const gfx::Image& photo) {
+  // The profile's picture: the profile button, the profile menu and the
+  // profile picker all show it, as they do a Google account's.
+  ProfileManager* manager = g_browser_process->profile_manager();
+  ProfileAttributesEntry* entry =
+      manager ? manager->GetProfileAttributesStorage()
+                    .GetProfileAttributesWithPath(profile_->GetPath())
+              : nullptr;
+  if (entry) {
+    if (photo.IsEmpty()) {
+      entry->SetIsUsingGAIAPicture(false);
+      entry->SetGAIAPicture(std::string(), gfx::Image());
+    } else {
