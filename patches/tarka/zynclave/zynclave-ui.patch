+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AVATAR_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AVATAR_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "url/gurl.h"
+
+class SkBitmap;
+
+namespace gfx {
+class Image;
+}
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace tark_zynclave {
+
+struct Userinfo;
+
+// The signed-in account's photo. Fetched from userinfo's picture only when
+// it is on the Zynclave avatar CDN or Google's lh3-lh6, without cookies, at
+// most 512 KB; decoded out of process and kept, re-encoded as PNG, in
+// <profile>/Tark Zynclave/avatar.png. Deleted on sign-out.
+class ZynclaveAvatar {
+ public:
+  // Called with the new photo, or an empty image when there is none.
+  using ChangedCallback = base::RepeatingCallback<void(const gfx::Image&)>;
+
+  // Decodes image bytes into a bitmap (empty on failure). By default the
+  // data decoder service, out of process; tests give their own.
+  using DecodeCallback = base::OnceCallback<void(const SkBitmap&)>;
+  using Decoder =
+      base::RepeatingCallback<void(std::string bytes, DecodeCallback)>;
+
+  ZynclaveAvatar(scoped_refptr<network::SharedURLLoaderFactory> url_loaders,
+                 const base::FilePath& profile_dir,
+                 ChangedCallback on_changed,
+                 Decoder decoder = {});
+  ZynclaveAvatar(const ZynclaveAvatar&) = delete;
+  ZynclaveAvatar& operator=(const ZynclaveAvatar&) = delete;
+  ~ZynclaveAvatar();
+
+  // The account changed (null: signed out).
+  void Update(const Userinfo* account);
+
+  // data:image/png;base64,..., or empty.
+  std::string DataUrl() const;
+
+ private:
+  struct Stored {
+    std::string url;
+    std::string png;
+  };
+  void OnStored(GURL url, std::optional<Stored> stored);
+  void Fetch(GURL url);
+  void Forget(const GURL& url);
+  void OnFetched(GURL url, std::optional<std::string> body);
+  void OnDecoded(GURL url, bool from_disk, const SkBitmap& bitmap);
+  void Clear();
+
+  scoped_refptr<network::SharedURLLoaderFactory> url_loaders_;
+  const base::FilePath dir_;
+  ChangedCallback on_changed_;
+  Decoder decoder_;
+  scoped_refptr<base::SequencedTaskRunner> files_;
+
+  GURL url_;  // the photo being shown or fetched
+  std::string png_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::WeakPtrFactory<ZynclaveAvatar> weak_factory_{this};
+};
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_AVATAR_H_
