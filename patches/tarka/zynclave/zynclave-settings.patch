+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {TarkZynclaveCardElement} from './zynclave_card.js';
+
+export function getHtml(this: TarkZynclaveCardElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+${this.isAvailable_() ? html`
+<div id="zynclaveCard" class="cr-row first">
+  ${this.hasAccount_() ? html`
+    <div id="avatar" aria-hidden="true">
+      ${this.photo_() ? html`<img src="${this.photo_()}" alt="">`
+                      : html`<span>${this.initials_()}</span>`}
+    </div>
+    <div class="flex cr-padded-text">
+      <div id="name">${this.displayName_()}</div>
+      <div class="secondary">${this.subtitle_()}</div>
+      ${this.isStaging_() ? html`
+        <div class="secondary">$i18n{tarkZynclaveStaging}</div>` : ''}
+    </div>
+    ${this.needsSignInAgain_() ? html`
+      <cr-button id="signIn" class="action-button"
+          @click="${this.onSignInClick_}">
+        $i18n{tarkZynclaveSignInAgain}
+      </cr-button>
+    ` : html`
+      <cr-button id="changePhoto" @click="${this.onChangePhotoClick_}">
+        $i18n{tarkZynclaveChangePhoto}
+      </cr-button>
+      <cr-button id="signOut" @click="${this.onSignOutClick_}"
+          ?disabled="${this.isSigningIn_()}">
+        $i18n{tarkZynclaveSignOut}
+      </cr-button>
+    `}
+  ` : html`
+    <div class="flex cr-padded-text">
+      <div id="name">$i18n{tarkZynclaveSignIn}</div>
+      <div class="secondary">$i18n{tarkZynclaveSignInDesc}</div>
+      ${this.isStaging_() ? html`
+        <div class="secondary">$i18n{tarkZynclaveStaging}</div>` : ''}
+    </div>
+    <cr-button id="signIn" class="action-button"
+        @click="${this.onSignInClick_}">
+      $i18n{tarkZynclaveSignInButton}
+    </cr-button>
+  `}
+</div>
+<cr-dialog id="signOutDialog">
+  <div slot="title">$i18n{tarkZynclaveSignOutTitle}</div>
+  <div slot="body">$i18n{tarkZynclaveSignOutBody}</div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onCancelClick_}">
+      $i18n{cancel}
+    </cr-button>
+    <cr-button id="signOutTarkOnly" @click="${this.onSignOutChoiceClick_}">
+      $i18n{tarkZynclaveSignOutTarkOnly}
+    </cr-button>
+    <cr-button id="signOutEverywhere" class="action-button"
+        @click="${this.onSignOutChoiceClick_}">
+      $i18n{tarkZynclaveSignOutEverywhere}
+    </cr-button>
+  </div>
+</cr-dialog>
+` : ''}
+<!--_html_template_end_-->`;
+  // clang-format on
+}
