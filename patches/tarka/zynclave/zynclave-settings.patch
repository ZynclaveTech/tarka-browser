+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-tark-zynclave-card' is the Zynclave account at the
+ * top of Settings > Profile: "Sign in with Zynclave" when signed out; the
+ * photo, name and email, "Change photo" and "Sign out" when signed in; and
+ * "Sign in again" when Zynclave ended the sign-in. Hidden when the
+ * ZynclaveSignInAllowed policy is off and in profiles that have no account
+ * (Incognito, Guest).
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './zynclave_card.css.js';
+import {getHtml} from './zynclave_card.html.js';
+
+export interface ZynclaveAccount {
+  available: boolean;
+  state: 'signedOut'|'signingIn'|'signedIn'|'needsSignInAgain';
+  name: string;
+  email: string;
+  photo: string;
+  staging: boolean;
+}
+
+const TarkZynclaveCardElementBase =
+    WebUiListenerMixinLit(I18nMixinLit(CrLitElement));
+
+export class TarkZynclaveCardElement extends TarkZynclaveCardElementBase {
+  static get is() {
+    return 'settings-tark-zynclave-card';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      account_: {type: Object},
+    };
+  }
+
+  protected accessor account_: ZynclaveAccount|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'zynclave-account-changed',
+        (account: ZynclaveAccount) => this.account_ = account);
+    sendWithPromise<ZynclaveAccount>('getZynclaveAccount')
+        .then(account => this.account_ = account);
+  }
+
+  protected isAvailable_(): boolean {
+    return !!this.account_ && this.account_.available;
+  }
+
+  protected hasAccount_(): boolean {
+    return !!this.account_ && this.account_.state !== 'signedOut';
+  }
+
+  protected needsSignInAgain_(): boolean {
+    return !!this.account_ && this.account_.state === 'needsSignInAgain';
+  }
+
+  protected isSigningIn_(): boolean {
+    return !!this.account_ && this.account_.state === 'signingIn';
+  }
+
+  protected isStaging_(): boolean {
+    return !!this.account_ && this.account_.staging;
+  }
+
+  protected photo_(): string {
+    return this.account_ ? this.account_.photo : '';
+  }
+
+  // The email, or why the account needs signing in again.
+  protected subtitle_(): string {
+    if (!this.account_) {
+      return '';
+    }
+    return this.needsSignInAgain_() ?
+        this.i18n('tarkZynclaveSignInAgainDesc') :
+        this.account_.email;
+  }
+
+  protected displayName_(): string {
+    const a = this.account_;
+    if (!a) {
+      return '';
+    }
+    return a.name || a.email || this.i18n('tarkZynclaveAccountFallback');
+  }
+
+  // Up to two initials, for an account without a photo.
+  protected initials_(): string {
+    const words = this.displayName_().split(/[\s@._-]+/).filter(w => w);
+    return words.slice(0, 2).map(w => Array.from(w)[0].toUpperCase()).join('');
+  }
+
+  protected onSignInClick_() {
+    chrome.send('zynclaveSignIn');
+  }
+
+  protected onSignOutClick_() {
+    this.shadowRoot.querySelector<CrDialogElement>('#signOutDialog')!
+        .showModal();
+  }
+
+  protected onChangePhotoClick_() {
+    chrome.send('zynclaveChangePhoto');
+  }
+
+  protected onSignOutChoiceClick_(e: Event) {
+    const everywhere =
+        (e.currentTarget as HTMLElement).id === 'signOutEverywhere';
+    this.shadowRoot.querySelector<CrDialogElement>('#signOutDialog')!.close();
+    chrome.send('zynclaveSignOut', [everywhere]);
+  }
+
+  protected onCancelClick_() {
+    this.shadowRoot.querySelector<CrDialogElement>('#signOutDialog')!
+        .cancel();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-tark-zynclave-card': TarkZynclaveCardElement;
+  }
+}
+
+customElements.define(TarkZynclaveCardElement.is, TarkZynclaveCardElement);
