+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/tark_zynclave_handler.h"
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tark_zynclave/zynclave_config.h"
+#include "chrome/browser/tark_zynclave/zynclave_sign_in_service.h"
+#include "chrome/browser/tark_zynclave/zynclave_sign_in_service_factory.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/grit/generated_resources.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/webui/web_ui_util.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace settings {
+
+namespace {
+
+const char* StateName(tark_zynclave::ZynclaveState state) {
+  switch (state) {
+    case tark_zynclave::ZynclaveState::kSignedOut:
+      return "signedOut";
+    case tark_zynclave::ZynclaveState::kSigningIn:
+      return "signingIn";
+    case tark_zynclave::ZynclaveState::kSignedIn:
+      return "signedIn";
+    case tark_zynclave::ZynclaveState::kNeedsSignInAgain:
+      return "needsSignInAgain";
+  }
+}
+
+}  // namespace
+
+TarkZynclaveHandler::TarkZynclaveHandler(Profile* profile)
+    : profile_(profile) {}
+
+TarkZynclaveHandler::~TarkZynclaveHandler() = default;
+
+// static
+void TarkZynclaveHandler::AddStrings(content::WebUIDataSource* html_source) {
+  static constexpr webui::LocalizedString kStrings[] = {
+      {"tarkZynclaveSignIn", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_IN},
+      {"tarkZynclaveSignInDesc", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_IN_DESC},
+      {"tarkZynclaveSignInButton", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_IN_BUTTON},
+      {"tarkZynclaveSignInAgain", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_IN_AGAIN},
+      {"tarkZynclaveSignInAgainDesc",
+       IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_IN_AGAIN_DESC},
+      {"tarkZynclaveAccountFallback",
+       IDS_SETTINGS_TARK_ZYNCLAVE_ACCOUNT_FALLBACK},
+      {"tarkZynclaveChangePhoto", IDS_SETTINGS_TARK_ZYNCLAVE_CHANGE_PHOTO},
+      {"tarkZynclaveSignOut", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_OUT},
+      {"tarkZynclaveSignOutTitle", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_OUT_TITLE},
+      {"tarkZynclaveSignOutBody", IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_OUT_BODY},
+      {"tarkZynclaveSignOutTarkOnly",
+       IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_OUT_TARK_ONLY},
+      {"tarkZynclaveSignOutEverywhere",
+       IDS_SETTINGS_TARK_ZYNCLAVE_SIGN_OUT_EVERYWHERE},
+      {"tarkZynclaveStaging", IDS_SETTINGS_TARK_ZYNCLAVE_STAGING},
+  };
+  html_source->AddLocalizedStrings(kStrings);
+}
+
+void TarkZynclaveHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getZynclaveAccount",
+      base::BindRepeating(&TarkZynclaveHandler::HandleGetAccount,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "zynclaveSignIn", base::BindRepeating(&TarkZynclaveHandler::HandleSignIn,
+                                            base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "zynclaveSignOut",
+      base::BindRepeating(&TarkZynclaveHandler::HandleSignOut,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "zynclaveChangePhoto",
+      base::BindRepeating(&TarkZynclaveHandler::HandleChangePhoto,
+                          base::Unretained(this)));
+}
+
+void TarkZynclaveHandler::OnJavascriptAllowed() {
+  if (tark_zynclave::ZynclaveSignInService* s = service()) {
+    account_subscription_ = s->auth().AddObserver(base::BindRepeating(
+        &TarkZynclaveHandler::OnAccountChanged, base::Unretained(this)));
+  }
+}
+
+void TarkZynclaveHandler::OnJavascriptDisallowed() {
+  account_subscription_ = {};
+}
+
+tark_zynclave::ZynclaveSignInService* TarkZynclaveHandler::service() {
+  return tark_zynclave::ZynclaveSignInServiceFactory::GetForProfile(profile_);
+}
+
+base::DictValue TarkZynclaveHandler::Account() {
+  base::DictValue account;
+  tark_zynclave::ZynclaveSignInService* s = service();
+  account.Set("available", s && s->allowed());
+  account.Set("staging", tark_zynclave::GetZynclaveConfig().staging);
+  account.Set("state", StateName(s ? s->auth().state()
+                                   : tark_zynclave::ZynclaveState::kSignedOut));
+  const tark_zynclave::Userinfo* info = s ? s->auth().account() : nullptr;
+  account.Set("name", info ? info->name : std::string());
+  account.Set("email", info ? info->email : std::string());
+  // The photo comes with the avatar cache (zynclave-ui.patch).
+  account.Set("photo", std::string());
+  return account;
+}
+
+void TarkZynclaveHandler::HandleGetAccount(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], Account());
+}
+
+void TarkZynclaveHandler::HandleSignIn(const base::ListValue& args) {
+  tark_zynclave::ZynclaveSignInService* s = service();
+  if (s && s->allowed()) {
+    s->auth().StartSignIn(/*prompt_none=*/false);
+  }
+}
+
+void TarkZynclaveHandler::HandleSignOut(const base::ListValue& args) {
+  tark_zynclave::ZynclaveSignInService* s = service();
+  const bool everywhere = !args.empty() && args[0].is_bool() && args[0].GetBool();
+  if (s) {
+    s->auth().SignOut(everywhere);
+  }
+}
+
+void TarkZynclaveHandler::HandleChangePhoto(const base::ListValue& args) {
+  if (!service()) {
+    return;
+  }
+  // Zynclave's own account page, in a normal tab of this profile.
+  GURL url(base::StrCat({"https://",
+                         tark_zynclave::GetZynclaveConfig().accounts_host,
+                         "/settings"}));
+  NavigateParams params(profile_, url, ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+void TarkZynclaveHandler::OnAccountChanged() {
+  FireWebUIListener("zynclave-account-changed", Account());
+}
