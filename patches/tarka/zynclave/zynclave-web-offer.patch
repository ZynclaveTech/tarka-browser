+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/web_offer_rules.h"
+
+#include "chrome/browser/tark_zynclave/zynclave_auth.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace tark_zynclave {
+namespace {
+
+constexpr char kHost[] = "accounts.example.test";
+
+TEST(TarkZynclaveWebOffer, AccountsPages) {
+  EXPECT_TRUE(IsAccountsUrl(GURL("https://accounts.example.test/"), kHost));
+  EXPECT_TRUE(
+      IsAccountsUrl(GURL("https://accounts.example.test/settings"), kHost));
+  EXPECT_FALSE(IsAccountsUrl(GURL("http://accounts.example.test/"), kHost));
+  EXPECT_FALSE(IsAccountsUrl(GURL("https://example.test/"), kHost));
+  EXPECT_FALSE(
+      IsAccountsUrl(GURL("https://accounts.example.test.evil/"), kHost));
+}
+
+TEST(TarkZynclaveWebOffer, SignInScreens) {
+  for (const char* path :
+       {"/login", "/login/", "/login?flow=1", "/registration", "/recovery",
+        "/verification", "/error", "/oauth/consent", "/oauth/login"}) {
+    EXPECT_TRUE(IsSignInScreen(
+        GURL(std::string("https://accounts.example.test") + path), kHost))
+        << path;
+  }
+  for (const char* path : {"/", "/settings", "/loginx", "/sessions"}) {
+    EXPECT_FALSE(IsSignInScreen(
+        GURL(std::string("https://accounts.example.test") + path), kHost))
+        << path;
+  }
+  // Another site's /login is not Zynclave's sign-in screen.
+  EXPECT_FALSE(IsSignInScreen(GURL("https://shodhya.com/login"), kHost));
+}
+
+TEST(TarkZynclaveWebOffer, DeclineHashIsSaltedAndStable) {
+  const std::string a = DeclineHash("salt-1", "identity");
+  EXPECT_EQ(a, DeclineHash("salt-1", "identity"));
+  EXPECT_NE(a, DeclineHash("salt-2", "identity"));
+  EXPECT_NE(a, DeclineHash("salt-1", "other"));
+  EXPECT_EQ(a.size(), 64u);
+  EXPECT_EQ(a.find("identity"), std::string::npos);
+}
+
+TEST(TarkZynclaveWebOffer, ChecksOnlyWhenNotSignedIn) {
+  EXPECT_TRUE(MayCheck(/*allowed=*/true, ZynclaveState::kSignedOut));
+  EXPECT_TRUE(MayCheck(true, ZynclaveState::kNeedsSignInAgain));
+  EXPECT_FALSE(MayCheck(true, ZynclaveState::kSignedIn));
+  EXPECT_FALSE(MayCheck(true, ZynclaveState::kSigningIn));
+  EXPECT_FALSE(MayCheck(/*allowed=*/false, ZynclaveState::kSignedOut));
+}
+
+TEST(TarkZynclaveWebOffer, BubbleTitle) {
+  WhoamiResult who;
+  who.name = "Asha";
+  who.email = "asha@example.test";
+  EXPECT_EQ(OfferTitleName(who), u"Asha");
+  who.name.clear();
+  EXPECT_EQ(OfferTitleName(who), u"asha@example.test");
+  who.email.clear();
+  EXPECT_EQ(OfferTitleName(who), u"");
+  who.name = "Ev‮il";
+  EXPECT_EQ(OfferTitleName(who), u"Evil");
+}
+
+}  // namespace
+}  // namespace tark_zynclave
