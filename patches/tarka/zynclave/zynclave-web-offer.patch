+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/zynclave_web_offer.h"
+
+#include <set>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tark_zynclave/web_offer_rules.h"
+#include "chrome/browser/tark_zynclave/whoami_fetcher.h"
+#include "chrome/browser/tark_zynclave/zynclave_config.h"
+#include "chrome/browser/tark_zynclave/zynclave_offer_bubble.h"
+#include "chrome/browser/tark_zynclave/zynclave_prefs.h"
+// The service is built into //chrome/browser:core, which depends on this
+// target; a dep back would be a cycle.
+#include "chrome/browser/tark_zynclave/zynclave_sign_in_service.h"  // nogncheck
+#include "chrome/browser/tark_zynclave/zynclave_sign_in_service_factory.h"  // nogncheck
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "crypto/random.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+// Accounts offered in this run (by hash): at most once each.
+std::set<std::string>& OfferedThisRun() {
+  static base::NoDestructor<std::set<std::string>> offered;
+  return *offered;
+}
+
+Profile* ProfileOf(content::WebContents* contents) {
+  return Profile::FromBrowserContext(contents->GetBrowserContext());
+}
+
+// The profile's salt for "No thanks" hashes, made on first use.
+std::string Salt(PrefService* prefs) {
+  std::string salt = prefs->GetString(kSaltPref);
+  if (salt.empty()) {
+    salt = base::HexEncode(crypto::RandBytesAsVector(16));
+    prefs->SetString(kSaltPref, salt);
+  }
+  return salt;
+}
+
+}  // namespace
+
+// static
+void ZynclaveWebOffer::MaybeCreateForWebContents(
+    content::WebContents* contents) {
+  Profile* profile = ProfileOf(contents);
+  // No service for Incognito or Guest: no observer, no whoami, no offer.
+  if (!profile || profile->IsOffTheRecord() ||
+      !ZynclaveSignInServiceFactory::GetForProfile(profile)) {
+    return;
+  }
+  CreateForWebContents(contents);
+}
+
+ZynclaveWebOffer::ZynclaveWebOffer(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<ZynclaveWebOffer>(*contents) {}
+
+ZynclaveWebOffer::~ZynclaveWebOffer() = default;
+
+void ZynclaveWebOffer::DidStartNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && !handle->IsSameDocument()) {
+    settle_.Stop();
+  }
+}
+
+void ZynclaveWebOffer::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (!handle->IsInPrimaryMainFrame() || !handle->HasCommitted() ||
+      handle->IsSameDocument()) {
+    return;
+  }
+  const std::string& host = GetZynclaveConfig().accounts_host;
+  for (const GURL& url : handle->GetRedirectChain()) {
+    if (IsAccountsUrl(url, host)) {
+      marked_ = true;
+      VLOG(1) << "tark_zynclave offer: tab went through the account pages";
+    }
+  }
+}
+
+void ZynclaveWebOffer::DidStopLoading() {
+  if (!marked_ ||
+      IsSignInScreen(web_contents()->GetLastCommittedURL(),
+                     GetZynclaveConfig().accounts_host)) {
+    return;
+  }
+  VLOG(1) << "tark_zynclave offer: settling";
+  settle_.Start(FROM_HERE, kSettle,
+                base::BindOnce(&ZynclaveWebOffer::Check,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void ZynclaveWebOffer::Check() {
+  marked_ = false;
+  Profile* profile = ProfileOf(web_contents());
+  ZynclaveSignInService* service =
+      ZynclaveSignInServiceFactory::GetForProfile(profile);
+  if (checking_ || !service ||
+      !MayCheck(service->allowed(), service->auth().state())) {
+    VLOG(1) << "tark_zynclave offer: no check (signed in, off or busy)";
+    return;
+  }
+  VLOG(1) << "tark_zynclave offer: whoami";
+  checking_ = true;
+  FetchWhoami(
+      profile, GURL("https://" + GetZynclaveConfig().accounts_host + "/"),
+      base::BindOnce(&ZynclaveWebOffer::OnWhoami, weak_factory_.GetWeakPtr()));
+}
+
+void ZynclaveWebOffer::OnWhoami(WhoamiResult who) {
+  checking_ = false;
+  VLOG(1) << "tark_zynclave offer: whoami signed_in=" << who.signed_in;
+  if (!who.signed_in) {
+    return;
+  }
+  Profile* profile = ProfileOf(web_contents());
+  ZynclaveSignInService* service =
+      ZynclaveSignInServiceFactory::GetForProfile(profile);
+  if (!service || !MayCheck(service->allowed(), service->auth().state())) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  std::string hash = DeclineHash(Salt(prefs), who.id);
+  for (const base::Value& declined : prefs->GetList(kDeclinedPref)) {
+    if (declined.is_string() && declined.GetString() == hash) {
+      VLOG(1) << "tark_zynclave offer: declined before";
+      return;
+    }
+  }
+  if (OfferedThisRun().contains(hash)) {
+    VLOG(1) << "tark_zynclave offer: already offered in this run";
+    return;
+  }
+  VLOG(1) << "tark_zynclave offer: showing";
+  std::string email = who.email;
+  const bool shown = ShowZynclaveOfferBubble(
+      web_contents(), OfferTitleName(who),
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents, std::string email) {
+            if (!contents) {
+              return;
+            }
+            ZynclaveSignInService* s =
+                ZynclaveSignInServiceFactory::GetForProfile(
+                    ProfileOf(contents.get()));
+            // Signed in meanwhile (another window), or turned off.
+            if (!s || !MayCheck(s->allowed(), s->auth().state())) {
+              return;
+            }
+            if (email.empty()) {
+              // Nothing to hold the silent sign-in to: Zynclave's screen
+              // shows which account it is.
+              s->auth().StartSignIn(/*prompt_none=*/false);
+              return;
+            }
+            // Zynclave's web session, no screen; once more with one if it
+            // needs it. A different account comes back signed out.
+            s->auth().StartSignIn(/*prompt_none=*/true, email);
+          },
+          web_contents()->GetWeakPtr(), std::move(email)),
+      base::BindOnce(&ZynclaveWebOffer::Decline, weak_factory_.GetWeakPtr(),
+                     hash));
+  // Not shown (another tab came forward): the next visit offers again.
+  if (shown) {
+    OfferedThisRun().insert(std::move(hash));
+  }
+}
+
+void ZynclaveWebOffer::Decline(std::string hash) {
+  ScopedListPrefUpdate update(ProfileOf(web_contents())->GetPrefs(),
+                              kDeclinedPref);
+  update->Append(std::move(hash));
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ZynclaveWebOffer);
+
+}  // namespace tark_zynclave
