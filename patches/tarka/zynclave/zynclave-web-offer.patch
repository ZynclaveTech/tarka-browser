+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_zynclave/web_offer_rules.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/tark_zynclave/oidc.h"
+#include "chrome/browser/tark_zynclave/zynclave_auth.h"
+#include "crypto/hash.h"
+#include "url/gurl.h"
+
+namespace tark_zynclave {
+
+bool IsAccountsUrl(const GURL& url, std::string_view accounts_host) {
+  return url.is_valid() && url.SchemeIs(url::kHttpsScheme) &&
+         url.host() == accounts_host;
+}
+
+bool IsSignInScreen(const GURL& url, std::string_view accounts_host) {
+  if (!IsAccountsUrl(url, accounts_host)) {
+    return false;
+  }
+  const std::string_view path = url.path();
+  for (std::string_view screen :
+       {"/login", "/registration", "/recovery", "/verification", "/error"}) {
+    if (path == screen ||
+        (path.starts_with(screen) && path.size() > screen.size() &&
+         path[screen.size()] == '/')) {
+      return true;
+    }
+  }
+  return path.starts_with("/oauth/");
+}
+
+std::string DeclineHash(std::string_view salt, std::string_view identity_id) {
+  std::string input(salt);
+  input.push_back('\0');
+  input.append(identity_id);
+  return base::ToLowerASCII(base::HexEncode(crypto::hash::Sha256(input)));
+}
+
+bool MayCheck(bool allowed, ZynclaveState state) {
+  return allowed && (state == ZynclaveState::kSignedOut ||
+                     state == ZynclaveState::kNeedsSignInAgain);
+}
+
+std::u16string OfferTitleName(const WhoamiResult& who) {
+  std::string name = CleanDisplayText(who.name, 40);
+  if (name.empty()) {
+    name = CleanDisplayText(who.email, 64);
+  }
+  return base::UTF8ToUTF16(name);
+}
+
+}  // namespace tark_zynclave
