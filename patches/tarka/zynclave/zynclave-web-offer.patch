+// A page of the Zynclave Account on the web (https://<accounts host>/...).
+bool IsAccountsUrl(const GURL& url, std::string_view accounts_host);
+
+// One of its sign-in screens (/login, /registration, /recovery,
+// /verification, /error, /oauth/...): the offer never shows over them.
+bool IsSignInScreen(const GURL& url, std::string_view accounts_host);
+
+// What "No thanks" keeps: SHA-256 of a per-profile salt and the account's
+// identity id, in hex. The id itself is never stored.
