+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_WEB_OFFER_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_WEB_OFFER_H_
+
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/tark_zynclave/whoami_response.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace tark_zynclave {
+
+// "Sign in to Tark as X?" (handoff §2a, as Android's §5.6). A normal
+// profile's tab that goes through the Zynclave Account's pages is marked;
+// when it then rests for 3 seconds on a page that is not a sign-in screen,
+// Tark asks Zynclave once (whoami, with this profile's cookies) whether the
+// person is signed in there, and offers to sign Tark in as that account.
+// Never in Incognito or Guest (not attached), never while signed in, never
+// for an account declined with "No thanks", at most once per account per
+// run, and never without the person's click.
+class ZynclaveWebOffer : public content::WebContentsObserver,
+                         public content::WebContentsUserData<ZynclaveWebOffer> {
+ public:
+  static constexpr base::TimeDelta kSettle = base::Seconds(3);
+
+  // Attaches to tabs of normal profiles only.
+  static void MaybeCreateForWebContents(content::WebContents* contents);
+
+  ZynclaveWebOffer(const ZynclaveWebOffer&) = delete;
+  ZynclaveWebOffer& operator=(const ZynclaveWebOffer&) = delete;
+  ~ZynclaveWebOffer() override;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override;
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void DidStopLoading() override;
+
+ private:
+  friend class content::WebContentsUserData<ZynclaveWebOffer>;
+  explicit ZynclaveWebOffer(content::WebContents* contents);
+
+  void Check();
+  void OnWhoami(WhoamiResult who);
+  void Decline(std::string hash);
+
+  bool marked_ = false;
+  bool checking_ = false;
+  base::OneShotTimer settle_;
+  base::WeakPtrFactory<ZynclaveWebOffer> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_WEB_OFFER_H_
