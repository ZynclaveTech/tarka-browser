+
+#ifndef CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_FETCHER_H_
+#define CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_FETCHER_H_
+
+#include "base/functional/callback_forward.h"
+#include "chrome/browser/tark_zynclave/whoami_response.h"
+
+class GURL;
+class Profile;
+
+namespace tark_zynclave {
+
+using WhoamiCallback = base::OnceCallback<void(WhoamiResult)>;
+
+// "Sign in to Tark as X?" (spec §5.6): whether the Zynclave Account has a web
+// session in `profile`, from GET <accounts_origin>/sessions/whoami in that
+// profile's own network context, so the browser sends the profile's cookies
+// (Tark never reads them). An off-the-record profile makes no request and
+// answers not signed in. Anything but a 200 with a session (401, an error, a
+// redirect, a timeout after 10 s, a body over 64 KB) is not signed in.
+// `callback` runs on the UI thread, never synchronously.
+void FetchWhoami(Profile* profile,
+                 const GURL& accounts_origin,
+                 WhoamiCallback callback);
+
+}  // namespace tark_zynclave
+
+#endif  // CHROME_BROWSER_TARK_ZYNCLAVE_WHOAMI_FETCHER_H_
