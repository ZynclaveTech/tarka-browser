+#define CHROME_BROWSER_TARK_ZYNCLAVE_ZYNCLAVE_OFFER_BUBBLE_H_
+
+#include <string>
+
+#include "base/functional/callback_forward.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace tark_zynclave {
+
+// "Sign in to Tark as {name}?" under the address bar of the tab's window,
+// with [Sign in] and [No thanks]. Not shown if the tab is not the active
+// one. Closing it any other way decides nothing. Returns whether it showed.
+bool ShowZynclaveOfferBubble(content::WebContents* contents,
+                             const std::u16string& name,
+                             base::OnceClosure on_sign_in,
+                             base::OnceClosure on_no_thanks);
+
+}  // namespace tark_zynclave
