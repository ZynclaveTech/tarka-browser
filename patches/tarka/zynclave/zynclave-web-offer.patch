+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/location_bar/location_icon_view.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/bubble/bubble_dialog_model_host.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace tark_zynclave {
+
+namespace {
+
+// Closes the bubble when its tab stops being the one shown (another tab, or
+// the tab closed), so it never sits over a page it is not about. Owned by
+// the bubble's widget's lifetime: deletes itself when the widget goes.
+class CloseWithTab : public views::WidgetObserver {
+ public:
+  CloseWithTab(tabs::TabInterface* tab, views::Widget* widget)
+      : widget_(widget) {
+    widget_->AddObserver(this);
+    deactivate_ = tab->RegisterWillDeactivate(base::BindRepeating(
+        &CloseWithTab::Close, base::Unretained(this)));
+    detach_ = tab->RegisterWillDetach(base::BindRepeating(
+        [](CloseWithTab* self, tabs::TabInterface* tab,
+           tabs::TabInterface::DetachReason) { self->Close(tab); },
+        base::Unretained(this)));
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override {
+    widget_->RemoveObserver(this);
+    delete this;
+  }
+
+ private:
+  void Close(tabs::TabInterface*) {
+    deactivate_ = {};
+    detach_ = {};
+    widget_->Close();  // decides nothing, like any other close
+  }
+
+  raw_ptr<views::Widget> widget_;
+  base::CallbackListSubscription deactivate_;
+  base::CallbackListSubscription detach_;
+};
+
+}  // namespace
+
+bool ShowZynclaveOfferBubble(content::WebContents* contents,
+                             const std::u16string& name,
+                             base::OnceClosure on_sign_in,
+                             base::OnceClosure on_no_thanks) {
+  tabs::TabInterface* tab = tabs::TabInterface::MaybeGetFromContents(contents);
+  if (!tab || !tab->IsActivated() || !tab->GetBrowserWindowInterface()) {
+    VLOG(1) << "tark_zynclave offer: tab not active";
+    return false;
+  }
+  BrowserView* browser_view =
+      BrowserView::GetBrowserViewForBrowser(tab->GetBrowserWindowInterface());
+  // Under the site icon at the start of the address bar.
+  LocationBarView* location_bar =
+      browser_view ? browser_view->GetLocationBarView() : nullptr;
+  views::View* anchor = location_bar && location_bar->location_icon_view()
+                            ? static_cast<views::View*>(
+                                  location_bar->location_icon_view())
+                            : location_bar;
+  if (!anchor || !anchor->GetWidget() || !anchor->GetWidget()->IsVisible()) {
+    VLOG(1) << "tark_zynclave offer: no address bar to anchor to";
+    return false;
+  }
+  std::u16string title =
+      name.empty()
+          ? l10n_util::GetStringUTF16(IDS_TARK_ZYNCLAVE_OFFER_TITLE_GENERIC)
+          : l10n_util::GetStringFUTF16(IDS_TARK_ZYNCLAVE_OFFER_TITLE, name);
+  auto model =
+      ui::DialogModel::Builder()
+          .SetTitle(std::move(title))
+          .AddParagraph(ui::DialogModelLabel(
+              l10n_util::GetStringUTF16(IDS_TARK_ZYNCLAVE_OFFER_BODY)))
+          .AddOkButton(std::move(on_sign_in),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               IDS_TARK_ZYNCLAVE_OFFER_SIGN_IN)))
+          .AddCancelButton(std::move(on_no_thanks),
+                           ui::DialogModel::Button::Params().SetLabel(
+                               l10n_util::GetStringUTF16(
+                                   IDS_TARK_ZYNCLAVE_OFFER_NO_THANKS)))
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(model), anchor, views::BubbleBorder::TOP_LEFT);
+  // It stays until the person answers: a click elsewhere on the page would
+  // otherwise close it before it is read, and it is offered once a run.
+  bubble->set_close_on_deactivate(false);
+  views::Widget* widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  new CloseWithTab(tab, widget);
+  widget->Show();
+  return true;
+}
+
+}  // namespace tark_zynclave
