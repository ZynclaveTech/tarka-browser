+caption: Allow Sign in with Zynclave
+default: true
+desc: |-
+  Controls whether people can sign in to <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> with a Zynclave Account.
+
+  When this policy is set to Enabled or not set, people can sign in from Settings > Profile, and <ph name="PRODUCT_NAME">$1<ex>Google Chrome</ex></ph> may offer to sign in after they visit Zynclave's account pages.
+
+  When this policy is set to Disabled, there is no sign-in, no offer and no request to Zynclave, and an account already signed in is signed out on this device.
+example_value: false
+features:
+  dynamic_refresh: true
+  per_profile: true
