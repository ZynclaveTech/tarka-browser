--- a/chrome/browser/tark_zynclave/zynclave_auth_unittest.cc
+++ b/chrome/browser/tark_zynclave/zynclave_auth_unittest.cc
@@ -455,3 +455,35 @@
 
 }  // namespace
 }  // namespace tark_zynclave
+
+namespace tark_zynclave {
+namespace {
+
+// The ZynclaveSignInAllowed policy turned off: forgotten here, no request.
+TEST_F(TarkZynclaveAuth, PolicyOffSignsOutLocally) {
+  auto auth = MakeAuth();
+  SignIn(*auth);
+  auth->SignOutLocally();
+  task_env_.RunUntilIdle();
+  EXPECT_EQ(auth->state(), ZynclaveState::kSignedOut);
+  EXPECT_FALSE(auth->account());
+  EXPECT_TRUE(prefs_.GetString(kTokensPref).empty());
+  EXPECT_EQ(loaders_.NumPending(), 0);
+  EXPECT_EQ(opened_.size(), 1u);
+}
+
+TEST_F(TarkZynclaveAuth, PolicyOffForgetsPendingSignIns) {
+  auto auth = MakeAuth();
+  auto [state, nonce] = Start(*auth);
+  auth->SignOutLocally();
+  EXPECT_FALSE(auth->HandleRedirect(Redirect("code=c&state=" + state)));
+}
+
+TEST(TarkZynclavePrefs, AllowedByDefault) {
+  TestingPrefServiceSimple prefs;
+  RegisterZynclavePrefs(prefs.registry());
+  EXPECT_TRUE(prefs.GetBoolean(kAllowedPref));
+}
+
+}  // namespace
+}  // namespace tark_zynclave
