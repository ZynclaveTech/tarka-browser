+std::u16string ConvertScriptForDisplay(std::u16string_view text, Script from, Script to) {
+  if (from == Script::kLatin || to == Script::kLatin || from == to) {
+    return std::u16string(text);
+  }
+  // Letters with no counterpart at the same offset: the nearest one.
+  static constexpr struct {
+    char16_t from;
+    Script to;
+    std::u16string_view letters;
+  } kNearest[] = {
+      // Into Bengali.
+      {u'ன', Script::kBengali, u"ন"},  {u'ற', Script::kBengali, u"র"},
+      {u'ள', Script::kBengali, u"ল"},  {u'ழ', Script::kBengali, u"ল"},
+      {u'வ', Script::kBengali, u"ব"},  {u'எ', Script::kBengali, u"এ"},
+      {u'ஒ', Script::kBengali, u"ও"},  {u'ெ', Script::kBengali, u"ে"},
+      {u'ொ', Script::kBengali, u"ো"},  {u'व', Script::kBengali, u"ব"},
+      {u'ळ', Script::kBengali, u"ল"},  {u'ऑ', Script::kBengali, u"ও"},
+      {u'ॉ', Script::kBengali, u"ো"},  {u'ॅ', Script::kBengali, u"ে"},
+      {u'ऎ', Script::kBengali, u"এ"},  {u'ॆ', Script::kBengali, u"ে"},
+      {u'\u0929', Script::kBengali, u"ন"}, {u'\u0931', Script::kBengali, u"র"},
+      {u'\u0934', Script::kBengali, u"ল"},
+      // Into Tamil.
+      {u'ँ', Script::kTamil, u"ம்"},    {u'ृ', Script::kTamil, u"ு"},
+      {u'ऋ', Script::kTamil, u"ரு"},   {u'\u093C', Script::kTamil, u""},
+      {u'ॉ', Script::kTamil, u"ொ"},    {u'ॅ', Script::kTamil, u"ெ"},
+      {u'ऑ', Script::kTamil, u"ஒ"},    {u'ঁ', Script::kTamil, u"ம்"},
+      {u'\u09BC', Script::kTamil, u""}, {u'ৃ', Script::kTamil, u"ு"},
+      {u'ঋ', Script::kTamil, u"ரு"},   {u'ৎ', Script::kTamil, u"த்"},
+      {u'\u09DC', Script::kTamil, u"ட"}, {u'\u09DD', Script::kTamil, u"ட"},
+      {u'\u09DF', Script::kTamil, u"ய"}, {u'\u095C', Script::kTamil, u"ட"},
+      {u'\u095D', Script::kTamil, u"ட"},
+      // Into Devanagari.
+      {u'ৎ', Script::kDevanagari, u"त्"},
+  };
+  // Composite nukta letters: their base letter first (the nukta follows).
+  static constexpr std::pair<char16_t, std::u16string_view> kComposites[] = {
+      {0x0958, u"क\u093C"}, {0x0959, u"ख\u093C"}, {0x095A, u"ग\u093C"},
+      {0x095B, u"ज\u093C"}, {0x095E, u"फ\u093C"}, {0x095F, u"य\u093C"},
+  };
+  std::u16string source;
+  for (char16_t c : text) {
+    bool decomposed = false;
+    for (const auto& [composite, letters] : kComposites) {
+      if (c == composite) {
+        source += letters;
+        decomposed = true;
+      }
+    }
+    if (!decomposed) {
+      source += c;
+    }
+  }
+  std::u16string out;
+  for (char16_t c : source) {
+    bool done = false;
+    for (const auto& n : kNearest) {
+      if (n.from == c && n.to == to) {
+        out += n.letters;
+        done = true;
+        break;
+      }
+    }
+    if (done) {
+      continue;
+    }
+    const std::u16string converted = ConvertScript(std::u16string(1, c), from, to);
+    // Still no letter there: keep the original rather than an empty box.
+    out += u_isdefined(converted[0]) ? converted : std::u16string(1, c);
+  }
+  return out;
+}
