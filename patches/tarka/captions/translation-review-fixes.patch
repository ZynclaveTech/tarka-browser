+// "Show their words in" another Indian script: offsets that land on empty
+// code points (Tamil has no voiced plosives, Bengali no ன ற ழ வ...) are
+// replaced by the nearest letter, never shown as empty boxes.
+TEST(IndicTextTest, DisplayConversionHasNoEmptyLetters) {
+  const Script kScripts[] = {Script::kDevanagari, Script::kTamil, Script::kBengali};
+  const char16_t kStart[] = {0x0900, 0x0B80, 0x0980};
+  for (int from = 0; from < 3; ++from) {
+    std::u16string every;
+    for (char16_t c = kStart[from]; c <= kStart[from] + 0x6F; ++c) {
+      if (u_isdefined(c)) {
+        every += c;
+      }
+    }
+    std::vector<std::u16string> inputs = {every};
+    base::ListValue cases = Cases();
+    for (const base::Value& v : cases) {
+      if (ScriptOf(LanguageOf(v.GetDict())) == kScripts[from]) {
+        inputs.push_back(base::UTF8ToUTF16(*v.GetDict().FindString("caption")));
+      }
+    }
+    for (int to = 0; to < 3; ++to) {
+      if (to == from) {
+        continue;
+      }
+      for (const std::u16string& input : inputs) {
+        for (char16_t c : ConvertScriptForDisplay(input, kScripts[from], kScripts[to])) {
+          EXPECT_TRUE(u_isdefined(c)) << "U+" << std::hex << static_cast<int>(c) << " from "
+                                      << from << " to " << to;
+        }
+      }
+    }
+  }
+}
+
+TEST(IndicTextTest, DisplayConversionKeepsCommonLetters) {
+  EXPECT_EQ(ConvertScriptForDisplay(u"நன்றி", Script::kTamil, Script::kBengali), u"নন্রি");
+  EXPECT_EQ(ConvertScriptForDisplay(u"विकास", Script::kDevanagari, Script::kBengali), u"বিকাস");
+}
+
 }  // namespace
