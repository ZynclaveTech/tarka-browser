@@ -0,0 +1,199 @@
+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// libtark_apple_speech.dylib through its C entry points, as the browser loads
+// it (dlopen). macOS 26 only; the Spanish tests need es_US speech and the
+// Spanish→English translation installed.
+
+#include "chrome/browser/tark_captions/apple/tark_apple_speech.h"
+
+#include <dlfcn.h>
+
+#include <atomic>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_helpers.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/mac/mac_util.h"
+#include "base/path_service.h"
+#include "base/synchronization/lock.h"
+#include "base/test/run_until.h"
+#include "base/test/task_environment.h"
+#include "components/tark_captions/test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+// What the library calls back with, from any thread. Each callback wakes
+// the test's thread (as the browser posts each one to its own).
+struct Calls {
+  void Wake() { runner->PostTask(FROM_HERE, base::DoNothing()); }
+
+  scoped_refptr<base::SequencedTaskRunner> runner =
+      base::SequencedTaskRunner::GetCurrentDefault();
+  base::Lock lock;
+  std::vector<std::string> finals;
+  int drafts = 0;
+  std::atomic<int> failed{0};
+  std::atomic<bool> stopped{false};
+  std::atomic<int> status{-1};
+  std::atomic<bool> translated{false};
+  std::string translation;
+};
+
+Calls* CallsOf(void* ctx) {
+  return static_cast<Calls*>(ctx);
+}
+
+class TarkAppleSpeechTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    if (base::mac::MacOSMajorVersion() < 26) {
+      GTEST_SKIP() << "macOS 26 or later";
+    }
+    base::FilePath dir;
+    ASSERT_TRUE(base::PathService::Get(base::DIR_EXE, &dir));
+    library_ = dlopen(dir.Append("libtark_apple_speech.dylib").value().c_str(),
+                      RTLD_NOW | RTLD_LOCAL);
+    ASSERT_TRUE(library_) << dlerror();
+  }
+
+  void TearDown() override {
+    // The library's tasks may outlive a test; it stays loaded.
+  }
+
+  template <typename F>
+  F Symbol(const char* name) {
+    return reinterpret_cast<F>(dlsym(library_, name));
+  }
+
+  // es_US speech installed (2), or the test is skipped.
+  bool SpanishInstalled() {
+    Calls calls;
+    Symbol<decltype(&tark_apple_locale_status)>("tark_apple_locale_status")(
+        "es_US", &calls, [](void* ctx, int status) {
+          CallsOf(ctx)->status = status;
+          CallsOf(ctx)->Wake();
+        });
+    EXPECT_TRUE(base::test::RunUntil([&] { return calls.status >= 0; }));
+    return calls.status == 2;
+  }
+
+  // Feeds the Spanish test clip, then stops.
+  void TranscribeSpanish(Calls* calls) {
+    std::optional<base::FilePath> testdata = tark_captions::test::TestDataDir();
+    ASSERT_TRUE(testdata) << "set TARK_CAPTIONS_TESTDATA";
+    int rate = 0;
+    std::vector<float> pcm =
+        tark_captions::test::ReadWav(testdata->AppendASCII("lid/es_1.wav"), &rate);
+    ASSERT_EQ(rate, 16000);
+    void* t = Symbol<decltype(&tark_apple_transcriber_start)>("tark_apple_transcriber_start")(
+        "es_US", calls,
+        [](void* ctx, int is_final, const char* text) {
+          base::AutoLock lock(CallsOf(ctx)->lock);
+          if (is_final) {
+            CallsOf(ctx)->finals.push_back(text);
+          } else {
+            ++CallsOf(ctx)->drafts;
+          }
+        },
+        [](void* ctx, int code) {
+          CallsOf(ctx)->failed = code;
+          CallsOf(ctx)->Wake();
+        });
+    auto append =
+        Symbol<decltype(&tark_apple_transcriber_append)>("tark_apple_transcriber_append");
+    for (size_t i = 0; i < pcm.size(); i += 1600) {
+      append(t, pcm.data() + i, static_cast<int>(std::min<size_t>(1600, pcm.size() - i)));
+    }
+    // Stopped straight after the last audio: the last words still come.
+    Symbol<decltype(&tark_apple_transcriber_stop)>("tark_apple_transcriber_stop")(
+        t, [](void* ctx) {
+          CallsOf(ctx)->stopped = true;
+          CallsOf(ctx)->Wake();
+        });
+    ASSERT_TRUE(base::test::RunUntil([&] { return calls->stopped.load(); }));
+  }
+
+  // The UI thread runs a CFRunLoop, as the browser's does: Apple's
+  // translation answers only then.
+  base::test::TaskEnvironment env_{base::test::TaskEnvironment::MainThreadType::UI,
+                                   base::test::TaskEnvironment::TimeSource::SYSTEM_TIME};
+  void* library_ = nullptr;
+};
+
+TEST_F(TarkAppleSpeechTest, ExportsTheEntryPoints) {
+  for (const char* name :
+       {"tark_apple_available", "tark_apple_locale_status", "tark_apple_install",
+        "tark_apple_transcriber_start", "tark_apple_transcriber_append",
+        "tark_apple_transcriber_stop", "tark_apple_translation_status", "tark_apple_translate"}) {
+    EXPECT_TRUE(dlsym(library_, name)) << name;
+  }
+  EXPECT_EQ(Symbol<decltype(&tark_apple_available)>("tark_apple_available")(), 1);
+}
+
+TEST_F(TarkAppleSpeechTest, UnknownLocaleIsUnsupported) {
+  Calls calls;
+  Symbol<decltype(&tark_apple_locale_status)>("tark_apple_locale_status")(
+      "xx_XX", &calls, [](void* ctx, int status) {
+          CallsOf(ctx)->status = status;
+          CallsOf(ctx)->Wake();
+        });
+  ASSERT_TRUE(base::test::RunUntil([&] { return calls.status >= 0; }));
+  EXPECT_EQ(calls.status, 0);
+}
+
+TEST_F(TarkAppleSpeechTest, TranscribesSpanish) {
+  if (!SpanishInstalled()) {
+    GTEST_SKIP() << "es_US speech is not installed";
+  }
+  Calls calls;
+  TranscribeSpanish(&calls);
+  base::AutoLock lock(calls.lock);
+  EXPECT_EQ(calls.failed, 0);
+  EXPECT_GT(calls.drafts, 0);
+  std::string all;
+  for (const std::string& f : calls.finals) {
+    all += f + " ";
+  }
+  EXPECT_NE(all.find("civilizaci"), std::string::npos) << all;
+}
+
+TEST_F(TarkAppleSpeechTest, StopFlushesFinal) {
+  if (!SpanishInstalled()) {
+    GTEST_SKIP() << "es_US speech is not installed";
+  }
+  Calls calls;
+  TranscribeSpanish(&calls);
+  base::AutoLock lock(calls.lock);
+  EXPECT_FALSE(calls.finals.empty());
+}
+
+TEST_F(TarkAppleSpeechTest, TranslatesSpanishToEnglish) {
+  Calls calls;
+  Symbol<decltype(&tark_apple_translation_status)>("tark_apple_translation_status")(
+      "es", "en", &calls, [](void* ctx, int status) {
+          CallsOf(ctx)->status = status;
+          CallsOf(ctx)->Wake();
+        });
+  ASSERT_TRUE(base::test::RunUntil([&] { return calls.status >= 0; }));
+  if (calls.status != 2) {
+    GTEST_SKIP() << "Spanish→English translation is not installed";
+  }
+  Symbol<decltype(&tark_apple_translate)>("tark_apple_translate")(
+      "es", "en", "El clima de hoy es soleado y agradable.", &calls,
+      [](void* ctx, int ok, const char* text) {
+        base::AutoLock lock(CallsOf(ctx)->lock);
+        CallsOf(ctx)->translation = ok && text ? text : "";
+        CallsOf(ctx)->translated = true;
+        CallsOf(ctx)->Wake();
+      });
+  ASSERT_TRUE(base::test::RunUntil([&] { return calls.translated.load(); }));
+  base::AutoLock lock(calls.lock);
+  EXPECT_NE(calls.translation.find("sunny"), std::string::npos) << calls.translation;
+}
