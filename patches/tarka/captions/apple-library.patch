+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_TARK_CAPTIONS_APPLE_TARK_APPLE_SPEECH_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_APPLE_TARK_APPLE_SPEECH_H_
+
+// Tark (D4 Phase 3): the C entry points of libtark_apple_speech.dylib, a
+// small Swift library over macOS 26's on-device speech (SpeechAnalyzer,
+// SpeechTranscriber, AssetInventory) and Translation (TranslationSession).
+// Chromium's Mac toolchain builds no Swift, so Xcode's swiftc builds it
+// (build_swift_dylib.py) and the browser dlopens it on macOS 26 and later.
+//
+// Callbacks come on any thread; callers hop to their own. Strings are UTF-8.
+// Locales are identifiers such as "es_US"; languages are codes such as "es".
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void (*tark_apple_status_fn)(void* ctx, int status);
+typedef void (*tark_apple_progress_fn)(void* ctx, double fraction);
+typedef void (*tark_apple_done_fn)(void* ctx, int ok);
+typedef void (*tark_apple_result_fn)(void* ctx, int is_final, const char* text);
+typedef void (*tark_apple_failed_fn)(void* ctx, int code);
+typedef void (*tark_apple_stopped_fn)(void* ctx);
+typedef void (*tark_apple_text_fn)(void* ctx, int ok, const char* text);
+
+// 1 when this Mac's speech can transcribe (macOS 26 and later).
+int tark_apple_available(void);
+
+// The locale's speech: 0 unsupported, 1 supported (needs installing),
+// 2 installed.
+void tark_apple_locale_status(const char* locale, void* ctx, tark_apple_status_fn done);
+
+// Has macOS download and install the locale's speech; `progress` from 0 to
+// 1 meanwhile, then `done` once.
+void tark_apple_install(const char* locale,
+                        void* ctx,
+                        tark_apple_progress_fn progress,
+                        tark_apple_done_fn done);
+
+// Starts transcribing: `result` for each draft (is_final 0) and final, or
+// `failed` once. The handle takes audio until stopped.
+void* tark_apple_transcriber_start(const char* locale,
+                                   void* ctx,
+                                   tark_apple_result_fn result,
+                                   tark_apple_failed_fn failed);
+// 16 kHz mono audio.
+void tark_apple_transcriber_append(void* transcriber, const float* pcm16k, int count);
+// Flushes the last words, frees the handle, then calls `stopped`: the last
+// call with this transcriber's ctx.
+void tark_apple_transcriber_stop(void* transcriber, tark_apple_stopped_fn stopped);
+
+// Translation between two languages: 0 unsupported, 1 supported (the user
+// adds it in System Settings), 2 installed.
+void tark_apple_translation_status(const char* from,
+                                   const char* to,
+                                   void* ctx,
+                                   tark_apple_status_fn done);
+void tark_apple_translate(const char* from,
+                          const char* to,
+                          const char* text,
+                          void* ctx,
+                          tark_apple_text_fn done);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_APPLE_TARK_APPLE_SPEECH_H_
