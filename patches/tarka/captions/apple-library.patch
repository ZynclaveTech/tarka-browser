+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tark (D4 Phase 3): macOS 26's on-device speech and translation behind the C
+// entry points in tark_apple_speech.h. Built by Xcode's swiftc (see
+// build_swift_dylib.py); never logs what was said.
+
+import AVFoundation
+import Foundation
+import Speech
+import Translation
+
+public typealias StatusFn = @convention(c) (UnsafeMutableRawPointer?, Int32) -> Void
+public typealias ProgressFn = @convention(c) (UnsafeMutableRawPointer?, Double) -> Void
+public typealias DoneFn = @convention(c) (UnsafeMutableRawPointer?, Int32) -> Void
+public typealias ResultFn = @convention(c) (UnsafeMutableRawPointer?, Int32, UnsafePointer<CChar>?) -> Void
+public typealias FailedFn = @convention(c) (UnsafeMutableRawPointer?, Int32) -> Void
+public typealias StoppedFn = @convention(c) (UnsafeMutableRawPointer?) -> Void
+public typealias TextFn = @convention(c) (UnsafeMutableRawPointer?, Int32, UnsafePointer<CChar>?) -> Void
+
+// A caller's context crosses into tasks as bits: the library never reads it.
+private func bits(_ ctx: UnsafeMutableRawPointer?) -> UInt { UInt(bitPattern: ctx) }
+private func ptr(_ bits: UInt) -> UnsafeMutableRawPointer? { UnsafeMutableRawPointer(bitPattern: bits) }
+
+private func makeTranscriber(_ locale: String) -> SpeechTranscriber {
+  // Drafts (volatile) and quick finals: without .fastResults nothing streams.
+  SpeechTranscriber(
+    locale: Locale(identifier: locale), transcriptionOptions: [],
+    reportingOptions: [.volatileResults, .fastResults], attributeOptions: [])
+}
+
+private func contains(_ locales: [Locale], _ identifier: String) -> Bool {
+  let wanted = Locale(identifier: identifier).identifier(.bcp47)
+  return locales.contains { $0.identifier(.bcp47) == wanted }
+}
+
+@_cdecl("tark_apple_available")
+public func tark_apple_available() -> Int32 {
+  SpeechTranscriber.isAvailable ? 1 : 0
+}
+
+@_cdecl("tark_apple_locale_status")
+public func tark_apple_locale_status(
+  _ locale: UnsafePointer<CChar>, _ ctx: UnsafeMutableRawPointer?, _ done: StatusFn
+) {
+  let identifier = String(cString: locale)
+  let context = bits(ctx)
+  Task {
+    let status: Int32
+    if contains(await SpeechTranscriber.installedLocales, identifier) {
+      status = 2
+    } else if contains(await SpeechTranscriber.supportedLocales, identifier) {
+      status = 1
+    } else {
+      status = 0
+    }
+    done(ptr(context), status)
+  }
+}
+
+@_cdecl("tark_apple_install")
+public func tark_apple_install(
+  _ locale: UnsafePointer<CChar>, _ ctx: UnsafeMutableRawPointer?, _ progress: ProgressFn,
+  _ done: DoneFn
+) {
+  let identifier = String(cString: locale)
+  let context = bits(ctx)
+  Task {
+    var ok: Int32 = 1
+    var watch: Task<Void, Never>? = nil
+    do {
+      if let request = try await AssetInventory.assetInstallationRequest(
+        supporting: [makeTranscriber(identifier)])
+      {
+        watch = Task {
+          while !Task.isCancelled {
+            progress(ptr(context), request.progress.fractionCompleted)
+            try? await Task.sleep(for: .milliseconds(500))
+          }
+        }
+        try await request.downloadAndInstall()
+      }
+    } catch {
+      ok = 0
+    }
+    // No progress after `done`: done is the caller's last use of ctx.
+    watch?.cancel()
+    await watch?.value
+    if ok == 1 {
+      progress(ptr(context), 1)
+    }
+    done(ptr(context), ok)
+  }
+}
+
+// One call's transcription: audio in through `append`, drafts and finals
+// out through `result`. State lives on `queue`.
+final class Transcriber: @unchecked Sendable {
+  private let context: UInt
+  private let result: ResultFn
+  private let failed: FailedFn
+  private let queue = DispatchQueue(label: "tark.apple.transcriber")
+  private let stream: AsyncStream<AnalyzerInput>
+  private let input: AsyncStream<AnalyzerInput>.Continuation
+  private let module: SpeechTranscriber
+  private let analyzer: SpeechAnalyzer
+  private let source = AVAudioFormat(
+    commonFormat: .pcmFormatFloat32, sampleRate: 16000, channels: 1, interleaved: false)!
+  private var converter: AVAudioConverter?
+  private var target: AVAudioFormat?
+  private var pending: [Float] = []  // Audio that came before the analyzer was ready.
+  private var setup: Task<Void, Never>?
+  private var reader: Task<Void, Never>?
+  private var reportedFailure = false
+  private var stopping = false
+
+  init(locale: String, ctx: UnsafeMutableRawPointer?, result: ResultFn, failed: FailedFn) {
+    context = bits(ctx)
+    self.result = result
+    self.failed = failed
+    (stream, input) = AsyncStream<AnalyzerInput>.makeStream()
+    module = makeTranscriber(locale)
+    analyzer = SpeechAnalyzer(modules: [module])
+    setup = Task { await self.prepare() }
+  }
+
+  private func fail(_ code: Int32) {
+    queue.sync {
+      if reportedFailure { return }
+      reportedFailure = true
+      failed(ptr(context), code)
+    }
+  }
+
+  private func prepare() async {
+    guard let format = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [module]),
+      let converter = AVAudioConverter(from: source, to: format)
+    else {
+      fail(1)
+      return
+    }
+    do {
+      try await analyzer.prepareToAnalyze(in: format)
+      reader = Task {
+        do {
+          for try await r in module.results {
+            String(r.text.characters).withCString { result(ptr(context), r.isFinal ? 1 : 0, $0) }
+          }
+        } catch {
+          fail(2)
+        }
+      }
+      try await analyzer.start(inputSequence: stream)
+    } catch {
+      fail(1)
+      return
+    }
+    queue.sync {
+      self.target = format
+      self.converter = converter
+      let waiting = pending
+      pending = []
+      feed(waiting)
+    }
+  }
+
+  func append(_ samples: [Float]) {
+    queue.async {
+      // Stopped, or failed: nothing will read it, so nothing is kept.
+      if self.stopping || self.reportedFailure {
+        self.pending.removeAll()
+        return
+      }
+      if self.converter == nil {
+        self.pending += samples
+      } else {
+        self.feed(samples)
+      }
+    }
+  }
+
+  // On `queue`.
+  private func feed(_ samples: [Float]) {
+    guard !samples.isEmpty, let converter, let target,
+      let buffer = AVAudioPCMBuffer(pcmFormat: source, frameCapacity: AVAudioFrameCount(samples.count))
+    else { return }
+    buffer.frameLength = AVAudioFrameCount(samples.count)
+    samples.withUnsafeBufferPointer { buffer.floatChannelData![0].update(from: $0.baseAddress!, count: samples.count) }
+    let ratio = target.sampleRate / source.sampleRate
+    guard
+      let out = AVAudioPCMBuffer(
+        pcmFormat: target, frameCapacity: AVAudioFrameCount(Double(samples.count) * ratio) + 32)
+    else { return }
+    var consumed = false
+    var error: NSError?
+    converter.convert(to: out, error: &error) { _, status in
+      if consumed {
+        status.pointee = .noDataNow
+        return nil
+      }
+      consumed = true
+      status.pointee = .haveData
+      return buffer
+    }
+    if error == nil && out.frameLength > 0 {
+      input.yield(AnalyzerInput(buffer: out))
+    }
+  }
+
+  func stop(_ stopped: StoppedFn) {
+    Task {
+      // Audio that came before the analyzer was ready is fed when it is: the
+      // input ends only after that.
+      await self.setup?.value
+      self.queue.sync {
+        self.stopping = true
+        self.input.finish()
+      }
+      try? await self.analyzer.finalizeAndFinishThroughEndOfInput()
+      await self.reader?.value
+      stopped(ptr(self.context))
+    }
+  }
+}
+
+@_cdecl("tark_apple_transcriber_start")
+public func tark_apple_transcriber_start(
+  _ locale: UnsafePointer<CChar>, _ ctx: UnsafeMutableRawPointer?, _ result: ResultFn,
+  _ failed: FailedFn
+) -> UnsafeMutableRawPointer {
+  let transcriber = Transcriber(
+    locale: String(cString: locale), ctx: ctx, result: result, failed: failed)
+  return Unmanaged.passRetained(transcriber).toOpaque()
+}
+
+@_cdecl("tark_apple_transcriber_append")
+public func tark_apple_transcriber_append(
+  _ handle: UnsafeMutableRawPointer, _ pcm16k: UnsafePointer<Float>, _ count: Int32
+) {
+  let transcriber = Unmanaged<Transcriber>.fromOpaque(handle).takeUnretainedValue()
+  transcriber.append(Array(UnsafeBufferPointer(start: pcm16k, count: Int(count))))
+}
+
+@_cdecl("tark_apple_transcriber_stop")
+public func tark_apple_transcriber_stop(_ handle: UnsafeMutableRawPointer, _ stopped: StoppedFn) {
+  // The library's reference goes once it has stopped.
+  let transcriber = Unmanaged<Transcriber>.fromOpaque(handle).takeRetainedValue()
+  transcriber.stop(stopped)
+}
+
+@_cdecl("tark_apple_translation_status")
+public func tark_apple_translation_status(
+  _ from: UnsafePointer<CChar>, _ to: UnsafePointer<CChar>, _ ctx: UnsafeMutableRawPointer?,
+  _ done: StatusFn
+) {
+  let source = Locale.Language(identifier: String(cString: from))
+  let target = Locale.Language(identifier: String(cString: to))
+  let context = bits(ctx)
+  Task {
+    let status: Int32
+    switch await LanguageAvailability().status(from: source, to: target) {
+    case .installed: status = 2
+    case .supported: status = 1
+    default: status = 0
+    }
+    done(ptr(context), status)
+  }
+}
+
+@_cdecl("tark_apple_translate")
+public func tark_apple_translate(
+  _ from: UnsafePointer<CChar>, _ to: UnsafePointer<CChar>, _ text: UnsafePointer<CChar>,
+  _ ctx: UnsafeMutableRawPointer?, _ done: TextFn
+) {
+  let source = Locale.Language(identifier: String(cString: from))
+  let target = Locale.Language(identifier: String(cString: to))
+  let words = String(cString: text)
+  let context = bits(ctx)
+  Task {
+    do {
+      let session = TranslationSession(installedSource: source, target: target)
+      let translated = try await session.translate(words).targetText
+      translated.withCString { done(ptr(context), 1, $0) }
+    } catch {
+      done(ptr(context), 0, nil)
+    }
+  }
+}
