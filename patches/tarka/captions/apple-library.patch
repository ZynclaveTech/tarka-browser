+import("//build/config/mac/mac_sdk.gni")
+import("//testing/test.gni")
+
+# Tark (D4 Phase 3): the Swift library over macOS 26's speech and
+# translation, built by Xcode's swiftc (Chromium's Mac toolchain builds no
+# Swift). sign_and_package_app.sh installs it into Tark.app's Frameworks.
+action("tark_apple_speech") {
+  script = "build_swift_dylib.py"
+  sources = [ "tark_apple_speech.swift" ]
+  outputs = [ "$root_out_dir/libtark_apple_speech.dylib" ]
+  args = [
+    "--sdk",
+    rebase_path(mac_sdk_path, root_build_dir),
+    "--target",
+    "arm64-apple-macos26.0",
+    "--module",
+    "TarkAppleSpeech",
+    "--output",
+    rebase_path(outputs[0], root_build_dir),
+  ] + rebase_path(sources, root_build_dir)
+}
+
+# Runs on macOS 26 with the Spanish speech and translation installed; the
+# tests that need them are skipped otherwise. TARK_CAPTIONS_TESTDATA as for
+# the other captions tests.
+test("tark_apple_speech_unittests") {
+  sources = [ "tark_apple_speech_unittest.cc" ]
+  deps = [
+    "//base",
+    "//base/test:run_all_unittests",
+    "//base/test:test_support",
+    "//components/tark_captions:test_support",
+    "//testing/gtest",
+  ]
+  data_deps = [ ":tark_apple_speech" ]
+}
