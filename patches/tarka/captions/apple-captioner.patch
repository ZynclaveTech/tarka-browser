+bool CallCaptionsTabHelper::AppleAvailable() const {
+#if BUILDFLAG(IS_MAC)
+  tark_captions::AppleSpeechLibrary* library = tark_captions::AppleSpeechLibrary::Get();
+  return library && library->Available();
+#else
+  return false;
+#endif
+}
+
+void CallCaptionsTabHelper::BindTapSource(bool bind) {
+  tap_source_.reset();
+#if BUILDFLAG(IS_MAC)
+  apple_taps_.clear();
+#endif
+  Profile* profile = Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  speech::SpeechRecognitionService* service =
+      SpeechRecognitionServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return;
+  }
+  if (!bind) {
+    service->SetTarkTapSourceProvider({});
+    return;
+  }
+  // A fresh source each time the service binds a recognizer; the taps
+  // opened through an older one go on. OpenTap checks that macOS's speech
+  // is here (it may still be loading now).
+  service->SetTarkTapSourceProvider(base::BindRepeating(
+      [](base::WeakPtr<CallCaptionsTabHelper> tab) {
+        mojo::PendingRemote<media::mojom::TarkAudioTapSource> source;
+        if (tab) {
+          tab->tap_source_.reset();
+          source = tab->tap_source_.BindNewPipeAndPassRemote();
+        }
+        return source;
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+void CallCaptionsTabHelper::OpenTap(const std::string& language,
+                                    mojo::PendingReceiver<media::mojom::TarkAudioTap> tap) {
+#if BUILDFLAG(IS_MAC)
+  // From the speech process: only an Apple language, and a few streams.
+  constexpr size_t kMaxTaps = 8;
+  tark_captions::AppleSpeechLibrary* library = tark_captions::AppleSpeechLibrary::Get();
+  if (!state_.captions_on() || !library || !library->Available() ||
+      tark_captions::KindOfLanguage(language.substr(0, language.find('-'))) !=
+          tark_captions::Detection::Kind::kApple ||
+      apple_taps_.size() >= kMaxTaps) {
+    return;
+  }
+  VLOG(1) << "Tark captions: macOS captions \"" << language << "\"";
+  auto apple = std::make_unique<AppleTap>();
+  apple->captioner = std::make_unique<tark_captions::AppleCaptioner>(
+      library, language,
+      base::BindRepeating(&CallCaptionsTabHelper::OnAppleCaption, weak_factory_.GetWeakPtr(),
+                          language),
+      base::BindRepeating(
+          [](base::WeakPtr<CallCaptionsTabHelper> tab, tark_captions::AppleCaptioner::Status,
+             double) {
+            if (tab) {
+              tab->OnAppleStatusChanged();
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+  apple->receiver = std::make_unique<mojo::Receiver<media::mojom::TarkAudioTap>>(
+      apple->captioner.get(), std::move(tap));
+  // The recognizer closed its tap (another language, captions off).
+  apple->receiver->set_disconnect_handler(base::BindOnce(
+      [](CallCaptionsTabHelper* tab, AppleTap* gone) {
+        std::erase_if(tab->apple_taps_,
+                      [gone](const std::unique_ptr<AppleTap>& t) { return t.get() == gone; });
+        tab->OnAppleStatusChanged();
+      },
+      base::Unretained(this), apple.get()));
+  apple_taps_.push_back(std::move(apple));
+  OnAppleStatusChanged();
+#endif
+}
+
+void CallCaptionsTabHelper::OnAppleCaption(const std::string& language,
+                                           bool is_final,
+                                           const std::string& text) {
+  // Only the call's language: a stream that heard another (before the lock
+  // reached it) shows nothing.
+  if (!client_language_.AcceptsAppleCaptions(language)) {
+    return;
+  }
+  OnCaption(media::SpeechRecognitionResult(text, is_final));
+}
+
+void CallCaptionsTabHelper::OnAppleStatusChanged() {
+  observers_.Notify(&Observer::OnClientLanguageChanged, this);
+}
+
+CallCaptionsTabHelper::AppleDownload CallCaptionsTabHelper::apple_download() const {
+  AppleDownload download;
+#if BUILDFLAG(IS_MAC)
+  for (const std::unique_ptr<AppleTap>& tap : apple_taps_) {
+    switch (tap->captioner->status()) {
+      case tark_captions::AppleCaptioner::Status::kDownloading:
+        download.active = true;
+        download.fraction = std::max(download.fraction, tap->captioner->fraction());
+        break;
+      case tark_captions::AppleCaptioner::Status::kFailed:
+        download.active = true;
+        download.failed = true;
+        break;
+      case tark_captions::AppleCaptioner::Status::kPreparing:
+      case tark_captions::AppleCaptioner::Status::kReady:
+        break;
+    }
+  }
+#endif
+  return download;
+}
+
+void CallCaptionsTabHelper::RetryAppleDownload() {
+#if BUILDFLAG(IS_MAC)
+  for (const std::unique_ptr<AppleTap>& tap : apple_taps_) {
+    tap->captioner->Retry();
+  }
+#endif
+}
