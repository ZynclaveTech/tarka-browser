+#ifndef CHROME_BROWSER_TARK_CAPTIONS_APPLE_CAPTIONER_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_APPLE_CAPTIONER_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "media/mojo/mojom/tark_audio_tap.mojom.h"
+
+namespace tark_captions {
+
+class AppleSpeechLibrary;
+
+// "es" -> "es_US": the macOS speech locale for a language, or the code's own
+// region ("es-ES" -> "es_ES"). English is Indian English.
+std::string AppleLocaleFor(std::string_view language);
+
+// One tap's captions (D4 Phase 3): the call audio a recognizer sends for a
+// language macOS 26 captions, transcribed by Apple's SpeechTranscriber in the
+// browser process. The language's speech is installed first if needed
+// (macOS downloads it from Apple); audio that comes meanwhile is kept, up to
+// 30 s, so the first sentence is captioned too. Use on one sequence.
+class AppleCaptioner : public media::mojom::TarkAudioTap {
+ public:
+  enum class Status { kPreparing, kDownloading, kReady, kFailed };
+  using EventCallback = base::RepeatingCallback<void(bool is_final, const std::string& text)>;
+  // `fraction` of the download while kDownloading.
+  using StatusCallback = base::RepeatingCallback<void(Status status, double fraction)>;
+
+  AppleCaptioner(AppleSpeechLibrary* library,
+                 const std::string& language,
+                 EventCallback on_event,
+                 StatusCallback on_status);
+  AppleCaptioner(const AppleCaptioner&) = delete;
+  AppleCaptioner& operator=(const AppleCaptioner&) = delete;
+  ~AppleCaptioner() override;
+
+  // After kFailed: check and install again.
+  void Retry();
+  Status status() const { return status_; }
+  // How much of the language's speech macOS has downloaded (kDownloading).
+  double fraction() const { return fraction_; }
+
+  // media::mojom::TarkAudioTap:
+  void OnAudio(const std::vector<float>& pcm16k_mono) override;
+
+ private:
+  class Context;
+
+  void Check();
+  void OnLocaleStatus(int status);
+  void OnProgress(double fraction);
+  void OnInstalled(bool ok);
+  void OnResult(uint64_t transcriber, bool is_final, std::string text);
+  void OnFailed(uint64_t transcriber, int code);
+  void StopTranscribing();
+  void SetStatus(Status status, double fraction = 0);
+  void StartTranscribing();
+
+  raw_ptr<AppleSpeechLibrary> library_;
+  const std::string locale_;
+  EventCallback on_event_;
+  StatusCallback on_status_;
+  Status status_ = Status::kPreparing;
+  double fraction_ = 0;
+  scoped_refptr<Context> context_;
+  void* transcriber_ = nullptr;
+  // Which transcriber the library's answers are about (a new one after
+  // Retry); answers about an older one are dropped.
+  uint64_t transcriber_id_ = 0;
+  scoped_refptr<Context> transcriber_context_;
+  std::vector<float> waiting_;  // Audio before the transcriber started.
+  base::WeakPtrFactory<AppleCaptioner> weak_factory_{this};
+};
+
+// Translating an Apple language's caption (D4 Phase 3): Apple's Translation
+// into English, then, for an Indian target, Tark's own translator through
+// `indian_hop` (from English). Not offered in another script.
+enum class AppleRenderError { kNone, kTranslationLanguageMissing, kFailed };
+using IndianHop =
+    base::OnceCallback<void(const std::string& english,
+                            base::OnceCallback<void(bool ok, const std::string& text)> reply)>;
+void RenderApple(AppleSpeechLibrary* library,
+                 const std::string& text,
+                 const std::string& source,
+                 const std::string& target,
+                 IndianHop indian_hop,
+                 base::OnceCallback<void(AppleRenderError, const std::string& translation)> done);
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_APPLE_CAPTIONER_H_
