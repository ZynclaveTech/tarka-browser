+base::DictValue Golden() {
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  return testdata ? test::EnMtGolden(*testdata) : base::DictValue();
+}
+
+// English captions (utils/indictrans_export.py en-golden) through
+// IndicProcessor's English steps.
+TEST(EnglishTextTest, ModelInputMatchesReference) {
+  const base::DictValue golden = Golden();
+  const base::ListValue* cases = golden.FindList("cases");
+  if (!cases) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  ASSERT_FALSE(cases->empty());
+  for (const base::Value& v : *cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(EnglishModelInput(*c.FindString("english")), *c.FindString("model_input"))
+        << *c.FindString("id");
+  }
+}
+
+// Over the characters English captions are made of, ICU's classes are
+// sacremoses' (its Perl Unicode tables).
+TEST(EnglishTextTest, CharacterClassesMatchSacremoses) {
+  const base::DictValue golden = Golden();
+  const base::DictValue* classes = golden.FindDict("classes");
+  const base::ListValue* ranges = golden.FindList("ranges");
+  if (!classes || !ranges) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  const std::pair<const char*, bool (*)(char32_t)> kClasses[] = {
+      {"IsAlpha", &english_text_internal::IsAlpha},
+      {"IsN", &english_text_internal::IsNumber},
+      {"IsAlnum", &english_text_internal::IsAlnum},
+      {"IsLower", &english_text_internal::IsLower},
+      {"space", &english_text_internal::IsSpace},
+  };
+  for (const auto& [name, predicate] : kClasses) {
+    std::set<int> members;
+    for (const base::Value& c : *classes->FindList(name)) {
+      members.insert(c.GetInt());
+    }
+    for (const base::Value& range : *ranges) {
+      for (int c = range.GetList()[0].GetInt(); c <= range.GetList()[1].GetInt(); ++c) {
+        EXPECT_EQ(predicate(static_cast<char32_t>(c)), members.contains(c)) << name << base::StringPrintf(" U+%04X", c);
+      }
+    }
+  }
+}
+
+TEST(EnglishTextTest, SplitsContractionsAndPunctuation) {
+  EXPECT_EQ(EnglishModelInput("Mr. Smith can't come... sorry!"),
+            "Mr. Smith can 't come ... sorry !");
+}
+
+TEST(EnglishTextTest, EmptyAndBlank) {
+  EXPECT_EQ(EnglishModelInput(""), "");
+  EXPECT_EQ(EnglishModelInput(" \t\n "), "");
+}
+
+// Long runs of dots and spaces (the speech recogniser's output is
+// untrusted) stay linear.
+TEST(EnglishTextTest, LongRunsAreLinear) {
+  const std::string dots(200000, '.');
+  EXPECT_EQ(EnglishModelInput("a" + dots + "b"), "a " + dots + " b");
+  EXPECT_EQ(EnglishModelInput("a" + std::string(200000, ' ') + "b"), "a b");
+}
+
