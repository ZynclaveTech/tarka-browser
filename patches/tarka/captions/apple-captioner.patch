+std::vector<ModelUnit> UnitsForCaptions(const ClientLanguage& language) {
+  std::vector<ModelUnit> units = {ModelUnit::kLanguageId};
+  const bool own = language.state() == ClientLanguage::State::kCaptioning ||
+                   (!language.automatic() && language.state() == ClientLanguage::State::kDetecting);
+  if (own) {
+    units.push_back(ModelUnit::kCaptions);
+  }
+  return units;
+}
+
+std::vector<ModelUnit> UnitsForTranslating(const ClientLanguage& language, Target target) {
+  if (language.state() != ClientLanguage::State::kApple) {
+    return UnitsForTranslation(target);
+  }
+  if (target == Target::kEnglish || target == Target::kNone) {
+    return {};
+  }
+  return {ModelUnit::kFromEnglish};
+}
