+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/apple_speech_library.h"
+
+#include <atomic>
+
+#include "base/apple/bundle_locations.h"
+#include "base/logging.h"
+#include "base/mac/mac_util.h"
+#include "base/task/thread_pool.h"
+
+namespace tark_captions {
+namespace {
+
+std::atomic<AppleSpeechLibrary*> g_library{nullptr};
+std::atomic<AppleSpeechLibrary*> g_for_testing{nullptr};
+std::atomic<bool> g_loading{false};
+
+template <typename T>
+bool Bind(base::NativeLibrary native, const char* name, T* out) {
+  *out = reinterpret_cast<T>(base::GetFunctionPointerFromNativeLibrary(native, name));
+  return *out != nullptr;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<AppleSpeechLibrary> AppleSpeechLibrary::Load(const base::FilePath& path) {
+  if (base::mac::MacOSMajorVersion() < 26) {
+    return nullptr;
+  }
+  base::NativeLibraryLoadError error;
+  base::NativeLibrary native = base::LoadNativeLibrary(path, &error);
+  if (!native) {
+    VLOG(1) << "Tark captions: no macOS speech library (" << error.ToString() << ")";
+    return nullptr;
+  }
+  Functions f;
+  if (!Bind(native, "tark_apple_available", &f.available) ||
+      !Bind(native, "tark_apple_locale_status", &f.locale_status) ||
+      !Bind(native, "tark_apple_install", &f.install) ||
+      !Bind(native, "tark_apple_transcriber_start", &f.transcriber_start) ||
+      !Bind(native, "tark_apple_transcriber_append", &f.transcriber_append) ||
+      !Bind(native, "tark_apple_transcriber_stop", &f.transcriber_stop) ||
+      !Bind(native, "tark_apple_translation_status", &f.translation_status) ||
+      !Bind(native, "tark_apple_translate", &f.translate)) {
+    base::UnloadNativeLibrary(native);
+    return nullptr;
+  }
+  return std::make_unique<AppleSpeechLibrary>(f, native);
+}
+
+// static
+AppleSpeechLibrary* AppleSpeechLibrary::Get() {
+  if (AppleSpeechLibrary* testing = g_for_testing.load()) {
+    return testing;
+  }
+  return g_library.load();
+}
+
+// static
+void AppleSpeechLibrary::StartLoading() {
+  if (g_loading.exchange(true)) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE}, base::BindOnce([] {
+        std::unique_ptr<AppleSpeechLibrary> library = Load(
+            base::apple::OuterBundlePath().Append("Contents").Append("Frameworks").Append(
+                "libtark_apple_speech.dylib"));
+        if (library && library->Available()) {
+          // Lives for the process: its callbacks may come at any time.
+          g_library.store(library.release());
+        }
+      }));
+}
+
+// static
+void AppleSpeechLibrary::SetForTesting(AppleSpeechLibrary* library) {
+  g_for_testing.store(library);
+}
+
+AppleSpeechLibrary::AppleSpeechLibrary(const Functions& functions, base::NativeLibrary native)
+    : functions_(functions), native_(native) {}
+
+AppleSpeechLibrary::~AppleSpeechLibrary() = default;
+
+bool AppleSpeechLibrary::Available() const {
+  return functions_.available && functions_.available() == 1;
+}
+
+}  // namespace tark_captions
