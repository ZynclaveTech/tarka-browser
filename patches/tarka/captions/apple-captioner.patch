+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tark_captions/apple_captioner.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/memory/ref_counted.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/tark_captions/apple_speech_library.h"
+
+namespace tark_captions {
+namespace {
+
+// Audio kept while the language is checked or installed: 30 s at 16 kHz.
+constexpr size_t kMaxWaiting = 30 * 16000;
+
+struct LocaleOf {
+  std::string_view language;
+  std::string_view locale;
+};
+constexpr LocaleOf kLocales[] = {
+    {"en", "en_IN"}, {"es", "es_US"}, {"fr", "fr_FR"}, {"de", "de_DE"}, {"it", "it_IT"},
+    {"pt", "pt_BR"}, {"ja", "ja_JP"}, {"ko", "ko_KR"}, {"zh", "zh_CN"}, {"yue", "yue_CN"},
+};
+
+}  // namespace
+
+std::string AppleLocaleFor(std::string_view language) {
+  if (size_t dash = language.find('-'); dash != std::string_view::npos) {
+    std::string locale(language);
+    locale[dash] = '_';
+    return locale;
+  }
+  for (const LocaleOf& l : kLocales) {
+    if (l.language == language) {
+      return std::string(l.locale);
+    }
+  }
+  return std::string(language);
+}
+
+// What the library's callbacks hold: they come on Apple's threads and post
+// to the captioner's sequence. One reference per call still to answer.
+class AppleCaptioner::Context : public base::RefCountedThreadSafe<Context> {
+ public:
+  Context(scoped_refptr<base::SequencedTaskRunner> runner,
+          base::WeakPtr<AppleCaptioner> owner,
+          uint64_t transcriber = 0)
+      : runner_(std::move(runner)), owner_(std::move(owner)), transcriber_(transcriber) {}
+
+  // Passed to the library as its `ctx`, with a reference the answer drops.
+  void* Lend() {
+    AddRef();
+    return this;
+  }
+
+  static void LocaleStatus(void* ctx, int status) {
+    Context* c = static_cast<Context*>(ctx);
+    c->runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&AppleCaptioner::OnLocaleStatus, c->owner_, status));
+    c->Release();
+  }
+  static void Progress(void* ctx, double fraction) {
+    Context* c = static_cast<Context*>(ctx);
+    c->runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&AppleCaptioner::OnProgress, c->owner_, fraction));
+  }
+  static void Installed(void* ctx, int ok) {
+    Context* c = static_cast<Context*>(ctx);
+    c->runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&AppleCaptioner::OnInstalled, c->owner_, ok == 1));
+    c->Release();
+  }
+  static void Result(void* ctx, int is_final, const char* text) {
+    Context* c = static_cast<Context*>(ctx);
+    c->runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&AppleCaptioner::OnResult, c->owner_, c->transcriber_,
+                                        is_final == 1, std::string(text ? text : "")));
+  }
+  static void Failed(void* ctx, int code) {
+    Context* c = static_cast<Context*>(ctx);
+    c->runner_->PostTask(FROM_HERE, base::BindOnce(&AppleCaptioner::OnFailed, c->owner_,
+                                                   c->transcriber_, code));
+  }
+  static void Stopped(void* ctx) { static_cast<Context*>(ctx)->Release(); }
+
+ private:
+  friend class base::RefCountedThreadSafe<Context>;
+  ~Context() = default;
+
+  const scoped_refptr<base::SequencedTaskRunner> runner_;
+  const base::WeakPtr<AppleCaptioner> owner_;
+  const uint64_t transcriber_;
+};
+
+AppleCaptioner::AppleCaptioner(AppleSpeechLibrary* library,
+                               const std::string& language,
+                               EventCallback on_event,
+                               StatusCallback on_status)
+    : library_(library),
+      locale_(AppleLocaleFor(language)),
+      on_event_(std::move(on_event)),
+      on_status_(std::move(on_status)) {
+  context_ = base::MakeRefCounted<Context>(base::SequencedTaskRunner::GetCurrentDefault(),
+                                           weak_factory_.GetWeakPtr());
+  Check();
+}
+
+AppleCaptioner::~AppleCaptioner() {
+  StopTranscribing();
+}
+
+void AppleCaptioner::StopTranscribing() {
+  if (transcriber_) {
+    // The library flushes, then drops the transcriber's reference.
+    library_->functions().transcriber_stop(std::exchange(transcriber_, nullptr),
+                                           &Context::Stopped);
+  }
+}
+
+void AppleCaptioner::Retry() {
+  if (status_ == Status::kFailed) {
+    Check();
+  }
+}
+
+void AppleCaptioner::OnAudio(const std::vector<float>& pcm16k_mono) {
+  // From the speech process: never an empty chunk to the library, nothing
+  // while failed (until Retry).
+  if (pcm16k_mono.empty() || status_ == Status::kFailed) {
+    return;
+  }
+  if (transcriber_) {
+    library_->functions().transcriber_append(transcriber_, pcm16k_mono.data(),
+                                             static_cast<int>(pcm16k_mono.size()));
+    return;
+  }
+  waiting_.insert(waiting_.end(), pcm16k_mono.begin(), pcm16k_mono.end());
+  if (waiting_.size() > kMaxWaiting) {
+    waiting_.erase(waiting_.begin(), waiting_.end() - kMaxWaiting);
+  }
+}
+
+void AppleCaptioner::Check() {
+  SetStatus(Status::kPreparing);
+  library_->functions().locale_status(locale_.c_str(), context_->Lend(), &Context::LocaleStatus);
+}
+
+void AppleCaptioner::OnLocaleStatus(int status) {
+  VLOG(1) << "Tark captions: macOS speech for " << locale_ << ": " << status;
+  if (status == 2) {
+    StartTranscribing();
+  } else if (status == 1) {
+    // macOS downloads the language's speech from Apple.
+    SetStatus(Status::kDownloading, 0);
+    library_->functions().install(locale_.c_str(), context_->Lend(), &Context::Progress,
+                                  &Context::Installed);
+  } else {
+    SetStatus(Status::kFailed);
+  }
+}
+
+void AppleCaptioner::OnProgress(double fraction) {
+  if (status_ == Status::kDownloading) {
+    SetStatus(Status::kDownloading, fraction);
+  }
+}
+
+void AppleCaptioner::OnInstalled(bool ok) {
+  if (ok) {
+    StartTranscribing();
+  } else {
+    SetStatus(Status::kFailed);
+  }
+}
+
+void AppleCaptioner::StartTranscribing() {
+  if (transcriber_) {
+    return;
+  }
+  transcriber_context_ = base::MakeRefCounted<Context>(
+      base::SequencedTaskRunner::GetCurrentDefault(), weak_factory_.GetWeakPtr(),
+      ++transcriber_id_);
+  transcriber_ = library_->functions().transcriber_start(
+      locale_.c_str(), transcriber_context_->Lend(), &Context::Result, &Context::Failed);
+  SetStatus(Status::kReady);
+  if (!waiting_.empty()) {
+    library_->functions().transcriber_append(transcriber_, waiting_.data(),
+                                             static_cast<int>(waiting_.size()));
+    waiting_.clear();
+  }
+}
+
+void AppleCaptioner::OnResult(uint64_t transcriber, bool is_final, std::string text) {
+  if (transcriber != transcriber_id_ || !transcriber_) {
+    return;
+  }
+  // Never the text: call content stays out of logs.
+  VLOG(1) << "Tark captions: macOS " << (is_final ? "final" : "draft") << ", " << text.size()
+          << " bytes";
+  on_event_.Run(is_final, text);
+}
+
+void AppleCaptioner::OnFailed(uint64_t transcriber, int code) {
+  if (transcriber != transcriber_id_ || !transcriber_) {
+    return;
+  }
+  VLOG(1) << "Tark captions: macOS speech failed, code " << code;
+  StopTranscribing();
+  waiting_.clear();
+  SetStatus(Status::kFailed);
+}
+
+void AppleCaptioner::SetStatus(Status status, double fraction) {
+  status_ = status;
+  fraction_ = fraction;
+  on_status_.Run(status, fraction);
+}
+
+namespace {
+
+// One translation on its way, owned by whichever step holds it.
+struct RenderJob {
+  scoped_refptr<base::SequencedTaskRunner> runner;
+  raw_ptr<AppleSpeechLibrary> library;
+  std::string text;
+  std::string source;
+  std::string target;
+  IndianHop indian_hop;
+  base::OnceCallback<void(AppleRenderError, const std::string&)> done;
+};
+
+void Finish(std::unique_ptr<RenderJob> job, AppleRenderError error, const std::string& text) {
+  std::move(job->done).Run(error, text);
+}
+
+// English in hand: the target is English, or Tark's translator takes it on.
+void FromEnglish(std::unique_ptr<RenderJob> job, const std::string& english) {
+  if (job->target == "en") {
+    Finish(std::move(job), AppleRenderError::kNone, english);
+    return;
+  }
+  IndianHop hop = std::move(job->indian_hop);
+  std::move(hop).Run(english, base::BindOnce(
+                                  [](std::unique_ptr<RenderJob> job, bool ok,
+                                     const std::string& text) {
+                                    Finish(std::move(job),
+                                           ok ? AppleRenderError::kNone : AppleRenderError::kFailed,
+                                           text);
+                                  },
+                                  std::move(job)));
+}
+
+void OnTranslated(std::unique_ptr<RenderJob> job, bool ok, const std::string& english) {
+  if (!ok) {
+    Finish(std::move(job), AppleRenderError::kFailed, std::string());
+    return;
+  }
+  FromEnglish(std::move(job), english);
+}
+
+void OnTranslationStatus(std::unique_ptr<RenderJob> job, int status) {
+  if (status == 1) {
+    Finish(std::move(job), AppleRenderError::kTranslationLanguageMissing, std::string());
+    return;
+  }
+  if (status != 2) {
+    Finish(std::move(job), AppleRenderError::kFailed, std::string());
+    return;
+  }
+  RenderJob* raw = job.release();
+  raw->library->functions().translate(
+      raw->source.c_str(), "en", raw->text.c_str(), raw,
+      [](void* ctx, int ok, const char* text) {
+        RenderJob* job = static_cast<RenderJob*>(ctx);
+        job->runner->PostTask(FROM_HERE, base::BindOnce(&OnTranslated, base::WrapUnique(job),
+                                                        ok == 1, std::string(text ? text : "")));
+      });
+}
+
+}  // namespace
+
+void RenderApple(AppleSpeechLibrary* library,
+                 const std::string& text,
+                 const std::string& source,
+                 const std::string& target,
+                 IndianHop indian_hop,
+                 base::OnceCallback<void(AppleRenderError, const std::string&)> done) {
+  auto job = std::make_unique<RenderJob>();
+  job->runner = base::SequencedTaskRunner::GetCurrentDefault();
+  job->library = library;
+  job->text = text;
+  job->source = source.substr(0, source.find('-'));
+  job->target = target;
+  job->indian_hop = std::move(indian_hop);
+  job->done = std::move(done);
+  if (target.empty()) {
+    Finish(std::move(job), AppleRenderError::kNone, std::string());
+    return;
+  }
+  if (job->source == "en") {
+    // English already: only an Indian target needs translating.
+    const std::string english = job->text;
+    FromEnglish(std::move(job), english);
+    return;
+  }
+  RenderJob* raw = job.release();
+  library->functions().translation_status(
+      raw->source.c_str(), "en", raw, [](void* ctx, int status) {
+        RenderJob* job = static_cast<RenderJob*>(ctx);
+        job->runner->PostTask(FROM_HERE,
+                              base::BindOnce(&OnTranslationStatus, base::WrapUnique(job), status));
+      });
+}
+
+}  // namespace tark_captions
