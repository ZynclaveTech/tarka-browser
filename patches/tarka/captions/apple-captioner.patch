+#ifndef CHROME_BROWSER_TARK_CAPTIONS_APPLE_SPEECH_LIBRARY_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_APPLE_SPEECH_LIBRARY_H_
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/native_library.h"
+#include "chrome/browser/tark_captions/apple/tark_apple_speech.h"
+
+namespace tark_captions {
+
+// libtark_apple_speech.dylib (D4 Phase 3): macOS 26's speech and translation
+// for the Apple languages, loaded at run time from Tark.app's Frameworks.
+class AppleSpeechLibrary {
+ public:
+  // The library's entry points (tark_apple_speech.h).
+  struct Functions {
+    decltype(&tark_apple_available) available = nullptr;
+    decltype(&tark_apple_locale_status) locale_status = nullptr;
+    decltype(&tark_apple_install) install = nullptr;
+    decltype(&tark_apple_transcriber_start) transcriber_start = nullptr;
+    decltype(&tark_apple_transcriber_append) transcriber_append = nullptr;
+    decltype(&tark_apple_transcriber_stop) transcriber_stop = nullptr;
+    decltype(&tark_apple_translation_status) translation_status = nullptr;
+    decltype(&tark_apple_translate) translate = nullptr;
+  };
+
+  // Null before macOS 26, or when the library or one of its entry points is
+  // missing. Blocking: call off the UI thread.
+  static std::unique_ptr<AppleSpeechLibrary> Load(const base::FilePath& path);
+
+  // The browser's, loaded once in the background (StartLoading); null until
+  // then, and when this Mac can't have it.
+  static AppleSpeechLibrary* Get();
+  static void StartLoading();
+  static void SetForTesting(AppleSpeechLibrary* library);
+
+  explicit AppleSpeechLibrary(const Functions& functions,
+                              base::NativeLibrary native = nullptr);
+  AppleSpeechLibrary(const AppleSpeechLibrary&) = delete;
+  AppleSpeechLibrary& operator=(const AppleSpeechLibrary&) = delete;
+  ~AppleSpeechLibrary();
+
+  bool Available() const;
+  const Functions& functions() const { return functions_; }
+
+ private:
+  const Functions functions_;
+  // Kept loaded for the process's life: its tasks may outlive any caller.
+  base::NativeLibrary native_;
+};
+
+}  // namespace tark_captions
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_APPLE_SPEECH_LIBRARY_H_
