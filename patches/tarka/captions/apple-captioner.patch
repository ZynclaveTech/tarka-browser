+class AppleCaptionerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    g_fake = &fake_;
+    library_ = std::make_unique<AppleSpeechLibrary>(FakeFunctions());
+  }
+  void TearDown() override {
+    captioner_.reset();
+    env_.RunUntilIdle();
+    g_fake = nullptr;
+  }
+
+  void Start(const std::string& language) {
+    captioner_ = std::make_unique<AppleCaptioner>(
+        library_.get(), language,
+        base::BindRepeating(
+            [](std::vector<std::pair<bool, std::string>>* events, bool is_final,
+               const std::string& text) { events->push_back({is_final, text}); },
+            &events_),
+        base::BindRepeating(
+            [](std::vector<AppleCaptioner::Status>* statuses, double* fraction,
+               AppleCaptioner::Status status, double f) {
+              statuses->push_back(status);
+              *fraction = f;
+            },
+            &statuses_, &fraction_));
+  }
+
+  base::test::TaskEnvironment env_;
+  FakeApple fake_;
+  std::unique_ptr<AppleSpeechLibrary> library_;
+  std::unique_ptr<AppleCaptioner> captioner_;
+  std::vector<std::pair<bool, std::string>> events_;
+  std::vector<AppleCaptioner::Status> statuses_;
+  double fraction_ = 0;
+};
+
+TEST_F(AppleCaptionerTest, MissingLibraryIsUnavailable) {
+  std::unique_ptr<AppleSpeechLibrary> missing =
+      AppleSpeechLibrary::Load(base::FilePath("/nonexistent/libtark_apple_speech.dylib"));
+  EXPECT_FALSE(missing && missing->Available());
+}
+
+TEST_F(AppleCaptionerTest, LocalesForLanguages) {
+  EXPECT_EQ(AppleLocaleFor("en"), "en_IN");
+  EXPECT_EQ(AppleLocaleFor("es"), "es_US");
+  EXPECT_EQ(AppleLocaleFor("es-ES"), "es_ES");
+  EXPECT_EQ(AppleLocaleFor("zh"), "zh_CN");
+  EXPECT_EQ(AppleLocaleFor("yue"), "yue_CN");
+}
+
+TEST_F(AppleCaptionerTest, ResultsBecomeCaptionEvents) {
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.result != nullptr; }));
+  EXPECT_EQ(fake_.started_locale, "es_US");
+  fake_.result(fake_.ctx, 0, "hola");
+  fake_.result(fake_.ctx, 1, "hola mundo");
+  ASSERT_TRUE(base::test::RunUntil([&] { return events_.size() == 2u; }));
+  EXPECT_EQ(events_[0], std::make_pair(false, std::string("hola")));
+  EXPECT_EQ(events_[1], std::make_pair(true, std::string("hola mundo")));
+}
+
+// What arrived while the language was being checked or installed is
+// transcribed once it is ready: the first sentence is kept.
+TEST_F(AppleCaptionerTest, AudioBeforeReadyIsKept) {
+  fake_.locale_status = 1;
+  Start("es");
+  captioner_->OnAudio(std::vector<float>(1600, 0.1f));
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.install_done != nullptr; }));
+  fake_.install_done(fake_.install_ctx, 1);
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.appended == 1600u; }));
+}
+
+TEST_F(AppleCaptionerTest, PrepareReportsProgressThenReady) {
+  fake_.locale_status = 1;
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.progress != nullptr; }));
+  fake_.progress(fake_.install_ctx, 0.5);
+  ASSERT_TRUE(base::test::RunUntil([&] { return fraction_ == 0.5; }));
+  EXPECT_EQ(statuses_.back(), AppleCaptioner::Status::kDownloading);
+  fake_.install_done(fake_.install_ctx, 1);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return statuses_.back() == AppleCaptioner::Status::kReady; }));
+  EXPECT_EQ(fake_.started_locale, "es_US");
+}
+
+TEST_F(AppleCaptionerTest, AssetFailureShowsRetry) {
+  fake_.locale_status = 1;
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.install_done != nullptr; }));
+  fake_.install_done(fake_.install_ctx, 0);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return statuses_.back() == AppleCaptioner::Status::kFailed; }));
+  EXPECT_TRUE(fake_.started_locale.empty());  // Never half-ready.
+  captioner_->Retry();
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.installs == 2; }));
+}
+
+TEST_F(AppleCaptionerTest, UnsupportedLocaleFails) {
+  fake_.locale_status = 0;
+  Start("ko");
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !statuses_.empty() && statuses_.back() == AppleCaptioner::Status::kFailed; }));
+  EXPECT_EQ(fake_.installs, 0);
+}
+
+TEST_F(AppleCaptionerTest, TapStopsWhenTheCallEnds) {
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.result != nullptr; }));
+  captioner_.reset();
+  EXPECT_TRUE(fake_.stopped);
+}
+
+TEST_F(AppleCaptionerTest, SpanishToTamilPivotsThroughEnglish) {
+  base::test::TestFuture<AppleRenderError, const std::string&> done;
+  std::string hop_input;
+  RenderApple(library_.get(), "hola", "es", "ta",
+              base::BindOnce(
+                  [](std::string* input, const std::string& english,
+                     base::OnceCallback<void(bool, const std::string&)> reply) {
+                    *input = english;
+                    std::move(reply).Run(true, "vanakkam");
+                  },
+                  &hop_input),
+              done.GetCallback());
+  EXPECT_EQ(done.Get<0>(), AppleRenderError::kNone);
+  EXPECT_EQ(done.Get<1>(), "vanakkam");
+  EXPECT_EQ(hop_input, "hello");
+}
+
+TEST_F(AppleCaptionerTest, SpanishToEnglishIsOneHop) {
+  base::test::TestFuture<AppleRenderError, const std::string&> done;
+  RenderApple(library_.get(), "hola", "es", "en", base::NullCallback(), done.GetCallback());
+  EXPECT_EQ(done.Get<0>(), AppleRenderError::kNone);
+  EXPECT_EQ(done.Get<1>(), "hello");
+}
+
+TEST_F(AppleCaptionerTest, MissingTranslationLanguage) {
+  fake_.translation_status = 1;
+  base::test::TestFuture<AppleRenderError, const std::string&> done;
+  RenderApple(library_.get(), "hola", "es", "en", base::NullCallback(), done.GetCallback());
+  EXPECT_EQ(done.Get<0>(), AppleRenderError::kTranslationLanguageMissing);
+}
+
+// The transcriber failing (its format or model went away): it is stopped,
+// audio is dropped meanwhile, and Retry starts a new one.
+TEST_F(AppleCaptionerTest, TranscriberFailureThenRetry) {
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.failed != nullptr; }));
+  fake_.failed(fake_.ctx, 1);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return statuses_.back() == AppleCaptioner::Status::kFailed; }));
+  EXPECT_TRUE(fake_.stopped);
+  captioner_->OnAudio(std::vector<float>(1600, 0.1f));
+  EXPECT_EQ(fake_.appended, 0u);
+  captioner_->Retry();
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.starts == 2; }));
+  EXPECT_EQ(statuses_.back(), AppleCaptioner::Status::kReady);
+}
+
+// The speech process is less trusted than the browser: an empty chunk never
+// reaches the library (it would pass a null pointer).
+TEST_F(AppleCaptionerTest, EmptyAudioIsIgnored) {
+  Start("es");
+  ASSERT_TRUE(base::test::RunUntil([&] { return fake_.result != nullptr; }));
+  captioner_->OnAudio({});
+  EXPECT_EQ(fake_.appends, 0);
+}
