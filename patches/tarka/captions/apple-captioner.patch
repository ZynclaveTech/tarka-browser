+#if BUILDFLAG(IS_MAC)
+void CallCaptionsTabHelper::OnAppleRendered(bool is_final,
+                                            uint64_t generation,
+                                            const std::string& original,
+                                            tark_captions::AppleRenderError error,
+                                            const std::string& translation) {
+  const bool missing = error == tark_captions::AppleRenderError::kTranslationLanguageMissing;
+  if (missing != translation_language_missing_) {
+    translation_language_missing_ = missing;
+    observers_.Notify(&Observer::OnClientLanguageChanged, this);
+  }
+  OnRendered(is_final, generation, original, error == tark_captions::AppleRenderError::kNone,
+             std::string(), translation);
