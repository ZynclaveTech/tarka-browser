+namespace tark_captions {
+namespace {
+
+// The Swift library, faked: what was asked of it, and the callbacks to
+// answer with when a test decides.
+struct FakeApple {
+  int locale_status = 2;
+  int translation_status = 2;
+  std::string translation = "hello";
+  std::string started_locale;
+  void* ctx = nullptr;
+  tark_apple_result_fn result = nullptr;
+  tark_apple_progress_fn progress = nullptr;
+  tark_apple_done_fn install_done = nullptr;
+  void* install_ctx = nullptr;
+  int installs = 0;
+  size_t appended = 0;
+  int appends = 0;
+  int starts = 0;
+  tark_apple_failed_fn failed = nullptr;
+  bool stopped = false;
+  int handle = 0;
+};
+FakeApple* g_fake = nullptr;
+
+AppleSpeechLibrary::Functions FakeFunctions() {
+  AppleSpeechLibrary::Functions f;
+  f.available = [] { return 1; };
+  f.locale_status = [](const char*, void* ctx, tark_apple_status_fn done) {
+    done(ctx, g_fake->locale_status);
+  };
+  f.install = [](const char*, void* ctx, tark_apple_progress_fn progress, tark_apple_done_fn done) {
+    ++g_fake->installs;
+    g_fake->install_ctx = ctx;
+    g_fake->progress = progress;
+    g_fake->install_done = done;
+  };
+  f.transcriber_start = [](const char* locale, void* ctx, tark_apple_result_fn result,
+                           tark_apple_failed_fn failed) -> void* {
+    ++g_fake->starts;
+    g_fake->started_locale = locale;
+    g_fake->ctx = ctx;
+    g_fake->result = result;
+    g_fake->failed = failed;
+    return &g_fake->handle;
+  };
+  f.transcriber_append = [](void*, const float*, int count) {
+    ++g_fake->appends;
+    g_fake->appended += count;
+  };
+  f.transcriber_stop = [](void*, tark_apple_stopped_fn stopped) {
+    g_fake->stopped = true;
+    stopped(g_fake->ctx);
+  };
+  f.translation_status = [](const char*, const char*, void* ctx, tark_apple_status_fn done) {
+    done(ctx, g_fake->translation_status);
+  };
+  f.translate = [](const char*, const char*, const char*, void* ctx, tark_apple_text_fn done) {
+    done(ctx, 1, g_fake->translation.c_str());
+  };
+  return f;
+}
