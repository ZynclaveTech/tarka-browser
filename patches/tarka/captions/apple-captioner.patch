+void CallCaptionsTabHelper::RenderIndianHop(
+    const std::string& target,
+    const std::string& english,
+    base::OnceCallback<void(bool ok, const std::string& text)> reply) {
+  if (!translator_.is_bound()) {
+    std::move(reply).Run(false, std::string());
+    return;
+  }
+  translator_->Render(english, "en", std::string(), target,
+                      base::BindOnce(
+                          [](base::OnceCallback<void(bool, const std::string&)> reply, bool ok,
+                             const std::string& shown, const std::string& translation) {
+                            std::move(reply).Run(ok, translation);
+                          },
+                          std::move(reply)));
+}
