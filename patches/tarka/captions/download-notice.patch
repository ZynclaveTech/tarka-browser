+
+int64_t CaptionsMbToFollow(const std::vector<tark_captions::ModelUnit>& waiting,
+                           tark_captions::CaptionModelStore::State captions) {
+  using tark_captions::ModelUnit;
+  using State = tark_captions::CaptionModelStore::State;
+  if (!std::ranges::contains(waiting, ModelUnit::kLanguageId) ||
+      std::ranges::contains(waiting, ModelUnit::kCaptions) ||
+      (captions != State::kMissing && captions != State::kFailed)) {
+    return 0;
+  }
+  return tark_captions::Megabytes(tark_captions::UnitSize(ModelUnit::kCaptions));
+}
