+// The first CC press with nothing downloaded offers the download, with its
+// size, instead of starting it; never while detection's model is being
+// checked, fetched, here, or failed (that bar offers Retry).
+TEST(PillLanguageTest, OffersTheFirstDownloadOnlyWhenNothingIsHere) {
+  using State = tark_captions::CaptionModelStore::State;
+  EXPECT_TRUE(OffersFirstDownload(State::kMissing));
+  for (State state : {State::kChecking, State::kDownloading, State::kReady, State::kFailed}) {
+    EXPECT_FALSE(OffersFirstDownload(state)) << static_cast<int>(state);
+  }
+}
+
+// While detection's model downloads, the captions model that may follow
+// once Hindi, Tamil or Bengali is heard ("Then 680 MB more…").
+TEST(PillLanguageTest, CaptionsModelToFollow) {
+  using tark_captions::ModelUnit;
+  using State = tark_captions::CaptionModelStore::State;
+  const std::vector<ModelUnit> detection = {ModelUnit::kLanguageId};
+  const int64_t captions_mb =
+      tark_captions::Megabytes(tark_captions::UnitSize(ModelUnit::kCaptions));
+  ASSERT_GT(captions_mb, 600);
+  EXPECT_EQ(CaptionsMbToFollow(detection, State::kMissing), captions_mb);
+  EXPECT_EQ(CaptionsMbToFollow(detection, State::kFailed), captions_mb);
+  // Already here, already coming, or not known yet.
+  EXPECT_EQ(CaptionsMbToFollow(detection, State::kReady), 0);
+  EXPECT_EQ(CaptionsMbToFollow(detection, State::kDownloading), 0);
+  EXPECT_EQ(CaptionsMbToFollow(detection, State::kChecking), 0);
+  // A chosen Tark language downloads both at once: nothing follows.
+  EXPECT_EQ(CaptionsMbToFollow({ModelUnit::kLanguageId, ModelUnit::kCaptions}, State::kMissing),
+            0);
+  // Not waiting on detection (Translate's models): nothing to say.
+  EXPECT_EQ(CaptionsMbToFollow({ModelUnit::kToEnglish}, State::kMissing), 0);
+}
