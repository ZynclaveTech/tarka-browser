+std::u16string TarkCaptionPillController::WaitingNote() const {
+  if (!waiting_ || !waiting_for_captions_) {
+    return std::u16string();
+  }
+  using tark_captions::ModelUnit;
+  using State = tark_captions::CaptionModelStore::State;
+  const tark_captions::CaptionModelStore& models = tark_captions::TarkCaptionModels();
+  if (offering_) {
+    const std::u16string detection_mb = base::NumberToString16(
+        tark_captions::Megabytes(tark_captions::UnitSize(ModelUnit::kLanguageId)));
+    if (models.ready(ModelUnit::kCaptions)) {
+      return l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_FIRST_DOWNLOAD_SIZE, detection_mb);
+    }
+    return l10n_util::GetStringFUTF16(
+        IDS_TARK_CAPTIONS_FIRST_DOWNLOAD_SIZES, detection_mb,
+        base::NumberToString16(
+            tark_captions::Megabytes(tark_captions::UnitSize(ModelUnit::kCaptions))));
+  }
+  for (ModelUnit unit : waiting_units_) {
+    if (models.status(unit).state == State::kFailed) {
+      // The bar says it failed, with Retry.
+      return std::u16string();
+    }
+  }
+  const int64_t captions_mb =
+      CaptionsMbToFollow(waiting_units_, models.status(ModelUnit::kCaptions).state);
+  return captions_mb > 0 ? l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_THEN_MORE,
+                                                      base::NumberToString16(captions_mb))
+                         : std::u16string();
+}
