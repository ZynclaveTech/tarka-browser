+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/speech/tark_caption_recognizer.h"
+
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "media/mojo/mojom/audio_data.mojom.h"
+#include "media/mojo/mojom/speech_recognition_result.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+
+namespace speech {
+
+// The caption engine and its models, on a thread-pool sequence.
+class TarkCaptionRecognizer::Engine {
+ public:
+  Engine(const base::FilePath& ort_dylib,
+         const base::FilePath& models_dir,
+         tark_captions::Language language,
+         tark_captions::CaptionEngine::EventCallback on_event,
+         base::OnceClosure on_failed)
+      : engine_(tark_captions::CaptionEngine::Create(models_dir, ort_dylib)),
+        on_event_(std::move(on_event)) {
+    if (!engine_) {
+      std::move(on_failed).Run();
+      return;
+    }
+    engine_->SetLanguage(language);
+  }
+
+  void AddAudio(std::vector<int16_t> samples, int channels, int sample_rate) {
+    if (!engine_) {
+      return;
+    }
+    std::vector<float> floats(samples.size());
+    for (size_t i = 0; i < samples.size(); ++i) {
+      floats[i] = samples[i] / 32768.0f;
+    }
+    engine_->AddAudio(floats, channels, sample_rate, on_event_);
+  }
+
+  void Flush() {
+    if (engine_) {
+      engine_->Flush(on_event_);
+    }
+  }
+
+  void SetLanguage(tark_captions::Language language) {
+    if (engine_) {
+      engine_->SetLanguage(language);
+    }
+  }
+
+ private:
+  std::unique_ptr<tark_captions::CaptionEngine> engine_;
+  tark_captions::CaptionEngine::EventCallback on_event_;
+};
+
+// static
+void TarkCaptionRecognizer::Create(
+    mojo::PendingReceiver<media::mojom::SpeechRecognitionRecognizer> receiver,
+    mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client,
+    const base::FilePath& ort_dylib,
+    const base::FilePath& models_dir,
+    const std::string& language) {
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<TarkCaptionRecognizer>(std::move(client), ort_dylib, models_dir, language),
+      std::move(receiver));
+}
+
+// static
+std::optional<tark_captions::Language> TarkCaptionRecognizer::ParseLanguage(
+    const std::string& code) {
+  return tark_captions::LanguageFromCode(code.substr(0, code.find('-')));
+}
+
+TarkCaptionRecognizer::TarkCaptionRecognizer(
+    mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client,
+    const base::FilePath& ort_dylib,
+    const base::FilePath& models_dir,
+    const std::string& language)
+    : client_(std::move(client)) {
+  scoped_refptr<base::SequencedTaskRunner> here = base::SequencedTaskRunner::GetCurrentDefault();
+  engine_ = base::SequenceBound<Engine>(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+      ort_dylib, models_dir, ParseLanguage(language).value_or(tark_captions::Language::kHindi),
+      base::BindPostTask(here, base::BindRepeating(&TarkCaptionRecognizer::OnEvent,
+                                                   weak_factory_.GetWeakPtr())),
+      base::BindPostTask(here, base::BindOnce(&TarkCaptionRecognizer::OnEngineFailed,
+                                              weak_factory_.GetWeakPtr())));
+}
+
+TarkCaptionRecognizer::~TarkCaptionRecognizer() = default;
+
+void TarkCaptionRecognizer::SendAudioToSpeechRecognitionService(
+    media::mojom::AudioDataS16Ptr buffer,
+    std::optional<base::TimeDelta> media_start_pts) {
+  if (failed_ || !buffer || buffer->channel_count < 1) {
+    return;
+  }
+  engine_.AsyncCall(&Engine::AddAudio)
+      .WithArgs(std::move(buffer->data), buffer->channel_count, buffer->sample_rate);
+}
+
+void TarkCaptionRecognizer::MarkDone() {
+  engine_.AsyncCall(&Engine::Flush);
+}
+
+void TarkCaptionRecognizer::OnLanguageChanged(const std::string& language) {
+  if (std::optional<tark_captions::Language> parsed = ParseLanguage(language)) {
+    engine_.AsyncCall(&Engine::SetLanguage).WithArgs(*parsed);
+  }
+}
+
+void TarkCaptionRecognizer::OnMaskOffensiveWordsChanged(bool mask_offensive_words) {}
+
+void TarkCaptionRecognizer::UpdateRecognitionContext(
+    const media::SpeechRecognitionRecognitionContext& recognition_context) {}
+
+void TarkCaptionRecognizer::OnEvent(tark_captions::CaptionEvent event) {
+  // Never the text: call content stays out of logs.
+  VLOG(1) << "Tark captions: " << (event.is_final ? "final" : "draft") << ", "
+          << event.text.size() << " bytes";
+  client_->OnSpeechRecognitionRecognitionEvent(
+      media::SpeechRecognitionResult(event.text, event.is_final), base::DoNothing());
+}
+
+void TarkCaptionRecognizer::OnEngineFailed() {
+  failed_ = true;
+  client_->OnSpeechRecognitionError();
+}
+
+}  // namespace speech
