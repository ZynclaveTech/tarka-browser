+class FakeClient : public media::mojom::SpeechRecognitionRecognizerClient {
+ public:
+  void OnSpeechRecognitionRecognitionEvent(
+      const media::SpeechRecognitionResult& result,
+      OnSpeechRecognitionRecognitionEventCallback reply) override {
+    (result.is_final ? finals : drafts).push_back(result.transcription);
+    std::move(reply).Run(true);
+  }
+  void OnSpeechRecognitionStopped() override {}
+  void OnSpeechRecognitionError() override { error = true; }
+  void OnLanguageIdentificationEvent(media::mojom::LanguageIdentificationEventPtr) override {}
+
+  std::vector<std::string> finals;
+  std::vector<std::string> drafts;
+  bool error = false;
+};
+
+class TarkCaptionRecognizerTest : public testing::Test {
+ protected:
+  void Bind(const base::FilePath& ort, const base::FilePath& models, const std::string& lang) {
+    TarkCaptionRecognizer::Create(recognizer_.BindNewPipeAndPassReceiver(),
+                                  client_receiver_.BindNewPipeAndPassRemote(), ort, models, lang);
+  }
+
+  base::test::TaskEnvironment env_;
+  FakeClient client_;
+  mojo::Receiver<media::mojom::SpeechRecognitionRecognizerClient> client_receiver_{&client_};
+  mojo::Remote<media::mojom::SpeechRecognitionRecognizer> recognizer_;
+};
+
+TEST_F(TarkCaptionRecognizerTest, ForwardsFinalAndDrafts) {
+  std::optional<base::FilePath> ort = tark_captions::test::OrtPath();
+  std::optional<base::FilePath> models = tark_captions::test::ModelsDir();
+  std::optional<base::FilePath> testdata = tark_captions::test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort, *models, "hi-IN");
+  int rate = 0;
+  std::vector<float> pcm = tark_captions::test::ReadWav(testdata->Append("hi_1.wav"), &rate);
+  pcm.insert(pcm.end(), 16000, 0.0f);
+  for (size_t i = 0; i < pcm.size(); i += 160) {
+    auto buffer = media::mojom::AudioDataS16::New();
+    buffer->channel_count = 1;
+    buffer->sample_rate = 16000;
+    for (size_t j = i; j < std::min(i + 160, pcm.size()); ++j) {
+      buffer->data.push_back(static_cast<int16_t>(pcm[j] * 32767));
+    }
+    buffer->frame_count = static_cast<int>(buffer->data.size());
+    recognizer_->SendAudioToSpeechRecognitionService(std::move(buffer), std::nullopt);
+  }
+  recognizer_->MarkDone();
+  // The clip's second half ("...पैदल यात्रा मार्ग..."), after the 5 s cut.
+  const std::string yatra = "\xE0\xA4\xAF\xE0\xA4\xBE\xE0\xA4\xA4\xE0\xA5\x8D\xE0\xA4\xB0\xE0\xA4\xBE";
+  auto joined = [&] {
+    std::string all;
+    for (const std::string& f : client_.finals) {
+      all += f + " ";
+    }
+    return all;
+  };
+  ASSERT_TRUE(base::test::RunUntil([&] { return joined().find(yatra) != std::string::npos; }))
+      << joined();
+  EXPECT_FALSE(client_.error);
+  EXPECT_FALSE(client_.drafts.empty());
+}
+
+TEST_F(TarkCaptionRecognizerTest, ErrorWhenEngineMissing) {
+  Bind(base::FilePath("/nonexistent/libonnxruntime.dylib"), base::FilePath("/nonexistent"), "hi");
+  ASSERT_TRUE(base::test::RunUntil([&] { return client_.error; }));
+}
+
+TEST_F(TarkCaptionRecognizerTest, ParsesLanguages) {
+  EXPECT_EQ(TarkCaptionRecognizer::ParseLanguage("hi-IN"), tark_captions::Language::kHindi);
+  EXPECT_EQ(TarkCaptionRecognizer::ParseLanguage("ta"), tark_captions::Language::kTamil);
+  EXPECT_EQ(TarkCaptionRecognizer::ParseLanguage("bn-IN"), tark_captions::Language::kBengali);
+  EXPECT_EQ(TarkCaptionRecognizer::ParseLanguage("en-US"), std::nullopt);
+}
