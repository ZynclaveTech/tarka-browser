+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_SERVICES_SPEECH_TARK_CAPTION_RECOGNIZER_H_
+#define CHROME_SERVICES_SPEECH_TARK_CAPTION_RECOGNIZER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "components/tark_captions/caption_engine.h"
+#include "media/mojo/mojom/speech_recognition.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace speech {
+
+// Tark (D4): the speech service's recognizer, with Tark's caption engine
+// (components/tark_captions) in place of SODA. Audio arrives from the
+// renderer's caption hook (for a call: the tab's WebRTC remote audio);
+// drafts and finals go back to the client as SpeechRecognitionResults. The
+// engine runs on its own sequence so decoding never blocks the IPC thread.
+class TarkCaptionRecognizer : public media::mojom::SpeechRecognitionRecognizer {
+ public:
+  // Binds a self-owned recognizer to `receiver`. `language` is a code such
+  // as "hi" or "hi-IN"; an unsupported one means Hindi.
+  static void Create(
+      mojo::PendingReceiver<media::mojom::SpeechRecognitionRecognizer> receiver,
+      mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client,
+      const base::FilePath& ort_dylib,
+      const base::FilePath& models_dir,
+      const std::string& language);
+
+  TarkCaptionRecognizer(
+      mojo::PendingRemote<media::mojom::SpeechRecognitionRecognizerClient> client,
+      const base::FilePath& ort_dylib,
+      const base::FilePath& models_dir,
+      const std::string& language);
+  TarkCaptionRecognizer(const TarkCaptionRecognizer&) = delete;
+  TarkCaptionRecognizer& operator=(const TarkCaptionRecognizer&) = delete;
+  ~TarkCaptionRecognizer() override;
+
+  // "hi", "hi-IN", "ta-IN"... -> the engine's language, if it has one.
+  static std::optional<tark_captions::Language> ParseLanguage(const std::string& code);
+
+  // media::mojom::SpeechRecognitionRecognizer:
+  void SendAudioToSpeechRecognitionService(
+      media::mojom::AudioDataS16Ptr buffer,
+      std::optional<base::TimeDelta> media_start_pts) final;
+  void MarkDone() final;
+  void OnLanguageChanged(const std::string& language) final;
+  void OnMaskOffensiveWordsChanged(bool mask_offensive_words) final;
+  void UpdateRecognitionContext(
+      const media::SpeechRecognitionRecognitionContext& recognition_context) final;
+
+ private:
+  class Engine;
+
+  void OnEvent(tark_captions::CaptionEvent event);
+  void OnEngineFailed();
+
+  mojo::Remote<media::mojom::SpeechRecognitionRecognizerClient> client_;
+  base::SequenceBound<Engine> engine_;
+  bool failed_ = false;
+  base::WeakPtrFactory<TarkCaptionRecognizer> weak_factory_{this};
+};
+
+}  // namespace speech
+
+#endif  // CHROME_SERVICES_SPEECH_TARK_CAPTION_RECOGNIZER_H_
