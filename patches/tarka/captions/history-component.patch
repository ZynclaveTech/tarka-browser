+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_HISTORY_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_HISTORY_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "base/containers/circular_deque.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+
+namespace base {
+class TickClock;
+}
+
+namespace tark_captions {
+
+// "0:42", "1:05", "1:05:03": a row's time in the captions history.
+std::u16string HistoryTime(base::TimeDelta at);
+
+// D4 captions history (spec 2026-10-22-tark-d4-captions-history-design.md):
+// everything said in a tab since its captions came on, in memory only, for
+// the history panel. One row per final caption, in the speaker's own script
+// until its render (the chosen script and the translation) arrives.
+class CaptionHistory {
+ public:
+  enum class Kind { kLine, kNewVideo, kRestarted };
+  struct Row {
+    uint64_t id = 0;       // Stable and increasing; never reused.
+    uint32_t version = 0;  // Bumped when Rendered() changes the row.
+    Kind kind = Kind::kLine;
+    base::TimeDelta at;    // Since captions first came on.
+    std::u16string text;
+    std::u16string translation;  // Empty when Translate was off.
+  };
+  struct Draft {
+    std::u16string text;
+    std::u16string translation;
+  };
+
+  // The newest 2 hours or ~1 MB of text (UTF-16 units), whichever is less.
+  static constexpr base::TimeDelta kMaxAge = base::Hours(2);
+  static constexpr size_t kMaxChars = 500'000;
+
+  explicit CaptionHistory(const base::TickClock* clock);
+  CaptionHistory(const CaptionHistory&) = delete;
+  CaptionHistory& operator=(const CaptionHistory&) = delete;
+  ~CaptionHistory();
+
+  // Captions came on: the first call sets the time origin.
+  void Start();
+  // A final caption; returns its row's id. Clears the draft.
+  uint64_t AddFinal(const std::string& text);
+  // The final `id` as shown (another script) and translated; nothing if the
+  // row is gone.
+  void Rendered(uint64_t id, const std::string& shown, const std::string& translation);
+  void SetDraft(const std::string& text, const std::string& translation = std::string());
+  // A "New video" or "Captions restarted" line; only after a caption line.
+  void AddDivider(Kind kind);
+  // Captions at once: rows from a guess go if the guess was wrong.
+  void BeginGuess();
+  void DropGuess();
+  void KeepGuess();
+  void Clear();
+
+  const base::circular_deque<Row>& rows() const { return rows_; }
+  const Draft& draft() const { return draft_; }
+  // The oldest rows went for the limits.
+  bool dropped() const { return dropped_; }
+  bool empty() const { return rows_.empty() && draft_.text.empty(); }
+
+  // Plain text for Copy: "0:42  line", the translation indented below,
+  // dividers as "— New video —". The draft is left out.
+  std::u16string CopyText(const std::u16string& new_video, const std::u16string& restarted) const;
+
+ private:
+  void Trim();
+
+  raw_ptr<const base::TickClock> clock_;
+  std::optional<base::TimeTicks> origin_;
+  base::circular_deque<Row> rows_;
+  Draft draft_;
+  uint64_t next_id_ = 1;
+  size_t chars_ = 0;
+  bool dropped_ = false;
+  // The id of the first row of the current guess.
+  std::optional<uint64_t> guess_from_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_HISTORY_H_
