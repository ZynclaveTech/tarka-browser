+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_history.h"
+
+#include <string>
+#include <vector>
+
+#include "base/test/simple_test_tick_clock.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+std::vector<std::u16string> Texts(const CaptionHistory& history) {
+  std::vector<std::u16string> texts;
+  for (const CaptionHistory::Row& row : history.rows()) {
+    texts.push_back(row.text);
+  }
+  return texts;
+}
+
+class CaptionHistoryTest : public testing::Test {
+ protected:
+  base::SimpleTestTickClock clock_;
+  CaptionHistory history_{&clock_};
+};
+
+TEST(HistoryTimeTest, Formats) {
+  EXPECT_EQ(HistoryTime(base::Seconds(42)), u"0:42");
+  EXPECT_EQ(HistoryTime(base::Seconds(65)), u"1:05");
+  EXPECT_EQ(HistoryTime(base::Seconds(3903)), u"1:05:03");
+}
+
+TEST_F(CaptionHistoryTest, KeepsFinalsInOrderWithTimes) {
+  history_.Start();
+  clock_.Advance(base::Seconds(42));
+  const uint64_t a = history_.AddFinal("a");
+  clock_.Advance(base::Seconds(5));
+  const uint64_t b = history_.AddFinal("b");
+  EXPECT_EQ(Texts(history_), (std::vector<std::u16string>{u"a", u"b"}));
+  EXPECT_EQ(history_.rows()[0].at, base::Seconds(42));
+  EXPECT_EQ(history_.rows()[1].at, base::Seconds(47));
+  EXPECT_GT(b, a);
+  EXPECT_EQ(history_.rows()[0].kind, CaptionHistory::Kind::kLine);
+}
+
+TEST_F(CaptionHistoryTest, BlankFinalAddsNoRow) {
+  history_.Start();
+  EXPECT_EQ(history_.AddFinal("  "), 0u);
+  EXPECT_TRUE(history_.rows().empty());
+}
+
+TEST_F(CaptionHistoryTest, FinalClearsTheDraft) {
+  history_.Start();
+  history_.SetDraft("so far", "until now");
+  EXPECT_EQ(history_.draft().text, u"so far");
+  EXPECT_EQ(history_.draft().translation, u"until now");
+  history_.AddFinal("so far it went");
+  EXPECT_TRUE(history_.draft().text.empty());
+  EXPECT_TRUE(history_.draft().translation.empty());
+}
+
+TEST_F(CaptionHistoryTest, RenderedReplacesTextAndAddsTranslation) {
+  history_.Start();
+  const uint64_t id = history_.AddFinal("नमस्ते");
+  const uint32_t version = history_.rows()[0].version;
+  history_.Rendered(id, "namaste", "hello");
+  EXPECT_EQ(history_.rows()[0].text, u"namaste");
+  EXPECT_EQ(history_.rows()[0].translation, u"hello");
+  EXPECT_EQ(history_.rows()[0].version, version + 1);
+}
+
+TEST_F(CaptionHistoryTest, RenderedForUnknownIdChangesNothing) {
+  history_.Start();
+  history_.AddFinal("a");
+  history_.Rendered(999, "x", "y");
+  EXPECT_EQ(Texts(history_), std::vector<std::u16string>{u"a"});
+  EXPECT_TRUE(history_.rows()[0].translation.empty());
+}
+
+TEST_F(CaptionHistoryTest, DropGuessRemovesRowsSinceTheGuessBegan) {
+  history_.Start();
+  history_.AddFinal("a");
+  history_.BeginGuess();
+  history_.AddFinal("b");
+  const uint64_t c = history_.AddFinal("c");
+  history_.SetDraft("d so far");
+  history_.DropGuess();
+  EXPECT_EQ(Texts(history_), std::vector<std::u16string>{u"a"});
+  EXPECT_TRUE(history_.draft().text.empty());
+  EXPECT_GT(history_.AddFinal("d"), c);
+}
+
+TEST_F(CaptionHistoryTest, KeepGuessKeepsRows) {
+  history_.Start();
+  history_.BeginGuess();
+  history_.AddFinal("a");
+  history_.KeepGuess();
+  history_.DropGuess();
+  EXPECT_EQ(Texts(history_), std::vector<std::u16string>{u"a"});
+}
+
+TEST_F(CaptionHistoryTest, DropGuessWithoutAGuessDropsNothing) {
+  history_.Start();
+  history_.AddFinal("a");
+  history_.DropGuess();
+  EXPECT_EQ(Texts(history_), std::vector<std::u16string>{u"a"});
+}
+
+TEST_F(CaptionHistoryTest, DividersOnlyBetweenLines) {
+  history_.Start();
+  history_.AddDivider(CaptionHistory::Kind::kNewVideo);
+  EXPECT_TRUE(history_.rows().empty());
+  history_.AddFinal("a");
+  history_.AddDivider(CaptionHistory::Kind::kNewVideo);
+  history_.AddDivider(CaptionHistory::Kind::kRestarted);
+  ASSERT_EQ(history_.rows().size(), 2u);
+  EXPECT_EQ(history_.rows()[1].kind, CaptionHistory::Kind::kNewVideo);
+}
+
+TEST_F(CaptionHistoryTest, DropsRowsOlderThanTwoHours) {
+  history_.Start();
+  history_.AddFinal("old");
+  EXPECT_FALSE(history_.dropped());
+  clock_.Advance(CaptionHistory::kMaxAge + base::Seconds(1));
+  history_.AddFinal("new");
+  EXPECT_EQ(Texts(history_), std::vector<std::u16string>{u"new"});
+  EXPECT_TRUE(history_.dropped());
+}
+
+TEST_F(CaptionHistoryTest, DropsOldestPastTheTextLimit) {
+  history_.Start();
+  for (int i = 0; i < 4; ++i) {
+    history_.AddFinal(std::string(200'000, static_cast<char>('a' + i)));
+  }
+  size_t total = 0;
+  for (const CaptionHistory::Row& row : history_.rows()) {
+    total += row.text.size() + row.translation.size();
+  }
+  EXPECT_LE(total, CaptionHistory::kMaxChars);
+  EXPECT_EQ(history_.rows().back().text, std::u16string(200'000, u'd'));
+  EXPECT_TRUE(history_.dropped());
+}
+
+TEST_F(CaptionHistoryTest, CopyTextMixesRowsWithAndWithoutTranslation) {
+  history_.Start();
+  clock_.Advance(base::Seconds(42));
+  const uint64_t a = history_.AddFinal("a");
+  history_.Rendered(a, "a", "A");
+  history_.AddDivider(CaptionHistory::Kind::kNewVideo);
+  clock_.Advance(base::Seconds(3903 - 42));
+  history_.AddFinal("b");
+  history_.SetDraft("d");
+  EXPECT_EQ(history_.CopyText(u"New video", u"Captions restarted"),
+            u"0:42  a\n      A\n— New video —\n1:05:03  b\n");
+}
+
+TEST_F(CaptionHistoryTest, ClearForgetsEverything) {
+  history_.Start();
+  clock_.Advance(CaptionHistory::kMaxAge + base::Seconds(1));
+  history_.AddFinal("a");
+  history_.BeginGuess();
+  history_.SetDraft("b");
+  history_.Clear();
+  EXPECT_TRUE(history_.empty());
+  EXPECT_FALSE(history_.dropped());
+  clock_.Advance(base::Seconds(10));
+  history_.Start();
+  clock_.Advance(base::Seconds(3));
+  history_.AddFinal("c");
+  EXPECT_EQ(history_.rows()[0].at, base::Seconds(3));
+  history_.DropGuess();
+  EXPECT_EQ(history_.rows().size(), 1u);
+}
+
+TEST_F(CaptionHistoryTest, StartAgainKeepsTheTimeOrigin) {
+  history_.Start();
+  clock_.Advance(base::Seconds(30));
+  history_.Start();
+  history_.AddFinal("a");
+  EXPECT_EQ(history_.rows()[0].at, base::Seconds(30));
+}
+
+}  // namespace
+}  // namespace tark_captions
