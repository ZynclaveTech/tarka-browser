+// The captions history pairs a final with its render by this id.
+TEST(RenderQueueTest, CarriesTheHistoryId) {
+  RenderQueue queue;
+  queue.Add(true, "a", "hi", 7);
+  std::optional<RenderRequest> next = queue.Next();
+  ASSERT_TRUE(next);
+  EXPECT_EQ(next->history_id, 7u);
+  queue.Done(next->generation);
+  queue.Add(false, "b", "hi");
+  EXPECT_EQ(queue.Next()->history_id, 0u);
+}
