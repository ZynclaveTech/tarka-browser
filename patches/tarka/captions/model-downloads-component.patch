+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/model_manifest.h"
+
+namespace tark_captions {
+
+int64_t UnitSize(const ModelUnitInfo& info) {
+  int64_t size = 0;
+  for (const ModelFile& file : info.files) {
+    size += file.size;
+  }
+  return size;
+}
+
+std::vector<ModelUnit> UnitsForTranslation(Target target) {
+  switch (target) {
+    case Target::kNone:
+      return {};
+    case Target::kEnglish:
+      return {ModelUnit::kToEnglish};
+    case Target::kHindi:
+    case Target::kTamil:
+    case Target::kBengali:
+      return {ModelUnit::kToEnglish, ModelUnit::kFromEnglish};
+  }
+}
+
+}  // namespace tark_captions
