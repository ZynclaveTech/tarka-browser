+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/model_manifest.h"
+
+#include <set>
+#include <string>
+
+#include "base/notreached.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+std::set<std::string> PathsOf(ModelUnit unit) {
+  std::set<std::string> paths;
+  for (const ModelUnitInfo& info : ModelManifest()) {
+    if (info.unit == unit) {
+      for (const ModelFile& file : info.files) {
+        paths.insert(file.path);
+      }
+    }
+  }
+  return paths;
+}
+
+const ModelUnitInfo& InfoOf(ModelUnit unit) {
+  for (const ModelUnitInfo& info : ModelManifest()) {
+    if (info.unit == unit) {
+      return info;
+    }
+  }
+  NOTREACHED();
+}
+
+TEST(ModelManifestTest, UnitsCoverTheEngineFiles) {
+  EXPECT_EQ(PathsOf(ModelUnit::kCaptions),
+            (std::set<std::string>{"ctc_decoder.onnx", "encoder.int8.onnx", "language_masks.json",
+                                   "mel_fb.f32", "silero_vad.onnx", "vocab.json", "window.f32"}));
+  const std::set<std::string> kTranslation = {"LICENSE", "config.json", "decoder_step.int8.onnx",
+                                              "dict.SRC.json", "dict.TGT.json",
+                                              "encoder.int8.onnx", "model.SRC"};
+  for (const auto& [unit, folder] : {std::pair(ModelUnit::kToEnglish, "it2_indic_en/"),
+                                     std::pair(ModelUnit::kFromEnglish, "it2_en_indic/")}) {
+    std::set<std::string> expected;
+    for (const std::string& name : kTranslation) {
+      expected.insert(folder + name);
+    }
+    EXPECT_EQ(PathsOf(unit), expected);
+  }
+  for (const ModelUnitInfo& info : ModelManifest()) {
+    for (const ModelFile& file : info.files) {
+      EXPECT_EQ(std::string(file.sha256).size(), 64u) << file.path;
+      EXPECT_EQ(std::string(file.sha256).find_first_not_of("0123456789abcdef"),
+                std::string::npos)
+          << file.path;
+      EXPECT_GT(file.size, 0) << file.path;
+    }
+  }
+  EXPECT_GE(UnitSize(InfoOf(ModelUnit::kCaptions)), 600 * 1000 * 1000);
+  EXPECT_GE(UnitSize(InfoOf(ModelUnit::kToEnglish)), 200 * 1000 * 1000);
+  EXPECT_GE(UnitSize(InfoOf(ModelUnit::kFromEnglish)), 200 * 1000 * 1000);
+}
+
+TEST(ModelManifestTest, UnitsForTranslation) {
+  EXPECT_TRUE(UnitsForTranslation(Target::kNone).empty());
+  EXPECT_EQ(UnitsForTranslation(Target::kEnglish), std::vector<ModelUnit>{ModelUnit::kToEnglish});
+  EXPECT_EQ(UnitsForTranslation(Target::kTamil),
+            (std::vector<ModelUnit>{ModelUnit::kToEnglish, ModelUnit::kFromEnglish}));
+}
