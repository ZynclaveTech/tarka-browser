+namespace tark_captions {
+namespace {
+
+using State = CaptionModelStore::State;
+
+constexpr char kBase[] = "https://models.test/v1/";
+
+struct TestFile {
+  std::string path;
+  std::string content;
+  std::string sha256;
+};
+
+class Recorder : public CaptionModelStore::Observer {
+ public:
+  explicit Recorder(CaptionModelStore* store) : store_(store) {}
+  void OnModelStatusChanged(ModelUnit unit) override {
+    statuses.push_back(store_->status(unit));
+  }
+  std::vector<CaptionModelStore::Status> statuses;
+
+ private:
+  raw_ptr<CaptionModelStore> store_;
+};
+
+class CaptionModelStoreTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    AddFile(&captions_, "a.bin", "alpha");
+    AddFile(&captions_, "sub/b.bin", "bravo bravo");
+    AddFile(&to_english_, "it/c.bin", "charlie");
+    AddFile(&from_english_, "it2/d.bin", "delta");
+    for (auto [list, files] :
+         {std::pair(&captions_, &captions_files_), std::pair(&to_english_, &to_english_files_),
+          std::pair(&from_english_, &from_english_files_)}) {
+      for (const TestFile& f : *list) {
+        files->push_back(
+            {f.path.c_str(), static_cast<int64_t>(f.content.size()), f.sha256.c_str()});
+      }
+    }
+    manifest_ = {{ModelUnit::kCaptions, "captions", captions_files_},
+                 {ModelUnit::kToEnglish, "to_english", to_english_files_},
+                 {ModelUnit::kFromEnglish, "from_english", from_english_files_}};
+  }
+
+  // File work posted by a store can outlive it; it reads the test manifest,
+  // which must outlive that work.
+  void TearDown() override { env_.RunUntilIdle(); }
+
+  void AddFile(std::vector<TestFile>* list, std::string path, std::string content) {
+    list->push_back({path, content, base::HexEncodeLower(crypto::hash::Sha256(content))});
+  }
+
+  std::unique_ptr<CaptionModelStore> MakeStore() {
+    return std::make_unique<CaptionModelStore>(
+        dir_.GetPath(),
+        base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(&factory_),
+        GURL(kBase), manifest_, TRAFFIC_ANNOTATION_FOR_TESTS);
+  }
+
+  // Waits until `store` is done checking what is on disk.
+  void WaitChecked(CaptionModelStore* store) {
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      for (const ModelUnitInfo& info : manifest_) {
+        if (store->status(info.unit).state == State::kChecking) {
+          return false;
+        }
+      }
+      return true;
+    }));
+  }
+
+  void Serve(const std::vector<TestFile>& files) {
+    for (const TestFile& f : files) {
+      factory_.AddResponse(std::string(kBase) + f.path, f.content);
+    }
+  }
+
+  bool WaitFor(CaptionModelStore* store, ModelUnit unit, State state) {
+    return base::test::RunUntil([&] { return store->status(unit).state == state; });
+  }
+
+  std::string Read(const std::string& path) {
+    std::string content;
+    base::ReadFileToString(dir_.GetPath().AppendASCII(path), &content);
+    return content;
+  }
+
+  bool DownloadFolderEmpty() {
+    const base::FilePath download = dir_.GetPath().AppendASCII(".download");
+    return !base::PathExists(download) || base::IsDirectoryEmpty(download);
+  }
+
+  base::test::TaskEnvironment env_;
+  base::ScopedTempDir dir_;
+  network::TestURLLoaderFactory factory_;
+  std::vector<TestFile> captions_, to_english_, from_english_;
+  std::vector<ModelFile> captions_files_, to_english_files_, from_english_files_;
+  std::vector<ModelUnitInfo> manifest_;
+};
+
+TEST_F(CaptionModelStoreTest, DownloadsVerifiesAndMarksReady) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).state, State::kMissing);
+  Serve(captions_);
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kReady));
+  EXPECT_EQ(Read("a.bin"), "alpha");
+  EXPECT_EQ(Read("sub/b.bin"), "bravo bravo");
+  EXPECT_TRUE(DownloadFolderEmpty());
+  store.reset();
+  auto again = MakeStore();
+  WaitChecked(again.get());
+  EXPECT_EQ(again->status(ModelUnit::kCaptions).state, State::kReady);
+  EXPECT_EQ(again->status(ModelUnit::kToEnglish).state, State::kMissing);
+}
+
+TEST_F(CaptionModelStoreTest, ProgressReported) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  Recorder recorder(store.get());
+  store->AddObserver(&recorder);
+  Serve(captions_);
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kReady));
+  store->RemoveObserver(&recorder);
+  bool saw_downloading = false;
+  for (const auto& s : recorder.statuses) {
+    if (s.state == State::kDownloading) {
+      saw_downloading = true;
+      EXPECT_EQ(s.total, 16);
+      EXPECT_LE(s.done, s.total);
+    }
+  }
+  EXPECT_TRUE(saw_downloading);
+  EXPECT_EQ(recorder.statuses.back().state, State::kReady);
+}
+
+TEST_F(CaptionModelStoreTest, BadHashFailsAndCleansUp) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  factory_.AddResponse(std::string(kBase) + "a.bin", "alphz");
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kFailed));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("a.bin")));
+  ASSERT_TRUE(base::test::RunUntil([&] { return DownloadFolderEmpty(); }));
+}
+
+TEST_F(CaptionModelStoreTest, WrongSizeFails) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  factory_.AddResponse(std::string(kBase) + "a.bin", "alpha and more");
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kFailed));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("a.bin")));
+}
+
+TEST_F(CaptionModelStoreTest, NetworkErrorFailsAndCleansUp) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  factory_.AddResponse(GURL(std::string(kBase) + "a.bin"), network::mojom::URLResponseHead::New(),
+                       "", network::URLLoaderCompletionStatus(net::ERR_INTERNET_DISCONNECTED));
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kFailed));
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).done, 0);
+  ASSERT_TRUE(base::test::RunUntil([&] { return DownloadFolderEmpty(); }));
+}
+
+TEST_F(CaptionModelStoreTest, CancelStopsAndCleansUp) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(base::test::RunUntil([&] { return factory_.NumPending() == 1; }));
+  store->Cancel(ModelUnit::kCaptions);
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).state, State::kMissing);
+  ASSERT_TRUE(base::test::RunUntil([&] { return DownloadFolderEmpty(); }));
+}
+
+TEST_F(CaptionModelStoreTest, LeftoverPartialsIgnored) {
+  ASSERT_TRUE(base::CreateDirectory(dir_.GetPath().AppendASCII(".download")));
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII(".download/a.bin"), "alp"));
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).state, State::kMissing);
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII(".download")));
+}
+
+// The models a developer copied by hand (no marker): checked once, then
+// ready without a download.
+TEST_F(CaptionModelStoreTest, ExistingFolderVerifiedOnce) {
+  for (const TestFile& f : to_english_) {
+    const base::FilePath path = dir_.GetPath().AppendASCII(f.path);
+    ASSERT_TRUE(base::CreateDirectory(path.DirName()));
+    ASSERT_TRUE(base::WriteFile(path, f.content));
+  }
+  auto store = MakeStore();
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kToEnglish, State::kReady));
+  EXPECT_EQ(factory_.NumPending(), 0);
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).state, State::kMissing);
+}
+
+TEST_F(CaptionModelStoreTest, RemoveDeletesFiles) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  Serve(captions_);
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kReady));
+  EXPECT_TRUE(store->Remove(ModelUnit::kCaptions));
+  EXPECT_EQ(store->status(ModelUnit::kCaptions).state, State::kMissing);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !base::PathExists(dir_.GetPath().AppendASCII("a.bin")); }));
+  auto again = MakeStore();
+  WaitChecked(again.get());
+  EXPECT_EQ(again->status(ModelUnit::kCaptions).state, State::kMissing);
+}
+
+TEST_F(CaptionModelStoreTest, RemoveRefusedWhileInUse) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  Serve(captions_);
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kReady));
+  store->SetInUse(ModelUnit::kCaptions, true);
+  EXPECT_FALSE(store->Remove(ModelUnit::kCaptions));
+  EXPECT_EQ(Read("a.bin"), "alpha");
+  store->SetInUse(ModelUnit::kCaptions, false);
+  EXPECT_TRUE(store->Remove(ModelUnit::kCaptions));
+}
+
+TEST_F(CaptionModelStoreTest, RequestsOnlyTheBaseUrl) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(base::test::RunUntil([&] { return factory_.NumPending() == 1; }));
+  for (const network::TestURLLoaderFactory::PendingRequest& p : *factory_.pending_requests()) {
+    EXPECT_TRUE(p.request.url.spec().starts_with(kBase)) << p.request.url;
+    EXPECT_EQ(p.request.credentials_mode, network::mojom::CredentialsMode::kOmit);
+  }
+}
+
+TEST_F(CaptionModelStoreTest, BytesOnDisk) {
+  auto store = MakeStore();
+  WaitChecked(store.get());
+  EXPECT_EQ(store->BytesOnDisk(), 0);
+  Serve(captions_);
+  store->Download(ModelUnit::kCaptions);
+  ASSERT_TRUE(WaitFor(store.get(), ModelUnit::kCaptions, State::kReady));
+  EXPECT_EQ(store->BytesOnDisk(), 16);
+}
