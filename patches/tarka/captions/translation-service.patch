+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/speech/tark_caption_translator.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "components/tark_captions/asr_model.h"
+#include "components/tark_captions/indic_text.h"
+#include "components/tark_captions/romanize.h"
+#include "components/tark_captions/translation_engine.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+
+namespace speech {
+
+namespace {
+
+struct Result {
+  bool ok = false;
+  std::string shown;
+  std::string translation;
+};
+
+}  // namespace
+
+// Lives on a thread-pool sequence that may block (model loads, decoding).
+class TarkCaptionTranslator::Worker {
+ public:
+  Worker(const base::FilePath& ort_dylib, const base::FilePath& models_dir)
+      : ort_dylib_(ort_dylib), models_dir_(models_dir) {}
+
+  Result Render(const std::string& text,
+                const std::string& source_code,
+                const std::string& script,
+                const std::string& target_code) {
+    Result result;
+    const std::optional<tark_captions::Language> source =
+        tark_captions::LanguageFromCode(source_code);
+    const std::optional<tark_captions::Target> target =
+        tark_captions::TargetFromCode(target_code);
+    if (!source) {
+      return result;
+    }
+    if (script.empty()) {
+      result.shown = text;
+    } else if (script == "latn") {
+      result.shown =
+          base::UTF16ToUTF8(tark_captions::Romanize(base::UTF8ToUTF16(text), *source));
+    } else if (const std::optional<tark_captions::Language> other =
+                   tark_captions::LanguageFromCode(script)) {
+      result.shown = base::UTF16ToUTF8(tark_captions::ConvertScript(
+          base::UTF8ToUTF16(text), tark_captions::ScriptOf(*source),
+          tark_captions::ScriptOf(*other)));
+    } else {
+      return result;
+    }
+    if (!target) {
+      return result;
+    }
+    if (*target != tark_captions::Target::kNone && !engine_) {
+      engine_ = tark_captions::TranslationEngine::Create(models_dir_, ort_dylib_);
+    }
+    std::optional<std::string> translation =
+        *target == tark_captions::Target::kNone
+            ? std::string()
+            : (engine_ ? engine_->Translate(text, *source, *target) : std::nullopt);
+    // Codes and sizes only: call content stays out of logs.
+    VLOG(1) << "Tark translation: " << source_code << " -> " << (script.empty() ? "-" : script)
+            << " / " << (target_code.empty() ? "-" : target_code) << ", " << text.size()
+            << " bytes in, " << (translation ? translation->size() : 0) << " bytes out";
+    if (!translation) {
+      return result;
+    }
+    result.ok = true;
+    result.translation = std::move(*translation);
+    return result;
+  }
+
+ private:
+  const base::FilePath ort_dylib_;
+  const base::FilePath models_dir_;
+  std::unique_ptr<tark_captions::TranslationEngine> engine_;
+};
+
+// static
+void TarkCaptionTranslator::Create(
+    mojo::PendingReceiver<media::mojom::TarkCaptionTranslator> receiver,
+    const base::FilePath& ort_dylib,
+    const base::FilePath& models_dir) {
+  mojo::MakeSelfOwnedReceiver(std::make_unique<TarkCaptionTranslator>(ort_dylib, models_dir),
+                              std::move(receiver));
+}
+
+TarkCaptionTranslator::TarkCaptionTranslator(const base::FilePath& ort_dylib,
+                                             const base::FilePath& models_dir)
+    : worker_(base::ThreadPool::CreateSequencedTaskRunner(
+                  {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+              ort_dylib,
+              models_dir) {}
+
+TarkCaptionTranslator::~TarkCaptionTranslator() = default;
+
+void TarkCaptionTranslator::Render(const std::string& text,
+                                   const std::string& source,
+                                   const std::string& script,
+                                   const std::string& target,
+                                   RenderCallback callback) {
+  worker_.AsyncCall(&Worker::Render)
+      .WithArgs(text, source, script, target)
+      .Then(base::BindOnce(
+          [](RenderCallback callback, Result result) {
+            std::move(callback).Run(result.ok, result.shown, result.translation);
+          },
+          std::move(callback)));
+}
+
+}  // namespace speech
