+module media.mojom;
+
+// Tark (D4 Phase 2): shows a call's caption in the script the user reads
+// and translates it, in the speech recognition utility process. Bound by
+// the browser through SpeechRecognitionService.BindTarkCaptionTranslator.
+interface TarkCaptionTranslator {
+  // `text`: a caption in `source` ("hi", "ta", "bn"). `script`: "" (its own
+  // script), "latn" (English letters), or "hi"/"ta"/"bn" (that language's
+  // script). `target`: "" (no translation), "en", "hi", "ta", "bn".
+  // `ok` is false when a code is unknown or a model the request needs is
+  // missing; `shown` is still filled when only the translation failed.
+  Render(string text, string source, string script, string target)
+      => (bool ok, string shown, string translation);
+};
