+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/services/speech/tark_caption_translator.h"
+
+#include <string>
+
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "components/tark_captions/romanize.h"
+#include "components/tark_captions/test_util.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace speech {
+namespace {
+
+struct Rendered {
+  bool ok;
+  std::string shown;
+  std::string translation;
+};
+
+class TarkCaptionTranslatorTest : public testing::Test {
+ protected:
+  void Bind(const base::FilePath& ort, const base::FilePath& models) {
+    TarkCaptionTranslator::Create(translator_.BindNewPipeAndPassReceiver(), ort, models);
+  }
+  Rendered Render(const std::string& text,
+                  const std::string& source,
+                  const std::string& script,
+                  const std::string& target) {
+    base::test::TestFuture<bool, const std::string&, const std::string&> done;
+    translator_->Render(text, source, script, target, done.GetCallback());
+    return {done.Get<0>(), done.Get<1>(), done.Get<2>()};
+  }
+
+  base::test::TaskEnvironment env_;
+  mojo::Remote<media::mojom::TarkCaptionTranslator> translator_;
+};
+
+TEST_F(TarkCaptionTranslatorTest, ScriptOnlyNeedsNoModels) {
+  Bind(base::FilePath("/nonexistent/libonnxruntime.dylib"), base::FilePath("/nonexistent"));
+  Rendered latin = Render("தமிழ்", "ta", "latn", "");
+  EXPECT_TRUE(latin.ok);
+  EXPECT_EQ(latin.shown, "tamizh");
+  EXPECT_EQ(latin.translation, "");
+  Rendered bengali = Render("नमस्ते", "hi", "bn", "");
+  EXPECT_TRUE(bengali.ok);
+  EXPECT_EQ(bengali.shown, "নমস্তে");
+}
+
+TEST_F(TarkCaptionTranslatorTest, TranslatorRendersAndTranslates) {
+  std::optional<base::FilePath> ort = tark_captions::test::OrtPath();
+  std::optional<base::FilePath> models = tark_captions::test::ModelsDir();
+  std::optional<base::FilePath> testdata = tark_captions::test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort, *models);
+  const base::ListValue cases = tark_captions::test::MtGoldenCases(*testdata);
+  ASSERT_FALSE(cases.empty());
+  const base::DictValue& c = cases[0].GetDict();
+  ASSERT_EQ(*c.FindString("lang"), "hi");
+  Rendered r = Render(*c.FindString("caption"), "hi", "latn", "en");
+  EXPECT_TRUE(r.ok);
+  EXPECT_EQ(r.shown, base::UTF16ToUTF8(tark_captions::Romanize(
+                         base::UTF8ToUTF16(*c.FindString("caption")), tark_captions::Language::kHindi)));
+  EXPECT_EQ(r.translation, *c.FindString("english"));
+}
+
+TEST_F(TarkCaptionTranslatorTest, TranslatorReportsMissingModels) {
+  std::optional<base::FilePath> ort = tark_captions::test::OrtPath();
+  if (!ort) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT";
+  }
+  base::ScopedTempDir empty;
+  ASSERT_TRUE(empty.CreateUniqueTempDir());
+  Bind(*ort, empty.GetPath());
+  Rendered r = Render("नमस्ते", "hi", "", "en");
+  EXPECT_FALSE(r.ok);
+  EXPECT_EQ(r.shown, "नमस्ते");
+  EXPECT_EQ(r.translation, "");
+}
+
+TEST_F(TarkCaptionTranslatorTest, UnknownCodesAreRejected) {
+  Bind(base::FilePath("/nonexistent/libonnxruntime.dylib"), base::FilePath("/nonexistent"));
+  EXPECT_FALSE(Render("hello", "en", "", "").ok);
+  EXPECT_FALSE(Render("नमस्ते", "hi", "cyrl", "").ok);
+  EXPECT_FALSE(Render("नमस्ते", "hi", "", "fr").ok);
+}
+
+}  // namespace
+}  // namespace speech
