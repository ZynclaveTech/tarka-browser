+
+namespace speech {
+
+// Tark (D4 Phase 2): media::mojom::TarkCaptionTranslator in the speech
+// recognition utility process. Captions are text from call audio, so they
+// are changed (script, English letters) and translated here, in the
+// sandbox, not in the browser. The work runs on its own sequence; the
+// translation models load on the first request that needs them.
+class TarkCaptionTranslator : public media::mojom::TarkCaptionTranslator {
+ public:
+  // Binds a self-owned translator to `receiver`.
+  static void Create(mojo::PendingReceiver<media::mojom::TarkCaptionTranslator> receiver,
+                     const base::FilePath& ort_dylib,
+                     const base::FilePath& models_dir);
+
+  TarkCaptionTranslator(const base::FilePath& ort_dylib, const base::FilePath& models_dir);
+  TarkCaptionTranslator(const TarkCaptionTranslator&) = delete;
+  TarkCaptionTranslator& operator=(const TarkCaptionTranslator&) = delete;
+  ~TarkCaptionTranslator() override;
+
+  // media::mojom::TarkCaptionTranslator:
+  void Render(const std::string& text,
+              const std::string& source,
+              const std::string& script,
+              const std::string& target,
+              RenderCallback callback) override;
+
+ private:
+  class Worker;
+  base::SequenceBound<Worker> worker_;
+};
+
+}  // namespace speech
+
+#endif  // CHROME_SERVICES_SPEECH_TARK_CAPTION_TRANSLATOR_H_
