+#ifndef CHROME_SERVICES_SPEECH_TARK_CAPTION_TRANSLATOR_H_
+#define CHROME_SERVICES_SPEECH_TARK_CAPTION_TRANSLATOR_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/threading/sequence_bound.h"
