+// macOS 26 (D4 Phase 3).
+TEST(PillLanguageTest, AppleLanguagesListedOnMacOS26) {
+  EXPECT_EQ(ClientLanguageChoices(/*apple_available=*/false),
+            (std::vector<std::string>{"hi", "ta", "bn"}));
+  EXPECT_EQ(ClientLanguageChoices(true),
+            (std::vector<std::string>{"hi", "ta", "bn", "en", "es", "fr", "de", "it", "pt", "ja",
+                                      "ko", "zh", "yue"}));
+}
+
+TEST(PillLanguageTest, ShowInOffersOwnScriptOnlyForApple) {
+  ClientLanguage spanish(/*apple_available=*/true);
+  spanish.Detected("es");
+  EXPECT_EQ(ShowInChoices(spanish), std::vector<std::string>{""});
+  ClientLanguage tamil(true);
+  tamil.Detected("ta");
+  EXPECT_EQ(ShowInChoices(tamil), (std::vector<std::string>{"", "latn", "hi", "bn"}));
+}
+
+TEST(PillLanguageTest, TranslationLanguageMissingOffersSettings) {
+  ClientLanguage spanish(true);
+  spanish.Detected("es");
+  const PillLanguage pill = DescribeLanguage(spanish, /*translation_missing=*/true);
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kTranslationLanguageMissing);
+  EXPECT_EQ(pill.code, "es");
+  EXPECT_STREQ(kTranslationSettingsUrl,
+               "x-apple.systempreferences:com.apple.Localization-Settings.extension");
+}
+
+TEST(PillLanguageTest, AppleLanguageWithAppleSpeechHasNoNotice) {
+  ClientLanguage spanish(true);
+  spanish.Detected("es");
+  EXPECT_EQ(DescribeLanguage(spanish).notice, PillLanguage::Notice::kNone);
+}
