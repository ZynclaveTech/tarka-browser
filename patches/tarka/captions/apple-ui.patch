+void TarkCaptionPillController::ShowAppleDownload() {
+  if (!view_ || !shown_ || waiting_) {
+    return;
+  }
+  const CallCaptionsTabHelper::AppleDownload apple = shown_->apple_download();
+  if (!apple.active || !shown_->captions_on()) {
+    view_->SetDownload(std::nullopt);
+    return;
+  }
+  const std::u16string language = NameOf(shown_->client_language().code());
+  TarkCaptionPillView::Download download;
+  download.failed = apple.failed;
+  download.fraction = apple.fraction;
+  download.text =
+      apple.failed
+          ? l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_DOWNLOAD_FAILED, language)
+          : l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_GETTING_APPLE_READY, language,
+                                       base::NumberToString16(
+                                           static_cast<int>(apple.fraction * 100)));
+  view_->SetDownload(download);
+}
