+TEST(AsrModelTest, BlankFromEngineJson) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath json = dir.GetPath().AppendASCII("engine.json");
+  ASSERT_TRUE(base::WriteFile(
+      json, R"({"lang": "en", "blank": 1024, "valid_frames": "n/hop", "pad": "constant"})"));
+  std::optional<ModelConventions> conventions = ReadConventions(DirectorySource(dir.GetPath()));
+  ASSERT_TRUE(conventions);
+  EXPECT_EQ(conventions->blank, 1024);
+  EXPECT_EQ(conventions->frames, ModelConventions::Frames::kHop);
+  EXPECT_EQ(conventions->pad, ModelConventions::Pad::kZero);
+  // An engine.json the engine does not understand refuses the model rather
+  // than decoding it wrongly.
+  ASSERT_TRUE(base::WriteFile(json, R"({"blank": 1024, "pad": "wrap"})"));
+  EXPECT_FALSE(ReadConventions(DirectorySource(dir.GetPath())));
+}
+
+// Android's per-language models (one language each, FastConformer's
+// English and Spanish too) load with the languages they have.
+TEST(AsrModelTest, ReadsWhateverLanguagesTheModelHas) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("vocab.json"),
+                              R"({"en": ["a", "b", "<blank>"]})"));
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("language_masks.json"),
+                              R"({"en": [true, true, true]})"));
+  std::optional<std::map<std::string, AsrModel::Vocabulary>> vocabularies =
+      ReadVocabularies(DirectorySource(dir.GetPath()), /*blank=*/2);
+  ASSERT_TRUE(vocabularies);
+  ASSERT_EQ(vocabularies->size(), 1u);
+  EXPECT_EQ(vocabularies->at("en").tokens.size(), 3u);
+  EXPECT_EQ(vocabularies->at("en").logit_indices, (std::vector<int>{0, 1, 2}));
+  // A vocabulary that does not reach past the blank is refused.
+  EXPECT_FALSE(ReadVocabularies(DirectorySource(dir.GetPath()), /*blank=*/3));
+}
