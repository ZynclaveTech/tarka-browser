+  ASSERT_EQ(frames, *g.FindInt("frames"));
+  ASSERT_EQ(valid, *g.FindInt("valid"));
+  float worst = 0;
+  auto compare = [&](const base::ListValue& rows, int first_frame) {
+    for (int m = 0; m < MelFrontend::kMels; ++m) {
+      const base::ListValue& row = rows[m].GetList();
+      for (size_t i = 0; i < row.size(); ++i) {
