+TEST(ModelSourceTest, DirectoryReadsFilesAndMissingIsNullopt) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(dir.GetPath().AppendASCII("vocab.json"), "{\"hi\":[]}"));
+  DirectorySource source(dir.GetPath());
+  std::optional<base::span<const uint8_t>> bytes = source.Read("vocab.json");
+  ASSERT_TRUE(bytes);
+  EXPECT_EQ(AsString(*bytes), "{\"hi\":[]}");
+  EXPECT_EQ(source.PathOf("vocab.json"), dir.GetPath().AppendASCII("vocab.json"));
+  EXPECT_FALSE(source.Read("missing.onnx"));
+  EXPECT_FALSE(source.PathOf("missing.onnx"));
+}
+
+TEST(ModelSourceTest, MappedFilesReadTheirBytesAndHaveNoPaths) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("window.f32");
+  ASSERT_TRUE(base::WriteFile(path, "abcd"));
+  std::map<std::string, base::File> files;
+  files.emplace("window.f32", base::File(path, base::File::FLAG_OPEN | base::File::FLAG_READ));
+  MappedFilesSource source(std::move(files));
+  std::optional<base::span<const uint8_t>> bytes = source.Read("window.f32");
+  ASSERT_TRUE(bytes);
+  EXPECT_EQ(AsString(*bytes), "abcd");
+  EXPECT_FALSE(source.PathOf("window.f32"));
+  EXPECT_FALSE(source.Read("mel_fb.f32"));
+}
