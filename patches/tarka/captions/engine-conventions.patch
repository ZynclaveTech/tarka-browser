+#include "components/tark_captions/model_source.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/values.h"
+
+namespace tark_captions {
+
+ModelSource::~ModelSource() = default;
+
+std::optional<base::FilePath> ModelSource::PathOf(std::string_view name) const {
+  return std::nullopt;
+}
+
+std::optional<ModelConventions> ReadConventions(const ModelSource& source) {
+  ModelConventions conventions;
+  std::optional<base::span<const uint8_t>> bytes = source.Read("engine.json");
+  if (!bytes) {
+    return conventions;  // The Mac's 600M.
+  }
+  std::optional<base::Value> json = base::JSONReader::Read(
+      std::string_view(reinterpret_cast<const char*>(bytes->data()), bytes->size()),
+      base::JSON_PARSE_RFC);
+  if (!json || !json->is_dict()) {
+    return std::nullopt;
+  }
+  const base::DictValue& dict = json->GetDict();
+  if (const std::string* frames = dict.FindString("valid_frames")) {
+    if (*frames == "n/hop") {
+      conventions.frames = ModelConventions::Frames::kHop;
+    } else if (*frames != "n/hop+1") {
+      return std::nullopt;
+    }
+  }
+  if (const std::string* pad = dict.FindString("pad")) {
+    if (*pad == "constant") {
+      conventions.pad = ModelConventions::Pad::kZero;
+    } else if (*pad != "reflect") {
+      return std::nullopt;
+    }
+  }
+  if (const base::Value* blank = dict.Find("blank")) {
+    if (!blank->is_int() || blank->GetInt() < 0) {
+      return std::nullopt;
+    }
+    conventions.blank = blank->GetInt();
+  }
+  return conventions;
+}
+
+DirectorySource::DirectorySource(base::FilePath dir) : dir_(std::move(dir)) {}
+DirectorySource::~DirectorySource() = default;
+
+std::optional<base::span<const uint8_t>> DirectorySource::Read(std::string_view name) const {
+  auto it = cache_.find(name);
+  if (it == cache_.end()) {
+    std::optional<std::vector<uint8_t>> bytes = base::ReadFileToBytes(dir_.AppendASCII(name));
+    if (!bytes) {
+      return std::nullopt;
+    }
+    it = cache_.emplace(std::string(name), std::move(*bytes)).first;
+  }
+  return base::span<const uint8_t>(it->second);
+}
+
+std::optional<base::FilePath> DirectorySource::PathOf(std::string_view name) const {
+  const base::FilePath path = dir_.AppendASCII(name);
+  return base::PathExists(path) ? std::optional(path) : std::nullopt;
+}
+
+MappedFilesSource::MappedFilesSource(std::map<std::string, base::File> files) {
+  for (auto& [name, file] : files) {
+    files_.emplace(name, std::move(file));
+  }
+}
+MappedFilesSource::~MappedFilesSource() = default;
+
+std::optional<base::span<const uint8_t>> MappedFilesSource::Read(std::string_view name) const {
+  auto mapped = mapped_.find(name);
+  if (mapped == mapped_.end()) {
+    auto file = files_.find(name);
+    if (file == files_.end() || !file->second.IsValid()) {
+      return std::nullopt;
+    }
+    auto map = std::make_unique<base::MemoryMappedFile>();
+    if (!map->Initialize(std::move(file->second))) {
+      return std::nullopt;
+    }
+    files_.erase(file);
+    mapped = mapped_.emplace(std::string(name), std::move(map)).first;
+  }
+  return mapped->second->bytes();
+}
+
+}  // namespace tark_captions
