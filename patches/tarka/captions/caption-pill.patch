+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/caption_pill_view.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/vector_icons/vector_icons.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_id.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/styled_label.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+// The caption box's width over the call; in the strip (call tab hidden).
+constexpr int kCaptionWidth = 420;
+constexpr int kStripWidth = 320;
+constexpr SkColor kCaptionBackground = SkColorSetARGB(0xCC, 0x12, 0x12, 0x14);
+constexpr SkColor kCaptionText = SK_ColorWHITE;
+constexpr SkColor kDraftText = SkColorSetARGB(0x99, 0xFF, 0xFF, 0xFF);
+
+}  // namespace
+
+TarkCaptionPillView::TarkCaptionPillView(Delegate* delegate) : delegate_(delegate) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8))
+      ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  caption_box_ = AddChildView(std::make_unique<views::View>());
+  caption_box_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  caption_box_->SetBackground(views::CreateRoundedRectBackground(kCaptionBackground, 10));
+  caption_box_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 14)));
+  caption_ = caption_box_->AddChildView(std::make_unique<views::StyledLabel>());
+  caption_->SetDisplayedOnBackgroundColor(kCaptionBackground);
+  caption_->SizeToFit(kCaptionWidth);
+  caption_box_->SetVisible(false);
+
+  pill_ = AddChildView(std::make_unique<views::View>());
+  auto* row = pill_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets::TLBR(6, 10, 6, 8), 8));
+  row->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  pill_->SetBackground(views::CreateRoundedRectBackground(ui::kColorDialogBackground, 22));
+
+  pill_->AddChildView(std::make_unique<views::ImageView>(
+      ui::ImageModel::FromVectorIcon(vector_icons::kProductIcon, ui::kColorIcon, 16)));
+  captions_button_ = pill_->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&Delegate::OnCaptionsPressed, base::Unretained(delegate_.get())),
+      l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_CAPTIONS)));
+  language_button_ = pill_->AddChildView(std::make_unique<views::MdTextButton>(
+      views::Button::PressedCallback(),
+      l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HINDI)));
+  language_button_->SetCallback(base::BindRepeating(
+      [](TarkCaptionPillView* view) { view->delegate_->OnLanguagePressed(view->language_button_); },
+      base::Unretained(this)));
+  language_button_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_LANGUAGE));
+  auto* translate = pill_->AddChildView(std::make_unique<views::MdTextButton>(
+      views::Button::PressedCallback(), l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_TRANSLATE)));
+  translate->SetEnabled(false);
+  translate->SetTooltipText(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_TRANSLATE_SOON));
+  auto* hide = pill_->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&Delegate::OnHidePressed, base::Unretained(delegate_.get())),
+      vector_icons::kCloseIcon, 16));
+  hide->SetTooltipText(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HIDE));
+  hide->GetViewAccessibility().SetName(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HIDE));
+  SetCaptionsOn(false);
+}
+
+TarkCaptionPillView::~TarkCaptionPillView() = default;
+
+void TarkCaptionPillView::SetMode(Mode mode) {
+  pill_->SetVisible(mode == Mode::kPill);
+  caption_width_ = mode == Mode::kPill ? kCaptionWidth : kStripWidth;
+  caption_->SizeToFit(caption_width_);
+  PreferredSizeChanged();
+}
+
+void TarkCaptionPillView::SetCaptionsOn(bool on) {
+  captions_button_->SetStyle(on ? ui::ButtonStyle::kProminent : ui::ButtonStyle::kDefault);
+}
+
+void TarkCaptionPillView::SetLanguageName(const std::u16string& name) {
+  language_button_->SetText(name + u" ▾");
+}
+
+void TarkCaptionPillView::SetCaption(const tark_captions::CaptionText::Display& display,
+                                     const std::u16string& message) {
+  std::u16string text;
+  size_t draft_start = 0;
+  if (!message.empty()) {
+    text = message;
+    draft_start = text.size();
+  } else {
+    text = display.committed;
+    if (!display.draft.empty()) {
+      if (!text.empty()) {
+        text += u" ";
+      }
+      draft_start = text.size();
+      text += display.draft;
+    } else {
+      draft_start = text.size();
+    }
+  }
+  caption_box_->SetVisible(!text.empty());
+  caption_->SetText(text);
+  views::StyledLabel::RangeStyleInfo final_style;
+  final_style.override_color = kCaptionText;
+  views::StyledLabel::RangeStyleInfo draft_style;
+  draft_style.override_color = kDraftText;
+  if (draft_start > 0) {
+    caption_->AddStyleRange(gfx::Range(0, draft_start), final_style);
+  }
+  if (draft_start < text.size()) {
+    caption_->AddStyleRange(gfx::Range(draft_start, text.size()), draft_style);
+  }
+  caption_->SizeToFit(caption_width_);
+  PreferredSizeChanged();
+}
+
+bool TarkCaptionPillView::OnMousePressed(const ui::MouseEvent& event) {
+  drag_last_ = ScreenLocation(event);
+  return true;
+}
+
+bool TarkCaptionPillView::OnMouseDragged(const ui::MouseEvent& event) {
+  // In screen coordinates: the pill's own window moves with the drag, so
+  // positions within it would shift under the pointer and jitter.
+  const gfx::Point now = ScreenLocation(event);
+  delegate_->OnDragged(now - drag_last_);
+  drag_last_ = now;
+  return true;
+}
+
+gfx::Point TarkCaptionPillView::ScreenLocation(const ui::MouseEvent& event) const {
+  gfx::Point point = event.location();
+  views::View::ConvertPointToScreen(this, &point);
+  return point;
+}
+
+BEGIN_METADATA(TarkCaptionPillView)
+END_METADATA
