+
+ public:
+  class Delegate {
+   public:
+    virtual void OnCaptionsPressed() = 0;
+    virtual void OnLanguagePressed(views::View* anchor) = 0;
+    virtual void OnHidePressed() = 0;
+    virtual void OnDragged(const gfx::Vector2d& delta) = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  enum class Mode { kPill, kStrip };
+
+  explicit TarkCaptionPillView(Delegate* delegate);
+  TarkCaptionPillView(const TarkCaptionPillView&) = delete;
+  TarkCaptionPillView& operator=(const TarkCaptionPillView&) = delete;
+  ~TarkCaptionPillView() override;
+
+  void SetMode(Mode mode);
+  void SetCaptionsOn(bool on);
+  void SetLanguageName(const std::u16string& name);
+  // Shows `display` in the caption box, or `message` (Listening…, Captions
+  // unavailable) when it is not empty; hides the box when both are empty.
+  void SetCaption(const tark_captions::CaptionText::Display& display,
+                  const std::u16string& message);
+
+  // views::View:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+
+ private:
+  gfx::Point ScreenLocation(const ui::MouseEvent& event) const;
+
+  raw_ptr<Delegate> delegate_;
+  raw_ptr<views::View> caption_box_ = nullptr;
+  raw_ptr<views::StyledLabel> caption_ = nullptr;
+  raw_ptr<views::View> pill_ = nullptr;
+  raw_ptr<views::MdTextButton> captions_button_ = nullptr;
+  raw_ptr<views::MdTextButton> language_button_ = nullptr;
+  int caption_width_ = 420;
+  gfx::Point drag_last_;
+};
