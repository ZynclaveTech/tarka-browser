+// Tark (D4): shows the call captions pill for one browser window. The pill
+// floats over the call's tab while it is in front (captions off until the
+// user presses Captions); when another tab is in front and the call's
+// captions are on, only the caption box shows (the strip). Captions and the
+// pill go when the call ends or the user hides them for the call. The
+// pill's window is left out of screen shares and screenshots.
+class TarkCaptionPillController : public TabStripModelObserver,
+                                  public CallCaptionsTabHelper::Observer,
+                                  public TarkCaptionPillView::Delegate,
+                                  public ui::SimpleMenuModel::Delegate,
+                                  public views::WidgetObserver,
+                                  public views::ViewObserver {
+ public:
+  explicit TarkCaptionPillController(BrowserView* browser_view);
+  TarkCaptionPillController(const TarkCaptionPillController&) = delete;
+  TarkCaptionPillController& operator=(const TarkCaptionPillController&) = delete;
+  ~TarkCaptionPillController() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* tab_strip_model,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+
+  // CallCaptionsTabHelper::Observer:
+  void OnCallStateChanged(CallCaptionsTabHelper* tab) override;
+  void OnCaption(CallCaptionsTabHelper* tab, bool is_final, const std::string& text) override;
+  void OnCaptionsUnavailable(CallCaptionsTabHelper* tab) override;
+
+  // TarkCaptionPillView::Delegate:
+  void OnCaptionsPressed() override;
+  void OnLanguagePressed(views::View* anchor) override;
+  void OnHidePressed() override;
+  void OnDragged(const gfx::Vector2d& delta) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int command_id) const override;
+  void ExecuteCommand(int command_id, int event_flags) override;
+
+  // views::WidgetObserver:
+  void OnWidgetBoundsChanged(views::Widget* widget, const gfx::Rect& new_bounds) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewPreferredSizeChanged(views::View* observed_view) override;
+
+ private:
+  void Observe(content::WebContents* contents);
+  void Unobserve(content::WebContents* contents);
+  // Picks the tab the pill is for and shows, updates or closes the pill.
+  void Update();
+  void ShowCaption();
+  void Close();
+  void Reposition();
+
+  raw_ptr<BrowserView> browser_view_;
+  // The tab the pill or strip is showing; null when it is closed.
+  raw_ptr<CallCaptionsTabHelper> shown_ = nullptr;
+  TarkCaptionPillView::Mode mode_ = TarkCaptionPillView::Mode::kPill;
+  tark_captions::CaptionText text_;
+  std::u16string message_;
+  // Where the user dragged the pill, from its resting place.
+  gfx::Vector2d offset_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<TarkCaptionPillView> view_ = nullptr;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  base::ScopedMultiSourceObservation<CallCaptionsTabHelper, CallCaptionsTabHelper::Observer>
+      tabs_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver> browser_widget_observation_{this};
+  base::ScopedObservation<views::Widget, views::WidgetObserver> pill_widget_observation_{this};
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver> view_observation_{this};
+};
