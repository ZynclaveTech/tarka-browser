+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/caption_pill_controller.h"
+
+#include <utility>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tark_captions/asr_model.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/mojom/menu_source_type.mojom.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The pill rests this far above the bottom of the page, centred; the strip
+// sits at the bottom.
+constexpr int kBottomGap = 72;
+constexpr int kStripGap = 12;
+// About two lines of the 420 px caption box.
+constexpr size_t kCaptionChars = 110;
+
+constexpr tark_captions::Language kLanguages[] = {
+    tark_captions::Language::kHindi,
+    tark_captions::Language::kTamil,
+    tark_captions::Language::kBengali,
+};
+
+std::u16string LanguageName(tark_captions::Language language) {
+  switch (language) {
+    case tark_captions::Language::kHindi:
+      return l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HINDI);
+    case tark_captions::Language::kTamil:
+      return l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_TAMIL);
+    case tark_captions::Language::kBengali:
+      return l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_BENGALI);
+  }
+}
+
+CallCaptionsTabHelper* HelperFor(content::WebContents* contents) {
+  return contents ? CallCaptionsTabHelper::FromWebContents(contents) : nullptr;
+}
+
+}  // namespace
+
+TarkCaptionPillController::TarkCaptionPillController(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  model->AddObserver(this);
+  for (int i = 0; i < model->count(); ++i) {
+    Observe(model->GetWebContentsAt(i));
+  }
+  browser_widget_observation_.Observe(browser_view_->GetWidget());
+  view_observation_.AddObservation(browser_view_->GetActiveContentsWebView());
+  Update();
+}
+
+TarkCaptionPillController::~TarkCaptionPillController() {
+  menu_runner_.reset();
+  view_observation_.RemoveAllObservations();
+  pill_widget_observation_.Reset();
+  view_ = nullptr;
+  widget_.reset();
+}
+
+void TarkCaptionPillController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const auto& tab : change.GetInsert()->contents) {
+        Observe(tab.contents);
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const auto& tab : change.GetRemove()->contents) {
+        Unobserve(tab.contents);
+      }
+      break;
+    case TabStripModelChange::kReplaced:
+      Unobserve(change.GetReplace()->old_contents);
+      Observe(change.GetReplace()->new_contents);
+      break;
+    case TabStripModelChange::kMoved:
+    case TabStripModelChange::kSelectionOnly:
+      break;
+  }
+  Update();
+}
+
+void TarkCaptionPillController::OnCallStateChanged(CallCaptionsTabHelper* tab) {
+  Update();
+}
+
+void TarkCaptionPillController::OnCaption(CallCaptionsTabHelper* tab,
+                                          bool is_final,
+                                          const std::string& text) {
+  if (tab != shown_) {
+    return;
+  }
+  if (is_final) {
+    text_.AddFinal(text);
+  } else {
+    text_.SetDraft(text);
+  }
+  message_.clear();
+  ShowCaption();
+}
+
+void TarkCaptionPillController::OnCaptionsUnavailable(CallCaptionsTabHelper* tab) {
+  if (tab != shown_) {
+    return;
+  }
+  message_ = l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_UNAVAILABLE);
+  ShowCaption();
+}
+
+void TarkCaptionPillController::OnCaptionsPressed() {
+  if (shown_) {
+    shown_->SetCaptionsOn(!shown_->captions_on());
+  }
+}
+
+void TarkCaptionPillController::OnLanguagePressed(views::View* anchor) {
+  if (!shown_) {
+    return;
+  }
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  for (tark_captions::Language language : kLanguages) {
+    menu_model_->AddRadioItem(static_cast<int>(language), LanguageName(language),
+                              /*group_id=*/0);
+  }
+  menu_runner_ = std::make_unique<views::MenuRunner>(menu_model_.get(),
+                                                     views::MenuRunner::NO_FLAGS);
+  menu_runner_->RunMenuAt(anchor->GetWidget(), nullptr, anchor->GetAnchorBoundsInScreen(),
+                          views::MenuAnchorPosition::kBubbleTopLeft,
+                          ui::mojom::MenuSourceType::kMouse);
+}
+
+void TarkCaptionPillController::OnHidePressed() {
+  if (shown_) {
+    shown_->HideForThisCall();
+  }
+}
+
+void TarkCaptionPillController::OnDragged(const gfx::Vector2d& delta) {
+  offset_ += delta;
+  Reposition();
+}
+
+bool TarkCaptionPillController::IsCommandIdChecked(int command_id) const {
+  return shown_ && static_cast<int>(shown_->language()) == command_id;
+}
+
+void TarkCaptionPillController::ExecuteCommand(int command_id, int event_flags) {
+  for (tark_captions::Language language : kLanguages) {
+    if (shown_ && static_cast<int>(language) == command_id) {
+      shown_->SetLanguage(language);
+    }
+  }
+}
+
+void TarkCaptionPillController::OnWidgetBoundsChanged(views::Widget* widget,
+                                                      const gfx::Rect& new_bounds) {
+  Reposition();
+}
+
+void TarkCaptionPillController::OnWidgetDestroying(views::Widget* widget) {
+  if (widget_ && widget == widget_.get()) {
+    // The pill's window went with the browser window's.
+    menu_runner_.reset();
+    if (view_ && view_observation_.IsObservingSource(view_.get())) {
+      view_observation_.RemoveObservation(view_.get());
+    }
+    pill_widget_observation_.Reset();
+    view_ = nullptr;
+    return;
+  }
+  // The browser window is closing: stop following it.
+  Close();
+  browser_widget_observation_.Reset();
+  view_observation_.RemoveAllObservations();
+}
+
+void TarkCaptionPillController::OnViewBoundsChanged(views::View* observed_view) {
+  Reposition();
+}
+
+void TarkCaptionPillController::OnViewPreferredSizeChanged(views::View* observed_view) {
+  Reposition();
+}
+
+void TarkCaptionPillController::Observe(content::WebContents* contents) {
+  CallCaptionsTabHelper* helper = HelperFor(contents);
+  if (helper && !tabs_observation_.IsObservingSource(helper)) {
+    tabs_observation_.AddObservation(helper);
+  }
+}
+
+void TarkCaptionPillController::Unobserve(content::WebContents* contents) {
+  CallCaptionsTabHelper* helper = HelperFor(contents);
+  if (!helper) {
+    return;
+  }
+  if (tabs_observation_.IsObservingSource(helper)) {
+    tabs_observation_.RemoveObservation(helper);
+  }
+  if (helper == shown_) {
+    shown_ = nullptr;
+  }
+}
+
+void TarkCaptionPillController::Update() {
+  TabStripModel* model = browser_view_->browser()->GetTabStripModel();
+  CallCaptionsTabHelper* target = nullptr;
+  TarkCaptionPillView::Mode mode = TarkCaptionPillView::Mode::kPill;
+  CallCaptionsTabHelper* active = HelperFor(model->GetActiveWebContents());
+  if (active && active->in_call() && !active->hidden()) {
+    target = active;
+  } else {
+    // The call is in another tab: its captions (if on) show as the strip.
+    for (int i = 0; i < model->count() && !target; ++i) {
+      CallCaptionsTabHelper* helper = HelperFor(model->GetWebContentsAt(i));
+      if (helper && helper->in_call() && !helper->hidden() && helper->captions_on()) {
+        target = helper;
+        mode = TarkCaptionPillView::Mode::kStrip;
+      }
+    }
+  }
+  if (!target || !browser_view_->GetWidget()) {
+    Close();
+    return;
+  }
+  if (target != shown_ || !target->captions_on()) {
+    text_.Clear();
+    message_.clear();
+  }
+  shown_ = target;
+
+  if (!widget_) {
+    views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                     views::Widget::InitParams::TYPE_POPUP);
+    params.parent = browser_view_->GetWidget()->GetNativeView();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.name = "TarkCaptionPill";
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+    view_ = widget_->SetContentsView(std::make_unique<TarkCaptionPillView>(this));
+    // Captions are private to whoever reads them: keep them out of screen
+    // shares and screenshots.
+    widget_->SetAllowScreenshots(false);
+    pill_widget_observation_.Observe(widget_.get());
+    view_observation_.AddObservation(view_.get());
+  }
+  if (!view_) {
+    return;
+  }
+  mode_ = mode;
+  view_->SetMode(mode);
+  view_->SetCaptionsOn(target->captions_on());
+  view_->SetLanguageName(LanguageName(target->language()));
+  ShowCaption();
+  Reposition();
+  if (!widget_->IsVisible()) {
+    widget_->ShowInactive();
+  }
+}
+
+void TarkCaptionPillController::ShowCaption() {
+  if (!view_ || !shown_) {
+    return;
+  }
+  if (!shown_->captions_on()) {
+    view_->SetCaption({}, std::u16string());
+    return;
+  }
+  const tark_captions::CaptionText::Display display = text_.GetDisplay(kCaptionChars);
+  std::u16string message = message_;
+  if (message.empty() && display.committed.empty() && display.draft.empty()) {
+    message = l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_LISTENING);
+  }
+  view_->SetCaption(display, message);
+}
+
+void TarkCaptionPillController::Close() {
+  // Hidden, not destroyed: this can run inside one of the pill's own button
+  // presses. The window goes with the controller.
+  menu_runner_.reset();
+  shown_ = nullptr;
+  text_.Clear();
+  message_.clear();
+  if (widget_ && view_) {
+    widget_->Hide();
+  }
+}
+
+void TarkCaptionPillController::Reposition() {
+  if (!widget_ || !view_ || !browser_view_->GetWidget()) {
+    return;
+  }
+  const gfx::Rect area = browser_view_->GetActiveContentsWebView()->GetBoundsInScreen();
+  gfx::Size size = view_->GetPreferredSize();
+  size.SetToMin(area.size());
+  const bool strip = mode_ == TarkCaptionPillView::Mode::kStrip;
+  const gfx::Point rest(area.x() + (area.width() - size.width()) / 2,
+                        area.bottom() - (strip ? kStripGap : kBottomGap) - size.height());
+  // Only the pill moves where the user dragged it.
+  gfx::Rect bounds(strip ? rest : rest + offset_, size);
+  bounds.AdjustToFit(area);
+  if (!strip) {
+    // Dragging past an edge does not build up: the offset stays where the
+    // pill could go.
+    offset_ = bounds.origin() - rest;
+  }
+  widget_->SetBounds(bounds);
+}
