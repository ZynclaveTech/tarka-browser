+#ifndef COMPONENTS_TARK_CAPTIONS_FLAT_VOCAB_H_
+#define COMPONENTS_TARK_CAPTIONS_FLAT_VOCAB_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_util.h"
+
