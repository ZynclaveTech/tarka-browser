+// Models that can't load fail every non-blank text before any thread starts.
+TEST_F(TranslationEngineTest, ParallelPagesMissingModelFails) {
+  base::ScopedTempDir empty;
+  ASSERT_TRUE(empty.CreateUniqueTempDir());
+  std::unique_ptr<TranslationEngine> engine = TranslationEngine::Create(empty.GetPath(), ort_);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(engine->TranslatePages({"एक", " ", "दो"}, "hi", "en", 4),
+            (std::vector<std::optional<std::string>>{std::nullopt, "", std::nullopt}));
+}
+
+// The thread count is a load parameter; translations don't depend on it.
+TEST_F(TranslationEngineTest, ThreadsDoNotChangeTranslations) {
+  std::unique_ptr<TranslationEngine> four = TranslationEngine::Create(models_, ort_, 4);
+  ASSERT_TRUE(four);
+  for (const base::Value& v : cases_) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(four->TranslatePages({*c.FindString("caption")}, *c.FindString("lang"), "en"),
+              (std::vector<std::optional<std::string>>{
+                  engine_->TranslatePage(*c.FindString("caption"), *c.FindString("lang"), "en")}))
+        << *c.FindString("id");
+  }
+}
