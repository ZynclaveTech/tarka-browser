+// eight, U+FDDB..U+FDEB): base::JSONReader takes them, so this does too.
+inline std::optional<std::vector<std::pair<std::string, int>>> ParseFlatVocab(
+    std::string_view json,
+    const char** why = nullptr,
+    size_t* at = nullptr) {
+  size_t i = 0;
