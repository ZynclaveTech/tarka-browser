+// A page's sentences on four threads sharing one engine (one intra-op
+// thread each) come back exactly as one at a time gives them, in order; a
+// sentence cut off at kMaxOutputTokens is nullopt without failing the rest.
+TEST_F(TranslationEngineTest, ParallelPagesMatchOneAtATime) {
+  std::string cut_off;
+  for (int i = 0; i < 60; ++i) {
+    cut_off += "नमस्ते दुनिया ";
+  }
+  std::vector<std::string> texts = {"", cut_off};
+  for (const base::Value& v : cases_) {
+    if (*v.GetDict().FindString("lang") == "hi") {
+      texts.push_back(*v.GetDict().FindString("caption"));
+    }
+  }
+  ASSERT_GE(texts.size(), 4u);
+  std::unique_ptr<TranslationEngine> one_thread = TranslationEngine::Create(models_, ort_, 1);
+  ASSERT_TRUE(one_thread);
+  for (const char* target : {"en", "ta", "gu"}) {
+    std::vector<std::optional<std::string>> one;
+    for (const std::string& text : texts) {
+      one.push_back(engine_->TranslatePage(text, "hi", target));
+    }
+    ASSERT_EQ(one[0], std::string()) << target;
+    ASSERT_EQ(one[1], std::nullopt) << target;  // the cut-off one
+    const std::vector<std::optional<std::string>> parallel =
+        one_thread->TranslatePages(texts, "hi", target, /*parallel=*/4);
+    ASSERT_EQ(parallel.size(), one.size());
+    for (size_t i = 0; i < one.size(); ++i) {
+      EXPECT_EQ(parallel[i], one[i]) << target << " row " << i;
+    }
+  }
+}
