+std::vector<std::optional<std::string>> TranslationEngine::TranslatePages(
+    const std::vector<std::string>& texts,
+    std::string_view source_code,
+    std::string_view target_code,
+    int parallel) {
+  std::vector<std::optional<std::string>> results(texts.size());
+  if (parallel <= 1 || texts.size() <= 1) {
+    for (size_t i = 0; i < texts.size(); ++i) {
+      results[i] = TranslatePage(texts[i], source_code, target_code);
+    }
+    return results;
+  }
+  // Every model the pair needs loads here, first: the workers only read
+  // loaded_. A model that doesn't load fails every text, as TranslatePage
+  // would (blank ones stay "").
+  for (TranslationDirection direction : PageDirectionsFor(source_code, target_code)) {
+    if (!Get(direction)) {
+      for (size_t i = 0; i < texts.size(); ++i) {
+        if (base::TrimWhitespaceASCII(texts[i], base::TRIM_ALL).empty()) {
+          results[i] = std::string();
+        }
+      }
+      return results;
+    }
+  }
+  // Workers take the next text until none is left, each running
+  // TranslatePage on the shared sessions (ONNX Runtime's Run is thread-safe).
+  class Worker : public base::DelegateSimpleThread::Delegate {
+   public:
+    Worker(TranslationEngine* engine,
+           const std::vector<std::string>& texts,
+           std::string_view source,
+           std::string_view target,
+           std::vector<std::optional<std::string>>& results,
+           std::atomic<size_t>& next)
+        : engine_(engine),
+          texts_(texts),
+          source_(source),
+          target_(target),
+          results_(results),
+          next_(next) {}
+    void Run() override {
+      for (size_t i = (*next_)++; i < texts_->size(); i = (*next_)++) {
+        (*results_)[i] = engine_->TranslatePage((*texts_)[i], source_, target_);
+      }
+    }
+
+   private:
+    raw_ptr<TranslationEngine> engine_;
+    raw_ref<const std::vector<std::string>> texts_;
+    std::string_view source_;
+    std::string_view target_;
+    raw_ref<std::vector<std::optional<std::string>>> results_;
+    raw_ref<std::atomic<size_t>> next_;
+  };
+  std::atomic<size_t> next = 0;
+  Worker worker(this, texts, source_code, target_code, results, next);
+  const size_t threads = std::min(static_cast<size_t>(parallel), texts.size()) - 1;
+  std::vector<std::unique_ptr<base::DelegateSimpleThread>> helpers;
+  for (size_t t = 0; t < threads; ++t) {
+    helpers.push_back(std::make_unique<base::DelegateSimpleThread>(&worker, "TarkPageTranslate"));
+    helpers.back()->Start();
+  }
+  worker.Run();  // this thread is one of them
+  for (const std::unique_ptr<base::DelegateSimpleThread>& helper : helpers) {
+    helper->Join();
+  }
+  return results;
+}
