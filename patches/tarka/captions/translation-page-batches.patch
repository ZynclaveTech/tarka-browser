+          break;
+        case 'n':
+          s->push_back('\n');
+          break;
+        case 'r':
+          s->push_back('\r');
+          break;
+        case 't':
+          s->push_back('\t');
+          break;
+        case 'u': {
+          uint32_t cp = 0;
+          if (!hex4(&cp)) {
+            return false;
+          }
+          if (cp >= 0xD800 && cp <= 0xDBFF) {  // a high surrogate: its low half follows
+            uint32_t low = 0;
+            if (n - i < 2 || json[i] != '\\' || json[i + 1] != 'u') {
+              return false;
+            }
+            i += 2;
+            if (!hex4(&low) || low < 0xDC00 || low > 0xDFFF) {
+              return false;
+            }
+            cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
+          } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
+            return false;  // a lone low surrogate
+          }
+          append_utf8(cp, s);
+          break;
+        }
+        default:
+          return false;
+      }
+    }
+    return false;  // no closing quote
+  };
+  auto read_int = [&](int* out) {
+    bool negative = false;
+    if (i < n && json[i] == '-') {
+      negative = true;
+      ++i;
+    }
+    if (i >= n || json[i] < '0' || json[i] > '9') {
+      return false;
+    }
+    if (json[i] == '0' && i + 1 < n && json[i + 1] >= '0' && json[i + 1] <= '9') {
+      return false;  // a leading zero is not JSON
+    }
+    int64_t v = 0;
+    while (i < n && json[i] >= '0' && json[i] <= '9') {
+      v = v * 10 + (json[i] - '0');
+      if (v > int64_t{2147483648}) {
+        return false;
+      }
+      ++i;
+    }
+    if (i < n && (json[i] == '.' || json[i] == 'e' || json[i] == 'E')) {
+      return false;  // a double: base::JSONReader's int check decides
+    }
+    v = negative ? -v : v;
+    if (v > int64_t{2147483647} || v < -int64_t{2147483648}) {
+      return false;
+    }
+    *out = static_cast<int>(v);
+    return true;
+  };
+
+  std::vector<std::pair<std::string, int>> entries;
+  skip_space();
+  if (i >= n || json[i] != '{') {
+    return decline("not an object");
+  }
+  ++i;
+  skip_space();
+  if (i < n && json[i] == '}') {
+    ++i;
+  } else {
+    std::string key;
+    for (;;) {
+      skip_space();
+      if (!read_string(&key)) {
+        return decline("key");
+      }
+      skip_space();
+      if (i >= n || json[i] != ':') {
+        return decline("no colon");
+      }
+      ++i;
+      skip_space();
+      int value = 0;
+      if (!read_int(&value)) {
+        return decline("value not an int32");
+      }
+      if (!base::IsStringUTF8AllowingNoncharacters(key)) {
+        return decline("key not UTF-8");
+      }
+      entries.emplace_back(std::move(key), value);
+      skip_space();
+      if (i < n && json[i] == ',') {
+        ++i;
+        continue;
+      }
+      if (i < n && json[i] == '}') {
+        ++i;
+        break;
+      }
+      return decline("no comma or brace");
+    }
+  }
+  skip_space();
+  if (i != n) {
+    return decline("text after the object");
+  }
+  return entries;
+}
