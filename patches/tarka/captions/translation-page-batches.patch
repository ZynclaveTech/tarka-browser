+// ParseFlatVocab gives what base::JSONReader gives for a flat {"token": id}
+// file, escapes and all (dict.*.json write Devanagari raw, but a file may
+// escape it).
+TEST(FlatVocabTest, MatchesJsonReader) {
+  const std::string json =
+      "{\n  \"<s>\": 0,\n  \"a\\\"b\": 1, \"\\\\\": 2, \"\\u0905\\u093e\": 3,\n"
+      "  \"\\ud83d\\ude00\": 4, \"tab\\there\": 5, \"\\/x\": -6,\n"
+      "  \"\xE2\x96\x81\xE0\xA5\xA4\": 7, \"z\": 2147483647, \"y\": -2147483648 }\n";
+  std::optional<std::vector<std::pair<std::string, int>>> fast = ParseFlatVocab(json);
+  ASSERT_TRUE(fast);
+  std::optional<base::Value> slow = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(slow && slow->is_dict());
+  ASSERT_EQ(fast->size(), slow->GetDict().size());
+  for (const auto& [key, id] : *fast) {
+    EXPECT_EQ(slow->GetDict().FindInt(key), id) << key;
+  }
+  EXPECT_EQ((*fast)[2].first, "\\");
+  EXPECT_EQ((*fast)[3].first, "\xE0\xA4\x85\xE0\xA4\xBE");      // अा
+  EXPECT_EQ((*fast)[4].first, "\xF0\x9F\x98\x80");              // a surrogate pair
+  EXPECT_EQ((*fast)[0].first, "<s>");                           // file order
+}
+
+// it2_indic_en's dict.SRC.json has keys with Unicode noncharacters
+// (U+FDDB..U+FDEB). base::JSONReader takes them, and so must the fast path: with
+// base::IsStringUTF8 it declined that file on the phone (round 12) and fell
+// back to the 18 s path.
+TEST(FlatVocabTest, NoncharacterKeysTaken) {
+  const std::string json = "{\"\xEF\xB7\x9C\": 5, \"\\ufdeb\": 6}";
+  const char* why = "";
+  std::optional<std::vector<std::pair<std::string, int>>> fast = ParseFlatVocab(json, &why);
+  ASSERT_TRUE(fast) << why;
+  std::optional<base::Value> slow = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(slow && slow->is_dict());
+  ASSERT_EQ(fast->size(), slow->GetDict().size());
+  for (const auto& [key, id] : *fast) {
+    EXPECT_EQ(slow->GetDict().FindInt(key), id);
+  }
+}
+
+// Anything that is not a flat object of int32s goes back to base::JSONReader.
+TEST(FlatVocabTest, DeclinesWhatItDoesNotHandle) {
+  for (const char* json :
+       {"{\"a\": 1.0}", "{\"a\": 1e2}", "{\"a\": 01}", "{\"a\": \"1\"}", "{\"a\": [1]}",
+        "{\"a\": 2147483648}", "{\"\\ud800\": 1}", "{\"\\udc00\": 1}", "{\"\\x41\": 1}",
+        "{\"a\": 1,}", "{\"a\": 1} x", "[1]", "", "{\"\xFF\": 1}", "{\"a\nb\": 1}"}) {
+    EXPECT_FALSE(ParseFlatVocab(json)) << json;
+  }
+  EXPECT_EQ(ParseFlatVocab(" {} "), (std::vector<std::pair<std::string, int>>{}));
+}
+
+// The size of IndicTrans2's dict.SRC.json, keys in id order (not key order),
+// as on the phone, where base::JSONReader took 18.7 s: well under a second.
+TEST(FlatVocabTest, LargeVocabularyIsFast) {
+  std::string json = "{";
+  for (int id = 0; id < 122706; ++id) {
+    json += (id ? ",\n  \"" : "\n  \"");
+    json += "\xE2\x96\x81\xE0\xA4\x95";  // ▁क
+    json += std::to_string((id * 7919) % 122706);
+    json += "\": " + std::to_string(id);
+  }
+  json += "\n}\n";
+  const base::TimeTicks start = base::TimeTicks::Now();
+  std::optional<std::vector<std::pair<std::string, int>>> entries = ParseFlatVocab(json);
+  const base::TimeDelta took = base::TimeTicks::Now() - start;
+  ASSERT_TRUE(entries);
+  EXPECT_EQ(entries->size(), 122706u);
+  EXPECT_LT(took, base::Seconds(1));
+}
