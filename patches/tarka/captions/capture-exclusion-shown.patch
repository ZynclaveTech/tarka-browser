+// Tark: macOS drops a capture-exclusion shape given to a window that isn't on
+// screen yet, so a window excluded while hidden showed in screen captures
+// until it was next resized. The exclusion is given again when it shows.
+TEST_F(NativeWidgetMacTest, ScreenshotProtectionReappliedWhenShown) {
+  NativeWidgetMacTestWindow* window;
+  Widget::InitParams params =
+      CreateParams(Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.bounds = gfx::Rect(100, 100, 200, 150);
+  Widget* widget = CreateWidgetWithTestWindow(std::move(params), &window);
+
+  std::vector<bool> calls;
+  BridgedNativeWidgetTestApi(widget).SetCaptureExclusionApplier(
+      base::BindRepeating(
+          [](std::vector<bool>* calls, NSWindow* window, bool allow) {
+            calls->push_back(allow);
+          },
+          &calls));
+
+  widget->SetAllowScreenshots(false);
+  ASSERT_EQ(1u, calls.size());
+
+  WidgetChangeObserver observer(widget);
+  widget->ShowInactive();
+  observer.WaitForVisibleCounts(1, 0);
+  // Given again on show (and on the first frame, if it has come by now).
+  ASSERT_GE(calls.size(), 2u);
+  EXPECT_FALSE(calls.back());
+
+  // A window that allows captures is left alone when it shows.
+  widget->Hide();
+  observer.WaitForVisibleCounts(1, 1);
+  widget->SetAllowScreenshots(true);
+  const size_t before = calls.size();
+  widget->ShowInactive();
+  observer.WaitForVisibleCounts(2, 1);
+  EXPECT_EQ(before, calls.size());
+
+  widget->CloseNow();
+}
