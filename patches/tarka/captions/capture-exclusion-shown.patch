+
+void NativeWidgetNSWindowBridge::ReapplyCaptureExclusionSoon() {
+  if (allow_screenshots_) {
+    return;
+  }
+  SetAllowScreenshots(false);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&NativeWidgetNSWindowBridge::ReapplyCaptureExclusion,
+                     factory_.GetWeakPtr()),
+      base::Milliseconds(100));
+}
