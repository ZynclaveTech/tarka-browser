+std::string CallCaptionsTabHelper::CaptionLanguageCode() const {
+  // macOS's captions are in the language detected, picked or guessed; Tark's
+  // own in the one its engine decodes.
+  using State = tark_captions::ClientLanguage::State;
+  if (client_language_.state() == State::kApple) {
+    return client_language_.code();
+  }
+  if (client_language_.state() == State::kDetecting &&
+      tark_captions::KindOfLanguage(client_language_.guess()) ==
+          tark_captions::Detection::Kind::kApple) {
+    return client_language_.guess();
+  }
+  return std::string(tark_captions::LanguageCode(language_));
+}
