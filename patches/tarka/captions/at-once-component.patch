+std::optional<std::string> GuessLanguage(base::span<const float> logits,
+                                         base::span<const std::string> labels) {
+  const std::map<std::string, double> p = Probabilities(logits, labels);
+  if (p.empty()) {
+    return std::nullopt;
+  }
+  auto top = std::max_element(p.begin(), p.end(),
+                              [](const auto& a, const auto& b) { return a.second < b.second; });
+  const Detection::Kind kind = KindOfLanguage(top->first);
+  if (top->second < kGuessProbability ||
+      (kind != Detection::Kind::kCaption && kind != Detection::Kind::kApple)) {
+    return std::nullopt;
+  }
+  return top->first;
+}
