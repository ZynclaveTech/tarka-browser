+// Captions at once: the guess that starts captions before the lock.
+std::optional<std::string> Guess(const std::map<std::string, double>& named) {
+  return GuessLanguage(Scores(named), kLabels);
+}
+
+TEST(GuessLanguageTest, TakesTopTarkLanguage) {
+  EXPECT_EQ(Guess({{"hi", 0.6}, {"ta", 0.3}}), "hi");
+}
+
+TEST(GuessLanguageTest, CountsUrduAsHindi) {
+  EXPECT_EQ(Guess({{"ur", 0.3}, {"hi", 0.25}, {"en", 0.45}}), "hi");
+}
+
+TEST(GuessLanguageTest, NeedsHalf) {
+  EXPECT_EQ(Guess({{"hi", 0.45}, {"ta", 0.4}}), std::nullopt);
+}
+
+TEST(GuessLanguageTest, TakesAppleLanguage) {
+  EXPECT_EQ(Guess({{"en", 0.8}}), "en");
+}
+
+TEST(GuessLanguageTest, SkipsWhatNothingCaptions) {
+  EXPECT_EQ(Guess({{"sw", 0.9}}), std::nullopt);
+  EXPECT_EQ(Guess({{"te", 0.7}}), std::nullopt);  // Planned, not captioned yet.
+}
+
+TEST(GuessLanguageTest, ScoresAndLabelsMustMatch) {
