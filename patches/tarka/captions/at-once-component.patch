+TEST(ScriptHintTest, TamilTitleIsTamil) {
+  EXPECT_EQ(ScriptHint(u"பட்ஜெட் விளக்கம்"), "ta");
+}
+
+TEST(ScriptHintTest, BengaliTitleIsBengali) {
+  EXPECT_EQ(ScriptHint(u"বাজেট ব্যাখ্যা"), "bn");
+}
+
+TEST(ScriptHintTest, LatinTitleHasNoHint) {
+  EXPECT_EQ(ScriptHint(u"Union Budget explained - YouTube"), std::nullopt);
+}
+
+TEST(ScriptHintTest, MostLettersWin) {
+  EXPECT_EQ(ScriptHint(u"বাজেট বাজেট बजट"), "bn");
+}
+
+TEST(ScriptHintTest, TwoLettersAreNotAHint) {
+  EXPECT_EQ(ScriptHint(u"हि - YouTube"), std::nullopt);
+}
+
+TEST(ScriptHintTest, EmptyTitleHasNoHint) {
+  EXPECT_EQ(ScriptHint(u""), std::nullopt);
+}
