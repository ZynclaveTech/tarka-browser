+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/language_hint.h"
+
+#include <iterator>
+
+namespace tark_captions {
+namespace {
+
+struct Script {
+  char16_t first;
+  char16_t last;
+  const char* code;
+};
+
+// Unicode blocks; vowel signs and other marks inside a block count too.
+constexpr Script kScripts[] = {
+    {0x0900, 0x097F, "hi"},  // Devanagari
+    {0x0980, 0x09FF, "bn"},  // Bengali
+    {0x0B80, 0x0BFF, "ta"},  // Tamil
+};
+
+constexpr int kMinimumCharacters = 3;
+
+}  // namespace
+
+std::optional<std::string> ScriptHint(std::u16string_view title) {
+  int counts[std::size(kScripts)] = {};
+  // All three blocks are in the Basic Multilingual Plane: no surrogates.
+  for (char16_t c : title) {
+    for (size_t i = 0; i < std::size(kScripts); ++i) {
+      if (c >= kScripts[i].first && c <= kScripts[i].last) {
+        ++counts[i];
+      }
+    }
+  }
+  size_t best = 0;
+  bool tie = false;
+  for (size_t i = 1; i < std::size(kScripts); ++i) {
+    if (counts[i] > counts[best]) {
+      best = i;
+      tie = false;
+    } else if (counts[i] == counts[best]) {
+      tie = true;
+    }
+  }
+  if (tie || counts[best] < kMinimumCharacters) {
+    return std::nullopt;
+  }
+  return kScripts[best].code;
+}
+
+}  // namespace tark_captions
