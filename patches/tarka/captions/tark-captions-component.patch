+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/call_state.h"
+
+namespace tark_captions {
+
+void CallState::OnMicCapturing(bool capturing) {
+  if (capturing == in_call_) {
+    return;
+  }
+  in_call_ = capturing;
+  captions_on_ = false;
+  hidden_ = false;
+}
+
+bool CallState::SetCaptionsOn(bool on) {
+  if (on && (!in_call_ || hidden_)) {
+    return false;
+  }
+  captions_on_ = on;
+  return true;
+}
+
+void CallState::HideForThisCall() {
+  captions_on_ = false;
+  hidden_ = in_call_;
+}
+
+CallState::Phase CallState::phase() const {
+  if (!in_call_) {
+    return Phase::kIdle;
+  }
+  return captions_on_ ? Phase::kCaptioning : Phase::kInCall;
+}
+
+}  // namespace tark_captions
