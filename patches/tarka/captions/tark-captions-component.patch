+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_ORT_RUNTIME_H_
+#define COMPONENTS_TARK_CAPTIONS_ORT_RUNTIME_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
+#include "base/native_library.h"
+
+struct OrtApi;
+struct OrtEnv;
+struct OrtSession;
+
+namespace tark_captions {
+
+// A dense tensor passed to or returned from a model: float32 data in `f32`
+// or int64 data in `i64` (exactly one is used), row-major in `shape`. An
+// empty shape is a scalar.
+struct Tensor {
+  std::string name;
+  std::vector<int64_t> shape;
+  std::vector<float> f32;
+  std::vector<int64_t> i64;
+};
+
+class OrtModel;
+
+// ONNX Runtime, loaded at run time from its dylib (Tark.app/Contents/
+// Frameworks/libonnxruntime.1.31.0.dylib) the way Chromium loads SODA:
+// nothing links against it. Use on one sequence.
+class OrtRuntime {
+ public:
+  // Null if the library or its C API (ORT_API_VERSION) is unavailable.
+  static std::unique_ptr<OrtRuntime> Load(const base::FilePath& dylib);
+
+  OrtRuntime(const OrtRuntime&) = delete;
+  OrtRuntime& operator=(const OrtRuntime&) = delete;
+  ~OrtRuntime();
+
+  // Null if the model is missing or invalid. `threads` is ONNX Runtime's
+  // intra-op thread count.
+  std::unique_ptr<OrtModel> LoadModel(const base::FilePath& onnx, int threads);
+
+ private:
+  OrtRuntime(base::NativeLibrary library, const OrtApi* api, OrtEnv* env);
+
+  base::NativeLibrary library_;
+  raw_ptr<const OrtApi> api_;
+  raw_ptr<OrtEnv> env_;
+};
+
+// One loaded model (an ONNX Runtime session). The runtime must outlive it.
+class OrtModel {
+ public:
+  OrtModel(const OrtModel&) = delete;
+  OrtModel& operator=(const OrtModel&) = delete;
+  ~OrtModel();
+
+  // Runs the model on `inputs` (float32 or int64, by name) and fills
+  // `outputs` with `output_names`, in that order. False on any error.
+  bool Run(const std::vector<Tensor>& inputs,
+           const std::vector<std::string>& output_names,
+           std::vector<Tensor>* outputs);
+
+ private:
+  friend class OrtRuntime;
+  OrtModel(const OrtApi* api, OrtSession* session);
+
+  raw_ptr<const OrtApi> api_;
+  raw_ptr<OrtSession> session_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_ORT_RUNTIME_H_
