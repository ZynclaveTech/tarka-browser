+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/ort_runtime.h"
+
+#include <utility>
+
+#include "base/logging.h"
+#include "base/memory/ptr_util.h"
+#include "onnxruntime_c_api.h"
+
+namespace tark_captions {
+namespace {
+
+using GetApiBaseFn = const OrtApiBase* (*)();
+
+// Logs and frees `status`; true when there was no error.
+bool Ok(const OrtApi* api, OrtStatus* status) {
+  if (!status) {
+    return true;
+  }
+  LOG(ERROR) << "ONNX Runtime: " << api->GetErrorMessage(status);
+  api->ReleaseStatus(status);
+  return false;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<OrtRuntime> OrtRuntime::Load(const base::FilePath& dylib) {
+  base::NativeLibraryLoadError error;
+  base::NativeLibrary library = base::LoadNativeLibrary(dylib, &error);
+  if (!library) {
+    LOG(ERROR) << "ONNX Runtime not loaded from " << dylib << ": " << error.ToString();
+    return nullptr;
+  }
+  auto get_api_base = reinterpret_cast<GetApiBaseFn>(
+      base::GetFunctionPointerFromNativeLibrary(library, "OrtGetApiBase"));
+  const OrtApi* api = get_api_base ? get_api_base()->GetApi(ORT_API_VERSION) : nullptr;
+  OrtEnv* env = nullptr;
+  if (!api || !Ok(api, api->CreateEnv(ORT_LOGGING_LEVEL_WARNING, "tark_captions", &env))) {
+    base::UnloadNativeLibrary(library);
+    return nullptr;
+  }
+  return base::WrapUnique(new OrtRuntime(library, api, env));
+}
+
+OrtRuntime::OrtRuntime(base::NativeLibrary library, const OrtApi* api, OrtEnv* env)
+    : library_(library), api_(api), env_(env) {}
+
+OrtRuntime::~OrtRuntime() {
+  api_->ReleaseEnv(env_.ExtractAsDangling());
+  api_ = nullptr;
+  base::UnloadNativeLibrary(library_);
+}
+
+std::unique_ptr<OrtModel> OrtRuntime::LoadModel(const base::FilePath& onnx, int threads) {
+  OrtSessionOptions* options = nullptr;
+  if (!Ok(api_, api_->CreateSessionOptions(&options))) {
+    return nullptr;
+  }
+  OrtSession* session = nullptr;
+  const bool ok = Ok(api_, api_->SetIntraOpNumThreads(options, threads)) &&
+                  Ok(api_, api_->SetInterOpNumThreads(options, 1)) &&
+                  Ok(api_, api_->SetSessionGraphOptimizationLevel(options, ORT_ENABLE_ALL)) &&
+                  Ok(api_, api_->CreateSession(env_, onnx.value().c_str(), options, &session));
+  api_->ReleaseSessionOptions(options);
+  if (!ok) {
+    return nullptr;
+  }
+  return base::WrapUnique(new OrtModel(api_, session));
+}
+
+OrtModel::OrtModel(const OrtApi* api, OrtSession* session) : api_(api), session_(session) {}
+
+OrtModel::~OrtModel() {
+  api_->ReleaseSession(session_.ExtractAsDangling());
+}
+
+bool OrtModel::Run(const std::vector<Tensor>& inputs,
+                   const std::vector<std::string>& output_names,
+                   std::vector<Tensor>* outputs) {
+  OrtMemoryInfo* memory = nullptr;
+  if (!Ok(api_, api_->CreateCpuMemoryInfo(OrtArenaAllocator, OrtMemTypeDefault, &memory))) {
+    return false;
+  }
+  std::vector<OrtValue*> in_values(inputs.size(), nullptr);
+  std::vector<const char*> in_names;
+  bool ok = true;
+  for (size_t i = 0; ok && i < inputs.size(); ++i) {
+    const Tensor& t = inputs[i];
+    in_names.push_back(t.name.c_str());
+    // ONNX Runtime reads the data in place; it does not write inputs.
+    void* data = t.i64.empty() ? static_cast<void*>(const_cast<float*>(t.f32.data()))
+                               : static_cast<void*>(const_cast<int64_t*>(t.i64.data()));
+    const size_t bytes = t.i64.empty() ? t.f32.size() * sizeof(float) : t.i64.size() * sizeof(int64_t);
+    ok = Ok(api_, api_->CreateTensorWithDataAsOrtValue(
+                      memory, data, bytes, t.shape.data(), t.shape.size(),
+                      t.i64.empty() ? ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT
+                                    : ONNX_TENSOR_ELEMENT_DATA_TYPE_INT64,
+                      &in_values[i]));
+  }
+  std::vector<const char*> out_names;
+  for (const std::string& name : output_names) {
+    out_names.push_back(name.c_str());
+  }
+  std::vector<OrtValue*> out_values(output_names.size(), nullptr);
+  ok = ok && Ok(api_, api_->Run(session_, nullptr, in_names.data(), in_values.data(),
+                                in_values.size(), out_names.data(), out_names.size(),
+                                out_values.data()));
+  outputs->clear();
+  for (size_t i = 0; ok && i < out_values.size(); ++i) {
+    Tensor t{.name = output_names[i]};
+    OrtTensorTypeAndShapeInfo* info = nullptr;
+    size_t count = 0;
+    size_t dims = 0;
+    ONNXTensorElementDataType type = ONNX_TENSOR_ELEMENT_DATA_TYPE_UNDEFINED;
+    void* data = nullptr;
+    ok = Ok(api_, api_->GetTensorTypeAndShape(out_values[i], &info));
+    if (ok) {
+      ok = Ok(api_, api_->GetDimensionsCount(info, &dims)) &&
+           Ok(api_, api_->GetTensorElementType(info, &type)) &&
+           Ok(api_, api_->GetTensorShapeElementCount(info, &count));
+      if (ok) {
+        t.shape.resize(dims);
+        ok = Ok(api_, api_->GetDimensions(info, t.shape.data(), dims));
+      }
+      api_->ReleaseTensorTypeAndShapeInfo(info);
+    }
+    ok = ok && Ok(api_, api_->GetTensorMutableData(out_values[i], &data));
+    if (ok && type == ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT) {
+      const float* f = static_cast<const float*>(data);
+      t.f32.assign(f, f + count);
+    } else if (ok && type == ONNX_TENSOR_ELEMENT_DATA_TYPE_INT64) {
+      const int64_t* v = static_cast<const int64_t*>(data);
+      t.i64.assign(v, v + count);
+    } else if (ok) {
+      LOG(ERROR) << "ONNX Runtime: output " << t.name << " has unsupported type " << type;
+      ok = false;
+    }
+    outputs->push_back(std::move(t));
+  }
+  for (OrtValue* value : in_values) {
+    if (value) {
+      api_->ReleaseValue(value);
+    }
+  }
+  for (OrtValue* value : out_values) {
+    if (value) {
+      api_->ReleaseValue(value);
+    }
+  }
+  api_->ReleaseMemoryInfo(memory);
+  if (!ok) {
+    outputs->clear();
+  }
+  return ok;
+}
+
+}  // namespace tark_captions
