+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// tark_captions_bench: cores used and draft lag of the caption engine on a
+// 5-minute Hindi track (the test clips repeated, with 0.8-2 s pauses).
+
+#include <sys/resource.h>
+
+#include <algorithm>
+#include <cstdio>
+
+#include "base/functional/callback_helpers.h"
+#include "components/tark_captions/caption_engine.h"
+#include "components/tark_captions/segmenter.h"
+#include "components/tark_captions/test_util.h"
+
+namespace {
+
+double CpuSeconds() {
+  rusage u;
+  getrusage(RUSAGE_SELF, &u);
+  return u.ru_utime.tv_sec + u.ru_utime.tv_usec / 1e6 + u.ru_stime.tv_sec + u.ru_stime.tv_usec / 1e6;
+}
+
+}  // namespace
+
+int main() {
+  using namespace tark_captions;
+  std::optional<base::FilePath> ort = test::OrtPath();
+  std::optional<base::FilePath> models = test::ModelsDir();
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  if (!ort || !models || !testdata) {
+    fprintf(stderr, "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA\n");
+    return 2;
+  }
+  std::vector<std::vector<float>> clips;
+  for (const base::Value& clip : test::GoldenClips(*testdata)) {
+    if (*clip.GetDict().FindString("lang") == "hi") {
+      int rate = 0;
+      clips.push_back(test::ReadWav(testdata->AppendASCII(*clip.GetDict().FindString("wav")), &rate));
+    }
+  }
+  std::vector<float> track;
+  for (int i = 0; track.size() < 300u * 16000; ++i) {
+    const std::vector<float>& clip = clips[i % clips.size()];
+    track.insert(track.end(), clip.begin(), clip.end());
+    track.insert(track.end(), static_cast<size_t>((0.8 + 0.4 * (i % 4)) * 16000), 0.0f);
+  }
+  std::unique_ptr<CaptionEngine> engine = CaptionEngine::Create(*models, *ort);
+  if (!engine) {
+    fprintf(stderr, "engine not created\n");
+    return 1;
+  }
+  const double cpu0 = CpuSeconds();
+  for (size_t i = 0; i < track.size(); i += 160) {
+    engine->AddAudio(base::span(track).subspan(i, std::min<size_t>(160, track.size() - i)), 1,
+                     16000, base::DoNothing());
+  }
+  engine->Flush(base::DoNothing());
+  const double cpu = CpuSeconds() - cpu0;
+  std::vector<double> times = engine->stats().decode_seconds;
+  std::sort(times.begin(), times.end());
+  const double audio = track.size() / 16000.0;
+  printf("audio %.0f s, decodes %d, cores used %.2f, decode median %.3f s p90 %.3f s, draft lag %.2f s\n",
+         audio, engine->stats().decodes, cpu / audio, times[times.size() / 2],
+         times[times.size() * 9 / 10], Segmenter::kDraftEvery / 2 + times[times.size() / 2]);
+  return 0;
+}
