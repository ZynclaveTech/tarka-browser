+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/call_state.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(CallStateTest, MicCaptureStartsCall) {
+  CallState state;
+  EXPECT_EQ(state.phase(), CallState::Phase::kIdle);
+  state.OnMicCapturing(true);
+  EXPECT_EQ(state.phase(), CallState::Phase::kInCall);
+  EXPECT_TRUE(state.in_call());
+}
+
+TEST(CallStateTest, CaptionsOffByDefault) {
+  CallState state;
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.captions_on());
+  EXPECT_TRUE(state.SetCaptionsOn(true));
+  EXPECT_EQ(state.phase(), CallState::Phase::kCaptioning);
+}
+
+TEST(CallStateTest, CaptionsNeedACall) {
+  CallState state;
+  EXPECT_FALSE(state.SetCaptionsOn(true));
+  EXPECT_FALSE(state.captions_on());
+}
+
+TEST(CallStateTest, CallEndStopsEngine) {
+  CallState state;
+  state.OnMicCapturing(true);
+  state.SetCaptionsOn(true);
+  state.OnMicCapturing(false);
+  EXPECT_EQ(state.phase(), CallState::Phase::kIdle);
+  EXPECT_FALSE(state.captions_on());
+  // The next call starts with captions off again.
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.captions_on());
+}
+
+TEST(CallStateTest, HiddenForThisCall) {
+  CallState state;
+  state.OnMicCapturing(true);
+  state.SetCaptionsOn(true);
+  state.HideForThisCall();
+  EXPECT_FALSE(state.captions_on());
+  EXPECT_TRUE(state.hidden());
+  EXPECT_FALSE(state.SetCaptionsOn(true));
+  state.OnMicCapturing(false);
+  state.OnMicCapturing(true);
+  EXPECT_FALSE(state.hidden());
+}
+
