+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
+#define COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
+
+namespace tark_captions {
+
+// One tab's call and captions state. A tab is in a call while it captures
+// the microphone. Captions start off in every call and only the user turns
+// them on (nothing listens before that); the call ending turns them off and
+// forgets "hide for this call".
+class CallState {
+ public:
+  enum class Phase { kIdle, kInCall, kCaptioning };
+
+  void OnMicCapturing(bool capturing);
+  // False (and no change) outside a call or after HideForThisCall().
+  bool SetCaptionsOn(bool on);
+  // The pill's ✕: captions off and no pill until the next call.
+  void HideForThisCall();
+
+  Phase phase() const;
+  bool in_call() const { return in_call_; }
+  bool captions_on() const { return captions_on_; }
+  bool hidden() const { return hidden_; }
+
+ private:
+  bool in_call_ = false;
+  bool captions_on_ = false;
+  bool hidden_ = false;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CALL_STATE_H_
