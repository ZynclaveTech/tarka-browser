+// The languages Phase 1 captions (measured in the D4 spike).
+enum class Language { kHindi, kTamil, kBengali };
+
+// "hi", "ta", "bn" (also the keys of vocab.json and language_masks.json).
+const char* LanguageCode(Language language);
+std::optional<Language> LanguageFromCode(std::string_view code);
+
+// AI4Bharat IndicConformer 600M (MIT), its int8 encoder and CTC decoder:
+// whole-segment recognition, greedy CTC per language.
+class AsrModel {
+ public:
+  // Null if a model file is missing or invalid.
+  static std::unique_ptr<AsrModel> Load(OrtRuntime* runtime,
+                                        const base::FilePath& models_dir,
