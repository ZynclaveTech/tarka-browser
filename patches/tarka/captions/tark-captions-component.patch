+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/caption_engine.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/ptr_util.h"
+#include "base/time/time.h"
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/segmenter.h"
+#include "components/tark_captions/vad.h"
+#include "media/base/sinc_resampler.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr int kRate = 16000;
+constexpr int kThreads = 2;
+// Audio kept for decoding: more than a 5 s segment plus its pre-roll.
+constexpr int64_t kKeep = 12 * kRate;
+
+}  // namespace
+
+// static
+std::unique_ptr<CaptionEngine> CaptionEngine::Create(const base::FilePath& models_dir,
+                                                     const base::FilePath& ort_dylib) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_dylib);
+  if (!runtime) {
+    return nullptr;
+  }
+  std::unique_ptr<AsrModel> asr = AsrModel::Load(runtime.get(), models_dir, kThreads);
+  std::unique_ptr<Vad> vad = Vad::Load(runtime.get(), models_dir);
+  if (!asr || !vad) {
+    return nullptr;
+  }
+  return base::WrapUnique(new CaptionEngine(std::move(runtime), std::move(asr), std::move(vad)));
+}
+
+CaptionEngine::CaptionEngine(std::unique_ptr<OrtRuntime> runtime,
+                             std::unique_ptr<AsrModel> asr,
+                             std::unique_ptr<Vad> vad)
+    : runtime_(std::move(runtime)),
+      asr_(std::move(asr)),
+      vad_(std::move(vad)),
+      segmenter_(std::make_unique<Segmenter>()) {}
+
+CaptionEngine::~CaptionEngine() {
+  // Models before the runtime that loaded them.
+  asr_.reset();
+  vad_.reset();
+}
+
+void CaptionEngine::SetLanguage(Language language) {
+  language_ = language;
+}
+
+void CaptionEngine::AddAudio(base::span<const float> interleaved, int channels, int sample_rate,
+                             const EventCallback& on_event) {
+  if (channels < 1 || sample_rate < 8000) {
+    return;
+  }
+  std::vector<float> mono(interleaved.size() / channels);
+  for (size_t i = 0; i < mono.size(); ++i) {
+    float sum = 0;
+    for (int c = 0; c < channels; ++c) {
+      sum += interleaved[i * channels + c];
+    }
+    mono[i] = sum / channels;
+  }
+  if (sample_rate == kRate) {
+    AddMono16k(mono, on_event);
+    return;
+  }
+  if (!resampler_ || sample_rate != input_rate_) {
+    input_rate_ = sample_rate;
+    fifo_.clear();
+    resampler_ = std::make_unique<media::SincResampler>(
+        static_cast<double>(sample_rate) / kRate, media::SincResampler::kDefaultRequestSize,
+        base::BindRepeating(
+            [](std::vector<float>* fifo, base::span<float> dest) {
+              const size_t n = std::min(dest.size(), fifo->size());
+              std::copy_n(fifo->begin(), n, dest.begin());
+              std::fill(dest.begin() + n, dest.end(), 0.0f);
+              fifo->erase(fifo->begin(), fifo->begin() + n);
+            },
+            base::Unretained(&fifo_)));
+    resampler_->PrimeWithSilence();
+  }
+  fifo_.insert(fifo_.end(), mono.begin(), mono.end());
+  std::vector<float> out(resampler_->ChunkSize());
+  while (fifo_.size() >= static_cast<size_t>(media::SincResampler::kDefaultRequestSize)) {
+    resampler_->Resample(out);
+    AddMono16k(out, on_event);
+  }
+}
+
+void CaptionEngine::AddMono16k(base::span<const float> pcm, const EventCallback& on_event) {
+  audio_.insert(audio_.end(), pcm.begin(), pcm.end());
+  for (float sample : pcm) {
+    chunk_.push_back(sample);
+    if (chunk_.size() < Vad::kChunk) {
+      continue;
+    }
+    total_ += Vad::kChunk;
+    const float p = vad_->Process(base::span(chunk_).first<Vad::kChunk>());
+    chunk_.clear();
+    const SegmenterAction a = segmenter_->OnChunk(static_cast<double>(total_) / kRate, p);
+    if (a.kind != SegmenterAction::kNone) {
+      Decode(a.kind == SegmenterAction::kFinal, a.start_s, a.end_s, on_event);
+    }
+  }
+  if (static_cast<int64_t>(audio_.size()) > 2 * kKeep) {
+    const int64_t drop = static_cast<int64_t>(audio_.size()) - kKeep;
+    audio_.erase(audio_.begin(), audio_.begin() + drop);
+    audio_start_ += drop;
+  }
+}
+
+void CaptionEngine::Flush(const EventCallback& on_event) {
+  if (std::optional<SegmenterAction> a = segmenter_->Flush(static_cast<double>(total_) / kRate)) {
+    Decode(/*is_final=*/true, a->start_s, a->end_s, on_event);
+  }
+}
+
+void CaptionEngine::Decode(bool is_final, double start_s, double end_s,
+                           const EventCallback& on_event) {
+  const int64_t end_total = audio_start_ + static_cast<int64_t>(audio_.size());
+  const int64_t begin = std::clamp<int64_t>(start_s * kRate, audio_start_, end_total);
+  const int64_t end = std::clamp<int64_t>(end_s * kRate, begin, end_total);
+  if (end - begin < kRate / 4) {
+    return;
+  }
+  const base::TimeTicks started = base::TimeTicks::Now();
+  std::string text = asr_->Decode(
+      base::span(audio_).subspan(static_cast<size_t>(begin - audio_start_),
+                                 static_cast<size_t>(end - begin)),
+      language_);
+  stats_.decodes++;
+  stats_.decode_seconds.push_back((base::TimeTicks::Now() - started).InSecondsF());
+  if (!text.empty()) {
+    on_event.Run({.is_final = is_final, .text = std::move(text)});
+  }
+}
+
+}  // namespace tark_captions
