+           std::map<Language, Vocabulary> vocabularies);
+
+  std::unique_ptr<MelFrontend> frontend_;
+  std::unique_ptr<OrtModel> encoder_;
+  std::unique_ptr<OrtModel> ctc_;
+  std::map<Language, Vocabulary> vocabularies_;
