+  // UTF-8 text of 16 kHz mono speech; empty if nothing was recognised or
+  // the model failed.
+  std::string Decode(base::span<const float> pcm16k, Language language);
+
+ private:
+  struct Vocabulary {
+    std::vector<int> logit_indices;   // the language's columns of the logits
+    std::vector<std::string> tokens;  // token id -> piece
