+#ifndef COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
+#define COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "components/tark_captions/asr_model.h"
+
+namespace media {
+class SincResampler;
+}
+
+namespace tark_captions {
+
+class OrtRuntime;
+class Segmenter;
+class Vad;
+
+// A caption: a draft of what is being said, or the final text of a segment.
+struct CaptionEvent {
+  bool is_final = false;
+  std::string text;
+};
+
+// Live captions of a call's audio: speech detection, segmenting and
+// IndicConformer, in the D4 spike's measured configuration (2 threads,
+// drafts every 0.8 s, segments of at most 5 s). Not thread-safe; use on one
+// sequence. Decoding happens inside AddAudio(), so call it off the audio
+// thread.
+class CaptionEngine {
+ public:
+  struct Stats {
+    int decodes = 0;
+    std::vector<double> decode_seconds;  // wall time of each decode
+  };
+
+  // Null if ONNX Runtime or any model is missing.
+  static std::unique_ptr<CaptionEngine> Create(const base::FilePath& models_dir,
+                                               const base::FilePath& ort_dylib);
+
+  CaptionEngine(const CaptionEngine&) = delete;
+  CaptionEngine& operator=(const CaptionEngine&) = delete;
+  ~CaptionEngine();
+
+  void SetLanguage(Language language);
+
+  // Interleaved float audio at any rate and channel count; downmixed and
+  // resampled to 16 kHz mono. `on_event` runs for each draft and final.
+  using EventCallback = base::RepeatingCallback<void(CaptionEvent)>;
+  void AddAudio(base::span<const float> interleaved, int channels, int sample_rate,
+                const EventCallback& on_event);
+  // The end of the audio: finalises an open segment.
+  void Flush(const EventCallback& on_event);
+
+  const Stats& stats() const { return stats_; }
+
+ private:
+  CaptionEngine(std::unique_ptr<OrtRuntime> runtime,
+                std::unique_ptr<AsrModel> asr,
+                std::unique_ptr<Vad> vad);
+
+  void AddMono16k(base::span<const float> pcm, const EventCallback& on_event);
+  void Decode(bool is_final, double start_s, double end_s, const EventCallback& on_event);
+
+  std::unique_ptr<OrtRuntime> runtime_;
+  std::unique_ptr<AsrModel> asr_;
+  std::unique_ptr<Vad> vad_;
+  std::unique_ptr<Segmenter> segmenter_;
+  Language language_ = Language::kHindi;
+
+  // 16 kHz mono audio from absolute sample `audio_start_` to `total_`.
+  std::vector<float> audio_;
+  int64_t audio_start_ = 0;
+  int64_t total_ = 0;
+  std::vector<float> chunk_;  // the next VAD chunk, being filled
+
+  int input_rate_ = 16000;
+  std::unique_ptr<media::SincResampler> resampler_;
+  std::vector<float> fifo_;  // mono input waiting for the resampler
+
+  Stats stats_;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CAPTION_ENGINE_H_
