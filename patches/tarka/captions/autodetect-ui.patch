+std::u16string ChipText(const PillLanguage& pill) {
+  switch (pill.chip) {
+    case PillLanguage::Chip::kAutoDetect:
+      return l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_AUTO_DETECT);
+    case PillLanguage::Chip::kDetected:
+      return l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_DETECTED, NameOf(pill.code));
+    case PillLanguage::Chip::kChosen:
