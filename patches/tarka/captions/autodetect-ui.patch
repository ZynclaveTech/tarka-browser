+#ifndef CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_PILL_LANGUAGE_H_
+#define CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_PILL_LANGUAGE_H_
+
+#include <string>
+
+namespace tark_captions {
+class ClientLanguage;
+}
+
+// What the call captions pill says about the client's language (D4 Phase 3,
+// mockup pill-states.html 2, 4 and 5): the language chip, and a line with
+// "Choose a language" when Tark can't caption what it heard.
+struct PillLanguage {
+  enum class Chip {
+    kAutoDetect,  // "Auto-detect": listening for it.
+    kDetected,    // "Tamil · detected".
+    kChosen,      // "Tamil": the user picked it.
+  };
+  enum class Notice {
+    kNone,
+    kPlanned,       // An Indian language Tark will caption once tested.
+    kUnsupported,   // A language Tark can't caption.
+    kNeedsMacOS26,  // A language macOS 26 captions, on an older Mac.
+  };
+  Chip chip = Chip::kAutoDetect;
+  Notice notice = Notice::kNone;
+  std::string code;  // The language, when there is one.
+};
+
+PillLanguage DescribeLanguage(const tark_captions::ClientLanguage& language);
+
+// "Swahili" for "sw" in `ui_locale`'s words (ICU), for languages Tark has
+// no string of its own for.
+std::u16string LanguageDisplayName(const std::string& code, const std::string& ui_locale);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_PILL_LANGUAGE_H_
