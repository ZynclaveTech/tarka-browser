+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/pill_language.h"
+
+#include "components/tark_captions/client_language.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+using tark_captions::ClientLanguage;
+
+TEST(PillLanguageTest, ShowsListeningWhileDetecting) {
+  ClientLanguage language(/*apple_available=*/false);
+  const PillLanguage pill = DescribeLanguage(language);
+  EXPECT_EQ(pill.chip, PillLanguage::Chip::kAutoDetect);
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kNone);
+}
+
+TEST(PillLanguageTest, ShowsDetectedSuffix) {
+  ClientLanguage language(false);
+  language.Detected("ta");
+  const PillLanguage pill = DescribeLanguage(language);
+  EXPECT_EQ(pill.chip, PillLanguage::Chip::kDetected);
+  EXPECT_EQ(pill.code, "ta");
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kNone);
+}
+
+TEST(PillLanguageTest, ChosenHasNoSuffix) {
+  ClientLanguage language(false);
+  language.Choose("bn");
+  EXPECT_EQ(DescribeLanguage(language).chip, PillLanguage::Chip::kChosen);
+}
+
+TEST(PillLanguageTest, ShowsUnsupportedMessage) {
+  ClientLanguage language(false);
+  language.Detected("sw");
+  const PillLanguage pill = DescribeLanguage(language);
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kUnsupported);
+  EXPECT_EQ(LanguageDisplayName(pill.code, "en"), u"Swahili");
+}
+
+TEST(PillLanguageTest, ShowsPlannedMessage) {
+  ClientLanguage language(false);
+  language.Detected("te");
+  const PillLanguage pill = DescribeLanguage(language);
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kPlanned);
+  EXPECT_EQ(LanguageDisplayName(pill.code, "en"), u"Telugu");
+}
+
+TEST(PillLanguageTest, AppleLanguageNeedsMacOS26) {
+  ClientLanguage language(false);
+  language.Detected("es");
+  const PillLanguage pill = DescribeLanguage(language);
+  EXPECT_EQ(pill.notice, PillLanguage::Notice::kNeedsMacOS26);
+  EXPECT_EQ(LanguageDisplayName(pill.code, "en"), u"Spanish");
+}
+
+}  // namespace
