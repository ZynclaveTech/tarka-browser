+
+void CallCaptionsTabHelper::OnLanguageDetected(const std::string& code) {
+  if (!state_.captions_on()) {
+    return;
+  }
+  VLOG(1) << "Tark captions: the client speaks \"" << code << "\"";
+  const std::string before = client_language_.code();
+  client_language_.Detected(code);
+  if (client_language_.code() == before) {
+    return;  // Picked by the user, already locked, or "und".
+  }
+  if (client_language_.state() == tark_captions::ClientLanguage::State::kCaptioning) {
+    // The speech process already captions it; captions come after this.
+    language_ = *tark_captions::LanguageFromCode(client_language_.code());
+    render_queue_.ChoicesChanged();
+  }
+  UpdateModelsInUse();
+  observers_.Notify(&Observer::OnClientLanguageChanged, this);
   observers_.Notify(&Observer::OnCallStateChanged, this);
 }
 
