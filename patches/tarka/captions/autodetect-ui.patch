+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/pill_language.h"
+
+#include "components/tark_captions/client_language.h"
+#include "ui/base/l10n/l10n_util.h"
+
+PillLanguage DescribeLanguage(const tark_captions::ClientLanguage& language) {
+  using State = tark_captions::ClientLanguage::State;
+  PillLanguage out;
+  out.code = language.code();
+  if (language.state() == State::kDetecting) {
+    return out;
+  }
+  out.chip = language.automatic() ? PillLanguage::Chip::kDetected : PillLanguage::Chip::kChosen;
+  switch (language.state()) {
+    case State::kPlanned:
+      out.notice = PillLanguage::Notice::kPlanned;
+      break;
+    case State::kUnsupported:
+      out.notice = PillLanguage::Notice::kUnsupported;
+      break;
+    case State::kAppleUnavailable:
+      out.notice = PillLanguage::Notice::kNeedsMacOS26;
+      break;
+    case State::kDetecting:
+    case State::kCaptioning:
+    case State::kApple:
+      break;
+  }
+  return out;
+}
+
+std::u16string LanguageDisplayName(const std::string& code, const std::string& ui_locale) {
+  return l10n_util::GetDisplayNameForLocale(code, ui_locale, /*is_for_ui=*/true);
+}
