+// Tark's own names for its languages, ICU's for the rest (Swahili, Spanish).
+std::u16string NameOf(const std::string& code) {
+  if (std::optional<tark_captions::Language> language = tark_captions::LanguageFromCode(code)) {
+    return LanguageName(*language);
+  }
+  return LanguageDisplayName(code, g_browser_process->GetApplicationLocale());
