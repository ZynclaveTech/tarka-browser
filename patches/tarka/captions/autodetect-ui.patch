+  if (!shown_) {
     return;
   }
+  if (!shown_->captions_on()) {
+    // Detection (and the captions engine) listen through the language_id
+    // unit; Tark's own captions model is needed once the language is one of
+    // its own.
+    std::vector<tark_captions::ModelUnit> units = {tark_captions::ModelUnit::kLanguageId};
+    const tark_captions::ClientLanguage& client = shown_->client_language();
+    if (!client.automatic() ||
+        client.state() == tark_captions::ClientLanguage::State::kCaptioning) {
+      units.push_back(tark_captions::ModelUnit::kCaptions);
+    }
+    for (tark_captions::ModelUnit unit : units) {
+      if (!tark_captions::TarkCaptionModels().ready(unit)) {
+        WaitForModels(/*for_captions=*/true, /*turn_on=*/true, units);
+        return;
+      }
+    }
+  }
   shown_->SetCaptionsOn(!shown_->captions_on());
 }
 
