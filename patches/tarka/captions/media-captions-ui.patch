+TarkCaptionButtonView::TarkCaptionButtonView(PressedCallback callback)
+    : views::LabelButton(std::move(callback), u"CC") {
+  SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  SetBorder(nullptr);
+  label()->SetFontList(
+      gfx::FontList().DeriveWithSizeDelta(-2).DeriveWithWeight(gfx::Font::Weight::BOLD));
+  SetCaptionsOn(false);
+}
+
+TarkCaptionButtonView::~TarkCaptionButtonView() = default;
+
+void TarkCaptionButtonView::SetCaptionsOn(bool on) {
+  const ui::ColorId background =
+      on ? ui::kColorButtonBackgroundProminent : ui::kColorDialogBackground;
+  const ui::ColorId foreground =
+      on ? ui::kColorButtonForegroundProminent : ui::kColorLabelForeground;
+  SetBackground(views::CreateRoundedRectBackground(background, kRadius));
+  SetBorder(views::CreateRoundedRectBorder(
+      1, kRadius, on ? ui::kColorButtonBackgroundProminent : ui::kColorSeparator));
+  SetEnabledTextColors(foreground);
+  const std::u16string name = l10n_util::GetStringUTF16(
+      on ? IDS_TARK_CAPTIONS_BUTTON_OFF : IDS_TARK_CAPTIONS_BUTTON_ON);
+  SetTooltipText(name);
+  GetViewAccessibility().SetName(name);
+}
+
+gfx::Size TarkCaptionButtonView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return kSize;
+}
