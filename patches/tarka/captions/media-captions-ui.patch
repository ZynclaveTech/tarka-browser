+void TarkCaptionPillController::UpdateButton() {
+  button_timer_.Stop();
+  CallCaptionsTabHelper* active =
+      HelperFor(browser_view_->browser()->GetTabStripModel()->GetActiveWebContents());
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::optional<gfx::Rect> place;
+  if (active && browser_view_->GetWidget() &&
+      tark_captions::CaptionChoices(g_browser_process->local_state()).show_button()) {
+    if (std::optional<base::TimeTicks> next =
+            active->players().NextChange(active->in_call(), now)) {
+      button_timer_.Start(FROM_HERE, *next - now,
+                          base::BindOnce(&TarkCaptionPillController::UpdateButton,
+                                         base::Unretained(this)));
+    }
+    // Captions on (or on their way) keep the button, to turn them off.
+    if (active->captions_on() || (waiting_ && shown_ == active) ||
+        active->players().ButtonShown(active->in_call(), now)) {
+      const gfx::Rect area = browser_view_->GetActiveContentsWebView()->GetBoundsInScreen();
+      place = tark_captions::PlaceButton(active->players(), active->in_call(), area.size(),
+                                         TarkCaptionButtonView::kSize);
+      if (place) {
+        place->Offset(area.OffsetFromOrigin());
+        // The page decides where it goes: never over the browser's own
+        // windows above the page (a permission prompt, the fullscreen
+        // bubble, the omnibox popup).
+        std::vector<gfx::Rect> browser_windows;
+        const gfx::NativeView browser = browser_view_->GetWidget()->GetNativeView();
+        for (const views::Widget::Widgets& widgets :
+             {views::Widget::GetAllChildWidgets(browser), views::Widget::GetAllOwnedWidgets(browser)}) {
+          for (views::Widget* widget : widgets) {
+            if (widget->IsVisible() && widget != browser_view_->GetWidget() &&
+                widget != button_widget_.get() && widget != widget_.get()) {
+              browser_windows.push_back(widget->GetWindowBoundsInScreen());
+            }
+          }
+        }
+        if (!ButtonClearOf(*place, browser_windows)) {
+          place.reset();
+        }
+      }
+    }
+  }
+  if (!place) {
+    if (button_widget_) {
+      button_widget_->Hide();
+    }
+    return;
+  }
+  if (!button_widget_) {
+    views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                     views::Widget::InitParams::TYPE_POPUP);
+    params.parent = browser_view_->GetWidget()->GetNativeView();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.name = "TarkCaptionButton";
+    button_widget_ = std::make_unique<views::Widget>();
+    button_widget_->Init(std::move(params));
+    button_view_ = button_widget_->SetContentsView(std::make_unique<TarkCaptionButtonView>(
+        base::BindRepeating(&TarkCaptionPillController::OnCaptionButtonPressed,
+                            base::Unretained(this))));
+    button_widget_observation_.Observe(button_widget_.get());
+  }
+  if (!button_view_) {
+    return;
+  }
+  button_view_->SetCaptionsOn(active->captions_on());
+  button_widget_->SetBounds(*place);
+  // Out of screen shares, with every new shape (see Reposition()).
+  button_widget_->SetAllowScreenshots(false);
+  if (!button_widget_->IsVisible()) {
+    button_widget_->ShowInactive();
+  }
+}
