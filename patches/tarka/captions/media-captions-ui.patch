+}
+
+void CallCaptionsTabHelper::MediaDestroyed(const content::MediaPlayerId& id) {
+  players_.OnDestroyed(KeyOf(id), base::TimeTicks::Now());
+  PlayersChanged();
+}
+
+void CallCaptionsTabHelper::DidUpdateAudioMutingState(bool muted) {
+  players_.SetTabMuted(muted, base::TimeTicks::Now());
+  PlayersChanged();
+}
+
+void CallCaptionsTabHelper::PrimaryPageChanged(content::Page& page) {
+  const net::SchemefulSite site(page.GetMainDocument().GetLastCommittedOrigin());
+  if (site_ && *site_ != site && state_.captions_on()) {
+    // Captions are for the site the user turned them on for.
+    state_.OnLeftSite();
+    CaptionsChanged(/*was_on=*/true);
+    ReleaseIfOff();
+    UpdateModelsInUse();
+    observers_.Notify(&Observer::OnCallStateChanged, this);
+  }
+  site_ = site;
+}
+
+void CallCaptionsTabHelper::PlayersChanged() {
+  const bool was_playing = state_.playing_sound();
+  state_.OnSoundPlaying(players_.AnyAudible());
+  if (state_.playing_sound() != was_playing) {
+    observers_.Notify(&Observer::OnCallStateChanged, this);
+  }
+  observers_.Notify(&Observer::OnPlayersChanged, this);
 }
 
