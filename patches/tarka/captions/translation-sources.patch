+  EXPECT_EQ(DirectionsFor("es", Target::kTamil),
+            (std::vector<D>{D::kSpanishToEnglish, D::kEnglishToIndic}));
+  EXPECT_EQ(DirectionsFor("es", Target::kEnglish), (std::vector<D>{D::kSpanishToEnglish}));
+  EXPECT_EQ(DirectionsFor("en", Target::kHindi), (std::vector<D>{D::kEnglishToIndic}));
+  EXPECT_EQ(DirectionsFor("hi", Target::kEnglish), (std::vector<D>{D::kIndicToEnglish}));
