+std::optional<std::string> TranslationEngine::TranslateFrom(std::string_view caption,
+                                                            std::string_view source_code,
+                                                            Target target,
+                                                            TranslationTrace* trace) {
+  if (base::TrimWhitespaceASCII(caption, base::TRIM_ALL).empty() ||
+      DirectionsFor(source_code, target).empty()) {
+    return std::string();
+  }
+  if (IsIndianCode(source_code)) {
+    return Translate(caption, *LanguageFromCode(source_code), target, trace);
+  }
+  if (source_code == "en") {
+    return TranslateEnglish(caption, target, trace);
+  }
+  // Spanish: opus-mt into English, then (an Indian target) English → Indian.
+  Direction* spanish = Get(TranslationDirection::kSpanishToEnglish);
+  if (!spanish) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> src_ids = spanish->Encode("", "", caption);
+  std::optional<std::vector<int64_t>> out_ids = spanish->Greedy(src_ids);
+  if (!out_ids) {
+    return std::nullopt;
+  }
+  if (trace) {
+    trace->src_ids = src_ids;
+    trace->out_ids = *out_ids;
+  }
+  const std::string english = spanish->Decode(*out_ids);
+  const std::optional<Language> indian_target = IndianLanguage(target);
+  if (!indian_target) {
+    return english;
+  }
+  return IntoIndian(EnglishModelInput(english), *indian_target,
+                    trace ? &trace->pivot_src_ids : nullptr,
+                    trace ? &trace->pivot_out_ids : nullptr);
+}
