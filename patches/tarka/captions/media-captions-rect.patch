+
+// Tark (D4 any-media captions): where a playing video's picture is, in DIPs
+// relative to the outermost main frame's viewport; empty when it isn't
+// visible, nullopt when it isn't known. One observer for the browser, on the
+// UI thread (a hook of its own so WebContentsObserver, which most of the
+// browser includes, stays as Chromium ships it).
+class CONTENT_EXPORT TarkMediaRectObserver {
+ public:
+  virtual ~TarkMediaRectObserver() = default;
+  virtual void OnVideoRectChanged(WebContents* web_contents,
+                                  const MediaPlayerId& id,
+                                  const std::optional<gfx::Rect>& rect) = 0;
+};
+
+// Sets the observer (null clears it); it must outlive its registration.
+CONTENT_EXPORT void SetTarkMediaRectObserver(TarkMediaRectObserver* observer);
+CONTENT_EXPORT TarkMediaRectObserver* GetTarkMediaRectObserver();
+
+}  // namespace content
