+class Document;
+class HTMLVideoElement;
+
+// Tark (D4 any-media captions): once a video has played, tells the
+// browser where it is on screen, so Tark's captions button can sit on its corner.
+// The box is the video's content box in DIPs, relative to the outermost
+// main frame's viewport; sent after a lifecycle update when it changed.
+// Empty: not visible. Null: not known (a video in a cross-site frame, whose
+// place in the page lags the page's scrolling).
+class CORE_EXPORT TarkVideoRectReporter final
+    : public GarbageCollected<TarkVideoRectReporter>,
+      public LocalFrameView::LifecycleNotificationObserver {
+ public:
+  explicit TarkVideoRectReporter(HTMLVideoElement& video);
+
+  // Starts reporting (the video started playing); it goes on while the
+  // video stays in its document, paused or moved.
+  void Attach();
+  void Detach();
+
+  // LocalFrameView::LifecycleNotificationObserver:
+  void DidFinishLifecycleUpdate(const LocalFrameView&) override;
+
+  void Trace(Visitor*) const override;
+
+ private:
+  std::optional<gfx::Rect> ComputeRect() const;
+  void Send(const std::optional<gfx::Rect>& rect);
+
+  Member<HTMLVideoElement> video_;
+  Member<Document> attached_to_;
+  // What the browser was last told; nothing yet when unset.
+  std::optional<std::optional<gfx::Rect>> sent_;
+};
+
+}  // namespace blink
