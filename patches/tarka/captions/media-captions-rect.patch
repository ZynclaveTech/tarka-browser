+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/media/tark_video_rect_reporter.h"
+
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/html/html_frame_owner_element.h"
+#include "third_party/blink/renderer/core/html/media/html_video_element.h"
+#include "third_party/blink/renderer/core/layout/layout_box.h"
+#include "third_party/blink/renderer/core/layout/layout_video.h"
+#include "third_party/blink/renderer/core/page/chrome_client.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+
+namespace blink {
+
+namespace {
+
+// `rect` (absolute, in `box`'s frame) clipped by the boxes around it that
+// clip their overflow (scrollers, overflow: hidden) and by the frame's own
+// viewport.
+PhysicalRect ClipWithinFrame(const LayoutObject& box,
+                             PhysicalRect rect,
+                             const LocalFrameView& view) {
+  for (const LayoutObject* parent = box.Parent(); parent; parent = parent->Parent()) {
+    const auto* clipper = DynamicTo<LayoutBox>(parent);
+    if (clipper && clipper->ShouldClipOverflowAlongEitherAxis()) {
+      rect.Intersect(clipper->LocalToAbsoluteRect(clipper->OverflowClipRect()));
+    }
+  }
+  rect.Intersect(PhysicalRect(PhysicalOffset(), PhysicalSize(view.Size())));
+  return rect;
+}
+
+}  // namespace
+
+TarkVideoRectReporter::TarkVideoRectReporter(HTMLVideoElement& video) : video_(&video) {}
+
+void TarkVideoRectReporter::Attach() {
+  Document& document = video_->GetDocument();
+  if (attached_to_ || !document.View()) {
+    return;
+  }
+  document.View()->RegisterForLifecycleNotifications(this);
+  attached_to_ = &document;
+  // A page that doesn't change gets no lifecycle update by itself while the
+  // video plays: ask for one, so the box is sent now.
+  document.View()->ScheduleAnimation();
+}
+
+void TarkVideoRectReporter::Detach() {
+  if (!attached_to_) {
+    return;
+  }
+  if (LocalFrameView* view = attached_to_->View()) {
+    view->UnregisterFromLifecycleNotifications(this);
+  }
+  attached_to_ = nullptr;
+  sent_.reset();
+}
+
+void TarkVideoRectReporter::DidFinishLifecycleUpdate(const LocalFrameView&) {
+  if (&video_->GetDocument() != attached_to_) {
+    Detach();
+    return;
+  }
+  // Keeps reporting once the video has played: paused (its button may stay,
+  // captions still on) and while it is moved in the page (theater mode, a
+  // floating player). Out of the page, it isn't visible.
+  Send(video_->isConnected() ? ComputeRect() : std::optional<gfx::Rect>(gfx::Rect()));
+}
+
+std::optional<gfx::Rect> TarkVideoRectReporter::ComputeRect() const {
+  LocalFrame* frame = video_->GetDocument().GetFrame();
+  auto* layout = DynamicTo<LayoutVideo>(video_->GetLayoutObject());
+  // A frame in another process (a cross-site embed) learns where it sits in
+  // the page only now and then, so its box would lag the page's scrolling:
+  // not known (the button goes to the window's corner).
+  if (!frame || !frame->View() || !frame->GetPage() ||
+      !frame->LocalFrameRoot().IsOutermostMainFrame()) {
+    return std::nullopt;
+  }
+  if (!layout) {
+    return gfx::Rect();  // display: none.
+  }
+  // The content box (the picture, not the letterboxing), clipped in its frame.
+  const PhysicalRect box = ClipWithinFrame(
+      *layout, layout->LocalToAbsoluteRect(layout->ReplacedContentRect()), *frame->View());
+  if (box.IsEmpty()) {
+    return gfx::Rect();
+  }
+  // Through same-process ancestor frames to the main frame's viewport,
+  // clipped by each iframe it sits in.
+  gfx::Rect in_viewport = frame->View()->FrameToViewport(ToEnclosingRect(box));
+  for (LocalFrame* child = frame; child && !child->IsOutermostMainFrame();) {
+    auto* parent = DynamicTo<LocalFrame>(child->Tree().Parent());
+    HTMLFrameOwnerElement* owner = child->DeprecatedLocalOwner();
+    if (!parent || !parent->View() || !owner) {
+      break;
+    }
+    if (const auto* owner_box = DynamicTo<LayoutBox>(owner->GetLayoutObject())) {
+      const PhysicalRect owner_rect = ClipWithinFrame(
+          *owner_box, owner_box->LocalToAbsoluteRect(owner_box->PhysicalContentBoxRect()),
+          *parent->View());
+      in_viewport.Intersect(parent->View()->FrameToViewport(ToEnclosingRect(owner_rect)));
+    }
+    child = parent;
+  }
+  if (in_viewport.IsEmpty()) {
+    return gfx::Rect();
+  }
+  // Layout is in physical pixels; the browser places windows in DIPs.
+  const float scale = frame->GetPage()->GetChromeClient().WindowToViewportScalar(frame, 1.0f);
+  if (scale <= 0) {
+    return std::nullopt;
+  }
+  return gfx::ToEnclosingRect(gfx::ScaleRect(gfx::RectF(in_viewport), 1.0f / scale));
+}
+
+void TarkVideoRectReporter::Send(const std::optional<gfx::Rect>& rect) {
+  if (sent_ && *sent_ == rect) {
+    return;
+  }
+  sent_ = rect;
+  video_->TarkSendVideoRect(rect);
+}
+
+void TarkVideoRectReporter::Trace(Visitor* visitor) const {
+  visitor->Trace(video_);
+  visitor->Trace(attached_to_);
+  LocalFrameView::LifecycleNotificationObserver::Trace(visitor);
+}
+
+}  // namespace blink
