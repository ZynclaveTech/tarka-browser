+// Without the captions download there is nothing to start: no guess, and
+// the decision comes as before.
+TEST_F(TarkCaptionRecognizerTest, GuessWithoutCaptionModelsWaitsForTheLock) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  base::ScopedTempDir only_detection;
+  ASSERT_TRUE(only_detection.CreateUniqueTempDir());
+  for (const char* name : {"lid.onnx", "lid_labels.txt", "silero_vad.onnx"}) {
+    ASSERT_TRUE(base::CopyFile(models_->AppendASCII(name),
+                               only_detection.GetPath().AppendASCII(name)));
+  }
+  Bind(*ort_, only_detection.GetPath(), "auto:hi");
+  Play(Clip("hi_1.wav"));
+  EXPECT_TRUE(client_.guesses.empty());
+  EXPECT_EQ(client_.languages, std::vector<std::string>{"hi"});
+}
