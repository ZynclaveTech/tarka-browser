+// Captions at once: with a hint, captions start before the decision.
+TEST_F(TarkCaptionRecognizerTest, HintedLanguageCaptionsBeforeTheLock) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort_, *models_, "auto:hi");
+  Play(Clip("hi_1.wav"));
+  ASSERT_FALSE(client_.guesses.empty());
+  EXPECT_EQ(client_.guesses.front(), "hi");
+  EXPECT_EQ(client_.languages, std::vector<std::string>{"hi"});
+  const size_t lock = client_.At("lock:hi");
+  EXPECT_LT(std::min(client_.At("draft"), client_.At("final")), lock);
+  EXPECT_FALSE(client_.error);
+}
+
+// A wrong hint is replaced, and the right language's captions start again
+// from the clip's first words.
+TEST_F(TarkCaptionRecognizerTest, WrongHintIsReplacedFromTheFirstWord) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort_, *models_, "auto:ta");
+  Play(Clip("hi_1.wav"));
+  ASSERT_FALSE(client_.guesses.empty());
+  EXPECT_EQ(client_.guesses.front(), "ta");
+  EXPECT_EQ(client_.languages, std::vector<std::string>{"hi"});
+  const size_t hindi = std::min(client_.At("guess:hi"), client_.At("lock:hi"));
+  const std::string ko_ek = "\xE0\xA4\x95\xE0\xA5\x8B \xE0\xA4\x8F\xE0\xA4\x95";
+  size_t finals_before = 0;
+  for (size_t i = 0; i < hindi; ++i) {
+    finals_before += client_.log[i] == "final";
+  }
+  ASSERT_GT(client_.finals.size(), finals_before);
+  EXPECT_NE(client_.finals[finals_before].find(ko_ek), std::string::npos)
+      << client_.finals[finals_before];
+}
+
+// lid/hi_1.wav is sure of itself within 2 s; not every clip is (hi_1.wav
