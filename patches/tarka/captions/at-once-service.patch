+TEST_F(TarkCaptionRecognizerTest, DetectorGuessArrivesBeforeTheLock) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort_, *models_, "auto");
+  Play(Clip("lid/hi_1.wav"));
+  EXPECT_LT(client_.At("guess:hi"), client_.At("lock:hi"));
+  EXPECT_LT(client_.At("lock:hi"), client_.log.size());
+}
+
+// An Apple guess taps at once; the decision agreeing keeps the same tap,
+// with no audio sent twice.
+TEST_F(TarkCaptionRecognizerTest, AppleGuessTapsBeforeTheLock) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort_, *models_, "auto");
