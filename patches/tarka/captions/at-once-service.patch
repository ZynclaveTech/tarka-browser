+// Review fix: auto-detect again on the language already captioned (a new
+// video starting on the tab's last lock) keeps the shared speech model
+// loaded instead of unloading and loading it again.
+TEST_F(TarkCaptionRecognizerTest, HintAfterTheSameLanguageKeepsTheModel) {
+  if (!Files()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+  }
+  Bind(*ort_, *models_, "hi");
+  std::vector<float> clip = Clip("hi_1.wav");
+  clip.resize(16000);
+  Send(clip);
+  env_.RunUntilIdle();
+  const int loads = tark_captions::CaptionEngine::ModelLoadsForTesting();
+  recognizer_->OnLanguageChanged("auto:hi");
+  env_.RunUntilIdle();
+  EXPECT_EQ(tark_captions::CaptionEngine::ModelLoadsForTesting(), loads);
+  EXPECT_FALSE(client_.error);
+}
