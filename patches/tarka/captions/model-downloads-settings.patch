+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview 'settings-tark-live-captions-page' (Tark, D4 Phase 4):
+ * chrome://settings/liveCaptions. The caption and translation models on
+ * this Mac (download, cancel, remove) and the remembered caption choices.
+ */
+
+import '//resources/cr_elements/cr_button/cr_button.js';
+import '//resources/cr_elements/cr_icon/cr_icon.js';
+import '//resources/cr_elements/icons.html.js';
+import '../settings_page/settings_subpage.js';
+
+import {I18nMixinLit} from '//resources/cr_elements/i18n_mixin_lit.js';
+import {WebUiListenerMixinLit} from '//resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from '//resources/js/cr.js';
+import {CrLitElement} from '//resources/lit/v3_0/lit.rollup.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import {getCss} from './tark_live_captions_page.css.js';
+import {getHtml} from './tark_live_captions_page.html.js';
+
+export interface TarkCaptionModel {
+  id: string;
+  sizeMb: number;
+  doneMb: number;
+  state: 'checking'|'missing'|'downloading'|'ready'|'inUse'|'failed';
+}
+
+interface TarkCaptionModels {
+  models: TarkCaptionModel[];
+  usedMb: number;
+}
+
+interface Option {
+  value: string;
+  name: string;
+}
+
+const SettingsTarkLiveCaptionsPageElementBase =
+    SettingsViewMixinLit(WebUiListenerMixinLit(I18nMixinLit(CrLitElement)));
+
+export class SettingsTarkLiveCaptionsPageElement extends
+    SettingsTarkLiveCaptionsPageElementBase {
+  static get is() {
+    return 'settings-tark-live-captions-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      models_: {type: Array},
+      usedMb_: {type: Number},
+      showIn_: {type: String},
+      translateTo_: {type: String},
+    };
+  }
+
+  protected accessor models_: TarkCaptionModel[] = [];
+  protected accessor usedMb_: number = 0;
+  protected accessor showIn_: string = '';
+  protected accessor translateTo_: string = 'en';
+
+  protected showInOptions_: Option[] = [
+    {value: '', name: loadTimeData.getString('tarkCaptionsOwnScript')},
+    {value: 'latn', name: loadTimeData.getString('tarkCaptionsEnglishLetters')},
+    {value: 'hi', name: loadTimeData.getString('tarkCaptionsDevanagari')},
+    {value: 'ta', name: loadTimeData.getString('tarkCaptionsTamilScript')},
+    {value: 'bn', name: loadTimeData.getString('tarkCaptionsBengaliScript')},
+  ];
+  protected translateToOptions_: Option[] = [
+    {value: 'en', name: loadTimeData.getString('tarkCaptionsEnglish')},
+    {value: 'hi', name: loadTimeData.getString('tarkCaptionsHindi')},
+    {value: 'ta', name: loadTimeData.getString('tarkCaptionsTamil')},
+    {value: 'bn', name: loadTimeData.getString('tarkCaptionsBengali')},
+  ];
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'tark-caption-models-changed',
+        (models: TarkCaptionModels) => this.setModels_(models));
+    sendWithPromise<TarkCaptionModels>('getTarkCaptionModels')
+        .then(models => this.setModels_(models));
+    sendWithPromise<{showIn: string, translateTo: string}>('getTarkCaptionChoices')
+        .then(choices => {
+          this.showIn_ = choices.showIn;
+          this.translateTo_ = choices.translateTo;
+        });
+  }
+
+  private setModels_(models: TarkCaptionModels) {
+    this.models_ = models.models;
+    this.usedMb_ = models.usedMb;
+  }
+
+  protected titleOf_(id: string): string {
+    switch (id) {
+      case 'captions':
+        return this.i18n('tarkLiveCaptionsCaptions');
+      case 'to_english':
+        return this.i18n('tarkLiveCaptionsToEnglish');
+      default:
+        return this.i18n('tarkLiveCaptionsFromEnglish');
+    }
+  }
+
+  protected detailOf_(model: TarkCaptionModel): string {
+    if (model.state === 'failed') {
+      return this.i18n('tarkLiveCaptionsFailed');
+    }
+    if (model.state === 'downloading') {
+      return this.i18n(
+          'tarkLiveCaptionsProgress', String(model.doneMb), String(model.sizeMb));
+    }
+    const detail = model.id === 'captions' ?
+        this.i18n('tarkLiveCaptionsCaptionsDetail') :
+        model.id === 'to_english' ? this.i18n('tarkLiveCaptionsToEnglishDetail') :
+                                    this.i18n('tarkLiveCaptionsFromEnglishDetail');
+    return `${detail} · ${model.sizeMb} MB`;
+  }
+
+  private modelIdOf_(e: Event): string {
+    return (e.currentTarget as HTMLElement).dataset['modelId']!;
+  }
+
+  protected onDownloadClick_(e: Event) {
+    chrome.send('downloadTarkCaptionModel', [this.modelIdOf_(e)]);
+  }
+
+  protected onCancelClick_(e: Event) {
+    chrome.send('cancelTarkCaptionModel', [this.modelIdOf_(e)]);
+  }
+
+  protected onRemoveClick_(e: Event) {
+    chrome.send('removeTarkCaptionModel', [this.modelIdOf_(e)]);
+  }
+
+  protected onShowInChange_(e: Event) {
+    this.showIn_ = (e.target as HTMLSelectElement).value;
+    chrome.send('setTarkCaptionShowIn', [this.showIn_]);
+  }
+
+  protected onTranslateToChange_(e: Event) {
+    this.translateTo_ = (e.target as HTMLSelectElement).value;
+    chrome.send('setTarkCaptionTranslateTo', [this.translateTo_]);
+  }
+
+  // SettingsViewMixin implementation.
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-tark-live-captions-page': SettingsTarkLiveCaptionsPageElement;
+  }
+}
+
+customElements.define(
+    SettingsTarkLiveCaptionsPageElement.is, SettingsTarkLiveCaptionsPageElement);
