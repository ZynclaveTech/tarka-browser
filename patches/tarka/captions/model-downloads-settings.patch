+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/tark_live_captions_handler.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/tark_captions/caption_models.h"
+#include "components/tark_captions/caption_choices.h"
+#include "components/tark_captions/model_manifest.h"
+#include "content/public/browser/web_ui.h"
+
+namespace settings {
+namespace {
+
+using State = tark_captions::CaptionModelStore::State;
+
+std::optional<tark_captions::ModelUnit> UnitFromId(const base::ListValue& args, size_t index) {
+  if (args.size() <= index || !args[index].is_string()) {
+    return std::nullopt;
+  }
+  for (const tark_captions::ModelUnitInfo& info : tark_captions::ModelManifest()) {
+    if (args[index].GetString() == info.id) {
+      return info.unit;
+    }
+  }
+  return std::nullopt;
+}
+
+const char* StateName(const tark_captions::CaptionModelStore& store,
+                      tark_captions::ModelUnit unit) {
+  switch (store.status(unit).state) {
+    case State::kChecking:
+      return "checking";
+    case State::kMissing:
+      return "missing";
+    case State::kDownloading:
+      return "downloading";
+    case State::kReady:
+      return store.in_use(unit) ? "inUse" : "ready";
+    case State::kFailed:
+      return "failed";
+  }
+}
+
+int Megabytes(int64_t bytes) {
+  return static_cast<int>(bytes / 1000000);
+}
+
+}  // namespace
+
+TarkLiveCaptionsHandler::TarkLiveCaptionsHandler() = default;
+TarkLiveCaptionsHandler::~TarkLiveCaptionsHandler() = default;
+
+void TarkLiveCaptionsHandler::RegisterMessages() {
+  auto add = [this](const char* name, void (TarkLiveCaptionsHandler::*method)(
+                                          const base::ListValue&)) {
+    web_ui()->RegisterMessageCallback(name, base::BindRepeating(method, base::Unretained(this)));
+  };
+  add("getTarkCaptionModels", &TarkLiveCaptionsHandler::HandleGetModels);
+  add("downloadTarkCaptionModel", &TarkLiveCaptionsHandler::HandleDownload);
+  add("cancelTarkCaptionModel", &TarkLiveCaptionsHandler::HandleCancel);
+  add("removeTarkCaptionModel", &TarkLiveCaptionsHandler::HandleRemove);
+  add("getTarkCaptionChoices", &TarkLiveCaptionsHandler::HandleGetChoices);
+  add("setTarkCaptionShowIn", &TarkLiveCaptionsHandler::HandleSetShowIn);
+  add("setTarkCaptionTranslateTo", &TarkLiveCaptionsHandler::HandleSetTranslateTo);
+}
+
+void TarkLiveCaptionsHandler::OnJavascriptAllowed() {
+  models_observation_.Observe(&tark_captions::TarkCaptionModels());
+}
+
+void TarkLiveCaptionsHandler::OnJavascriptDisallowed() {
+  models_observation_.Reset();
+}
+
+void TarkLiveCaptionsHandler::OnModelStatusChanged(tark_captions::ModelUnit unit) {
+  FireWebUIListener("tark-caption-models-changed", Models());
+}
+
+base::DictValue TarkLiveCaptionsHandler::Models() const {
+  const tark_captions::CaptionModelStore& store = tark_captions::TarkCaptionModels();
+  base::ListValue models;
+  for (const tark_captions::ModelUnitInfo& info : tark_captions::ModelManifest()) {
+    models.Append(base::DictValue()
+                      .Set("id", info.id)
+                      .Set("sizeMb", Megabytes(tark_captions::UnitSize(info)))
+                      .Set("doneMb", Megabytes(store.status(info.unit).done))
+                      .Set("state", StateName(store, info.unit)));
+  }
+  return base::DictValue()
+      .Set("models", std::move(models))
+      .Set("usedMb", Megabytes(store.BytesOnDisk()));
+}
+
+void TarkLiveCaptionsHandler::HandleGetModels(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], Models());
+}
+
+void TarkLiveCaptionsHandler::HandleDownload(const base::ListValue& args) {
+  if (std::optional<tark_captions::ModelUnit> unit = UnitFromId(args, 0)) {
+    tark_captions::TarkCaptionModels().Download(*unit);
+  }
+}
+
+void TarkLiveCaptionsHandler::HandleCancel(const base::ListValue& args) {
+  if (std::optional<tark_captions::ModelUnit> unit = UnitFromId(args, 0)) {
+    tark_captions::TarkCaptionModels().Cancel(*unit);
+  }
+}
+
+void TarkLiveCaptionsHandler::HandleRemove(const base::ListValue& args) {
+  if (std::optional<tark_captions::ModelUnit> unit = UnitFromId(args, 0)) {
+    tark_captions::TarkCaptionModels().Remove(*unit);
+  }
+}
+
+void TarkLiveCaptionsHandler::HandleGetChoices(const base::ListValue& args) {
+  AllowJavascript();
+  // Settings never runs off the record, so these are the remembered ones.
+  tark_captions::CaptionChoices choices(g_browser_process->local_state());
+  ResolveJavascriptCallback(args[0],
+                            base::DictValue()
+                                .Set("showIn", choices.show_in(/*off_the_record=*/false))
+                                .Set("translateTo", choices.translate_to(/*off_the_record=*/false)));
+}
+
+void TarkLiveCaptionsHandler::HandleSetShowIn(const base::ListValue& args) {
+  if (!args.empty() && args[0].is_string()) {
+    tark_captions::CaptionChoices(g_browser_process->local_state())
+        .SetShowIn(args[0].GetString(), /*off_the_record=*/false);
+  }
+}
+
+void TarkLiveCaptionsHandler::HandleSetTranslateTo(const base::ListValue& args) {
+  if (!args.empty() && args[0].is_string()) {
+    tark_captions::CaptionChoices(g_browser_process->local_state())
+        .SetTranslateTo(args[0].GetString(), /*off_the_record=*/false);
+  }
+}
+
+}  // namespace settings
