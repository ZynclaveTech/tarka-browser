+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsTarkLiveCaptionsPageElement} from './tark_live_captions_page.js';
+
+export function getHtml(this: SettingsTarkLiveCaptionsPageElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+<settings-subpage page-title="$i18n{tarkLiveCaptionsTitle}"
+    route-path="${this.routePath}">
+  <div class="cr-row first">
+    <div class="secondary">$i18n{tarkLiveCaptionsIntro}</div>
+  </div>
+  ${this.models_.map(model => html`
+    <div class="cr-row" id="${model.id}">
+      <cr-icon class="model-icon"
+          icon="${model.state === 'ready' || model.state === 'inUse' ?
+              'cr:check' : 'cr:file-download'}">
+      </cr-icon>
+      <div class="flex cr-padded-text">
+        <div>${this.titleOf_(model.id)}</div>
+        <div class="secondary ${model.state === 'failed' ? 'failed' : ''}">
+          ${this.detailOf_(model)}
+        </div>
+      </div>
+      ${model.state === 'ready' ? html`
+        <cr-button id="remove-${model.id}" data-model-id="${model.id}"
+            @click="${this.onRemoveClick_}">$i18n{tarkLiveCaptionsRemove}</cr-button>
+      ` : ''}
+      ${model.state === 'inUse' ? html`
+        <div class="secondary">$i18n{tarkLiveCaptionsInUse}</div>
+      ` : ''}
+      ${model.state === 'downloading' ? html`
+        <cr-button id="cancel-${model.id}" data-model-id="${model.id}"
+            @click="${this.onCancelClick_}">$i18n{tarkLiveCaptionsCancel}</cr-button>
+      ` : ''}
+      ${model.state === 'missing' || model.state === 'failed' ? html`
+        <cr-button id="download-${model.id}" data-model-id="${model.id}"
+            @click="${this.onDownloadClick_}">$i18n{tarkLiveCaptionsDownload}</cr-button>
+      ` : ''}
+    </div>
+  `)}
+  <div class="cr-row">
+    <div class="flex">$i18n{tarkLiveCaptionsShowIn}</div>
+    <select id="showIn" class="md-select" @change="${this.onShowInChange_}">
+      ${this.showInOptions_.map(option => html`
+        <option value="${option.value}" ?selected="${option.value === this.showIn_}">
+          ${option.name}
+        </option>`)}
+    </select>
+  </div>
+  <div class="cr-row">
+    <div class="flex">$i18n{tarkLiveCaptionsTranslateTo}</div>
+    <select id="translateTo" class="md-select" @change="${this.onTranslateToChange_}">
+      ${this.translateToOptions_.map(option => html`
+        <option value="${option.value}" ?selected="${option.value === this.translateTo_}">
+          ${option.name}
+        </option>`)}
+    </select>
+  </div>
+  <div class="cr-row">
+    <div class="secondary" id="used">
+      ${this.i18n('tarkLiveCaptionsUsed', String(this.usedMb_))}
+    </div>
+  </div>
+</settings-subpage>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
