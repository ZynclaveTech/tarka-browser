+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_LIVE_CAPTIONS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_LIVE_CAPTIONS_HANDLER_H_
+
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/tark_captions/caption_model_store.h"
+
+namespace settings {
+
+// Tark (D4 Phase 4): Settings > Accessibility > Live captions. The caption
+// and translation models on this Mac (download, cancel, remove) and the two
+// remembered choices (show their words in, translate to).
+class TarkLiveCaptionsHandler : public SettingsPageUIHandler,
+                                public tark_captions::CaptionModelStore::Observer {
+ public:
+  TarkLiveCaptionsHandler();
+  TarkLiveCaptionsHandler(const TarkLiveCaptionsHandler&) = delete;
+  TarkLiveCaptionsHandler& operator=(const TarkLiveCaptionsHandler&) = delete;
+  ~TarkLiveCaptionsHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // tark_captions::CaptionModelStore::Observer:
+  void OnModelStatusChanged(tark_captions::ModelUnit unit) override;
+
+ private:
+  void HandleGetModels(const base::ListValue& args);
+  void HandleDownload(const base::ListValue& args);
+  void HandleCancel(const base::ListValue& args);
+  void HandleRemove(const base::ListValue& args);
+  void HandleGetChoices(const base::ListValue& args);
+  void HandleSetShowIn(const base::ListValue& args);
+  void HandleSetTranslateTo(const base::ListValue& args);
+
+  // {models: [{id, sizeMb, doneMb, state}], usedMb}.
+  base::DictValue Models() const;
+
+  base::ScopedObservation<tark_captions::CaptionModelStore,
+                          tark_captions::CaptionModelStore::Observer>
+      models_observation_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_TARK_LIVE_CAPTIONS_HANDLER_H_
