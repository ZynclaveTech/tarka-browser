+// Page translation: the 22 Indian languages.
+
+namespace {
+
+constexpr IndicLanguage kIndicLanguages[] = {
+    {"as", "asm_Beng", 0x0980},  {"bn", "ben_Beng", 0x0980}, {"brx", "brx_Deva", 0x0900},
+    {"doi", "doi_Deva", 0x0900}, {"gu", "guj_Gujr", 0x0A80}, {"hi", "hin_Deva", 0x0900},
+    {"kn", "kan_Knda", 0x0C80},  {"ks", "kas_Arab", 0},      {"kok", "gom_Deva", 0x0900},
+    {"mai", "mai_Deva", 0x0900}, {"ml", "mal_Mlym", 0x0D00}, {"mni", "mni_Beng", 0x0980},
+    {"mr", "mar_Deva", 0x0900},  {"ne", "npi_Deva", 0x0900}, {"or", "ory_Orya", 0x0B00},
+    {"pa", "pan_Guru", 0x0A00},  {"sa", "san_Deva", 0x0900}, {"sat", "sat_Olck", 0},
+    {"sd", "snd_Arab", 0},       {"ta", "tam_Taml", 0x0B80}, {"te", "tel_Telu", 0x0C00},
+    {"ur", "urd_Arab", 0},
+};
+
+// IndicNLP's UnicodeIndicTransliterator between two Brahmi blocks: the
+// letter at the same offset (dandas kept); a 0 block leaves the text alone.
+std::u16string ShiftBlock(std::u16string_view text, char16_t from, char16_t to) {
+  if (from == 0 || to == 0 || from == to) {
+    return std::u16string(text);
+  }
+  std::u16string out;
+  out.reserve(text.size());
+  for (char16_t c : text) {
+    const int offset = static_cast<int>(c) - from;
+    if (offset >= 0 && offset <= 0x6F && c != u'\u0964' && c != u'\u0965') {
+      out.push_back(static_cast<char16_t>(to + offset));
+    } else {
+      out.push_back(c);
+    }
+  }
+  return out;
+}
+
+// What IndicTransToolkit feeds the model for page text in `language`:
+// spaces collapsed, tokenised, in Devanagari for a Brahmi script.
+std::string PageModelInput(std::string_view text, const IndicLanguage& language) {
+  std::u16string s = base::UTF8ToUTF16(text);
+  s = std::u16string(base::CollapseWhitespace(s, /*trim_sequences_with_line_breaks=*/true));
+  s = TokenizeIndic(s);
+  s = ShiftBlock(s, language.block, 0x0900);
+  base::ReplaceSubstringsAfterOffset(&s, 0, u" \u094D ", u"\u094D");
+  return base::UTF16ToUTF8(base::TrimWhitespace(s, base::TRIM_ALL));
+}
+
+bool IsCaptionsCode(std::string_view code) {
+  return code == "hi" || code == "ta" || code == "bn" || code == "en" || code == "es";
+}
+
+}  // namespace
+
+base::span<const IndicLanguage> IndicLanguages() {
+  return kIndicLanguages;
+}
+
+const IndicLanguage* IndicLanguageFromCode(std::string_view code) {
+  for (const IndicLanguage& language : kIndicLanguages) {
+    if (language.code == code) {
+      return &language;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<TranslationDirection> PageDirectionsFor(std::string_view source_code,
+                                                    std::string_view target_code) {
+  using D = TranslationDirection;
+  if (source_code == target_code) {
+    return {};
+  }
+  std::vector<D> directions;
+  if (IndicLanguageFromCode(source_code)) {
+    directions.push_back(D::kIndicToEnglish);
+  } else if (source_code == "es") {
+    directions.push_back(D::kSpanishToEnglish);
+  } else if (source_code != "en") {
+    return {};
+  }
+  if (IndicLanguageFromCode(target_code)) {
+    directions.push_back(D::kEnglishToIndic);
+  } else if (target_code != "en") {
+    return {};
+  }
+  return directions;
+}
+
+std::optional<std::string> TranslationEngine::TranslatePage(std::string_view text,
+                                                            std::string_view source_code,
+                                                            std::string_view target_code) {
+  if (base::TrimWhitespaceASCII(text, base::TRIM_ALL).empty() ||
+      PageDirectionsFor(source_code, target_code).empty()) {
+    return std::string();
+  }
+  const std::optional<Target> captions_target = TargetFromCode(target_code);
+  if (IsCaptionsCode(source_code) && captions_target) {
+    return TranslateFrom(text, source_code, *captions_target);
+  }
+  const IndicLanguage* target = IndicLanguageFromCode(target_code);  // null: English
+  std::string english;        // the English model input for the second hop
+  if (source_code == "en") {
+    english = EnglishModelInput(text);
+  } else if (source_code == "es") {
+    std::optional<std::string> spanish = TranslateFrom(text, "es", Target::kEnglish);
+    if (!spanish || spanish->empty()) {
+      return std::nullopt;
+    }
+    english = EnglishModelInput(*spanish);
+  } else {
+    const IndicLanguage* source = IndicLanguageFromCode(source_code);
+    Direction* to_english = Get(TranslationDirection::kIndicToEnglish);
+    if (!to_english) {
+      return std::nullopt;
+    }
+    // Hindi, Tamil and Bengali keep captions' normaliser.
+    const std::optional<Language> captions_source = LanguageFromCode(source_code);
+    std::optional<std::vector<int64_t>> out_ids = to_english->Greedy(to_english->Encode(
+        source->tag, kEnglishTag,
+        captions_source ? ModelInput(text, *captions_source) : PageModelInput(text, *source)));
+    if (!out_ids) {
+      return std::nullopt;
+    }
+    english = to_english->Decode(*out_ids);
+    if (!target) {
+      return DetokenizeEnglish(english);
+    }
+  }
+  // Hindi, Tamil (its own letter mapping) and Bengali as captions write them.
+  if (const std::optional<Language> indian = LanguageFromCode(target_code)) {
+    return IntoIndian(english, *indian, nullptr, nullptr);
+  }
+  return IntoTag(english, *target);
+}
+
+std::optional<std::string> TranslationEngine::IntoTag(std::string_view model_input,
+                                                      const IndicLanguage& target) {
+  Direction* from_english = Get(TranslationDirection::kEnglishToIndic);
+  if (!from_english) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<int64_t>> out =
+      from_english->Greedy(from_english->Encode(kEnglishTag, target.tag, model_input));
+  if (!out) {
+    return std::nullopt;
+  }
+  // IndicTrans2 writes every Brahmi script in Devanagari.
+  return base::UTF16ToUTF8(DetokenizeIndic(
+      ShiftBlock(base::UTF8ToUTF16(from_english->Decode(*out)), 0x0900, target.block)));
+}
+
