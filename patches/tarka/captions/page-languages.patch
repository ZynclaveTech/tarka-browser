+// Page translation: each of the 22 Indian languages has an IndicTrans2 tag
+// and goes both ways through English.
+TEST(TranslationEngineNoRuntimeTest, EveryIndianLanguageHasATagAndDirections) {
+  using D = TranslationDirection;
+  static constexpr const char* kCodes[] = {"as", "bn",  "brx", "doi", "gu", "hi", "kn", "ks",
+                                           "kok", "mai", "ml", "mni", "mr", "ne", "or", "pa",
+                                           "sa", "sat", "sd", "ta",  "te", "ur"};
+  EXPECT_EQ(IndicLanguages().size(), 22u);
+  for (const char* code : kCodes) {
+    const IndicLanguage* language = IndicLanguageFromCode(code);
+    ASSERT_TRUE(language) << code;
+    EXPECT_EQ(language->tag.size(), 8u) << code;  // "hin_Deva"
+    EXPECT_EQ(language->tag[3], '_') << code;
+    EXPECT_EQ(PageDirectionsFor(code, "en"), (std::vector<D>{D::kIndicToEnglish})) << code;
+    EXPECT_EQ(PageDirectionsFor("en", code), (std::vector<D>{D::kEnglishToIndic})) << code;
+    EXPECT_EQ(PageDirectionsFor("es", code),
+              (std::vector<D>{D::kSpanishToEnglish, D::kEnglishToIndic}))
+        << code;
+  }
+  EXPECT_EQ(PageDirectionsFor("ml", "pa"),
+            (std::vector<D>{D::kIndicToEnglish, D::kEnglishToIndic}));
+  EXPECT_EQ(IndicLanguageFromCode("kok")->tag, "gom_Deva");
+  EXPECT_EQ(IndicLanguageFromCode("ne")->tag, "npi_Deva");
+  EXPECT_EQ(IndicLanguageFromCode("ur")->block, 0);
+  EXPECT_TRUE(PageDirectionsFor("hi", "hi").empty());
+  EXPECT_TRUE(PageDirectionsFor("fr", "en").empty());
+  EXPECT_TRUE(PageDirectionsFor("en", "fr").empty());
+  EXPECT_FALSE(IndicLanguageFromCode("fr"));
+}
+
+TEST_F(TranslationEngineTest, PageTextInCaptionsLanguagesIsTranslateFrom) {
+  for (const base::Value& v : cases_) {
