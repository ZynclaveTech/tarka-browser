+    {u'எ', "e"}, {u'ஏ', "e"},  {u'ஐ', "ai"}, {u'ஒ', "o"}, {u'ஓ', "o"}, {u'ஔ', "au"},
+};
+constexpr std::pair<char16_t, const char*> kTamilSigns[] = {
+    {u'ா', "a"}, {u'ி', "i"}, {u'ீ', "i"},  {u'ு', "u"}, {u'ூ', "u"},
