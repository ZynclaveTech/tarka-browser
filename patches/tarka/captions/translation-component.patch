+
+constexpr int kThreads = 2;
+// IndicTrans2's model_max_length: 255 tokens and </s>.
+constexpr size_t kMaxSourceTokens = 255;
+constexpr int kMaxSteps = 256;
+constexpr char kEnglishTag[] = "eng_Latn";
+
+const char* FloresTag(Language language) {
+  switch (language) {
+    case Language::kHindi:
+      return "hin_Deva";
+    case Language::kTamil:
+      return "tam_Taml";
+    case Language::kBengali:
+      return "ben_Beng";
+  }
+}
+
+std::optional<Language> IndianLanguage(Target target) {
+  switch (target) {
+    case Target::kHindi:
+      return Language::kHindi;
+    case Target::kTamil:
+      return Language::kTamil;
+    case Target::kBengali:
+      return Language::kBengali;
+    case Target::kNone:
+    case Target::kEnglish:
+      return std::nullopt;
+  }
+}
+
+std::optional<base::DictValue> ReadJsonDict(const base::FilePath& file) {
+  std::string json;
+  if (!base::ReadFileToString(file, &json)) {
+    return std::nullopt;
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*value).TakeDict();
+}
+
+}  // namespace
+
+std::optional<Target> TargetFromCode(std::string_view code) {
+  if (code.empty()) {
+    return Target::kNone;
+  }
+  if (code == "en") {
+    return Target::kEnglish;
+  }
+  if (code == "hi") {
+    return Target::kHindi;
+  }
+  if (code == "ta") {
+    return Target::kTamil;
+  }
+  if (code == "bn") {
+    return Target::kBengali;
+  }
+  return std::nullopt;
+}
+
+// One translation direction: tokenizer, vocabularies and the two models.
+class TranslationEngine::Direction {
+ public:
+  static std::unique_ptr<Direction> Load(OrtRuntime* runtime, const base::FilePath& dir) {
+    auto d = base::WrapUnique(new Direction());
+    std::optional<base::DictValue> config = ReadJsonDict(dir.Append("config.json"));
+    std::optional<base::DictValue> src = ReadJsonDict(dir.Append("dict.SRC.json"));
+    std::optional<base::DictValue> tgt = ReadJsonDict(dir.Append("dict.TGT.json"));
+    std::string spm;
+    if (!config || !src || !tgt || !base::ReadFileToString(dir.Append("model.SRC"), &spm) ||
+        !d->spm_.LoadFromSerializedProto(spm).ok()) {
+      LOG(ERROR) << "Tark translation: model files missing in " << dir;
+      return nullptr;
+    }
+    std::optional<int> layers = config->FindInt("decoder_layers");
+    std::optional<int> heads = config->FindInt("decoder_attention_heads");
+    std::optional<int> dim = config->FindInt("decoder_embed_dim");
+    std::optional<int> start = config->FindInt("decoder_start_token_id");
+    std::optional<int> eos = config->FindInt("eos_token_id");
+    if (!layers || !heads || !dim || !start || !eos || *heads <= 0) {
+      return nullptr;
+    }
+    d->layers_ = *layers;
+    d->heads_ = *heads;
+    d->head_dim_ = *dim / *heads;
+    d->start_ = *start;
+    d->eos_ = *eos;
+    std::vector<std::pair<std::string, int64_t>> src_entries;
+    for (const auto [piece, id] : *src) {
+      if (!id.is_int()) {
+        return nullptr;
+      }
+      src_entries.emplace_back(piece, id.GetInt());
+    }
+    d->src_vocab_ = base::flat_map<std::string, int64_t>(std::move(src_entries));
+    for (const auto [token, id] : *tgt) {
+      if (!id.is_int() || id.GetInt() < 0) {
+        return nullptr;
+      }
+      if (static_cast<size_t>(id.GetInt()) >= d->tgt_vocab_.size()) {
+        d->tgt_vocab_.resize(id.GetInt() + 1);
+      }
+      d->tgt_vocab_[id.GetInt()] = token;
+    }
+    auto unk = d->src_vocab_.find("<unk>");
+    auto end = d->src_vocab_.find("</s>");
+    if (unk == d->src_vocab_.end() || end == d->src_vocab_.end()) {
+      return nullptr;
+    }
+    d->unk_ = unk->second;
+    d->end_ = end->second;
+    d->encoder_ = runtime->LoadModel(dir.Append("encoder.int8.onnx"), kThreads);
+    d->decoder_ = runtime->LoadModel(dir.Append("decoder_step.int8.onnx"), kThreads);
+    if (!d->encoder_ || !d->decoder_) {
+      LOG(ERROR) << "Tark translation: models not loaded from " << dir;
+      return nullptr;
+    }
+    return d;
+  }
+
+  // The language tags, then the SentencePiece pieces of `body`; at most
+  // 255 ids, then </s>.
+  std::vector<int64_t> Encode(std::string_view src_tag,
+                              std::string_view tgt_tag,
+                              std::string_view body) const {
+    std::vector<std::string> pieces = {std::string(src_tag), std::string(tgt_tag)};
+    std::vector<std::string> body_pieces;
+    if (spm_.Encode(body, &body_pieces).ok()) {
+      pieces.insert(pieces.end(), body_pieces.begin(), body_pieces.end());
+    }
+    std::vector<int64_t> ids;
+    for (const std::string& piece : pieces) {
+      if (ids.size() == kMaxSourceTokens) {
+        break;
+      }
+      auto it = src_vocab_.find(piece);
+      ids.push_back(it == src_vocab_.end() ? unk_ : it->second);
+    }
+    ids.push_back(end_);
+    return ids;
+  }
+
+  std::optional<std::vector<int64_t>> Greedy(const std::vector<int64_t>& ids) {
+    std::vector<Tensor> encoded;
+    if (!encoder_->Run({Tensor{.name = "ids",
+                               .shape = {1, static_cast<int64_t>(ids.size())},
+                               .i64 = ids}},
+                       {"cross_mask", "cross_k", "cross_v"}, &encoded)) {
+      return std::nullopt;
+    }
+    const std::vector<int64_t> empty_cache = {layers_, 1, heads_, 0, head_dim_};
+    std::vector<Tensor> inputs = {
+        Tensor{.name = "token", .shape = {1, 1}, .i64 = {start_}},
+        Tensor{.name = "step", .shape = {}, .i64 = {0}},
+        Tensor{.name = "past_k", .shape = empty_cache},
+        Tensor{.name = "past_v", .shape = empty_cache},
+        std::move(encoded[1]),
+        std::move(encoded[2]),
+        std::move(encoded[0]),
+    };
+    std::vector<int64_t> out;
+    std::vector<Tensor> step_out;
+    for (int step = 0; step < kMaxSteps; ++step) {
+      inputs[1].i64[0] = step;
+      if (!decoder_->Run(inputs, {"logits", "new_k", "new_v"}, &step_out) ||
+          step_out[0].f32.empty()) {
+        return std::nullopt;
+      }
+      const std::vector<float>& logits = step_out[0].f32;
+      const int64_t token = std::max_element(logits.begin(), logits.end()) - logits.begin();
+      if (token == eos_) {
+        break;
+      }
+      out.push_back(token);
+      inputs[0].i64[0] = token;
+      inputs[2] = std::move(step_out[1]);
+      inputs[2].name = "past_k";
+      inputs[3] = std::move(step_out[2]);
+      inputs[3].name = "past_v";
+    }
+    return out;
+  }
+
+  // Target tokens joined, without <s>, <pad>, </s>, <unk>; ▁ is a space.
+  std::string Decode(const std::vector<int64_t>& ids) const {
+    std::string text;
+    for (int64_t id : ids) {
+      if (id < 0 || static_cast<size_t>(id) >= tgt_vocab_.size()) {
+        continue;
+      }
+      const std::string& token = tgt_vocab_[id];
+      if (token.empty() || token == "<s>" || token == "<pad>" || token == "</s>" ||
+          token == "<unk>") {
+        continue;
+      }
+      text += token;
+    }
+    base::ReplaceSubstringsAfterOffset(&text, 0, "\xE2\x96\x81", " ");
+    return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  }
+
+ private:
+  Direction() = default;
+
+  std::unique_ptr<OrtModel> encoder_;
+  std::unique_ptr<OrtModel> decoder_;
+  sentencepiece::SentencePieceProcessor spm_;
+  base::flat_map<std::string, int64_t> src_vocab_;
+  std::vector<std::string> tgt_vocab_;
+  int64_t layers_ = 0;
+  int64_t heads_ = 0;
+  int64_t head_dim_ = 0;
+  int64_t start_ = 0;
+  int64_t eos_ = 0;
+  int64_t unk_ = 0;
+  int64_t end_ = 0;
+};
+
+// static
+std::unique_ptr<TranslationEngine> TranslationEngine::Create(const base::FilePath& models_dir,
+                                                             const base::FilePath& ort_dylib) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_dylib);
+  if (!runtime) {
+    return nullptr;
+  }
+  return base::WrapUnique(new TranslationEngine(std::move(runtime), models_dir));
+}
+
+TranslationEngine::TranslationEngine(std::unique_ptr<OrtRuntime> runtime,
+                                     const base::FilePath& models_dir)
+    : runtime_(std::move(runtime)), models_dir_(models_dir) {}
+
+TranslationEngine::~TranslationEngine() {
+  // The models before the runtime that loaded them.
+  to_english_.reset();
+  from_english_.reset();
+}
+
+TranslationEngine::Direction* TranslationEngine::Get(bool to_english) {
+  std::unique_ptr<Direction>& direction = to_english ? to_english_ : from_english_;
+  if (!direction) {
+    // Not remembered when missing: the models may arrive later.
+    direction = Direction::Load(runtime_.get(),
+                                models_dir_.Append(to_english ? "it2_indic_en" : "it2_en_indic"));
+  }
+  return direction.get();
+}
+
+std::optional<std::string> TranslationEngine::Translate(std::string_view caption,
+                                                        Language source,
+                                                        Target target,
+                                                        TranslationTrace* trace) {
+  const std::optional<Language> indian_target = IndianLanguage(target);
+  if (target == Target::kNone || indian_target == source) {
+    return std::string();
+  }
+  Direction* to_english = Get(/*to_english=*/true);
+  if (!to_english) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> src_ids =
+      to_english->Encode(FloresTag(source), kEnglishTag, ModelInput(caption, source));
+  std::optional<std::vector<int64_t>> out_ids = to_english->Greedy(src_ids);
+  if (!out_ids) {
+    return std::nullopt;
+  }
+  if (trace) {
+    trace->src_ids = src_ids;
+    trace->out_ids = *out_ids;
+  }
+  const std::string english_tokens = to_english->Decode(*out_ids);
+  if (!indian_target) {
+    return DetokenizeEnglish(english_tokens);
+  }
+  // Indian to Indian: the English model tokens go straight into the second
+  // hop.
+  Direction* from_english = Get(/*to_english=*/false);
+  if (!from_english) {
+    return std::nullopt;
+  }
+  const std::vector<int64_t> pivot_src =
+      from_english->Encode(kEnglishTag, FloresTag(*indian_target), english_tokens);
+  std::optional<std::vector<int64_t>> pivot_out = from_english->Greedy(pivot_src);
+  if (!pivot_out) {
+    return std::nullopt;
+  }
+  if (trace) {
+    trace->pivot_src_ids = pivot_src;
+    trace->pivot_out_ids = *pivot_out;
+  }
+  // IndicTrans2 writes every Indian language in Devanagari.
+  return base::UTF16ToUTF8(DetokenizeIndic(ConvertScript(
+      base::UTF8ToUTF16(from_english->Decode(*pivot_out)), Script::kDevanagari,
+      ScriptOf(*indian_target))));
+}
+
+int TranslationEngine::LoadedDirectionsForTesting() const {
+  return (to_english_ ? 1 : 0) + (from_english_ ? 1 : 0);
+}
