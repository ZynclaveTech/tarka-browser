+namespace tark_captions {
+namespace {
+
+// The golden cases (utils/indictrans_export.py golden): real caption
+// hypotheses through IndicTransToolkit's IndicProcessor.
+base::ListValue Cases() {
+  std::optional<base::FilePath> testdata = test::TestDataDir();
+  return testdata ? test::MtGoldenCases(*testdata) : base::ListValue();
+}
+
+Language LanguageOf(const base::DictValue& c) {
+  return *LanguageFromCode(*c.FindString("lang"));
+}
+
+TEST(IndicTextTest, NormalizeMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(base::UTF16ToUTF8(NormalizeIndic(base::UTF8ToUTF16(*c.FindString("caption")),
+                                               LanguageOf(c))),
+              *c.FindString("normalized"))
+        << *c.FindString("id");
+  }
+}
+
+TEST(IndicTextTest, ModelInputMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(ModelInput(*c.FindString("caption"), LanguageOf(c)), *c.FindString("model_input"))
+        << *c.FindString("id");
+  }
+}
+
+TEST(IndicTextTest, EnglishDetokenizeMatchesReference) {
+  base::ListValue cases = Cases();
+  if (cases.empty()) {
+    GTEST_SKIP() << "set TARK_CAPTIONS_TESTDATA";
+  }
+  for (const base::Value& v : cases) {
+    const base::DictValue& c = v.GetDict();
+    EXPECT_EQ(DetokenizeEnglish(*c.FindString("english_tokens")), *c.FindString("english"))
+        << *c.FindString("id");
+  }
+}
+
+// Tamil has no voiced or aspirated plosives: ग and ड become க and ட.
+TEST(IndicTextTest, TamilTargetUsesUnvoicedPlosives) {
+  EXPECT_EQ(ConvertScript(u"गड", Script::kDevanagari, Script::kTamil), u"கட");
+}
+
+TEST(IndicTextTest, DandasUnchanged) {
+  EXPECT_EQ(ConvertScript(u"क।", Script::kDevanagari, Script::kBengali), u"ক।");
+}
+
+TEST(IndicTextTest, ScriptsOfLanguages) {
+  EXPECT_EQ(ScriptOf(Language::kHindi), Script::kDevanagari);
+  EXPECT_EQ(ScriptOf(Language::kTamil), Script::kTamil);
+  EXPECT_EQ(ScriptOf(Language::kBengali), Script::kBengali);
+}
