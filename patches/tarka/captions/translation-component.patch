+    {u'ধ', "dh"}, {u'ন', "n"},  {u'প', "p"},  {u'ফ', "ph"}, {u'ব', "b"},  {u'ভ', "bh"},
+    {u'ম', "m"},  {u'য', "j"},  {u'র', "r"},  {u'ল', "l"},  {u'শ', "sh"}, {u'ষ', "sh"},
