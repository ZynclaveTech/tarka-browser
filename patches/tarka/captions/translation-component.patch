+#ifndef COMPONENTS_TARK_CAPTIONS_INDIC_TEXT_H_
+#define COMPONENTS_TARK_CAPTIONS_INDIC_TEXT_H_
+
+#include <string>
+#include <string_view>
+
+#include "components/tark_captions/asr_model.h"
+
+namespace tark_captions {
+
+// The text steps around the translation model (D4 Phase 2): ports of the
+// parts of IndicTransToolkit's IndicProcessor (IndicNLP's normaliser,
+// tokeniser and script converter; sacremoses' English detokeniser) that
+// caption text reaches. Captions are Indian letters and spaces, so the
+// processor's URL, number and punctuation handling is not ported.
+
+enum class Script { kDevanagari, kTamil, kBengali, kLatin };
+
+Script ScriptOf(Language language);
+
+// IndicNLP's BaseNormalizer and the Devanagari, Tamil or Bengali normaliser
+// with IndicTransToolkit's settings (nuktas kept, nasals and chandras
+// untouched). Its colon-to-visarga step never matches (its pattern is
+// double-escaped upstream) and is left out.
+std::u16string NormalizeIndic(std::u16string_view text, Language language);
+
+// IndicNLP's UnicodeIndicTransliterator between Indian scripts: the letter
+// at the same offset in the other script's Unicode block (dandas kept;
+// Tamil, which lacks voiced and aspirated plosives, gets the unvoiced one).
+// Text is returned unchanged when either script is Latin.
+std::u16string ConvertScript(std::u16string_view text, Script from, Script to);
+
+// IndicNLP's trivial_tokenize / trivial_detokenize for Brahmi scripts.
+std::u16string TokenizeIndic(std::u16string_view text);
+std::u16string DetokenizeIndic(std::u16string_view text);
+
+// sacremoses' MosesDetokenizer(lang="en") on space-separated tokens.
+std::string DetokenizeEnglish(std::string_view tokens);
+
+// What IndicTransToolkit feeds the model for a caption in `language`
+// (without the two language tags): normalised, tokenised and written in
+// Devanagari (IndicTrans2's script unification).
+std::string ModelInput(std::string_view caption, Language language);
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_INDIC_TEXT_H_
