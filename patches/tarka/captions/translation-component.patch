+// One script's letters. Keys are code points; values are Latin spellings.
+struct Table {
+  char16_t first;  // The script's Unicode block.
+  char16_t last;
+  const char* inherent;
+  bool drops_inherent;  // Hindi and Bengali.
+  char16_t virama;
+  char16_t nukta;  // 0 if none.
