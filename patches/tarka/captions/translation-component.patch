+};
+
+// Everyday spellings without diacritics ("show their words in English
+// letters", spec D4).
+TEST(RomanizeTest, RomanizesEverydaySpellings) {
+  const Example kExamples[] = {
+      {Language::kHindi, "नमस्ते", "namaste"},
+      {Language::kHindi, "भारत", "bharat"},
+      {Language::kHindi, "कमला", "kamla"},
+      {Language::kHindi, "ज़िंदगी", "zindagi"},
+      {Language::kHindi, "क्या", "kya"},
+      {Language::kHindi, "लंबी", "lambi"},
+      {Language::kHindi, "आप कैसे हैं", "aap kaise hain"},
+      {Language::kTamil, "தமிழ்", "tamizh"},
+      {Language::kTamil, "வணக்கம்", "vanakkam"},
+      {Language::kTamil, "நன்றி", "nandri"},
+      {Language::kTamil, "சென்னை", "chennai"},
+      {Language::kTamil, "மற்றும்", "matrum"},
+      {Language::kTamil, "விளங்கும்", "vilangum"},
+      {Language::kBengali, "বাংলা", "bangla"},
+      {Language::kBengali, "আমি", "ami"},
+      {Language::kBengali, "কলকাতা", "kolkata"},
+      {Language::kBengali, "ধন্যবাদ", "dhonyobad"},
+  };
+  for (const Example& e : kExamples) {
+    EXPECT_EQ(base::UTF16ToUTF8(Romanize(base::UTF8ToUTF16(e.text), e.language)), e.latin)
+        << e.text;
+  }
+}
+
+TEST(RomanizeTest, LeavesOtherTextAlone) {
+  EXPECT_EQ(Romanize(u"OK 42", Language::kHindi), u"OK 42");
+}
+
+}  // namespace
