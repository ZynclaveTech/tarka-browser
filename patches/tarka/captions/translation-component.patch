+namespace tark_captions {
+namespace {
+
+std::vector<int64_t> Ids(const base::ListValue* list) {
+  std::vector<int64_t> ids;
+  for (const base::Value& v : *list) {
+    ids.push_back(v.GetInt());
+  }
+  return ids;
+}
+
+Target TargetOf(const std::string& code) {
+  return *TargetFromCode(code);
+}
+
+class TranslationEngineTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    std::optional<base::FilePath> ort = test::OrtPath();
+    std::optional<base::FilePath> models = test::ModelsDir();
+    std::optional<base::FilePath> testdata = test::TestDataDir();
+    if (!ort || !models || !testdata) {
+      GTEST_SKIP() << "set TARK_CAPTIONS_ORT, TARK_CAPTIONS_MODELS and TARK_CAPTIONS_TESTDATA";
+    }
+    ort_ = *ort;
+    models_ = *models;
+    cases_ = test::MtGoldenCases(*testdata);
+    ASSERT_FALSE(cases_.empty());
+    engine_ = TranslationEngine::Create(models_, ort_);
+    ASSERT_TRUE(engine_);
+  }
+
+  base::FilePath ort_;
+  base::FilePath models_;
+  base::ListValue cases_;
+  std::unique_ptr<TranslationEngine> engine_;
+};
+
+TEST_F(TranslationEngineTest, TokenIdsMatchReference) {
+  for (const base::Value& v : cases_) {
+    const base::DictValue& c = v.GetDict();
+    TranslationTrace trace;
+    engine_->Translate(*c.FindString("caption"), *LanguageFromCode(*c.FindString("lang")),
+                       Target::kEnglish, &trace);
+    EXPECT_EQ(trace.src_ids, Ids(c.FindList("src_ids"))) << *c.FindString("id");
+  }
+}
+
+// Same ONNX Runtime (1.31.0) and int8 files as the reference: exact.
+TEST_F(TranslationEngineTest, TranslatesLikeReference) {
+  for (const base::Value& v : cases_) {
+    const base::DictValue& c = v.GetDict();
+    TranslationTrace trace;
+    std::optional<std::string> english = engine_->Translate(
+        *c.FindString("caption"), *LanguageFromCode(*c.FindString("lang")), Target::kEnglish,
+        &trace);
+    EXPECT_EQ(trace.out_ids, Ids(c.FindList("out_ids"))) << *c.FindString("id");
+    EXPECT_EQ(english, *c.FindString("english")) << *c.FindString("id");
+  }
+}
+
+// Indian to Indian goes through English; the second hop takes the English
+// model tokens as they are (the reference detokenises and re-tokenises).
+TEST_F(TranslationEngineTest, PivotMatchesReference) {
+  for (const base::Value& v : cases_) {
+    const base::DictValue& c = v.GetDict();
+    for (const auto [code, pivot] : *c.FindDict("pivot")) {
+      TranslationTrace trace;
+      std::optional<std::string> text = engine_->Translate(
+          *c.FindString("caption"), *LanguageFromCode(*c.FindString("lang")), TargetOf(code),
+          &trace);
+      EXPECT_EQ(trace.pivot_src_ids, Ids(pivot.GetDict().FindList("src_ids")))
+          << *c.FindString("id") << " -> " << code;
+      EXPECT_EQ(text, *pivot.GetDict().FindString("text")) << *c.FindString("id") << " -> " << code;
+    }
+  }
+}
+
+TEST_F(TranslationEngineTest, SameLanguageIsNotTranslated) {
+  std::unique_ptr<TranslationEngine> engine = TranslationEngine::Create(models_, ort_);
+  EXPECT_EQ(engine->Translate("नमस्ते", Language::kHindi, Target::kHindi), "");
+  EXPECT_EQ(engine->Translate("नमस्ते", Language::kHindi, Target::kNone), "");
+  EXPECT_EQ(engine->LoadedDirectionsForTesting(), 0);
+}
+
+TEST_F(TranslationEngineTest, LongInputIsTruncated) {
+  std::string caption;
+  for (int i = 0; i < 400; ++i) {
+    caption += "नमस्ते ";
+  }
+  TranslationTrace trace;
+  EXPECT_TRUE(engine_->Translate(caption, Language::kHindi, Target::kEnglish, &trace));
+  EXPECT_LE(trace.src_ids.size(), 256u);
+  EXPECT_LE(trace.out_ids.size(), 256u);
+}
+
+TEST_F(TranslationEngineTest, MissingModelsFail) {
+  base::ScopedTempDir empty;
+  ASSERT_TRUE(empty.CreateUniqueTempDir());
+  std::unique_ptr<TranslationEngine> engine = TranslationEngine::Create(empty.GetPath(), ort_);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(engine->Translate("नमस्ते", Language::kHindi, Target::kEnglish), std::nullopt);
+}
+
+TEST_F(TranslationEngineTest, TruncatedModelFails) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath from = models_.Append("it2_indic_en");
+  const base::FilePath to = dir.GetPath().Append("it2_indic_en");
+  ASSERT_TRUE(base::CopyDirectory(from, dir.GetPath(), /*recursive=*/true));
+  std::string encoder;
+  ASSERT_TRUE(base::ReadFileToStringWithMaxSize(from.Append("encoder.int8.onnx"), &encoder,
+                                                1 << 20) ||
+              encoder.size() == (1u << 20));
+  ASSERT_TRUE(base::WriteFile(to.Append("encoder.int8.onnx"), encoder.substr(0, 1 << 20)));
+  std::unique_ptr<TranslationEngine> engine = TranslationEngine::Create(dir.GetPath(), ort_);
+  ASSERT_TRUE(engine);
+  EXPECT_EQ(engine->Translate("नमस्ते", Language::kHindi, Target::kEnglish), std::nullopt);
+}
+
+TEST(TranslationEngineNoRuntimeTest, CreateFailsWithoutRuntime) {
+  EXPECT_FALSE(TranslationEngine::Create(base::FilePath("/nonexistent"),
+                                         base::FilePath("/nonexistent/libonnxruntime.dylib")));
+}
+
+TEST(TranslationEngineNoRuntimeTest, TargetCodes) {
+  EXPECT_EQ(TargetFromCode(""), Target::kNone);
+  EXPECT_EQ(TargetFromCode("en"), Target::kEnglish);
+  EXPECT_EQ(TargetFromCode("ta"), Target::kTamil);
+  EXPECT_EQ(TargetFromCode("fr"), std::nullopt);
+}
