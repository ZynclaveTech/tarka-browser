+// One loaded speech model (ONNX Runtime and IndicConformer) for a models
+// folder, shared by every engine in the process that uses it. Loading,
+// lookup and release all happen under one lock, so an engine never picks up
+// a model that is being unloaded.
+class SharedAsr {
+ public:
+  // Null if ONNX Runtime or the model is missing.
+  static SharedAsr* Acquire(const base::FilePath& models_dir, const base::FilePath& ort_dylib) {
+    base::AutoLock lock(RegistryLock());
+    auto key = std::make_pair(models_dir, ort_dylib);
+    auto it = Registry().find(key);
+    if (it != Registry().end()) {
+      ++it->second->users_;
+      return it->second.get();
+    }
+    std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_dylib);
+    if (!runtime) {
+      return nullptr;
+    }
+    std::unique_ptr<AsrModel> asr = AsrModel::Load(runtime.get(), models_dir, kThreads);
+    if (!asr) {
+      return nullptr;
+    }
+    auto shared = base::WrapUnique(new SharedAsr(key, std::move(runtime), std::move(asr)));
+    SharedAsr* raw = shared.get();
+    Registry().emplace(key, std::move(shared));
+    return raw;
+  }
+
+  static void Release(SharedAsr* shared) {
+    base::AutoLock lock(RegistryLock());
+    if (--shared->users_ == 0) {
+      Registry().erase(shared->key_);
+    }
+  }
+
+  static int Count() {
+    base::AutoLock lock(RegistryLock());
+    return static_cast<int>(Registry().size());
+  }
+
+  SharedAsr(const SharedAsr&) = delete;
+  SharedAsr& operator=(const SharedAsr&) = delete;
+  ~SharedAsr() {
+    // The model before the runtime that loaded it.
+    asr_.reset();
+  }
+
+  // Engines run on their own sequences and the runtime and the model's
+  // front end are not made for concurrent use, so their uses take turns.
+  std::unique_ptr<Vad> LoadVad(const base::FilePath& models_dir) {
+    base::AutoLock lock(lock_);
+    return Vad::Load(runtime_.get(), models_dir);
+  }
+  std::string Decode(base::span<const float> pcm16k, Language language) {
+    base::AutoLock lock(lock_);
+    return asr_->Decode(pcm16k, language);
+  }
+
+ private:
+  using Key = std::pair<base::FilePath, base::FilePath>;
+
+  static base::Lock& RegistryLock() {
+    static base::NoDestructor<base::Lock> lock;
+    return *lock;
+  }
+  static std::map<Key, std::unique_ptr<SharedAsr>>& Registry() {
+    static base::NoDestructor<std::map<Key, std::unique_ptr<SharedAsr>>> registry;
+    return *registry;
+  }
+
+  SharedAsr(Key key, std::unique_ptr<OrtRuntime> runtime, std::unique_ptr<AsrModel> asr)
+      : key_(std::move(key)), runtime_(std::move(runtime)), asr_(std::move(asr)) {}
+
+  const Key key_;
+  int users_ = 1;  // Guarded by RegistryLock().
+  std::unique_ptr<OrtRuntime> runtime_;
+  std::unique_ptr<AsrModel> asr_;
+  base::Lock lock_;
+};
