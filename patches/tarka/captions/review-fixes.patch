+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/caption_box_view.h"
+
+#include <memory>
+
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/styled_label.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+class TarkCaptionBoxViewTest : public views::ViewsTestBase {
+ protected:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    box_ = widget_->SetContentsView(std::make_unique<TarkCaptionBoxView>());
+    widget_->SetBounds(gfx::Rect(0, 0, 500, 200));
+  }
+  void TearDown() override {
+    widget_.reset();
+    views::ViewsTestBase::TearDown();
+  }
+
+  // The colours the box's text is drawn in, one per run of text.
+  std::vector<SkColor> Colors() {
+    views::test::RunScheduledLayout(box_->label_for_testing());
+    std::vector<SkColor> colors;
+    for (views::View* child : box_->label_for_testing()->children()) {
+      if (auto* label = views::AsViewClass<views::Label>(child)) {
+        colors.push_back(label->GetEnabledColor());
+      }
+    }
+    return colors;
+  }
+
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<TarkCaptionBoxView> box_ = nullptr;
+};
+
+TEST_F(TarkCaptionBoxViewTest, DraftFaded) {
+  box_->SetCaption({u"one two", u"three"}, u"");
+  EXPECT_EQ(Colors(), (std::vector<SkColor>{TarkCaptionBoxView::kFinalColor,
+                                            TarkCaptionBoxView::kDraftColor}));
+}
+
+// The final usually repeats the last draft word for word: it must turn white.
+TEST_F(TarkCaptionBoxViewTest, FinalMatchingTheDraftIsNotFaded) {
+  box_->SetCaption({u"", u"one two"}, u"");
+  box_->SetCaption({u"one two", u""}, u"");
+  EXPECT_EQ(Colors(), (std::vector<SkColor>{TarkCaptionBoxView::kFinalColor}));
+}
+
+TEST_F(TarkCaptionBoxViewTest, HiddenWhenEmpty) {
+  box_->SetCaption({u"one", u""}, u"");
+  EXPECT_TRUE(box_->GetVisible());
+  box_->SetCaption({}, u"");
+  EXPECT_FALSE(box_->GetVisible());
+}
+
+}  // namespace
