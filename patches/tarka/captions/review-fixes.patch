+#ifndef CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_CAPTION_BOX_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_CAPTION_BOX_VIEW_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "components/tark_captions/caption_text.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace views {
+class StyledLabel;
+}  // namespace views
+
+// Tark (D4): the caption box above the pill (and the strip): the latest final
+// text in white, the draft of what is being said now faded after it, on a
+// dark translucent rounded box. Hidden when there is nothing to show.
+class TarkCaptionBoxView : public views::View {
+  METADATA_HEADER(TarkCaptionBoxView, views::View)
+
+ public:
+  static constexpr SkColor kFinalColor = SK_ColorWHITE;
+  static constexpr SkColor kDraftColor = SkColorSetARGB(0x99, 0xFF, 0xFF, 0xFF);
+
+  TarkCaptionBoxView();
+  TarkCaptionBoxView(const TarkCaptionBoxView&) = delete;
+  TarkCaptionBoxView& operator=(const TarkCaptionBoxView&) = delete;
+  ~TarkCaptionBoxView() override;
+
+  // The text's wrapping width.
+  void SetTextWidth(int width);
+  // Shows `display`, or `message` (Listening…, Captions unavailable) when it
+  // is not empty.
+  void SetCaption(const tark_captions::CaptionText::Display& display,
+                  const std::u16string& message);
+
+  views::StyledLabel* label_for_testing() { return label_; }
+
+ private:
+  raw_ptr<views::StyledLabel> label_ = nullptr;
+  int text_width_ = 420;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_CAPTION_BOX_VIEW_H_
