+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/caption_box_view.h"
+
+#include <memory>
+
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/range/range.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/styled_label.h"
+#include "ui/views/layout/box_layout.h"
+
+namespace {
+
+constexpr SkColor kBackground = SkColorSetARGB(0xCC, 0x12, 0x12, 0x14);
+
+}  // namespace
+
+TarkCaptionBoxView::TarkCaptionBoxView() {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(views::BoxLayout::Orientation::kVertical));
+  SetBackground(views::CreateRoundedRectBackground(kBackground, 10));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(8, 14)));
+  label_ = AddChildView(std::make_unique<views::StyledLabel>());
+  label_->SetDisplayedOnBackgroundColor(kBackground);
+  label_->SizeToFit(text_width_);
+  SetVisible(false);
+}
+
+TarkCaptionBoxView::~TarkCaptionBoxView() = default;
+
+void TarkCaptionBoxView::SetTextWidth(int width) {
+  text_width_ = width;
+  label_->SizeToFit(text_width_);
+  PreferredSizeChanged();
+}
+
+void TarkCaptionBoxView::SetCaption(const tark_captions::CaptionText::Display& display,
+                                    const std::u16string& message) {
+  std::u16string text;
+  size_t draft_start = 0;
+  if (!message.empty()) {
+    text = message;
+    draft_start = text.size();
+  } else {
+    text = display.committed;
+    if (!display.draft.empty()) {
+      if (!text.empty()) {
+        text += u" ";
+      }
+      draft_start = text.size();
+      text += display.draft;
+    } else {
+      draft_start = text.size();
+    }
+  }
+  SetVisible(!text.empty());
+  // StyledLabel keeps its old styles when the text is unchanged (a final
+  // usually repeats the last draft): clear it so the styles start afresh.
+  label_->SetText(std::u16string());
+  label_->SetText(text);
+  views::StyledLabel::RangeStyleInfo final_style;
+  final_style.override_color = kFinalColor;
+  views::StyledLabel::RangeStyleInfo draft_style;
+  draft_style.override_color = kDraftColor;
+  if (draft_start > 0) {
+    label_->AddStyleRange(gfx::Range(0, draft_start), final_style);
+  }
+  if (draft_start < text.size()) {
+    label_->AddStyleRange(gfx::Range(draft_start, text.size()), draft_style);
+  }
+  label_->SizeToFit(text_width_);
+  PreferredSizeChanged();
+}
+
+BEGIN_METADATA(TarkCaptionBoxView)
+END_METADATA
