+class FakeClient : public media::mojom::SpeechRecognitionRecognizerClient {
+ public:
+  void OnSpeechRecognitionRecognitionEvent(
+      const media::SpeechRecognitionResult& result,
+      OnSpeechRecognitionRecognitionEventCallback reply) override {
+    std::move(reply).Run(true);
+  }
+  void OnSpeechRecognitionStopped() override {}
+  void OnSpeechRecognitionError() override { error = true; }
+  void OnLanguageIdentificationEvent(media::mojom::LanguageIdentificationEventPtr) override {}
+
+  bool error = false;
+};
+
+// Before the models are on this Mac, pressing Captions must say captions are
+// unavailable; the client must not just be dropped (the pill would wait on
+// "Listening…" for ever).
+TEST(TarkSpeechServiceTest, MissingModelsReachTheClientAsAnError) {
+  base::test::TaskEnvironment env;
+  mojo::Remote<media::mojom::SpeechRecognitionService> service;
+  SpeechRecognitionServiceImpl impl(service.BindNewPipeAndPassReceiver());
+  service->SetSodaPaths(base::FilePath("/nonexistent/libonnxruntime.dylib"),
+                        {{"hi", base::FilePath("/nonexistent/models")}}, "hi");
+  mojo::Remote<media::mojom::SpeechRecognitionContext> context;
+  service->BindSpeechRecognitionContext(context.BindNewPipeAndPassReceiver());
+
+  FakeClient client;
+  mojo::Receiver<media::mojom::SpeechRecognitionRecognizerClient> client_receiver(&client);
+  mojo::Remote<media::mojom::SpeechRecognitionRecognizer> recognizer;
+  auto options = media::mojom::SpeechRecognitionOptions::New();
+  options->recognizer_client_type = media::mojom::RecognizerClientType::kLiveCaption;
+  options->language = "hi";
+  context->BindRecognizer(recognizer.BindNewPipeAndPassReceiver(),
+                          client_receiver.BindNewPipeAndPassRemote(), std::move(options),
+                          base::DoNothing());
+  ASSERT_TRUE(base::test::RunUntil([&] { return client.error; }));
+}
+
+}  // namespace
+}  // namespace speech
