+void SpeechRecognitionClientBrowserInterface::OnTarkCaptionsChanged(
+    bool on,
+    const std::string& language) {
+  tark_captions_tabs_ = std::max(0, tark_captions_tabs_ + (on ? 1 : -1));
+  tark_captions_language_ = language;
+  for (auto& observer : live_caption_availability_observers_) {
+    observer->SpeechRecognitionAvailabilityChanged(false);
+  }
+  NotifyLiveCaptionObserversIfNeeded();
+}
+
+void SpeechRecognitionClientBrowserInterface::OnTarkCaptionsLanguageChanged(
+    const std::string& language) {
+  tark_captions_language_ = language;
+  for (auto& observer : live_caption_availability_observers_) {
+    observer->SpeechRecognitionLanguageChanged(language);
+  }
+}
+
 void SpeechRecognitionClientBrowserInterface::
     NotifyLiveCaptionObserversIfNeeded() {
   if (live_caption_availability_observers_.empty()) {
     return;
   }
-  // Tark (D4): --tark-captions-force makes captions available everywhere
-  // until the pill decides per call.
-  if (base::CommandLine::ForCurrentProcess()->HasSwitch(kTarkCaptionsForceSwitch)) {
+  // Tark (D4): captions are Tark's call captions, available while a tab has
+  // them on. Chromium's own Live Caption is not used.
+  if (tark_captions_tabs_ > 0) {
     for (auto& observer : live_caption_availability_observers_) {
       observer->SpeechRecognitionAvailabilityChanged(true);
+      observer->SpeechRecognitionLanguageChanged(tark_captions_language_);
     }
     return;
   }
