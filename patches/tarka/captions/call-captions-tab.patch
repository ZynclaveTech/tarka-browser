+#include "chrome/browser/tark_captions/call_captions_tab_helper.h"
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/speech/chrome_speech_recognition_service.h"
+#include "chrome/browser/speech/speech_recognition_client_browser_interface.h"
+#include "chrome/browser/speech/speech_recognition_client_browser_interface_factory.h"
+#include "content/public/browser/web_contents.h"
+#include "media/mojo/mojom/speech_recognition_result.h"
+
+CallCaptionsTabHelper::CallCaptionsTabHelper(content::WebContents* web_contents)
+    : content::WebContentsUserData<CallCaptionsTabHelper>(*web_contents),
+      indicator_(MediaCaptureDevicesDispatcher::GetInstance()->GetMediaStreamCaptureIndicator()) {
+  capture_observation_.Observe(indicator_.get());
+  state_.OnMicCapturing(indicator_->IsCapturingAudio(web_contents));
+}
+
+CallCaptionsTabHelper::~CallCaptionsTabHelper() {
+  if (state_.captions_on()) {
+    state_.SetCaptionsOn(false);
+    CaptionsChanged(/*was_on=*/true);
+  }
+}
+
+void CallCaptionsTabHelper::SetCaptionsOn(bool on) {
+  const bool was_on = state_.captions_on();
+  if (state_.SetCaptionsOn(on) && was_on != on) {
+    CaptionsChanged(was_on);
+  }
+  observers_.Notify(&Observer::OnCallStateChanged);
+}
+
+void CallCaptionsTabHelper::SetLanguage(tark_captions::Language language) {
+  language_ = language;
+  if (state_.captions_on()) {
+    Profile* profile = Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+    if (auto* speech =
+            SpeechRecognitionClientBrowserInterfaceFactory::GetForProfile(profile)) {
+      speech->OnTarkCaptionsLanguageChanged(tark_captions::LanguageCode(language_));
+    }
+  }
+  observers_.Notify(&Observer::OnCallStateChanged);
+}
+
+void CallCaptionsTabHelper::HideForThisCall() {
+  const bool was_on = state_.captions_on();
+  state_.HideForThisCall();
+  if (was_on) {
+    CaptionsChanged(was_on);
+  }
+  observers_.Notify(&Observer::OnCallStateChanged);
+}
+
+void CallCaptionsTabHelper::OnCaption(const media::SpeechRecognitionResult& result) {
+  if (!state_.captions_on()) {
+    return;
+  }
+  // Never the text: call content stays out of logs.
+  VLOG(1) << "Tark captions: " << (result.is_final ? "final" : "draft") << ", "
+          << result.transcription.size() << " bytes";
+  observers_.Notify(&Observer::OnCaption, result.is_final, result.transcription);
+}
+
+void CallCaptionsTabHelper::OnCaptionsError() {
+  observers_.Notify(&Observer::OnCaptionsUnavailable);
+}
+
+void CallCaptionsTabHelper::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void CallCaptionsTabHelper::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void CallCaptionsTabHelper::OnIsCapturingAudioChanged(content::WebContents* web_contents,
+                                                      bool is_capturing_audio) {
+  if (web_contents != &GetWebContents()) {
+    return;
+  }
+  const bool was_on = state_.captions_on();
+  state_.OnMicCapturing(is_capturing_audio);
+  VLOG(1) << "Tark captions: in_call=" << state_.in_call();
+  if (was_on && !state_.captions_on()) {
+    CaptionsChanged(was_on);
+  }
+  // Until the pill (Task 10): --tark-captions-force=LANG turns captions on
+  // in any tab that is in a call.
+  const std::string forced =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          speech::kTarkCaptionsForceSwitch);
+  if (state_.in_call() && !forced.empty()) {
+    language_ = tark_captions::LanguageFromCode(forced).value_or(language_);
+    SetCaptionsOn(true);
+    return;
+  }
+  observers_.Notify(&Observer::OnCallStateChanged);
+}
+
+void CallCaptionsTabHelper::CaptionsChanged(bool was_on) {
+  Profile* profile = Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+  speech::SpeechRecognitionClientBrowserInterface* speech =
+      SpeechRecognitionClientBrowserInterfaceFactory::GetForProfile(profile);
+  if (speech) {
+    speech->OnTarkCaptionsChanged(/*on=*/!was_on, tark_captions::LanguageCode(language_));
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(CallCaptionsTabHelper);
