+#ifndef CHROME_BROWSER_TARK_CAPTIONS_CALL_CAPTIONS_TAB_HELPER_H_
+#define CHROME_BROWSER_TARK_CAPTIONS_CALL_CAPTIONS_TAB_HELPER_H_
+
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "components/tark_captions/asr_model.h"
+#include "components/tark_captions/call_state.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace media {
+struct SpeechRecognitionResult;
+}
+
+// Tark (D4): one tab's call captions. The tab is in a call while it
+// captures the microphone; the user turns captions on (nothing listens
+// before), which lets the tab's renderer send its incoming call audio to
+// the speech service; the captions come back here for the pill. The call
+// ending turns captions off.
+class CallCaptionsTabHelper
+    : public content::WebContentsUserData<CallCaptionsTabHelper>,
+      public MediaStreamCaptureIndicator::Observer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnCallStateChanged() {}
+    virtual void OnCaption(bool is_final, const std::string& text) {}
+    virtual void OnCaptionsUnavailable() {}
+  };
+
+  CallCaptionsTabHelper(const CallCaptionsTabHelper&) = delete;
+  CallCaptionsTabHelper& operator=(const CallCaptionsTabHelper&) = delete;
+  ~CallCaptionsTabHelper() override;
+
+  bool in_call() const { return state_.in_call(); }
+  bool captions_on() const { return state_.captions_on(); }
+  bool hidden() const { return state_.hidden(); }
+  tark_captions::Language language() const { return language_; }
+
+  void SetCaptionsOn(bool on);
+  void SetLanguage(tark_captions::Language language);
+  void HideForThisCall();
+
+  // From the speech recognition host of one of this tab's frames.
+  void OnCaption(const media::SpeechRecognitionResult& result);
+  void OnCaptionsError();
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // MediaStreamCaptureIndicator::Observer:
+  void OnIsCapturingAudioChanged(content::WebContents* web_contents,
+                                 bool is_capturing_audio) override;
+
+ private:
+  friend class content::WebContentsUserData<CallCaptionsTabHelper>;
+  explicit CallCaptionsTabHelper(content::WebContents* web_contents);
+
+  // Tells the profile's renderers (through the speech client interface)
+  // whether this tab's captions turned on or off.
+  void CaptionsChanged(bool was_on);
+
+  tark_captions::CallState state_;
+  tark_captions::Language language_ = tark_captions::Language::kHindi;
+  scoped_refptr<MediaStreamCaptureIndicator> indicator_;
+  base::ScopedObservation<MediaStreamCaptureIndicator,
+                          MediaStreamCaptureIndicator::Observer>
+      capture_observation_{this};
+  base::ObserverList<Observer> observers_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+#endif  // CHROME_BROWSER_TARK_CAPTIONS_CALL_CAPTIONS_TAB_HELPER_H_
