+
+void CallCaptionsTabHelper::Pump() {
+  if (!translator_.is_bound()) {
+    Profile* profile = Profile::FromBrowserContext(GetWebContents().GetBrowserContext());
+    speech::SpeechRecognitionService* service =
+        SpeechRecognitionServiceFactory::GetForProfile(profile);
+    if (!service) {
+      render_queue_.Clear();
+      return;
+    }
+    service->BindTarkCaptionTranslator(translator_.BindNewPipeAndPassReceiver());
+    // The speech process went away (idle, crash): start afresh next caption.
+    translator_.set_disconnect_handler(base::BindOnce(
+        [](CallCaptionsTabHelper* tab) {
+          tab->translator_.reset();
+          tab->render_queue_.Clear();
+        },
+        base::Unretained(this)));
+  }
+  std::optional<tark_captions::RenderRequest> next = render_queue_.Next();
+  if (!next) {
+    return;
+  }
+  const std::string text = next->text;
+  translator_->Render(text, tark_captions::LanguageCode(language_), show_in(),
+                      translate_on_ ? translate_to() : std::string(),
+                      base::BindOnce(&CallCaptionsTabHelper::OnRendered,
+                                     weak_factory_.GetWeakPtr(), next->is_final,
+                                     next->generation, text));
+}
+
+void CallCaptionsTabHelper::OnRendered(bool is_final,
+                                       uint64_t generation,
+                                       const std::string& original,
+                                       bool ok,
+                                       const std::string& shown,
+                                       const std::string& translation) {
+  const bool current = render_queue_.Done(generation);
+  // Sizes only: call content stays out of logs.
+  VLOG(1) << "Tark captions: rendered " << (is_final ? "final" : "draft") << ", "
+          << shown.size() << " bytes shown, " << translation.size() << " bytes translated"
+          << (ok ? "" : ", failed") << (current ? "" : ", stale");
+  if (current && state_.captions_on()) {
+    observers_.Notify(&Observer::OnCaptionRendered, this, is_final,
+                      shown.empty() ? original : shown, translation, translate_on_ && !ok);
+  }
+  Pump();
+}
+
+void CallCaptionsTabHelper::StopRendering() {
+  translate_on_ = false;
+  render_queue_.Clear();
+  translator_.reset();
 }
 
