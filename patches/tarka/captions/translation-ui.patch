+  if (is_final) {
+    text_.AddFinal(shown);
+  } else {
+    text_.SetDraft(shown);
+  }
+  translation_failed_ = translation_failed;
+  if (tab->translate_on() && !translation_failed) {
+    if (is_final) {
+      translation_.AddFinal(translation);
+    } else {
+      translation_.SetDraft(translation);
+    }
+  }
+  message_.clear();
+  ShowCaption();
+}
