+namespace tark_captions {
+
+// Tark (D4 Phase 4): the live captions models on this Mac, for every
+// profile (the browser UI thread only). Downloads come from
+// https://gettarka.com/models/captions/v1/ through the system network
+// context (no cookies); --tark-captions-models-url points elsewhere for
+// tests, which changes nothing Tark runs because every file is checked
+// against the manifest compiled into Tark.
+CaptionModelStore& TarkCaptionModels();
+
+}  // namespace tark_captions
