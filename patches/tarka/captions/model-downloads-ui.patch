+void TarkCaptionPillController::OnDownloadButtonPressed() {
+  if (!waiting_) {
+    return;
+  }
+  bool failed = false;
+  for (tark_captions::ModelUnit unit : waiting_units_) {
+    failed |= tark_captions::TarkCaptionModels().status(unit).state ==
+              tark_captions::CaptionModelStore::State::kFailed;
+  }
+  if (failed) {
+    // Retry.
+    for (tark_captions::ModelUnit unit : waiting_units_) {
+      tark_captions::TarkCaptionModels().Download(unit);
+    }
+    ShowDownload();
+    return;
+  }
+  for (tark_captions::ModelUnit unit : waiting_units_) {
+    tark_captions::TarkCaptionModels().Cancel(unit);
+  }
+  StopWaiting();
+}
+
+void TarkCaptionPillController::OnModelStatusChanged(tark_captions::ModelUnit unit) {
+  if (!waiting_ || !shown_) {
+    return;
+  }
+  for (tark_captions::ModelUnit needed : waiting_units_) {
+    if (!tark_captions::TarkCaptionModels().ready(needed)) {
+      ShowDownload();
+      return;
+    }
+  }
+  const bool for_captions = waiting_for_captions_;
+  const bool turn_on = turn_on_when_ready_;
+  StopWaiting();
+  if (!turn_on) {
+    return;
+  }
+  if (for_captions) {
+    shown_->SetCaptionsOn(true);
+  } else {
+    shown_->SetTranslateOn(true);
+  }
+}
+
+void TarkCaptionPillController::WaitForModels(bool for_captions,
+                                              bool turn_on,
+                                              std::vector<tark_captions::ModelUnit> units) {
+  waiting_ = true;
+  waiting_for_captions_ = for_captions;
+  turn_on_when_ready_ = turn_on;
+  waiting_units_ = std::move(units);
+  for (tark_captions::ModelUnit unit : waiting_units_) {
+    tark_captions::TarkCaptionModels().Download(unit);
+  }
+  ShowDownload();
+}
+
+void TarkCaptionPillController::StopWaiting() {
+  waiting_ = false;
+  waiting_units_.clear();
+  if (view_) {
+    view_->SetDownload(std::nullopt);
+  }
+}
+
+void TarkCaptionPillController::ShowDownload() {
+  if (!view_ || !shown_ || !waiting_) {
+    return;
+  }
+  int64_t done = 0;
+  int64_t total = 0;
+  bool failed = false;
+  for (tark_captions::ModelUnit unit : waiting_units_) {
+    const tark_captions::CaptionModelStore::Status status =
+        tark_captions::TarkCaptionModels().status(unit);
+    done += status.state == tark_captions::CaptionModelStore::State::kReady ? status.total
+                                                                           : status.done;
+    total += status.total;
+    failed |= status.state == tark_captions::CaptionModelStore::State::kFailed;
+  }
+  const std::u16string language = LanguageName(shown_->language());
+  const std::u16string done_mb = base::NumberToString16(done / 1000000);
+  const std::u16string total_mb = base::NumberToString16(total / 1000000);
+  TarkCaptionPillView::Download download;
+  download.failed = failed;
+  download.fraction = total > 0 ? static_cast<double>(done) / total : 0;
+  if (waiting_for_captions_) {
+    download.text =
+        failed ? l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_DOWNLOAD_FAILED, language)
+               : l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_GETTING_READY, language, done_mb,
+                                            total_mb);
+  } else {
+    download.text =
+        failed ? l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_TRANSLATION_DOWNLOAD_FAILED)
+               : l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_GETTING_TRANSLATION_READY,
+                                            done_mb, total_mb);
+  }
+  view_->SetDownload(download);
+}
