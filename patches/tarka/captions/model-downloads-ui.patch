+void CallCaptionsTabHelper::UpdateModelsInUse() {
+  const bool on = state_.captions_on();
+  if (!on && !holds_models_) {
+    return;
+  }
+  holds_models_ = on;
+  std::vector<tark_captions::ModelUnit> translation;
+  if (on && translate_on_) {
+    translation = tark_captions::UnitsForTranslation(
+        tark_captions::TargetFromCode(translate_to()).value_or(tark_captions::Target::kEnglish));
+  }
+  tark_captions::CaptionModelStore& models = tark_captions::TarkCaptionModels();
+  models.SetInUse(tark_captions::ModelUnit::kCaptions, on);
+  for (tark_captions::ModelUnit unit :
+       {tark_captions::ModelUnit::kToEnglish, tark_captions::ModelUnit::kFromEnglish}) {
+    models.SetInUse(unit, std::ranges::find(translation, unit) != translation.end());
+  }
+}
