+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/speech/chrome_speech_recognition_service.h"
+#include "components/tark_captions/model_manifest.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr char kModelsUrlSwitch[] = "tark-captions-models-url";
+constexpr char kModelsUrl[] = "https://gettarka.com/models/captions/v1/";
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("tark_captions_models", R"(
+        semantics {
+          sender: "Tark live captions"
+          description:
+            "Downloads the on-device speech recognition and translation "
+            "models Tark's call captions run on, once per model, from "
+            "gettarka.com. Every file is checked against hashes built into "
+            "Tark."
+          trigger:
+            "The user turns on Captions or Translate in a call and the "
+            "model is not on this Mac yet, or downloads it in Settings > "
+            "Live captions."
+          data: "None. The request carries no cookies and no user data."
+          destination: OTHER
+          destination_other: "gettarka.com, Tark's own site."
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Nothing is downloaded until the user turns on Captions or "
+            "Translate, or downloads a model in Settings > Live captions."
+          policy_exception_justification: "Not implemented."
+        })");
+
+}  // namespace
+
+CaptionModelStore& TarkCaptionModels() {
+  static base::NoDestructor<CaptionModelStore> store(
+      speech::ChromeSpeechRecognitionService::TarkCaptionsModelsDir(),
+      g_browser_process->shared_url_loader_factory(),
+      GURL(base::CommandLine::ForCurrentProcess()->HasSwitch(kModelsUrlSwitch)
+               ? base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(kModelsUrlSwitch)
+               : kModelsUrl),
+      ModelManifest(), kAnnotation);
+  return *store;
+}
+
+}  // namespace tark_captions
