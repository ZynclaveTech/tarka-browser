+void TarkCaptionPillView::SetDownload(const std::optional<Download>& download) {
+  captions_button_->SetVisible(!download);
+  language_button_->SetVisible(!download);
+  translate_button_->SetVisible(!download);
+  download_label_->SetVisible(!!download);
+  download_progress_->SetVisible(download && !download->failed);
+  download_button_->SetVisible(!!download);
+  if (download) {
+    download_label_->SetText(download->text);
+    download_label_->SetEnabledColor(download->failed ? ui::kColorAlertHighSeverity
+                                                      : ui::kColorLabelForegroundSecondary);
+    download_progress_->SetValue(download->fraction);
+    download_button_->SetText(l10n_util::GetStringUTF16(
+        download->failed ? IDS_TARK_CAPTIONS_RETRY : IDS_TARK_CAPTIONS_CANCEL));
+  }
+  PreferredSizeChanged();
+}
