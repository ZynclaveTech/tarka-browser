+#ifndef COMPONENTS_TARK_CAPTIONS_DETECTION_POLICY_H_
+#define COMPONENTS_TARK_CAPTIONS_DETECTION_POLICY_H_
+
+#include <string>
+
+#include "base/containers/span.h"
+
+namespace tark_captions {
+
+// When the client's language is decided (D4 Phase 3), in seconds of speech:
+// at the first point when the language detector is sure, else at the last
+// whatever it thinks. Tuned with utils/lid_export.py policy on 549 FLEURS
+// clips; keep in step with its Python twin, `decide`.
+inline constexpr double kFirstDecision = 3.0;
+inline constexpr double kLastDecision = 5.0;
+inline constexpr double kLockProbability = 0.9;
+// An unsure call between neighbouring Indian languages goes to the one Tark
+// captions when that one has at least this much.
+inline constexpr double kNeighbourMass = 0.1;
+
+struct Detection {
+  enum class Kind {
+    kUnsure,       // Not yet: more speech is needed.
+    kCaption,      // Tark's own models caption it (hi, ta, bn).
+    kApple,        // macOS 26's speech captions it (en, es, fr, ...).
+    kPlanned,      // An Indian language not listed yet (te, mr, ...).
+    kUnsupported,  // Anything else (sw, ...).
+  };
+  Kind kind = Kind::kUnsure;
+  std::string code;  // Empty when unsure. Urdu is reported as "hi".
+};
+
+// `logits`: the language detector's scores, one per label, for the first
+// `speech_seconds` of the client's speech.
+Detection DecideLanguage(base::span<const float> logits,
+                         base::span<const std::string> labels,
+                         double speech_seconds);
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_DETECTION_POLICY_H_
