+
+#ifndef COMPONENTS_TARK_CAPTIONS_LANGUAGE_GATE_H_
+#define COMPONENTS_TARK_CAPTIONS_LANGUAGE_GATE_H_
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "components/tark_captions/detection_policy.h"
+
+namespace tark_captions {
+
+class LanguageDetector;
+class OrtRuntime;
+class Vad;
+
+// The first seconds of a call (D4 Phase 3): listens until the client has
+// spoken for kFirstDecision seconds (kLastDecision when unsure), then says
+// which language it is. Only speech counts (Silero VAD): silence, hold music
+// and noise never decide. What it heard since the speech began is kept so
+// the captions, or the browser's Apple captioner, start from the first word.
+// Use on one sequence.
+class LanguageGate {
+ public:
+  // Null without the language_id unit (lid.onnx, lid_labels.txt,
+  // silero_vad.onnx) or ONNX Runtime.
+  static std::unique_ptr<LanguageGate> Create(const base::FilePath& models_dir,
+                                              const base::FilePath& ort_dylib);
+
+  LanguageGate(const LanguageGate&) = delete;
+  LanguageGate& operator=(const LanguageGate&) = delete;
+  ~LanguageGate();
+
+  // 16 kHz mono call audio. The decision, the one time it is made.
+  std::optional<Detection> AddMono16k(base::span<const float> pcm);
+
+  // The audio since just before the speech began (at most the last 30 s);
+  // empty after it is taken.
+  std::vector<float> TakeHeard();
+  double speech_seconds() const;
+
+ private:
+  LanguageGate(std::unique_ptr<OrtRuntime> runtime,
+               std::unique_ptr<Vad> vad,
+               std::unique_ptr<LanguageDetector> detector);
+
+  std::unique_ptr<OrtRuntime> runtime_;
+  std::unique_ptr<Vad> vad_;
+  std::unique_ptr<LanguageDetector> detector_;
+  std::vector<float> chunk_;    // The next VAD chunk, being filled.
+  std::vector<float> speech_;   // Speech only: what the detector hears.
+  std::vector<float> heard_;    // Everything since the speech began.
+  std::vector<float> preroll_;  // The half second before it began.
+  bool decided_ = false;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_LANGUAGE_GATE_H_
