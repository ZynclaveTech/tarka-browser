+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TARK_CAPTIONS_CLIENT_LANGUAGE_H_
+#define COMPONENTS_TARK_CAPTIONS_CLIENT_LANGUAGE_H_
+
+#include <cstdint>
+#include <string>
+
+namespace tark_captions {
+
+// The language the client speaks on one call (D4 Phase 3): Auto-detect
+// until the speech process says which (it locks; it never switches by
+// itself), or the language the user picked, which wins over a detection
+// still on its way. Never remembered past the call.
+class ClientLanguage {
+ public:
+  enum class State {
+    kDetecting,         // Auto-detect, nothing decided yet.
+    kCaptioning,        // Tark's own captions (hi, ta, bn).
+    kApple,             // macOS 26 captions it.
+    kAppleUnavailable,  // macOS captions it, but not this Mac (before 26).
+    kPlanned,           // An Indian language not listed yet.
+    kUnsupported,       // Tark can't caption it.
+  };
+
+  explicit ClientLanguage(bool apple_available);
+  ClientLanguage(const ClientLanguage&) = delete;
+  ClientLanguage& operator=(const ClientLanguage&) = delete;
+  ~ClientLanguage();
+
+  // Auto-detect: a new call, or "Auto-detect" picked again.
+  void ChooseAuto();
+  // The user picked `code` for this call.
+  void Choose(const std::string& code);
+  // The speech process heard `code` ("und": it couldn't tell). Ignored once
+  // a language is locked or picked.
+  void Detected(const std::string& code);
+
+  State state() const { return state_; }
+  // "" while detecting.
+  const std::string& code() const { return code_; }
+  bool automatic() const { return automatic_; }
+  // Locked by detection (the pill says "· detected").
+  bool detected() const { return automatic_ && !code_.empty(); }
+  // Bumped by every choice, so answers about an older one can be dropped.
+  uint64_t generation() const { return generation_; }
+  // What the recognizer is told: "auto" until a language is known.
+  std::string recognizer_code() const { return code_.empty() ? "auto" : code_; }
+
+ private:
+  void Set(const std::string& code);
+
+  const bool apple_available_;
+  State state_ = State::kDetecting;
+  std::string code_;
+  bool automatic_ = true;
+  uint64_t generation_ = 0;
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_CLIENT_LANGUAGE_H_
