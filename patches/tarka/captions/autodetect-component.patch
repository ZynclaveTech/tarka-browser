+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/language_gate.h"
+
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "components/tark_captions/language_detector.h"
+#include "components/tark_captions/mono_resampler.h"
+#include "components/tark_captions/ort_runtime.h"
+#include "components/tark_captions/vad.h"
+
+namespace tark_captions {
+namespace {
+
+constexpr float kSpeechProbability = 0.5f;
+constexpr size_t kPreroll = MonoResampler::kRate / 2;
+constexpr size_t kMaxHeard = 30 * MonoResampler::kRate;
+
+}  // namespace
+
+// static
+std::unique_ptr<LanguageGate> LanguageGate::Create(const base::FilePath& models_dir,
+                                                   const base::FilePath& ort_dylib) {
+  std::unique_ptr<OrtRuntime> runtime = OrtRuntime::Load(ort_dylib);
+  if (!runtime) {
+    return nullptr;
+  }
+  std::unique_ptr<Vad> vad = Vad::Load(runtime.get(), models_dir);
+  std::unique_ptr<LanguageDetector> detector = LanguageDetector::Load(runtime.get(), models_dir);
+  if (!vad || !detector) {
+    return nullptr;
+  }
+  return base::WrapUnique(
+      new LanguageGate(std::move(runtime), std::move(vad), std::move(detector)));
+}
+
+LanguageGate::LanguageGate(std::unique_ptr<OrtRuntime> runtime,
+                           std::unique_ptr<Vad> vad,
+                           std::unique_ptr<LanguageDetector> detector)
+    : runtime_(std::move(runtime)), vad_(std::move(vad)), detector_(std::move(detector)) {}
+
+// The models go before the runtime that made them.
+LanguageGate::~LanguageGate() {
+  detector_.reset();
+  vad_.reset();
+}
+
+std::optional<Detection> LanguageGate::AddMono16k(base::span<const float> pcm) {
+  if (decided_) {
+    return std::nullopt;
+  }
+  std::optional<Detection> decision;
+  for (float sample : pcm) {
+    chunk_.push_back(sample);
+    if (chunk_.size() < Vad::kChunk) {
+      continue;
+    }
+    const bool speech = vad_->Process(base::span(chunk_).first<Vad::kChunk>()) >= kSpeechProbability;
+    if (heard_.empty() && !speech) {
+      preroll_.insert(preroll_.end(), chunk_.begin(), chunk_.end());
+      if (preroll_.size() > kPreroll) {
+        preroll_.erase(preroll_.begin(), preroll_.end() - kPreroll);
+      }
+    } else {
+      if (heard_.empty()) {
+        heard_ = std::move(preroll_);
+        preroll_.clear();
+      }
+      heard_.insert(heard_.end(), chunk_.begin(), chunk_.end());
+      if (heard_.size() > kMaxHeard) {
+        heard_.erase(heard_.begin(), heard_.end() - kMaxHeard);
+      }
+    }
+    chunk_.clear();
+    if (!speech || decision) {
+      continue;
+    }
+    const double before = speech_seconds();
+    speech_.insert(speech_.end(), heard_.end() - Vad::kChunk, heard_.end());
+    const double now = speech_seconds();
+    // Decide when the speech crosses 3 s, and again at 5 s if unsure.
+    for (double at : {kFirstDecision, kLastDecision}) {
+      if (before < at && now >= at) {
+        Detection d = DecideLanguage(detector_->Logits(speech_), detector_->labels(), now);
+        if (d.kind != Detection::Kind::kUnsure) {
+          decision = std::move(d);
+          decided_ = true;
+        }
+      }
+    }
+  }
+  return decision;
+}
+
+std::vector<float> LanguageGate::TakeHeard() {
+  return std::exchange(heard_, {});
+}
+
+double LanguageGate::speech_seconds() const {
+  return static_cast<double>(speech_.size()) / MonoResampler::kRate;
+}
+
+}  // namespace tark_captions
