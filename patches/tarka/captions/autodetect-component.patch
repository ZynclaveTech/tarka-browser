+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/language_detector.h"
+
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/memory/ptr_util.h"
+#include "base/strings/string_split.h"
+#include "components/tark_captions/ort_runtime.h"
+
+namespace tark_captions {
+
+// static
+std::unique_ptr<LanguageDetector> LanguageDetector::Load(OrtRuntime* runtime,
+                                                         const base::FilePath& models_dir) {
+  std::string text;
+  if (!base::ReadFileToString(models_dir.Append("lid_labels.txt"), &text)) {
+    return nullptr;
+  }
+  std::vector<std::string> labels = base::SplitString(
+      text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::unique_ptr<OrtModel> model = runtime->LoadModel(models_dir.Append("lid.onnx"), 2);
+  if (labels.empty() || !model) {
+    return nullptr;
+  }
+  return base::WrapUnique(new LanguageDetector(std::move(model), std::move(labels)));
+}
+
+LanguageDetector::LanguageDetector(std::unique_ptr<OrtModel> model,
+                                   std::vector<std::string> labels)
+    : model_(std::move(model)), labels_(std::move(labels)) {}
+
+LanguageDetector::~LanguageDetector() = default;
+
+std::vector<float> LanguageDetector::Logits(base::span<const float> pcm16k) {
+  if (pcm16k.empty()) {
+    return {};
+  }
+  std::vector<Tensor> inputs(1);
+  inputs[0] = {.name = "waveform", .shape = {1, static_cast<int64_t>(pcm16k.size())}};
+  inputs[0].f32.assign(pcm16k.begin(), pcm16k.end());
+  std::vector<Tensor> outputs;
+  if (!model_->Run(inputs, {"logits"}, &outputs) || outputs.empty() ||
+      outputs[0].f32.size() != labels_.size()) {
+    return {};
+  }
+  return std::move(outputs[0].f32);
+}
+
+}  // namespace tark_captions
