+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/detection_policy.h"
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+#include <string_view>
+
+
+namespace tark_captions {
+namespace {
+
+constexpr std::string_view kCaptioned[] = {"hi", "ta", "bn"};
+constexpr std::string_view kApple[] = {"en", "es", "fr", "de", "it", "pt", "ja", "ko", "zh"};
+// IndicConformer covers these too; they are listed once measured.
+constexpr std::string_view kPlanned[] = {"as", "gu", "kn", "ml", "mr",
+                                         "ne", "pa", "sa", "sd", "te"};
+// Languages the detector confuses; an unsure call inside one goes to the
+// member Tark captions.
+constexpr std::string_view kBengaliFamily[] = {"bn", "as"};
+constexpr std::string_view kHindiFamily[] = {"hi", "mr", "gu", "pa", "ne", "sa", "sd"};
+constexpr std::string_view kTamilFamily[] = {"ta", "ml", "te", "kn"};
+
+bool In(base::span<const std::string_view> set, std::string_view code) {
+  return std::find(set.begin(), set.end(), code) != set.end();
+}
+
+}  // namespace
+
+Detection DecideLanguage(base::span<const float> logits,
+                         base::span<const std::string> labels,
+                         double speech_seconds) {
+  if (speech_seconds < kFirstDecision || logits.empty() || logits.size() != labels.size()) {
+    return {};
+  }
+  // Probabilities, with Urdu counted as Hindi (spoken Hindustani).
+  const float max = *std::max_element(logits.begin(), logits.end());
+  double sum = 0;
+  std::map<std::string, double> p;
+  for (size_t i = 0; i < logits.size(); ++i) {
+    const double e = std::exp(static_cast<double>(logits[i]) - max);
+    sum += e;
+    p[labels[i] == "ur" ? std::string("hi") : labels[i]] += e;
+  }
+  for (auto& [code, value] : p) {
+    value /= sum;
+  }
+  auto top = std::max_element(p.begin(), p.end(),
+                              [](const auto& a, const auto& b) { return a.second < b.second; });
+  const bool sure = top->second >= kLockProbability;
+  if (!sure && speech_seconds < kLastDecision) {
+    return {};
+  }
+  std::string code = top->first;
+  if (!sure && !In(kCaptioned, code)) {
+    for (base::span<const std::string_view> family :
+         {base::span<const std::string_view>(kBengaliFamily),
+          base::span<const std::string_view>(kHindiFamily),
+          base::span<const std::string_view>(kTamilFamily)}) {
+      if (!In(family, code)) {
+        continue;
+      }
+      // The family's captioned member (its first).
+      const std::string captioned(family[0]);
+      auto it = p.find(captioned);
+      if (it != p.end() && it->second >= kNeighbourMass) {
+        code = captioned;
+      }
+    }
+  }
+  Detection out;
+  out.code = code;
+  if (In(kCaptioned, code)) {
+    out.kind = Detection::Kind::kCaption;
+  } else if (In(kApple, code)) {
+    out.kind = Detection::Kind::kApple;
+  } else if (In(kPlanned, code)) {
+    out.kind = Detection::Kind::kPlanned;
+  } else {
+    out.kind = Detection::Kind::kUnsupported;
+  }
+  return out;
+}
+
+}  // namespace tark_captions
