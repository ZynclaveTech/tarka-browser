+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tark_captions/detection_policy.h"
+
+#include <cmath>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+using Kind = Detection::Kind;
+
+const std::vector<std::string> kLabels = {"ab", "as", "bn", "en", "es", "hi",
+                                          "ml", "sw", "ta", "te", "ur"};
+
+// Log-probabilities, as the model gives them: the named languages get
+// their share, the rest split what is left.
+std::vector<float> Scores(const std::map<std::string, double>& named) {
+  double used = 0;
+  for (const auto& [code, p] : named) {
+    used += p;
+  }
+  const double rest = (1.0 - used) / (kLabels.size() - named.size());
+  std::vector<float> out;
+  for (const std::string& code : kLabels) {
+    auto it = named.find(code);
+    out.push_back(std::log(it == named.end() ? rest : it->second));
+  }
+  return out;
+}
+
+Detection Decide(const std::map<std::string, double>& named, double seconds) {
+  return DecideLanguage(Scores(named), kLabels, seconds);
+}
+
+void ExpectDetection(const Detection& got, Kind kind, const std::string& code) {
+  EXPECT_EQ(got.kind, kind);
+  EXPECT_EQ(got.code, code);
+}
+
+TEST(DetectionPolicyTest, UrduCountsAsHindi) {
+  ExpectDetection(Decide({{"ur", 0.65}, {"hi", 0.3}}, 3.0), Kind::kCaption, "hi");
+}
+
+TEST(DetectionPolicyTest, ConfidentAtThreeSeconds) {
+  ExpectDetection(Decide({{"es", 0.95}}, 3.0), Kind::kApple, "es");
+}
+
+TEST(DetectionPolicyTest, UnsureAtThreeWaitsForFive) {
+  ExpectDetection(Decide({{"ta", 0.4}, {"ml", 0.3}}, 3.0), Kind::kUnsure, "");
+  ExpectDetection(Decide({{"ta", 0.4}, {"ml", 0.3}}, 5.0), Kind::kCaption, "ta");
+}
+
+TEST(DetectionPolicyTest, NeighbourOfSupportedIsSupported) {
+  ExpectDetection(Decide({{"as", 0.5}, {"bn", 0.35}}, 5.0), Kind::kCaption, "bn");
+}
+
+TEST(DetectionPolicyTest, ConfidentNeighbourIsNotPulled) {
+  ExpectDetection(Decide({{"te", 0.95}, {"ta", 0.04}}, 3.0), Kind::kPlanned, "te");
+}
+
+TEST(DetectionPolicyTest, SwahiliIsUnsupported) {
+  ExpectDetection(Decide({{"sw", 0.95}}, 3.0), Kind::kUnsupported, "sw");
+}
+
+TEST(DetectionPolicyTest, TeluguIsPlanned) {
+  ExpectDetection(Decide({{"te", 0.95}}, 3.0), Kind::kPlanned, "te");
+}
+
+TEST(DetectionPolicyTest, NothingBeforeThreeSeconds) {
+  ExpectDetection(Decide({{"es", 0.99}}, 2.9), Kind::kUnsure, "");
+}
+
+TEST(DetectionPolicyTest, ScoresAndLabelsMustMatch) {
+  ExpectDetection(DecideLanguage(std::vector<float>(3, 0.0f), kLabels, 5.0), Kind::kUnsure, "");
+}
+
+}  // namespace
+}  // namespace tark_captions
