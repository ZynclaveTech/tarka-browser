+
+#ifndef COMPONENTS_TARK_CAPTIONS_MONO_RESAMPLER_H_
+#define COMPONENTS_TARK_CAPTIONS_MONO_RESAMPLER_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace media {
+class SincResampler;
+}
+
+namespace tark_captions {
+
+// Call audio as the models want it: channels averaged to mono, resampled to
+// 16 kHz. Keeps the resampler's state between calls, so feed one stream.
+class MonoResampler {
+ public:
+  static constexpr int kRate = 16000;
+
+  MonoResampler();
+  MonoResampler(const MonoResampler&) = delete;
+  MonoResampler& operator=(const MonoResampler&) = delete;
+  ~MonoResampler();
+
+  // Appends `interleaved` (`channels` >= 1, `sample_rate` >= 8 kHz) to `out`
+  // as 16 kHz mono; anything else is ignored.
+  void Add(base::span<const float> interleaved,
+           int channels,
+           int sample_rate,
+           std::vector<float>* out);
+
+ private:
+  int input_rate_ = kRate;
+  std::unique_ptr<media::SincResampler> resampler_;
+  std::vector<float> fifo_;  // Mono input waiting for the resampler.
+};
+
+}  // namespace tark_captions
+
+#endif  // COMPONENTS_TARK_CAPTIONS_MONO_RESAMPLER_H_
