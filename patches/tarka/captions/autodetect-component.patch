+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace tark_captions {
+namespace {
+
+TEST(MonoResamplerTest, SixteenKilohertzMonoPassesThrough) {
+  MonoResampler resampler;
+  std::vector<float> in = {0.1f, -0.2f, 0.3f};
+  std::vector<float> out;
+  resampler.Add(in, 1, 16000, &out);
+  EXPECT_EQ(out, in);
+}
+
+TEST(MonoResamplerTest, StereoIsAveraged) {
+  MonoResampler resampler;
+  std::vector<float> out;
+  resampler.Add(std::vector<float>{0.2f, 0.4f, -1.0f, 1.0f}, 2, 16000, &out);
+  ASSERT_EQ(out.size(), 2u);
+  EXPECT_FLOAT_EQ(out[0], 0.3f);
+  EXPECT_FLOAT_EQ(out[1], 0.0f);
+}
+
+// One second of a 440 Hz tone at 48 kHz stereo comes out as about one second
+// at 16 kHz (less what the resampler holds back).
+TEST(MonoResamplerTest, FortyEightKilohertzStereoBecomesSixteen) {
+  MonoResampler resampler;
+  std::vector<float> in;
+  for (int i = 0; i < 48000; ++i) {
+    const float s = 0.5f * std::sin(2 * M_PI * 440 * i / 48000.0);
+    in.push_back(s);
+    in.push_back(s);
+  }
+  std::vector<float> out;
+  for (size_t i = 0; i < in.size(); i += 960) {
+    resampler.Add(base::span(in).subspan(i, 960u), 2, 48000, &out);
+  }
+  EXPECT_GT(out.size(), 15000u);
+  EXPECT_LE(out.size(), 16000u);
+}
+
+TEST(MonoResamplerTest, BadInputIsIgnored) {
+  MonoResampler resampler;
+  std::vector<float> out;
+  resampler.Add(std::vector<float>{0.1f}, 0, 16000, &out);
+  resampler.Add(std::vector<float>{0.1f}, 1, 4000, &out);
+  EXPECT_TRUE(out.empty());
+}
+
