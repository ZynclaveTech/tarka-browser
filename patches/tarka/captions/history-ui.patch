+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_HISTORY_FOLLOW_H_
+#define CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_HISTORY_FOLLOW_H_
+
+// D4 captions history panel: whether it sticks to the newest line. Scrolling
+// up holds it still and counts the lines that arrive ("↓ Live · 3 new");
+// back at the bottom it follows again. Content growing below (new lines, a
+// line gaining its translation) moves the bottom, not the scroll offset, so
+// it is not taken for the user scrolling up.
+class HistoryFollow {
+ public:
+  // `offset`: how far the rows are scrolled from the top.
+  void OnScrolled(int offset, bool at_bottom);
+  void OnRowsAdded(int count);
+  bool following() const { return following_; }
+  int unseen() const { return unseen_; }
+
+ private:
+  bool following_ = true;
+  int unseen_ = 0;
+  int last_offset_ = 0;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_HISTORY_FOLLOW_H_
