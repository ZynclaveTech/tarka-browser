+// Tark (D4): the captions history panel's contents (mockup
+// captions-history-panel-mockup.html): "Captions · <tab>" with Copy and ✕,
+// the stopped and dropped notes, then every line with its time and
+// translation, the draft faded last, and "↓ Live · N new" while scrolled up.
+class TarkCaptionHistoryView : public views::View {
+  METADATA_HEADER(TarkCaptionHistoryView, views::View)
+
+ public:
+  class Delegate {
+   public:
+    virtual void OnCopyPressed() = 0;
+    virtual void OnCloseHistoryPressed() = 0;
+
+   protected:
+    virtual ~Delegate() = default;
+  };
+
+  explicit TarkCaptionHistoryView(Delegate* delegate);
+  TarkCaptionHistoryView(const TarkCaptionHistoryView&) = delete;
+  TarkCaptionHistoryView& operator=(const TarkCaptionHistoryView&) = delete;
+  ~TarkCaptionHistoryView() override;
+
+  void SetTitle(const std::u16string& tab_title);
+  // Captions stopped by themselves; the history stays until the user ends it.
+  void SetStopped(bool stopped);
+  // Rows are kept by id: new ones are added, changed ones updated, gone ones
+  // removed; the rest stay as they are.
+  void SetHistory(const tark_captions::CaptionHistory& history);
+  // Another tab's history comes next: its row ids start again at 1.
+  void Reset();
+
+ private:
+  struct RowViews {
+    raw_ptr<views::View> row = nullptr;
+    raw_ptr<views::Label> text = nullptr;
+    raw_ptr<views::Label> translation = nullptr;
+    uint32_t version = 0;
+  };
+
+  views::View* MakeRow(const tark_captions::CaptionHistory::Row& row, RowViews* views);
+  void FillRow(const tark_captions::CaptionHistory::Row& row, RowViews* views);
+  void OnScrolled();
+  void ScrollToBottom();
+  void UpdateLive();
+
+  raw_ptr<Delegate> delegate_;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> stopped_ = nullptr;
+  raw_ptr<views::Label> dropped_ = nullptr;
+  raw_ptr<views::ScrollView> scroll_ = nullptr;
+  raw_ptr<views::View> rows_ = nullptr;
+  raw_ptr<views::Label> draft_ = nullptr;
+  raw_ptr<views::MdTextButton> live_ = nullptr;
+  std::map<uint64_t, RowViews> row_views_;
+  HistoryFollow follow_;
+  base::CallbackListSubscription scrolled_subscription_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TARK_CAPTIONS_CAPTION_HISTORY_VIEW_H_
