+namespace {
+
+using Row = tark_captions::CaptionHistory::Row;
+using Kind = tark_captions::CaptionHistory::Kind;
+
+// Close enough to the bottom to count as there.
+constexpr int kBottomSlop = 4;
+
+std::unique_ptr<views::Label> MakeLabel(ui::ColorId color, bool multiline) {
+  auto label = std::make_unique<views::Label>();
+  label->SetMultiLine(multiline);
+  label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label->SetEnabledColor(color);
+  return label;
+}
+
+}  // namespace
+
+TarkCaptionHistoryView::TarkCaptionHistoryView(Delegate* delegate) : delegate_(delegate) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(views::BoxLayout::Orientation::kVertical,
+                                                      gfx::Insets::TLBR(10, 12, 10, 12), 6))
+      ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  SetBackground(views::CreateSolidBackground(ui::kColorDialogBackground));
+
+  auto* header = AddChildView(std::make_unique<views::BoxLayoutView>());
+  header->SetOrientation(views::BoxLayout::Orientation::kHorizontal);
+  header->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kCenter);
+  header->SetBetweenChildSpacing(6);
+  title_ = header->AddChildView(MakeLabel(ui::kColorLabelForeground, /*multiline=*/false));
+  title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  title_->SetFontList(title_->font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+  header->SetFlexForView(title_, 1);
+  header->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&Delegate::OnCopyPressed, base::Unretained(delegate_.get())),
+      l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_COPY)));
+  auto* close = header->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+      base::BindRepeating(&Delegate::OnCloseHistoryPressed, base::Unretained(delegate_.get())),
+      vector_icons::kCloseIcon, 16));
+  close->SetTooltipText(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_CLOSE));
+  close->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_CLOSE));
+
+  stopped_ = AddChildView(MakeLabel(ui::kColorLabelForegroundSecondary, /*multiline=*/true));
+  stopped_->SetText(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_STOPPED_NOTE));
+  stopped_->SetBackground(
+      views::CreateRoundedRectBackground(ui::kColorSubtleEmphasisBackground, 6));
+  stopped_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(3, 8)));
+  stopped_->SetVisible(false);
+  dropped_ = AddChildView(MakeLabel(ui::kColorLabelForegroundSecondary, /*multiline=*/false));
+  dropped_->SetText(l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_DROPPED));
+  dropped_->SetVisible(false);
+
+  scroll_ = AddChildView(std::make_unique<views::ScrollView>());
+  scroll_->SetHorizontalScrollBarMode(views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_->SetBackgroundColor(std::nullopt);
+  auto rows = std::make_unique<views::BoxLayoutView>();
+  rows->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  rows->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  rows_ = scroll_->SetContents(std::move(rows));
+  draft_ = rows_->AddChildView(MakeLabel(ui::kColorLabelForegroundSecondary, /*multiline=*/true));
+  draft_->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(5, 0)));
+  draft_->SetVisible(false);
+  static_cast<views::BoxLayout*>(GetLayoutManager())->SetFlexForView(scroll_, 1);
+  scroll_->AddContentsScrolledCallback(
+      base::BindRepeating(&TarkCaptionHistoryView::OnScrolled, base::Unretained(this)));
+
+  live_ = AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(
+          [](TarkCaptionHistoryView* view) {
+            view->follow_.OnScrolled(/*at_bottom=*/true);
+            view->ScrollToBottom();
+            view->UpdateLive();
+          },
+          base::Unretained(this)),
+      std::u16string()));
+  live_->SetStyle(ui::ButtonStyle::kProminent);
+  live_->SetVisible(false);
+}
+
+TarkCaptionHistoryView::~TarkCaptionHistoryView() = default;
+
+void TarkCaptionHistoryView::SetTitle(const std::u16string& tab_title) {
+  title_->SetText(l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_HISTORY_TITLE, tab_title));
+}
+
+void TarkCaptionHistoryView::SetStopped(bool stopped) {
+  if (stopped_->GetVisible() != stopped) {
+    stopped_->SetVisible(stopped);
+    InvalidateLayout();
+  }
+}
+
+void TarkCaptionHistoryView::SetHistory(const tark_captions::CaptionHistory& history) {
+  const auto& rows = history.rows();
+  // Rows gone: dropped from the top for the limits, a wrong guess from the
+  // bottom, or all of them.
+  const uint64_t first = rows.empty() ? UINT64_MAX : rows.front().id;
+  const uint64_t last = rows.empty() ? 0 : rows.back().id;
+  for (auto it = row_views_.begin(); it != row_views_.end();) {
+    if (it->first < first || it->first > last) {
+      rows_->RemoveChildViewT(it->second.row.get());
+      it = row_views_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  int added = 0;
+  for (const Row& row : rows) {
+    auto it = row_views_.find(row.id);
+    if (it == row_views_.end()) {
+      RowViews views;
+      // Before the draft, which stays last.
+      rows_->AddChildViewAt(MakeRow(row, &views), rows_->children().size() - 1);
+      row_views_.emplace(row.id, views);
+      ++added;
+    } else if (it->second.version != row.version) {
+      FillRow(row, &it->second);
+    }
+  }
+  const tark_captions::CaptionHistory::Draft& draft = history.draft();
+  draft_->SetVisible(!draft.text.empty());
+  draft_->SetText(draft.translation.empty() ? draft.text
+                                            : draft.text + u"\n" + draft.translation);
+  dropped_->SetVisible(history.dropped());
+  follow_.OnRowsAdded(added);
+  InvalidateLayout();
+  if (follow_.following()) {
+    ScrollToBottom();
+  }
+  UpdateLive();
+}
+
+views::View* TarkCaptionHistoryView::MakeRow(const Row& row, RowViews* views) {
+  auto view = std::make_unique<views::BoxLayoutView>();
+  view->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  view->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  view->SetInsideBorderInsets(gfx::Insets::VH(5, 0));
+  view->SetBorder(views::CreateSolidSidedBorder(gfx::Insets::TLBR(1, 0, 0, 0),
+                                                ui::kColorSeparator));
+  if (row.kind == Kind::kLine) {
+    auto* time = view->AddChildView(MakeLabel(ui::kColorLabelForegroundSecondary, false));
+    time->SetText(tark_captions::HistoryTime(row.at));
+    time->SetFontList(time->font_list().DeriveWithSizeDelta(-2));
+    views->text = view->AddChildView(MakeLabel(ui::kColorLabelForeground, true));
+    views->translation =
+        view->AddChildView(MakeLabel(ui::kColorButtonBackgroundProminent, true));
+  } else {
+    auto* divider = view->AddChildView(MakeLabel(ui::kColorLabelForegroundSecondary, false));
+    divider->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    divider->SetFontList(divider->font_list().DeriveWithSizeDelta(-2));
+    divider->SetText(l10n_util::GetStringUTF16(row.kind == Kind::kNewVideo
+                                                   ? IDS_TARK_CAPTIONS_HISTORY_NEW_VIDEO
+                                                   : IDS_TARK_CAPTIONS_HISTORY_RESTARTED));
+  }
+  views->row = view.get();
+  FillRow(row, views);
+  return view.release();
+}
+
+void TarkCaptionHistoryView::FillRow(const Row& row, RowViews* views) {
+  views->version = row.version;
+  if (!views->text) {
+    return;
+  }
+  views->text->SetText(row.text);
+  views->translation->SetText(row.translation);
+  views->translation->SetVisible(!row.translation.empty());
+}
+
+void TarkCaptionHistoryView::OnScrolled() {
+  if (scrolling_) {
+    return;
+  }
+  const gfx::Rect visible = scroll_->GetVisibleRect();
+  follow_.OnScrolled(visible.bottom() + kBottomSlop >= rows_->height());
+  UpdateLive();
+}
+
+void TarkCaptionHistoryView::ScrollToBottom() {
+  if (views::Widget* widget = GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+  scrolling_ = true;
+  rows_->ScrollRectToVisible(gfx::Rect(0, rows_->height() - 1, 1, 1));
+  scrolling_ = false;
+}
+
+void TarkCaptionHistoryView::UpdateLive() {
+  const bool show = !follow_.following() && follow_.unseen() > 0;
+  if (show) {
+    live_->SetText(l10n_util::GetStringFUTF16(IDS_TARK_CAPTIONS_HISTORY_LIVE,
+                                              base::NumberToString16(follow_.unseen())));
+  }
+  if (live_->GetVisible() != show) {
+    live_->SetVisible(show);
+    InvalidateLayout();
+  }
+}
+
+BEGIN_METADATA(TarkCaptionHistoryView)
+END_METADATA
