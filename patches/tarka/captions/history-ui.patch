+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/history_follow.h"
+
+void HistoryFollow::OnScrolled(int offset, bool at_bottom) {
+  if (at_bottom) {
+    following_ = true;
+    unseen_ = 0;
+  } else if (offset < last_offset_) {
+    following_ = false;
+  }
+  last_offset_ = offset;
+}
+
+void HistoryFollow::OnRowsAdded(int count) {
+  if (!following_) {
+    unseen_ += count;
+  }
+}
