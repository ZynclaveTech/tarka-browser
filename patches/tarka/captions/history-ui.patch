   EXPECT_FALSE(box_->GetVisible());
 }
 
+// The user (2026-10-22): "if the caption box grew full width and height
+// never resize after that". While it shows, the box only grows, so new
+// words never make it jump; it starts small again once it hides.
+TEST_F(TarkCaptionBoxViewTest, GrowsButNeverShrinksWhileShowing) {
+  const std::u16string long_text(
+      u"this sentence is long enough to fill the whole width of the caption box "
+      u"and to wrap onto a second line, maybe even a third one when it keeps going");
+  box_->SetCaption({long_text, u""}, u"");
+  const gfx::Size grown = box_->GetPreferredSize();
+  box_->SetCaption({u"short", u""}, u"");
+  EXPECT_EQ(box_->GetPreferredSize(), grown);
+
+  // Hidden (captions off, the bar closed): the next caption starts small.
+  box_->SetCaption({u"", u""}, u"");
+  EXPECT_FALSE(box_->GetVisible());
+  box_->SetCaption({u"short", u""}, u"");
+  EXPECT_LT(box_->GetPreferredSize().width(), grown.width());
+  EXPECT_LT(box_->GetPreferredSize().height(), grown.height());
+}
+
+TEST_F(TarkCaptionBoxViewTest, NewWidthStartsSmallAgain) {
+  box_->SetCaption({std::u16string(200, u'x') + u" y", u""}, u"");
+  const gfx::Size wide = box_->GetPreferredSize();
+  // The bar becomes the narrower strip.
+  box_->SetTextWidth(320);
+  box_->SetCaption({u"short", u""}, u"");
+  EXPECT_LT(box_->GetPreferredSize().width(), wide.width());
+}
+
+// The bar closed or moved to another tab: the next caption starts small.
+TEST_F(TarkCaptionBoxViewTest, ResetGrowthStartsSmall) {
+  box_->SetCaption({std::u16string(150, u'x') + u" y z", u""}, u"");
+  const gfx::Size grown = box_->GetPreferredSize();
+  box_->ResetGrowth();
+  box_->SetCaption({u"short", u""}, u"");
+  EXPECT_LT(box_->GetPreferredSize().width(), grown.width());
+}
+
+// Translate switched off: the box loses the translation's line instead of
+// keeping its height.
+TEST_F(TarkCaptionBoxViewTest, TranslateSwitchStartsSmall) {
+  box_->SetCaption({u"original words", u""}, {u"the translated words", u""}, u"");
+  const gfx::Size with_translation = box_->GetPreferredSize();
+  box_->SetCaption({u"original words", u""}, {}, u"");
+  EXPECT_LT(box_->GetPreferredSize().height(), with_translation.height());
+}
+
 }  // namespace
