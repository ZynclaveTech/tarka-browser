+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/history_follow.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+TEST(HistoryFollowTest, FollowsUntilScrolledUp) {
+  HistoryFollow follow;
+  EXPECT_TRUE(follow.following());
+  follow.OnScrolled(/*offset=*/300, /*at_bottom=*/true);
+  follow.OnScrolled(/*offset=*/120, /*at_bottom=*/false);
+  follow.OnRowsAdded(2);
+  EXPECT_FALSE(follow.following());
+  EXPECT_EQ(follow.unseen(), 2);
+}
+
+TEST(HistoryFollowTest, BackAtBottomFollowsAgain) {
+  HistoryFollow follow;
+  follow.OnScrolled(/*offset=*/300, /*at_bottom=*/true);
+  follow.OnScrolled(/*offset=*/100, /*at_bottom=*/false);
+  follow.OnRowsAdded(3);
+  follow.OnScrolled(/*offset=*/500, /*at_bottom=*/true);
+  EXPECT_TRUE(follow.following());
+  EXPECT_EQ(follow.unseen(), 0);
+}
+
+TEST(HistoryFollowTest, RowsWhileFollowingAreNotCounted) {
+  HistoryFollow follow;
+  follow.OnRowsAdded(5);
+  EXPECT_TRUE(follow.following());
+  EXPECT_EQ(follow.unseen(), 0);
+}
+
+// Lines arriving (or a line growing with its translation) push the bottom
+// down without the user scrolling: still following.
+TEST(HistoryFollowTest, ContentGrowingBelowKeepsFollowing) {
+  HistoryFollow follow;
+  follow.OnScrolled(/*offset=*/300, /*at_bottom=*/true);
+  follow.OnScrolled(/*offset=*/300, /*at_bottom=*/false);
+  follow.OnRowsAdded(1);
+  EXPECT_TRUE(follow.following());
+  EXPECT_EQ(follow.unseen(), 0);
+}
+
+}  // namespace
