+void TarkCaptionHistoryPanel::Show(CallCaptionsTabHelper* tab) {
+  if (!tab || tab->history().empty() || !browser_view_->GetWidget()) {
+    return;
+  }
+  if (tab != tab_) {
+    tab_observation_.Reset();
+    tab_ = tab;
+    tab_observation_.Observe(tab);
+    models_pending_ = false;
+    if (view_) {
+      view_->Reset();
+    }
+  }
+  if (!widget_) {
+    views::Widget::InitParams params(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                                     views::Widget::InitParams::TYPE_POPUP);
+    params.parent = browser_view_->GetWidget()->GetNativeView();
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+    params.name = "TarkCaptionHistory";
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+    view_ = widget_->SetContentsView(std::make_unique<TarkCaptionHistoryView>(this));
+    // What was said is private to whoever reads it: out of screen shares
+    // and screenshots, before anything shows.
+    widget_->SetAllowScreenshots(false);
+    browser_widget_observation_.Observe(browser_view_->GetWidget());
+    contents_observation_.Observe(browser_view_->contents_web_view());
+  }
+  Refresh();
+  // Runs on_visibility_changed_ when it appears.
+  Reposition();
+}
+
+void TarkCaptionHistoryPanel::Close() {
+  refresh_timer_.Stop();
+  tab_observation_.Reset();
+  browser_widget_observation_.Reset();
+  contents_observation_.Reset();
+  tab_ = nullptr;
+  view_ = nullptr;
+  const bool was_open = !!widget_;
+  widget_.reset();
+  if (was_open && on_visibility_changed_) {
+    on_visibility_changed_.Run();
+  }
+}
+
+int TarkCaptionHistoryPanel::OccupiedWidth() const {
+  return widget_ && widget_->IsVisible() ? widget_->GetWindowBoundsInScreen().width() : 0;
+}
+
+void TarkCaptionHistoryPanel::SetModelsPending(bool pending) {
+  if (models_pending_ != pending) {
+    models_pending_ = pending;
+    ScheduleRefresh();
+  }
+}
+
+void TarkCaptionHistoryPanel::OnHistoryChanged(CallCaptionsTabHelper* tab) {
+  ScheduleRefresh();
+}
+
+void TarkCaptionHistoryPanel::OnCallStateChanged(CallCaptionsTabHelper* tab) {
+  ScheduleRefresh();
+}
+
+void TarkCaptionHistoryPanel::OnCopyPressed() {
+  if (!tab_) {
+    return;
+  }
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(tab_->history().CopyText(
+          l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_NEW_VIDEO),
+          l10n_util::GetStringUTF16(IDS_TARK_CAPTIONS_HISTORY_RESTARTED)));
+}
+
+void TarkCaptionHistoryPanel::OnCloseHistoryPressed() {
+  // Not from inside the button's own press: closing destroys it.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&TarkCaptionHistoryPanel::Close, weak_factory_.GetWeakPtr()));
+}
+
+void TarkCaptionHistoryPanel::OnWidgetBoundsChanged(views::Widget* widget,
+                                                    const gfx::Rect& new_bounds) {
+  Reposition();
+}
+
+void TarkCaptionHistoryPanel::OnWidgetDestroying(views::Widget* widget) {
+  Close();
+}
+
+void TarkCaptionHistoryPanel::OnViewBoundsChanged(views::View* observed_view) {
+  Reposition();
+}
+
+void TarkCaptionHistoryPanel::ScheduleRefresh() {
+  if (!refresh_timer_.IsRunning()) {
+    refresh_timer_.Start(FROM_HERE, kRefreshDelay,
+                         base::BindOnce(&TarkCaptionHistoryPanel::Refresh,
+                                        base::Unretained(this)));
+  }
+}
+
+void TarkCaptionHistoryPanel::Refresh() {
+  if (!tab_ || !view_) {
+    return;
+  }
+  if (tab_->history().empty()) {
+    // Cleared: the user turned captions off, or the tab left the site.
+    Close();
+    return;
+  }
+  view_->SetTitle(tab_->web_contents()->GetTitle());
+  view_->SetStopped(!tab_->captions_on() && !models_pending_);
+  view_->SetHistory(tab_->history());
+}
+
+void TarkCaptionHistoryPanel::Reposition() {
+  if (!widget_ || !browser_view_->GetWidget()) {
+    return;
+  }
+  const bool was_visible = widget_->IsVisible();
+  const gfx::Rect area = browser_view_->contents_web_view()->GetBoundsInScreen();
+  // Full-screen video takes the whole screen; the panel waits.
+  content::WebContents* front = browser_view_->GetActiveWebContents();
+  const bool hide = !tab_ || area.IsEmpty() || (front && front->IsFullscreen());
+  if (hide) {
+    widget_->Hide();
+  } else {
+    const int width = std::min(kPanelWidth, area.width() * 2 / 5);
+    widget_->SetBounds(gfx::Rect(area.right() - width, area.y(), width, area.height()));
+    if (!was_visible) {
+      widget_->ShowInactive();
+    }
+    // macOS keeps the capture-exclusion shape it was given: give it the
+    // new one, now that the window has its size and shows.
+    widget_->SetAllowScreenshots(false);
+  }
+  if (was_visible != widget_->IsVisible() && on_visibility_changed_) {
+    on_visibility_changed_.Run();
+  }
+}
