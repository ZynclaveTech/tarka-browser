+// Copyright 2026 The Tark Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tark_captions/history_follow.h"
+
+void HistoryFollow::OnScrolled(bool at_bottom) {
+  following_ = at_bottom;
+  if (at_bottom) {
+    unseen_ = 0;
+  }
+}
+
+void HistoryFollow::OnRowsAdded(int count) {
+  if (!following_) {
+    unseen_ += count;
+  }
+}
