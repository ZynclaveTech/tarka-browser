+void TarkCaptionPillController::OnHistoryPressed() {
+  if (!shown_) {
+    return;
+  }
+  if (!history_panel_) {
+    history_panel_ = std::make_unique<TarkCaptionHistoryPanel>(browser_view_);
+    history_panel_->set_on_visibility_changed(base::BindRepeating(
+        &TarkCaptionPillController::Update, base::Unretained(this)));
+  }
+  if (history_panel_->showing() && history_panel_->tab() == shown_) {
+    history_panel_->Close();
+  } else {
+    history_panel_->Show(shown_);
+  }
+}
+
+void TarkCaptionPillController::OnHistoryChanged(CallCaptionsTabHelper* tab) {
+  // Lines come several times a second: the bar only cares when a history
+  // starts or goes (☰ Earlier, "Captions stopped").
+  if (tab == shown_ && tab->history().empty() == shown_has_history_) {
+    Update();
+  }
+}
