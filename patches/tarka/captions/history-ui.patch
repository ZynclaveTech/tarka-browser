+// caption bar; macOS and Windows can hide only whole windows.
+class TarkCaptionHistoryPanel : public views::WidgetObserver,
+                                public views::ViewObserver,
+                                public CallCaptionsTabHelper::Observer,
+                                public TarkCaptionHistoryView::Delegate {
+ public:
+  explicit TarkCaptionHistoryPanel(BrowserView* browser_view);
+  TarkCaptionHistoryPanel(const TarkCaptionHistoryPanel&) = delete;
+  TarkCaptionHistoryPanel& operator=(const TarkCaptionHistoryPanel&) = delete;
+  ~TarkCaptionHistoryPanel() override;
+
+  // Opens on `tab`'s history, or follows `tab` when open on another.
+  void Show(CallCaptionsTabHelper* tab);
+  void Close();
+  bool showing() const { return !!tab_; }
+  CallCaptionsTabHelper* tab() const { return tab_; }
+  // The width it covers on the right of the page; 0 when closed or hidden.
+  int OccupiedWidth() const;
+  bool IsPanelWidget(const views::Widget* widget) const { return widget == widget_.get(); }
+  // The tab's captions are off only while Tark downloads a model they need
+  // (they come back on by themselves): not "Captions stopped".
+  void SetModelsPending(bool pending);
+
+  // Runs when it appears, closes or hides: the bar re-centres.
+  void set_on_visibility_changed(base::RepeatingClosure callback) {
+    on_visibility_changed_ = std::move(callback);
+  }
+
+  // CallCaptionsTabHelper::Observer:
+  void OnHistoryChanged(CallCaptionsTabHelper* tab) override;
+  void OnCallStateChanged(CallCaptionsTabHelper* tab) override;
+
+  // TarkCaptionHistoryView::Delegate:
+  void OnCopyPressed() override;
+  void OnCloseHistoryPressed() override;
+
+  // views::WidgetObserver:
+  void OnWidgetBoundsChanged(views::Widget* widget, const gfx::Rect& new_bounds) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+
+ private:
+  void ScheduleRefresh();
+  void Refresh();
+  void Reposition();
+
+  raw_ptr<BrowserView> browser_view_;
+  raw_ptr<CallCaptionsTabHelper> tab_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<TarkCaptionHistoryView> view_ = nullptr;
+  bool models_pending_ = false;
+  // Captions come several times a second; the panel takes at most four.
+  base::OneShotTimer refresh_timer_;
+  base::RepeatingClosure on_visibility_changed_;
+  base::ScopedObservation<CallCaptionsTabHelper, CallCaptionsTabHelper::Observer>
