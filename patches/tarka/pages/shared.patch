+<?xml version="1.0" encoding="utf-8"?>
+<!-- Tark (M3d): the sentences in Tark's own page headers
+     (docs/superpowers/specs/2026-10-18-tark-own-pages-design.md). -->
+<grit-part>
+  <message name="IDS_TARK_PAGES_DOWNLOADS_SENTENCE" desc="Sentence under the Downloads page title. $1 is the name of the download folder.">
+    {COUNT, plural,
+      =0 {Saved to your <ph name="FOLDER">$1<ex>Downloads</ex></ph> folder}
+      =1 {1 file today, saved to your <ph name="FOLDER">$1<ex>Downloads</ex></ph> folder}
+      other {# files today, saved to your <ph name="FOLDER">$1<ex>Downloads</ex></ph> folder}}
+  </message>
+  <message name="IDS_TARK_PAGES_DOWNLOADS_EMPTY" desc="Shown on the Downloads page when there are no downloads.">
+    Files you save will appear here.
+  </message>
+  <message name="IDS_TARK_PAGES_EXTENSIONS_SENTENCE" desc="Sentence under the Extensions page title: how many extensions are switched on.">
+    {COUNT, plural,
+      =1 {1 extension on.}
+      other {# extensions on.}}
+  </message>
+  <message name="IDS_TARK_PAGES_EXTENSIONS_UBLOCK" desc="Added to the Extensions sentence while uBlock Origin is on.">
+    uBlock Origin blocks ads on every site.
+  </message>
+  <message name="IDS_TARK_PAGES_HISTORY_SENTENCE" desc="Sentence under the History page title: how many pages were visited today.">
+    {COUNT, plural,
+      =1 {Kept on this Mac only. 1 page today.}
+      other {Kept on this Mac only. # pages today.}}
+  </message>
+  <message name="IDS_TARK_PAGES_BOOKMARKS_SENTENCE" desc="Sentence under the Bookmarks page title. $1 is the folder count, already formatted as 'N folder(s)'.">
+    {COUNT, plural,
+      =1 {1 bookmark in <ph name="FOLDERS">$1<ex>3 folders</ex></ph>, kept on this Mac.}
+      other {# bookmarks in <ph name="FOLDERS">$1<ex>3 folders</ex></ph>, kept on this Mac.}}
+  </message>
+  <message name="IDS_TARK_PAGES_BOOKMARKS_FOLDERS" desc="Folder count inside the Bookmarks sentence.">
+    {COUNT, plural,
+      =1 {1 folder}
+      other {# folders}}
+  </message>
+  <message name="IDS_TARK_PAGES_PASSWORDS_SENTENCE" desc="Sentence under the Password Manager title: how many passwords are saved.">
+    {COUNT, plural,
+      =1 {1 password saved on this Mac, locked with your Mac login.}
+      other {# passwords saved on this Mac, locked with your Mac login.}}
+  </message>
+  <message name="IDS_TARK_PAGES_VERSION_SENTENCE" desc="Sentence under the Version page title. $1 is Tark's version number.">
+    Tark <ph name="VERSION">$1<ex>155.0.8059.39</ex></ph>, built on Chromium for this Mac.
+  </message>
+</grit-part>
