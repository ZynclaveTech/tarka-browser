+
+/* Tark (M3d): the palette by name for Tark's own pages (spec 6), light and
+ * dark. Pages read these, never their own hex values. */
+:root {
+  --tark-paper: #f6f1e7;
+  --tark-raised: #fffdf8;
+  --tark-ink: #14142b;
+  --tark-soft: #4d473d;
+  --tark-faint: #6f6757;
+  --tark-rule: #d9d0bf;
+  --tark-indigo: #4338ca;
+  --tark-amber: #ffb703;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --tark-paper: #12121c;
+    --tark-raised: #1b1b29;
+    --tark-ink: #f3efe6;
+    --tark-soft: #bdb6a8;
+    --tark-faint: #948d80;
+    --tark-rule: #2c2c3d;
+    --tark-indigo: #8f88ff;
+    --tark-amber: #ffc53d;
+  }
+}
--- a/ui/webui/resources/cr_elements/cr_toolbar/cr_toolbar.css
+++ b/ui/webui/resources/cr_elements/cr_toolbar/cr_toolbar.css
@@ -143,3 +143,58 @@
   height: 24px;
   width: 24px;
 }
+
+/* Tark (M3d): the page title and its sentence stack in one column. */
+#pageTitle {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+}
+
+#pageTitle h1 {
+  flex: none;
+}
+
+#pageSentence {
+  margin: 0;
+}
+
+/* Tark (M3d, spec "The page pattern"): with a sentence, the header is an
+ * uppercase indigo label over one line of ink, and the search field is a
+ * raised pill with a hairline. */
+:host([page-sentence]:not([page-sentence=''])) h1 {
+  color: var(--tark-indigo);
+  font-size: 11px;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  line-height: 16px;
+  margin-inline-start: 0;
+  padding-inline-end: 0;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+/* With a sentence, the title column takes its own width (pages with a
+ * sidebar would otherwise cut the sentence at the sidebar's width). */
+:host([page-sentence]:not([page-sentence='']):not([narrow])) #leftContent {
+  flex: 0 1 auto;
+  max-width: 48%;
+}
+
+:host([page-sentence]:not([page-sentence=''])) #pageSentence {
+  color: var(--tark-ink);
+  font-size: 13px;
+  line-height: 18px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+/* Not when narrow: there the search field is a single icon button. */
+:host([page-sentence]:not([page-sentence='']):not([narrow])) #search {
+  --cr-toolbar-search-field-background: var(--tark-raised);
+  --cr-toolbar-search-field-border-radius: 999px;
+  border: 1px solid var(--tark-rule);
+  border-radius: 999px;
+}
