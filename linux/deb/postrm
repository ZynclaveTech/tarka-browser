#!/bin/sh
# Tark's package (L3): `apt purge tark` also removes Tark's apt repository
# and its key; a plain remove keeps them, as Chrome's package does.
set -e
root=${DPKG_ROOT:-}
if [ "$1" = purge ]; then
  rm -f "$root/etc/apt/sources.list.d/tark.list" "$root/usr/share/keyrings/tark-archive-keyring.gpg"
fi
exit 0
